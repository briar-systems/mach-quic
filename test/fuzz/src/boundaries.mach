# every untrusted-input entry point the lane answers, by corpus directory name

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use fuzz.frame;
use fuzz.listener;
use fuzz.negotiation;
use fuzz.packet;
use fuzz.parameters;
use fuzz.protection;
use fuzz.receive;
use fuzz.token;
use fuzz.varint;
use fuzz.verdict;

pub def AnswerFn: fun(*u8, usize) verdict.Verdict;

pub rec Boundary {
    name:   str;
    answer: AnswerFn;
}

pub val CAPACITY: usize = 32;

fun put(out: *Boundary, i: usize, name: str, answer: AnswerFn) usize {
    if (i >= CAPACITY) { ret i; }
    out[i].name   = name;
    out[i].answer = answer;
    ret i + 1;
}

pub fun all(out: *Boundary) usize {
    var i: usize = 0;
    i = put(out, i, "varint", varint.answer);
    i = put(out, i, "packet", packet.answer);
    i = put(out, i, "frame", frame.answer);
    i = put(out, i, "transport-parameters", parameters.answer);
    i = put(out, i, "datagram", listener.answer_datagram);
    i = put(out, i, "preflight", listener.answer_preflight);
    i = put(out, i, "token", token.answer);
    i = put(out, i, "version-negotiation", negotiation.answer_version_negotiation);
    i = put(out, i, "retry", negotiation.answer_retry);
    i = put(out, i, "packet-protection", protection.answer);
    i = put(out, i, "receive", receive.answer);
    ret i;
}

pub fun lookup(table: *Boundary, n: usize, name: str) opt[usize] {
    var i: usize = 0;
    for (i < n) {
        if (str_equals(table[i].name, name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}
