# the server's first look at a datagram: classification and preflight

use crypto.contracts;
use quic.connection.admission;
use quic.connection.listener;
use quic.connection.token;
use quic.crypto.protection;
use quic.packet.packet;
use std.encoding.binary;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use pk: fuzz.packet;
use fuzz.server;
use fuzz.verdict;

val SCRATCH: usize = 20480;

var output: [SCRATCH]u8;
var pseudo: [SCRATCH]u8;

fun classified_is(value: *listener.ConnectionId, data: *u8, len: usize) bool {
    if (value.length != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (value.data[i] != data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun id_is(value: *packet.ConnectionId, data: *u8, len: usize) bool {
    if (value.len::usize != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (value.data[i] != data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a classification copies the destination it names from where the header
# carries it, and agrees with the packet decoder on every packet that decoder
# accepts: a server cannot route a packet it would parse to the wrong place
fun classify_one(data: *u8, len: usize, short_len: usize, outcome: *u64) bool {
    val c: listener.ClassifiedDatagram = listener.classify_datagram(data, len, short_len);
    @outcome = verdict.mix(@outcome, (c.class::u64 << 1) | c.long_header::u64);
    if (c.class == listener.DATAGRAM_MALFORMED) {
        if (c.destination.length != 0 || c.version != 0 || c.token_length != 0 || c.long_header) {
            ret false;
        }
    }
    or {
        if (c.class > listener.DATAGRAM_ESTABLISHED || len == 0 ||
            c.long_header != ((data[0] & 0x80) != 0)) { ret false; }
        if (c.long_header) {
            if (len < 7 || !classified_is(?c.destination, ?data[6], data[5]::usize)) { ret false; }
        }
        or (len < 1 + short_len || !classified_is(?c.destination, ?data[1], short_len)) { ret false; }
        if (c.class != listener.DATAGRAM_INITIAL && c.token_length != 0)                { ret false; }
        if (c.token_length > len)                                                       { ret false; }
    }
    if (c.class != listener.DATAGRAM_MALFORMED) { verdict.accept(); }

    var d:     binary.Decoder      = binary.decoder(data, len, binary.BIG);
    var value: packet.Packet;
    val read:  packet.DecodeResult = packet.decode(?d, true,
        pk.context(packet.VERSION_1, short_len::u8, 0), packet.default_limits(), ?value);
    if (read.status != packet.STATUS_DONE) { ret true; }
    val kind: u8 = value.header.kind;
    if (kind == packet.PACKET_ONE_RTT) {
        ret c.class == listener.DATAGRAM_ESTABLISHED && !c.long_header;
    }
    # a long header without a destination is refused before it is classified
    if (value.header.destination.len == 0) { ret c.class == listener.DATAGRAM_MALFORMED; }
    if (kind == packet.PACKET_INITIAL) {
        ret c.class == listener.DATAGRAM_INITIAL && c.token_length == value.token.len;
    }
    if (kind == packet.PACKET_UNKNOWN_VERSION) { ret c.class == listener.DATAGRAM_NEGOTIATE; }
    ret c.class == listener.DATAGRAM_ESTABLISHED;
}

pub fun answer_datagram(data: *u8, len: usize) verdict.Verdict {
    var outcome: u64 = 0;
    if (!classify_one(data, len, 8, ?outcome) || !classify_one(data, len, 20, ?outcome)) {
        ret verdict.violated("datagram: a classification names bytes the header does not carry, or disagrees with the packet decoder");
    }
    ret verdict.answered(outcome);
}

var ready:      u8;
var admissions: [2]admission.Manager;
var tokens:     [2]token.Manager;
var listeners:  [2]listener.Listener;

fun setup() bool {
    if (ready == 1) { ret true; }
    if (ready == 2) { ret false; }
    ready = 2;
    if (!server.make_listener(?listeners[0], ?admissions[0], ?tokens[0], 501, false) ||
        !server.make_listener(?listeners[1], ?admissions[1], ?tokens[1], 502, true)) { ret false; }
    ready = 1;
    ret true;
}

fun retry_source() listener.ConnectionId {
    var value: listener.ConnectionId;
    value.length = 8;
    var i: usize = 0;
    for (i < 8) {
        value.data[i] = (0xa0 + i)::u8;
        i             = i + 1;
    }
    ret value;
}

# the version negotiation a server writes echoes the client's connection ids,
# lists what it supports, and is no larger than three times what it answers
fun negotiation_sound(data: *u8, len: usize, count: usize) bool {
    if (count > len * 3 || count > SCRATCH) { ret false; }
    var d:     binary.Decoder      = binary.decoder(?output[0], count, binary.BIG);
    var value: packet.Packet;
    val read:  packet.DecodeResult = packet.decode(?d, true, packet.empty_decode_context(),
        packet.default_limits(), ?value);
    if (read.status != packet.STATUS_DONE || read.consumed != count ||
        value.header.kind != packet.PACKET_VERSION_NEGOTIATION || value.versions.len != 8 ||
        packet.version_at(?value, 0) != packet.VERSION_1 ||
        packet.version_at(?value, 1) != packet.VERSION_2) { ret false; }
    val destination_len: usize = data[5]::usize;
    val source_len:      usize = data[6 + destination_len]::usize;
    ret id_is(?value.header.source, ?data[6], destination_len) &&
        id_is(?value.header.destination, ?data[7 + destination_len], source_len);
}

# the retry a server writes goes back to the client's source, names the retry
# source it was given, and carries an integrity tag over the client's original
# destination
fun retry_sound(data: *u8, len: usize, count: usize) bool {
    if (count > SCRATCH) { ret false; }
    var d:     binary.Decoder      = binary.decoder(?output[0], count, binary.BIG);
    var value: packet.Packet;
    val read:  packet.DecodeResult = packet.decode(?d, true, packet.empty_decode_context(),
        packet.default_limits(), ?value);
    val version: u32 = binary.get_uint(?data[1], 4, binary.BIG)::u32;
    if (read.status != packet.STATUS_DONE || read.consumed != count ||
        value.header.kind != packet.PACKET_RETRY || value.header.version != version ||
        value.token.len != token.TOKEN_SIZE) { ret false; }
    val destination_len: usize                 = data[5]::usize;
    val source_len:      usize                 = data[6 + destination_len]::usize;
    val expected:        listener.ConnectionId = retry_source();
    if (!id_is(?value.header.destination, ?data[7 + destination_len], source_len) ||
        !id_is(?value.header.source, ?expected.data[0], 8)) { ret false; }
    ret protection.verify_retry(version,
        contracts.Bytes{data: ?data[6], len: destination_len},
        contracts.Bytes{data: ?output[0], len: count - packet.RETRY_INTEGRITY_TAG},
        contracts.Bytes{data: ?output[count - packet.RETRY_INTEGRITY_TAG],
        len: packet.RETRY_INTEGRITY_TAG},
        contracts.Buffer{data: ?pseudo[0], capacity: SCRATCH}) == protection.OK;
}

fun preflight_one(index: usize, data: *u8, len: usize, outcome: *u64) bool {
    var request: listener.Request;
    request.peer            = server.peer();
    request.data            = data;
    request.length          = len;
    request.now             = server.now();
    request.retry_source    = retry_source();
    request.retry_nonce     = 0x5eed;
    request.output          = ?output[0];
    request.output_capacity = SCRATCH;
    val value: listener.Result = listener.preflight(?listeners[index], ?request);
    @outcome = verdict.mix(@outcome, (value.action::u64 << 8) | value.error::u64);
    # a preflight never keeps what it could not give back
    if (value.error == listener.ERROR_CLEANUP) { ret false; }
    if (value.action == listener.ACTION_VERSION_NEGOTIATION) {
        verdict.accept();
        ret negotiation_sound(data, len, value.output_count);
    }
    if (value.action == listener.ACTION_RETRY) {
        verdict.accept();
        ret retry_sound(data, len, value.output_count);
    }
    if (value.action != listener.ACTION_ACCEPT) { ret true; }
    verdict.accept();
    # what a server admits is an initial it classifies as one, sized as a client must
    val c: listener.ClassifiedDatagram = listener.classify_datagram(data, len, 8);
    if (c.class != listener.DATAGRAM_INITIAL || len < 1200 || c.destination.length < 8 ||
        value.version != c.version) { ret false; }
    ret listener.cancel(?listeners[index], value.acceptance).action == listener.ACTION_ACCEPT;
}

# the same datagram before a listener that admits tokenless clients and one
# that asks them for a retry
pub fun answer_preflight(data: *u8, len: usize) verdict.Verdict {
    if (!setup()) { ret verdict.violated("preflight: the fixed server could not be set up"); }
    var outcome: u64 = 0;
    if (!preflight_one(0, data, len, ?outcome) || !preflight_one(1, data, len, ?outcome)) {
        ret verdict.violated("preflight: an answer is not what the server promised, or kept state it could not release");
    }
    ret verdict.answered(outcome);
}
