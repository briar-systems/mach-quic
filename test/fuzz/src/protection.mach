# packet protection: header protection removal and packet decryption
#
# a long header packet is opened with the initial keys its own destination
# derives, both sides, and a short header packet with the rfc 9001 appendix
# a.5 chacha20 keys. what opens must seal back to the bytes it came from

use crypto.contracts;
use quic.crypto.protection;
use quic.packet.packet;
use std.encoding.binary;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use pk: fuzz.packet;
use fuzz.verdict;

val SCRATCH: usize = 20480;
# the packet number the appendix a.5 packet carries
val SHORT_EXPECTED: u64 = 654360564;

var unmasked: [SCRATCH]u8;
var header:   [64]u8;
var plain:    [SCRATCH]^u8;
var sealed:   [SCRATCH]u8;

var ready: u8;
var short: protection.SendKeys;

fun setup() bool {
    if (ready == 1) { ret true; }
    if (ready == 2) { ret false; }
    ready = 2;
    val public: [32]u8 = [32]u8{
        0x9a, 0xc3, 0x12, 0xa7, 0xf8, 0x77, 0x46, 0x8e,
        0xbe, 0x69, 0x42, 0x27, 0x48, 0xad, 0x00, 0xa1,
        0x54, 0x43, 0xf1, 0x82, 0x03, 0xa0, 0x7d, 0x60,
        0x60, 0xf6, 0x88, 0xf3, 0x0f, 0x21, 0x63, 0x2b,
    };
    var secret: [32]^u8;
    var i:      usize = 0;
    for (i < 32) {
        secret[i] = public[i];
        i         = i + 1;
    }
    if (protection.init_send(?short, packet.VERSION_1, protection.CHACHA20_POLY1305_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.OK) { ret false; }
    ready = 1;
    ret true;
}

# open the packet, and when it opens, check what it published and seal it back
fun open_one(keys: *protection.KeySet, expected: u64, data: *u8, len: usize, offset: usize,
    outcome: *u64) bool {
    val opened: protection.OpenResult = protection.open_packet(keys, expected,
        contracts.Bytes{data: data, len: len}, offset,
        contracts.Buffer{data: ?header[0], capacity: 64},
        contracts.SecretBuffer{data: ?plain[0], capacity: SCRATCH});
    @outcome = verdict.mix(@outcome, opened.error::u64);
    if (opened.error != protection.OK) { ret true; }
    verdict.accept();
    val header_len: usize = opened.header_len;
    if (opened.packet_number_len < 1 || opened.packet_number_len > 4 ||
        header_len != offset + opened.packet_number_len::usize || header_len > len ||
        len - header_len < 16 || opened.written != len - header_len - 16 ||
        opened.packet_number > packet.MAX_PACKET_NUMBER) { ret false; }
    # header protection touches only the first byte's low bits and the packet number
    var i: usize = 1;
    for (i < offset) {
        if (header[i] != data[i]) { ret false; }
        i = i + 1;
    }
    val resealed: protection.Result = protection.seal_packet(keys, opened.packet_number,
        contracts.Bytes{data: ?header[0], len: header_len}, offset,
        contracts.SecretBytes{data: ?plain[0], len: opened.written},
        contracts.Buffer{data: ?sealed[0], capacity: SCRATCH});
    if (resealed.error != protection.OK || resealed.written != len) { ret false; }
    i = 0;
    for (i < len) {
        if (sealed[i] != data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun answer_long(data: *u8, len: usize, outcome: *u64) bool {
    # the fields before the packet number are not protected, so the decoder
    # finds them once the protected bits of the first byte are cleared
    if (len > SCRATCH) { ret true; }
    var i: usize = 0;
    for (i < len) {
        unmasked[i] = data[i];
        i           = i + 1;
    }
    unmasked[0] = unmasked[0] & 0xf0;
    var d:     binary.Decoder      = binary.decoder(?unmasked[0], len, binary.BIG);
    var value: packet.Packet;
    val read:  packet.DecodeResult = packet.decode(?d, true, pk.context(packet.VERSION_1, 0, 0),
        packet.default_limits(), ?value);
    @outcome = verdict.mix(@outcome, (read.status::u64 << 8) | read.error::u64);
    if (read.status != packet.STATUS_DONE || value.header.kind == packet.PACKET_RETRY ||
        value.header.kind == packet.PACKET_VERSION_NEGOTIATION ||
        value.header.kind == packet.PACKET_UNKNOWN_VERSION) { ret true; }
    @outcome = verdict.mix(@outcome, value.header.kind::u64);
    val offset:  usize            = value.payload.data::usize - (?unmasked[0])::usize - 1;
    var keys:    protection.InitialKeys;
    val derived: protection.Error = protection.derive_initial(?keys, value.header.version,
        contracts.Bytes{data: ?value.header.destination.data[0],
        len: value.header.destination.len::usize});
    if (derived != protection.OK) { ret false; }
    val ok: bool = open_one(?keys.client, 0, data, read.consumed, offset, outcome) &&
        open_one(?keys.server, 0, data, read.consumed, offset, outcome);
    protection.destroy_initial(?keys);
    ret ok;
}

pub fun answer(data: *u8, len: usize) verdict.Verdict {
    if (!setup()) { ret verdict.violated("packet-protection: the fixed keys could not be derived"); }
    var outcome: u64  = 0;
    var ok:      bool = true;
    if (len != 0 && (data[0] & 0x80) != 0) { ok = answer_long(data, len, ?outcome); }
    or                                     { ok = open_one(?short.current, SHORT_EXPECTED, data, len, 1, ?outcome); }
    if (!ok) {
        ret verdict.violated("packet-protection: an opened packet published a header or plaintext it cannot seal back to");
    }
    ret verdict.answered(outcome);
}
