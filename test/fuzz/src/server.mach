# the fixed server the token and preflight harnesses answer against
#
# every manager holds the same token key, so a token sealed for the corpus
# opens in any of them at NOW from PEER

use crypto.contracts;
use quic.clock;
use quic.connection.admission;
use quic.connection.listener;
use quic.connection.token;
use quic.storage.limited;
use std.allocator;
use std.chrono.time;
use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

pub val GENERATION: u64 = 1;
# the instant the corpus's tokens were issued, and the instant they are opened
pub val ISSUED_AT: u64 = 1000000000;
pub val NOW:       u64 = 1000000500;
# long enough that a corpus token never expires at NOW
val MAX_AGE: u64 = 1000000000000;

pub fun peer() ip.Endpoint {
    ret ip.endpoint(192, 0, 2, 44, 4433);
}

pub fun now() time.Instant {
    ret clock.instant(NOW);
}

var memory_state: limited.Limited;
var memory_ready: bool;

pub fun backing() *allocator.Allocator {
    if (!memory_ready) {
        if (!limited.make(?memory_state, 1 << 26)) { ret nil; }
        memory_ready = true;
    }
    ret limited.allocator_of(?memory_state);
}

pub fun token_config(source: u64) token.Config {
    var config: token.Config;
    config.source          = source;
    config.retry_max_age   = clock.duration_of(MAX_AGE);
    config.address_max_age = clock.duration_of(MAX_AGE);
    config.max_replay      = 1024;
    ret config;
}

# a token manager keyed with the corpus key
pub fun make_tokens(manager: *token.Manager, source: u64) bool {
    var key: [32]^u8;
    var i:   usize = 0;
    for (i < 32) {
        key[i] = (0x40 + i)::u8;
        i      = i + 1;
    }
    val alloc: *allocator.Allocator = backing();
    if (alloc == nil) { ret false; }
    ret token.initialize(manager, token_config(source), alloc, GENERATION,
        contracts.SecretBytes{data: ?key[0], len: 32});
}

var versions: [2]u32;

# a listener that asks every tokenless client for a retry, or one that does not
pub fun make_listener(value: *listener.Listener, admissions: *admission.Manager,
    tokens: *token.Manager, source: u64, require_retry: bool) bool {
    val alloc: *allocator.Allocator = backing();
    if (alloc == nil) { ret false; }
    versions[0] = 0x00000001;
    versions[1] = 0x6b3343cf;
    var limits: admission.Config;
    limits.source                   = source;
    limits.max_connections          = opt[usize].some{64};
    limits.max_connections_per_peer = opt[usize].some{64};
    if (!admission.initialize(admissions, limits, alloc) || !make_tokens(tokens, source)) {
        ret false;
    }
    var config: listener.Config;
    config.source                  = source;
    config.supported_versions      = ?versions[0];
    config.supported_version_count = 2;
    config.minimum_initial_size    = 1200;
    config.require_retry           = require_retry;
    ret listener.initialize(value, config, alloc, admissions, tokens);
}
