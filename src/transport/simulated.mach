test native__loopback_udp_preserves_generated_and_received_datagrams {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 108, stream_api.ROLE_CLIENT)) { ret 1; }
    val bound: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    val made:  res[udp.Socket, io_error.Error] = udp.create();
    if (sel bound.err) { ret 2; }
    if (sel made.err)  { ret 2; }
    var receiver:          udp.Socket                       = bound.ok;
    var sender:            udp.Socket                       = made.ok;
    val receiver_endpoint: res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?receiver);
    if (sel receiver_endpoint.err) { ret 3; }
    fixture.core.outbound = 1;
    var output:    [8]u8;
    val generated: transport_api.Generated = transport_api.generate[Core](?fixture.driver,
        ?fixture.scope, ?output[0], 8, clock.instant(1), 9);
    val sent: res[usize, io_error.Error] = udp.send_to(?sender, generated.buffer,
        generated.count, receiver_endpoint.ok);
    if (generated.status != transport_api.STATUS_OK) { ret 4; }
    if (sel sent.err)                                { ret 4; }
    if (sent.ok != 5 ||
        transport_api.complete_send[Core](?fixture.driver, generated.token,
        transport_api.SEND_SENT, 5, clock.instant(2)).status != transport_api.STATUS_OK) { ret 4; }
    var received_bytes: [16]u8;
    var peer:           ip.Endpoint;
    val received:       res[usize, io_error.Error] = udp.recv_from(?receiver,
        ?received_bytes[0], 16, ?peer);
    if (sel received.err) { ret 5; }
    var packet: net_types.Packet;
    packet.buffer   = ?received_bytes[0];
    packet.capacity = 16;
    packet.length   = received.ok;
    packet.peer     = peer;
    if (transport_api.receive_native[Core](?fixture.driver, ?packet,
        receiver_endpoint.ok, clock.instant(3), 0).status !=
        transport_api.STATUS_OK || fixture.core.received != 1) { ret 6; }
    udp.socket_close(?sender);
    udp.socket_close(?receiver);
    if (!close_fixture(?fixture, 4)) { ret 7; }
    ret 0;
}

test transport__a_cancelled_scope_closes_on_the_owners_next_call {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 111, stream_api.ROLE_CLIENT)) { ret 1; }
    if (!transition_ok(cancel.cancel(?fixture.scope)))        { ret 2; }
    # the scope's callback is handed an untyped ptr and cannot reach a protocol
    # whose context is secret-welded, so it records the cancellation and touches
    # nothing else
    # read the protocol's own state directly: any driver call would itself
    # apply the cancellation and hide what is being asserted
    if (fixture.core.closing || fixture.core.abortive) { ret 3; }
    # the owner's next call performs the close, on the thread that owns the
    # protocol
    val state: transport_api.Snapshot = transport_api.snapshot[Core](
        ?fixture.driver);
    if (state.state != transport_api.DRAINING ||
        state.close_mode != io_lifecycle.ABORTIVE ||
        !(sel state.cancellation_reason.cancelled) ||
        !fixture.core.closing || !fixture.core.abortive) { ret 4; }
    if (transport_api.finish_close[Core](?fixture.driver).status !=
        transport_api.STATUS_OK || !operation_ok(cancel.destroy(?fixture.scope))) { ret 5; }
    ret 0;
}

