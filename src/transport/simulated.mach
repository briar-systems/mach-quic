# std 4.0.1 refuses a whole send batch whose packet is malformed, before any
# native call. the refusal settles the send as failed and nothing else changes
test native__a_refused_native_send_batch_fails_only_that_send {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 112, stream_api.ROLE_CLIENT)) { ret 1; }
    var pages:      allocator.Allocator;
    val made_pages: err[allocator.Error] = page.make(?pages);
    if (sel made_pages.err) { ret 2; }
    var runtime:      io_runtime.Runtime;
    val made_runtime: err[io_error.Error] = io_runtime.make(?runtime, ?pages, 4);
    if (sel made_runtime.err) { ret 2; }
    var network:      net_async.Driver;
    val made_network: err[io_error.Error] = net_async.make(?network, ?runtime);
    if (sel made_network.err) { ret 3; }
    val bound: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    val made:  res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    if (sel bound.err) { ret 4; }
    if (sel made.err)  { ret 4; }
    var receiver: udp.Socket                       = bound.ok;
    var sender:   udp.Socket                       = made.ok;
    val target:   res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?receiver);
    if (sel target.err) { ret 5; }

    fixture.core.outbound = 1;
    var output:    [8]u8;
    val generated: transport_api.Generated = transport_api.generate[Core](?fixture.driver,
        ?fixture.scope, ?output[0], 8, clock.instant(1), 9);
    if (generated.status != transport_api.STATUS_OK) { ret 6; }
    # the slot's packet claims more bytes than its buffer holds
    val slot: *transport_api.SendSlot = ?fixture.sends[generated.token.index::usize];
    slot.packet.peer   = target.ok;
    slot.packet.length = slot.packet.capacity + 4;
    val submitted: res[io_runtime.Token, io_error.Error] = transport_api.submit_native[Core](
        ?fixture.driver, ?network, ?sender, ?fixture.scope, generated.token);
    if (!(sel submitted.err)) {
        var completions: [4]io_runtime.Completion;
        var settled:     bool  = false;
        var rounds:      usize = 0;
        for (!settled && rounds < 8) {
            val waited: res[usize, io_error.Error] = net_async.wait(?network,
                ?completions[0], 4, 250);
            if (sel waited.err) { ret 7; }
            var j: usize = 0;
            for (j < waited.ok) {
                if (transport_api.complete_native[Core](?fixture.driver,
                    ?completions[j], clock.instant(2)).status != transport_api.STATUS_OK) { ret 8; }
                settled = true;
                j       = j + 1;
            }
            rounds = rounds + 1;
        }
        if (!settled) { ret 9; }
    }
    val snapshot: transport_api.Snapshot = transport_api.snapshot[Core](?fixture.driver);
    if (fixture.core.failed != 1 || fixture.core.active_count != 0 ||
        snapshot.pending_sends != 0 || snapshot.state != transport_api.ACTIVE) { ret 10; }
    # the connection still sends: the failed datagram is generated again
    val retried: transport_api.Generated = transport_api.generate[Core](?fixture.driver,
        ?fixture.scope, ?output[0], 8, clock.instant(3), 10);
    if (retried.status != transport_api.STATUS_OK ||
        transport_api.complete_send[Core](?fixture.driver, retried.token,
        transport_api.SEND_SENT, retried.count, clock.instant(4)).status != transport_api.STATUS_OK) { ret 11; }
    udp.socket_close(?sender);
    udp.socket_close(?receiver);
    val destroyed: err[io_error.Error] = net_async.destroy(?network);
    if (sel destroyed.err) { ret 12; }
    val closed: res[bool, io_error.Error] = io_runtime.close(?runtime);
    if (sel closed.err) { ret 13; }
    val released: err[io_error.Error] = io_runtime.destroy(?runtime);
    if (sel released.err)            { ret 14; }
    if (!close_fixture(?fixture, 5)) { ret 15; }
    ret 0;
}

# a real native send, completed by the runtime, for a test to reshape
rec NativeSend {
    completion: io_runtime.Completion;
    length:     usize;
    ok:         bool;
}

fun native_send(fixture: *Fixture, network: *net_async.Driver, sender: *udp.Socket,
    target: ip.Endpoint, output: *u8, at: u64) NativeSend {
    var result: NativeSend;
    fixture.core.outbound = 1;
    val generated: transport_api.Generated = transport_api.generate[Core](?fixture.driver,
        ?fixture.scope, output, 8, clock.instant(at), 9);
    if (generated.status != transport_api.STATUS_OK) { ret result; }
    fixture.sends[generated.token.index::usize].packet.peer = target;
    val submitted: res[io_runtime.Token, io_error.Error] = transport_api.submit_native[Core](
        ?fixture.driver, network, sender, ?fixture.scope, generated.token);
    if (sel submitted.err) { ret result; }
    var rounds: usize = 0;
    for (rounds < 8) {
        val waited: res[usize, io_error.Error] = net_async.wait(network,
            ?result.completion, 1, 250);
        if (sel waited.err) { ret result; }
        if (waited.ok == 1) {
            result.length = generated.count;
            result.ok     = !result.completion.has_error &&
                result.completion.items == 1 &&
                result.completion.bytes == generated.count;
            ret result;
        }
        rounds = rounds + 1;
    }
    ret result;
}

# mach-std 5.3 reports a cancelled or timed-out completion with the transfer
# that finished first. a datagram that went out whole was sent, whatever
# stopped the operation after it, and nothing less than whole counts as sent.
# the sends are real, but each completion's error and transfer are set by
# hand, so this proves quic reads that completion shape correctly. that std
# produces the shape on this path is proven by std's own tests
test native__a_cancelled_send_that_went_out_whole_is_sent {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 113, stream_api.ROLE_CLIENT)) { ret 1; }
    var pages:      allocator.Allocator;
    val made_pages: err[allocator.Error] = page.make(?pages);
    if (sel made_pages.err) { ret 2; }
    var runtime:      io_runtime.Runtime;
    val made_runtime: err[io_error.Error] = io_runtime.make(?runtime, ?pages, 4);
    if (sel made_runtime.err) { ret 2; }
    var network:      net_async.Driver;
    val made_network: err[io_error.Error] = net_async.make(?network, ?runtime);
    if (sel made_network.err) { ret 3; }
    val bound: res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    val made:  res[udp.Socket, io_error.Error] = udp.bind(ip.endpoint(127, 0, 0, 1, 0));
    if (sel bound.err) { ret 4; }
    if (sel made.err)  { ret 4; }
    var receiver: udp.Socket                       = bound.ok;
    var sender:   udp.Socket                       = made.ok;
    val target:   res[ip.Endpoint, io_error.Error] = udp.local_endpoint(?receiver);
    if (sel target.err) { ret 5; }
    var output: [8]u8;

    # whole datagram out, then cancelled: sent, with its full length
    var whole: NativeSend = native_send(?fixture, ?network, ?sender, target.ok, ?output[0], 1);
    if (!whole.ok) { ret 6; }
    whole.completion.has_error = true;
    whole.completion.error     = io_error.make(io_error.CANCELLED, io_error.OP_SEND);
    val sent: transport_api.Completion = transport_api.complete_native[Core](?fixture.driver,
        ?whole.completion, clock.instant(2));
    if (sent.status != transport_api.STATUS_OK ||
        sent.send_status != transport_api.SEND_SENT || sent.count != whole.length ||
        fixture.core.sent != 1 || fixture.core.sent_bytes != whole.length ||
        fixture.core.cancelled != 0) { ret 7; }

    # whole datagram out, then timed out: sent as well
    var late: NativeSend = native_send(?fixture, ?network, ?sender, target.ok, ?output[0], 3);
    if (!late.ok) { ret 8; }
    late.completion.has_error = true;
    late.completion.error     = io_error.make(io_error.TIMEOUT, io_error.OP_SEND);
    val timed: transport_api.Completion = transport_api.complete_native[Core](?fixture.driver,
        ?late.completion, clock.instant(4));
    if (timed.send_status != transport_api.SEND_SENT || fixture.core.sent != 2 ||
        fixture.core.timed_out != 0) { ret 9; }

    # nothing out before the cancellation: cancelled, as before
    var none: NativeSend = native_send(?fixture, ?network, ?sender, target.ok, ?output[0], 5);
    if (!none.ok) { ret 10; }
    none.completion.has_error = true;
    none.completion.error     = io_error.make(io_error.CANCELLED, io_error.OP_SEND);
    none.completion.items     = 0;
    none.completion.bytes     = 0;
    val cancelled: transport_api.Completion = transport_api.complete_native[Core](
        ?fixture.driver, ?none.completion, clock.instant(6));
    if (cancelled.send_status != transport_api.SEND_CANCELLED || cancelled.count != 0 ||
        fixture.core.cancelled != 1 || fixture.core.sent != 2) { ret 11; }

    # part of a datagram is not a packet: a timed-out partial stays timed out,
    # and a partial with no error still fails
    var part: NativeSend = native_send(?fixture, ?network, ?sender, target.ok, ?output[0], 7);
    if (!part.ok) { ret 12; }
    part.completion.has_error = true;
    part.completion.error     = io_error.make(io_error.TIMEOUT, io_error.OP_SEND);
    part.completion.items     = 0;
    part.completion.bytes     = part.length - 1;
    val partial: transport_api.Completion = transport_api.complete_native[Core](
        ?fixture.driver, ?part.completion, clock.instant(8));
    if (partial.send_status != transport_api.SEND_TIMED_OUT || partial.count != 0 ||
        fixture.core.timed_out != 1 || fixture.core.sent != 2) { ret 13; }
    var short: NativeSend = native_send(?fixture, ?network, ?sender, target.ok, ?output[0], 9);
    if (!short.ok) { ret 14; }
    short.completion.bytes = short.length - 1;
    val failed: transport_api.Completion = transport_api.complete_native[Core](
        ?fixture.driver, ?short.completion, clock.instant(10));
    if (failed.send_status != transport_api.SEND_FAILED || failed.count != 0 ||
        fixture.core.failed != 1 || fixture.core.sent != 2) { ret 15; }
    # the failed datagram is generated again and goes out
    val retried: transport_api.Generated = transport_api.generate[Core](?fixture.driver,
        ?fixture.scope, ?output[0], 8, clock.instant(11), 10);
    if (retried.status != transport_api.STATUS_OK ||
        transport_api.complete_send[Core](?fixture.driver, retried.token,
        transport_api.SEND_SENT, retried.count, clock.instant(12)).status !=
        transport_api.STATUS_OK) { ret 20; }

    udp.socket_close(?sender);
    udp.socket_close(?receiver);
    val destroyed: err[io_error.Error] = net_async.destroy(?network);
    if (sel destroyed.err) { ret 16; }
    val closed: res[bool, io_error.Error] = io_runtime.close(?runtime);
    if (sel closed.err) { ret 17; }
    val released: err[io_error.Error] = io_runtime.destroy(?runtime);
    if (sel released.err)             { ret 18; }
    if (!close_fixture(?fixture, 13)) { ret 19; }
    ret 0;
}

test transport__a_settled_close_answers_closed_to_every_later_call {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 131, stream_api.ROLE_CLIENT)) { ret 1; }
    fixture.core.outbound = 1;
    var buffer: [8]u8;
    val first:  transport_api.Generated = transport_api.generate[Core](
        ?fixture.driver, ?fixture.scope, ?buffer[0], 8, clock.instant(1), 1);
    if (first.status != transport_api.STATUS_OK ||
        transport_api.complete_send[Core](?fixture.driver, first.token,
        transport_api.SEND_SENT, first.count, clock.instant(2)).status !=
        transport_api.STATUS_OK ||
        transport_api.begin_close[Core](?fixture.driver, 0, nil, 0,
        clock.instant(3)).status != transport_api.STATUS_OK ||
        transport_api.finish_close[Core](?fixture.driver).status !=
        transport_api.STATUS_OK ||
        transport_api.snapshot[Core](?fixture.driver).state != transport_api.CLOSED) {
        ret 2;
    }
    val again: transport_api.OperationResult = transport_api.begin_close[Core](
        ?fixture.driver, 0, nil, 0, clock.instant(4));
    if (again.status != transport_api.STATUS_CLOSED || again.error != transport_api.ERROR_NONE ||
        again.state != transport_api.CLOSED) { ret 3; }
    var reason:      [4]u8;
    val with_reason: transport_api.OperationResult = transport_api.begin_close[Core](
        ?fixture.driver, 7, ?reason[0], 4, clock.instant(5));
    if (with_reason.status != transport_api.STATUS_CLOSED) { ret 4; }
    val generated: transport_api.Generated = transport_api.generate[Core](
        ?fixture.driver, ?fixture.scope, ?buffer[0], 8, clock.instant(6), 1);
    if (generated.status != transport_api.STATUS_CLOSED) { ret 5; }
    var datagram: transport_api.Datagram;
    datagram.data        = ?buffer[0];
    datagram.length      = 8;
    datagram.received_at = clock.instant(7);
    val received: transport_api.OperationResult = transport_api.receive_datagram[Core](
        ?fixture.driver, ?datagram);
    if (received.status != transport_api.STATUS_CLOSED) { ret 6; }
    if (transport_api.open_stream[Core](?fixture.driver,
        transport_api.BIDIRECTIONAL).status != transport_api.STATUS_CLOSED) { ret 7; }
    if (transport_api.send_datagram[Core](?fixture.driver, ?buffer[0], 8).status !=
        transport_api.STATUS_CLOSED) { ret 8; }
    if (!transport_api.release_ready[Core](?fixture.driver) ||
        transport_api.release_closed[Core](?fixture.driver).status !=
        transport_api.STATUS_OK || !operation_ok(cancel.destroy(?fixture.scope))) { ret 9; }
    ret 0;
}

fun pending(fixture: *Fixture, now_ns: u64) bool {
    ret transport_api.pending_output[Core](?fixture.driver, clock.instant(now_ns));
}

test transport__the_driver_answers_for_output_it_would_refuse_and_for_a_recorded_cancellation {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 112, stream_api.ROLE_CLIENT)) { ret 1; }
    var buffers: [5][16]u8;
    fixture.core.outbound = 0;
    if (pending(?fixture, 10)) { ret 2; }
    fixture.core.outbound = 6;
    if (!pending(?fixture, 10)) { ret 3; }
    # every send slot taken leaves nothing generate could send into
    var tokens: [4]transport_api.Token;
    var i:      usize = 0;
    for (i < 4) {
        val generated: transport_api.Generated = transport_api.generate[Core](?fixture.driver,
            ?fixture.scope, ?buffers[i][0], 16, clock.instant(10), 0);
        if (generated.status != transport_api.STATUS_OK) { ret 4; }
        tokens[i] = generated.token;
        i         = i + 1;
    }
    if (pending(?fixture, 10) || transport_api.generate[Core](?fixture.driver, ?fixture.scope,
        ?buffers[4][0], 16, clock.instant(10), 0).status != transport_api.STATUS_BLOCKED) { ret 5; }
    if (transport_api.complete_send[Core](?fixture.driver, tokens[0], transport_api.SEND_SENT,
        5, clock.instant(11)).status != transport_api.STATUS_OK || !pending(?fixture, 11)) { ret 6; }
    # an instant before the driver's last call is refused, as generate refuses it
    if (pending(?fixture, 10)) { ret 7; }
    # a recorded cancellation is work for the next call, which applies it and
    # closes abortively, so nothing is pending once it has
    if (!transition_ok(cancel.cancel(?fixture.scope)) || !pending(?fixture, 11) ||
        fixture.core.closing) { ret 8; }
    if (transport_api.generate[Core](?fixture.driver, ?fixture.scope, ?buffers[4][0], 16,
        clock.instant(11), 0).status != transport_api.STATUS_CLOSED ||
        !fixture.core.abortive || pending(?fixture, 11)) { ret 9; }
    ret 0;
}
