use quic.clock;
use quic.connection.ownership;
use quic.storage.limited;
use supply:        quic.storage.source;
use datagram_api:  quic.stream.datagram;
use stream_api:    quic.stream.stream;
use transport_api: quic.transport;

use std.allocator;
use std.allocator.page;
use std.chrono.time;
use io_error:     std.io.error;
use io_lifecycle: std.io.lifecycle;
use io_runtime:   std.io.runtime;
use std.memory.buffers;
use net_async: std.net.async;
use net_types: std.net.async.types;
use std.net.ip;
use std.net.udp;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.thread;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

rec Core {
    driver:            *transport_api.Driver[Core];
    streams:           *stream_api.Manager;
    datagrams:         *datagram_api.Queue;
    outbound:          usize;
    storage_wakes:     usize;
    next_owner:        u64;
    active_owners:     [64]bool;
    active_count:      usize;
    received:          usize;
    completed:         usize;
    sent:              usize;
    sent_bytes:        usize;
    failed:            usize;
    cancelled:         usize;
    timed_out:         usize;
    timer_deadline_ns: u64;
    timer_generation:  u64;
    timer_armed:       bool;
    closing:           bool;
    abortive:          bool;
    closed:            bool;
    oversize:          bool;
    reentry_rejected:  bool;
}

rec Fixture {
    stream_records:  [32]stream_api.Stream;
    chunks:          supply.TestPool;
    account:         supply.Account;
    attempts:        [64]stream_api.Attempt;
    streams:         stream_api.Manager;
    send_entries:    [8]datagram_api.Entry;
    receive_entries: [8]datagram_api.Entry;
    datagrams:       datagram_api.Queue;
    sends:           [4]transport_api.SendSlot;
    core:            Core;
    scope:           cancel.Scope;
    driver:          transport_api.Driver[Core];
}

fun stream_config(source: u64, role: u8) stream_api.Config {
    var value: stream_api.Config;
    value.source                            = source;
    value.role                              = role;
    value.local_bidirectional_limit         = 32;
    value.local_unidirectional_limit        = 32;
    value.peer_bidirectional_limit          = 32;
    value.peer_unidirectional_limit         = 32;
    value.send_max_data                     = 1024;
    value.receive_max_data                  = 1024;
    value.send_local_bidirectional_limit    = 32;
    value.send_peer_bidirectional_limit     = 32;
    value.send_unidirectional_limit         = 32;
    value.receive_local_bidirectional_limit = 32;
    value.receive_peer_bidirectional_limit  = 32;
    value.receive_unidirectional_limit      = 32;
    ret value;
}

# a literal that omits a field leaves the previous frame's contents there rather
# than zero (briar-systems/mach#3108), so every result names all four
# the protocol answers for its own memory, because a context the driver cannot
# cast to bytes is the whole reason the entry exists
fun core_range(core: *Core) ownership.Range {
    ret ownership.record[Core](core);
}

fun core_outcome(status: u8, error: u64, state: u8) transport_api.CoreResult {
    ret transport_api.CoreResult{status: status, error: error,
        provider_error: 0, state: state};
}

fun core_result(status: u8, state: u8) transport_api.CoreResult {
    ret core_outcome(status, 0, state);
}

fun core_receive(core: *Core, input: *transport_api.CoreInput) transport_api.CoreResult {
    if (core.closed || input == nil || input.length == 0 || input.data == nil) {
        ret core_outcome(transport_api.STATUS_ERROR, 1, transport_api.ACTIVE);
    }
    val command: u8 = input.data[0];
    if (command == 1) {
        core.received = core.received + 1;
        ret core_result(transport_api.STATUS_OK, transport_api.ACTIVE);
    }
    if (command == 2 && input.length >= 4) {
        val id:       u64                      = input.data[1]::u64;
        val offset:   u64                      = input.data[2]::u64;
        val fin:      bool                     = input.data[3] != 0;
        val received: stream_api.ReceiveResult = stream_api.receive_stream(core.streams,
            id, offset, ?input.data[4], input.length - 4, fin);
        if (!received.ok) {
            ret core_outcome(transport_api.STATUS_ERROR, received.error::u64, transport_api.ACTIVE);
        }
        core.received = core.received + 1;
        ret core_result(transport_api.STATUS_OK, transport_api.ACTIVE);
    }
    if (command == 3) {
        val received: datagram_api.QueueResult = datagram_api.receive(core.datagrams,
            ?input.data[1], input.length - 1, input.length);
        if (!received.ok) {
            ret core_outcome(transport_api.STATUS_ERROR, received.error::u64, transport_api.ACTIVE);
        }
        core.received = core.received + 1;
        ret core_result(transport_api.STATUS_OK, transport_api.ACTIVE);
    }
    if (command == 4 && input.length == 2) {
        core.outbound = core.outbound + input.data[1]::usize;
        core.received = core.received + 1;
        ret core_result(transport_api.STATUS_OK, transport_api.ACTIVE);
    }
    if (command == 5 && input.length == 2) {
        core.timer_generation  = core.timer_generation + 1;
        core.timer_deadline_ns = input.data[1]::u64;
        core.timer_armed       = true;
        core.received          = core.received + 1;
        ret core_result(transport_api.STATUS_OK, transport_api.ACTIVE);
    }
    if (command == 6 && core.driver != nil) {
        val reentered: transport_api.OperationResult = transport_api.begin_close[Core](
            core.driver, 0, nil, 0, clock.instant(input.received_at_ns));
        core.reentry_rejected = reentered.status == transport_api.STATUS_ERROR &&
            reentered.error == transport_api.ERROR_STATE;
        core.driver.config.max_udp_payload = 1;
        ret core_result(transport_api.STATUS_OK, transport_api.ACTIVE);
    }
    ret core_outcome(transport_api.STATUS_ERROR, 2, transport_api.ACTIVE);
}

fun core_timeout(core: *Core, generation: u64, now_ns: u64) transport_api.CoreResult {
    if (!core.timer_armed || core.timer_generation != generation ||
        now_ns < core.timer_deadline_ns) {
        ret core_outcome(transport_api.STATUS_ERROR, 3, transport_api.ACTIVE);
    }
    core.timer_armed      = false;
    core.timer_generation = core.timer_generation + 1;
    core.outbound         = core.outbound + 1;
    ret core_result(transport_api.STATUS_OK, transport_api.ACTIVE);
}

fun core_generate(core: *Core, output: *u8, capacity: usize,
    now_ns: u64) transport_api.CoreDatagram {
    var result: transport_api.CoreDatagram;
    result.state = transport_api.ACTIVE;
    if (core.outbound == 0) {
        result.status = transport_api.STATUS_EMPTY;
        ret result;
    }
    if (core.oversize) {
        result.status = transport_api.STATUS_OK;
        result.count  = capacity + 1;
        ret result;
    }
    if (output == nil || capacity < 5 || core.next_owner == 0 - 1::u64) {
        result.status = transport_api.STATUS_BLOCKED;
        result.error  = 4;
        ret result;
    }
    val owner: u64   = core.next_owner;
    val index: usize = (owner % 64)::usize;
    if (core.active_owners[index]) {
        result.status = transport_api.STATUS_BLOCKED;
        result.error  = 5;
        ret result;
    }
    output[0]                 = 1;
    output[1]                 = owner::u8;
    output[2]                 = (owner >> 8)::u8;
    output[3]                 = now_ns::u8;
    output[4]                 = 0xa5;
    core.active_owners[index] = true;
    core.active_count         = core.active_count + 1;
    core.next_owner           = core.next_owner + 1;
    core.outbound             = core.outbound - 1;
    result.status             = transport_api.STATUS_OK;
    result.owner              = owner;
    result.count              = 5;
    result.local              = ip.endpoint(127, 0, 0, 1, 4433);
    result.peer               = ip.endpoint(127, 0, 0, 1, 4434);
    ret result;
}

fun core_complete(core: *Core, owner: u64, status: u8, count: usize,
    now_ns: u64) transport_api.CoreResult {
    val index: usize = (owner % 64)::usize;
    if (!core.active_owners[index] || count > 5 || now_ns == 0 - 1::u64) {
        ret core_outcome(transport_api.STATUS_ERROR, 6, transport_api.ACTIVE);
    }
    core.active_owners[index] = false;
    core.active_count         = core.active_count - 1;
    core.completed            = core.completed + 1;
    if (status == transport_api.SEND_SENT) {
        core.sent       = core.sent + 1;
        core.sent_bytes = core.sent_bytes + count;
    }
    if (status == transport_api.SEND_FAILED) {
        core.failed = core.failed + 1;
        if (!core.closing) { core.outbound = core.outbound + 1; }
    }
    if (status == transport_api.SEND_CANCELLED) { core.cancelled = core.cancelled + 1; }
    if (status == transport_api.SEND_TIMED_OUT) { core.timed_out = core.timed_out + 1; }
    var state: u8 = transport_api.ACTIVE;
    if (core.closing) { state = transport_api.DRAINING; }
    ret core_result(transport_api.STATUS_OK, state);
}

fun core_begin_close(core: *Core, abortive: bool, application_error: u64,
    reason: *u8, reason_length: usize, now_ns: u64) transport_api.CoreResult {
    if (reason_length > 0 && reason == nil) {
        ret core_outcome(transport_api.STATUS_ERROR, application_error + now_ns, transport_api.ACTIVE);
    }
    core.closing = true;
    if (abortive) {
        core.abortive = true;
        core.outbound = 0;
    }
    ret core_result(transport_api.STATUS_OK, transport_api.DRAINING);
}

fun core_storage_ready(core: *Core) {
    core.storage_wakes = core.storage_wakes + 1;
}

fun core_ready(core: *Core) bool {
    ret core.closing && core.active_count == 0 && core.outbound == 0;
}

fun core_finish(core: *Core) bool {
    if (!core_ready(core)) { ret false; }
    if (stream_api.finish_close(core.streams).status != stream_api.STATUS_OK ||
        datagram_api.finish_close(core.datagrams).status !=
        datagram_api.STATUS_OK) { ret false; }
    core.closed = true;
    ret true;
}

# what core_generate would answer, given a buffer it accepts
fun core_pending(core: *Core, now_ns: u64) bool {
    ret core.outbound != 0 && !core.oversize && core.next_owner != 0 - 1::u64 &&
        !core.active_owners[(core.next_owner % 64)::usize];
}

fun core_timer(core: *Core) transport_api.CoreTimer {
    ret transport_api.CoreTimer{deadline_ns: core.timer_deadline_ns,
        generation: core.timer_generation, armed: core.timer_armed};
}

fun make_fixture(fixture: *Fixture, source: u64, role: u8) bool {
    # a fixture made again reuses its record, so its previous pool goes first
    if (supply.test_made(?fixture.chunks)) {
        if ((fixture.account.open &&
            !supply.close(?fixture.chunks.provider, ?fixture.account)) ||
            !supply.end_test(?fixture.chunks)) { ret false; }
    }
    if (!supply.make_test(?fixture.chunks, 512) ||
        !supply.open(?fixture.chunks.provider, ?fixture.account, source, 256, 256, 0)) {
        ret false;
    }
    val stream_storage: stream_api.Storage = stream_api.Storage{
        streams:  ?fixture.stream_records[0], stream_capacity: 32,
        attempts: ?fixture.attempts[0], attempt_capacity: 64,
        chunks:   ?fixture.chunks.provider, account: ?fixture.account, send_buffer_limit: 32
    };
    if (!stream_api.initialize(?fixture.streams,
        stream_config(source, role), stream_storage)) { ret false; }
    val datagram_storage: datagram_api.Storage = datagram_api.Storage{
        send_entries:     ?fixture.send_entries[0], send_capacity: 8,
        send_stride:      64, receive_entries: ?fixture.receive_entries[0],
        receive_capacity: 8, receive_stride: 64,
        chunks:           ?fixture.chunks.provider, account: ?fixture.account
    };
    if (!datagram_api.initialize(?fixture.datagrams,
        datagram_api.Config{source: source, peer_max_frame_size: 65,
        local_max_frame_size: 65, enabled: true}, datagram_storage)) { ret false; }
    var candidate: Core;
    candidate.streams          = ?fixture.streams;
    candidate.datagrams        = ?fixture.datagrams;
    candidate.driver           = ?fixture.driver;
    candidate.next_owner       = 1;
    candidate.timer_generation = 1;
    fixture.core               = candidate;
    if (!operation_ok(cancel.make_root(?fixture.scope, opt[time.Instant].none{}))) { ret false; }
    val protocol: transport_api.Protocol[Core] = transport_api.Protocol[Core]{
        context:       ?fixture.core, context_range: core_range,
        receive:       core_receive, timeout: core_timeout,
        generate:      core_generate, complete_send: core_complete,
        begin_close:   core_begin_close, close_ready: core_ready,
        finish_close:  core_finish, timer: core_timer,
        storage_ready: core_storage_ready, pending_output: core_pending
    };
    val config: transport_api.Config = transport_api.Config{source: source,
        max_udp_payload: 1500, max_close_reason: 64};
    val storage: transport_api.Storage = transport_api.Storage{
        sends: ?fixture.sends[0], send_capacity: 4
    };
    if (role == stream_api.ROLE_CLIENT) {
        ret transport_api.init_client[Core](?fixture.driver, config, protocol,
            ?fixture.streams, ?fixture.datagrams, ?fixture.scope, storage);
    }
    ret transport_api.init_server[Core](?fixture.driver, config, protocol,
        ?fixture.streams, ?fixture.datagrams, ?fixture.scope, storage);
}

fun input(driver: *transport_api.Driver[Core], bytes: *u8, length: usize,
    now_ns: u64) transport_api.OperationResult {
    var datagram: transport_api.Datagram;
    datagram.local       = ip.endpoint(127, 0, 0, 1, 4433);
    datagram.peer        = ip.endpoint(127, 0, 0, 1, 4434);
    datagram.data        = bytes;
    datagram.length      = length;
    datagram.received_at = clock.instant(now_ns);
    ret transport_api.receive_datagram[Core](driver, ?datagram);
}

fun close_fixture(fixture: *Fixture, now_ns: u64) bool {
    if (transport_api.snapshot[Core](?fixture.driver).state != transport_api.DRAINING) {
        if (transport_api.begin_close[Core](?fixture.driver, 0, nil, 0, clock.instant(now_ns)).status !=
            transport_api.STATUS_OK) { ret false; }
    }
    if (transport_api.finish_close[Core](?fixture.driver).status != transport_api.STATUS_OK) { ret false; }
    ret operation_ok(cancel.destroy(?fixture.scope));
}

test transport__client_and_server_expose_only_application_contracts {
    var client: Fixture;
    var server: Fixture;
    if (!make_fixture(?client, 101, stream_api.ROLE_CLIENT) ||
        !make_fixture(?server, 102, stream_api.ROLE_SERVER)) { ret 1; }
    var active: [1]u8 = [1]u8{1};
    if (input(?client.driver, ?active[0], 1, 1).state != transport_api.ACTIVE ||
        input(?server.driver, ?active[0], 1, 1).state != transport_api.ACTIVE) { ret 2; }
    val opened: transport_api.OpenResult = transport_api.open_stream[Core](?client.driver,
        transport_api.BIDIRECTIONAL);
    var original: [4]u8 = [4]u8{'h', '3', '-', 'x'};
    if (opened.status != transport_api.STATUS_OK || opened.stream.id != 0 ||
        transport_api.write_stream[Core](?client.driver, opened.stream, ?original[0], 4).count != 4 ||
        transport_api.finish_stream[Core](?client.driver, opened.stream).status != transport_api.STATUS_OK) { ret 3; }
    original[0] = 'z';
    var remote: [9]u8 = [9]u8{2, 1, 0, 1, 'h', 'e', 'l', 'l', 'o'};
    if (input(?client.driver, ?remote[0], 9, 2).status != transport_api.STATUS_OK) { ret 4; }
    val accepted: transport_api.OpenResult = transport_api.accept_stream[Core](?client.driver);
    var output:   [8]u8;
    val read:     transport_api.ReadResult = transport_api.read_stream[Core](?client.driver,
        accepted.stream, ?output[0], 8);
    if (accepted.status != transport_api.STATUS_OK || accepted.stream.id != 1 ||
        read.status != transport_api.STATUS_OK || read.count != 5 || !read.fin ||
        output[0] != 'h' || output[4] != 'o' ||
        read.receive_uncredited != 5) { ret 5; }
    var stale: transport_api.Stream = accepted.stream;
    stale.generation = stale.generation + 1;
    val unsettled: transport_api.OperationResult =
        transport_api.release_stream[Core](?client.driver, accepted.stream);
    val rejected: transport_api.OperationResult =
        transport_api.release_stream[Core](?client.driver, stale);
    if (unsettled.status != transport_api.STATUS_BLOCKED ||
        unsettled.error != transport_api.ERROR_NONE ||
        unsettled.protocol_error != 0 ||
        rejected.status != transport_api.STATUS_STALE ||
        rejected.error != transport_api.ERROR_TOKEN) { ret 11; }
    if (transport_api.credit_stream[Core](?client.driver, accepted.stream, 6).status ==
        transport_api.STATUS_OK ||
        transport_api.credit_stream[Core](?client.driver, accepted.stream, 5).status !=
        transport_api.STATUS_OK ||
        transport_api.stream_snapshot[Core](?client.driver,
        accepted.stream).receive_uncredited != 0) { ret 9; }
    val credited: transport_api.ReadResult = transport_api.read_stream[Core](
        ?client.driver, accepted.stream, ?output[0], 8);
    if (credited.receive_max_data != read.receive_max_data + 5 ||
        credited.receive_uncredited != 0) { ret 10; }
    var message: [4]u8 = [4]u8{3, 'd', 'g', 'm'};
    if (input(?client.driver, ?message[0], 4, 3).status != transport_api.STATUS_OK) { ret 6; }
    val delivered: transport_api.ReceivedDatagram = transport_api.next_datagram[Core](?client.driver);
    if (delivered.status != transport_api.STATUS_OK || delivered.data.length != 3 ||
        delivered.data.data[0] != 'd' || transport_api.release_datagram[Core](?client.driver,
        delivered.token).status != transport_api.STATUS_OK) { ret 7; }
    if (!close_fixture(?client, 4) || !close_fixture(?server, 2)) { ret 8; }
    ret 0;
}

test transport__output_saturation_loss_reordering_and_stale_tokens_preserve_ownership {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 103, stream_api.ROLE_CLIENT)) { ret 1; }
    var queue: [2]u8 = [2]u8{4, 4};
    if (input(?fixture.driver, ?queue[0], 2, 1).status != transport_api.STATUS_OK) { ret 2; }
    var buffers:   [5][8]u8;
    var generated: [4]transport_api.Generated;
    var i:         usize = 0;
    for (i < 4) {
        generated[i] = transport_api.generate[Core](?fixture.driver, ?fixture.scope,
            ?buffers[i][0], 8, clock.instant(2 + i::u64), 10 + i);
        if (generated[i].status != transport_api.STATUS_OK || generated[i].count != 5 ||
            transport_api.operation_snapshot[Core](?fixture.driver, generated[i].token).buffer !=
            ?buffers[i][0]) { ret 3; }
        i = i + 1;
    }
    if (transport_api.generate[Core](?fixture.driver, ?fixture.scope, ?buffers[4][0], 8,
        clock.instant(6), 99).status != transport_api.STATUS_BLOCKED) { ret 4; }
    if (transport_api.complete_send[Core](?fixture.driver, generated[2].token,
        transport_api.SEND_FAILED, 0, clock.instant(7)).status != transport_api.STATUS_OK ||
        transport_api.complete_send[Core](?fixture.driver, generated[0].token,
        transport_api.SEND_SENT, 5, clock.instant(8)).status != transport_api.STATUS_OK ||
        transport_api.cancel_send[Core](?fixture.driver, generated[3].token, clock.instant(9)).status !=
        transport_api.STATUS_OK ||
        transport_api.complete_send[Core](?fixture.driver, generated[1].token,
        transport_api.SEND_TIMED_OUT, 0, clock.instant(10)).status != transport_api.STATUS_OK) { ret 5; }
    if (transport_api.complete_send[Core](?fixture.driver, generated[0].token,
        transport_api.SEND_SENT, 5, clock.instant(11)).status != transport_api.STATUS_STALE ||
        fixture.core.failed != 1 || fixture.core.cancelled != 1 ||
        fixture.core.timed_out != 1 || fixture.core.active_count != 0) { ret 6; }
    val retried: transport_api.Generated = transport_api.generate[Core](?fixture.driver,
        ?fixture.scope, ?buffers[4][0], 8, clock.instant(12), 77);
    if (retried.status != transport_api.STATUS_OK ||
        transport_api.cancel_send[Core](?fixture.driver, retried.token, clock.instant(13)).status !=
        transport_api.STATUS_OK) { ret 7; }
    fixture.core.outbound = 0;
    if (!close_fixture(?fixture, 14)) { ret 8; }
    ret 0;
}

test transport__terminal_release_preserves_generations_across_record_reuse {
    var fixture: Fixture;
    if (!make_fixture(?fixture, 119, stream_api.ROLE_CLIENT)) { ret 1; }
    if (transport_api.release_closed[Core](?fixture.driver).status !=
        transport_api.STATUS_ERROR || !fixture.driver.initialized ||
        fixture.driver.released) { ret 2; }
    fixture.core.outbound = 1;
    var first_buffer: [8]u8;
    val first:        transport_api.Generated = transport_api.generate[Core](
        ?fixture.driver, ?fixture.scope, ?first_buffer[0], 8, clock.instant(1), 1);
    if (first.status != transport_api.STATUS_OK ||
        transport_api.complete_send[Core](?fixture.driver, first.token,
        transport_api.SEND_SENT, first.count, clock.instant(2)).status !=
        transport_api.STATUS_OK ||
        transport_api.begin_close[Core](?fixture.driver, 0, nil, 0, clock.instant(3)).status !=
        transport_api.STATUS_OK ||
        transport_api.release_closed[Core](?fixture.driver).status !=
        transport_api.STATUS_ERROR || !fixture.driver.initialized ||
        transport_api.finish_close[Core](?fixture.driver).status !=
        transport_api.STATUS_OK) { ret 3; }
    fixture.driver.cancellation_calls = 1;
    if (transport_api.release_closed[Core](?fixture.driver).status !=
        transport_api.STATUS_BLOCKED || !fixture.driver.initialized ||
        fixture.driver.protocol.context != ?fixture.core) { ret 7; }
    fixture.driver.cancellation_calls = 0;
    if (!transport_api.release_ready[Core](?fixture.driver) ||
        transport_api.release_closed[Core](?fixture.driver).status !=
        transport_api.STATUS_OK || fixture.driver.initialized ||
        !fixture.driver.released || fixture.sends[first.token.index::usize].generation !=
        first.token.generation ||
        fixture.sends[first.token.index::usize].token.source != 0 ||
        fixture.sends[first.token.index::usize].packet.buffer != nil ||
        transport_api.release_closed[Core](?fixture.driver).status !=
        transport_api.STATUS_OK || !operation_ok(cancel.destroy(?fixture.scope))) { ret 4; }
    if (!make_fixture(?fixture, 119, stream_api.ROLE_CLIENT)) { ret 5; }
    fixture.core.outbound = 1;
    var second_buffer: [8]u8;
    val second:        transport_api.Generated = transport_api.generate[Core](
        ?fixture.driver, ?fixture.scope, ?second_buffer[0], 8, clock.instant(4), 2);
    if (second.status != transport_api.STATUS_OK ||
        second.token.index != first.token.index ||
        second.token.generation == first.token.generation ||
        transport_api.complete_send[Core](?fixture.driver, first.token,
        transport_api.SEND_SENT, first.count, clock.instant(5)).status !=
        transport_api.STATUS_STALE ||
        transport_api.complete_send[Core](?fixture.driver, second.token,
        transport_api.SEND_SENT, second.count, clock.instant(6)).status !=
        transport_api.STATUS_OK || !close_fixture(?fixture, 7)) { ret 6; }
    ret 0;
}

