# the production Protocol: the vtable that joins connection.core to the driver
#
# this is what the untyped context made unconstructable. every core operation
# takes the public record and the secret-welded Secrets together, and a
# *Secrets cannot be erased to `ptr`, so a vtable with an opaque context could
# only ever be implemented by a test double whose context holds no secrets.
# with Protocol[T] the context is simply typed and the binding is thin.

use core_api: quic.connection.core;
use quic.connection.ownership;
use quic.connection.scratch;
use transport_api: quic.transport;

use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val ROUTING_ID_CAPACITY: usize = 1;
pub val ROUTING_ID_LENGTH:   usize = 20;

pub rec RoutingId {
    data:   [20]u8;
    length: usize;
}

pub rec Route {
    source:     u64;
    index:      usize;
    generation: u64;
    sequence:   u64;
    id:         RoutingId;
    active:     bool;
}

pub rec RoutingSnapshot {
    source:      u64;
    capacity:    usize;
    active:      usize;
    initialized: bool;
}

rec RoutingEntry {
    id:       RoutingId;
    sequence: u64;
    epoch:    i64;
    prepared: bool;
}

# holds the pointers the core's operations take and the pump's scratch pair,
# lent to the core around each call. it is the protocol context, so it must
# stay disjoint from the driver record the transport validates it against
pub rec Binding {
    anchor:         u64;
    core:           *core_api.Core;
    secrets:        *core_api.Secrets;
    scratch:        *scratch.Scratch;
    secret_scratch: *scratch.SecretScratch;
    routing:        [1]RoutingEntry;
    routing_source: u64;
    initialized:    bool;
    released:       bool;
}

fun next_epoch(value: i64) i64 {
    var next: i64 = value + 1;
    if (next <= 0) { next = 1; }
    ret next;
}

fun route_active(entry: *RoutingEntry) bool {
    ret entry != nil && (atomic.load(?entry.epoch) & 1) == 1;
}

fun retire_routes(binding: *Binding) {
    var i: usize = 0;
    for (i < ROUTING_ID_CAPACITY) {
        val entry: *RoutingEntry = ?binding.routing[i];
        val epoch: i64           = atomic.load(?entry.epoch);
        if ((epoch & 1) == 1) {
            atomic.store(?entry.epoch, next_epoch(epoch));
        }
        i = i + 1;
    }
}

fun bound(binding: *Binding) bool {
    ret binding != nil && binding.initialized && binding.core != nil &&
        binding.secrets != nil && binding.scratch != nil &&
        binding.secret_scratch != nil;
}

fun lend(binding: *Binding) bool {
    ret scratch.lend(binding.scratch, binding.secret_scratch,
        binding.routing_source);
}

fun give_back(binding: *Binding) {
    scratch.give_back(binding.scratch, binding.secret_scratch,
        binding.routing_source);
}

# the scratch is in use by another call: nothing ran and nothing changed
fun busy(binding: *Binding) transport_api.CoreResult {
    var value: transport_api.CoreResult;
    value.status  = transport_api.STATUS_ERROR;
    value.state   = binding.core.state;
    value.refusal = transport_api.ERROR_STATE;
    ret value;
}

fun busy_datagram(binding: *Binding) transport_api.CoreDatagram {
    var value: transport_api.CoreDatagram;
    value.status  = transport_api.STATUS_ERROR;
    value.state   = binding.core.state;
    value.refusal = transport_api.ERROR_STATE;
    ret value;
}

fun refused() transport_api.CoreResult {
    var value: transport_api.CoreResult;
    value.status         = transport_api.STATUS_ERROR;
    value.error          = core_api.INTERNAL_ERROR;
    value.provider_error = 0;
    value.state          = transport_api.DRAINING;
    ret value;
}

fun refused_datagram() transport_api.CoreDatagram {
    var value: transport_api.CoreDatagram;
    value.status = transport_api.STATUS_ERROR;
    value.error  = core_api.INTERNAL_ERROR;
    value.state  = transport_api.DRAINING;
    ret value;
}

fun binding_range(binding: *Binding) ownership.Range {
    if (binding == nil) {
        var empty: ownership.Range;
        ret empty;
    }
    ret ownership.anchored_record[Binding, u64](?binding.anchor,
        $offset_of(Binding, anchor));
}

fun on_receive(binding: *Binding,
    input: *transport_api.CoreInput) transport_api.CoreResult {
    if (!bound(binding)) { ret refused(); }
    if (!lend(binding))  { ret busy(binding); }
    val result: transport_api.CoreResult = core_api.receive(binding.core,
        binding.secrets, input);
    give_back(binding);
    ret result;
}

fun on_timeout(binding: *Binding, generation: u64,
    now_ns: u64) transport_api.CoreResult {
    if (!bound(binding)) { ret refused(); }
    if (!lend(binding))  { ret busy(binding); }
    val result: transport_api.CoreResult = core_api.on_timeout(binding.core,
        binding.secrets, generation, now_ns);
    give_back(binding);
    ret result;
}

fun on_generate(binding: *Binding, output: *u8, capacity: usize,
    now_ns: u64) transport_api.CoreDatagram {
    if (!bound(binding)) { ret refused_datagram(); }
    if (!lend(binding))  { ret busy_datagram(binding); }
    val result: transport_api.CoreDatagram = core_api.generate(binding.core,
        binding.secrets, output, capacity, now_ns);
    give_back(binding);
    ret result;
}

fun on_complete_send(binding: *Binding, owner: u64,
    status: transport_api.SendStatus, count: usize,
    now_ns: u64) transport_api.CoreResult {
    if (!bound(binding)) { ret refused(); }
    if (!lend(binding))  { ret busy(binding); }
    val result: transport_api.CoreResult = core_api.complete_send(binding.core,
        binding.secrets, owner, status, count, now_ns);
    give_back(binding);
    ret result;
}

fun on_begin_close(binding: *Binding, abortive: bool, application_error: u64,
    reason: *u8, reason_length: usize,
    now_ns: u64) transport_api.CoreResult {
    if (!bound(binding)) { ret refused(); }
    if (!lend(binding))  { ret busy(binding); }
    val result: transport_api.CoreResult = core_api.begin_close(binding.core,
        binding.secrets, abortive, application_error, reason, reason_length,
        now_ns);
    give_back(binding);
    ret result;
}

fun on_close_ready(binding: *Binding) bool {
    if (!bound(binding)) { ret false; }
    ret core_api.close_ready(binding.core);
}

fun on_finish_close(binding: *Binding) bool {
    if (!bound(binding) || !lend(binding)) { ret false; }
    val finished: bool = core_api.finish_close(binding.core, binding.secrets);
    give_back(binding);
    if (!finished) { ret false; }
    retire_routes(binding);
    ret true;
}

fun on_storage_ready(binding: *Binding) {
    if (bound(binding)) { core_api.storage_ready(binding.core); }
}

fun on_timer(binding: *Binding) transport_api.CoreTimer {
    var idle: transport_api.CoreTimer;
    if (!bound(binding)) { ret idle; }
    ret core_api.timer(binding.core);
}

# binds an already-initialized core and the scratch pair its storage points
# into. the core has validated its own ownership set by then, so the binding
# only refuses a core that is not live
pub fun bind(binding: *Binding, core: *core_api.Core,
    secrets: *core_api.Secrets, public: *scratch.Scratch,
    secret: *scratch.SecretScratch) bool {
    if (binding == nil || core == nil || secrets == nil || public == nil ||
        secret == nil || binding.initialized || !core.initialized ||
        core.destroyed || !secrets.initialized || secrets.destroyed ||
        core.config.source == 0) { ret false; }
    binding.anchor         = 1;
    binding.core           = core;
    binding.secrets        = secrets;
    binding.scratch        = public;
    binding.secret_scratch = secret;
    binding.routing_source = core.config.source;
    binding.initialized    = true;
    binding.released       = false;
    ret true;
}

# stages the stable sequence-zero route while it is not externally visible.
# assembly publishes it only after the transport driver is initialized
# a zero-length id publishes a route with an empty key: the connection is
# found by its address, never by a connection id
pub fun prepare_initial_route(binding: *Binding, data: *u8,
    length: usize) bool {
    if (!bound(binding) || (data == nil && length != 0) ||
        length > ROUTING_ID_LENGTH) { ret false; }
    val entry: *RoutingEntry = ?binding.routing[0];
    if (entry.prepared || (atomic.load(?entry.epoch) & 1) == 1) { ret false; }
    var i: usize = 0;
    for (i < length) {
        entry.id.data[i] = data[i];
        i                = i + 1;
    }
    entry.id.length = length;
    entry.sequence  = 0;
    entry.prepared  = true;
    ret true;
}

# rollback retires routes that remained private to a failed assembly init
pub fun abandon_initialization(binding: *Binding) bool {
    if (!bound(binding)) { ret false; }
    retire_routes(binding);
    var i: usize = 0;
    for (i < ROUTING_ID_CAPACITY) {
        val entry: *RoutingEntry = ?binding.routing[i];
        var byte:  usize         = 0;
        for (byte < ROUTING_ID_LENGTH) {
            entry.id.data[byte] = 0;
            byte                = byte + 1;
        }
        entry.id.length = 0;
        entry.sequence  = 0;
        entry.prepared  = false;
        i               = i + 1;
    }
    binding.anchor         = 0;
    binding.core           = nil;
    binding.secrets        = nil;
    binding.scratch        = nil;
    binding.secret_scratch = nil;
    binding.routing_source = 0;
    binding.initialized    = false;
    binding.released       = true;
    ret true;
}

pub fun publish_initial_route(binding: *Binding) bool {
    if (!bound(binding)) { ret false; }
    val entry: *RoutingEntry = ?binding.routing[0];
    val epoch: i64           = atomic.load(?entry.epoch);
    if (!entry.prepared || (epoch & 1) == 1) { ret false; }
    atomic.store(?entry.epoch, next_epoch(epoch));
    ret true;
}

# release is valid only after the production core has destroyed its secrets,
# handshake provider, and every leased manager, and after routing is invisible
pub fun release_ready(binding: *Binding) bool {
    if (binding == nil)       { ret false; }
    if (!binding.initialized) { ret binding.released; }
    if (binding.core == nil || binding.secrets == nil ||
        binding.core.initialized || !binding.core.destroyed ||
        !binding.core.closing || binding.core.state != transport_api.CLOSED ||
        binding.secrets.initialized || !binding.secrets.destroyed ||
        binding.secrets.handshake == nil ||
        binding.secrets.handshake.initialized ||
        !binding.secrets.handshake.destroyed ||
        !binding.secrets.handshake.closing ||
        binding.secrets.handshake.core_lease != 0 ||
        binding.core.cids == nil || binding.core.cids.initialized ||
        !binding.core.cids.closing || binding.core.cids.core_lease != 0 ||
        binding.core.paths == nil || binding.core.paths.valid ||
        !binding.core.paths.closing || binding.core.paths.core_lease != 0 ||
        binding.core.streams == nil || binding.core.streams.valid ||
        !binding.core.streams.closing || binding.core.streams.active_streams != 0 ||
        binding.core.streams.active_attempts != 0 ||
        binding.core.streams.core_lease != 0 || binding.core.datagrams == nil ||
        binding.core.datagrams.valid || !binding.core.datagrams.closing ||
        binding.core.datagrams.send_count != 0 ||
        binding.core.datagrams.delivered_count != 0 ||
        binding.core.datagrams.core_lease != 0) {
        ret false;
    }
    var i: usize = 0;
    for (i < ROUTING_ID_CAPACITY) {
        if (route_active(?binding.routing[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# retired epochs are deliberately preserved so a route from an earlier use of
# the stable record can never validate after the next publication
pub fun release_closed(binding: *Binding) bool {
    if (!release_ready(binding)) { ret false; }
    if (!binding.initialized)    { ret binding.released; }
    var i: usize = 0;
    for (i < ROUTING_ID_CAPACITY) {
        val entry: *RoutingEntry = ?binding.routing[i];
        var byte:  usize         = 0;
        for (byte < ROUTING_ID_LENGTH) {
            entry.id.data[byte] = 0;
            byte                = byte + 1;
        }
        entry.id.length = 0;
        entry.sequence  = 0;
        entry.prepared  = false;
        i               = i + 1;
    }
    binding.anchor         = 0;
    binding.core           = nil;
    binding.secrets        = nil;
    binding.scratch        = nil;
    binding.secret_scratch = nil;
    binding.routing_source = 0;
    binding.initialized    = false;
    binding.released       = true;
    ret true;
}

pub fun routing_snapshot(binding: *Binding) RoutingSnapshot {
    var value: RoutingSnapshot;
    if (!bound(binding)) { ret value; }
    value.source      = binding.routing_source;
    value.capacity    = ROUTING_ID_CAPACITY;
    value.initialized = true;
    var i: usize = 0;
    for (i < ROUTING_ID_CAPACITY) {
        if (route_active(?binding.routing[i])) { value.active = value.active + 1; }
        i = i + 1;
    }
    ret value;
}

pub fun route_at(binding: *Binding, index: usize) Route {
    var value: Route;
    if (!bound(binding) || index >= ROUTING_ID_CAPACITY) { ret value; }
    val entry:  *RoutingEntry = ?binding.routing[index];
    val before: i64           = atomic.load(?entry.epoch);
    if ((before & 1) == 0) { ret value; }
    value.source     = binding.routing_source;
    value.index      = index;
    value.generation = before::u64;
    value.sequence   = entry.sequence;
    value.id         = entry.id;
    val after: i64 = atomic.load(?entry.epoch);
    if (after != before || (after & 1) == 0) {
        var retired: Route;
        ret retired;
    }
    value.active = true;
    ret value;
}

pub fun route_valid(binding: *Binding, route: *Route) bool {
    if (!bound(binding) || route == nil || !route.active ||
        route.source != binding.routing_source ||
        route.index >= ROUTING_ID_CAPACITY) { ret false; }
    val current: Route = route_at(binding, route.index);
    if (!current.active || current.generation != route.generation ||
        current.sequence != route.sequence ||
        current.id.length != route.id.length) { ret false; }
    var i: usize = 0;
    for (i < current.id.length) {
        if (current.id.data[i] != route.id.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an unbound binding yields a vtable with a nil context, which the driver
# rejects, so a protocol cannot be installed over a core that is not there
pub fun protocol(binding: *Binding) transport_api.Protocol[Binding] {
    var value: transport_api.Protocol[Binding];
    if (!bound(binding)) { ret value; }
    value.context       = binding;
    value.context_range = binding_range;
    value.receive       = on_receive;
    value.timeout       = on_timeout;
    value.generate      = on_generate;
    value.complete_send = on_complete_send;
    value.begin_close   = on_begin_close;
    value.close_ready   = on_close_ready;
    value.finish_close  = on_finish_close;
    value.timer         = on_timer;
    value.storage_ready = on_storage_ready;
    ret value;
}
