use std.encoding.binary;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

#[testing]
fun is_err_usize_u8(outcome: res[usize, u8]) bool {
    ret sel outcome.err;
}

fun is_ok_usize_encode(outcome: res[usize, binary.EncodeError]) bool {
    ret sel outcome.ok;
}

#[testing]
fun is_ok_usize_u8(outcome: res[usize, u8]) bool {
    ret sel outcome.ok;
}

pub val MAX: u64 = 4611686018427387903;

pub val STATUS_DONE:  u8 = 1;
pub val STATUS_MORE:  u8 = 2;
pub val STATUS_ERROR: u8 = 3;

pub val ERROR_NONE:        u8 = 0;
pub val ERROR_NON_MINIMAL: u8 = 1;
pub val ERROR_OVERFLOW:    u8 = 2;
pub val ERROR_WIDTH:       u8 = 3;

pub rec Decoded {
    status: u8;
    error:  u8;
    value:  u64;
    width:  u8;
}

fun done(value: u64, width: u8) Decoded {
    var r: Decoded;
    r.status = STATUS_DONE;
    r.value  = value;
    r.width  = width;
    ret r;
}

fun more() Decoded {
    var r: Decoded;
    r.status = STATUS_MORE;
    ret r;
}

fun failed(code: u8) Decoded {
    var r: Decoded;
    r.status = STATUS_ERROR;
    r.error  = code;
    ret r;
}

pub fun width(value: u64) u8 {
    if (value <= 63)         { ret 1; }
    if (value <= 16383)      { ret 2; }
    if (value <= 1073741823) { ret 4; }
    if (value <= MAX)        { ret 8; }
    ret 0;
}

fun valid_width(value: u64, encoded_width: u8) bool {
    if (encoded_width == 1) { ret value <= 63; }
    if (encoded_width == 2) { ret value <= 16383; }
    if (encoded_width == 4) { ret value <= 1073741823; }
    if (encoded_width == 8) { ret value <= MAX; }
    ret false;
}

# reads one rfc 9000 variable-length integer transactionally
pub fun read(d: *binary.Decoder, canonical: bool) Decoded {
    if (d == nil || d.pos > d.len) { ret failed(ERROR_OVERFLOW); }
    if (d.pos == d.len)            { ret more(); }
    if (d.data == nil)             { ret failed(ERROR_OVERFLOW); }

    val first:         u8 = d.data[d.pos];
    val encoded_width: u8 = (1 << (first >> 6))::u8;
    if (encoded_width::usize > d.len - d.pos) { ret more(); }

    var value: u64   = (first & 0x3f)::u64;
    var i:     usize = 1;
    for (i < encoded_width::usize) {
        value = (value << 8) | d.data[d.pos + i]::u64;
        i     = i + 1;
    }

    if (value > MAX) { ret failed(ERROR_OVERFLOW); }
    if (canonical && width(value) != encoded_width) {
        ret failed(ERROR_NON_MINIMAL);
    }

    d.pos = d.pos + encoded_width::usize;
    ret done(value, encoded_width);
}

# writes one variable-length integer atomically, using width 0 for canonical
pub fun write(b: *binary.Builder, value: u64, encoded_width: u8) res[usize, u8] {
    if (b == nil || b.order != binary.BIG) { ret res[usize, u8].err{ERROR_WIDTH}; }
    var actual: u8 = encoded_width;
    if (actual == 0)                 { actual = width(value); }
    if (value > MAX)                 { ret res[usize, u8].err{ERROR_OVERFLOW}; }
    if (!valid_width(value, actual)) { ret res[usize, u8].err{ERROR_WIDTH}; }

    val mark_result: res[binary.Checkpoint, binary.EncodeError] = binary.builder_checkpoint(b);
    if (sel mark_result.err) {
        ret res[usize, u8].err{ERROR_OVERFLOW};
    }
    val mark: binary.Checkpoint = mark_result.ok;

    var encoded: u64 = value;
    if (actual == 2) { encoded = encoded | 0x4000; }
    if (actual == 4) { encoded = encoded | 0x80000000; }
    if (actual == 8) { encoded = encoded | 0xc000000000000000; }

    var ok: bool = false;
    if (actual == 1) {
        ok = is_ok_usize_encode(binary.builder_write_u8(b, encoded::u8));
    }
    if (actual == 2) {
        ok = is_ok_usize_encode(binary.builder_write_u16(b, encoded::u16));
    }
    if (actual == 4) {
        ok = is_ok_usize_encode(binary.builder_write_u32(b, encoded::u32));
    }
    if (actual == 8) {
        ok = is_ok_usize_encode(binary.builder_write_u64(b, encoded));
    }

    if (!ok) {
        binary.builder_rollback(b, mark);
        ret res[usize, u8].err{ERROR_OVERFLOW};
    }
    ret res[usize, u8].ok{b.len};
}

test varint__rfc_9000_vectors_round_trip {
    val values:  [8]u64         = [8]u64{37, 15293, 494878333, 151288809941952652, 63, 16383, 1073741823, MAX};
    var encoded: [64]u8;
    var b:       binary.Builder = binary.builder(?encoded[0], 64, binary.BIG);
    var i:       usize          = 0;
    for (i < 8) {
        val wr: res[usize, u8] = write(?b, values[i], 0);
        if (sel wr.err) { ret 1; }
        i = i + 1;
    }

    var d: binary.Decoder = binary.decoder(?encoded[0], b.len, binary.BIG);
    i = 0;
    for (i < 8) {
        val r: Decoded = read(?d, true);
        if (r.status != STATUS_DONE || r.value != values[i]) { ret 1; }
        i = i + 1;
    }
    if (d.pos != b.len) { ret 1; }
    ret 0;
}

test varint__published_rfc_encodings_decode {
    val bytes:  [15]u8         = [15]u8{0x25, 0x7b, 0xbd, 0x9d, 0x7f, 0x3e, 0x7d, 0xc2, 0x19, 0x7c, 0x5e, 0xff, 0x14, 0xe8, 0x8c};
    val values: [4]u64         = [4]u64{37, 15293, 494878333, 151288809941952652};
    var d:      binary.Decoder = binary.decoder(?bytes[0], 15, binary.BIG);
    var i:      usize          = 0;
    for (i < 4) {
        val r: Decoded = read(?d, true);
        if (r.status != STATUS_DONE || r.value != values[i]) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test varint__truncation_and_canonical_failure_are_transactional {
    val truncated: [3]u8          = [3]u8{0x80, 0, 0};
    var d:         binary.Decoder = binary.decoder(?truncated[0], 3, binary.BIG);
    val missing:   Decoded        = read(?d, false);
    if (missing.status != STATUS_MORE || d.pos != 0) { ret 1; }

    val nonminimal: [2]u8 = [2]u8{0x40, 0x25};
    d = binary.decoder(?nonminimal[0], 2, binary.BIG);
    val rejected: Decoded = read(?d, true);
    if (rejected.status != STATUS_ERROR || rejected.error != ERROR_NON_MINIMAL || d.pos != 0) { ret 1; }
    val accepted: Decoded = read(?d, false);
    if (accepted.status != STATUS_DONE || accepted.value != 37 || d.pos != 2) { ret 1; }
    ret 0;
}

test varint__overflow_and_fixed_buffer_failure_do_not_publish {
    var data: [1]u8;
    var b:    binary.Builder = binary.builder(?data[0], 1, binary.BIG);
    if (is_ok_usize_u8(write(?b, MAX + 1, 0)) || b.len != 0) { ret 1; }
    if (is_ok_usize_u8(write(?b, 64, 0)) || b.len != 0)      { ret 1; }
    if (is_ok_usize_u8(write(?b, 64, 1)) || b.len != 0)      { ret 1; }
    b = binary.builder(?data[0], 1, binary.LITTLE);
    if (is_ok_usize_u8(write(?b, 1, 0)) || b.len != 0) { ret 1; }
    ret 0;
}

test varint__every_byte_boundary_reports_incomplete_transactionally {
    val values: [4]u64 = [4]u64{37, 15293, 494878333, 151288809941952652};
    var i:      usize  = 0;
    for (i < 4) {
        var bytes: [8]u8;
        var b:     binary.Builder = binary.builder(?bytes[0], 8, binary.BIG);
        if (is_err_usize_u8(write(?b, values[i], 0))) { ret 1; }
        var prefix: usize = 0;
        for (prefix < b.len) {
            var d:       binary.Decoder = binary.decoder(?bytes[0], prefix, binary.BIG);
            val decoded: Decoded        = read(?d, false);
            if (decoded.status != STATUS_MORE || d.pos != 0) { ret 1; }
            prefix = prefix + 1;
        }
        i = i + 1;
    }
    ret 0;
}
