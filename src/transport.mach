# bounded public quic connection driver

use quic.clock;
use quic.connection.ownership;
use datagram_api: quic.stream.datagram;
use stream_api:   quic.stream.stream;

use std.chrono.time;
use io_error: std.io.error;
use std.io.lifecycle;
use io_runtime: std.io.runtime;
use net_async:  std.net.async;
use net_types:  std.net.async.types;
use std.net.ip;
use std.net.udp;
use std.sync.atomic;
use std.sync.cancel;
use std.sync.mutex;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

pub def Role: u8;
pub val CLIENT: Role = 1;
pub val SERVER: Role = 2;

pub def ConnectionState: u8;
pub val NEW:         ConnectionState = 1;
pub val HANDSHAKING: ConnectionState = 2;
pub val ACTIVE:      ConnectionState = 3;
pub val CLOSING:     ConnectionState = 4;
pub val DRAINING:    ConnectionState = 5;
pub val CLOSED:      ConnectionState = 6;

pub def Status: u8;
pub val STATUS_OK:        Status = 1;
pub val STATUS_EMPTY:     Status = 2;
pub val STATUS_BLOCKED:   Status = 3;
pub val STATUS_STALE:     Status = 4;
pub val STATUS_CANCELLED: Status = 5;
pub val STATUS_CLOSED:    Status = 6;
pub val STATUS_EARLY:     Status = 7;
pub val STATUS_ERROR:     Status = 8;

pub def Error: u8;
pub val ERROR_NONE:      Error = 0;
pub val ERROR_STATE:     Error = 1;
pub val ERROR_CONFIG:    Error = 2;
pub val ERROR_CAPACITY:  Error = 3;
pub val ERROR_TOKEN:     Error = 4;
pub val ERROR_BUFFER:    Error = 5;
pub val ERROR_TIME:      Error = 6;
pub val ERROR_PROTOCOL:  Error = 7;
pub val ERROR_STREAM:    Error = 8;
pub val ERROR_DATAGRAM:  Error = 9;
pub val ERROR_CANCELLED: Error = 10;
pub val ERROR_NATIVE:    Error = 11;

pub def SendStatus: u8;
pub val SEND_SENT:      SendStatus = 1;
pub val SEND_FAILED:    SendStatus = 2;
pub val SEND_CANCELLED: SendStatus = 3;
pub val SEND_TIMED_OUT: SendStatus = 4;

pub def Direction: u8;
pub val BIDIRECTIONAL:  Direction = 1;
pub val UNIDIRECTIONAL: Direction = 2;

val SLOT_FREE:      u8 = 0;
val SLOT_PREPARED:  u8 = 1;
val SLOT_SUBMITTED: u8 = 2;

pub rec View { data: *u8; length: usize; }

# a datagram the caller received, read at `received_at` on the monotonic clock
pub rec Datagram {
    local:       ip.Endpoint;
    peer:        ip.Endpoint;
    data:        *u8;
    length:      usize;
    received_at: time.Instant;
    ecn:         u8;
}

# the same datagram as a protocol sees it, with time in clock nanoseconds
pub rec CoreInput {
    local:          ip.Endpoint;
    peer:           ip.Endpoint;
    data:           *u8;
    length:         usize;
    received_at_ns: u64;
    ecn:            u8;
}

pub rec Timer     { source: u64; deadline: time.Instant; generation: u64; armed: bool; }
pub rec CoreTimer { deadline_ns: u64; generation: u64; armed: bool; }

# a protocol that refuses a call without changing any state reports
# STATUS_ERROR with its current state and names the caller-facing error in
# `refusal`. ERROR_NONE there means a protocol failure
pub rec CoreResult {
    status:         Status;
    error:          u64;
    provider_error: u64;
    state:          ConnectionState;
    refusal:        Error;
}

pub rec CoreDatagram {
    status:                Status;
    error:                 u64;
    provider_error:        u64;
    state:                 ConnectionState;
    local:                 ip.Endpoint;
    peer:                  ip.Endpoint;
    local_destination:     ip.Addr;
    interface_index:       u32;
    count:                 usize;
    owner:                 u64;
    ecn:                   u8;
    has_local_destination: bool;
    refusal:               Error;
}

# the caller-facing error for a protocol's STATUS_ERROR
fun core_error(refusal: Error) Error {
    if (refusal == ERROR_NONE) { ret ERROR_PROTOCOL; }
    ret refusal;
}

# callbacks are serialized and may not call back into the same driver.
#
# the context is typed rather than an untyped `ptr`. a production protocol
# reaches secret-welded state — every connection.core operation takes both the
# public record and the Secrets — and mach refuses to erase a secret-welded
# pointer to `ptr`, so a vtable with an opaque context can only ever be
# implemented by a test double whose context holds no secrets.
#
# `context_range` exists for the same reason: the context's byte range cannot be
# taken by casting it, so the provider answers for its own memory, the way
# handshake.provider_ranges already does
pub rec Protocol[T] {
    context:       *T;
    context_range: fun(*T) ownership.Range;
    receive:       fun(*T, *CoreInput) CoreResult;
    timeout:       fun(*T, u64, u64) CoreResult;
    generate:      fun(*T, *u8, usize, u64) CoreDatagram;
    complete_send: fun(*T, u64, SendStatus, usize, u64) CoreResult;
    begin_close:   fun(*T, bool, u64, *u8, usize, u64) CoreResult;
    close_ready:   fun(*T) bool;
    finish_close:  fun(*T) bool;
    timer:         fun(*T) CoreTimer;
}

# the scope's cancellation callback runs on a foreign thread and is handed an
# untyped `ptr`, so it cannot reach a typed protocol at all. it records the
# cancellation here and the owner's next call performs the close, on the thread
# that owns the protocol. `cancel_connection` stays synchronous because the
# owner calls it with the driver already typed
pub rec Cancellation {
    registration: cancel.Registration;
    pending:      i64;
    reason:       i64;
    attached:     bool;
}

pub rec Token { source: u64; index: u32; generation: u64; }

pub rec Generated {
    status:                Status;
    error:                 Error;
    protocol_error:        u64;
    provider_error:        u64;
    token:                 Token;
    local:                 ip.Endpoint;
    peer:                  ip.Endpoint;
    local_destination:     ip.Addr;
    interface_index:       u32;
    buffer:                *u8;
    count:                 usize;
    context:               usize;
    ecn:                   u8;
    has_local_destination: bool;
}

pub rec Completion {
    status:         Status;
    error:          Error;
    protocol_error: u64;
    provider_error: u64;
    token:          Token;
    send_status:    SendStatus;
    count:          usize;
    context:        usize;
}

pub rec OperationResult {
    status:         Status;
    error:          Error;
    protocol_error: u64;
    provider_error: u64;
    state:          ConnectionState;
}

pub rec Stream { source: u64; index: usize; generation: u64; id: u64; }

# a stream with news for its owner. readable: bytes or a fin can be read.
# writable: a short write may now make progress. reset: the peer reset the
# stream or asked it to stop sending
pub rec ReadyStream {
    status:   Status;
    error:    Error;
    stream:   Stream;
    readable: bool;
    writable: bool;
    reset:    bool;
}

pub rec OpenResult {
    status:               Status;
    error:                Error;
    detail:               u8;
    stream:               Stream;
    stream_limit_blocked: bool;
    storage_blocked:      bool;
}

pub rec WriteResult {
    status:             Status;
    error:              Error;
    detail:             u8;
    count:              usize;
    connection_blocked: bool;
    stream_blocked:     bool;
    storage_blocked:    bool;
}

pub rec ReadResult {
    status:                  Status;
    error:                   Error;
    detail:                  u8;
    count:                   usize;
    final_size:              u64;
    application_error:       u64;
    receive_max_data:        u64;
    receive_max_stream_data: u64;
    receive_uncredited:      u64;
    fin:                     bool;
}

pub rec StreamSnapshot {
    status:             Status;
    error:              Error;
    id:                 u64;
    send_offset:        u64;
    receive_offset:     u64;
    final_size:         u64;
    send_error:         u64;
    receive_error:      u64;
    send_closed:        bool;
    receive_closed:     bool;
    send_cancelled:     bool;
    receive_cancelled:  bool;
    final_known:        bool;
    receive_uncredited: u64;
}

pub rec DatagramToken { source: u64; index: usize; generation: u64; }

pub rec DatagramResult {
    status: Status;
    error:  Error;
    detail: u8;
    token:  DatagramToken;
}

pub rec ReceivedDatagram {
    status: Status;
    error:  Error;
    detail: u8;
    token:  DatagramToken;
    data:   View;
}

pub rec Snapshot {
    source:              u64;
    role:                Role;
    state:               ConnectionState;
    close_mode:          lifecycle.Mode;
    close_cause:         lifecycle.Cause;
    terminal_cause:      lifecycle.Cause;
    cancellation_reason: cancel.Reason;
    application_error:   u64;
    active_streams:      usize;
    pending_sends:       usize;
    queued_datagrams:    usize;
    received_datagrams:  usize;
    initialized:         bool;
}

pub rec Config { source: u64; max_udp_payload: usize; max_close_reason: usize; }

pub rec SendSlot {
    state:        u8;
    generation:   u64;
    token:        Token;
    buffer:       *u8;
    capacity:     usize;
    length:       usize;
    context:      usize;
    owner:        u64;
    packet:       net_types.Packet;
    native_token: io_runtime.Token;
}

pub rec Storage { sends: *SendSlot; send_capacity: usize; }

pub rec Driver[T] {
    cancellation:        Cancellation;
    config:              Config;
    protocol:            Protocol[T];
    streams:             *stream_api.Manager;
    datagrams:           *datagram_api.Queue;
    operation_scope:     *cancel.Scope;
    storage:             Storage;
    state:               ConnectionState;
    role:                Role;
    next_slot:           usize;
    pending_sends:       usize;
    cancellation_calls:  usize;
    last_now_ns:         u64;
    application_error:   u64;
    close_mode:          lifecycle.Mode;
    close_cause:         lifecycle.Cause;
    terminal_cause:      lifecycle.Cause;
    cancellation_reason: cancel.Reason;
    callback_owner:      i64;
    lock:                mutex.Mutex;
    initialized:         bool;
    released:            bool;
    closing:             bool;
}

pub fun default_config(source: u64) Config {
    ret Config{source: source, max_udp_payload: 65527, max_close_reason: 1024};
}

fun valid_role(role: Role) bool {
    ret role == CLIENT || role == SERVER;
}

fun valid_state(state: ConnectionState) bool {
    ret state >= NEW && state <= CLOSED;
}

fun protocol_valid[T](protocol: *Protocol[T]) bool {
    # a callback's type carries the context's secrecy, so these are compared
    # against nil rather than cast to an address
    if (protocol == nil || protocol.context == nil ||
        protocol.context_range == nil) { ret false; }
    if (!protocol.context_range(protocol.context).valid) { ret false; }
    ret protocol.receive != nil && protocol.timeout != nil &&
        protocol.generate != nil && protocol.complete_send != nil &&
        protocol.begin_close != nil && protocol.close_ready != nil &&
        protocol.finish_close != nil && protocol.timer != nil;
}

fun callback_reentry[T](driver: *Driver[T]) bool {
    ret driver != nil && atomic.load(?driver.callback_owner) != 0 &&
        atomic.load(?driver.callback_owner) == os.thread_current_id();
}

# os.thread_current_id is a system call on linux, so each callback reads it
# once and checks the owner against that value
fun callback_intact[T](driver: *Driver[T], before: *Driver[T], caller: i64) bool {
    ret driver.config.source == before.config.source &&
        driver.config.max_udp_payload == before.config.max_udp_payload &&
        driver.config.max_close_reason == before.config.max_close_reason &&
        driver.protocol.context == before.protocol.context &&
        driver.protocol.context_range == before.protocol.context_range &&
        driver.protocol.receive == before.protocol.receive &&
        driver.protocol.timeout == before.protocol.timeout &&
        driver.protocol.generate == before.protocol.generate &&
        driver.protocol.complete_send == before.protocol.complete_send &&
        driver.protocol.begin_close == before.protocol.begin_close &&
        driver.protocol.close_ready == before.protocol.close_ready &&
        driver.protocol.finish_close == before.protocol.finish_close &&
        driver.protocol.timer == before.protocol.timer &&
        driver.streams == before.streams &&
        driver.datagrams == before.datagrams &&
        driver.operation_scope == before.operation_scope &&
        driver.storage.sends == before.storage.sends &&
        driver.storage.send_capacity == before.storage.send_capacity &&
        driver.state == before.state && driver.role == before.role &&
        driver.next_slot == before.next_slot &&
        driver.pending_sends == before.pending_sends &&
        driver.cancellation_calls == before.cancellation_calls &&
        driver.last_now_ns == before.last_now_ns &&
        driver.application_error == before.application_error &&
        driver.close_mode == before.close_mode &&
        driver.close_cause == before.close_cause &&
        driver.terminal_cause == before.terminal_cause &&
        reason_code(driver.cancellation_reason) == reason_code(before.cancellation_reason) &&
        driver.cancellation.attached == before.cancellation.attached &&
        driver.initialized == before.initialized &&
        driver.released == before.released &&
        driver.closing == before.closing &&
        atomic.load(?driver.callback_owner) == caller;
}

fun restore_callback[T](driver: *Driver[T], before: *Driver[T]) {
    val lock: mutex.Mutex = driver.lock;
    @driver     = @before;
    driver.lock = lock;
    atomic.store(?driver.callback_owner, 0);
}

fun callback_receive[T](driver: *Driver[T], input: *CoreInput) CoreResult {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: CoreResult = driver.protocol.receive(driver.protocol.context,
        input);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        ret CoreResult{status: STATUS_ERROR, error: 0,
            provider_error: 0, state: before.state};
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun callback_timeout[T](driver: *Driver[T], generation: u64,
    now_ns: u64) CoreResult {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: CoreResult = driver.protocol.timeout(driver.protocol.context,
        generation, now_ns);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        ret CoreResult{status: STATUS_ERROR, error: 0,
            provider_error: 0, state: before.state};
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun callback_generate[T](driver: *Driver[T], output: *u8, capacity: usize,
    now_ns: u64) CoreDatagram {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: CoreDatagram = driver.protocol.generate(
        driver.protocol.context, output, capacity, now_ns);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        var refused: CoreDatagram;
        refused.status = STATUS_ERROR;
        refused.state  = before.state;
        ret refused;
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun callback_complete_send[T](driver: *Driver[T], owner: u64,
    send_status: SendStatus, count: usize,
    now_ns: u64) CoreResult {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: CoreResult = driver.protocol.complete_send(
        driver.protocol.context, owner, send_status, count, now_ns);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        ret CoreResult{status: STATUS_ERROR, error: 0,
            provider_error: 0, state: before.state};
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun callback_begin_close[T](driver: *Driver[T], abortive: bool,
    application_error: u64, reason: *u8,
    reason_length: usize, now_ns: u64) CoreResult {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: CoreResult = driver.protocol.begin_close(
        driver.protocol.context, abortive, application_error, reason,
        reason_length, now_ns);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        ret CoreResult{status: STATUS_ERROR, error: 0,
            provider_error: 0, state: before.state};
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun callback_timer[T](driver: *Driver[T]) CoreTimer {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: CoreTimer = driver.protocol.timer(driver.protocol.context);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        var failed: CoreTimer;
        ret failed;
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun callback_close_ready[T](driver: *Driver[T]) bool {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: bool = driver.protocol.close_ready(driver.protocol.context);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        ret false;
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun callback_finish_close[T](driver: *Driver[T]) bool {
    val before: Driver[T] = @driver;
    val caller: i64       = os.thread_current_id();
    atomic.store(?driver.callback_owner, caller);
    val result: bool = driver.protocol.finish_close(driver.protocol.context);
    if (!callback_intact[T](driver, ?before, caller)) {
        restore_callback[T](driver, ?before);
        ret false;
    }
    atomic.store(?driver.callback_owner, 0);
    ret result;
}

fun driver_extent[T](driver: *Driver[T]) ownership.Range {
    if (driver == nil) {
        var empty: ownership.Range;
        ret empty;
    }
    ret ownership.anchored_record[Driver[T], Cancellation](
        ?driver.cancellation, $offset_of(Driver[T], cancellation));
}

fun ownership_valid[T](driver: *Driver[T], protocol: *Protocol[T],
    streams: *stream_api.Manager,
    datagrams: *datagram_api.Queue, scope: *cancel.Scope,
    storage: *Storage) bool {
    if (driver == nil || protocol == nil || streams == nil || datagrams == nil ||
        scope == nil || storage == nil) { ret false; }
    var datagram_zero: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    if (!datagrams.config.enabled) { datagram_zero = ownership.ZERO_ALLOWED; }
    var ranges: [10]ownership.Range;
    ranges[0] = driver_extent[T](driver);
    ranges[1] = ownership.array(storage.sends::*u8, storage.send_capacity,
        $size_of(SendSlot), ownership.ZERO_FORBIDDEN);
    ranges[2] = ownership.record[stream_api.Manager](streams);
    ranges[3] = stream_api.lent_records(streams.storage);
    ranges[4] = stream_api.lent_attempts(streams.storage);
    ranges[5] = ownership.record[datagram_api.Queue](datagrams);
    ranges[6] = ownership.array(datagrams.storage.send_entries::*u8,
        datagrams.storage.send_capacity, $size_of(datagram_api.Entry),
        datagram_zero);
    ranges[7] = ownership.array(datagrams.storage.receive_entries::*u8,
        datagrams.storage.receive_capacity, $size_of(datagram_api.Entry),
        datagram_zero);
    ranges[8] = ownership.record[cancel.Scope](scope);
    ranges[9] = protocol.context_range(protocol.context);
    ret ownership.all_disjoint(?ranges[0], 10);
}

fun borrowed_disjoint[T](driver: *Driver[T], borrowed: ownership.Range) bool {
    ret borrowed_all_disjoint[T](driver, ?borrowed, 1);
}

# checks every borrowed range against the driver's owned ranges, building
# those once for the whole set
fun borrowed_all_disjoint[T](driver: *Driver[T], borrowed: *ownership.Range,
    count: usize) bool {
    var b: usize = 0;
    for (b < count) {
        if (!borrowed[b].valid) { ret false; }
        b = b + 1;
    }
    var datagram_zero: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    if (!driver.datagrams.config.enabled) {
        datagram_zero = ownership.ZERO_ALLOWED;
    }
    var ranges: [10]ownership.Range;
    ranges[0] = driver_extent[T](driver);
    ranges[1] = ownership.array(driver.storage.sends::*u8,
        driver.storage.send_capacity, $size_of(SendSlot),
        ownership.ZERO_FORBIDDEN);
    ranges[2] = ownership.record[stream_api.Manager](driver.streams);
    ranges[3] = stream_api.lent_records(driver.streams.storage);
    ranges[4] = stream_api.lent_attempts(driver.streams.storage);
    ranges[5] = ownership.record[datagram_api.Queue](driver.datagrams);
    ranges[6] = ownership.array(driver.datagrams.storage.send_entries::*u8,
        driver.datagrams.storage.send_capacity, $size_of(datagram_api.Entry),
        datagram_zero);
    ranges[7] = ownership.array(driver.datagrams.storage.receive_entries::*u8,
        driver.datagrams.storage.receive_capacity, $size_of(datagram_api.Entry),
        datagram_zero);
    ranges[8] = ownership.record[cancel.Scope](driver.operation_scope);
    ranges[9] = driver.protocol.context_range(driver.protocol.context);
    b         = 0;
    for (b < count) {
        var i: usize = 0;
        for (i < 10) {
            if (!ownership.disjoint(borrowed[b], ranges[i])) { ret false; }
            i = i + 1;
        }
        i = 0;
        for (i < driver.storage.send_capacity) {
            if (driver.storage.sends[i].state != SLOT_FREE &&
                !ownership.disjoint(borrowed[b],
                ownership.bytes(driver.storage.sends[i].buffer,
                driver.storage.sends[i].capacity,
                ownership.ZERO_FORBIDDEN))) { ret false; }
            i = i + 1;
        }
        b = b + 1;
    }
    ret true;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun state_transition(current: ConnectionState, next: ConnectionState) bool {
    if (!valid_state(next) || next < current) { ret false; }
    if (current == NEW)                       { ret true; }
    if (current == HANDSHAKING)               { ret next >= HANDSHAKING; }
    if (current == ACTIVE)                    { ret next >= ACTIVE; }
    if (current == CLOSING)                   { ret next >= CLOSING; }
    if (current == DRAINING)                  { ret next >= DRAINING; }
    ret next == CLOSED;
}

fun stream_handle(value: Stream) stream_api.Handle {
    ret stream_api.Handle{source: value.source, index: value.index,
        generation: value.generation, id: value.id};
}

fun public_stream(value: stream_api.Handle) Stream {
    ret Stream{source: value.source, index: value.index,
        generation: value.generation, id: value.id};
}

fun datagram_token(value: DatagramToken, receive: bool) datagram_api.Token {
    ret datagram_api.Token{source: value.source, index: value.index,
        generation: value.generation, receive: receive};
}

fun public_datagram(value: datagram_api.Token) DatagramToken {
    ret DatagramToken{source: value.source, index: value.index,
        generation: value.generation};
}

fun status_from_stream(status: u8) Status {
    if (status == stream_api.STATUS_OK || status == stream_api.STATUS_FINISHED)     { ret STATUS_OK; }
    if (status == stream_api.STATUS_EMPTY)                                          { ret STATUS_EMPTY; }
    if (status == stream_api.STATUS_BLOCKED)                                        { ret STATUS_BLOCKED; }
    if (status == stream_api.STATUS_STALE)                                          { ret STATUS_STALE; }
    if (status == stream_api.STATUS_CANCELLED || status == stream_api.STATUS_RESET) { ret STATUS_CANCELLED; }
    ret STATUS_ERROR;
}

fun status_from_datagram(status: u8) Status {
    if (status == datagram_api.STATUS_OK)    { ret STATUS_OK; }
    if (status == datagram_api.STATUS_EMPTY) { ret STATUS_EMPTY; }
    if (status == datagram_api.STATUS_STALE) { ret STATUS_STALE; }
    ret STATUS_ERROR;
}

fun operation_error(code: Error) OperationResult {
    var result: OperationResult;
    result.status = STATUS_ERROR;
    result.error  = code;
    ret result;
}

# a literal that omits a field leaves the previous frame's contents there rather
# than zero (briar-systems/mach#3108), so every result is built with all of them
fun operation_result(status: Status, error: Error, protocol_error: u64,
    provider_error: u64,
    state: ConnectionState) OperationResult {
    ret OperationResult{status: status, error: error,
        protocol_error: protocol_error, provider_error: provider_error,
        state:          state};
}

fun source_scope(scope: *cancel.Scope, owner: *cancel.Scope) bool {
    if (scope == nil || owner == nil) { ret false; }
    var current: *cancel.Scope = scope;
    for (current != nil) {
        if (current == owner) { ret true; }
        current = current.parent;
    }
    ret false;
}

fun stream_storage_drained(manager: *stream_api.Manager) bool {
    ret stream_api.attempts_drained(manager);
}

fun update_now[T](driver: *Driver[T], now_ns: u64) bool {
    if (now_ns < driver.last_now_ns) { ret false; }
    driver.last_now_ns = now_ns;
    ret true;
}

fun begin_components[T](driver: *Driver[T]) bool {
    if (!driver.streams.closing && stream_api.begin_close(driver.streams).status != stream_api.STATUS_OK)         { ret false; }
    if (!driver.datagrams.closing && datagram_api.begin_close(driver.datagrams).status != datagram_api.STATUS_OK) { ret false; }
    ret true;
}

fun apply_state[T](driver: *Driver[T], state: ConnectionState) bool {
    if (state == 0 || state == driver.state)    { ret true; }
    if (!state_transition(driver.state, state)) { ret false; }
    if (state >= CLOSING && driver.state < CLOSING) {
        if (!begin_components[T](driver)) { ret false; }
        driver.closing = true;
    }
    driver.state = state;
    ret true;
}

fun normalize_core[T](driver: *Driver[T], core: CoreResult) OperationResult {
    var result: OperationResult;
    result.protocol_error = core.error;
    result.provider_error = core.provider_error;
    if (core.status < STATUS_OK || core.status > STATUS_ERROR || !apply_state[T](driver, core.state)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_PROTOCOL;
        result.state  = driver.state;
        ret result;
    }
    result.status = core.status;
    result.state  = driver.state;
    if (core.status == STATUS_ERROR) { result.error = core_error(core.refusal); }
    ret result;
}

fun begin_close_locked[T](driver: *Driver[T], abortive: bool, cause: lifecycle.Cause,
    application_error: u64, reason: *u8, reason_length: usize,
    now_ns: u64) OperationResult {
    if (driver.state == CLOSED) {
        ret operation_result(STATUS_CLOSED, ERROR_NONE, 0, 0, CLOSED);
    }
    if (reason_length > driver.config.max_close_reason || (reason_length > 0 && reason == nil)) {
        ret operation_error(ERROR_BUFFER);
    }
    if (!update_now[T](driver, now_ns)) { ret operation_error(ERROR_TIME); }
    if (driver.closing) {
        if (abortive && driver.close_mode == lifecycle.GRACEFUL) {
            val core: CoreResult = callback_begin_close[T](driver, true,
                application_error, reason, reason_length, now_ns);
            val escalated: OperationResult = normalize_core[T](driver, core);
            if (escalated.status == STATUS_ERROR) { ret escalated; }
            driver.close_mode     = lifecycle.ABORTIVE;
            driver.terminal_cause = cause;
        }
        ret operation_result(STATUS_OK, ERROR_NONE, 0, 0, driver.state);
    }
    val core: CoreResult = callback_begin_close[T](driver, abortive,
        application_error, reason, reason_length, now_ns);
    val normalized: OperationResult = normalize_core[T](driver, core);
    if (normalized.status == STATUS_ERROR) { ret normalized; }
    if (!driver.closing || driver.state < CLOSING) {
        ret operation_error(ERROR_STATE);
    }
    driver.close_mode = lifecycle.GRACEFUL;
    if (abortive) { driver.close_mode = lifecycle.ABORTIVE; }
    driver.close_cause       = cause;
    driver.terminal_cause    = cause;
    driver.application_error = application_error;
    ret operation_result(STATUS_OK, ERROR_NONE, 0, 0, driver.state);
}

# runs on whichever thread cancelled the scope, with no access to the protocol.
# it records the cancellation; apply_cancellation performs the close under the
# owner's next call
# a cancel.Reason as the integer the callback can publish atomically
fun reason_code(reason: cancel.Reason) i64 {
    if (sel reason.cancelled) { ret 1; }
    if (sel reason.timed_out) { ret 2; }
    if (sel reason.destroyed) { ret 3; }
    if (sel reason.invalid)   { ret 4; }
    ret 0;
}

fun reason_from_code(code: i64) cancel.Reason {
    if (code == 1) { ret cancel.Reason.cancelled{}; }
    if (code == 2) { ret cancel.Reason.timed_out{}; }
    if (code == 3) { ret cancel.Reason.destroyed{}; }
    if (code == 4) { ret cancel.Reason.invalid{}; }
    ret cancel.Reason.active{};
}

fun cancellation_callback(context: ptr, reason: cancel.Reason) {
    val state: *Cancellation = context::*Cancellation;
    atomic.store(?state.reason, reason_code(reason));
    atomic.store(?state.pending, 1);
}

# called with the driver locked, at the top of every operation that can close
fun apply_cancellation[T](driver: *Driver[T]) {
    if (atomic.load(?driver.cancellation.pending) == 0) { ret; }
    atomic.store(?driver.cancellation.pending, 0);
    driver.cancellation.attached = false;
    val reason: cancel.Reason = reason_from_code(atomic.load(?driver.cancellation.reason));
    driver.cancellation_reason = reason;
    var cause: lifecycle.Cause = lifecycle.CANCELLATION;
    if (sel reason.timed_out) { cause = lifecycle.DEADLINE; }
    begin_close_locked[T](driver, true, cause, 0, nil, 0, driver.last_now_ns);
}

fun init_driver[T](driver: *Driver[T], role: Role, config: Config, protocol: Protocol[T],
    streams: *stream_api.Manager, datagrams: *datagram_api.Queue,
    scope: *cancel.Scope, storage: Storage) bool {
    if (driver == nil || !driver_extent[T](driver).valid || driver.initialized ||
        !valid_role(role) || config.source == 0 ||
        config.max_udp_payload < 1200 || config.max_udp_payload > 65527 ||
        !protocol_valid[T](?protocol) || streams == nil || !streams.valid ||
        datagrams == nil || !datagrams.valid || scope == nil ||
        !scope_active(scope) || storage.sends == nil ||
        storage.send_capacity == 0 || storage.send_capacity > 0xffffffff ||
        streams.config.source != config.source || datagrams.config.source != config.source ||
        (role == CLIENT && streams.config.role != stream_api.ROLE_CLIENT) ||
        (role == SERVER && streams.config.role != stream_api.ROLE_SERVER) ||
        !ownership_valid[T](driver, ?protocol, streams, datagrams, scope,
        ?storage)) { ret false; }
    val original:  Driver[T] = @driver;
    var candidate: Driver[T];
    candidate.config              = config;
    candidate.protocol            = protocol;
    candidate.streams             = streams;
    candidate.datagrams           = datagrams;
    candidate.operation_scope     = scope;
    candidate.storage             = storage;
    candidate.state               = HANDSHAKING;
    candidate.role                = role;
    candidate.close_mode          = lifecycle.GRACEFUL;
    candidate.close_cause         = lifecycle.EXPLICIT;
    candidate.terminal_cause      = lifecycle.EXPLICIT;
    candidate.cancellation_reason = cancel.Reason.active{};
    candidate.lock                = mutex.make();
    cancel.init_registration(?candidate.cancellation.registration);
    candidate.initialized           = true;
    candidate.cancellation.attached = true;
    @driver                         = candidate;
    mutex.lock(?driver.lock);
    val attached: cancel.Reason = cancel.attach(scope,
        ?driver.cancellation.registration, cancellation_callback,
        (?driver.cancellation)::ptr);
    if (!(sel attached.active)) {
        mutex.unlock(?driver.lock);
        @driver = original;
        ret false;
    }
    var i: usize = 0;
    for (i < storage.send_capacity) {
        val generation: u64 = storage.sends[i].generation;
        var clean:      SendSlot;
        clean.generation = generation;
        storage.sends[i] = clean;
        i                = i + 1;
    }
    mutex.unlock(?driver.lock);
    ret true;
}

pub fun init_client[T](driver: *Driver[T], config: Config, protocol: Protocol[T],
    streams: *stream_api.Manager, datagrams: *datagram_api.Queue,
    scope: *cancel.Scope, storage: Storage) bool {
    ret init_driver[T](driver, CLIENT, config, protocol, streams, datagrams, scope, storage);
}

pub fun init_server[T](driver: *Driver[T], config: Config, protocol: Protocol[T],
    streams: *stream_api.Manager, datagrams: *datagram_api.Queue,
    scope: *cancel.Scope, storage: Storage) bool {
    ret init_driver[T](driver, SERVER, config, protocol, streams, datagrams, scope, storage);
}

pub fun token_equal(a: Token, b: Token) bool {
    ret a.source == b.source && a.index == b.index && a.generation == b.generation;
}

fun token_context(token: Token) usize {
    ret (token.index::u64 + 1)::usize;
}

fun context_index[T](driver: *Driver[T], context: usize) usize {
    val raw: u64 = context::u64;
    if (raw == 0 || raw - 1 >= driver.storage.send_capacity::u64) {
        ret driver.storage.send_capacity;
    }
    ret (raw - 1)::usize;
}

fun slot_for[T](driver: *Driver[T], token: Token) *SendSlot {
    if (token.source != driver.config.source || token.index::usize >= driver.storage.send_capacity) { ret nil; }
    val slot: *SendSlot = ?driver.storage.sends[token.index::usize];
    if (slot.state == SLOT_FREE || !token_equal(slot.token, token)) { ret nil; }
    ret slot;
}

fun claim_slot[T](driver: *Driver[T], buffer: *u8, capacity: usize,
    context: usize) *SendSlot {
    var offset: usize = 0;
    for (offset < driver.storage.send_capacity) {
        val index: usize     = (driver.next_slot + offset) % driver.storage.send_capacity;
        val slot:  *SendSlot = ?driver.storage.sends[index];
        if (slot.state == SLOT_FREE) {
            slot.generation = next_generation(slot.generation);
            slot.token      = Token{source: driver.config.source, index: index::u32,
                generation: slot.generation};
            slot.state           = SLOT_PREPARED;
            slot.buffer          = buffer;
            slot.capacity        = capacity;
            slot.length          = 0;
            slot.context         = context;
            slot.owner           = 0;
            driver.next_slot     = (index + 1) % driver.storage.send_capacity;
            driver.pending_sends = driver.pending_sends + 1;
            ret slot;
        }
        offset = offset + 1;
    }
    ret nil;
}

fun release_slot[T](driver: *Driver[T], slot: *SendSlot) {
    slot.state    = SLOT_FREE;
    slot.buffer   = nil;
    slot.capacity = 0;
    slot.length   = 0;
    slot.context  = 0;
    slot.owner    = 0;
    if (driver.pending_sends > 0) { driver.pending_sends = driver.pending_sends - 1; }
}

pub fun receive_datagram[T](driver: *Driver[T], input: *Datagram) OperationResult {
    if (callback_reentry[T](driver)) { ret operation_error(ERROR_STATE); }
    if (driver == nil || input == nil || !driver.initialized) {
        ret operation_error(ERROR_BUFFER);
    }
    var borrowed: [2]ownership.Range;
    borrowed[0] = ownership.record[Datagram](input);
    borrowed[1] = ownership.bytes(input.data, input.length, ownership.ZERO_ALLOWED);
    if (!borrowed_all_disjoint[T](driver, ?borrowed[0], 2) ||
        !ownership.disjoint(borrowed[0], borrowed[1])) {
        ret operation_error(ERROR_BUFFER);
    }
    var core_input: CoreInput = CoreInput{local: input.local, peer: input.peer,
        data:           input.data, length: input.length,
        received_at_ns: clock.nanos(input.received_at), ecn: input.ecn};
    ret receive_checked[T](driver, ?core_input);
}

# the input and its bytes are already known to be disjoint from the driver
fun receive_checked[T](driver: *Driver[T], input: *CoreInput) OperationResult {
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED || (driver.closing &&
        driver.close_mode == lifecycle.ABORTIVE)) {
        val state: ConnectionState = driver.state;
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_CLOSED, ERROR_NONE, 0, 0, state);
    }
    if (driver.operation_scope == nil ||
        !scope_active(driver.operation_scope)) {
        val state: ConnectionState = driver.state;
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_CANCELLED, ERROR_CANCELLED, 0, 0, state);
    }
    if (!update_now[T](driver, input.received_at_ns)) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_TIME);
    }
    # rfc 9000 18.2: a datagram above the advertised max_udp_payload_size may
    # be dropped, and dropping it must not fail the connection
    if (input.length > driver.config.max_udp_payload) {
        val state: ConnectionState = driver.state;
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_OK, ERROR_NONE, 0, 0, state);
    }
    val core:   CoreResult      = callback_receive[T](driver, input);
    val result: OperationResult = normalize_core[T](driver, core);
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun receive_native[T](driver: *Driver[T], packet: *net_types.Packet,
    bound_local: ip.Endpoint, received_at: time.Instant, ecn: u8) OperationResult {
    if (callback_reentry[T](driver)) { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized || packet == nil ||
        packet.truncated || packet.length > packet.capacity ||
        (packet.length > 0 && packet.buffer == nil)) { ret operation_error(ERROR_BUFFER); }
    var borrowed: [2]ownership.Range;
    borrowed[0] = ownership.record[net_types.Packet](packet);
    borrowed[1] = ownership.bytes(packet.buffer, packet.length, ownership.ZERO_ALLOWED);
    if (!borrowed_all_disjoint[T](driver, ?borrowed[0], 2) ||
        !ownership.disjoint(borrowed[0], borrowed[1])) {
        ret operation_error(ERROR_BUFFER);
    }
    var local: ip.Endpoint = bound_local;
    if (packet.has_local_destination) {
        local.addr = packet.local_destination;
        if (local.addr.is_v6 != 0) { local.scope = packet.interface_index; }
    }
    var input: CoreInput = CoreInput{local: local, peer: packet.peer, data: packet.buffer,
        length: packet.length, received_at_ns: clock.nanos(received_at), ecn: ecn};
    ret receive_checked[T](driver, ?input);
}

pub fun timer[T](driver: *Driver[T]) Timer {
    var result: Timer;
    if (callback_reentry[T](driver))          { ret result; }
    if (driver == nil || !driver.initialized) { ret result; }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state != CLOSED && !(driver.closing &&
        driver.close_mode == lifecycle.ABORTIVE) && driver.operation_scope != nil &&
        scope_active(driver.operation_scope)) {
        val core: CoreTimer = callback_timer[T](driver);
        if (core.armed && core.generation != 0) {
            result.source     = driver.config.source;
            result.deadline   = clock.instant(core.deadline_ns);
            result.generation = core.generation;
            result.armed      = true;
        }
    }
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun on_timeout[T](driver: *Driver[T], value: Timer, now: time.Instant) OperationResult {
    val now_ns:      u64 = clock.nanos(now);
    val deadline_ns: u64 = clock.nanos(value.deadline);
    if (callback_reentry[T](driver)) { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized || !value.armed ||
        value.source != driver.config.source || value.generation == 0) {
        ret operation_error(ERROR_TOKEN);
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_CLOSED, ERROR_NONE, 0, 0, CLOSED);
    }
    if ((driver.closing && driver.close_mode == lifecycle.ABORTIVE) ||
        driver.operation_scope == nil || !scope_active(driver.operation_scope)) {
        val state: ConnectionState = driver.state;
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_CANCELLED, ERROR_CANCELLED, 0, 0, state);
    }
    if (now_ns < driver.last_now_ns) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_TIME);
    }
    val current: CoreTimer = callback_timer[T](driver);
    if (!current.armed || current.generation != value.generation ||
        current.deadline_ns != deadline_ns) {
        val state: ConnectionState = driver.state;
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_STALE, ERROR_TOKEN, 0, 0, state);
    }
    if (now_ns < deadline_ns) {
        val state: ConnectionState = driver.state;
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_EARLY, ERROR_TIME, 0, 0, state);
    }
    driver.last_now_ns = now_ns;
    val core:   CoreResult      = callback_timeout[T](driver, value.generation, now_ns);
    val result: OperationResult = normalize_core[T](driver, core);
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun generate[T](driver: *Driver[T], scope: *cancel.Scope, buffer: *u8,
    capacity: usize, now: time.Instant, context: usize) Generated {
    val now_ns: u64 = clock.nanos(now);
    var result: Generated;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized || buffer == nil || capacity == 0 ||
        scope == nil) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_BUFFER;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (!source_scope(scope, driver.operation_scope) || !scope_active(scope)) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CANCELLED;
        result.error  = ERROR_CANCELLED;
        ret result;
    }
    if (!borrowed_disjoint[T](driver, ownership.bytes(buffer, capacity,
        ownership.ZERO_FORBIDDEN))) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_ERROR;
        result.error  = ERROR_BUFFER;
        ret result;
    }
    if (driver.state == CLOSED || (driver.closing && driver.close_mode == lifecycle.ABORTIVE)) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CLOSED;
        ret result;
    }
    if (!update_now[T](driver, now_ns)) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_ERROR;
        result.error  = ERROR_TIME;
        ret result;
    }
    # max_udp_payload bounds what this endpoint accepts, and the core bounds
    # what it sends by its own storage and the peer's limit
    val available: usize     = capacity;
    val slot:      *SendSlot = claim_slot[T](driver, buffer, available, context);
    if (slot == nil) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_CAPACITY;
        ret result;
    }
    val core: CoreDatagram = callback_generate[T](driver, buffer, available,
        now_ns);
    result.provider_error = core.provider_error;
    val status_ok:   bool = core.status >= STATUS_OK && core.status <= STATUS_ERROR;
    val state_ok:    bool = state_transition(driver.state, core.state);
    val empty_shape: bool = core.status != STATUS_OK && core.count == 0;
    if (!status_ok || !state_ok || (core.status == STATUS_OK &&
        (core.count == 0 || core.count > available)) || !empty_shape && core.status != STATUS_OK) {
        release_slot[T](driver, slot);
        result.status         = STATUS_ERROR;
        result.error          = ERROR_PROTOCOL;
        result.protocol_error = core.error;
        mutex.unlock(?driver.lock);
        ret result;
    }
    if (!apply_state[T](driver, core.state)) {
        release_slot[T](driver, slot);
        result.status = STATUS_ERROR;
        result.error  = ERROR_PROTOCOL;
        mutex.unlock(?driver.lock);
        ret result;
    }
    if (core.status != STATUS_OK) {
        release_slot[T](driver, slot);
        result.status         = core.status;
        result.protocol_error = core.error;
        if (core.status == STATUS_ERROR) { result.error = core_error(core.refusal); }
        mutex.unlock(?driver.lock);
        ret result;
    }
    slot.length                       = core.count;
    slot.owner                        = core.owner;
    slot.packet.buffer                = buffer;
    slot.packet.capacity              = core.count;
    slot.packet.length                = core.count;
    slot.packet.peer                  = core.peer;
    slot.packet.local_destination     = core.local_destination;
    slot.packet.interface_index       = core.interface_index;
    slot.packet.has_local_destination = core.has_local_destination;
    slot.packet.truncated             = false;
    slot.packet.zero_length           = false;
    result.status                     = STATUS_OK;
    result.token                      = slot.token;
    result.local                      = core.local;
    result.peer                       = core.peer;
    result.local_destination          = core.local_destination;
    result.interface_index            = core.interface_index;
    result.buffer                     = buffer;
    result.count                      = core.count;
    result.context                    = context;
    result.ecn                        = core.ecn;
    result.has_local_destination      = core.has_local_destination;
    mutex.unlock(?driver.lock);
    ret result;
}

fun complete_locked[T](driver: *Driver[T], slot: *SendSlot, send_status: SendStatus,
    count: usize, now_ns: u64) Completion {
    var completion: Completion;
    completion.token       = slot.token;
    completion.send_status = send_status;
    completion.count       = count;
    completion.context     = slot.context;
    if (send_status < SEND_SENT || send_status > SEND_TIMED_OUT || count > slot.length ||
        (send_status == SEND_SENT && count != slot.length) ||
        (send_status != SEND_SENT && count != 0) || !update_now[T](driver, now_ns)) {
        completion.status = STATUS_ERROR;
        completion.error  = ERROR_NATIVE;
        ret completion;
    }
    val core: CoreResult = callback_complete_send[T](driver, slot.owner,
        send_status, count, now_ns);
    val normalized: OperationResult = normalize_core[T](driver, core);
    completion.status         = normalized.status;
    completion.error          = normalized.error;
    completion.protocol_error = normalized.protocol_error;
    completion.provider_error = normalized.provider_error;
    release_slot[T](driver, slot);
    ret completion;
}

pub fun complete_send[T](driver: *Driver[T], token: Token, send_status: SendStatus,
    count: usize, now: time.Instant) Completion {
    val now_ns: u64 = clock.nanos(now);
    var result: Completion;
    result.token = token;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    val slot: *SendSlot = slot_for[T](driver, token);
    if (slot == nil || slot.state != SLOT_PREPARED) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    result = complete_locked[T](driver, slot, send_status, count, now_ns);
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun cancel_send[T](driver: *Driver[T], token: Token, now: time.Instant) Completion {
    ret complete_send[T](driver, token, SEND_CANCELLED, 0, now);
}

pub fun submit_native[T](driver: *Driver[T], network: *net_async.Driver, socket: *udp.Socket,
    scope: *cancel.Scope, token: Token) res[io_runtime.Token, io_error.Error] {
    # these refusals are the adapter's own, so each names its kind and carries
    # no native code
    if (callback_reentry[T](driver)) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.BUSY, io_error.OP_SEND)};
    }
    if (driver == nil || !driver.initialized || network == nil || socket == nil || scope == nil) {
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_SEND)};
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    val slot: *SendSlot = slot_for[T](driver, token);
    if (slot == nil || slot.state != SLOT_PREPARED ||
        !source_scope(scope, driver.operation_scope)) {
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.INVALID, io_error.OP_SEND)};
    }
    if (!scope_active(scope)) {
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{io_error.make(io_error.CANCELLED, io_error.OP_SEND)};
    }
    val submitted: res[io_runtime.Token, io_error.Error] = net_async.submit_send_batch(
        network, scope, socket, ?slot.packet, 1, token_context(token));
    if (sel submitted.err) {
        val failure: io_error.Error = submitted.err;
        complete_locked[T](driver, slot, SEND_FAILED, 0, driver.last_now_ns);
        mutex.unlock(?driver.lock);
        ret res[io_runtime.Token, io_error.Error].err{failure};
    }
    slot.native_token = submitted.ok;
    slot.state        = SLOT_SUBMITTED;
    val result: io_runtime.Token = slot.native_token;
    mutex.unlock(?driver.lock);
    ret res[io_runtime.Token, io_error.Error].ok{result};
}

pub fun complete_native[T](driver: *Driver[T], native: *io_runtime.Completion,
    now: time.Instant) Completion {
    val now_ns: u64 = clock.nanos(now);
    var result: Completion;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized || native == nil ||
        native.kind != io_runtime.SEND_TO) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_NATIVE;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    val index: usize = context_index[T](driver, native.context);
    if (index == driver.storage.send_capacity) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    val slot: *SendSlot = ?driver.storage.sends[index];
    result.token = slot.token;
    if (slot.state != SLOT_SUBMITTED ||
        slot.native_token.index != native.token.index ||
        slot.native_token.generation != native.token.generation) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    var send_status: SendStatus = SEND_SENT;
    var count:       usize      = native.bytes;
    if (native.has_error) {
        send_status = SEND_FAILED;
        count       = 0;
        if (native.error.kind == io_error.CANCELLED) { send_status = SEND_CANCELLED; }
        if (native.error.kind == io_error.TIMEOUT)   { send_status = SEND_TIMED_OUT; }
    }
    or (native.items != 1 || native.bytes != slot.length) {
        send_status = SEND_FAILED;
        count       = 0;
    }
    result = complete_locked[T](driver, slot, send_status, count, now_ns);
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun operation_snapshot[T](driver: *Driver[T], token: Token) Generated {
    var result: Generated;
    result.token = token;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    val slot: *SendSlot = slot_for[T](driver, token);
    if (slot != nil) {
        result.status                = STATUS_OK;
        result.buffer                = slot.buffer;
        result.count                 = slot.length;
        result.context               = slot.context;
        result.peer                  = slot.packet.peer;
        result.local_destination     = slot.packet.local_destination;
        result.interface_index       = slot.packet.interface_index;
        result.has_local_destination = slot.packet.has_local_destination;
    }
    or {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

fun app_available[T](driver: *Driver[T]) bool {
    ret driver.initialized && !driver.closing &&
        driver.operation_scope != nil && scope_active(driver.operation_scope) &&
        (driver.state == HANDSHAKING || driver.state == ACTIVE);
}

pub fun open_stream[T](driver: *Driver[T], direction: Direction) OpenResult {
    var result: OpenResult;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized ||
        (direction != BIDIRECTIONAL && direction != UNIDIRECTIONAL)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_CONFIG;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (!app_available[T](driver)) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CLOSED;
        result.error  = ERROR_STATE;
        ret result;
    }
    var internal_direction: u8 = stream_api.DIRECTION_BIDIRECTIONAL;
    if (direction == UNIDIRECTIONAL) { internal_direction = stream_api.DIRECTION_UNIDIRECTIONAL; }
    val opened: stream_api.CreateResult = stream_api.open(driver.streams, internal_direction);
    result.status = status_from_stream(opened.status);
    result.detail = opened.error;
    if (result.status == STATUS_ERROR) { result.error = ERROR_STREAM; }
    result.stream               = public_stream(opened.handle);
    result.stream_limit_blocked = opened.stream_limit_blocked;
    result.storage_blocked      = opened.storage_blocked;
    mutex.unlock(?driver.lock);
    ret result;
}

# the oldest stream with news since it was last reported, O(1). reports may
# repeat or be spurious, never lost. a peer stream is reported only once
# accept_stream has returned it
pub fun ready_stream[T](driver: *Driver[T]) ReadyStream {
    var result: ReadyStream;
    if (callback_reentry[T](driver) || driver == nil || !driver.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    mutex.lock(?driver.lock);
    val ready: stream_api.Ready = stream_api.next_ready(driver.streams);
    mutex.unlock(?driver.lock);
    if (ready.status != stream_api.STATUS_OK) {
        result.status = STATUS_EMPTY;
        ret result;
    }
    result.status   = STATUS_OK;
    result.stream   = public_stream(ready.handle);
    result.readable = ready.readable;
    result.writable = ready.writable;
    result.reset    = ready.reset;
    ret result;
}

# the connection's chunk pool woke this connection: writes it refused for
# storage are reported writable again
pub fun storage_ready[T](driver: *Driver[T]) {
    if (callback_reentry[T](driver) || driver == nil || !driver.initialized) { ret; }
    mutex.lock(?driver.lock);
    stream_api.storage_released(driver.streams);
    driver.streams.send_revision = driver.streams.send_revision + 1;
    mutex.unlock(?driver.lock);
}

pub fun accept_stream[T](driver: *Driver[T]) OpenResult {
    var result: OpenResult;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CLOSED;
        ret result;
    }
    val accepted: stream_api.CreateResult = stream_api.accept(driver.streams);
    result.status = status_from_stream(accepted.status);
    result.detail = accepted.error;
    if (result.status == STATUS_ERROR) { result.error = ERROR_STREAM; }
    result.stream = public_stream(accepted.handle);
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun write_stream[T](driver: *Driver[T], value: Stream, data: *u8, length: usize) WriteResult {
    var result: WriteResult;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized || (length > 0 && data == nil)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_BUFFER;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (!app_available[T](driver)) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CLOSED;
        result.error  = ERROR_STATE;
        ret result;
    }
    val written: stream_api.WriteResult = stream_api.write(driver.streams,
        stream_handle(value), data, length);
    result.status = status_from_stream(written.status);
    result.detail = written.error;
    if (written.error == stream_api.ERROR_TOKEN) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    if (result.status == STATUS_ERROR) { result.error = ERROR_STREAM; }
    result.count              = written.count;
    result.connection_blocked = written.connection_blocked;
    result.stream_blocked     = written.stream_blocked;
    result.storage_blocked    = written.storage_blocked;
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun finish_stream[T](driver: *Driver[T], value: Stream) OperationResult {
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (!app_available[T](driver)) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_STATE);
    }
    val finished: stream_api.OperationResult = stream_api.finish(driver.streams,
        stream_handle(value));
    var result: OperationResult;
    result.status = status_from_stream(finished.status);
    result.state  = driver.state;
    if (finished.error == stream_api.ERROR_TOKEN) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    if (result.status == STATUS_ERROR) {
        result.error          = ERROR_STREAM;
        result.protocol_error = finished.error::u64;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun read_stream[T](driver: *Driver[T], value: Stream, output: *u8, capacity: usize) ReadResult {
    var result: ReadResult;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized || (capacity > 0 && output == nil)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_BUFFER;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CLOSED;
        ret result;
    }
    val read: stream_api.ReadResult = stream_api.read(driver.streams,
        stream_handle(value), output, capacity);
    result.status = status_from_stream(read.status);
    result.detail = read.error;
    if (read.error == stream_api.ERROR_TOKEN) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    if (result.status == STATUS_ERROR) { result.error = ERROR_STREAM; }
    result.count                   = read.count;
    result.final_size              = read.final_size;
    result.application_error       = read.application_error;
    result.receive_max_data        = read.receive_max_data;
    result.receive_max_stream_data = read.receive_max_stream_data;
    result.receive_uncredited      = read.receive_uncredited;
    result.fin                     = read.fin;
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun credit_stream[T](driver: *Driver[T], value: Stream, count: u64) OperationResult {
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_STATE);
    }
    val internal: stream_api.OperationResult = stream_api.credit(driver.streams,
        stream_handle(value), count);
    var result: OperationResult;
    result.status = status_from_stream(internal.status);
    result.state  = driver.state;
    if (internal.error == stream_api.ERROR_TOKEN) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    if (result.status == STATUS_ERROR) {
        result.error          = ERROR_STREAM;
        result.protocol_error = internal.error::u64;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

fun stream_operation[T](driver: *Driver[T], value: Stream, receive: bool,
    error_code: u64) OperationResult {
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    mutex.lock(?driver.lock);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_STATE);
    }
    var internal: stream_api.OperationResult;
    if (receive) {
        internal = stream_api.cancel_receive(driver.streams, stream_handle(value), error_code);
    }
    or {
        internal = stream_api.cancel_send(driver.streams, stream_handle(value), error_code);
    }
    var result: OperationResult;
    result.status = status_from_stream(internal.status);
    result.state  = driver.state;
    if (internal.error == stream_api.ERROR_TOKEN) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    if (result.status == STATUS_ERROR) {
        result.error          = ERROR_STREAM;
        result.protocol_error = internal.error::u64;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun cancel_stream_send[T](driver: *Driver[T], value: Stream, error_code: u64) OperationResult {
    ret stream_operation[T](driver, value, false, error_code);
}

pub fun cancel_stream_receive[T](driver: *Driver[T], value: Stream, error_code: u64) OperationResult {
    ret stream_operation[T](driver, value, true, error_code);
}

pub fun release_stream[T](driver: *Driver[T], value: Stream) OperationResult {
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    # releasing is the owner's bookkeeping and stays possible in every state,
    # including CLOSED: finish_close waits for the stream storage to drain and
    # release_ready for every stream to be released
    val released: stream_api.OperationResult = stream_api.release(driver.streams,
        stream_handle(value));
    var result: OperationResult;
    result.status = status_from_stream(released.status);
    result.state  = driver.state;
    if (released.error == stream_api.ERROR_TOKEN) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    if (released.error == stream_api.ERROR_STATE) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_NONE;
    }
    if (result.status == STATUS_ERROR) {
        result.error          = ERROR_STREAM;
        result.protocol_error = released.error::u64;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun stream_snapshot[T](driver: *Driver[T], value: Stream) StreamSnapshot {
    var result: StreamSnapshot;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    val current: stream_api.Snapshot = stream_api.snapshot(driver.streams, stream_handle(value));
    if (current.ok) {
        result.status             = STATUS_OK;
        result.id                 = current.id;
        result.send_offset        = current.send_offset;
        result.receive_offset     = current.receive_offset;
        result.final_size         = current.final_size;
        result.send_error         = current.send_error;
        result.receive_error      = current.receive_error;
        result.send_closed        = current.send_closed;
        result.receive_closed     = current.receive_closed;
        result.send_cancelled     = current.send_cancelled;
        result.receive_cancelled  = current.receive_cancelled;
        result.final_known        = current.final_known;
        result.receive_uncredited = current.receive_uncredited;
    }
    or {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun send_datagram[T](driver: *Driver[T], data: *u8, length: usize) DatagramResult {
    var result: DatagramResult;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized || (length > 0 && data == nil)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_BUFFER;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (!app_available[T](driver)) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CLOSED;
        ret result;
    }
    val queued: datagram_api.QueueResult = datagram_api.enqueue(driver.datagrams, data, length);
    result.status = status_from_datagram(queued.status);
    result.detail = queued.error;
    if (queued.error == datagram_api.ERROR_CAPACITY) { result.status = STATUS_BLOCKED; }
    if (result.status == STATUS_ERROR)               { result.error = ERROR_DATAGRAM; }
    result.token = public_datagram(queued.token);
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun cancel_datagram[T](driver: *Driver[T], value: DatagramToken) OperationResult {
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_STATE);
    }
    val cancelled: datagram_api.OperationResult = datagram_api.cancel(driver.datagrams,
        datagram_token(value, false));
    var result: OperationResult;
    result.status = status_from_datagram(cancelled.status);
    result.state  = driver.state;
    if (result.status == STATUS_ERROR) {
        result.error          = ERROR_DATAGRAM;
        result.protocol_error = cancelled.error::u64;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun next_datagram[T](driver: *Driver[T]) ReceivedDatagram {
    var result: ReceivedDatagram;
    if (callback_reentry[T](driver)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (driver == nil || !driver.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        result.status = STATUS_CLOSED;
        ret result;
    }
    val delivery: datagram_api.Delivery = datagram_api.next(driver.datagrams);
    result.status = status_from_datagram(delivery.status);
    result.detail = delivery.error;
    if (result.status == STATUS_ERROR) { result.error = ERROR_DATAGRAM; }
    result.token       = public_datagram(delivery.token);
    result.data.data   = delivery.data.data;
    result.data.length = delivery.data.len;
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun release_datagram[T](driver: *Driver[T], value: DatagramToken) OperationResult {
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (driver.state == CLOSED) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_STATE);
    }
    val released: datagram_api.OperationResult = datagram_api.release(driver.datagrams,
        datagram_token(value, true));
    var result: OperationResult;
    result.status = status_from_datagram(released.status);
    result.state  = driver.state;
    if (result.status == STATUS_ERROR) {
        result.error          = ERROR_DATAGRAM;
        result.protocol_error = released.error::u64;
    }
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun begin_close[T](driver: *Driver[T], application_error: u64, reason: *u8,
    reason_length: usize, now: time.Instant) OperationResult {
    val now_ns: u64 = clock.nanos(now);
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    if (!borrowed_disjoint[T](driver, ownership.bytes(reason, reason_length,
        ownership.ZERO_ALLOWED))) { ret operation_error(ERROR_BUFFER); }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    val result: OperationResult = begin_close_locked[T](driver, false, lifecycle.EXPLICIT,
        application_error, reason, reason_length, now_ns);
    mutex.unlock(?driver.lock);
    ret result;
}

pub fun cancel_connection[T](driver: *Driver[T]) bool {
    if (callback_reentry[T](driver))          { ret false; }
    if (driver == nil || !driver.initialized) { ret false; }
    mutex.lock(?driver.lock);
    if (driver.state == CLOSED || driver.operation_scope == nil) {
        mutex.unlock(?driver.lock);
        ret false;
    }
    if (driver.cancellation_calls == 0 - 1::usize) {
        mutex.unlock(?driver.lock);
        ret false;
    }
    val scope: *cancel.Scope = driver.operation_scope;
    driver.cancellation_calls = driver.cancellation_calls + 1;
    mutex.unlock(?driver.lock);
    val cancelled: bool = transition_ok(cancel.cancel(scope));
    mutex.lock(?driver.lock);
    driver.cancellation_calls = driver.cancellation_calls - 1;
    apply_cancellation[T](driver);
    mutex.unlock(?driver.lock);
    ret cancelled;
}

pub fun finish_close[T](driver: *Driver[T]) OperationResult {
    if (callback_reentry[T](driver))          { ret operation_error(ERROR_STATE); }
    if (driver == nil || !driver.initialized) { ret operation_error(ERROR_STATE); }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    if (!driver.closing || (driver.state != DRAINING &&
        driver.state != CLOSED)) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_STATE);
    }
    if (driver.pending_sends != 0 || driver.cancellation_calls != 0 ||
        !stream_storage_drained(driver.streams) ||
        driver.datagrams.send_count != 0 || driver.datagrams.delivered_count != 0 ||
        !callback_close_ready[T](driver)) {
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_BLOCKED, ERROR_CAPACITY, 0, 0, DRAINING);
    }
    if (!callback_finish_close[T](driver)) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_PROTOCOL);
    }
    if (driver.streams.valid || driver.datagrams.valid) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_PROTOCOL);
    }
    if (driver.cancellation.attached) {
        if (!transition_ok(cancel.unregister(?driver.cancellation.registration))) {
            mutex.unlock(?driver.lock);
            ret operation_result(STATUS_BLOCKED, ERROR_CANCELLED, 0, 0, DRAINING);
        }
        driver.cancellation.attached = false;
    }
    driver.state           = CLOSED;
    driver.operation_scope = nil;
    mutex.unlock(?driver.lock);
    ret operation_result(STATUS_OK, ERROR_NONE, 0, 0, CLOSED);
}

fun release_ready_locked[T](driver: *Driver[T]) bool {
    if (!driver.initialized || !driver.closing || driver.state != CLOSED ||
        driver.pending_sends != 0 || driver.cancellation_calls != 0 ||
        driver.operation_scope != nil || driver.cancellation.attached ||
        atomic.load(?driver.cancellation.pending) != 0 ||
        atomic.load(?driver.callback_owner) != 0 || driver.streams == nil ||
        driver.datagrams == nil || driver.streams.valid ||
        driver.streams.active_streams != 0 ||
        driver.streams.active_attempts != 0 || driver.datagrams.valid ||
        driver.datagrams.send_count != 0 ||
        driver.datagrams.delivered_count != 0) {
        ret false;
    }
    var i: usize = 0;
    for (i < driver.storage.send_capacity) {
        if (driver.storage.sends[i].state != SLOT_FREE) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a successfully released driver is the only uninitialized terminal state for
# which release is idempotent. send-slot generations remain caller-owned so a
# delayed token cannot target the next initialization of the same record
pub fun release_ready[T](driver: *Driver[T]) bool {
    if (callback_reentry[T](driver) || driver == nil) { ret false; }
    if (!driver.initialized)                          { ret driver.released; }
    mutex.lock(?driver.lock);
    val ready: bool = release_ready_locked[T](driver);
    mutex.unlock(?driver.lock);
    ret ready;
}

pub fun release_closed[T](driver: *Driver[T]) OperationResult {
    if (callback_reentry[T](driver) || driver == nil) {
        ret operation_error(ERROR_STATE);
    }
    if (!driver.initialized) {
        if (driver.released) {
            ret operation_result(STATUS_OK, ERROR_NONE, 0, 0, CLOSED);
        }
        ret operation_error(ERROR_STATE);
    }
    mutex.lock(?driver.lock);
    if (!driver.closing || driver.state != CLOSED) {
        mutex.unlock(?driver.lock);
        ret operation_error(ERROR_STATE);
    }
    if (!release_ready_locked[T](driver)) {
        mutex.unlock(?driver.lock);
        ret operation_result(STATUS_BLOCKED, ERROR_CAPACITY, 0, 0, CLOSED);
    }
    var i: usize = 0;
    for (i < driver.storage.send_capacity) {
        val generation: u64 = driver.storage.sends[i].generation;
        var clean:      SendSlot;
        clean.generation        = generation;
        driver.storage.sends[i] = clean;
        i                       = i + 1;
    }
    var empty_protocol: Protocol[T];
    driver.protocol                = empty_protocol;
    driver.streams                 = nil;
    driver.datagrams               = nil;
    driver.operation_scope         = nil;
    driver.storage.sends           = nil;
    driver.storage.send_capacity   = 0;
    driver.config.source           = 0;
    driver.config.max_udp_payload  = 0;
    driver.config.max_close_reason = 0;
    driver.role                    = 0;
    driver.next_slot               = 0;
    driver.pending_sends           = 0;
    driver.cancellation_calls      = 0;
    driver.application_error       = 0;
    atomic.store(?driver.callback_owner, 0);
    var empty_cancellation: Cancellation;
    driver.cancellation = empty_cancellation;
    driver.closing      = false;
    driver.initialized  = false;
    driver.released     = true;
    mutex.unlock(?driver.lock);
    ret operation_result(STATUS_OK, ERROR_NONE, 0, 0, CLOSED);
}

pub fun snapshot[T](driver: *Driver[T]) Snapshot {
    var result: Snapshot;
    if (callback_reentry[T](driver))          { ret result; }
    if (driver == nil || !driver.initialized) { ret result; }
    mutex.lock(?driver.lock);
    apply_cancellation[T](driver);
    result.source              = driver.config.source;
    result.role                = driver.role;
    result.state               = driver.state;
    result.close_mode          = driver.close_mode;
    result.close_cause         = driver.close_cause;
    result.terminal_cause      = driver.terminal_cause;
    result.cancellation_reason = driver.cancellation_reason;
    result.application_error   = driver.application_error;
    result.active_streams      = driver.streams.active_streams;
    result.pending_sends       = driver.pending_sends;
    result.queued_datagrams    = driver.datagrams.send_count;
    result.received_datagrams  = driver.datagrams.receive_count;
    result.initialized         = true;
    mutex.unlock(?driver.lock);
    ret result;
}
