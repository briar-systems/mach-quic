# official vectors and adversarial packet-protection lifecycle tests

use crypto.aead.aes_gcm;
use crypto.contracts;
use quic.crypto.protection;
use quic.packet.packet;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

fun secret_matches(actual: *^u8, expected: *u8, len: usize) bool {
    if (actual == nil || expected == nil) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun public_matches(actual: *u8, expected: *u8, len: usize) bool {
    if (actual == nil || expected == nil) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "quic.crypto.protection: RFC 9001 initial secrets and AES header mask" {
    var dcid: [8]u8 = [8]u8{0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08};
    var keys: protection.InitialKeys;
    if (protection.derive_initial(?keys, packet.VERSION_1,
        contracts.Bytes{data: ?dcid[0], len: 8}) != protection.OK) { ret 1; }

    val client_secret: [32]u8 = [32]u8{
        0xc0, 0x0c, 0xf1, 0x51, 0xca, 0x5b, 0xe0, 0x75,
        0xed, 0x0e, 0xbf, 0xb5, 0xc8, 0x03, 0x23, 0xc4,
        0x2d, 0x6b, 0x7d, 0xb6, 0x78, 0x81, 0x28, 0x9a,
        0xf4, 0x00, 0x8f, 0x1f, 0x6c, 0x35, 0x7a, 0xea,
    };
    val client_key: [16]u8 = [16]u8{
        0x1f, 0x36, 0x96, 0x13, 0xdd, 0x76, 0xd5, 0x46,
        0x77, 0x30, 0xef, 0xcb, 0xe3, 0xb1, 0xa2, 0x2d,
    };
    val client_iv: [12]u8 = [12]u8{
        0xfa, 0x04, 0x4b, 0x2f, 0x42, 0xa3, 0xfd, 0x3b,
        0x46, 0xfb, 0x25, 0x5c,
    };
    val client_hp: [16]u8 = [16]u8{
        0x9f, 0x50, 0x44, 0x9e, 0x04, 0xa0, 0xe8, 0x10,
        0x28, 0x3a, 0x1e, 0x99, 0x33, 0xad, 0xed, 0xd2,
    };
    val server_secret: [32]u8 = [32]u8{
        0x3c, 0x19, 0x98, 0x28, 0xfd, 0x13, 0x9e, 0xfd,
        0x21, 0x6c, 0x15, 0x5a, 0xd8, 0x44, 0xcc, 0x81,
        0xfb, 0x82, 0xfa, 0x8d, 0x74, 0x46, 0xfa, 0x7d,
        0x78, 0xbe, 0x80, 0x3a, 0xcd, 0xda, 0x95, 0x1b,
    };
    val server_key: [16]u8 = [16]u8{
        0xcf, 0x3a, 0x53, 0x31, 0x65, 0x3c, 0x36, 0x4c,
        0x88, 0xf0, 0xf3, 0x79, 0xb6, 0x06, 0x7e, 0x37,
    };
    val server_iv: [12]u8 = [12]u8{
        0x0a, 0xc1, 0x49, 0x3c, 0xa1, 0x90, 0x58, 0x53,
        0xb0, 0xbb, 0xa0, 0x3e,
    };
    val server_hp: [16]u8 = [16]u8{
        0xc2, 0x06, 0xb8, 0xd9, 0xb9, 0xf0, 0xf3, 0x76,
        0x44, 0x43, 0x0b, 0x49, 0x0e, 0xea, 0xa3, 0x14,
    };
    if (!secret_matches(?keys.client.secret[0], ?client_secret[0], 32)
        || !secret_matches(?keys.client.key[0], ?client_key[0], 16)
        || !secret_matches(?keys.client.iv[0], ?client_iv[0], 12)
        || !secret_matches(?keys.client.hp[0], ?client_hp[0], 16)
        || !secret_matches(?keys.server.secret[0], ?server_secret[0], 32)
        || !secret_matches(?keys.server.key[0], ?server_key[0], 16)
        || !secret_matches(?keys.server.iv[0], ?server_iv[0], 12)
        || !secret_matches(?keys.server.hp[0], ?server_hp[0], 16)) {
        protection.destroy_initial(?keys);
        ret 2;
    }

    var nonce: [12]u8;
    val expected_nonce: [12]u8 = [12]u8{
        0xfa, 0x04, 0x4b, 0x2f, 0x42, 0xa3, 0xfd, 0x3b,
        0x46, 0xfb, 0x25, 0x5e,
    };
    if (protection.make_nonce(?keys.client, 2,
        contracts.Buffer{data: ?nonce[0], capacity: 12}) != protection.OK
        || !public_matches(?nonce[0], ?expected_nonce[0], 12)) {
        protection.destroy_initial(?keys);
        ret 3;
    }

    var sample: [16]u8 = [16]u8{
        0xd1, 0xb1, 0xc9, 0x8d, 0xd7, 0x68, 0x9f, 0xb8,
        0xec, 0x11, 0xd2, 0x42, 0xb1, 0x23, 0xdc, 0x9b,
    };
    val expected_mask: [5]u8 = [5]u8{0x43, 0x7b, 0x9a, 0xec, 0x36};
    var mask: [5]^u8;
    val masked: protection.Result = protection.header_mask(?keys.client,
        contracts.Bytes{data: ?sample[0], len: 16},
        contracts.SecretBuffer{data: ?mask[0], capacity: 5});
    if (masked.error != protection.OK || masked.written != 5
        || !secret_matches(?mask[0], ?expected_mask[0], 5)) {
        protection.destroy_initial(?keys);
        ct.zeroize(?mask[0], 5);
        ret 4;
    }

    var packet_bytes: [38]u8;
    val header: [22]u8 = [22]u8{
        0xc3, 0x00, 0x00, 0x00, 0x01, 0x08, 0x83, 0x94,
        0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08, 0x00, 0x00,
        0x44, 0x9e, 0x00, 0x00, 0x00, 0x02,
    };
    val protected_header: [22]u8 = [22]u8{
        0xc0, 0x00, 0x00, 0x00, 0x01, 0x08, 0x83, 0x94,
        0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08, 0x00, 0x00,
        0x44, 0x9e, 0x7b, 0x9a, 0xec, 0x34,
    };
    var i: usize = 0;
    for (i < 22) { packet_bytes[i] = header[i]; i = i + 1; }
    i = 0;
    for (i < 16) { packet_bytes[22 + i] = sample[i]; i = i + 1; }
    if (protection.protect_header(?keys.client, ?packet_bytes[0], 38, 18, 4)
        != protection.OK || !public_matches(?packet_bytes[0], ?protected_header[0], 22)) {
        protection.destroy_initial(?keys);
        ct.zeroize(?mask[0], 5);
        ret 5;
    }
    protection.destroy_initial(?keys);
    ct.zeroize(?mask[0], 5);
    if (keys.client.state != protection.STATE_DISCARDED
        || keys.client.key[0]:>u8 != 0 || keys.server.secret[31]:>u8 != 0) { ret 6; }
    ret 0;
}

test "quic.crypto.protection: RFC 9369 version 2 initial material" {
    var dcid: [8]u8 = [8]u8{0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08};
    var keys: protection.InitialKeys;
    if (protection.derive_initial(?keys, packet.VERSION_2,
        contracts.Bytes{data: ?dcid[0], len: 8}) != protection.OK) { ret 1; }
    val client_secret: [32]u8 = [32]u8{
        0x14, 0xec, 0x9d, 0x6e, 0xb9, 0xfd, 0x7a, 0xf8,
        0x3b, 0xf5, 0xa6, 0x68, 0xbc, 0x17, 0xa7, 0xe2,
        0x83, 0x76, 0x6a, 0xad, 0xe7, 0xec, 0xd0, 0x89,
        0x1f, 0x70, 0xf9, 0xff, 0x7f, 0x4b, 0xf4, 0x7b,
    };
    val key: [16]u8 = [16]u8{
        0x8b, 0x1a, 0x0b, 0xc1, 0x21, 0x28, 0x42, 0x90,
        0xa2, 0x9e, 0x09, 0x71, 0xb5, 0xcd, 0x04, 0x5d,
    };
    val iv: [12]u8 = [12]u8{
        0x91, 0xf7, 0x3e, 0x23, 0x51, 0xd8, 0xfa, 0x91,
        0x66, 0x0e, 0x90, 0x9f,
    };
    val hp: [16]u8 = [16]u8{
        0x45, 0xb9, 0x5e, 0x15, 0x23, 0x5d, 0x6f, 0x45,
        0xa6, 0xb1, 0x9c, 0xbc, 0xb0, 0x29, 0x4b, 0xa9,
    };
    if (!secret_matches(?keys.client.secret[0], ?client_secret[0], 32)
        || !secret_matches(?keys.client.key[0], ?key[0], 16)
        || !secret_matches(?keys.client.iv[0], ?iv[0], 12)
        || !secret_matches(?keys.client.hp[0], ?hp[0], 16)) {
        protection.destroy_initial(?keys);
        ret 2;
    }
    protection.destroy_initial(?keys);
    ret 0;
}

test "quic.crypto.protection: RFC 9001 ChaCha packet and key update" {
    var secret: [32]^u8;
    val secret_public: [32]u8 = [32]u8{
        0x9a, 0xc3, 0x12, 0xa7, 0xf8, 0x77, 0x46, 0x8e,
        0xbe, 0x69, 0x42, 0x27, 0x48, 0xad, 0x00, 0xa1,
        0x54, 0x43, 0xf1, 0x82, 0x03, 0xa0, 0x7d, 0x60,
        0x60, 0xf6, 0x88, 0xf3, 0x0f, 0x21, 0x63, 0x2b,
    };
    var i: usize = 0;
    for (i < 32) { secret[i] = secret_public[i]; i = i + 1; }
    var send: protection.SendKeys;
    if (protection.init_send(?send, packet.VERSION_1,
        protection.CHACHA20_POLY1305_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.OK) { ret 1; }
    val key: [32]u8 = [32]u8{
        0xc6, 0xd9, 0x8f, 0xf3, 0x44, 0x1c, 0x3f, 0xe1,
        0xb2, 0x18, 0x20, 0x94, 0xf6, 0x9c, 0xaa, 0x2e,
        0xd4, 0xb7, 0x16, 0xb6, 0x54, 0x88, 0x96, 0x0a,
        0x7a, 0x98, 0x49, 0x79, 0xfb, 0x23, 0xe1, 0xc8,
    };
    val iv: [12]u8 = [12]u8{
        0xe0, 0x45, 0x9b, 0x34, 0x74, 0xbd, 0xd0, 0xe4,
        0x4a, 0x41, 0xc1, 0x44,
    };
    val hp: [32]u8 = [32]u8{
        0x25, 0xa2, 0x82, 0xb9, 0xe8, 0x2f, 0x06, 0xf2,
        0x1f, 0x48, 0x89, 0x17, 0xa4, 0xfc, 0x8f, 0x1b,
        0x73, 0x57, 0x36, 0x85, 0x60, 0x85, 0x97, 0xd0,
        0xef, 0xcb, 0x07, 0x6b, 0x0a, 0xb7, 0xa7, 0xa4,
    };
    if (!secret_matches(?send.current.key[0], ?key[0], 32)
        || !secret_matches(?send.current.iv[0], ?iv[0], 12)
        || !secret_matches(?send.current.hp[0], ?hp[0], 32)) {
        protection.destroy_send(?send);
        ct.zeroize(?secret[0], 32);
        ret 2;
    }

    var header: [4]u8 = [4]u8{0x42, 0x00, 0xbf, 0xf4};
    var plaintext: [1]^u8;
    plaintext[0] = 0x01;
    var protected_packet: [21]u8;
    val expected_packet: [21]u8 = [21]u8{
        0x4c, 0xfe, 0x41, 0x89, 0x65, 0x5e, 0x5c,
        0xd5, 0x5c, 0x41, 0xf6, 0x90, 0x80, 0x57, 0x5d,
        0x79, 0x99, 0xc2, 0x5a, 0x5b, 0xfb,
    };
    val sealed: protection.Result = protection.seal_packet(?send.current, 654360564,
        contracts.Bytes{data: ?header[0], len: 4}, 1,
        contracts.SecretBytes{data: ?plaintext[0], len: 1},
        contracts.Buffer{data: ?protected_packet[0], capacity: 21});
    if (sealed.error != protection.OK || sealed.written != 21
        || !public_matches(?protected_packet[0], ?expected_packet[0], 21)) {
        protection.destroy_send(?send);
        ct.zeroize(?secret[0], 32);
        ct.zeroize(?plaintext[0], 1);
        ret 3;
    }
    var header_scratch: [4]u8;
    var opened_plaintext: [1]^u8;
    val opened: protection.OpenResult = protection.open_packet(?send.current, 654360565,
        contracts.Bytes{data: ?protected_packet[0], len: 21}, 1,
        contracts.Buffer{data: ?header_scratch[0], capacity: 4},
        contracts.SecretBuffer{data: ?opened_plaintext[0], capacity: 1});
    if (opened.error != protection.OK) {
        protection.destroy_send(?send);
        ct.zeroize(?secret[0], 32);
        ct.zeroize(?plaintext[0], 1);
        ct.zeroize(?opened_plaintext[0], 1);
        ret 50 + opened.error::i32;
    }
    if (opened.written != 1) { ret 40; }
    if (opened.packet_number != 654360564) { ret 41; }
    if (opened.packet_number_len != 3) { ret 42; }
    if (opened.key_phase) { ret 43; }
    if (opened.key_updated || opened.generation != 1) { ret 46; }
    if (opened_plaintext[0]:>u8 != 1) { ret 44; }
    if (!public_matches(?header_scratch[0], ?header[0], 4)) { ret 45; }

    if (protection.initiate_update(?send) != protection.KEY_UPDATE_ERROR
        || protection.confirm_handshake_send(?send) != protection.OK
        || protection.initiate_update(?send) != protection.OK
        || !send.phase || send.generation != 2
        || !secret_matches(?send.current.hp[0], ?hp[0], 32)) {
        protection.destroy_send(?send);
        ct.zeroize(?secret[0], 32);
        ret 5;
    }
    val updated_secret: [32]u8 = [32]u8{
        0x12, 0x23, 0x50, 0x47, 0x55, 0x03, 0x6d, 0x55,
        0x63, 0x42, 0xee, 0x93, 0x61, 0xd2, 0x53, 0x42,
        0x1a, 0x82, 0x6c, 0x9e, 0xcd, 0xf3, 0xc7, 0x14,
        0x86, 0x84, 0xb3, 0x6b, 0x71, 0x48, 0x81, 0xf9,
    };
    if (!secret_matches(?send.current.secret[0], ?updated_secret[0], 32)
        || protection.initiate_update(?send) != protection.KEY_UPDATE_ERROR
        || protection.note_sent(?send, 10) != protection.OK
        || protection.note_acknowledged(?send, 9) != protection.KEY_UPDATE_ERROR
        || protection.note_acknowledged(?send, 10) != protection.OK
        || protection.initiate_update(?send) != protection.OK
        || send.phase || send.generation != 3) {
        protection.destroy_send(?send);
        ct.zeroize(?secret[0], 32);
        ret 6;
    }
    protection.destroy_send(?send);
    ct.zeroize(?secret[0], 32);
    ct.zeroize(?plaintext[0], 1);
    ct.zeroize(?opened_plaintext[0], 1);
    ret 0;
}

test "quic.crypto.protection: Retry integrity is exact and transactional" {
    var odcid: [8]u8 = [8]u8{0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08};
    var retry: [20]u8 = [20]u8{
        0xff, 0x00, 0x00, 0x00, 0x01, 0x00, 0x08, 0xf0,
        0x67, 0xa5, 0x50, 0x2a, 0x42, 0x62, 0xb5, 0x74,
        0x6f, 0x6b, 0x65, 0x6e,
    };
    val expected: [16]u8 = [16]u8{
        0x04, 0xa2, 0x65, 0xba, 0x2e, 0xff, 0x4d, 0x82,
        0x90, 0x58, 0xfb, 0x3f, 0x0f, 0x24, 0x96, 0xba,
    };
    var pseudo: [29]u8;
    var tag: [16]^u8;
    val result: protection.Result = protection.retry_tag(packet.VERSION_1,
        contracts.Bytes{data: ?odcid[0], len: 8},
        contracts.Bytes{data: ?retry[0], len: 20},
        contracts.Buffer{data: ?pseudo[0], capacity: 29},
        contracts.SecretBuffer{data: ?tag[0], capacity: 16});
    if (result.error != protection.OK || result.written != 16
        || !secret_matches(?tag[0], ?expected[0], 16)
        || protection.verify_retry(packet.VERSION_1,
            contracts.Bytes{data: ?odcid[0], len: 8},
            contracts.Bytes{data: ?retry[0], len: 20},
            contracts.Bytes{data: ?expected[0], len: 16},
            contracts.Buffer{data: ?pseudo[0], capacity: 29}) != protection.OK) {
        ct.zeroize(?tag[0], 16);
        ret 1;
    }
    var corrupted: [16]u8;
    var i: usize = 0;
    for (i < 16) { corrupted[i] = expected[i]; i = i + 1; }
    corrupted[15] = corrupted[15] ^ 1;
    if (protection.verify_retry(packet.VERSION_1,
        contracts.Bytes{data: ?odcid[0], len: 8},
        contracts.Bytes{data: ?retry[0], len: 20},
        contracts.Bytes{data: ?corrupted[0], len: 16},
        contracts.Buffer{data: ?pseudo[0], capacity: 29}) != protection.AUTH_FAILED) {
        ct.zeroize(?tag[0], 16);
        ret 2;
    }
    var retry_v2: [20]u8 = [20]u8{
        0xcf, 0x6b, 0x33, 0x43, 0xcf, 0x00, 0x08, 0xf0,
        0x67, 0xa5, 0x50, 0x2a, 0x42, 0x62, 0xb5, 0x74,
        0x6f, 0x6b, 0x65, 0x6e,
    };
    val expected_v2: [16]u8 = [16]u8{
        0xc8, 0x64, 0x6c, 0xe8, 0xbf, 0xe3, 0x39, 0x52,
        0xd9, 0x55, 0x54, 0x36, 0x65, 0xdc, 0xc7, 0xb6,
    };
    if (protection.retry_tag(packet.VERSION_2,
        contracts.Bytes{data: ?odcid[0], len: 8},
        contracts.Bytes{data: ?retry_v2[0], len: 20},
        contracts.Buffer{data: ?pseudo[0], capacity: 29},
        contracts.SecretBuffer{data: ?tag[0], capacity: 16}).error != protection.OK
        || !secret_matches(?tag[0], ?expected_v2[0], 16)) {
        ct.zeroize(?tag[0], 16);
        ret 3;
    }
    var sentinel: [16]^u8;
    sentinel[0] = 0xaa;
    if (protection.retry_tag(7,
        contracts.Bytes{data: ?odcid[0], len: 8},
        contracts.Bytes{data: ?retry[0], len: 20},
        contracts.Buffer{data: ?pseudo[0], capacity: 29},
        contracts.SecretBuffer{data: ?sentinel[0], capacity: 16}).error
        != protection.UNSUPPORTED_VERSION || sentinel[0]:>u8 != 0xaa) {
        ct.zeroize(?tag[0], 16);
        ct.zeroize(?sentinel[0], 16);
        ret 4;
    }
    ct.zeroize(?tag[0], 16);
    ct.zeroize(?sentinel[0], 16);
    ret 0;
}

test "quic.crypto.protection: invalid tags release no packet plaintext" {
    var secret: [32]^u8;
    var i: usize = 0;
    for (i < 32) { secret[i] = (i + 1)::u8; i = i + 1; }
    var keys: protection.KeySet;
    if (protection.derive_tls(?keys, packet.VERSION_1, protection.LEVEL_HANDSHAKE,
        protection.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.OK) { ret 1; }
    var header: [2]u8 = [2]u8{0x40, 0x07};
    var plaintext: [20]^u8;
    plaintext[0] = 0x01; plaintext[1] = 0x02; plaintext[2] = 0x03;
    var wire: [38]u8;
    val sealed: protection.Result = protection.seal_packet(?keys, 7,
        contracts.Bytes{data: ?header[0], len: 2}, 1,
        contracts.SecretBytes{data: ?plaintext[0], len: 20},
        contracts.Buffer{data: ?wire[0], capacity: 38});
    if (sealed.error != protection.OK) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 32); ret 2;
    }
    wire[37] = wire[37] ^ 1;
    var scratch: [5]u8;
    var output: [20]^u8;
    output[0] = 0xaa; output[1] = 0xbb; output[2] = 0xcc;
    val opened: protection.OpenResult = protection.open_packet(?keys, 8,
        contracts.Bytes{data: ?wire[0], len: 38}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?output[0], capacity: 20});
    if (opened.error != protection.AUTH_FAILED) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 32);
        ct.zeroize(?plaintext[0], 20); ct.zeroize(?output[0], 20);
        ret 60 + opened.error::i32;
    }
    if (opened.written != 0) { ret 30; }
    if (opened.header_len != 0) { ret 31; }
    if (opened.packet_number != 0) { ret 32; }
    i = 0;
    for (i < 20) { if (output[i]:>u8 != 0) { ret 33; } i = i + 1; }
    if (protection.seal_packet(?keys, 7,
        contracts.Bytes{data: ?header[0], len: 2}, 1,
        contracts.SecretBytes{data: ?plaintext[0], len: 20},
        contracts.Buffer{data: ?wire[0], capacity: 38}).error != protection.OK) { ret 34; }
    wire[5] = wire[5] ^ 0x18;
    output[0] = 0xaa;
    val sample_corrupted: protection.OpenResult = protection.open_packet(?keys, 8,
        contracts.Bytes{data: ?wire[0], len: 38}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?output[0], capacity: 20});
    if (sample_corrupted.error != protection.AUTH_FAILED || output[0]:>u8 != 0) { ret 35; }
    protection.destroy(?keys);
    ct.zeroize(?secret[0], 32);
    ct.zeroize(?plaintext[0], 20);
    ct.zeroize(?output[0], 20);
    ret 0;
}

test "quic.crypto.protection: receive key phases retain old and prederive next" {
    var secret: [32]^u8;
    var i: usize = 0;
    for (i < 32) { secret[i] = (0x80 + i)::u8; i = i + 1; }
    var send: protection.SendKeys;
    var response_send: protection.SendKeys;
    var receive: protection.ReceiveKeys;
    if (protection.init_send(?send, packet.VERSION_1,
        protection.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.OK
        || protection.init_send(?response_send, packet.VERSION_1,
            protection.AES_128_GCM_SHA256,
            contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.OK
        || protection.confirm_handshake_send(?response_send) != protection.OK
        || protection.init_receive(?receive, packet.VERSION_1,
        protection.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.OK) { ret 1; }
    var first_header: [2]u8 = [2]u8{0x40, 0x64};
    var payload: [3]^u8;
    payload[0] = 1; payload[1] = 2; payload[2] = 3;
    var first_wire: [21]u8;
    if (protection.seal_send_packet(?send, 100,
        contracts.Bytes{data: ?first_header[0], len: 2}, 1,
        contracts.SecretBytes{data: ?payload[0], len: 3},
        contracts.Buffer{data: ?first_wire[0], capacity: 21}).error != protection.OK) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ct.zeroize(?payload[0], 3); ret 2;
    }
    var duplicate_output: [21]u8;
    duplicate_output[0] = 0xa5;
    if (protection.seal_send_packet(?send, 100,
        contracts.Bytes{data: ?first_header[0], len: 2}, 1,
        contracts.SecretBytes{data: ?payload[0], len: 3},
        contracts.Buffer{data: ?duplicate_output[0], capacity: 21}).error
        != protection.PACKET_NUMBER_ERROR || duplicate_output[0] != 0xa5
        || protection.note_acknowledged(?send, 101) != protection.KEY_UPDATE_ERROR) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ct.zeroize(?payload[0], 3); ret 8;
    }
    var scratch: [5]u8;
    var opened_payload: [3]^u8;
    var opened: protection.OpenResult = protection.open_receive_packet(?receive, 101,
        contracts.Bytes{data: ?first_wire[0], len: 21}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?opened_payload[0], capacity: 3});
    if (opened.error != protection.OK || opened.packet_number != 100
        || opened.key_updated || opened.generation != 1
        || receive.generation != 1 || receive.current_floor != 100
        || opened_payload[2]:>u8 != 3) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ct.zeroize(?payload[0], 3);
        ct.zeroize(?opened_payload[0], 3); ret 3;
    }
    if (protection.confirm_handshake_send(?send) != protection.OK
        || protection.initiate_update(?send) != protection.OK) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 4;
    }
    var second_header: [2]u8 = [2]u8{0x44, 0x65};
    var second_wire: [21]u8;
    if (protection.seal_send_packet(?send, 101,
        contracts.Bytes{data: ?second_header[0], len: 2}, 1,
        contracts.SecretBytes{data: ?payload[0], len: 3},
        contracts.Buffer{data: ?second_wire[0], capacity: 21}).error != protection.OK) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 5;
    }
    opened = protection.open_receive_packet(?receive, 102,
        contracts.Bytes{data: ?second_wire[0], len: 21}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?opened_payload[0], capacity: 3});
    if (opened.error != protection.KEY_UPDATE_ERROR || receive.generation != 1
        || opened_payload[0]:>u8 != 0
        || protection.confirm_handshake_receive(?receive) != protection.OK) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 13;
    }
    opened = protection.open_receive_packet(?receive, 102,
        contracts.Bytes{data: ?second_wire[0], len: 21}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?opened_payload[0], capacity: 3});
    if (opened.error != protection.OK || !opened.key_phase || !opened.key_updated
        || opened.generation != 2
        || !receive.phase || receive.generation != 2 || !receive.have_previous
        || receive.current_floor != 101 || receive.next.generation != 3
        || protection.respond_to_update(?response_send, opened.generation) != protection.OK
        || response_send.generation != 2 || !response_send.phase) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 6;
    }
    opened = protection.open_receive_packet(?receive, 101,
        contracts.Bytes{data: ?first_wire[0], len: 21}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?opened_payload[0], capacity: 3});
    if (opened.error != protection.OK || opened.key_phase || receive.generation != 2) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 7;
    }
    if (protection.note_acknowledged(?send, 101) != protection.OK
        || protection.initiate_update(?send) != protection.OK) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 9;
    }
    var third_header: [2]u8 = [2]u8{0x40, 0x66};
    var third_wire: [21]u8;
    if (protection.seal_send_packet(?send, 102,
        contracts.Bytes{data: ?third_header[0], len: 2}, 1,
        contracts.SecretBytes{data: ?payload[0], len: 3},
        contracts.Buffer{data: ?third_wire[0], capacity: 21}).error != protection.OK) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 10;
    }
    opened_payload[0] = 0xaa;
    opened = protection.open_receive_packet(?receive, 103,
        contracts.Bytes{data: ?third_wire[0], len: 21}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?opened_payload[0], capacity: 3});
    if (opened.error != protection.KEY_UPDATE_ERROR || opened_payload[0]:>u8 != 0
        || receive.generation != 2
        || protection.confirm_update_response(?receive, 2, 100)
            != protection.KEY_UPDATE_ERROR
        || protection.confirm_update_response(?receive, 2, 101) != protection.OK) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 11;
    }
    opened = protection.open_receive_packet(?receive, 103,
        contracts.Bytes{data: ?third_wire[0], len: 21}, 1,
        contracts.Buffer{data: ?scratch[0], capacity: 5},
        contracts.SecretBuffer{data: ?opened_payload[0], capacity: 3});
    if (opened.error != protection.OK || !opened.key_updated || opened.generation != 3
        || receive.phase || receive.generation != 3
        || protection.discard_previous(?receive) != protection.OK
        || receive.have_previous || receive.previous.state != protection.STATE_DISCARDED) {
        protection.destroy_send(?send); protection.destroy_send(?response_send);
        protection.destroy_receive(?receive);
        ct.zeroize(?secret[0], 32); ret 12;
    }
    protection.destroy_send(?send);
    protection.destroy_send(?response_send);
    protection.destroy_receive(?receive);
    ct.zeroize(?secret[0], 32);
    ct.zeroize(?payload[0], 3);
    ct.zeroize(?opened_payload[0], 3);
    ret 0;
}

test "quic.crypto.protection: AES-256 dispatch agrees with the pinned AEAD" {
    var secret: [48]^u8;
    var i: usize = 0;
    for (i < 48) { secret[i] = (i * 3 + 1)::u8; i = i + 1; }
    var keys: protection.KeySet;
    if (protection.derive_tls(?keys, packet.VERSION_1, protection.LEVEL_APPLICATION,
        protection.AES_256_GCM_SHA384,
        contracts.SecretBytes{data: ?secret[0], len: 48}) != protection.OK) { ret 1; }
    var aad: [3]u8 = [3]u8{0x40, 0x00, 0x01};
    var plaintext: [7]^u8;
    i = 0;
    for (i < 7) { plaintext[i] = (0xa0 + i)::u8; i = i + 1; }
    var actual: [23]u8;
    val sealed: protection.Result = protection.seal(?keys, 1,
        contracts.Bytes{data: ?aad[0], len: 3},
        contracts.SecretBytes{data: ?plaintext[0], len: 7},
        contracts.Buffer{data: ?actual[0], capacity: 23});
    var nonce: [12]u8;
    if (sealed.error != protection.OK || protection.make_nonce(?keys, 1,
        contracts.Buffer{data: ?nonce[0], capacity: 12}) != protection.OK) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 48); ret 2;
    }
    var expected: [23]u8;
    val direct: contracts.Operation = aes_gcm.seal(
        contracts.SecretBytes{data: ?keys.key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12},
        contracts.Bytes{data: ?aad[0], len: 3},
        contracts.SecretBytes{data: ?plaintext[0], len: 7},
        contracts.Buffer{data: ?expected[0], capacity: 23});
    if (direct.error != contracts.OK || direct.written != sealed.written
        || !public_matches(?actual[0], ?expected[0], 23)) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 48);
        ct.zeroize(?plaintext[0], 7); ret 3;
    }
    protection.destroy(?keys);
    ct.zeroize(?secret[0], 48);
    ct.zeroize(?plaintext[0], 7);
    ret 0;
}

test "quic.crypto.protection: bounds and discarded states are transactional" {
    var secret: [32]^u8;
    var i: usize = 0;
    for (i < 32) { secret[i] = i::u8; i = i + 1; }
    var keys: protection.KeySet;
    keys.state = protection.STATE_ACTIVE;
    keys.version = 77;
    keys.secret[0] = 0xaa;
    if (protection.derive_tls(?keys, 7, protection.LEVEL_APPLICATION,
        protection.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.UNSUPPORTED_VERSION
        || keys.version != 77 || keys.secret[0]:>u8 != 0xaa) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 32); ret 1;
    }
    if (protection.derive_tls(?keys, packet.VERSION_1, protection.LEVEL_INITIAL,
        protection.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.INVALID_INPUT
        || keys.version != 77 || keys.secret[0]:>u8 != 0xaa) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 32); ret 2;
    }
    if (protection.derive_tls(?keys, packet.VERSION_1, protection.LEVEL_EARLY,
        protection.AES_128_GCM_SHA256,
        contracts.SecretBytes{data: ?secret[0], len: 32}) != protection.OK
        || keys.level != protection.LEVEL_EARLY || keys.state != protection.STATE_ACTIVE) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 32); ret 3;
    }
    var mask: [5]^u8;
    mask[0] = 0xa5;
    var short_sample: [15]u8;
    if (protection.header_mask(?keys,
        contracts.Bytes{data: ?short_sample[0], len: 15},
        contracts.SecretBuffer{data: ?mask[0], capacity: 5}).error != protection.SAMPLE_ERROR
        || mask[0]:>u8 != 0xa5) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 32);
        ct.zeroize(?mask[0], 5); ret 4;
    }
    var nonce_sentinel: [12]u8;
    nonce_sentinel[0] = 0x5a;
    if (protection.make_nonce(?keys, packet.MAX_PACKET_NUMBER + 1,
        contracts.Buffer{data: ?nonce_sentinel[0], capacity: 12})
        != protection.PACKET_NUMBER_ERROR || nonce_sentinel[0] != 0x5a) {
        protection.destroy(?keys); ct.zeroize(?secret[0], 32);
        ct.zeroize(?mask[0], 5); ret 5;
    }
    protection.destroy(?keys);
    var output: [16]u8;
    output[0] = 0x5a;
    if (protection.seal(?keys, 0, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: nil, len: 0},
        contracts.Buffer{data: ?output[0], capacity: 16}).error != protection.KEYS_DISCARDED
        || output[0] != 0x5a || protection.make_nonce(?keys, 0,
            contracts.Buffer{data: ?output[0], capacity: 12}) != protection.KEYS_DISCARDED
        || output[0] != 0x5a) {
        ct.zeroize(?secret[0], 32); ct.zeroize(?mask[0], 5); ret 6;
    }
    var initial: protection.InitialKeys;
    initial.state = protection.STATE_ACTIVE;
    initial.client.generation = 99;
    var oversized: [21]u8;
    if (protection.derive_initial(?initial, packet.VERSION_1,
        contracts.Bytes{data: ?oversized[0], len: 21}) != protection.INVALID_INPUT
        || initial.state != protection.STATE_ACTIVE || initial.client.generation != 99) {
        protection.destroy_initial(?initial); ct.zeroize(?secret[0], 32);
        ct.zeroize(?mask[0], 5); ret 7;
    }
    protection.destroy_initial(?initial);
    ct.zeroize(?secret[0], 32);
    ct.zeroize(?mask[0], 5);
    ret 0;
}
