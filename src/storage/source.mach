# where connection storage comes from: a std buffer source, seen through one
# connection's account
#
# every chunk quic takes is at most BYTES long and charged to one of two lanes,
# send or receive. tls charges the same account on a third lane of its own,
# for chunks it takes through its lease. a refusal is backpressure: the account is registered with the
# source and woken once chunks come back. this is the only module that calls the
# source, so the rest of quic depends on the handful of operations below

use quic.storage.limited;

use std.memory.buffers;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Provider: buffers.Source;
pub def Account:  buffers.Account;
pub def Ref:      buffers.Ref;
pub def Chunk:    buffers.Chunk;

# the largest request quic makes, and the unit budgets are counted in
pub val BYTES: usize = 4096;

pub def Lane: u8;
pub val SEND:    Lane = 0;
pub val RECEIVE: Lane = 1;
pub val TLS:     Lane = 2;
pub val LANES:   u8   = 3;

# the chunk sizes a connection asks a source for: quic's BYTES, and the sizes
# mach-tls requests for handshake messages and records
pub val CLASS_COUNT: usize = 3;
pub val SMALL:       usize = 512;
pub val RECORD:      usize = 17408;

# one connection's view of its provider, charged to one lane
pub rec Source {
    provider: *Provider;
    account:  *Account;
    lane:     Lane;
}

pub rec Taken {
    ok:    bool;
    chunk: Chunk;
}

# the CLASS_COUNT plain classes a connection asks for, smallest first
# ---
# output:     CLASS_COUNT entries
# high_water: released chunks each class keeps for reuse
pub fun classes(output: *buffers.ClassConfig, high_water: usize) {
    output[0] = buffers.ClassConfig{size: SMALL, align: 0, secret: false,
        high_water: high_water};
    output[1] = buffers.ClassConfig{size: BYTES, align: 0, secret: false,
        high_water: high_water};
    output[2] = buffers.ClassConfig{size: RECORD, align: 0, secret: false,
        high_water: high_water};
}

# a pool configuration over `class_count` classes with room for `bytes`
# across every account
pub fun pool_config(classes: *buffers.ClassConfig, class_count: usize,
    bytes: usize) buffers.Config {
    var config: buffers.Config;
    config.classes       = classes;
    config.class_count   = class_count;
    config.lanes         = LANES;
    config.global_budget = bytes;
    ret config;
}

# opens a connection's account with quic's budgets and reservation in chunks
# and tls's budget in bytes
pub fun open_connection(provider: *Provider, account: *Account, handle: u64,
    send: usize, receive: usize, tls: usize, reserve: usize) bool {
    var budgets: [3]usize       = [3]usize{send * BYTES, receive * BYTES, tls};
    val reason:  buffers.Reason = buffers.source_open_account(provider, account, handle, ?budgets[0],
        reserve * BYTES);
    ret sel reason.none;
}

# opens an account for quic's own chunks alone, with no tls lane
pub fun open(provider: *Provider, account: *Account, handle: u64, send: usize,
    receive: usize, reserve: usize) bool {
    ret open_connection(provider, account, handle, send, receive, 0, reserve);
}

pub fun close(provider: *Provider, account: *Account) bool {
    val reason: buffers.Reason = buffers.source_close_account(provider, account);
    ret sel reason.none;
}

# whole chunks the account holds on a lane
pub fun held(account: *Account, lane: Lane) usize {
    ret (account.used[lane::usize] + BYTES - 1) / BYTES;
}

# a chunk with room for `bytes`, registering the account for a wake on
# refusal. it is always a whole BYTES chunk, the unit quic's budgets count, so a
# source with smaller classes never hands quic a chunk its arithmetic misses
pub fun take(from: *Source, bytes: usize) Taken {
    var taken: Taken;
    if (from.provider == nil || bytes == 0 || bytes > BYTES) { ret taken; }
    val got: buffers.Acquired = buffers.source_acquire(from.provider, from.account,
        buffers.Request{bytes: BYTES, align: 0, lane: from.lane, secret: false}, true);
    if (!sel got.status.ok) { ret taken; }
    taken.ok    = true;
    taken.chunk = got.chunk;
    ret taken;
}

# gives a chunk back. a refused release leaves it held
pub fun give(from: *Source, chunk: Chunk) bool {
    val reason: buffers.Reason = buffers.source_release(from.provider, from.account, chunk);
    ret sel reason.none;
}

# a chunk is retained while bytes sealed from it are in flight
pub fun retain(provider: *Provider, ref: Ref) bool {
    val reason: buffers.Reason = buffers.source_retain(provider, ref);
    ret sel reason.none;
}

pub fun settle(provider: *Provider, ref: Ref) bool {
    val reason: buffers.Reason = buffers.source_settle(provider, ref);
    ret sel reason.none;
}

pub fun in_flight(provider: *Provider, ref: Ref) bool {
    ret buffers.source_in_flight(provider, ref);
}

# the handles of accounts woken since the last call, oldest first
pub fun ready(provider: *Provider, output: *u64, capacity: usize) usize {
    ret buffers.source_ready(provider, output, capacity);
}

# room for this many tls record chunks beside the BYTES chunks of a test pool
val TEST_RECORDS: usize = 4;

# a pool with room for `chunks` BYTES chunks and a few tls records over
# `memory`, for tests
# ---
# configs: CLASS_COUNT entries
pub fun test_pool(pool: *buffers.Pool, configs: *buffers.ClassConfig,
    memory: *limited.Limited, chunks: usize) bool {
    classes(configs, 0);
    val bytes: usize = chunks * BYTES + TEST_RECORDS * RECORD;
    if (memory.a.ctx == nil && !limited.make(memory, (bytes + 16 * BYTES) * 2)) {
        ret false;
    }
    ret buffers.make(pool, pool_config(configs, CLASS_COUNT, bytes),
        limited.allocator_of(memory));
}

# a whole test pool and its provider, which must not move once made
pub rec TestPool {
    memory:   limited.Limited;
    pool:     buffers.Pool;
    classes:  [CLASS_COUNT]buffers.ClassConfig;
    provider: Provider;
}

pub fun make_test(fixture: *TestPool, chunks: usize) bool {
    if (!test_pool(?fixture.pool, ?fixture.classes[0], ?fixture.memory, chunks)) { ret false; }
    fixture.provider = buffers.source(?fixture.pool);
    ret true;
}

pub fun test_made(fixture: *TestPool) bool {
    ret fixture.provider.ctx != nil;
}

# ends a test pool once every account on it is closed, keeping its memory for
# the next make
pub fun end_test(fixture: *TestPool) bool {
    if (!test_made(fixture) || !buffers.destroy(?fixture.pool)) { ret false; }
    var none: Provider;
    fixture.provider = none;
    ret true;
}

# misuse a pool has refused so far
pub fun misuse(pool: *buffers.Pool) u64 {
    var view: buffers.Snapshot;
    if (!buffers.snapshot(pool, ?view)) { ret 0; }
    ret view.misuse;
}
