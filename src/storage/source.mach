# where connection storage comes from: a std buffer source, seen through one
# connection's account
#
# every chunk quic takes is at most BYTES long and charged to one of two lanes,
# send or receive. tls charges the same account on a third lane of its own,
# for chunks it takes through its lease. a refusal is backpressure: the account is registered with the
# source and woken once chunks come back. this is the only module that calls the
# source, so the rest of quic depends on the handful of operations below

use quic.storage.limited;

use std.memory.buffers;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Provider:       buffers.Source;
pub def SecretProvider: buffers.SecretSource;
pub def Account:        buffers.Account;
pub def Ref:            buffers.Ref;
pub def Chunk:          buffers.Chunk;

# the largest request quic makes, and the unit budgets are counted in
pub val BYTES: usize = 4096;

pub def Lane: u8;
pub val SEND:    Lane = 0;
pub val RECEIVE: Lane = 1;
pub val TLS:     Lane = 2;
pub val LANES:   u8   = 3;
# lanes a source can declare at most, and so how many a caller may add
pub val MAX_LANES:       usize = buffers.MAX_LANES;
pub val MAX_EXTRA_LANES: usize = buffers.MAX_LANES - LANES::usize;

# the chunk sizes a connection asks a source for: quic's BYTES, the sizes
# mach-tls requests for handshake messages and records, and a secret BYTES
# class for key material
pub val CLASS_COUNT: usize = 4;
pub val SMALL:       usize = 512;
pub val RECORD:      usize = 17408;

# one connection's view of its provider, charged to one lane
pub rec Source {
    provider: *Provider;
    account:  *Account;
    lane:     Lane;
}

# one connection's view of its provider's secret chunks, charged to one lane
# of the same account
pub rec SecretSource {
    provider: *SecretProvider;
    account:  *Account;
    lane:     Lane;
}

pub rec Taken {
    ok:    bool;
    chunk: Chunk;
}

# the CLASS_COUNT classes a connection asks for, the plain ones smallest first
# ---
# output:     CLASS_COUNT entries
# high_water: released chunks each class keeps for reuse
pub fun classes(output: *buffers.ClassConfig, high_water: usize) {
    output[0] = buffers.ClassConfig{size: SMALL, align: 0, secret: false,
        high_water: high_water};
    output[1] = buffers.ClassConfig{size: BYTES, align: 0, secret: false,
        high_water: high_water};
    output[2] = buffers.ClassConfig{size: RECORD, align: 0, secret: false,
        high_water: high_water};
    output[3] = buffers.ClassConfig{size: BYTES, align: 0, secret: true,
        high_water: high_water};
}

# a pool configuration over `class_count` classes with room for `bytes`
# across every account
pub fun pool_config(classes: *buffers.ClassConfig, class_count: usize,
    bytes: usize) buffers.Config {
    ret pool_config_lanes(classes, class_count, bytes, 0);
}

# as pool_config, with `extra` caller lanes after quic's three
pub fun pool_config_lanes(classes: *buffers.ClassConfig, class_count: usize,
    bytes: usize, extra: usize) buffers.Config {
    var config: buffers.Config;
    config.classes       = classes;
    config.class_count   = class_count;
    config.lanes         = LANES + extra::u8;
    config.global_budget = bytes;
    ret config;
}

# opens a connection's account with quic's budgets and reservation in chunks,
# tls's budget in bytes, and the caller's `extra_count` budgets on the lanes
# after quic's. it supplies exactly LANES + extra_count budgets, so it refuses
# a source that does not declare exactly that many lanes, including one that
# declares none, and a total above MAX_LANES. a wrapping source must forward
# fn_lanes
pub fun open_connection(provider: *Provider, account: *Account, handle: u64,
    send: usize, receive: usize, tls: usize, reserve: usize,
    extra: *usize, extra_count: usize) bool {
    if (provider == nil || extra_count > MAX_EXTRA_LANES ||
        (extra == nil) != (extra_count == 0) ||
        buffers.source_lanes(provider) != LANES::usize + extra_count) { ret false; }
    var budgets: buffers.Budgets;
    budgets.lanes    = LANES::usize + extra_count;
    budgets.bytes[0] = send * BYTES;
    budgets.bytes[1] = receive * BYTES;
    budgets.bytes[2] = tls;
    var i: usize = 0;
    for (i < extra_count) {
        budgets.bytes[LANES::usize + i] = extra[i];
        i                               = i + 1;
    }
    val reason: buffers.Reason = buffers.source_open_account(provider, account, handle,
        budgets, reserve * BYTES);
    ret sel reason.none;
}

# opens an account for quic's own chunks alone, with no tls lane and no
# caller lanes. it refuses a source that does not declare exactly LANES lanes,
# as open_connection does
pub fun open(provider: *Provider, account: *Account, handle: u64, send: usize,
    receive: usize, reserve: usize) bool {
    ret open_connection(provider, account, handle, send, receive, 0, reserve, nil, 0);
}

# the lanes a source declares, 0 when it declares none
pub fun source_lanes_of(provider: *Provider) usize {
    ret buffers.source_lanes(provider);
}

pub fun close(provider: *Provider, account: *Account) bool {
    val reason: buffers.Reason = buffers.source_close_account(provider, account);
    ret sel reason.none;
}

# whole chunks the account holds on a lane
pub fun held(account: *Account, lane: Lane) usize {
    ret (account.used[lane::usize] + BYTES - 1) / BYTES;
}

# a chunk of at least `bytes`, registering the account for a wake on refusal.
# the source picks the smallest class that fits and charges what it hands out,
# so budgets, which are bytes, stay exact
pub fun take(from: *Source, bytes: usize) Taken {
    var taken: Taken;
    if (from.provider == nil || bytes == 0 || bytes > BYTES) { ret taken; }
    val got: buffers.Acquired = buffers.source_acquire(from.provider, from.account,
        buffers.Request{bytes: bytes, align: 0, lane: from.lane, secret: false}, true);
    if (!sel got.status.ok) { ret taken; }
    taken.ok    = true;
    taken.chunk = got.chunk;
    ret taken;
}

# gives a chunk back. a refused release leaves it held
pub fun give(from: *Source, chunk: Chunk) bool {
    val reason: buffers.Reason = buffers.source_release(from.provider, from.account, chunk);
    ret sel reason.none;
}

# a secret chunk of at least `bytes`, registering the account for a wake on
# refusal. its bytes are reached only through the provider's welded view
pub fun take_secret(from: *SecretSource, bytes: usize) Taken {
    var taken: Taken;
    if (from.provider == nil || bytes == 0 || bytes > BYTES) { ret taken; }
    val got: buffers.Acquired = buffers.secret_source_acquire(from.provider, from.account,
        buffers.Request{bytes: bytes, align: 0, lane: from.lane, secret: true}, true);
    if (!sel got.status.ok) { ret taken; }
    taken.ok    = true;
    taken.chunk = got.chunk;
    ret taken;
}

# wipes a secret chunk in full and gives it back. a refused release leaves it
# held
pub fun give_secret(from: *SecretSource, chunk: Chunk) bool {
    val reason: buffers.Reason = buffers.secret_source_release(from.provider, from.account,
        chunk);
    ret sel reason.none;
}

# a held secret chunk viewed as `count` values of T for the rest of its hold.
# nil for a stale chunk, a shape that does not fit, or a provider without
# typed views
pub fun view_secret[T](from: *SecretSource, chunk: Chunk, count: usize) *T {
    ret buffers.secret_source_view_typed[T](from.provider, chunk, count);
}

# a chunk is retained while bytes sealed from it are in flight
pub fun retain(provider: *Provider, ref: Ref) bool {
    val reason: buffers.Reason = buffers.source_retain(provider, ref);
    ret sel reason.none;
}

pub fun settle(provider: *Provider, ref: Ref) bool {
    val reason: buffers.Reason = buffers.source_settle(provider, ref);
    ret sel reason.none;
}

pub fun in_flight(provider: *Provider, ref: Ref) bool {
    ret buffers.source_in_flight(provider, ref);
}

# the handles of accounts woken since the last call, oldest first
pub fun ready(provider: *Provider, output: *u64, capacity: usize) usize {
    ret buffers.source_ready(provider, output, capacity);
}

# room for this many tls record chunks beside the BYTES chunks of a test pool
val TEST_RECORDS: usize = 4;

# a pool with room for `chunks` BYTES chunks and a few tls records over
# `memory`, for tests
# ---
# configs: CLASS_COUNT entries
pub fun test_pool(pool: *buffers.Pool, configs: *buffers.ClassConfig,
    memory: *limited.Limited, chunks: usize) bool {
    ret test_pool_lanes(pool, configs, memory, chunks, 0);
}

# as test_pool, with `extra` caller lanes
pub fun test_pool_lanes(pool: *buffers.Pool, configs: *buffers.ClassConfig,
    memory: *limited.Limited, chunks: usize, extra: usize) bool {
    classes(configs, 0);
    val bytes: usize = chunks * BYTES + TEST_RECORDS * RECORD;
    if (memory.a.ctx == nil && !limited.make(memory, (bytes + 16 * BYTES) * 2)) {
        ret false;
    }
    ret buffers.make(pool, pool_config_lanes(configs, CLASS_COUNT, bytes, extra),
        limited.allocator_of(memory));
}

# a whole test pool and its provider, which must not move once made
pub rec TestPool {
    memory:   limited.Limited;
    pool:     buffers.Pool;
    classes:  [CLASS_COUNT]buffers.ClassConfig;
    provider: Provider;
    secret:   SecretProvider;
}

pub fun make_test(fixture: *TestPool, chunks: usize) bool {
    ret make_test_lanes(fixture, chunks, 0);
}

# as make_test, with `extra` caller lanes
pub fun make_test_lanes(fixture: *TestPool, chunks: usize, extra: usize) bool {
    if (!test_pool_lanes(?fixture.pool, ?fixture.classes[0], ?fixture.memory, chunks,
        extra)) { ret false; }
    fixture.provider = buffers.source(?fixture.pool);
    fixture.secret   = buffers.secret_source(?fixture.pool);
    ret true;
}

pub fun test_made(fixture: *TestPool) bool {
    ret fixture.provider.ctx != nil;
}

# ends a test pool once every account on it is closed, keeping its memory for
# the next make
pub fun end_test(fixture: *TestPool) bool {
    if (!test_made(fixture) || !buffers.destroy(?fixture.pool)) { ret false; }
    var none:      Provider;
    var no_secret: SecretProvider;
    fixture.provider = none;
    fixture.secret   = no_secret;
    ret true;
}

# misuse a pool has refused so far
pub fun misuse(pool: *buffers.Pool) u64 {
    var view: buffers.Snapshot;
    if (!buffers.snapshot(pool, ?view)) { ret 0; }
    ret view.misuse;
}

test source__a_source_with_other_than_three_lanes_opens_no_account {
    var wide:    TestPool;
    var configs: [CLASS_COUNT]buffers.ClassConfig;
    classes(?configs[0], 0);
    if (!limited.make(?wide.memory, 1 << 20)) { ret 1; }
    var config: buffers.Config = pool_config(?configs[0], CLASS_COUNT, 64 * BYTES);
    config.lanes = 5;
    if (!buffers.make(?wide.pool, config, limited.allocator_of(?wide.memory))) { ret 2; }
    wide.provider = buffers.source(?wide.pool);
    var account: Account;
    if (buffers.source_lanes(?wide.provider) != 5 ||
        open_connection(?wide.provider, ?account, 1, 4, 4, 4096, 0, nil, 0) || account.open) {
        ret 3;
    }
    if (!buffers.destroy(?wide.pool)) { ret 4; }

    var fixture: TestPool;
    if (!make_test(?fixture, 16)) { ret 5; }
    var undeclared: Provider = fixture.provider;
    undeclared.fn_lanes = nil;
    if (open_connection(?undeclared, ?account, 2, 4, 4, 4096, 0, nil, 0) ||
        open(?undeclared, ?account, 2, 4, 4, 0) || account.open ||
        open_connection(nil, ?account, 2, 4, 4, 4096, 0, nil, 0) || account.open) {
        ret 6;
    }
    if (!open_connection(?fixture.provider, ?account, 3, 4, 4, 4096, 0, nil, 0) ||
        !account.open || account.budgets[3] != 0 || !close(?fixture.provider, ?account) ||
        !end_test(?fixture)) {
        ret 7;
    }
    ret 0;
}

# a source that claims more lanes than std allows
fun nine_lanes(ctx: ptr) usize {
    ret 9;
}

test source__caller_lanes_open_only_when_the_count_matches_exactly {
    var fixture: TestPool;
    if (!make_test_lanes(?fixture, 16, 2)) { ret 1; }
    var account: Account;
    var extra:   [6]usize = [6]usize{100, 200, 300, 400, 500, 600};
    # 3 + 2 on a 5-lane source, and the budgets land after quic's
    if (!open_connection(?fixture.provider, ?account, 1, 4, 4, 4096, 0, ?extra[0], 2) ||
        !account.open || account.budgets[3] != 100 || account.budgets[4] != 200 ||
        account.budgets[5] != 0 || !close(?fixture.provider, ?account)) { ret 2; }
    # fewer than the source declares
    if (open_connection(?fixture.provider, ?account, 2, 4, 4, 4096, 0, ?extra[0], 1) ||
        open_connection(?fixture.provider, ?account, 2, 4, 4, 4096, 0, nil, 0) ||
        account.open) { ret 3; }
    # more than the source declares
    if (open_connection(?fixture.provider, ?account, 3, 4, 4, 4096, 0, ?extra[0], 3) ||
        account.open) { ret 4; }
    # budgets and count must agree
    if (open_connection(?fixture.provider, ?account, 4, 4, 4, 4096, 0, nil, 2) ||
        open_connection(?fixture.provider, ?account, 4, 4, 4, 4096, 0, ?extra[0], 0) ||
        account.open) { ret 5; }
    if (!end_test(?fixture)) { ret 6; }
    # the widest source there is still refuses a total above MAX_LANES
    if (!make_test_lanes(?fixture, 16, MAX_EXTRA_LANES)) { ret 7; }
    if (open_connection(?fixture.provider, ?account, 5, 4, 4, 4096, 0, ?extra[0],
        MAX_EXTRA_LANES + 1) || account.open) { ret 8; }
    if (!open_connection(?fixture.provider, ?account, 6, 4, 4, 4096, 0, ?extra[0],
        MAX_EXTRA_LANES) || !account.open || account.budgets[7] != 500 ||
        !close(?fixture.provider, ?account)) { ret 9; }
    # a source claiming nine lanes would match a six-lane request, and the
    # budgets have room for eight, so the cap refuses it before any budget lands
    var liar: Provider = fixture.provider;
    liar.fn_lanes = nine_lanes;
    if (source_lanes_of(?liar) != 9 ||
        open_connection(?liar, ?account, 7, 4, 4, 4096, 0, ?extra[0], 6) ||
        account.open) { ret 10; }
    if (!end_test(?fixture)) { ret 11; }
    ret 0;
}
