# the pool chunks holding one byte sequence, such as a stream direction or a
# crypto level, kept sorted by chunk number (offset >> SHIFT)
#
# two slots live inline. more spill into one pool chunk. every chunk, the
# spill included, counts against the source's account and direction. a chunk
# that an in-flight attempt retains is never released
#
# chunks come from quic.storage.source, which is the only caller of std's
# buffer source

use quic.storage.limited;
use quic.storage.ranges;
use supply: quic.storage.source;

use std.memory;
use std.memory.buffers;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val SHIFT:          u64   = 12;
pub val INLINE:         usize = 2;
pub val SPILL_CAPACITY: usize = supply.BYTES / $size_of(Slot);
pub val RESERVE:        usize = 4;

pub rec Slot {
    number: u64;
    chunk:  supply.Chunk;
}

pub rec Chunks {
    inline: [INLINE]Slot;
    spill:  supply.Chunk;
    count:  usize;
}

# the chunks one span needs, taken before anything else changes so a refusal
# leaves the buffer as it was
pub rec Reserved {
    slots: [RESERVE]Slot;
    count: usize;
    spill: supply.Chunk;
}

# one whole chunk laid out by its holder, such as state a connection needs
# only until its handshake is confirmed
pub rec Block {
    chunk: supply.Chunk;
    data:  *u8;
}

# takes a zeroed chunk into an empty block
pub fun take_block(from: *ranges.Source, block: *Block) bool {
    if (block.data != nil) { ret false; }
    val got: supply.Taken = supply.take(from, supply.BYTES);
    if (!got.ok) { ret false; }
    memory.raw_zero(got.chunk.data, supply.BYTES);
    block.chunk = got.chunk;
    block.data  = got.chunk.data;
    ret true;
}

# wipes and gives back a held block. an empty block is left as it is
pub fun give_block(from: *ranges.Source, block: *Block) {
    if (block.data == nil) { ret; }
    memory.raw_zero(block.data, supply.BYTES);
    if (supply.give(from, block.chunk)) { block.data = nil; }
}

pub fun number_of(offset: u64) u64 {
    ret offset >> SHIFT;
}

# bytes from `offset` to the end of its chunk
pub fun room(offset: u64) u64 {
    ret supply.BYTES::u64 - offset % supply.BYTES::u64;
}

fun items(chunks: *Chunks) *Slot {
    if (chunks.spill.data != nil) { ret chunks.spill.data::*Slot; }
    ret ?chunks.inline[0];
}

# the position of the first chunk numbered at least `number`
fun locate(chunks: *Chunks, number: u64) usize {
    val list: *Slot = items(chunks);
    var low:  usize = 0;
    var high: usize = chunks.count;
    for (low < high) {
        val middle: usize = low + (high - low) / 2;
        if (list[middle].number < number) { low = middle + 1; }
        or                                { high = middle; }
    }
    ret low;
}

pub fun count(chunks: *Chunks) usize {
    ret chunks.count;
}

pub fun spilled(chunks: *Chunks) bool {
    ret chunks.spill.data != nil;
}

# the chunk numbered `number`, or nil
pub fun find(chunks: *Chunks, number: u64) *Slot {
    val at: usize = locate(chunks, number);
    if (at < chunks.count && items(chunks)[at].number == number) {
        ret ?items(chunks)[at];
    }
    ret nil;
}

# the byte at `offset`, or nil when its chunk is not held
pub fun address(chunks: *Chunks, offset: u64) *u8 {
    val slot: *Slot = find(chunks, number_of(offset));
    if (slot == nil) { ret nil; }
    ret ?slot.chunk.data[(offset % supply.BYTES::u64)::usize];
}

# places a slot in order. the caller has made room, spilling first when needed
fun insert(chunks: *Chunks, slot: Slot) *Slot {
    val at:   usize = locate(chunks, slot.number);
    val list: *Slot = items(chunks);
    if (at < chunks.count) {
        memory.move[Slot](?list[at + 1], ?list[at], chunks.count - at);
    }
    list[at]     = slot;
    chunks.count = chunks.count + 1;
    ret ?list[at];
}

# the chunk holding `offset`, taken from the pool when it is not there yet.
# nil when the pool or the list refuses, with nothing changed
pub fun ensure(chunks: *Chunks, from: *ranges.Source, offset: u64) *Slot {
    val number:   u64   = number_of(offset);
    val existing: *Slot = find(chunks, number);
    if (existing != nil)                { ret existing; }
    if (chunks.count >= SPILL_CAPACITY) { ret nil; }
    val got: supply.Taken = supply.take(from, supply.BYTES);
    if (!got.ok) { ret nil; }
    if (chunks.count >= INLINE && chunks.spill.data == nil) {
        val spilled: supply.Taken = supply.take(from, supply.BYTES);
        if (!spilled.ok) {
            supply.give(from, got.chunk);
            ret nil;
        }
        val spill: *Slot = spilled.chunk.data::*Slot;
        memory.copy[Slot](spill, ?chunks.inline[0], chunks.count);
        chunks.spill = spilled.chunk;
    }
    ret insert(chunks, Slot{number: number, chunk: got.chunk});
}

pub fun cancel(from: *ranges.Source, reserved: *Reserved) {
    var i: usize = 0;
    for (i < reserved.count) {
        supply.give(from, reserved.slots[i].chunk);
        i = i + 1;
    }
    if (reserved.spill.data != nil) {
        supply.give(from, reserved.spill);
    }
    var none: supply.Chunk;
    reserved.count = 0;
    reserved.spill = none;
}

# takes the chunks of [offset, offset + length) that `chunks` lacks, plus a
# spill if the list will outgrow its inline slots, or nothing. `chunks` is nil
# for a buffer that does not exist yet
pub fun reserve(chunks: *Chunks, from: *ranges.Source, offset: u64, length: usize,
    reserved: *Reserved) bool {
    var none: supply.Chunk;
    reserved.count = 0;
    reserved.spill = none;
    if (length == 0) { ret true; }
    val last:   u64 = number_of(offset + length::u64 - 1);
    var number: u64 = number_of(offset);
    for (number <= last) {
        if (chunks == nil || find(chunks, number) == nil) {
            if (reserved.count == RESERVE) {
                cancel(from, reserved);
                ret false;
            }
            val got: supply.Taken = supply.take(from, supply.BYTES);
            if (!got.ok) {
                cancel(from, reserved);
                ret false;
            }
            reserved.slots[reserved.count] = Slot{number: number, chunk: got.chunk};
            reserved.count                 = reserved.count + 1;
        }
        number = number + 1;
    }
    var held:    usize = 0;
    var spilled: bool  = false;
    if (chunks != nil) {
        held    = chunks.count;
        spilled = chunks.spill.data != nil;
    }
    if (held + reserved.count > SPILL_CAPACITY) {
        cancel(from, reserved);
        ret false;
    }
    if (held + reserved.count > INLINE && !spilled) {
        val got: supply.Taken = supply.take(from, supply.BYTES);
        if (!got.ok) {
            cancel(from, reserved);
            ret false;
        }
        reserved.spill = got.chunk;
    }
    ret true;
}

pub fun commit(chunks: *Chunks, reserved: *Reserved) {
    if (reserved.spill.data != nil) {
        memory.copy[Slot](reserved.spill.data::*Slot, ?chunks.inline[0], chunks.count);
        chunks.spill = reserved.spill;
    }
    var i: usize = 0;
    for (i < reserved.count) {
        insert(chunks, reserved.slots[i]);
        i = i + 1;
    }
    var none: supply.Chunk;
    reserved.count = 0;
    reserved.spill = none;
}

# takes every chunk [offset, offset + length) lacks, or none
pub fun ensure_span(chunks: *Chunks, from: *ranges.Source, offset: u64,
    length: usize) bool {
    var reserved: Reserved;
    if (!reserve(chunks, from, offset, length, ?reserved)) { ret false; }
    commit(chunks, ?reserved);
    ret true;
}

# copies bytes into chunks that already exist
pub fun write(chunks: *Chunks, offset: u64, input: *u8, length: usize) {
    var done: usize = 0;
    for (done < length) {
        val at:    u64   = offset + done::u64;
        val slot:  *Slot = find(chunks, number_of(at));
        val start: usize = (at % supply.BYTES::u64)::usize;
        var span:  usize = supply.BYTES - start;
        if (span > length - done) { span = length - done; }
        memory.copy[u8](?slot.chunk.data[start], ?input[done], span);
        done = done + span;
    }
}

# copies bytes out of chunks that exist
pub fun read(chunks: *Chunks, offset: u64, output: *u8, length: usize) {
    var done: usize = 0;
    for (done < length) {
        val at:    u64   = offset + done::u64;
        val slot:  *Slot = find(chunks, number_of(at));
        val start: usize = (at % supply.BYTES::u64)::usize;
        var span:  usize = supply.BYTES - start;
        if (span > length - done) { span = length - done; }
        memory.copy[u8](?output[done], ?slot.chunk.data[start], span);
        done = done + span;
    }
}

# whether any input byte differs from a byte `present` says is already held
pub fun conflicts(chunks: *Chunks, present: *ranges.RangeSet, offset: u64,
    input: *u8, length: usize) bool {
    val end:   u64   = offset + length::u64;
    var index: usize = ranges.index_after(present, offset);
    for (index < ranges.count(present)) {
        val held: ranges.Interval = ranges.at(present, index);
        if (held.start >= end) { brk; }
        var at: u64 = held.start;
        if (at < offset) { at = offset; }
        var stop: u64 = held.end;
        if (stop > end) { stop = end; }
        for (at < stop) {
            val slot:  *Slot = find(chunks, number_of(at));
            val start: usize = (at % supply.BYTES::u64)::usize;
            var span:  u64   = (supply.BYTES - start)::u64;
            if (span > stop - at) { span = stop - at; }
            if (!memory.equal[u8](?slot.chunk.data[start], ?input[(at - offset)::usize],
                span::usize)) {
                ret true;
            }
            at = at + span;
        }
        index = index + 1;
    }
    ret false;
}

# gives the spill back once the list fits inline again
fun shrink(chunks: *Chunks, from: *ranges.Source) {
    if (chunks.spill.data == nil || chunks.count > INLINE) { ret; }
    val spill: *Slot = chunks.spill.data::*Slot;
    memory.copy[Slot](?chunks.inline[0], spill, chunks.count);
    if (supply.give(from, chunks.spill)) {
        var none: supply.Chunk;
        chunks.spill = none;
    }
}

# releases, in order, the chunks that lie wholly below `limit` and that nothing
# retains, stopping at the first that is still retained
pub fun release_below(chunks: *Chunks, from: *ranges.Source, limit: u64) {
    val list:     *Slot = items(chunks);
    var released: usize = 0;
    for (released < chunks.count) {
        val slot: Slot = list[released];
        if ((slot.number + 1) << SHIFT > limit ||
            supply.in_flight(from.provider, slot.chunk.ref)) { brk; }
        if (!supply.give(from, slot.chunk)) { brk; }
        released = released + 1;
    }
    if (released > 0) {
        memory.move[Slot](?list[0], ?list[released], chunks.count - released);
        chunks.count = chunks.count - released;
    }
    shrink(chunks, from);
}

# releases the chunks numbered at least `number`, none of which may be retained
pub fun release_from(chunks: *Chunks, from: *ranges.Source, number: u64) {
    val list: *Slot = items(chunks);
    for (chunks.count > 0 && list[chunks.count - 1].number >= number) {
        if (!supply.give(from, list[chunks.count - 1].chunk)) { brk; }
        chunks.count = chunks.count - 1;
    }
    shrink(chunks, from);
}

# releases what lies below a consumed prefix. once nothing past the prefix is
# held, the partly used chunk at its end goes too, since later bytes take a
# fresh chunk at their own number
pub fun release_consumed(chunks: *Chunks, from: *ranges.Source, prefix: u64,
    drained: bool) {
    if (drained) { release_all(chunks, from); }
    or           { release_below(chunks, from, prefix); }
}

# releases every chunk nothing retains. a retained chunk stays until settled
pub fun release_all(chunks: *Chunks, from: *ranges.Source) {
    release_below(chunks, from, 0 - 1::u64);
}

rec Fixture {
    backing:  limited.Limited;
    pool:     buffers.Pool;
    class:    buffers.ClassConfig;
    provider: supply.Provider;
    account:  supply.Account;
}

fun test_pool(fixture: *Fixture) bool {
    if (!supply.test_pool(?fixture.pool, ?fixture.class, ?fixture.backing, 16)) { ret false; }
    fixture.provider = buffers.source(?fixture.pool);
    ret supply.open(?fixture.provider, ?fixture.account, 1, 5, 5, 0);
}

test chunks__bytes_round_trip_across_chunks_and_the_spill_is_given_back {
    var fixture: Fixture;
    if (!test_pool(?fixture)) { ret 1; }
    var from: ranges.Source = ranges.Source{provider: ?fixture.provider,
        account: ?fixture.account, lane: supply.SEND};
    var held:   Chunks;
    var input:  [9000]u8;
    var output: [9000]u8;
    var i:      usize = 0;
    for (i < 9000) {
        input[i] = (i % 251)::u8;
        i        = i + 1;
    }
    if (!ensure_span(?held, ?from, 100, 9000)) { ret 2; }
    # three data chunks outgrow the inline slots, so a spill is held too
    if (count(?held) != 3 || !spilled(?held) || supply.held(?fixture.account, supply.SEND) != 4) { ret 3; }
    write(?held, 100, ?input[0], 9000);
    read(?held, 100, ?output[0], 9000);
    if (!memory.equal[u8](?input[0], ?output[0], 9000)) { ret 4; }
    release_below(?held, ?from, 8192);
    if (count(?held) != 1 || spilled(?held) || supply.held(?fixture.account, supply.SEND) != 1) { ret 5; }
    if (address(?held, 8192)[0] != input[8092])                                                 { ret 6; }
    release_all(?held, ?from);
    if (count(?held) != 0 || supply.held(?fixture.account, supply.SEND) != 0) { ret 7; }
    ret 0;
}

test chunks__a_refused_span_takes_nothing_and_retained_chunks_stay {
    var fixture: Fixture;
    if (!test_pool(?fixture)) { ret 1; }
    var from: ranges.Source = ranges.Source{provider: ?fixture.provider,
        account: ?fixture.account, lane: supply.RECEIVE};
    var held: Chunks;
    if (!ensure_span(?held, ?from, 0, 4096)) { ret 2; }
    # four more chunks plus a spill exceed the budget of five
    if (ensure_span(?held, ?from, 4096, 4 * 4096))                                                 { ret 3; }
    if (count(?held) != 1 || spilled(?held) || supply.held(?fixture.account, supply.RECEIVE) != 1) { ret 4; }
    val slot: *Slot = find(?held, 0);
    if (!supply.retain(?fixture.provider, slot.chunk.ref)) { ret 5; }
    release_all(?held, ?from);
    if (count(?held) != 1) { ret 6; }
    supply.settle(?fixture.provider, find(?held, 0).chunk.ref);
    release_all(?held, ?from);
    if (count(?held) != 0 || supply.held(?fixture.account, supply.RECEIVE) != 0) { ret 7; }
    if (!ensure_span(?held, ?from, 0, 3 * 4096))                                 { ret 8; }
    release_from(?held, ?from, 1);
    if (count(?held) != 1 || spilled(?held) || supply.held(?fixture.account, supply.RECEIVE) != 1) { ret 9; }
    ret 0;
}
