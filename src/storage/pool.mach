# a per-pump pool of pinned, fixed-size chunks with per-account budgets
#
# one pool serves the connections one thread drives, so it takes no lock. its
# owner check is thread affinity: the thread that made the pool is the only one
# that may open or close accounts, and debug builds check every call. each
# chunk is its own allocation, so it never moves, and the pool keeps up to
# `high_water` released chunks for reuse before handing memory back.
#
# an account is the pool's view of one connection. it lives in the connection,
# is linked into the pool's wait and ready lists by address, and must not move
# while it is open. its budget bounds what it may hold. its reservation is taken
# from the pool's global budget when it opens, so those chunks are always there.
# anything beyond the reservation competes for the unreserved rest, and a
# refusal there registers the account to be woken when a chunk comes back

use quic.storage.limited;
use quic.storage.slots;

use std.allocator;
use std.sync.thread;
use std.system.os;
use std.system.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

pub val CHUNK: usize = 4096;

val CHUNK_ALIGN: usize = 16;

pub def Direction: u8;
pub val SEND:    Direction = 0;
pub val RECEIVE: Direction = 1;

pub def Status: u8;
pub val STATUS_OK:      Status = 1;
pub val STATUS_BLOCKED: Status = 2;
pub val STATUS_ERROR:   Status = 3;

pub def Error: u8;
pub val ERROR_NONE:      Error = 0;
pub val ERROR_STATE:     Error = 1;
pub val ERROR_THREAD:    Error = 2;
pub val ERROR_TOKEN:     Error = 3;
pub val ERROR_INFLIGHT:  Error = 4;
pub val ERROR_BUDGET:    Error = 5;
pub val ERROR_EXHAUSTED: Error = 6;
pub val ERROR_MEMORY:    Error = 7;

# pool policy
# ---
# max_chunks:     global budget, the most chunks all accounts may hold at once
# high_water:     released chunks kept for reuse rather than freed
# notify:         called when an account becomes ready, nil for none
# notify_context: passed to notify
# trap_misuse:    abort on a misuse in debug builds as well as reporting it
pub rec Config {
    max_chunks:     usize;
    high_water:     usize;
    notify:         fun(ptr);
    notify_context: ptr;
    trap_misuse:    bool;
}

pub rec Account {
    pool:      *Pool;
    handle:    u64;
    budget:    [2]usize;
    used:      [2]usize;
    reserved:  usize;
    wait_next: *Account;
    wait_prev: *Account;
    waiting:   bool;
    ready:     bool;
    open:      bool;
}

pub rec Ref {
    index:      usize;
    generation: u64;
}

pub rec Acquired {
    status: Status;
    error:  Error;
    ref:    Ref;
    data:   *u8;
}

pub rec Snapshot {
    live:            usize;
    retained:        usize;
    peak:            usize;
    reserved:        usize;
    overflow:        usize;
    accounts:        usize;
    acquisitions:    u64;
    refusals:        u64;
    budget_refusals: u64;
    releases:        u64;
    misuse:          u64;
    ready_count:     u64;
}

rec Meta {
    data:       *u8;
    account:    *Account;
    generation: u64;
    inflight:   u32;
    live:       bool;
}

pub rec Pool {
    backing:         allocator.Allocator;
    config:          Config;
    meta:            slots.Slots[Meta];
    thread:          i64;
    live:            usize;
    retained:        usize;
    peak:            usize;
    reserved:        usize;
    overflow:        usize;
    accounts:        usize;
    wait_head:       *Account;
    wait_tail:       *Account;
    ready_head:      *Account;
    ready_tail:      *Account;
    ready_count:     u64;
    acquisitions:    u64;
    refusals:        u64;
    budget_refusals: u64;
    releases:        u64;
    misuse:          u64;
    valid:           bool;
}

pub fun default_config(max_chunks: usize) Config {
    var config: Config;
    config.max_chunks     = max_chunks;
    config.high_water     = 0;
    config.notify         = nil;
    config.notify_context = nil;
    config.trap_misuse    = true;
    ret config;
}

fun next_generation(value: u64) u64 {
    if (value == 0 - 1::u64) { ret 1; }
    ret value + 1;
}

# a misuse is a caller bug: it is always counted and reported, and a debug
# build stops on it unless the pool was made to observe misuse in tests
fun misuse(pool: *Pool, message: *u8) {
    pool.misuse = pool.misuse + 1;
    $if ($mach.build.mode == $mach.mode.debug) {
        if (pool.config.trap_misuse) { panic.panic(message); }
    }
}

fun misused(pool: *Pool, code: Error, message: *u8) Acquired {
    misuse(pool, message);
    var result: Acquired;
    result.status = STATUS_ERROR;
    result.error  = code;
    ret result;
}

fun usable(pool: *Pool) bool {
    ret pool != nil && pool.valid;
}

# the owning thread is checked on every call in debug builds, and always when an
# account opens or closes, since a system call per chunk is too dear otherwise
fun on_owner_thread(pool: *Pool) bool {
    $if ($mach.build.mode == $mach.mode.debug) {
        ret os.thread_current_id() == pool.thread;
    }
    $or {
        ret true;
    }
}

fun overflow_of(account: *Account, total: usize) usize {
    if (total <= account.reserved) { ret 0; }
    ret total - account.reserved;
}

fun held(account: *Account) usize {
    ret account.used[0] + account.used[1];
}

# the pool keeps a copy of the backing allocator, whose context must outlive it
pub fun make(pool: *Pool, backing: *allocator.Allocator, config: Config) bool {
    if (pool == nil || backing == nil || config.max_chunks == 0) { ret false; }
    var fresh: Pool;
    fresh.backing = @backing;
    fresh.config  = config;
    fresh.meta    = slots.empty[Meta]();
    fresh.thread  = os.thread_current_id();
    fresh.valid   = true;
    @pool         = fresh;
    ret true;
}

# opens an account for one connection and takes its reservation
# ---
# account: the connection's account record, which must not move while open
# handle:  what `ready` reports for this account
# send:    most send chunks the account may hold
# receive: most receive chunks the account may hold
# reserve: chunks set aside for the account alone, at most send + receive
# ret:     whether the account opened. a refusal reserves nothing
pub fun open_account(pool: *Pool, account: *Account, handle: u64,
    send: usize, receive: usize, reserve: usize) bool {
    if (!usable(pool) || account == nil || account.open) { ret false; }
    if (os.thread_current_id() != pool.thread) {
        misuse(pool, "quic pool: account opened off the owning thread");
        ret false;
    }
    if (send > (0 - 1::usize) - receive || reserve > send + receive ||
        reserve > pool.config.max_chunks - pool.reserved) { ret false; }
    var fresh: Account;
    fresh.pool      = pool;
    fresh.handle    = handle;
    fresh.budget[0] = send;
    fresh.budget[1] = receive;
    fresh.reserved  = reserve;
    fresh.open      = true;
    @account        = fresh;
    pool.reserved   = pool.reserved + reserve;
    pool.accounts   = pool.accounts + 1;
    ret true;
}

# the wait and ready lists are doubly linked, so leaving either is O(1)
fun unlink(head: **Account, tail: **Account, account: *Account) {
    if (account.wait_prev == nil) { @head = account.wait_next; }
    or                            { account.wait_prev.wait_next = account.wait_next; }
    if (account.wait_next == nil) { @tail = account.wait_prev; }
    or                            { account.wait_next.wait_prev = account.wait_prev; }
    account.wait_next = nil;
    account.wait_prev = nil;
}

fun append(head: **Account, tail: **Account, account: *Account) {
    account.wait_next = nil;
    account.wait_prev = @tail;
    if (@tail == nil) { @head = account; }
    or                { (@tail).wait_next = account; }
    @tail = account;
}

# closes an account that holds nothing and returns its reservation
pub fun close_account(pool: *Pool, account: *Account) bool {
    if (!usable(pool) || account == nil || !account.open || account.pool != pool) {
        ret false;
    }
    if (os.thread_current_id() != pool.thread) {
        misuse(pool, "quic pool: account closed off the owning thread");
        ret false;
    }
    if (held(account) != 0) {
        misuse(pool, "quic pool: account closed while holding chunks");
        ret false;
    }
    if (account.waiting) {
        unlink(?pool.wait_head, ?pool.wait_tail, account);
        account.waiting = false;
    }
    if (account.ready) {
        unlink(?pool.ready_head, ?pool.ready_tail, account);
        account.ready = false;
    }
    pool.reserved = pool.reserved - account.reserved;
    pool.accounts = pool.accounts - 1;
    account.open  = false;
    account.pool  = nil;
    ret true;
}

fun register_waiter(pool: *Pool, account: *Account) {
    if (account.waiting || account.ready) { ret; }
    append(?pool.wait_head, ?pool.wait_tail, account);
    account.waiting = true;
}

# moves the oldest waiter to the ready list and tells the owner
fun wake_one(pool: *Pool) {
    val account: *Account = pool.wait_head;
    if (account == nil) { ret; }
    unlink(?pool.wait_head, ?pool.wait_tail, account);
    account.waiting = false;
    append(?pool.ready_head, ?pool.ready_tail, account);
    account.ready    = true;
    pool.ready_count = pool.ready_count + 1;
    if (pool.config.notify != nil) {
        pool.config.notify(pool.config.notify_context);
    }
}

fun blocked(code: Error) Acquired {
    var result: Acquired;
    result.status = STATUS_BLOCKED;
    result.error  = code;
    ret result;
}

# takes one chunk for the account
#
# a refusal of the account's own budget is its own backpressure and registers
# nothing, since only its own releases can end it. a refusal of the shared
# budget, or of the backend, registers the account to be woken
pub fun acquire(pool: *Pool, account: *Account, direction: Direction) Acquired {
    if (!usable(pool)) {
        var refused: Acquired;
        refused.status = STATUS_ERROR;
        refused.error  = ERROR_STATE;
        ret refused;
    }
    if (!on_owner_thread(pool)) {
        ret misused(pool, ERROR_THREAD, "quic pool: chunk taken off the owning thread");
    }
    if (account == nil || !account.open || account.pool != pool || direction > RECEIVE) {
        ret misused(pool, ERROR_STATE, "quic pool: chunk taken for a foreign account");
    }
    val d: usize = direction::usize;
    if (account.used[d] >= account.budget[d]) {
        pool.budget_refusals = pool.budget_refusals + 1;
        ret blocked(ERROR_BUDGET);
    }
    val total:  usize = held(account);
    val growth: usize = overflow_of(account, total + 1) - overflow_of(account, total);
    if (growth > 0 && pool.overflow >= pool.config.max_chunks - pool.reserved) {
        pool.refusals = pool.refusals + 1;
        register_waiter(pool, account);
        ret blocked(ERROR_EXHAUSTED);
    }
    if (!slots.reserve[Meta](?pool.meta, ?pool.backing, 1)) {
        pool.refusals = pool.refusals + 1;
        register_waiter(pool, account);
        ret blocked(ERROR_MEMORY);
    }
    val index: usize = slots.claim[Meta](?pool.meta);
    val cell:  *Meta = slots.at[Meta](?pool.meta, index);
    if (cell.data == nil) {
        val got: res[ptr, allocator.Error] = allocator.allocate_raw(?pool.backing,
            CHUNK, CHUNK_ALIGN);
        if (sel got.err) {
            slots.release[Meta](?pool.meta, index);
            pool.refusals = pool.refusals + 1;
            register_waiter(pool, account);
            ret blocked(ERROR_MEMORY);
        }
        cell.data = got.ok::*u8;
    }
    or {
        pool.retained = pool.retained - 1;
    }
    cell.account    = account;
    cell.generation = next_generation(cell.generation);
    cell.inflight   = 0;
    cell.live       = true;
    account.used[d] = account.used[d] + 1;
    pool.overflow   = pool.overflow + growth;
    pool.live       = pool.live + 1;
    if (pool.live > pool.peak) { pool.peak = pool.live; }
    pool.acquisitions = pool.acquisitions + 1;
    var result: Acquired;
    result.status = STATUS_OK;
    result.ref    = Ref{index: index, generation: cell.generation};
    result.data   = cell.data;
    ret result;
}

fun live_cell(pool: *Pool, ref: Ref) *Meta {
    val cell: *Meta = slots.at[Meta](?pool.meta, ref.index);
    if (cell == nil || !cell.live || cell.generation != ref.generation) { ret nil; }
    ret cell;
}

# the chunk's bytes, or nil once the reference is stale
pub fun data(pool: *Pool, ref: Ref) *u8 {
    if (!usable(pool)) { ret nil; }
    val cell: *Meta = live_cell(pool, ref);
    if (cell == nil) { ret nil; }
    ret cell.data;
}

# an attempt sealed from the chunk, so it may not be released until settled
pub fun retain(pool: *Pool, ref: Ref) bool {
    if (!usable(pool)) { ret false; }
    val cell: *Meta = live_cell(pool, ref);
    if (cell == nil || cell.inflight == 0 - 1::u32) {
        misuse(pool, "quic pool: retain of a stale chunk");
        ret false;
    }
    cell.inflight = cell.inflight + 1;
    ret true;
}

# a stale reference settles nothing, since its chunk may already hold other data
pub fun settle(pool: *Pool, ref: Ref) bool {
    if (!usable(pool)) { ret false; }
    val cell: *Meta = live_cell(pool, ref);
    if (cell == nil) { ret false; }
    if (cell.inflight == 0) {
        misuse(pool, "quic pool: settle without a retain");
        ret false;
    }
    cell.inflight = cell.inflight - 1;
    ret true;
}

# returns a chunk the account holds and nothing references in flight
pub fun release(pool: *Pool, account: *Account, direction: Direction, ref: Ref) Error {
    if (!usable(pool)) { ret ERROR_STATE; }
    if (!on_owner_thread(pool)) {
        misuse(pool, "quic pool: chunk released off the owning thread");
        ret ERROR_THREAD;
    }
    val cell: *Meta = live_cell(pool, ref);
    if (cell == nil || account == nil || cell.account != account ||
        direction > RECEIVE || account.used[direction::usize] == 0) {
        misuse(pool, "quic pool: release of a chunk the account does not hold");
        ret ERROR_TOKEN;
    }
    if (cell.inflight != 0) {
        misuse(pool, "quic pool: release of a chunk still in flight");
        ret ERROR_INFLIGHT;
    }
    val total:  usize = held(account);
    val shrink: usize = overflow_of(account, total) - overflow_of(account, total - 1);
    account.used[direction::usize] = account.used[direction::usize] - 1;
    pool.overflow                  = pool.overflow - shrink;
    pool.live                      = pool.live - 1;
    cell.live                      = false;
    cell.account                   = nil;
    cell.inflight                  = 0;
    if (pool.retained < pool.config.high_water) {
        pool.retained = pool.retained + 1;
    }
    or {
        allocator.deallocate_raw(?pool.backing, cell.data::ptr, CHUNK, CHUNK_ALIGN);
        cell.data = nil;
    }
    slots.release[Meta](?pool.meta, ref.index);
    pool.releases = pool.releases + 1;
    wake_one(pool);
    ret ERROR_NONE;
}

# hands the owner the accounts woken since the last call, oldest first
pub fun ready(pool: *Pool, output: *u64, capacity: usize) usize {
    if (!usable(pool) || output == nil) { ret 0; }
    var count: usize = 0;
    for (count < capacity && pool.ready_head != nil) {
        val account: *Account = pool.ready_head;
        unlink(?pool.ready_head, ?pool.ready_tail, account);
        account.ready = false;
        output[count] = account.handle;
        count         = count + 1;
    }
    ret count;
}

pub fun snapshot(pool: *Pool) Snapshot {
    var value: Snapshot;
    if (!usable(pool)) { ret value; }
    value.live            = pool.live;
    value.retained        = pool.retained;
    value.peak            = pool.peak;
    value.reserved        = pool.reserved;
    value.overflow        = pool.overflow;
    value.accounts        = pool.accounts;
    value.acquisitions    = pool.acquisitions;
    value.refusals        = pool.refusals;
    value.budget_refusals = pool.budget_refusals;
    value.releases        = pool.releases;
    value.misuse          = pool.misuse;
    value.ready_count     = pool.ready_count;
    ret value;
}

# frees a pool with no open accounts and no live chunks. a refusal keeps it
pub fun destroy(pool: *Pool) bool {
    if (!usable(pool) || pool.accounts != 0 || pool.live != 0) { ret false; }
    var i: usize = 0;
    for (i < pool.meta.capacity) {
        val cell: *Meta = slots.at[Meta](?pool.meta, i);
        if (cell.data != nil) {
            val freed: err[allocator.Error] = allocator.deallocate_raw(?pool.backing,
                cell.data::ptr, CHUNK, CHUNK_ALIGN);
            if (sel freed.err) { ret false; }
            cell.data = nil;
        }
        i = i + 1;
    }
    if (!slots.destroy[Meta](?pool.meta, ?pool.backing)) { ret false; }
    pool.retained = 0;
    pool.valid    = false;
    ret true;
}

var notified: usize;

fun count_notify(context: ptr) {
    notified = notified + 1;
}

fun observing(max_chunks: usize, high_water: usize) Config {
    var config: Config = default_config(max_chunks);
    config.high_water     = high_water;
    config.notify         = count_notify;
    config.notify_context = nil;
    config.trap_misuse    = false;
    ret config;
}

test "quic.storage.pool: budgets, reservations and the shared remainder are enforced" {
    var memory: limited.Limited;
    if (!limited.make(?memory, 1 << 20)) { ret 1; }
    var pool: Pool;
    if (!make(?pool, limited.allocator_of(?memory), observing(4, 0))) { ret 2; }
    var a: Account;
    var b: Account;
    # a keeps two chunks for itself and b one, so one chunk is left to share
    if (!open_account(?pool, ?a, 11, 3, 1, 2) || !open_account(?pool, ?b, 22, 2, 2, 1)) {
        ret 3;
    }
    var c: Account;
    if (open_account(?pool, ?c, 33, 4, 4, 2) || pool.reserved != 3) { ret 4; }
    val a1: Acquired = acquire(?pool, ?a, SEND);
    val a2: Acquired = acquire(?pool, ?a, SEND);
    val a3: Acquired = acquire(?pool, ?a, SEND);
    if (a1.status != STATUS_OK || a2.status != STATUS_OK || a3.status != STATUS_OK ||
        pool.overflow != 1) { ret 5; }
    # a's own budget refuses a fourth send chunk and registers nothing
    val a4: Acquired = acquire(?pool, ?a, SEND);
    if (a4.status != STATUS_BLOCKED || a4.error != ERROR_BUDGET || a.waiting) { ret 6; }
    # b's reserved chunk is always there, the shared one is gone
    val b1: Acquired = acquire(?pool, ?b, RECEIVE);
    val b2: Acquired = acquire(?pool, ?b, RECEIVE);
    if (b1.status != STATUS_OK || b2.status != STATUS_BLOCKED ||
        b2.error != ERROR_EXHAUSTED || !b.waiting) { ret 7; }
    var woken: [4]u64;
    if (ready(?pool, ?woken[0], 4) != 0 || notified != 0) { ret 8; }
    # a gives one back, and b alone is woken
    if (release(?pool, ?a, SEND, a1.ref) != ERROR_NONE) { ret 9; }
    if (notified != 1 || b.waiting || !b.ready ||
        ready(?pool, ?woken[0], 4) != 1 || woken[0] != 22 || b.ready) { ret 10; }
    val retried: Acquired = acquire(?pool, ?b, RECEIVE);
    if (retried.status != STATUS_OK || pool.live != 4) { ret 11; }
    if (release(?pool, ?a, SEND, a2.ref) != ERROR_NONE ||
        release(?pool, ?a, SEND, a3.ref) != ERROR_NONE ||
        release(?pool, ?b, RECEIVE, b1.ref) != ERROR_NONE ||
        release(?pool, ?b, RECEIVE, retried.ref) != ERROR_NONE ||
        pool.overflow != 0 || pool.live != 0) { ret 12; }
    if (!close_account(?pool, ?a) || !close_account(?pool, ?b) || pool.reserved != 0 ||
        !destroy(?pool) || !limited.clean(?memory)) { ret 13; }
    limited.dnit(?memory);
    ret 0;
}

test "quic.storage.pool: a chunk in flight cannot be released and a stale reference reaches nothing" {
    var memory: limited.Limited;
    if (!limited.make(?memory, 1 << 20)) { ret 1; }
    var pool: Pool;
    if (!make(?pool, limited.allocator_of(?memory), observing(2, 1))) { ret 2; }
    var a: Account;
    if (!open_account(?pool, ?a, 1, 2, 2, 1)) { ret 3; }
    val first: Acquired = acquire(?pool, ?a, SEND);
    if (first.status != STATUS_OK || !retain(?pool, first.ref)) { ret 4; }
    first.data[0] = 0xAA;
    if (release(?pool, ?a, SEND, first.ref) != ERROR_INFLIGHT ||
        pool.misuse != 1 || pool.live != 1) { ret 5; }
    if (!settle(?pool, first.ref) || release(?pool, ?a, SEND, first.ref) != ERROR_NONE) {
        ret 6;
    }
    # the kept chunk is handed out again under a new generation
    val second: Acquired = acquire(?pool, ?a, SEND);
    if (second.status != STATUS_OK || second.ref.index != first.ref.index ||
        second.ref.generation == first.ref.generation || second.data != first.data ||
        pool.retained != 0) { ret 7; }
    # the old reference settles, reads and releases nothing of the new owner's
    if (data(?pool, first.ref) != nil || settle(?pool, first.ref) ||
        retain(?pool, first.ref) ||
        release(?pool, ?a, SEND, first.ref) != ERROR_TOKEN ||
        data(?pool, second.ref) != second.data) { ret 8; }
    # a direction the account holds nothing in is refused
    if (release(?pool, ?a, RECEIVE, second.ref) != ERROR_TOKEN) { ret 9; }
    if (close_account(?pool, ?a) || release(?pool, ?a, SEND, second.ref) != ERROR_NONE ||
        !close_account(?pool, ?a) || !destroy(?pool) || !limited.clean(?memory)) { ret 10; }
    limited.dnit(?memory);
    ret 0;
}

test "quic.storage.pool: released chunks above the high-water mark go back to the allocator" {
    var memory: limited.Limited;
    if (!limited.make(?memory, 1 << 20)) { ret 1; }
    var pool: Pool;
    if (!make(?pool, limited.allocator_of(?memory), observing(8, 2))) { ret 2; }
    var a: Account;
    if (!open_account(?pool, ?a, 1, 8, 0, 0)) { ret 3; }
    var refs: [5]Ref;
    var i:    usize = 0;
    for (i < 5) {
        val got: Acquired = acquire(?pool, ?a, SEND);
        if (got.status != STATUS_OK) { ret 4; }
        refs[i] = got.ref;
        i       = i + 1;
    }
    val holding: usize = memory.live_bytes;
    i = 0;
    for (i < 5) {
        if (release(?pool, ?a, SEND, refs[i]) != ERROR_NONE) { ret 5; }
        i = i + 1;
    }
    if (pool.retained != 2 || holding - memory.live_bytes != 3 * CHUNK)          { ret 6; }
    if (!close_account(?pool, ?a) || !destroy(?pool) || !limited.clean(?memory)) { ret 7; }
    limited.dnit(?memory);
    ret 0;
}

test "quic.storage.pool: a refused backend registers the account and a later release wakes it" {
    var memory: limited.Limited;
    # room for the directory and exactly one chunk
    if (!limited.make(?memory, CHUNK + 4096)) { ret 1; }
    var pool: Pool;
    if (!make(?pool, limited.allocator_of(?memory), observing(8, 0))) { ret 2; }
    var a: Account;
    var b: Account;
    if (!open_account(?pool, ?a, 5, 4, 4, 0) || !open_account(?pool, ?b, 6, 4, 4, 0)) {
        ret 3;
    }
    val held_by_a: Acquired = acquire(?pool, ?a, RECEIVE);
    val refused:   Acquired = acquire(?pool, ?b, RECEIVE);
    if (held_by_a.status != STATUS_OK || refused.status != STATUS_BLOCKED ||
        refused.error != ERROR_MEMORY || !b.waiting) { ret 4; }
    val before: usize = notified;
    if (release(?pool, ?a, RECEIVE, held_by_a.ref) != ERROR_NONE ||
        notified != before + 1) { ret 5; }
    var woken: [2]u64;
    if (ready(?pool, ?woken[0], 2) != 1 || woken[0] != 6) { ret 6; }
    val retried: Acquired = acquire(?pool, ?b, RECEIVE);
    if (retried.status != STATUS_OK ||
        release(?pool, ?b, RECEIVE, retried.ref) != ERROR_NONE) { ret 7; }
    # closing a registered account takes it off the lists
    val first:  Acquired = acquire(?pool, ?a, SEND);
    val second: Acquired = acquire(?pool, ?b, SEND);
    if (first.status != STATUS_OK || second.status != STATUS_BLOCKED || !b.waiting ||
        !close_account(?pool, ?b) || pool.wait_head != nil) { ret 8; }
    if (release(?pool, ?a, SEND, first.ref) != ERROR_NONE ||
        ready(?pool, ?woken[0], 2) != 0) { ret 9; }
    if (!close_account(?pool, ?a) || !destroy(?pool) || !limited.clean(?memory)) { ret 10; }
    limited.dnit(?memory);
    ret 0;
}

rec Intruder {
    pool:    *Pool;
    account: *Account;
    opened:  bool;
    closed:  bool;
}

fun intrude(arg: *u8) {
    val intruder: *Intruder = arg::*Intruder;
    var foreign:  Account;
    intruder.opened = open_account(intruder.pool, ?foreign, 9, 1, 1, 0);
    intruder.closed = close_account(intruder.pool, intruder.account);
}

test "quic.storage.pool: another thread cannot open or close accounts" {
    var memory: limited.Limited;
    if (!limited.make(?memory, 1 << 20)) { ret 1; }
    var pool: Pool;
    if (!make(?pool, limited.allocator_of(?memory), observing(4, 0))) { ret 2; }
    var owned: Account;
    if (!open_account(?pool, ?owned, 1, 1, 1, 1)) { ret 3; }
    var intruder: Intruder = Intruder{pool: ?pool, account: ?owned, opened: true, closed: true};
    var worker:   thread.Thread;
    thread.spawn_with(intrude, (?intruder)::*u8, ?worker);
    if (worker.tid < 0) { ret 4; }
    thread.join(?worker);
    if (intruder.opened || intruder.closed || pool.accounts != 1 ||
        pool.misuse != 2 || !owned.open) { ret 5; }
    if (!close_account(?pool, ?owned) || !destroy(?pool) || !limited.clean(?memory)) { ret 6; }
    limited.dnit(?memory);
    ret 0;
}
