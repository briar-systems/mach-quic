# keyed siphash-2-4 for tables whose keys a peer can choose

use std.crypto.rand;
use io_error: std.io.error;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;

pub rec Key {
    k0: u64;
    k1: u64;
}

rec State {
    v0: u64;
    v1: u64;
    v2: u64;
    v3: u64;
}

# draws a key from the operating system entropy source
pub fun random_key() opt[Key] {
    var key:    Key;
    val filled: err[io_error.Error] = rand.fill((?key)::*u8, $size_of(Key));
    if (sel filled.err) { ret opt[Key].none{}; }
    ret opt[Key].some{key};
}

fun rotate(value: u64, bits: u64) u64 {
    ret (value << bits) | (value >> (64 - bits));
}

fun round(state: *State) {
    state.v0 = state.v0 + state.v1;
    state.v1 = rotate(state.v1, 13);
    state.v1 = state.v1 ^ state.v0;
    state.v0 = rotate(state.v0, 32);
    state.v2 = state.v2 + state.v3;
    state.v3 = rotate(state.v3, 16);
    state.v3 = state.v3 ^ state.v2;
    state.v0 = state.v0 + state.v3;
    state.v3 = rotate(state.v3, 21);
    state.v3 = state.v3 ^ state.v0;
    state.v2 = state.v2 + state.v1;
    state.v1 = rotate(state.v1, 17);
    state.v1 = state.v1 ^ state.v2;
    state.v2 = rotate(state.v2, 32);
}

fun read_little(data: *u8, offset: usize, count: usize) u64 {
    var value: u64   = 0;
    var i:     usize = 0;
    for (i < count) {
        value = value | (data[offset + i]::u64 << (8 * i)::u64);
        i     = i + 1;
    }
    ret value;
}

fun absorb(state: *State, block: u64) {
    state.v3 = state.v3 ^ block;
    round(state);
    round(state);
    state.v0 = state.v0 ^ block;
}

pub fun bytes(key: Key, data: *u8, length: usize) u64 {
    var state: State;
    state.v0 = key.k0 ^ 0x736f6d6570736575;
    state.v1 = key.k1 ^ 0x646f72616e646f6d;
    state.v2 = key.k0 ^ 0x6c7967656e657261;
    state.v3 = key.k1 ^ 0x7465646279746573;
    val whole: usize = length - length % 8;
    var i:     usize = 0;
    for (i < whole) {
        absorb(?state, read_little(data, i, 8));
        i = i + 8;
    }
    absorb(?state, ((length::u64 & 0xff) << 56) |
        read_little(data, whole, length - whole));
    state.v2 = state.v2 ^ 0xff;
    round(?state);
    round(?state);
    round(?state);
    round(?state);
    ret state.v0 ^ state.v1 ^ state.v2 ^ state.v3;
}

test "quic.storage.hash: siphash-2-4 matches the reference vectors" {
    val key:     Key   = Key{k0: 0x0706050403020100, k1: 0x0f0e0d0c0b0a0908};
    var message: [15]u8;
    var i:       usize = 0;
    for (i < 15) {
        message[i] = i::u8;
        i          = i + 1;
    }
    if (bytes(key, ?message[0], 0) != 0x726fdb47dd0e0e31 ||
        bytes(key, ?message[0], 1) != 0x74f839c593dc67fd ||
        bytes(key, ?message[0], 15) != 0xa129ca6149be45e5) { ret 1; }
    ret 0;
}

test "quic.storage.hash: random keys differ" {
    val first:  opt[Key] = random_key();
    val second: opt[Key] = random_key();
    if (!sel first.some)                                                    { ret 1; }
    if (!sel second.some)                                                   { ret 1; }
    if (first.some.k0 == second.some.k0 && first.some.k1 == second.some.k1) { ret 2; }
    ret 0;
}
