# growable min-heap of slot indices ordered by a u64 key
#
# each record stores its own heap position, reached through `position`, so a
# record can leave the heap from anywhere in it

use quic.connection.ownership;
use quic.storage.slots;

use std.allocator;
use std.allocator.testing;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

val MINIMUM: usize = 8;

pub rec Node {
    key:  u64;
    slot: usize;
}

pub rec Heap {
    nodes:    *Node;
    capacity: usize;
    count:    usize;
}

rec Probe {
    deadline: u64;
    position: usize;
}

pub fun empty() Heap {
    var value: Heap;
    value.nodes    = nil;
    value.capacity = 0;
    value.count    = 0;
    ret value;
}

pub fun sound(heap: *Heap) bool {
    ret heap.count <= heap.capacity && (heap.nodes != nil || heap.capacity == 0);
}

# makes room for `count` nodes in total. a refusal leaves the heap as it was
pub fun reserve(heap: *Heap, backing: *allocator.Allocator, count: usize) bool {
    if (count <= heap.capacity) { ret true; }
    if (backing == nil)         { ret false; }
    var next: usize = MINIMUM;
    if (heap.capacity >= MINIMUM) {
        next = heap.capacity * 2;
        if (heap.capacity > slots.NONE / 2) { next = slots.NONE - 1; }
    }
    if (next < count) { next = count; }
    var grown: res[*Node, allocator.Error];
    if (heap.nodes == nil) {
        grown = allocator.allocate[Node](backing, next);
    }
    or {
        grown = allocator.reallocate[Node](backing, heap.nodes, heap.capacity, next);
    }
    if (sel grown.err) { ret false; }
    heap.nodes    = grown.ok;
    heap.capacity = next;
    ret true;
}

fun set[T](heap: *Heap, table: *slots.Slots[T], at: usize, node: Node,
    position: fun(*T) *usize) {
    heap.nodes[at]                           = node;
    @position(?table.items[node.slot].value) = at;
}

fun rise[T](heap: *Heap, table: *slots.Slots[T], start: usize,
    position: fun(*T) *usize) {
    val node: Node  = heap.nodes[start];
    var at:   usize = start;
    for (at > 0) {
        val parent: usize = (at - 1) / 2;
        if (heap.nodes[parent].key <= node.key) { brk; }
        set[T](heap, table, at, heap.nodes[parent], position);
        at = parent;
    }
    set[T](heap, table, at, node, position);
}

fun sink[T](heap: *Heap, table: *slots.Slots[T], start: usize,
    position: fun(*T) *usize) {
    val node: Node  = heap.nodes[start];
    var at:   usize = start;
    for {
        val left: usize = at * 2 + 1;
        if (left >= heap.count) { brk; }
        var child: usize = left;
        if (left + 1 < heap.count && heap.nodes[left + 1].key < heap.nodes[left].key) {
            child = left + 1;
        }
        if (node.key <= heap.nodes[child].key) { brk; }
        set[T](heap, table, at, heap.nodes[child], position);
        at = child;
    }
    set[T](heap, table, at, node, position);
}

# requires a reserve for count + 1 since the last growth
pub fun push[T](heap: *Heap, table: *slots.Slots[T], key: u64, slot: usize,
    position: fun(*T) *usize) {
    heap.nodes[heap.count] = Node{key: key, slot: slot};
    heap.count             = heap.count + 1;
    rise[T](heap, table, heap.count - 1, position);
}

pub fun remove[T](heap: *Heap, table: *slots.Slots[T], at: usize,
    position: fun(*T) *usize) {
    @position(?table.items[heap.nodes[at].slot].value) = slots.NONE;
    heap.count                                         = heap.count - 1;
    if (at == heap.count) { ret; }
    set[T](heap, table, at, heap.nodes[heap.count], position);
    sink[T](heap, table, at, position);
    rise[T](heap, table, at, position);
}

pub fun bytes(heap: *Heap) usize {
    ret heap.capacity * $size_of(Node);
}

pub fun range(heap: *Heap) ownership.Range {
    ret ownership.array(heap.nodes::*u8, heap.capacity, $size_of(Node),
        ownership.ZERO_ALLOWED);
}

# releases the heap. a refusal keeps it, so the caller can try again
pub fun destroy(heap: *Heap, backing: *allocator.Allocator) bool {
    if (heap.nodes != nil) {
        if (backing == nil) { ret false; }
        val released: err[allocator.Error] = allocator.deallocate[Node](backing,
            heap.nodes, heap.capacity);
        if (sel released.err) { ret false; }
    }
    heap.nodes    = nil;
    heap.capacity = 0;
    heap.count    = 0;
    ret true;
}

fun probe_position(value: *Probe) *usize {
    ret ?value.position;
}

test "quic.storage.heap: removal from anywhere keeps order and positions exact" {
    var state: testing.Testing;
    val made:  err[allocator.Error] = testing.make(?state);
    if (sel made.err) { ret 1; }
    val backing: *allocator.Allocator = testing.allocator_of(?state);
    var table:   slots.Slots[Probe]   = slots.empty[Probe]();
    var order:   Heap                 = empty();
    var i:       usize                = 0;
    for (i < 50) {
        if (!slots.reserve[Probe](?table, backing, 1) ||
            !reserve(?order, backing, order.count + 1)) { ret 2; }
        val slot:     usize = slots.claim[Probe](?table);
        val deadline: u64   = (i * 37 % 50)::u64;
        table.items[slot].value.deadline = deadline;
        push[Probe](?order, ?table, deadline, slot, probe_position);
        i = i + 1;
    }
    if (order.capacity != 64 || !sound(?order)) { ret 7; }
    i = 0;
    for (i < 50) {
        if (i % 3 == 0) {
            remove[Probe](?order, ?table, table.items[i].value.position,
                probe_position);
            if (table.items[i].value.position != slots.NONE) { ret 3; }
        }
        i = i + 1;
    }
    var last: u64 = 0;
    for (order.count > 0) {
        val top: Node = order.nodes[0];
        if (top.key < last || table.items[top.slot].value.position != 0 ||
            top.slot % 3 == 0) { ret 4; }
        last = top.key;
        remove[Probe](?order, ?table, 0, probe_position);
        i = 0;
        for (i < order.count) {
            if (table.items[order.nodes[i].slot].value.position != i) { ret 5; }
            i = i + 1;
        }
    }
    if (!destroy(?order, backing) || !slots.destroy[Probe](?table, backing) ||
        testing.leaked(?state)) { ret 6; }
    testing.dnit(?state);
    ret 0;
}
