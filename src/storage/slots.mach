# growable index-addressed records with a free list
#
# records move when the directory grows, so only indices may be held across a
# call that can grow it

use quic.connection.ownership;

use std.allocator;
use std.allocator.testing;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# an index no directory can reach, whatever its capacity
pub val NONE: usize = 0xffffffffffffffff;

val MINIMUM: usize = 8;

pub rec Cell[T] {
    value:     T;
    next_free: usize;
}

pub rec Slots[T] {
    items:     *Cell[T];
    capacity:  usize;
    live:      usize;
    free_head: usize;
}

rec Probe {
    value: u64;
}

pub fun empty[T]() Slots[T] {
    var value: Slots[T];
    value.items     = nil;
    value.capacity  = 0;
    value.live      = 0;
    value.free_head = NONE;
    ret value;
}

# the counters agree with each other, so no walk can run past the directory
pub fun sound[T](slots: *Slots[T]) bool {
    ret slots.live <= slots.capacity && slots.capacity != NONE &&
        (slots.items != nil || slots.capacity == 0) &&
        (slots.free_head == NONE || slots.free_head < slots.capacity) &&
        (slots.free_head != NONE) == (slots.live < slots.capacity);
}

# makes the next `additional` claims succeed without allocating. a refusal
# leaves every record and index where it was
pub fun reserve[T](slots: *Slots[T], backing: *allocator.Allocator,
    additional: usize) bool {
    if (slots.capacity - slots.live >= additional)            { ret true; }
    if (backing == nil || additional > NONE - 1 - slots.live) { ret false; }
    val needed: usize = slots.live + additional;
    var next:   usize = MINIMUM;
    if (slots.capacity >= MINIMUM) {
        next = slots.capacity * 2;
        if (slots.capacity > (NONE - 1) / 2) { next = NONE - 1; }
    }
    if (next < needed) { next = needed; }
    var grown: res[*Cell[T], allocator.Error];
    if (slots.items == nil) {
        grown = allocator.allocate[Cell[T]](backing, next);
    }
    or {
        grown = allocator.reallocate[Cell[T]](backing, slots.items, slots.capacity, next);
    }
    if (sel grown.err) { ret false; }
    val items: *Cell[T] = grown.ok;
    memory.zero[Cell[T]](?items[slots.capacity], next - slots.capacity);
    var i: usize = next;
    for (i > slots.capacity) {
        i                  = i - 1;
        items[i].next_free = slots.free_head;
        slots.free_head    = i;
    }
    slots.items    = items;
    slots.capacity = next;
    ret true;
}

# takes the lowest recently freed index, or NONE when reserve was skipped
pub fun claim[T](slots: *Slots[T]) usize {
    val index: usize = slots.free_head;
    if (index == NONE) { ret NONE; }
    slots.free_head              = slots.items[index].next_free;
    slots.items[index].next_free = NONE;
    slots.live                   = slots.live + 1;
    ret index;
}

# the caller's own state proves the index is claimed
pub fun release[T](slots: *Slots[T], index: usize) {
    slots.items[index].next_free = slots.free_head;
    slots.free_head              = index;
    slots.live                   = slots.live - 1;
}

pub fun at[T](slots: *Slots[T], index: usize) *T {
    if (index >= slots.capacity) { ret nil; }
    ret ?slots.items[index].value;
}

pub fun bytes[T](slots: *Slots[T]) usize {
    ret slots.capacity * $size_of(Cell[T]);
}

pub fun range[T](slots: *Slots[T]) ownership.Range {
    ret ownership.array(slots.items::*u8, slots.capacity, $size_of(Cell[T]),
        ownership.ZERO_ALLOWED);
}

# releases the directory. a refusal keeps it, so the caller can try again
pub fun destroy[T](slots: *Slots[T], backing: *allocator.Allocator) bool {
    if (slots.items != nil) {
        if (backing == nil) { ret false; }
        val released: err[allocator.Error] = allocator.deallocate[Cell[T]](backing,
            slots.items, slots.capacity);
        if (sel released.err) { ret false; }
    }
    slots.items     = nil;
    slots.capacity  = 0;
    slots.live      = 0;
    slots.free_head = NONE;
    ret true;
}

test slots__growth_keeps_records_and_hands_out_every_index_once {
    var state: testing.Testing;
    val made:  err[allocator.Error] = testing.make(?state);
    if (sel made.err) { ret 1; }
    val backing: *allocator.Allocator = testing.allocator_of(?state);
    var table:   Slots[Probe]         = empty[Probe]();
    var seen:    [40]u8;
    var i:       usize                = 0;
    for (i < 40) {
        if (!reserve[Probe](?table, backing, 1)) { ret 2; }
        val index: usize = claim[Probe](?table);
        if (index >= 40 || seen[index] != 0) { ret 3; }
        seen[index]                    = 1;
        table.items[index].value.value = 1000 + index::u64;
        i                              = i + 1;
    }
    # doubling, so forty claims cost four allocations rather than thirty-three
    if (table.capacity != 64 || table.live != 40 || !sound[Probe](?table)) { ret 4; }
    i = 0;
    for (i < 40) {
        if (table.items[i].value.value != 1000 + i::u64) { ret 5; }
        i = i + 1;
    }
    release[Probe](?table, 17);
    if (claim[Probe](?table) != 17 || at[Probe](?table, table.capacity) != nil) { ret 6; }
    if (!destroy[Probe](?table, backing) || testing.leaked(?state))             { ret 7; }
    testing.dnit(?state);
    ret 0;
}

test slots__a_refused_growth_leaves_the_directory_intact {
    var state: testing.Testing;
    val made:  err[allocator.Error] = testing.make(?state);
    if (sel made.err) { ret 1; }
    val backing: *allocator.Allocator = testing.allocator_of(?state);
    var table:   Slots[Probe]         = empty[Probe]();
    if (!reserve[Probe](?table, backing, MINIMUM)) { ret 2; }
    var i: usize = 0;
    for (i < MINIMUM) {
        table.items[claim[Probe](?table)].value.value = i::u64;
        i                                             = i + 1;
    }
    val before: *Cell[Probe] = table.items;
    testing.fail_at_ordinal(?state, testing.attempt_count(?state) + 1);
    if (reserve[Probe](?table, backing, 1) || table.items != before ||
        table.capacity != MINIMUM || claim[Probe](?table) != NONE) { ret 3; }
    testing.clear_failure(?state);
    if (!reserve[Probe](?table, backing, 1) || table.items[3].value.value != 3) { ret 4; }
    if (!destroy[Probe](?table, backing) || testing.leaked(?state))             { ret 5; }
    testing.dnit(?state);
    ret 0;
}
