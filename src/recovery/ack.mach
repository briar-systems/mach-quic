use quic.frame.frame;
use quic.packet.packet;
use quic.wire.varint;

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val RECEIVE_NEW:       u8 = 1;
pub val RECEIVE_DUPLICATE: u8 = 2;
pub val RECEIVE_DROPPED:   u8 = 3;
pub val RECEIVE_DISCARDED: u8 = 4;
pub val RECEIVE_ERROR:     u8 = 5;

pub val ERROR_NONE:    u8 = 0;
pub val ERROR_SPACE:   u8 = 1;
pub val ERROR_NUMBER:  u8 = 2;
pub val ERROR_STORAGE: u8 = 3;
pub val ERROR_OUTPUT:  u8 = 4;
pub val ERROR_ECN:     u8 = 5;

pub val ECN_NOT_ECT: u8 = 0;
pub val ECN_ECT0:    u8 = 1;
pub val ECN_ECT1:    u8 = 2;
pub val ECN_CE:      u8 = 3;

pub rec Range {
    start: u64;
    end:   u64;
}

pub rec SpaceStorage {
    ranges:   *Range;
    capacity: usize;
}

pub rec Space {
    ranges:                    *Range;
    capacity:                  usize;
    count:                     usize;
    floor:                     u64;
    largest_received:          u64;
    largest_received_at_ns:    u64;
    largest_ack_eliciting:     u64;
    ack_deadline_ns:           u64;
    ack_eliciting_since_last:  u32;
    receive_generation:        u64;
    ect0:                      u64;
    ect1:                      u64;
    ecn_ce:                    u64;
    has_largest:               bool;
    has_largest_ack_eliciting: bool;
    ack_pending:               bool;
    ack_immediate:             bool;
    ack_deadline_armed:        bool;
    floor_exhausted:           bool;
    has_ecn:                   bool;
    discarded:                 bool;
}

pub rec Tracker {
    spaces:             [3]Space;
    max_ack_delay_ns:   u64;
    ack_delay_exponent: u8;
    valid:              bool;
}

pub rec ReceiveResult {
    status:  u8;
    error:   u8;
    ack_now: bool;
}

pub rec BuildResult {
    ok:                   bool;
    error:                u8;
    range_count:          usize;
    generation:           u64;
    largest_acknowledged: u64;
}

fun index(space: u8) usize {
    if (space < packet.SPACE_INITIAL || space > packet.SPACE_APPLICATION) { ret 3; }
    ret (space - packet.SPACE_INITIAL)::usize;
}

fun saturated_add(a: u64, b: u64) u64 {
    if (b > (0 - 1::u64) - a) { ret 0 - 1::u64; }
    ret a + b;
}

fun result(status: u8, error: u8, ack_now: bool) ReceiveResult {
    var r: ReceiveResult;
    r.status  = status;
    r.error   = error;
    r.ack_now = ack_now;
    ret r;
}

pub fun init(initial: SpaceStorage, handshake: SpaceStorage, application: SpaceStorage, max_ack_delay_ns: u64, ack_delay_exponent: u8) Tracker {
    var tracker: Tracker;
    if (initial.ranges == nil || handshake.ranges == nil || application.ranges == nil ||
        initial.capacity == 0 || handshake.capacity == 0 || application.capacity == 0 ||
        ack_delay_exponent > 20) {
        ret tracker;
    }
    tracker.spaces[0].ranges   = initial.ranges;
    tracker.spaces[0].capacity = initial.capacity;
    tracker.spaces[1].ranges   = handshake.ranges;
    tracker.spaces[1].capacity = handshake.capacity;
    tracker.spaces[2].ranges   = application.ranges;
    tracker.spaces[2].capacity = application.capacity;
    tracker.max_ack_delay_ns   = max_ack_delay_ns;
    tracker.ack_delay_exponent = ack_delay_exponent;
    tracker.valid              = true;
    ret tracker;
}

fun advance_generation(space: *Space) {
    if (space.receive_generation == 0 - 1::u64) {
        space.receive_generation = 1;
    }
    or {
        space.receive_generation = space.receive_generation + 1;
    }
}

fun raise_floor_through(space: *Space, number: u64) {
    if (number == packet.MAX_PACKET_NUMBER) {
        space.floor           = packet.MAX_PACKET_NUMBER;
        space.floor_exhausted = true;
    }
    or (number + 1 > space.floor) {
        space.floor = number + 1;
    }
}

fun insert_number(space: *Space, number: u64) u8 {
    if (space.floor_exhausted || number < space.floor) { ret RECEIVE_DROPPED; }
    var position: usize = 0;
    for (position < space.count) {
        val range: Range = space.ranges[position];
        if (number >= range.start && number <= range.end) { ret RECEIVE_DUPLICATE; }
        if (number > range.end)                           { brk; }
        position = position + 1;
    }

    var joins_high: bool = false;
    var joins_low:  bool = false;
    if (position > 0 && space.ranges[position - 1].start > 0 &&
        space.ranges[position - 1].start - 1 == number) { joins_high = true; }
    if (position < space.count && space.ranges[position].end < packet.MAX_PACKET_NUMBER &&
        space.ranges[position].end + 1 == number) { joins_low = true; }

    if (joins_high && joins_low) {
        space.ranges[position - 1].start = space.ranges[position].start;
        var i: usize = position;
        for (i + 1 < space.count) {
            space.ranges[i] = space.ranges[i + 1];
            i               = i + 1;
        }
        space.count = space.count - 1;
        ret RECEIVE_NEW;
    }
    if (joins_high) {
        space.ranges[position - 1].start = number;
        ret RECEIVE_NEW;
    }
    if (joins_low) {
        space.ranges[position].end = number;
        ret RECEIVE_NEW;
    }

    if (space.count == space.capacity && position >= space.count) {
        raise_floor_through(space, number);
        ret RECEIVE_DROPPED;
    }

    if (space.count == space.capacity) {
        val evicted: Range = space.ranges[space.count - 1];
        raise_floor_through(space, evicted.end);
    }
    or {
        space.count = space.count + 1;
    }
    var i: usize = space.count - 1;
    for (i > position) {
        space.ranges[i] = space.ranges[i - 1];
        i               = i - 1;
    }
    space.ranges[position].start = number;
    space.ranges[position].end   = number;
    ret RECEIVE_NEW;
}

fun increment_ecn(space: *Space, ecn: u8) {
    if (ecn == ECN_ECT0) {
        if (space.ect0 < varint.MAX) { space.ect0 = space.ect0 + 1; }
        space.has_ecn = true;
    }
    if (ecn == ECN_ECT1) {
        if (space.ect1 < varint.MAX) { space.ect1 = space.ect1 + 1; }
        space.has_ecn = true;
    }
    if (ecn == ECN_CE) {
        if (space.ecn_ce < varint.MAX) { space.ecn_ce = space.ecn_ce + 1; }
        space.has_ecn = true;
    }
}

# what on_packet would decide for this number, without recording it
pub fun classify(tracker: *Tracker, pn_space: u8, number: u64) u8 {
    val i: usize = index(pn_space);
    if (tracker == nil || !tracker.valid || i >= 3 ||
        number > packet.MAX_PACKET_NUMBER) { ret RECEIVE_ERROR; }
    val space: *Space = ?tracker.spaces[i];
    if (space.discarded)                               { ret RECEIVE_DISCARDED; }
    if (space.floor_exhausted || number < space.floor) { ret RECEIVE_DROPPED; }
    var position: usize = 0;
    for (position < space.count) {
        val range: Range = space.ranges[position];
        if (number >= range.start && number <= range.end) { ret RECEIVE_DUPLICATE; }
        if (number > range.end)                           { brk; }
        position = position + 1;
    }
    ret RECEIVE_NEW;
}

pub fun on_packet(tracker: *Tracker, pn_space: u8, number: u64, received_at_ns: u64, ack_eliciting: bool, ecn: u8) ReceiveResult {
    val i: usize = index(pn_space);
    if (tracker == nil || !tracker.valid || i >= 3) { ret result(RECEIVE_ERROR, ERROR_SPACE, false); }
    if (number > packet.MAX_PACKET_NUMBER)          { ret result(RECEIVE_ERROR, ERROR_NUMBER, false); }
    if (ecn > ECN_CE)                               { ret result(RECEIVE_ERROR, ERROR_ECN, false); }
    val space: *Space = ?tracker.spaces[i];
    if (space.discarded) { ret result(RECEIVE_DISCARDED, ERROR_NONE, false); }
    val inserted: u8 = insert_number(space, number);
    if (inserted != RECEIVE_NEW) {
        if (inserted == RECEIVE_DUPLICATE && ack_eliciting) {
            space.ack_pending   = true;
            space.ack_immediate = true;
            advance_generation(space);
            ret result(inserted, ERROR_NONE, true);
        }
        ret result(inserted, ERROR_NONE, false);
    }
    increment_ecn(space, ecn);
    advance_generation(space);

    val had_largest:      bool = space.has_largest;
    val previous_largest: u64  = space.largest_received;
    if (!had_largest || number > previous_largest) {
        space.largest_received       = number;
        space.largest_received_at_ns = received_at_ns;
        space.has_largest            = true;
    }
    space.ack_pending = true;

    if (ack_eliciting) {
        if (space.ack_eliciting_since_last < 0 - 1::u32) {
            space.ack_eliciting_since_last = space.ack_eliciting_since_last + 1;
        }
        if (space.has_largest_ack_eliciting) {
            if (number < space.largest_ack_eliciting) { space.ack_immediate = true; }
            if (number > space.largest_ack_eliciting &&
                number - space.largest_ack_eliciting > 1) { space.ack_immediate = true; }
        }
        if (!space.has_largest_ack_eliciting || number > space.largest_ack_eliciting) {
            space.largest_ack_eliciting     = number;
            space.has_largest_ack_eliciting = true;
        }
        if (pn_space != packet.SPACE_APPLICATION || space.ack_eliciting_since_last >= 2) {
            space.ack_immediate = true;
        }
        if (!space.ack_deadline_armed) {
            if (pn_space == packet.SPACE_APPLICATION) {
                space.ack_deadline_ns = saturated_add(received_at_ns, tracker.max_ack_delay_ns);
            }
            or {
                space.ack_deadline_ns = received_at_ns;
            }
            space.ack_deadline_armed = true;
        }
    }
    if (ecn == ECN_CE && ack_eliciting) { space.ack_immediate = true; }
    ret result(RECEIVE_NEW, ERROR_NONE, space.ack_immediate);
}

pub fun ack_due(tracker: *Tracker, pn_space: u8, now_ns: u64) bool {
    val i: usize = index(pn_space);
    if (tracker == nil || !tracker.valid || i >= 3) { ret false; }
    val space: *Space = ?tracker.spaces[i];
    if (space.discarded || !space.ack_pending) { ret false; }
    if (space.ack_immediate)                   { ret true; }
    ret space.ack_deadline_armed && now_ns >= space.ack_deadline_ns;
}

# the checks build makes before it writes, and the frame it writes without
# its ranges. ERROR_STORAGE when `capacity` cannot hold the ranges
fun ack_frame(tracker: *Tracker, pn_space: u8, now_ns: u64, capacity: usize,
    out: *frame.Frame) u8 {
    val i: usize = index(pn_space);
    if (tracker == nil || out == nil || !tracker.valid || i >= 3) { ret ERROR_OUTPUT; }
    val space: *Space = ?tracker.spaces[i];
    if (space.discarded || !space.ack_pending || space.count == 0) { ret ERROR_SPACE; }
    if (now_ns < space.largest_received_at_ns)                     { ret ERROR_OUTPUT; }
    val needed: usize = space.count - 1;
    if (needed > capacity) { ret ERROR_STORAGE; }
    var ack: frame.Frame;
    ack.kind = frame.ACK;
    if (space.has_ecn) {
        ack.kind   = frame.ACK_ECN;
        ack.ect0   = space.ect0;
        ack.ect1   = space.ect1;
        ack.ecn_ce = space.ecn_ce;
    }
    ack.largest_acknowledged = space.ranges[0].end;
    ack.first_ack_range      = space.ranges[0].end - space.ranges[0].start;
    ack.ack_range_count      = needed;
    if (pn_space == packet.SPACE_APPLICATION && now_ns > space.largest_received_at_ns) {
        val delay_us: u64 = (now_ns - space.largest_received_at_ns) / 1000;
        ack.ack_delay = delay_us >> tracker.ack_delay_exponent;
    }
    @out = ack;
    ret ERROR_NONE;
}

fun gap_at(space: *Space, position: usize) u64 {
    ret space.ranges[position - 1].start - space.ranges[position].end - 2;
}

fun range_at(space: *Space, position: usize) u64 {
    ret space.ranges[position].end - space.ranges[position].start;
}

pub fun build(tracker: *Tracker, pn_space: u8, now_ns: u64, ranges: *frame.AckRange, capacity: usize, out: *frame.Frame) BuildResult {
    var build: BuildResult;
    var ack:   frame.Frame;
    var room:  usize = capacity;
    if (ranges == nil) { room = 0; }
    build.error = ack_frame(tracker, pn_space, now_ns, room, ?ack);
    if (build.error != ERROR_NONE) { ret build; }
    val space: *Space = ?tracker.spaces[index(pn_space)];
    ack.ack_ranges = ranges;
    var position: usize = 1;
    for (position < space.count) {
        ranges[position - 1].gap   = gap_at(space, position);
        ranges[position - 1].range = range_at(space, position);
        position                   = position + 1;
    }
    @out                       = ack;
    build.ok                   = true;
    build.range_count          = ack.ack_range_count;
    build.generation           = space.receive_generation;
    build.largest_acknowledged = ack.largest_acknowledged;
    ret build;
}

# the bytes the frame build would write with the same arguments, or 0 where
# build refuses. it writes nothing, so a send can be sized before the frame is
# taken
pub fun frame_size(tracker: *Tracker, pn_space: u8, now_ns: u64, capacity: usize) usize {
    var ack: frame.Frame;
    if (ack_frame(tracker, pn_space, now_ns, capacity, ?ack) != ERROR_NONE) { ret 0; }
    val space: *Space = ?tracker.spaces[index(pn_space)];
    # the frame without its ranges, then each range as encode writes it
    val count: usize = ack.ack_range_count;
    ack.ack_range_count = 0;
    val base: frame.EncodeResult = frame.encoded_size(?ack, frame.default_limits());
    if (!base.ok) { ret 0; }
    var size: usize = base.count - varint.width(0)::usize +
        varint.width(count::u64)::usize;
    var position: usize = 1;
    for (position < space.count) {
        size = size + varint.width(gap_at(space, position))::usize +
            varint.width(range_at(space, position))::usize;
        position = position + 1;
    }
    ret size;
}

pub fun on_ack_sent(tracker: *Tracker, pn_space: u8, generation: u64) bool {
    val i: usize = index(pn_space);
    if (tracker == nil || !tracker.valid || i >= 3 || tracker.spaces[i].discarded ||
        !tracker.spaces[i].ack_pending || tracker.spaces[i].receive_generation != generation) { ret false; }
    tracker.spaces[i].ack_pending              = false;
    tracker.spaces[i].ack_immediate            = false;
    tracker.spaces[i].ack_deadline_ns          = 0;
    tracker.spaces[i].ack_deadline_armed       = false;
    tracker.spaces[i].ack_eliciting_since_last = 0;
    ret true;
}

pub fun on_ack_packet_acked(tracker: *Tracker, pn_space: u8, largest_acknowledged: u64) bool {
    val i: usize = index(pn_space);
    if (tracker == nil || !tracker.valid || i >= 3 || tracker.spaces[i].discarded) { ret false; }
    val space: *Space = ?tracker.spaces[i];
    if (!space.has_largest || largest_acknowledged > space.largest_received) { ret false; }
    var position: usize = 0;
    for (position < space.count) {
        if (space.ranges[position].start > largest_acknowledged) {
            position = position + 1;
        }
        or {
            if (space.ranges[position].end > largest_acknowledged) {
                space.ranges[position].start = saturated_add(largest_acknowledged, 1);
                position                     = position + 1;
            }
            space.count = position;
            raise_floor_through(space, largest_acknowledged);
            ret true;
        }
    }
    raise_floor_through(space, largest_acknowledged);
    ret true;
}

pub fun discard_space(tracker: *Tracker, pn_space: u8) bool {
    val i: usize = index(pn_space);
    if (tracker == nil || !tracker.valid || i >= 2) { ret false; }
    tracker.spaces[i].count              = 0;
    tracker.spaces[i].ack_pending        = false;
    tracker.spaces[i].ack_immediate      = false;
    tracker.spaces[i].ack_deadline_armed = false;
    tracker.spaces[i].floor_exhausted    = true;
    tracker.spaces[i].discarded          = true;
    ret true;
}

# drops a discarded space's range storage so its holder can release it. the
# space is never read again
pub fun detach_space(tracker: *Tracker, pn_space: u8) bool {
    val i: usize = index(pn_space);
    if (tracker == nil || !tracker.valid || i >= 2 || !tracker.spaces[i].discarded) {
        ret false;
    }
    tracker.spaces[i].ranges   = nil;
    tracker.spaces[i].capacity = 0;
    ret true;
}

test ack__reordering_gaps_and_duplication_produce_bounded_ranges {
    var initial:     [4]Range;
    var handshake:   [4]Range;
    var application: [4]Range;
    var tracker:     Tracker = init(
        SpaceStorage{ranges: ?initial[0], capacity: 4},
        SpaceStorage{ranges: ?handshake[0], capacity: 4},
        SpaceStorage{ranges: ?application[0], capacity: 4},
        25000000, 3);
    if (!tracker.valid)                                                                                                 { ret 1; }
    if (on_packet(?tracker, packet.SPACE_APPLICATION, 0, 0, true, ECN_NOT_ECT).ack_now)                                 { ret 1; }
    if (!on_packet(?tracker, packet.SPACE_APPLICATION, 2, 1, true, ECN_NOT_ECT).ack_now)                                { ret 1; }
    if (on_packet(?tracker, packet.SPACE_APPLICATION, 2, 2, true, ECN_NOT_ECT).status != RECEIVE_DUPLICATE)             { ret 1; }
    if (tracker.spaces[2].count != 2)                                                                                   { ret 1; }
    if (on_packet(?tracker, packet.SPACE_APPLICATION, 1, 3, true, ECN_NOT_ECT).status != RECEIVE_NEW)                   { ret 1; }
    if (tracker.spaces[2].count != 1 || tracker.spaces[2].ranges[0].start != 0 || tracker.spaces[2].ranges[0].end != 2) { ret 1; }
    ret 0;
}

test ack__frame_construction_preserves_descending_ranges_and_delay {
    var initial:     [2]Range;
    var handshake:   [2]Range;
    var application: [3]Range;
    var tracker:     Tracker = init(
        SpaceStorage{ranges: ?initial[0], capacity: 2},
        SpaceStorage{ranges: ?handshake[0], capacity: 2},
        SpaceStorage{ranges: ?application[0], capacity: 3},
        25000000, 3);
    on_packet(?tracker, packet.SPACE_APPLICATION, 10, 1000, true, ECN_NOT_ECT);
    on_packet(?tracker, packet.SPACE_APPLICATION, 8, 2000, true, ECN_NOT_ECT);
    on_packet(?tracker, packet.SPACE_APPLICATION, 5, 3000, false, ECN_NOT_ECT);
    var ranges: [2]frame.AckRange;
    var ack:    frame.Frame;
    val built:  BuildResult = build(?tracker, packet.SPACE_APPLICATION, 11000, ?ranges[0], 2, ?ack);
    if (!built.ok || ack.largest_acknowledged != 10 || ack.first_ack_range != 0 || ack.ack_range_count != 2) { ret 1; }
    if (ranges[0].gap != 0 || ranges[0].range != 0 || ranges[1].gap != 1 || ranges[1].range != 0)            { ret 1; }
    if (ack.ack_delay != 1)                                                                                  { ret 1; }
    ret 0;
}

fun built_size(tracker: *Tracker, pn_space: u8, now_ns: u64, ranges: *frame.AckRange,
    capacity: usize) usize {
    var ack:   frame.Frame;
    val built: BuildResult = build(tracker, pn_space, now_ns, ranges, capacity, ?ack);
    if (!built.ok) { ret 0; }
    val encoded: frame.EncodeResult = frame.encoded_size(?ack, frame.default_limits());
    if (!encoded.ok) { ret 0; }
    ret encoded.count;
}

test ack__an_ack_frames_size_is_what_building_it_writes {
    var initial:     [2]Range;
    var handshake:   [2]Range;
    var application: [8]Range;
    var tracker:     Tracker = init(
        SpaceStorage{ranges: ?initial[0], capacity: 2},
        SpaceStorage{ranges: ?handshake[0], capacity: 2},
        SpaceStorage{ranges: ?application[0], capacity: 8},
        25000000, 3);
    var ranges: [8]frame.AckRange;
    # nothing to acknowledge is a refusal in both
    if (frame_size(?tracker, packet.SPACE_APPLICATION, 1, 8) != 0) { ret 1; }
    on_packet(?tracker, packet.SPACE_APPLICATION, 20000, 1000, true, ECN_NOT_ECT);
    on_packet(?tracker, packet.SPACE_APPLICATION, 9000, 2000, true, ECN_NOT_ECT);
    on_packet(?tracker, packet.SPACE_APPLICATION, 5, 3000, false, ECN_ECT1);
    on_packet(?tracker, packet.SPACE_APPLICATION, 3, 4000, true, ECN_NOT_ECT);
    on_packet(?tracker, packet.SPACE_APPLICATION, 2, 5000, true, ECN_CE);
    # a range count, gaps and a delay that span several varint widths
    val sized: usize = frame_size(?tracker, packet.SPACE_APPLICATION, 90000000, 8);
    if (sized == 0 || sized != built_size(?tracker, packet.SPACE_APPLICATION,
        90000000, ?ranges[0], 8)) { ret 2; }
    if (frame_size(?tracker, packet.SPACE_APPLICATION, 6000, 8) !=
        built_size(?tracker, packet.SPACE_APPLICATION, 6000, ?ranges[0], 8)) { ret 3; }
    # too little range storage refuses in both
    if (frame_size(?tracker, packet.SPACE_APPLICATION, 6000, 2) != 0 ||
        built_size(?tracker, packet.SPACE_APPLICATION, 6000, ?ranges[0], 2) != 0) { ret 4; }
    on_packet(?tracker, packet.SPACE_INITIAL, 0, 1, true, ECN_NOT_ECT);
    if (frame_size(?tracker, packet.SPACE_INITIAL, 7, 0) != built_size(?tracker,
        packet.SPACE_INITIAL, 7, nil, 0)) { ret 5; }
    ret 0;
}

test ack__capacity_eviction_advances_the_acceptance_floor {
    var initial:     [1]Range;
    var handshake:   [1]Range;
    var application: [2]Range;
    var tracker:     Tracker = init(
        SpaceStorage{ranges: ?initial[0], capacity: 1},
        SpaceStorage{ranges: ?handshake[0], capacity: 1},
        SpaceStorage{ranges: ?application[0], capacity: 2},
        1, 0);
    on_packet(?tracker, packet.SPACE_APPLICATION, 10, 0, true, ECN_NOT_ECT);
    on_packet(?tracker, packet.SPACE_APPLICATION, 6, 1, true, ECN_NOT_ECT);
    on_packet(?tracker, packet.SPACE_APPLICATION, 8, 2, true, ECN_NOT_ECT);
    if (tracker.spaces[2].count != 2 || tracker.spaces[2].floor != 7)                                     { ret 1; }
    if (on_packet(?tracker, packet.SPACE_APPLICATION, 6, 3, true, ECN_NOT_ECT).status != RECEIVE_DROPPED) { ret 1; }
    ret 0;
}

test ack__spaces_schedule_independently_and_discard_is_terminal {
    var initial:     [2]Range;
    var handshake:   [2]Range;
    var application: [2]Range;
    var tracker:     Tracker = init(
        SpaceStorage{ranges: ?initial[0], capacity: 2},
        SpaceStorage{ranges: ?handshake[0], capacity: 2},
        SpaceStorage{ranges: ?application[0], capacity: 2},
        10, 0);
    if (!on_packet(?tracker, packet.SPACE_INITIAL, 0, 5, true, ECN_NOT_ECT).ack_now)                    { ret 1; }
    if (on_packet(?tracker, packet.SPACE_APPLICATION, 0, 5, true, ECN_NOT_ECT).ack_now)                 { ret 1; }
    if (!ack_due(?tracker, packet.SPACE_APPLICATION, 15))                                               { ret 1; }
    if (!discard_space(?tracker, packet.SPACE_INITIAL))                                                 { ret 1; }
    if (on_packet(?tracker, packet.SPACE_INITIAL, 1, 6, true, ECN_NOT_ECT).status != RECEIVE_DISCARDED) { ret 1; }
    if (tracker.spaces[2].discarded)                                                                    { ret 1; }
    ret 0;
}

test ack__zero_delay_ecn_counts_and_send_publication_are_race_safe {
    var initial:     [2]Range;
    var handshake:   [2]Range;
    var application: [3]Range;
    var tracker:     Tracker = init(
        SpaceStorage{ranges: ?initial[0], capacity: 2},
        SpaceStorage{ranges: ?handshake[0], capacity: 2},
        SpaceStorage{ranges: ?application[0], capacity: 3},
        0, 0);
    if (on_packet(?tracker, packet.SPACE_APPLICATION, 0, 0, true, ECN_ECT0).ack_now) { ret 1; }
    if (!ack_due(?tracker, packet.SPACE_APPLICATION, 0))                             { ret 1; }
    var ranges: [2]frame.AckRange;
    var ack:    frame.Frame;
    val first:  BuildResult = build(?tracker, packet.SPACE_APPLICATION, 0, ?ranges[0], 2, ?ack);
    if (!first.ok || ack.kind != frame.ACK_ECN || ack.ect0 != 1 || ack.ect1 != 0 || ack.ecn_ce != 0) { ret 1; }

    if (!on_packet(?tracker, packet.SPACE_APPLICATION, 1, 1, true, ECN_CE).ack_now) { ret 1; }
    if (on_ack_sent(?tracker, packet.SPACE_APPLICATION, first.generation))          { ret 1; }
    if (!tracker.spaces[2].ack_pending)                                             { ret 1; }
    val second: BuildResult = build(?tracker, packet.SPACE_APPLICATION, 1, ?ranges[0], 2, ?ack);
    if (!second.ok || ack.largest_acknowledged != 1 || ack.ect0 != 1 || ack.ecn_ce != 1)                      { ret 1; }
    if (!on_ack_sent(?tracker, packet.SPACE_APPLICATION, second.generation) || tracker.spaces[2].ack_pending) { ret 1; }
    if (on_ack_sent(?tracker, packet.SPACE_APPLICATION, second.generation))                                   { ret 1; }
    ret 0;
}

test ack__output_and_terminal_packet_number_bounds_are_transactional {
    var initial:     [1]Range;
    var handshake:   [1]Range;
    var application: [2]Range;
    var tracker:     Tracker = init(
        SpaceStorage{ranges: ?initial[0], capacity: 1},
        SpaceStorage{ranges: ?handshake[0], capacity: 1},
        SpaceStorage{ranges: ?application[0], capacity: 2},
        1, 0);
    on_packet(?tracker, packet.SPACE_APPLICATION, packet.MAX_PACKET_NUMBER, 10, true, ECN_NOT_ECT);
    var output: frame.Frame;
    output.kind = frame.PING;
    val invalid_time: BuildResult = build(?tracker, packet.SPACE_APPLICATION, 9, nil, 0, ?output);
    if (invalid_time.ok || invalid_time.error != ERROR_OUTPUT || output.kind != frame.PING) { ret 1; }
    val built: BuildResult = build(?tracker, packet.SPACE_APPLICATION, 10, nil, 0, ?output);
    if (!built.ok || built.largest_acknowledged != packet.MAX_PACKET_NUMBER)                                                      { ret 1; }
    if (!on_ack_packet_acked(?tracker, packet.SPACE_APPLICATION, built.largest_acknowledged))                                     { ret 1; }
    if (!tracker.spaces[2].floor_exhausted || tracker.spaces[2].count != 0)                                                       { ret 1; }
    if (on_packet(?tracker, packet.SPACE_APPLICATION, packet.MAX_PACKET_NUMBER, 11, true, ECN_NOT_ECT).status != RECEIVE_DROPPED) { ret 1; }
    ret 0;
}
