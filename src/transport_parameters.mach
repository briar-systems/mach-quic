use quic.packet.packet;
use quic.wire.varint;

use std.encoding.binary;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;


fun is_err_usize_encode(outcome: res[usize, binary.EncodeError]) bool {
    ret sel outcome.err;
}

fun is_ok_usize_encode(outcome: res[usize, binary.EncodeError]) bool {
    ret sel outcome.ok;
}

fun is_ok_usize_u8(outcome: res[usize, u8]) bool {
    ret sel outcome.ok;
}
pub val ORIGINAL_DESTINATION_CONNECTION_ID: u64 = 0x00;
pub val MAX_IDLE_TIMEOUT: u64 = 0x01;
pub val STATELESS_RESET_TOKEN: u64 = 0x02;
pub val MAX_UDP_PAYLOAD_SIZE: u64 = 0x03;
pub val INITIAL_MAX_DATA: u64 = 0x04;
pub val INITIAL_MAX_STREAM_DATA_BIDI_LOCAL: u64 = 0x05;
pub val INITIAL_MAX_STREAM_DATA_BIDI_REMOTE: u64 = 0x06;
pub val INITIAL_MAX_STREAM_DATA_UNI: u64 = 0x07;
pub val INITIAL_MAX_STREAMS_BIDI: u64 = 0x08;
pub val INITIAL_MAX_STREAMS_UNI: u64 = 0x09;
pub val ACK_DELAY_EXPONENT: u64 = 0x0a;
pub val MAX_ACK_DELAY: u64 = 0x0b;
pub val DISABLE_ACTIVE_MIGRATION: u64 = 0x0c;
pub val PREFERRED_ADDRESS: u64 = 0x0d;
pub val ACTIVE_CONNECTION_ID_LIMIT: u64 = 0x0e;
pub val INITIAL_SOURCE_CONNECTION_ID: u64 = 0x0f;
pub val RETRY_SOURCE_CONNECTION_ID: u64 = 0x10;
pub val MAX_DATAGRAM_FRAME_SIZE: u64 = 0x20;

pub val ROLE_ANY: u8 = 0;
pub val ROLE_CLIENT: u8 = 1;
pub val ROLE_SERVER: u8 = 2;

pub val STATUS_DONE: u8 = 1;
pub val STATUS_MORE: u8 = 2;
pub val STATUS_ERROR: u8 = 3;

pub val ERROR_NONE: u8 = 0;
pub val ERROR_TRUNCATED: u8 = 1;
pub val ERROR_DUPLICATE: u8 = 2;
pub val ERROR_ENCODING: u8 = 3;
pub val ERROR_VALUE: u8 = 4;
pub val ERROR_ROLE: u8 = 5;
pub val ERROR_LIMIT: u8 = 6;
pub val ERROR_OUTPUT: u8 = 7;

pub val MAX_PARAMETERS: usize = 256;

pub rec Parameter {
    id: u64;
    value: packet.Span;
}

pub rec Storage {
    extensions: *Parameter;
    extension_capacity: usize;
    extension_bytes: *u8;
    extension_byte_capacity: usize;
}

pub rec PreferredAddress {
    ipv4: [4]u8;
    ipv4_port: u16;
    ipv6: [16]u8;
    ipv6_port: u16;
    connection_id: packet.ConnectionId;
    stateless_reset_token: [16]u8;
}

pub rec Parameters {
    present: u64;
    original_destination_connection_id: packet.ConnectionId;
    max_idle_timeout: u64;
    stateless_reset_token: [16]u8;
    max_udp_payload_size: u64;
    initial_max_data: u64;
    initial_max_stream_data_bidi_local: u64;
    initial_max_stream_data_bidi_remote: u64;
    initial_max_stream_data_uni: u64;
    initial_max_streams_bidi: u64;
    initial_max_streams_uni: u64;
    ack_delay_exponent: u64;
    max_ack_delay: u64;
    disable_active_migration: bool;
    preferred_address: PreferredAddress;
    active_connection_id_limit: u64;
    initial_source_connection_id: packet.ConnectionId;
    retry_source_connection_id: packet.ConnectionId;
    max_datagram_frame_size: u64;
    extensions: *Parameter;
    extension_count: usize;
}

pub rec Limits {
    max_total_size: usize;
    max_parameters: usize;
    max_extension_size: usize;
}

pub rec DecodeResult {
    status: u8;
    error: u8;
    consumed: usize;
    needed: usize;
}

pub rec EncodeResult {
    ok: bool;
    error: u8;
    count: usize;
}

pub fun default_limits() Limits {
    var limits: Limits;
    limits.max_total_size = 16384;
    limits.max_parameters = 128;
    limits.max_extension_size = 4096;
    ret limits;
}

pub fun defaults() Parameters {
    var parameters: Parameters;
    parameters.max_udp_payload_size = 65527;
    parameters.ack_delay_exponent = 3;
    parameters.max_ack_delay = 25;
    parameters.active_connection_id_limit = 2;
    ret parameters;
}

fun known(id: u64) bool {
    ret id <= RETRY_SOURCE_CONNECTION_ID || id == MAX_DATAGRAM_FRAME_SIZE;
}

pub fun has(parameters: *Parameters, id: u64) bool {
    if (parameters == nil || !known(id)) { ret false; }
    ret (parameters.present & (1 << id)) != 0;
}

pub fun set_present(parameters: *Parameters, id: u64) bool {
    if (parameters == nil || !known(id)) { ret false; }
    parameters.present = parameters.present | (1 << id);
    ret true;
}

fun done(count: usize) DecodeResult {
    var r: DecodeResult;
    r.status = STATUS_DONE;
    r.consumed = count;
    ret r;
}

fun failed(code: u8) DecodeResult {
    var r: DecodeResult;
    r.status = STATUS_ERROR;
    r.error = code;
    ret r;
}

fun missing(final: bool, needed: usize) DecodeResult {
    if (final) { ret failed(ERROR_TRUNCATED); }
    var r: DecodeResult;
    r.status = STATUS_MORE;
    r.needed = needed;
    ret r;
}

fun fits(d: *binary.Decoder, width: usize) bool {
    ret d != nil && d.pos <= d.len && width <= d.len - d.pos;
}

fun read_value(d: *binary.Decoder, value: *u64) u8 {
    val decoded: varint.Decoded = varint.read(d, false);
    if (decoded.status != varint.STATUS_DONE) { ret decoded.status; }
    @value = decoded.value;
    ret varint.STATUS_DONE;
}

fun read_scalar(data: *u8, len: usize, value: *u64) bool {
    var d: binary.Decoder = binary.decoder(data, len, binary.BIG);
    if (read_value(?d, value) != varint.STATUS_DONE) { ret false; }
    ret d.pos == d.len;
}

fun validate_role(parameters: *Parameters, role: u8) bool {
    if (!has(parameters, INITIAL_SOURCE_CONNECTION_ID)) { ret false; }
    if (role == ROLE_CLIENT) {
        if (has(parameters, ORIGINAL_DESTINATION_CONNECTION_ID) ||
            has(parameters, STATELESS_RESET_TOKEN) ||
            has(parameters, PREFERRED_ADDRESS) ||
            has(parameters, RETRY_SOURCE_CONNECTION_ID)) { ret false; }
    }
    if (role == ROLE_SERVER && !has(parameters, ORIGINAL_DESTINATION_CONNECTION_ID)) { ret false; }
    ret role == ROLE_ANY || role == ROLE_CLIENT || role == ROLE_SERVER;
}

fun scalar_valid(id: u64, value: u64) bool {
    if (value > varint.MAX) { ret false; }
    if ((id == INITIAL_MAX_STREAMS_BIDI || id == INITIAL_MAX_STREAMS_UNI) && value > (1 << 60)) { ret false; }
    if (id == MAX_UDP_PAYLOAD_SIZE && value < 1200) { ret false; }
    if (id == ACK_DELAY_EXPONENT && value > 20) { ret false; }
    if (id == MAX_ACK_DELAY && value >= (1 << 14)) { ret false; }
    if (id == ACTIVE_CONNECTION_ID_LIMIT && value < 2) { ret false; }
    ret true;
}

fun assign_scalar(parameters: *Parameters, id: u64, value: u64) {
    if (id == MAX_IDLE_TIMEOUT) { parameters.max_idle_timeout = value; }
    if (id == MAX_UDP_PAYLOAD_SIZE) { parameters.max_udp_payload_size = value; }
    if (id == INITIAL_MAX_DATA) { parameters.initial_max_data = value; }
    if (id == INITIAL_MAX_STREAM_DATA_BIDI_LOCAL) { parameters.initial_max_stream_data_bidi_local = value; }
    if (id == INITIAL_MAX_STREAM_DATA_BIDI_REMOTE) { parameters.initial_max_stream_data_bidi_remote = value; }
    if (id == INITIAL_MAX_STREAM_DATA_UNI) { parameters.initial_max_stream_data_uni = value; }
    if (id == INITIAL_MAX_STREAMS_BIDI) { parameters.initial_max_streams_bidi = value; }
    if (id == INITIAL_MAX_STREAMS_UNI) { parameters.initial_max_streams_uni = value; }
    if (id == ACK_DELAY_EXPONENT) { parameters.ack_delay_exponent = value; }
    if (id == MAX_ACK_DELAY) { parameters.max_ack_delay = value; }
    if (id == ACTIVE_CONNECTION_ID_LIMIT) { parameters.active_connection_id_limit = value; }
    if (id == MAX_DATAGRAM_FRAME_SIZE) { parameters.max_datagram_frame_size = value; }
}

fun scalar_value(parameters: *Parameters, id: u64) u64 {
    if (id == MAX_IDLE_TIMEOUT) { ret parameters.max_idle_timeout; }
    if (id == MAX_UDP_PAYLOAD_SIZE) { ret parameters.max_udp_payload_size; }
    if (id == INITIAL_MAX_DATA) { ret parameters.initial_max_data; }
    if (id == INITIAL_MAX_STREAM_DATA_BIDI_LOCAL) { ret parameters.initial_max_stream_data_bidi_local; }
    if (id == INITIAL_MAX_STREAM_DATA_BIDI_REMOTE) { ret parameters.initial_max_stream_data_bidi_remote; }
    if (id == INITIAL_MAX_STREAM_DATA_UNI) { ret parameters.initial_max_stream_data_uni; }
    if (id == INITIAL_MAX_STREAMS_BIDI) { ret parameters.initial_max_streams_bidi; }
    if (id == INITIAL_MAX_STREAMS_UNI) { ret parameters.initial_max_streams_uni; }
    if (id == ACK_DELAY_EXPONENT) { ret parameters.ack_delay_exponent; }
    if (id == MAX_ACK_DELAY) { ret parameters.max_ack_delay; }
    if (id == ACTIVE_CONNECTION_ID_LIMIT) { ret parameters.active_connection_id_limit; }
    if (id == MAX_DATAGRAM_FRAME_SIZE) { ret parameters.max_datagram_frame_size; }
    ret 0;
}

fun is_scalar(id: u64) bool {
    ret id == MAX_IDLE_TIMEOUT || id == MAX_UDP_PAYLOAD_SIZE ||
        (id >= INITIAL_MAX_DATA && id <= MAX_ACK_DELAY && id != DISABLE_ACTIVE_MIGRATION) ||
        id == ACTIVE_CONNECTION_ID_LIMIT || id == MAX_DATAGRAM_FRAME_SIZE;
}

fun all_zero(data: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (data[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun preferred_valid(address: *PreferredAddress) bool {
    if (address == nil || address.connection_id.len == 0 || address.connection_id.len::usize > packet.MAX_CONNECTION_ID) { ret false; }
    val ipv4_zero: bool = all_zero(?address.ipv4[0], 4);
    val ipv6_zero: bool = all_zero(?address.ipv6[0], 16);
    if (ipv4_zero != (address.ipv4_port == 0)) { ret false; }
    if (ipv6_zero != (address.ipv6_port == 0)) { ret false; }
    ret !(ipv4_zero && ipv6_zero);
}

fun parse_known(parameters: *Parameters, id: u64, value: packet.Span) bool {
    if (is_scalar(id)) {
        var decoded: u64 = 0;
        if (!read_scalar(value.data, value.len, ?decoded) || !scalar_valid(id, decoded)) { ret false; }
        assign_scalar(parameters, id, decoded);
        ret true;
    }
    if (id == DISABLE_ACTIVE_MIGRATION) {
        if (value.len != 0) { ret false; }
        parameters.disable_active_migration = true;
        ret true;
    }
    if (id == STATELESS_RESET_TOKEN) {
        if (value.len != 16) { ret false; }
        memory.copy[u8](?parameters.stateless_reset_token[0], value.data, 16);
        ret true;
    }
    if (id == ORIGINAL_DESTINATION_CONNECTION_ID) {
        ret packet.set_connection_id(?parameters.original_destination_connection_id, value.data, value.len);
    }
    if (id == INITIAL_SOURCE_CONNECTION_ID) {
        ret packet.set_connection_id(?parameters.initial_source_connection_id, value.data, value.len);
    }
    if (id == RETRY_SOURCE_CONNECTION_ID) {
        ret packet.set_connection_id(?parameters.retry_source_connection_id, value.data, value.len);
    }
    if (id == PREFERRED_ADDRESS) {
        if (value.len < 41 || value.len > 61) { ret false; }
        val cid_len: usize = value.data[24]::usize;
        if (cid_len == 0 || value.len != 41 + cid_len || cid_len > packet.MAX_CONNECTION_ID) { ret false; }
        memory.copy[u8](?parameters.preferred_address.ipv4[0], value.data, 4);
        parameters.preferred_address.ipv4_port = binary.get_uint(?value.data[4], 2, binary.BIG)::u16;
        memory.copy[u8](?parameters.preferred_address.ipv6[0], ?value.data[6], 16);
        parameters.preferred_address.ipv6_port = binary.get_uint(?value.data[22], 2, binary.BIG)::u16;
        if (!packet.set_connection_id(?parameters.preferred_address.connection_id, ?value.data[25], cid_len)) { ret false; }
        memory.copy[u8](?parameters.preferred_address.stateless_reset_token[0], ?value.data[25 + cid_len], 16);
        ret preferred_valid(?parameters.preferred_address);
    }
    ret false;
}

fun copy_extensions(data: *u8, len: usize, parameters: *Parameters, storage: Storage) bool {
    if (parameters.extension_count == 0) { parameters.extensions = nil; ret true; }
    if (storage.extensions == nil ||
        storage.extension_capacity < parameters.extension_count) { ret false; }
    var d: binary.Decoder = binary.decoder(data, len, binary.BIG);
    var index: usize = 0;
    var byte_offset: usize = 0;
    for (d.pos < d.len) {
        var id: u64 = 0;
        var value_len: u64 = 0;
        if (read_value(?d, ?id) != varint.STATUS_DONE || read_value(?d, ?value_len) != varint.STATUS_DONE || !fits(?d, value_len::usize)) { ret false; }
        if (!known(id)) {
            storage.extensions[index].id = id;
            storage.extensions[index].value.len = value_len::usize;
            if (value_len > 0) {
                if (storage.extension_bytes == nil ||
                    value_len::usize > storage.extension_byte_capacity - byte_offset) {
                    ret false;
                }
                storage.extensions[index].value.data =
                    ?storage.extension_bytes[byte_offset];
                memory.copy[u8](storage.extensions[index].value.data,
                    ?d.data[d.pos], value_len::usize);
                byte_offset = byte_offset + value_len::usize;
            }
            index = index + 1;
        }
        d.pos = d.pos + value_len::usize;
    }
    parameters.extensions = storage.extensions;
    ret index == parameters.extension_count;
}

# decodes a complete tls quic transport-parameter block transactionally
pub fun decode(data: *u8, len: usize, final: bool, peer_role: u8, limits: Limits, storage: Storage, out: *Parameters) DecodeResult {
    if (out == nil || len > limits.max_total_size || limits.max_parameters > MAX_PARAMETERS || (len > 0 && data == nil)) {
        ret failed(ERROR_LIMIT);
    }
    if (!final) { ret missing(false, 1); }
    var cursor: binary.Decoder = binary.decoder(data, len, binary.BIG);
    var parameters: Parameters = defaults();
    var seen: [256]u64;
    var count: usize = 0;
    var extension_bytes: usize = 0;

    for (cursor.pos < cursor.len) {
        if (count >= limits.max_parameters) { ret failed(ERROR_LIMIT); }
        var id: u64 = 0;
        var value_len: u64 = 0;
        if (read_value(?cursor, ?id) != varint.STATUS_DONE) { ret missing(true, 1); }
        var i: usize = 0;
        for (i < count) {
            if (seen[i] == id) { ret failed(ERROR_DUPLICATE); }
            i = i + 1;
        }
        seen[count] = id;
        count = count + 1;
        if (read_value(?cursor, ?value_len) != varint.STATUS_DONE) { ret missing(true, 1); }
        if (value_len > limits.max_extension_size::u64 && !known(id)) { ret failed(ERROR_LIMIT); }
        if (value_len > limits.max_total_size::u64 || !fits(?cursor, value_len::usize)) { ret missing(true, value_len::usize); }
        var value: packet.Span;
        value.len = value_len::usize;
        if (value.len > 0) { value.data = ?cursor.data[cursor.pos]; }
        cursor.pos = cursor.pos + value.len;

        if (known(id)) {
            if (!parse_known(?parameters, id, value) || !set_present(?parameters, id)) { ret failed(ERROR_VALUE); }
        } or {
            parameters.extension_count = parameters.extension_count + 1;
            if (parameters.extension_count > storage.extension_capacity ||
                value.len > storage.extension_byte_capacity - extension_bytes) {
                ret failed(ERROR_LIMIT);
            }
            extension_bytes = extension_bytes + value.len;
        }
    }

    if (!validate_role(?parameters, peer_role)) { ret failed(ERROR_ROLE); }
    if (!copy_extensions(data, len, ?parameters, storage)) { ret failed(ERROR_OUTPUT); }
    @out = parameters;
    ret done(len);
}

fun encode_error(code: u8) EncodeResult {
    var r: EncodeResult;
    r.error = code;
    ret r;
}

fun add(total: *usize, amount: usize, limit: usize) bool {
    if (@total > limit || amount > limit - @total) { ret false; }
    @total = @total + amount;
    ret true;
}

fun add_tlv(total: *usize, id: u64, value_len: usize, limit: usize) bool {
    val id_width: u8 = varint.width(id);
    val len_width: u8 = varint.width(value_len::u64);
    if (id_width == 0 || len_width == 0) { ret false; }
    ret add(total, id_width::usize, limit) && add(total, len_width::usize, limit) && add(total, value_len, limit);
}

fun known_value_len(parameters: *Parameters, id: u64) usize {
    if (is_scalar(id)) { ret varint.width(scalar_value(parameters, id))::usize; }
    if (id == DISABLE_ACTIVE_MIGRATION) { ret 0; }
    if (id == STATELESS_RESET_TOKEN) { ret 16; }
    if (id == ORIGINAL_DESTINATION_CONNECTION_ID) { ret parameters.original_destination_connection_id.len::usize; }
    if (id == INITIAL_SOURCE_CONNECTION_ID) { ret parameters.initial_source_connection_id.len::usize; }
    if (id == RETRY_SOURCE_CONNECTION_ID) { ret parameters.retry_source_connection_id.len::usize; }
    if (id == PREFERRED_ADDRESS) { ret 41 + parameters.preferred_address.connection_id.len::usize; }
    ret 0;
}

pub fun encoded_size(parameters: *Parameters, role: u8, limits: Limits) EncodeResult {
    if (parameters == nil || !validate_role(parameters, role) || parameters.extension_count > limits.max_parameters) {
        ret encode_error(ERROR_ROLE);
    }
    var count: usize = 0;
    var parameter_count: usize = 0;
    var id: u64 = 0;
    for (id <= RETRY_SOURCE_CONNECTION_ID) {
        if (has(parameters, id)) {
            if (is_scalar(id) && !scalar_valid(id, scalar_value(parameters, id))) { ret encode_error(ERROR_VALUE); }
            if (id == PREFERRED_ADDRESS && !preferred_valid(?parameters.preferred_address)) {
                ret encode_error(ERROR_VALUE);
            }
            if (!add_tlv(?count, id, known_value_len(parameters, id), limits.max_total_size)) { ret encode_error(ERROR_LIMIT); }
            parameter_count = parameter_count + 1;
        }
        id = id + 1;
    }
    if (has(parameters, MAX_DATAGRAM_FRAME_SIZE)) {
        if (!scalar_valid(MAX_DATAGRAM_FRAME_SIZE, parameters.max_datagram_frame_size) ||
            !add_tlv(?count, MAX_DATAGRAM_FRAME_SIZE,
                known_value_len(parameters, MAX_DATAGRAM_FRAME_SIZE), limits.max_total_size)) {
            ret encode_error(ERROR_VALUE);
        }
        parameter_count = parameter_count + 1;
    }
    if (parameters.extension_count > 0 && parameters.extensions == nil) { ret encode_error(ERROR_OUTPUT); }
    var i: usize = 0;
    for (i < parameters.extension_count) {
        val extension: Parameter = parameters.extensions[i];
        if (known(extension.id) || extension.id > varint.MAX ||
            extension.value.len > limits.max_extension_size || (extension.value.len > 0 && extension.value.data == nil)) {
            ret encode_error(ERROR_VALUE);
        }
        var j: usize = 0;
        for (j < i) {
            if (parameters.extensions[j].id == extension.id) { ret encode_error(ERROR_DUPLICATE); }
            j = j + 1;
        }
        if (!add_tlv(?count, extension.id, extension.value.len, limits.max_total_size)) { ret encode_error(ERROR_LIMIT); }
        parameter_count = parameter_count + 1;
        i = i + 1;
    }
    if (parameter_count > limits.max_parameters || parameter_count > MAX_PARAMETERS) { ret encode_error(ERROR_LIMIT); }
    var r: EncodeResult;
    r.ok = true;
    r.count = count;
    ret r;
}

fun write_v(b: *binary.Builder, value: u64) bool {
    ret is_ok_usize_u8(varint.write(b, value, 0));
}

fun write_bytes(b: *binary.Builder, data: *u8, len: usize) bool {
    ret is_ok_usize_encode(binary.builder_write_bytes(b, data, len));
}

fun write_header(b: *binary.Builder, id: u64, value_len: usize) bool {
    ret write_v(b, id) && write_v(b, value_len::u64);
}

fun write_known(b: *binary.Builder, parameters: *Parameters, id: u64) bool {
    val value_len: usize = known_value_len(parameters, id);
    if (!write_header(b, id, value_len)) { ret false; }
    if (is_scalar(id)) { ret write_v(b, scalar_value(parameters, id)); }
    if (id == DISABLE_ACTIVE_MIGRATION) { ret true; }
    if (id == STATELESS_RESET_TOKEN) { ret write_bytes(b, ?parameters.stateless_reset_token[0], 16); }
    if (id == ORIGINAL_DESTINATION_CONNECTION_ID) { ret write_bytes(b, ?parameters.original_destination_connection_id.data[0], parameters.original_destination_connection_id.len::usize); }
    if (id == INITIAL_SOURCE_CONNECTION_ID) { ret write_bytes(b, ?parameters.initial_source_connection_id.data[0], parameters.initial_source_connection_id.len::usize); }
    if (id == RETRY_SOURCE_CONNECTION_ID) { ret write_bytes(b, ?parameters.retry_source_connection_id.data[0], parameters.retry_source_connection_id.len::usize); }
    if (id == PREFERRED_ADDRESS) {
        ret write_bytes(b, ?parameters.preferred_address.ipv4[0], 4) &&
            is_ok_usize_encode(binary.builder_write_u16(b, parameters.preferred_address.ipv4_port)) &&
            write_bytes(b, ?parameters.preferred_address.ipv6[0], 16) &&
            is_ok_usize_encode(binary.builder_write_u16(b, parameters.preferred_address.ipv6_port)) &&
            is_ok_usize_encode(binary.builder_write_u8(b, parameters.preferred_address.connection_id.len)) &&
            write_bytes(b, ?parameters.preferred_address.connection_id.data[0], parameters.preferred_address.connection_id.len::usize) &&
            write_bytes(b, ?parameters.preferred_address.stateless_reset_token[0], 16);
    }
    ret false;
}

# encodes a complete parameter block as one builder transaction
pub fun encode(b: *binary.Builder, parameters: *Parameters, role: u8, limits: Limits) EncodeResult {
    if (b == nil || b.order != binary.BIG) { ret encode_error(ERROR_OUTPUT); }
    val measured: EncodeResult = encoded_size(parameters, role, limits);
    if (!measured.ok) { ret measured; }
    val reserved: res[binary.Reservation, binary.EncodeError] = binary.builder_reserve(b, measured.count);
    if (sel reserved.err) { ret encode_error(ERROR_OUTPUT); }
    var reservation: binary.Reservation = reserved.ok;
    val body: *binary.Builder = ?reservation.body;
    var ok: bool = true;
    var id: u64 = 0;
    for (ok && id <= RETRY_SOURCE_CONNECTION_ID) {
        if (has(parameters, id)) { ok = write_known(body, parameters, id); }
        id = id + 1;
    }
    if (ok && has(parameters, MAX_DATAGRAM_FRAME_SIZE)) {
        ok = write_known(body, parameters, MAX_DATAGRAM_FRAME_SIZE);
    }
    var i: usize = 0;
    for (ok && i < parameters.extension_count) {
        val extension: Parameter = parameters.extensions[i];
        ok = write_header(body, extension.id, extension.value.len) && write_bytes(body, extension.value.data, extension.value.len);
        i = i + 1;
    }
    if (!ok || body.len != measured.count) {
        binary.reservation_rollback(?reservation);
        ret encode_error(ERROR_OUTPUT);
    }
    if (is_err_usize_encode(binary.builder_commit(?reservation))) { ret encode_error(ERROR_OUTPUT); }
    ret measured;
}

test "quic.transport_parameters: client parameters and unknown extensions round trip" {
    var cid: [4]u8 = [4]u8{1, 2, 3, 4};
    var extension_data: [3]u8 = [3]u8{5, 6, 7};
    var extensions: [1]Parameter;
    extensions[0].id = 0x173e;
    extensions[0].value.data = ?extension_data[0];
    extensions[0].value.len = 3;
    var parameters: Parameters = defaults();
    if (!set_present(?parameters, INITIAL_SOURCE_CONNECTION_ID) ||
        !packet.set_connection_id(?parameters.initial_source_connection_id, ?cid[0], 4) ||
        !set_present(?parameters, MAX_IDLE_TIMEOUT) ||
        !set_present(?parameters, MAX_DATAGRAM_FRAME_SIZE)) { ret 1; }
    parameters.max_idle_timeout = 30;
    parameters.max_datagram_frame_size = 1200;
    parameters.extensions = ?extensions[0];
    parameters.extension_count = 1;
    var bytes: [256]u8;
    var b: binary.Builder = binary.builder(?bytes[0], 256, binary.BIG);
    if (!encode(?b, ?parameters, ROLE_CLIENT, default_limits()).ok) { ret 1; }

    var decoded_extensions: [1]Parameter;
    var decoded_extension_bytes: [3]u8;
    var storage: Storage;
    storage.extensions = ?decoded_extensions[0];
    storage.extension_capacity = 1;
    storage.extension_bytes = ?decoded_extension_bytes[0];
    storage.extension_byte_capacity = 3;
    var out: Parameters;
    out.max_idle_timeout = 99;
    var prefix: usize = 0;
    for (prefix < b.len) {
        val r: DecodeResult = decode(?bytes[0], prefix, false, ROLE_CLIENT, default_limits(), storage, ?out);
        if (r.status != STATUS_MORE || out.max_idle_timeout != 99) { ret 1; }
        prefix = prefix + 1;
    }
    val decoded: DecodeResult = decode(?bytes[0], b.len, true, ROLE_CLIENT, default_limits(), storage, ?out);
    if (decoded.status != STATUS_DONE || out.max_idle_timeout != 30 ||
        out.max_datagram_frame_size != 1200 || !has(?out, MAX_DATAGRAM_FRAME_SIZE) || out.extension_count != 1) { ret 1; }
    bytes[b.len - 1] = 0xff;
    if (out.extensions[0].id != 0x173e || out.extensions[0].value.len != 3 ||
        out.extensions[0].value.data != ?decoded_extension_bytes[0] ||
        out.extensions[0].value.data[0] != 5 ||
        out.extensions[0].value.data[2] != 7) { ret 1; }
    ret 0;
}

test "quic.transport_parameters: server preferred address round trips" {
    var cid: [4]u8 = [4]u8{8, 7, 6, 5};
    var parameters: Parameters = defaults();
    set_present(?parameters, INITIAL_SOURCE_CONNECTION_ID);
    set_present(?parameters, ORIGINAL_DESTINATION_CONNECTION_ID);
    set_present(?parameters, PREFERRED_ADDRESS);
    packet.set_connection_id(?parameters.initial_source_connection_id, ?cid[0], 4);
    packet.set_connection_id(?parameters.original_destination_connection_id, ?cid[0], 4);
    packet.set_connection_id(?parameters.preferred_address.connection_id, ?cid[0], 4);
    parameters.preferred_address.ipv4[0] = 127;
    parameters.preferred_address.ipv4[3] = 1;
    parameters.preferred_address.ipv4_port = 443;
    parameters.preferred_address.ipv6[15] = 1;
    parameters.preferred_address.ipv6_port = 8443;
    var bytes: [256]u8;
    var b: binary.Builder = binary.builder(?bytes[0], 256, binary.BIG);
    if (!encode(?b, ?parameters, ROLE_SERVER, default_limits()).ok) { ret 1; }
    var storage: Storage;
    var out: Parameters;
    if (decode(?bytes[0], b.len, true, ROLE_SERVER, default_limits(), storage, ?out).status != STATUS_DONE) { ret 1; }
    if (out.preferred_address.ipv4_port != 443 || out.preferred_address.connection_id.len != 4) { ret 1; }
    ret 0;
}

test "quic.transport_parameters: duplicate, role, value, and truncation failures are transactional" {
    val duplicate: [6]u8 = [6]u8{0x0f, 0, 0x0f, 0, 0x01, 0};
    var storage: Storage;
    var out: Parameters;
    out.max_idle_timeout = 77;
    val r: DecodeResult = decode(?duplicate[0], 6, true, ROLE_CLIENT, default_limits(), storage, ?out);
    if (r.error != ERROR_DUPLICATE || out.max_idle_timeout != 77) { ret 1; }
    val bad_udp: [5]u8 = [5]u8{0x0f, 0, 0x03, 1, 1};
    if (decode(?bad_udp[0], 5, true, ROLE_CLIENT, default_limits(), storage, ?out).error != ERROR_VALUE || out.max_idle_timeout != 77) { ret 1; }
    val truncated: [3]u8 = [3]u8{0x0f, 2, 1};
    if (decode(?truncated[0], 3, true, ROLE_CLIENT, default_limits(), storage, ?out).error != ERROR_TRUNCATED || out.max_idle_timeout != 77) { ret 1; }
    val nonminimal: [4]u8 = [4]u8{0x40, 0x0f, 0x40, 0};
    if (decode(?nonminimal[0], 4, true, ROLE_CLIENT, default_limits(), storage, ?out).status != STATUS_DONE) { ret 1; }
    val streams_overflow: [12]u8 = [12]u8{0x0f, 0, 0x08, 8, 0xd0, 0, 0, 0, 0, 0, 0, 1};
    out.max_idle_timeout = 88;
    if (decode(?streams_overflow[0], 12, true, ROLE_CLIENT, default_limits(), storage, ?out).error != ERROR_VALUE || out.max_idle_timeout != 88) { ret 1; }
    val datagram_duplicate: [8]u8 = [8]u8{0x40, 0x20, 1, 1, 0x40, 0x20, 1, 2};
    if (decode(?datagram_duplicate[0], 8, true, ROLE_CLIENT, default_limits(), storage, ?out).error != ERROR_DUPLICATE ||
        out.max_idle_timeout != 88) { ret 1; }
    ret 0;
}

test "quic.transport_parameters: fixed-buffer failure publishes nothing" {
    var parameters: Parameters = defaults();
    set_present(?parameters, INITIAL_SOURCE_CONNECTION_ID);
    var byte: [1]u8;
    var b: binary.Builder = binary.builder(?byte[0], 1, binary.BIG);
    if (encode(?b, ?parameters, ROLE_CLIENT, default_limits()).ok || b.len != 0) { ret 1; }
    ret 0;
}
