use quic.path.path;

use std.memory;

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

fun initialize_manager(config: path.Config, storage: path.Storage,
    initial: path.Endpoint) path.Manager {
    var manager: path.Manager;
    path.initialize(?manager, config, storage, initial);
    ret manager;
}

fun config(source: u64, role: u8, validated: bool) path.Config {
    var result: path.Config;
    result.source                      = source;
    result.role                        = role;
    result.allow_peer_active_migration = true;
    result.retain_port_rebinding_state = true;
    result.initial_address_validated   = validated;
    result.base_mtu                    = 1200;
    result.maximum_mtu                 = 1600;
    result.mtu_probe_step              = 200;
    result.validation_timeout_factor   = 3;
    result.mtu_probe_attempts          = 3;
    result.black_hole_threshold        = 3;
    ret result;
}

fun endpoint(local_host: u8, local_port: u16, peer_host: u8, peer_port: u16) path.Endpoint {
    var result: path.Endpoint;
    result.local = path.ipv4(192, 0, 2, local_host, local_port);
    result.peer  = path.ipv4(198, 51, 100, peer_host, peer_port);
    ret result;
}

fun challenge(seed: u8) [8]u8 {
    ret [8]u8{seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7};
}

test path__address_identity_includes_ports_family_and_ipv6_scope {
    val first:  path.Address = path.ipv4(192, 0, 2, 1, 4433);
    val second: path.Address = path.ipv4(192, 0, 2, 1, 4434);
    if (path.address_equal(first, second) || !path.same_address_without_port(first, second)) { ret 1; }
    var bytes: [16]u8;
    bytes[0]  = 0x20;
    bytes[1]  = 0x01;
    bytes[15] = 1;
    val scoped:      path.Address = path.ipv6(bytes, 4433, 7);
    val other_scope: path.Address = path.ipv6(bytes, 4433, 8);
    if (path.address_equal(scoped, other_scope) || path.same_address_without_port(scoped, other_scope)) {
        ret 1;
    }
    ret 0;
}

test path__unauthenticated_duplicate_and_pre_handshake_peer_changes_publish_nothing {
    var paths:      [3]path.Path;
    var challenges: [4]path.Challenge;
    var responses:  [4]path.Response;
    var sends:      [4]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 3,
        challenges: ?challenges[0], challenge_capacity: 4,
        responses:  ?responses[0], response_capacity: 4,
        sends:      ?sends[0], send_capacity: 4};
    val original: path.Endpoint = endpoint(1, 4433, 1, 55000);
    val changed:  path.Endpoint = endpoint(1, 4433, 1, 55001);
    var manager:  path.Manager  = initialize_manager(config(101, path.ROLE_SERVER, true), storage, original);
    if (path.observe(?manager, changed, 1, 100, true, false, true, true, 1).status != path.STATUS_DROPPED ||
        path.observe(?manager, changed, 1, 100, true, true, false, true, 1).status != path.STATUS_DROPPED ||
        path.observe(?manager, changed, 1, 100, true, true, true, true, 1).status != path.STATUS_DROPPED ||
        path.find(?manager, changed).status != path.STATUS_EMPTY || paths[0].received_bytes != 0) { ret 1; }
    if (path.confirm_handshake(?manager).status != path.STATUS_OK) { ret 1; }
    if (path.observe(?manager, original, 1, 100, true, true, true, true, 2).status != path.STATUS_OK ||
        path.observe(?manager, original, 1, 100, true, true, false, true, 3).status != path.STATUS_DROPPED ||
        paths[0].received_bytes != 100) { ret 1; }
    ret 0;
}

test path__nat_rebinding_selects_preserves_policy_state_and_enforces_amplification {
    var paths:      [4]path.Path;
    var challenges: [8]path.Challenge;
    var responses:  [4]path.Response;
    var sends:      [4]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 4,
        challenges: ?challenges[0], challenge_capacity: 8,
        responses:  ?responses[0], response_capacity: 4,
        sends:      ?sends[0], send_capacity: 4};
    val original: path.Endpoint = endpoint(1, 4433, 1, 55000);
    val rebound:  path.Endpoint = endpoint(1, 4433, 1, 55001);
    var manager:  path.Manager  = initialize_manager(config(102, path.ROLE_SERVER, true), storage, original);
    path.confirm_handshake(?manager);
    val moved: path.Observation = path.observe(?manager, rebound, 10, 400,
        true, true, true, true, 10);
    if (moved.status != path.STATUS_OK || !moved.created || !moved.selected ||
        moved.migration != path.MIGRATION_REBINDING || !moved.needs_validation ||
        moved.reset_congestion || moved.reset_rtt || !moved.reset_ecn ||
        moved.rotate_connection_id || !moved.validate_previous) { ret 1; }
    var current: path.Snapshot = path.snapshot(?manager, moved.handle);
    if (!current.port_rebinding || current.amplification_allowance != 1200 || current.address_validated) {
        ret 1;
    }
    val data:             [8]u8                = challenge(10);
    val queued_challenge: path.OperationResult = path.queue_challenge(?manager, moved.handle, data,
        100, 80, true, path.VALIDATION_PATH);
    if (queued_challenge.status != path.STATUS_OK) { ret 1; }
    val duplicate_challenge: path.OperationResult = path.queue_challenge(?manager, moved.handle, data,
        100, 80, true, path.VALIDATION_PATH);
    if (duplicate_challenge.error != path.ERROR_DUPLICATE) { ret 1; }
    val prepared: path.PreparedChallenge = path.prepare_challenge(?manager, moved.handle);
    val reserved: path.SendResult        = path.reserve_send(?manager, moved.handle, 1200, true);
    if (prepared.status != path.STATUS_OK || prepared.minimum_datagram_size != 1200 ||
        prepared.maximum_datagram_size != 1200 || reserved.status != path.STATUS_OK ||
        path.publish_send(?manager, reserved.token).status != path.STATUS_OK ||
        path.publish_challenge(?manager, prepared.token, 20).status != path.STATUS_OK ||
        path.reserve_send(?manager, moved.handle, 1, true).status != path.STATUS_BLOCKED ||
        path.receive_response(?manager, challenge(30), 30).status != path.STATUS_DROPPED) { ret 1; }
    val validated: path.ValidationResult = path.receive_response(?manager, data, 30);
    current = path.snapshot(?manager, moved.handle);
    if (validated.status != path.STATUS_OK || !validated.selected ||
        validated.reset_congestion || validated.reset_rtt || validated.reset_ecn ||
        !current.address_validated || !current.mtu_validated ||
        current.amplification_allowance != 0 - 1::u64) { ret 1; }
    # an unpadded challenge goes out small where the limit forbids 1200, and
    # its response then validates the address but not the mtu
    val narrow: path.Observation = path.observe(?manager, endpoint(1, 4433, 1, 55002), 11, 100,
        true, true, true, true, 40);
    if (narrow.status != path.STATUS_OK || !narrow.needs_validation || !narrow.validate_previous ||
        path.queue_challenge(?manager, narrow.handle, challenge(40), 100, 80, false,
        path.VALIDATION_PATH).status != path.STATUS_OK) { ret 2; }
    val small: path.PreparedChallenge = path.prepare_challenge(?manager, narrow.handle);
    if (small.status != path.STATUS_OK || small.minimum_datagram_size != 0 ||
        small.maximum_datagram_size != 300 ||
        path.publish_challenge(?manager, small.token, 41).status != path.STATUS_OK ||
        path.receive_response(?manager, challenge(40), 42).status != path.STATUS_OK) { ret 2; }
    current = path.snapshot(?manager, narrow.handle);
    if (!current.address_validated || current.mtu_validated) { ret 2; }
    # where the limit allows 1200 the same unpadded challenge is padded
    val wide: path.Observation = path.observe(?manager, endpoint(1, 4433, 1, 55003), 12, 400,
        true, true, true, true, 50);
    if (wide.status != path.STATUS_OK || !wide.needs_validation ||
        path.queue_challenge(?manager, wide.handle, challenge(50), 100, 80, false,
        path.VALIDATION_PATH).status != path.STATUS_OK) { ret 3; }
    val full: path.PreparedChallenge = path.prepare_challenge(?manager, wide.handle);
    if (full.status != path.STATUS_OK || full.minimum_datagram_size != 1200 ||
        path.publish_challenge(?manager, full.token, 51).status != path.STATUS_OK ||
        path.receive_response(?manager, challenge(50), 52).status != path.STATUS_OK) { ret 3; }
    current = path.snapshot(?manager, wide.handle);
    if (!current.address_validated || !current.mtu_validated) { ret 3; }
    ret 0;
}

test path__disabled_migration_still_permits_rebinding_and_preferred_addresses {
    var paths:      [5]path.Path;
    var challenges: [6]path.Challenge;
    var responses:  [4]path.Response;
    var sends:      [4]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 5,
        challenges: ?challenges[0], challenge_capacity: 6,
        responses:  ?responses[0], response_capacity: 4,
        sends:      ?sends[0], send_capacity: 4};
    val original:      path.Endpoint = endpoint(1, 4433, 1, 55000);
    var server_config: path.Config   = config(103, path.ROLE_SERVER, true);
    server_config.allow_peer_active_migration = false;
    var server: path.Manager = initialize_manager(server_config, storage, original);
    path.confirm_handshake(?server);
    val changed_ip: path.Endpoint    = endpoint(1, 4433, 2, 55000);
    val rejected:   path.Observation = path.observe(?server, changed_ip, 1, 400,
        true, true, true, true, 1);
    if (rejected.status != path.STATUS_DROPPED || !rejected.created || !rejected.needs_validation ||
        path.selected(?server).handle.index != 0) { ret 1; }

    var client_paths:      [4]path.Path;
    var client_challenges: [4]path.Challenge;
    var client_responses:  [2]path.Response;
    var client_sends:      [2]path.SendReservation;
    val client_storage:    path.Storage = path.Storage{paths: ?client_paths[0], path_capacity: 4,
        challenges: ?client_challenges[0], challenge_capacity: 4,
        responses:  ?client_responses[0], response_capacity: 2,
        sends:      ?client_sends[0], send_capacity: 2};
    var client_config: path.Config = config(104, path.ROLE_CLIENT, true);
    client_config.peer_disabled_active_migration = true;
    var client: path.Manager = initialize_manager(client_config, client_storage, original);
    path.confirm_handshake(?client);
    val original_handle: path.Handle = path.selected(?client).handle;
    if (path.configure_transport(?client, original_handle, 333000000,
        0).status != path.STATUS_OK) { ret 1; }
    val alternate: path.Endpoint = endpoint(2, 4434, 1, 55000);
    if (path.probe(?client, alternate, false).error != path.ERROR_MIGRATION_DISABLED) { ret 1; }
    val preferred: path.PathResult = path.probe(?client, alternate, true);
    val data:      [8]u8           = challenge(40);
    if (preferred.status != path.STATUS_OK ||
        path.configure_transport(?client, preferred.handle, 333000000,
        0).status != path.STATUS_OK) { ret 1; }
    client_paths[original_handle.index].congestion.congestion_window = 5000;
    val queued: path.OperationResult = path.queue_challenge(?client, preferred.handle, data,
        100, 100, true, path.VALIDATION_PATH);
    if (queued.status != path.STATUS_OK) { ret 1; }
    val prepared: path.PreparedChallenge = path.prepare_challenge(?client, preferred.handle);
    path.publish_challenge(?client, prepared.token, 1);
    if (!path.receive_response(?client, data, 2).ready_to_migrate) { ret 1; }
    val no_connection_id: path.Observation = path.migrate(?client, preferred.handle, true, false);
    if (no_connection_id.status != path.STATUS_BLOCKED || !no_connection_id.rotate_connection_id ||
        path.selected(?client).handle.index != 0) { ret 1; }
    val migrated: path.Observation = path.migrate(?client, preferred.handle, true, true);
    if (!migrated.selected || migrated.migration != path.MIGRATION_PREFERRED ||
        !migrated.reset_congestion || !migrated.reset_rtt || !migrated.reset_ecn ||
        !migrated.rotate_connection_id ||
        client_paths[preferred.handle.index].congestion.congestion_window == 5000 ||
        path.retain_recovery(?client, migrated.previous).status != path.STATUS_OK ||
        path.release(?client, migrated.previous).status != path.STATUS_BLOCKED ||
        path.release_recovery(?client, migrated.previous).status != path.STATUS_OK ||
        path.release(?client, migrated.previous).status != path.STATUS_OK) {
        ret 1;
    }
    ret 0;
}

test path__packet_number_ordering_prevents_migration_rollback {
    var paths:      [4]path.Path;
    var challenges: [4]path.Challenge;
    var responses:  [4]path.Response;
    var sends:      [4]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 4,
        challenges: ?challenges[0], challenge_capacity: 4,
        responses:  ?responses[0], response_capacity: 4,
        sends:      ?sends[0], send_capacity: 4};
    val original:          path.Endpoint = endpoint(1, 4433, 1, 55000);
    val migrated_endpoint: path.Endpoint = endpoint(1, 4433, 2, 55000);
    var manager:           path.Manager  = initialize_manager(config(105, path.ROLE_SERVER, true), storage, original);
    path.confirm_handshake(?manager);
    path.observe(?manager, original, 100, 100, true, true, true, true, 1);
    val old_handle:       path.Handle      = path.selected(?manager).handle;
    val queued_old:       path.SendResult  = path.reserve_send(?manager, old_handle, 100, true);
    val no_connection_id: path.Observation = path.observe(?manager, migrated_endpoint, 101, 100,
        true, true, true, false, 2);
    if (no_connection_id.status != path.STATUS_BLOCKED || !no_connection_id.created ||
        !no_connection_id.rotate_connection_id || no_connection_id.selected) { ret 1; }
    val migrated: path.Observation = path.observe(?manager, migrated_endpoint, 102, 100,
        true, true, true, true, 3);
    if (!migrated.selected || migrated.migration != path.MIGRATION_PEER) { ret 1; }
    val completed_send: path.OperationResult = path.publish_send(?manager, queued_old.token);
    if (completed_send.status != path.STATUS_OK ||
        path.snapshot(?manager, old_handle).reserved_bytes != 0 ||
        path.snapshot(?manager, old_handle).sent_bytes != 100) {
        ret 1;
    }
    val reordered: path.Observation = path.observe(?manager, original, 99, 100,
        true, true, true, true, 4);
    if (reordered.selected || path.selected(?manager).handle.index != migrated.handle.index) { ret 1; }
    val returned: path.Observation = path.observe(?manager, original, 103, 100,
        true, true, true, true, 5);
    if (!returned.selected || returned.handle.index != 0 ||
        path.selected(?manager).handle.index != 0 || !returned.reset_congestion || !returned.reset_rtt) {
        ret 1;
    }
    ret 0;
}

test path__challenge_and_response_ownership_rejects_stale_generations {
    var paths:      [3]path.Path;
    var challenges: [1]path.Challenge;
    var responses:  [1]path.Response;
    var sends:      [1]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 3,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses:  ?responses[0], response_capacity: 1,
        sends:      ?sends[0], send_capacity: 1};
    val original: path.Endpoint = endpoint(1, 4433, 1, 55000);
    var manager:  path.Manager  = initialize_manager(config(106, path.ROLE_CLIENT, true), storage, original);
    path.confirm_handshake(?manager);
    val handle:       path.Handle          = path.selected(?manager).handle;
    val first_queued: path.OperationResult = path.queue_response(?manager, handle, challenge(1));
    if (first_queued.status != path.STATUS_OK) { ret 1; }
    val first_response: path.PreparedResponse = path.prepare_response(?manager, handle);
    if (path.publish_response(?manager, first_response.token).status != path.STATUS_OK ||
        path.queue_response(?manager, handle, challenge(2)).status != path.STATUS_OK) { ret 1; }
    val second_response: path.PreparedResponse = path.prepare_response(?manager, handle);
    if (second_response.token.generation == first_response.token.generation ||
        path.publish_response(?manager, first_response.token).status != path.STATUS_STALE ||
        path.cancel_response(?manager, second_response.token).status != path.STATUS_OK) { ret 1; }

    val first_data:  [8]u8 = challenge(10);
    val second_data: [8]u8 = challenge(30);
    path.queue_challenge(?manager, handle, first_data, 100, 100, true, path.VALIDATION_PATH);
    val first_challenge: path.PreparedChallenge = path.prepare_challenge(?manager, handle);
    path.publish_challenge(?manager, first_challenge.token, 1);
    path.receive_response(?manager, first_data, 2);
    path.queue_challenge(?manager, handle, second_data, 100, 100, true, path.VALIDATION_PATH);
    val second_challenge: path.PreparedChallenge = path.prepare_challenge(?manager, handle);
    if (second_challenge.token.generation == first_challenge.token.generation)                  { ret 1; }
    if (path.publish_challenge(?manager, first_challenge.token, 4).status != path.STATUS_STALE) { ret 1; }
    if (path.cancel_challenge(?manager, second_challenge.token).status != path.STATUS_OK)       { ret 1; }
    ret 0;
}

test path__path_response_queuing_is_exact_and_amplification_aware {
    var paths:      [2]path.Path;
    var challenges: [2]path.Challenge;
    var responses:  [2]path.Response;
    var sends:      [2]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 2,
        challenges: ?challenges[0], challenge_capacity: 2,
        responses:  ?responses[0], response_capacity: 2,
        sends:      ?sends[0], send_capacity: 2};
    val initial:      path.Endpoint        = endpoint(1, 4433, 1, 55000);
    var manager:      path.Manager         = initialize_manager(config(107, path.ROLE_SERVER, false), storage, initial);
    val handle:       path.Handle          = path.selected(?manager).handle;
    val data:         [8]u8                = challenge(5);
    val first_queued: path.OperationResult = path.queue_response(?manager, handle, data);
    if (first_queued.status != path.STATUS_OK)                                    { ret 1; }
    if (path.queue_response(?manager, handle, data).status != path.STATUS_OK)     { ret 1; }
    if (path.queue_response(?manager, handle, data).error != path.ERROR_CAPACITY) { ret 1; }
    if (path.prepare_response(?manager, handle).status != path.STATUS_BLOCKED)    { ret 1; }
    path.confirm_handshake(?manager);
    path.observe(?manager, initial, 1, 4, false, true, true, true, 1);
    val first: path.PreparedResponse = path.prepare_response(?manager, handle);
    if (first.status != path.STATUS_OK || first.minimum_datagram_size != 0 ||
        first.maximum_datagram_size != 12 || path.publish_response(?manager, first.token).status != path.STATUS_OK) {
        ret 1;
    }
    path.observe(?manager, initial, 2, 396, false, true, true, true, 2);
    val second: path.PreparedResponse = path.prepare_response(?manager, handle);
    if (second.status != path.STATUS_OK || second.minimum_datagram_size != 1200 ||
        second.maximum_datagram_size != 1200) { ret 1; }
    if (path.cancel_response(?manager, second.token).status != path.STATUS_OK ||
        path.prepare_response(?manager, handle).status != path.STATUS_OK) { ret 1; }
    ret 0;
}

test path__validation_timeout_reverts_and_preserves_prepared_token_ownership {
    var paths:      [4]path.Path;
    var challenges: [3]path.Challenge;
    var responses:  [2]path.Response;
    var sends:      [2]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 4,
        challenges: ?challenges[0], challenge_capacity: 3,
        responses:  ?responses[0], response_capacity: 2,
        sends:      ?sends[0], send_capacity: 2};
    val original:  path.Endpoint = endpoint(1, 4433, 1, 55000);
    val alternate: path.Endpoint = endpoint(1, 4433, 2, 55000);
    var manager:   path.Manager  = initialize_manager(config(108, path.ROLE_SERVER, true), storage, original);
    path.confirm_handshake(?manager);
    val moved: path.Observation = path.observe(?manager, alternate, 10, 400,
        true, true, true, true, 0);
    val sent_data:     [8]u8 = challenge(10);
    val prepared_data: [8]u8 = challenge(30);
    path.queue_challenge(?manager, moved.handle, sent_data, 100, 80, true, path.VALIDATION_PATH);
    val sent: path.PreparedChallenge = path.prepare_challenge(?manager, moved.handle);
    path.publish_challenge(?manager, sent.token, 1);
    path.queue_challenge(?manager, moved.handle, prepared_data, 100, 80, true, path.VALIDATION_PATH);
    val prepared:  path.PreparedChallenge = path.prepare_challenge(?manager, moved.handle);
    val timed_out: path.TimeoutResult     = path.on_timeout(?manager, 301);
    if (!timed_out.reverted || timed_out.migration != path.MIGRATION_REVERTED ||
        timed_out.selected.index != 0 || !timed_out.reset_congestion || !timed_out.reset_rtt ||
        !timed_out.reset_ecn || !timed_out.rotate_connection_id || timed_out.connection_lost ||
        path.receive_response(?manager, sent_data, 302).status != path.STATUS_DROPPED ||
        path.snapshot(?manager, moved.handle).state != path.PATH_FAILED) { ret 1; }
    if (path.cancel_challenge(?manager, prepared.token).status != path.STATUS_STALE ||
        path.release(?manager, moved.handle).status != path.STATUS_OK) { ret 1; }
    val reused: path.Observation = path.observe(?manager, endpoint(1, 4433, 3, 55000), 11, 100,
        false, true, true, true, 303);
    if (!reused.created || reused.handle.index != moved.handle.index ||
        reused.handle.generation == moved.handle.generation ||
        path.snapshot(?manager, moved.handle).status != path.STATUS_ERROR) { ret 1; }
    ret 0;
}

test path__mtu_only_validation_timeout_does_not_invalidate_an_address {
    var paths:      [2]path.Path;
    var challenges: [2]path.Challenge;
    var responses:  [1]path.Response;
    var sends:      [1]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 2,
        challenges: ?challenges[0], challenge_capacity: 2,
        responses:  ?responses[0], response_capacity: 1,
        sends:      ?sends[0], send_capacity: 1};
    val initial: path.Endpoint = endpoint(1, 4433, 1, 55000);
    var manager: path.Manager  = initialize_manager(config(109, path.ROLE_CLIENT, true), storage, initial);
    val handle:  path.Handle   = path.selected(?manager).handle;
    paths[0].mtu_validated = false;
    val data: [8]u8 = challenge(50);
    path.queue_challenge(?manager, handle, data, 100, 100, true, path.VALIDATION_MTU);
    val prepared: path.PreparedChallenge = path.prepare_challenge(?manager, handle);
    path.publish_challenge(?manager, prepared.token, 20);
    val timeout: path.TimeoutResult = path.on_timeout(?manager, 320);
    val state:   path.Snapshot      = path.snapshot(?manager, handle);
    if (!timeout.mtu_validation_failed || timeout.reverted || state.state != path.PATH_VALIDATED ||
        !state.address_validated || state.mtu_validated ||
        path.receive_response(?manager, data, 321).status != path.STATUS_DROPPED) { ret 1; }
    ret 0;
}

test path__send_reservations_cannot_overspend_or_alias_a_reused_slot {
    var paths:      [2]path.Path;
    var challenges: [1]path.Challenge;
    var responses:  [1]path.Response;
    var sends:      [2]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 2,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses:  ?responses[0], response_capacity: 1,
        sends:      ?sends[0], send_capacity: 2};
    val initial: path.Endpoint = endpoint(1, 4433, 1, 55000);
    var manager: path.Manager  = initialize_manager(config(110, path.ROLE_SERVER, false), storage, initial);
    path.confirm_handshake(?manager);
    val handle: path.Handle = path.selected(?manager).handle;
    path.observe(?manager, initial, 1, 800, false, true, true, true, 1);
    val cancelled: path.SendResult = path.reserve_send(?manager, handle, 1200, true);
    if (path.cancel_send(?manager, cancelled.token).status != path.STATUS_OK) { ret 1; }
    val published: path.SendResult = path.reserve_send(?manager, handle, 1200, true);
    if (published.token.generation == cancelled.token.generation ||
        path.publish_send(?manager, cancelled.token).status != path.STATUS_STALE ||
        path.publish_send(?manager, published.token).status != path.STATUS_OK) { ret 1; }
    val first:  path.SendResult = path.reserve_send(?manager, handle, 600, true);
    val second: path.SendResult = path.reserve_send(?manager, handle, 600, true);
    if (first.status != path.STATUS_OK || second.status != path.STATUS_OK ||
        path.reserve_send(?manager, handle, 1, true).status != path.STATUS_BLOCKED ||
        path.cancel_send(?manager, first.token).status != path.STATUS_OK ||
        path.publish_send(?manager, second.token).status != path.STATUS_OK ||
        path.snapshot(?manager, handle).sent_bytes != 1800) { ret 1; }
    val overflow: path.SendResult = path.reserve_send(?manager, handle, 1, true);
    paths[0].sent_bytes = 0 - 1::u64;
    if (overflow.status != path.STATUS_OK || path.publish_send(?manager, overflow.token).error != path.ERROR_OVERFLOW ||
        paths[0].sent_bytes != 0 - 1::u64 || paths[0].reserved_bytes != 1 ||
        path.cancel_send(?manager, overflow.token).status != path.STATUS_OK) { ret 1; }
    ret 0;
}

test path__dplpmtud_retries_black_hole_fallback_and_ptb_hints_are_bounded {
    var paths:      [2]path.Path;
    var challenges: [1]path.Challenge;
    var responses:  [1]path.Response;
    var sends:      [2]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 2,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses:  ?responses[0], response_capacity: 1,
        sends:      ?sends[0], send_capacity: 2};
    val initial: path.Endpoint    = endpoint(1, 4433, 1, 55000);
    var manager: path.Manager     = initialize_manager(config(111, path.ROLE_CLIENT, true), storage, initial);
    val handle:  path.Handle      = path.selected(?manager).handle;
    var probe:   path.MtuPrepared = path.prepare_mtu_probe(?manager, handle);
    if (probe.status != path.STATUS_OK || probe.size != 1400 ||
        path.reserve_mtu_send(?manager, handle, 1401, true, probe.token).error != path.ERROR_TOKEN ||
        path.publish_mtu_probe(?manager, probe.token).error != path.ERROR_TOKEN ||
        path.cancel_mtu_probe(?manager, probe.token).status != path.STATUS_OK) { ret 1; }
    probe = path.prepare_mtu_probe(?manager, handle);
    val first_datagram: path.SendResult = path.reserve_mtu_send(?manager, handle, 1400, true, probe.token);
    if (first_datagram.status != path.STATUS_OK ||
        path.reserve_mtu_send(?manager, handle, 1400, true, probe.token).error != path.ERROR_TOKEN ||
        path.cancel_mtu_probe(?manager, probe.token).status != path.STATUS_BLOCKED ||
        path.publish_send(?manager, first_datagram.token).status != path.STATUS_OK ||
        path.cancel_mtu_probe(?manager, probe.token).error != path.ERROR_STATE ||
        path.publish_mtu_probe(?manager, probe.token).status != path.STATUS_OK ||
        !path.on_mtu_terminal(?manager, probe.token, path.MTU_TERMINAL_LOST).retry) { ret 1; }
    probe = path.prepare_mtu_probe(?manager, handle);
    val second_datagram: path.SendResult = path.reserve_mtu_send(?manager, handle, 1400, true, probe.token);
    path.publish_send(?manager, second_datagram.token);
    path.publish_mtu_probe(?manager, probe.token);
    if (!path.on_mtu_terminal(?manager, probe.token, path.MTU_TERMINAL_LOST).retry) { ret 1; }
    probe = path.prepare_mtu_probe(?manager, handle);
    val third_datagram: path.SendResult = path.reserve_mtu_send(?manager, handle, 1400, true, probe.token);
    path.publish_send(?manager, third_datagram.token);
    path.publish_mtu_probe(?manager, probe.token);
    val bounded: path.MtuResult = path.on_mtu_terminal(?manager, probe.token, path.MTU_TERMINAL_LOST);
    if (bounded.retry || bounded.next_probe_size != 1399 || bounded.current_mtu != 1200) { ret 1; }
    probe = path.prepare_mtu_probe(?manager, handle);
    if (probe.size != 1399) { ret 1; }
    val reserved: path.SendResult = path.reserve_mtu_send(?manager, handle, 1399, true, probe.token);
    if (reserved.status != path.STATUS_OK || path.publish_send(?manager, reserved.token).status != path.STATUS_OK ||
        path.publish_mtu_probe(?manager, probe.token).status != path.STATUS_OK) { ret 1; }
    val raised: path.MtuResult = path.on_mtu_terminal(?manager, probe.token, path.MTU_TERMINAL_ACKED);
    if (!raised.changed || raised.current_mtu != 1399 || !raised.reconfigure_congestion ||
        !raised.reconfigure_pacer) { ret 1; }
    path.on_large_packet_lost(?manager, handle, 1399);
    path.on_large_packet_lost(?manager, handle, 1399);
    path.on_packet_acked(?manager, handle, 1399);
    if (path.on_large_packet_lost(?manager, handle, 1399).changed) { ret 1; }
    path.on_large_packet_lost(?manager, handle, 1399);
    val black_hole: path.MtuResult = path.on_large_packet_lost(?manager, handle, 1399);
    if (!black_hole.changed || black_hole.current_mtu != 1200 ||
        !black_hole.reconfigure_congestion || !black_hole.reconfigure_pacer) { ret 1; }
    val before: path.Snapshot = path.snapshot(?manager, handle);
    if (path.on_packet_too_big(?manager, handle, 1300, false).status != path.STATUS_DROPPED ||
        path.snapshot(?manager, handle).next_probe_size != before.next_probe_size ||
        path.on_packet_too_big(?manager, handle, 1199, true).error != path.ERROR_MTU ||
        path.on_packet_too_big(?manager, handle, 1300, true).status != path.STATUS_OK) { ret 1; }
    ret 0;
}

test path__duplicate_paths_and_capacity_failure_are_transactional {
    var paths:      [2]path.Path;
    var challenges: [1]path.Challenge;
    var responses:  [1]path.Response;
    var sends:      [1]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 2,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses:  ?responses[0], response_capacity: 1,
        sends:      ?sends[0], send_capacity: 1};
    val initial: path.Endpoint = endpoint(1, 4433, 1, 55000);
    var manager: path.Manager  = initialize_manager(config(112, path.ROLE_CLIENT, true), storage, initial);
    path.confirm_handshake(?manager);
    val alternate: path.Endpoint   = endpoint(2, 4434, 1, 55000);
    val first:     path.PathResult = path.probe(?manager, alternate, false);
    val duplicate: path.PathResult = path.probe(?manager, alternate, false);
    if (first.status != path.STATUS_OK || duplicate.handle.index != first.handle.index ||
        duplicate.handle.generation != first.handle.generation ||
        path.probe(?manager, endpoint(3, 4435, 1, 55000), false).error != path.ERROR_CAPACITY ||
        path.find(?manager, endpoint(3, 4435, 1, 55000)).status != path.STATUS_EMPTY) { ret 1; }
    if (path.release(?manager, first.handle).status != path.STATUS_OK) { ret 1; }
    val reused: path.PathResult = path.probe(?manager, endpoint(3, 4435, 1, 55000), false);
    if (reused.handle.index != first.handle.index || reused.handle.generation == first.handle.generation ||
        path.release(?manager, first.handle).error != path.ERROR_TOKEN) { ret 1; }
    ret 0;
}

test path__multi_path_validation_faults_revert_to_the_last_validated_path {
    var paths:      [4]path.Path;
    var challenges: [4]path.Challenge;
    var responses:  [2]path.Response;
    var sends:      [2]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 4,
        challenges: ?challenges[0], challenge_capacity: 4,
        responses:  ?responses[0], response_capacity: 2,
        sends:      ?sends[0], send_capacity: 2};
    val initial: path.Endpoint = endpoint(1, 4433, 1, 55000);
    var manager: path.Manager  = initialize_manager(config(113, path.ROLE_SERVER, true), storage, initial);
    path.confirm_handshake(?manager);
    path.observe(?manager, initial, 10, 100, true, true, true, true, 0);
    val first: path.Observation = path.observe(?manager, endpoint(1, 4433, 2, 55000), 11, 100,
        true, true, true, true, 1);
    val second: path.Observation = path.observe(?manager, endpoint(1, 4433, 3, 55000), 12, 100,
        true, true, true, true, 2);
    if (!first.selected || !second.selected || first.handle.index == second.handle.index) { ret 1; }
    val data: [8]u8 = challenge(80);
    path.queue_challenge(?manager, second.handle, data, 100, 100, false, path.VALIDATION_PATH);
    val prepared: path.PreparedChallenge = path.prepare_challenge(?manager, second.handle);
    path.publish_challenge(?manager, prepared.token, 3);
    val timeout: path.TimeoutResult = path.on_timeout(?manager, 303);
    if (!timeout.reverted || timeout.selected.index != 0 || path.selected(?manager).handle.index != 0) {
        ret 1;
    }
    val first_data: [8]u8 = challenge(90);
    path.queue_challenge(?manager, first.handle, first_data, 100, 100, false, path.VALIDATION_PATH);
    val first_prepared: path.PreparedChallenge = path.prepare_challenge(?manager, first.handle);
    path.publish_challenge(?manager, first_prepared.token, 304);
    val validated: path.ValidationResult = path.receive_response(?manager, first_data, 305);
    if (validated.status != path.STATUS_OK || validated.selected || validated.ready_to_migrate ||
        path.selected(?manager).handle.index != 0) { ret 1; }
    ret 0;
}

test path__two_phase_close_drains_every_external_owner {
    var paths:      [2]path.Path;
    var challenges: [2]path.Challenge;
    var responses:  [2]path.Response;
    var sends:      [2]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 2,
        challenges: ?challenges[0], challenge_capacity: 2,
        responses:  ?responses[0], response_capacity: 2,
        sends:      ?sends[0], send_capacity: 2};
    val initial: path.Endpoint = endpoint(1, 4433, 1, 55000);
    var manager: path.Manager  = initialize_manager(config(114, path.ROLE_CLIENT, true), storage, initial);
    val handle:  path.Handle   = path.selected(?manager).handle;
    path.queue_challenge(?manager, handle, challenge(1), 100, 100, true, path.VALIDATION_PATH);
    val challenge_owner: path.PreparedChallenge = path.prepare_challenge(?manager, handle);
    path.queue_response(?manager, handle, challenge(2));
    val response_owner: path.PreparedResponse = path.prepare_response(?manager, handle);
    val mtu_owner:      path.MtuPrepared      = path.prepare_mtu_probe(?manager, handle);
    val send_owner:     path.SendResult       = path.reserve_mtu_send(?manager, handle,
        mtu_owner.size::u64, true, mtu_owner.token);
    if (path.begin_close(?manager).status != path.STATUS_OK ||
        path.finish_close(?manager).status != path.STATUS_BLOCKED) { ret 1; }
    if (path.cancel_challenge(?manager, challenge_owner.token).status != path.STATUS_OK ||
        path.publish_response(?manager, response_owner.token).status != path.STATUS_STALE ||
        path.cancel_mtu_probe(?manager, mtu_owner.token).status != path.STATUS_BLOCKED ||
        path.cancel_send(?manager, send_owner.token).status != path.STATUS_OK ||
        path.cancel_mtu_probe(?manager, mtu_owner.token).status != path.STATUS_OK ||
        path.finish_close(?manager).status != path.STATUS_OK || manager.valid) { ret 1; }
    ret 0;
}

test path__probing_paths_cannot_carry_non_probing_server_traffic_early {
    var paths:      [3]path.Path;
    var challenges: [2]path.Challenge;
    var responses:  [2]path.Response;
    var sends:      [2]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 3,
        challenges: ?challenges[0], challenge_capacity: 2,
        responses:  ?responses[0], response_capacity: 2,
        sends:      ?sends[0], send_capacity: 2};
    val initial:   path.Endpoint = endpoint(1, 4433, 1, 55000);
    val candidate: path.Endpoint = endpoint(1, 4433, 2, 55000);
    var manager:   path.Manager  = initialize_manager(config(115, path.ROLE_SERVER, true), storage, initial);
    path.confirm_handshake(?manager);
    val probing: path.Observation = path.observe(?manager, candidate, 1, 400,
        false, true, true, true, 10);
    if (!probing.created || probing.selected || probing.status != path.STATUS_OK ||
        path.reserve_send(?manager, probing.handle, 100, true).status != path.STATUS_BLOCKED) {
        ret 1;
    }
    val allowed: path.SendResult = path.reserve_send(?manager, probing.handle, 100, false);
    if (allowed.status != path.STATUS_OK || path.cancel_send(?manager, allowed.token).status != path.STATUS_OK) {
        ret 1;
    }
    val data: [8]u8 = challenge(100);
    path.queue_response(?manager, probing.handle, data);
    val probing_response: path.PreparedResponse = path.prepare_response(?manager, probing.handle);
    if (probing_response.status != path.STATUS_OK || probing_response.require_non_probing ||
        path.cancel_response(?manager, probing_response.token).status != path.STATUS_OK) { ret 1; }
    val moved: path.Observation = path.observe(?manager, candidate, 2, 400,
        true, true, true, true, 11);
    if (!moved.selected || moved.handle.index != probing.handle.index) { ret 1; }
    path.queue_response(?manager, moved.handle, challenge(110));
    val active_response: path.PreparedResponse = path.prepare_response(?manager, moved.handle);
    if (!active_response.require_non_probing ||
        path.cancel_response(?manager, active_response.token).status != path.STATUS_OK) { ret 1; }
    val received_before: u64 = path.snapshot(?manager, moved.handle).received_bytes;
    if (path.observe(?manager, candidate, 3, 1, false, true, true, true, 10).error != path.ERROR_TIME ||
        path.snapshot(?manager, moved.handle).received_bytes != received_before) { ret 1; }
    ret 0;
}

test path__failed_prior_path_revalidation_defeats_forwarding_attacks {
    var paths:      [3]path.Path;
    var challenges: [3]path.Challenge;
    var responses:  [1]path.Response;
    var sends:      [1]path.SendReservation;
    val storage:    path.Storage = path.Storage{paths: ?paths[0], path_capacity: 3,
        challenges: ?challenges[0], challenge_capacity: 3,
        responses:  ?responses[0], response_capacity: 1,
        sends:      ?sends[0], send_capacity: 1};
    val initial:   path.Endpoint = endpoint(1, 4433, 1, 55000);
    val candidate: path.Endpoint = endpoint(1, 4433, 2, 55000);
    var manager:   path.Manager  = initialize_manager(config(116, path.ROLE_SERVER, true), storage, initial);
    path.confirm_handshake(?manager);
    path.observe(?manager, initial, 10, 100, true, true, true, true, 1);
    val moved: path.Observation = path.observe(?manager, candidate, 11, 400,
        true, true, true, true, 2);
    val old: path.Handle = moved.previous;
    path.queue_challenge(?manager, old, challenge(1), 100, 100, true, path.VALIDATION_PATH);
    val old_challenge: path.PreparedChallenge = path.prepare_challenge(?manager, old);
    path.publish_challenge(?manager, old_challenge.token, 10);
    path.queue_challenge(?manager, moved.handle, challenge(20), 100, 100, true,
        path.VALIDATION_PATH);
    val new_challenge: path.PreparedChallenge = path.prepare_challenge(?manager, moved.handle);
    path.publish_challenge(?manager, new_challenge.token, 10);
    val prior_failed: path.TimeoutResult = path.on_timeout(?manager, 310);
    # a probing packet does not revive the failed path. a non-probing one would
    # validate it afresh (#238)
    if (prior_failed.failed.index != old.index || prior_failed.reverted || prior_failed.connection_lost ||
        path.selected(?manager).handle.index != moved.handle.index ||
        path.observe(?manager, initial, 12, 100, false, true, true, true, 311).status != path.STATUS_BLOCKED) {
        ret 1;
    }
    val candidate_failed: path.TimeoutResult = path.on_timeout(?manager, 310);
    if (!candidate_failed.connection_lost || path.selected(?manager).status != path.STATUS_ERROR ||
        path.cancel_challenge(?manager, old_challenge.token).status != path.STATUS_STALE ||
        path.cancel_challenge(?manager, new_challenge.token).status != path.STATUS_STALE) { ret 1; }
    val restarted: path.PathResult = path.restart(?manager, old);
    if (restarted.status != path.STATUS_OK || restarted.handle.generation == old.generation) { ret 1; }
    val recovered: path.Observation = path.observe(?manager, initial, 12, 100,
        true, true, true, true, 312);
    if (!recovered.selected || recovered.handle.generation != restarted.handle.generation ||
        !recovered.needs_validation) { ret 1; }
    ret 0;
}

rec Held {
    manager:    path.Manager;
    paths:      [2]path.Path;
    challenges: [2]path.Challenge;
    responses:  [2]path.Response;
    sends:      [2]path.SendReservation;
}

fun same(a: *Held, b: *Held) bool {
    ret memory.equal[Held](a, b, 1);
}

test path__a_peek_answers_what_the_prepare_after_it_does_and_changes_nothing {
    var held:    Held;
    var before:  Held;
    val storage: path.Storage = path.Storage{paths: ?held.paths[0], path_capacity: 2,
        challenges: ?held.challenges[0], challenge_capacity: 2,
        responses:  ?held.responses[0], response_capacity: 2,
        sends:      ?held.sends[0], send_capacity: 2};
    val initial: path.Endpoint = endpoint(1, 4433, 1, 55000);
    held.manager = initialize_manager(config(113, path.ROLE_SERVER, false), storage, initial);
    val handle: path.Handle = path.selected(?held.manager).handle;
    if (!path.lease_core(?held.manager, 113)) { ret 1; }
    # nothing queued, and a reservation the amplification limit refuses
    before = held;
    if (path.peek_response_scoped(?held.manager, 113, handle).status != path.STATUS_EMPTY ||
        path.peek_challenge_scoped(?held.manager, 113, handle).status != path.STATUS_EMPTY ||
        path.peek_send_scoped(?held.manager, 113, handle, 1200, false).error !=
        path.ERROR_AMPLIFICATION || !same(?held, ?before)) { ret 2; }
    if (path.peek_response_scoped(?held.manager, 114, handle).error != path.ERROR_STATE) { ret 3; }
    if (path.queue_response_scoped(?held.manager, 113, handle, challenge(5)).status !=
        path.STATUS_OK) { ret 4; }
    # blocked by amplification before anything was received, then taken
    before = held;
    val blocked: path.PreparedResponse = path.peek_response_scoped(?held.manager, 113, handle);
    if (blocked.status != path.STATUS_BLOCKED || !same(?held, ?before) ||
        path.prepare_response_scoped(?held.manager, 113, handle).status !=
        path.STATUS_BLOCKED) { ret 5; }
    path.observe_scoped(?held.manager, 113, initial, 1, 500, false, true, true, true, 1);
    before = held;
    val peeked:  path.PreparedResponse = path.peek_response_scoped(?held.manager, 113, handle);
    val allowed: path.SendResult       = path.peek_send_scoped(?held.manager, 113, handle, 1200, false);
    if (peeked.status != path.STATUS_OK || allowed.status != path.STATUS_OK ||
        allowed.allowance != 1500 || !same(?held, ?before)) { ret 6; }
    val taken: path.PreparedResponse = path.prepare_response_scoped(?held.manager, 113, handle);
    if (taken.status != path.STATUS_OK || taken.token.index != peeked.token.index ||
        taken.token.generation != peeked.token.generation ||
        taken.maximum_datagram_size != peeked.maximum_datagram_size ||
        taken.minimum_datagram_size != peeked.minimum_datagram_size ||
        path.peek_response_scoped(?held.manager, 113, handle).status != path.STATUS_EMPTY) { ret 7; }
    val reserved: path.SendResult = path.reserve_send_scoped(?held.manager, 113, handle, 1200, false);
    if (reserved.status != path.STATUS_OK || reserved.allowance != allowed.allowance ||
        path.peek_send_scoped(?held.manager, 113, handle, 301, false).status !=
        path.STATUS_BLOCKED ||
        path.reserve_send_scoped(?held.manager, 113, handle, 301, false).status !=
        path.STATUS_BLOCKED) { ret 8; }
    # a challenge on the same path
    path.confirm_handshake_scoped(?held.manager, 113);
    if (path.queue_challenge_scoped(?held.manager, 113, handle, challenge(9), 100, 100, false,
        path.VALIDATION_PATH).status != path.STATUS_OK) { ret 9; }
    before = held;
    val challenged: path.PreparedChallenge = path.peek_challenge_scoped(?held.manager, 113, handle);
    if (challenged.status != path.STATUS_OK || !same(?held, ?before)) { ret 10; }
    val prepared: path.PreparedChallenge = path.prepare_challenge_scoped(?held.manager, 113, handle);
    if (prepared.status != path.STATUS_OK || prepared.token.index != challenged.token.index ||
        prepared.token.generation != challenged.token.generation) { ret 11; }
    ret 0;
}

test path__an_mtu_probe_peek_names_the_probe_the_prepare_after_it_takes {
    var held:    Held;
    var before:  Held;
    val storage: path.Storage = path.Storage{paths: ?held.paths[0], path_capacity: 2,
        challenges: ?held.challenges[0], challenge_capacity: 2,
        responses:  ?held.responses[0], response_capacity: 2,
        sends:      ?held.sends[0], send_capacity: 2};
    held.manager = initialize_manager(config(115, path.ROLE_CLIENT, true), storage,
        endpoint(1, 4433, 1, 55000));
    val handle: path.Handle = path.selected(?held.manager).handle;
    if (!path.lease_core(?held.manager, 115)) { ret 1; }
    before = held;
    val peeked: path.MtuPrepared = path.peek_mtu_probe_scoped(?held.manager, 115, handle);
    if (peeked.status != path.STATUS_OK || peeked.size != 1400 ||
        path.peek_mtu_send_scoped(?held.manager, 115, handle, 1400, true, peeked.size).status !=
        path.STATUS_OK || !same(?held, ?before)) { ret 2; }
    val probe: path.MtuPrepared = path.prepare_mtu_probe_scoped(?held.manager, 115, handle);
    if (probe.status != path.STATUS_OK || probe.size != peeked.size ||
        probe.token.generation != peeked.token.generation ||
        path.reserve_mtu_send_scoped(?held.manager, 115, handle, 1400, true,
        probe.token).status != path.STATUS_OK) { ret 3; }
    # a prepared probe blocks the next, in the peek as in the prepare
    if (path.peek_mtu_probe_scoped(?held.manager, 115, handle).status != path.STATUS_BLOCKED) { ret 4; }
    ret 0;
}
