fun initialized_for_test(config: Config, storage: Storage,
                         initial: Endpoint) Manager {
    var manager: Manager;
    initialize(?manager, config, storage, initial);
    ret manager;
}

test "quic.path.path: owned regions reject maximum-address descriptors" {
    var paths: [1]Path;
    var challenges: [1]Challenge;
    var responses: [1]Response;
    var sends: [1]SendReservation;
    var endpoint: Endpoint;
    endpoint.local.family = ADDRESS_IPV4;
    endpoint.local.bytes[0] = 1;
    endpoint.local.port = 1;
    endpoint.peer.family = ADDRESS_IPV4;
    endpoint.peer.bytes[0] = 2;
    endpoint.peer.port = 2;
    val maximum: usize = 0 - 1::usize;
    var output: Manager;
    if (initialize(maximum::*Manager, default_config(90, ROLE_CLIENT, true),
        Storage{paths: ?paths[0], path_capacity: 1,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses: ?responses[0], response_capacity: 1,
        sends: ?sends[0], send_capacity: 1}, endpoint) ||
        initialize((?paths[0])::*Manager,
        default_config(90, ROLE_CLIENT, true),
        Storage{paths: ?paths[0], path_capacity: 1,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses: ?responses[0], response_capacity: 1,
        sends: ?sends[0], send_capacity: 1}, endpoint)) { ret 1; }
    val hostile: Manager = initialized_for_test(default_config(91, ROLE_CLIENT, true), Storage{
        paths: maximum::*Path, path_capacity: 1,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses: ?responses[0], response_capacity: 1,
        sends: ?sends[0], send_capacity: 1}, endpoint);
    val overflowed: Manager = initialized_for_test(default_config(92, ROLE_CLIENT, true),
        Storage{paths: ?paths[0], path_capacity: maximum,
        challenges: ?challenges[0], challenge_capacity: 1,
        responses: ?responses[0], response_capacity: 1,
        sends: ?sends[0], send_capacity: 1}, endpoint);
    if (hostile.valid || overflowed.valid || output.valid) { ret 1; }
    ret 0;
}
