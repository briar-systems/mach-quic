fwd quic.connection.core;
fwd quic.connection.core_simulated;
fwd quic.transport;
fwd quic.transport.simulated;

# CI proves the constant matches the manifest, so the test only pins the shape:
# three dot-separated numeric components
test "quic: exported version is major.minor.patch" {
    var dots:   usize = 0;
    var digits: usize = 0;
    var i:      usize = 0;
    for (VERSION[i] != 0) {
        var digit: bool = VERSION[i] >= '0' && VERSION[i] <= '9';
        if (!digit && VERSION[i] != '.') { ret 1; }
        if (digit)                       { digits = digits + 1; }
        if (!digit) {
            if (digits == 0) { ret 2; }
            dots   = dots + 1;
            digits = 0;
        }
        i = i + 1;
    }
    if (dots != 2 || digits == 0) { ret 3; }
    ret 0;
}
