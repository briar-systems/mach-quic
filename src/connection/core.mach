}

pub rec Snapshot {
    state: transport_api.ConnectionState;
    version: u32;
    authenticated_packets: usize;
    retry_count: usize;
    version_restart_count: usize;
    active_owners: usize;
    received_token_length: usize;
    early_disposition: u8;
    peer_parameters_ready: bool;
    peer_authenticated: bool;
    handshake_confirmed: bool;
    initial_keys_discarded: bool;
    provider_error: u64;
    closing: bool;
    destroyed: bool;
}

# why initialization refused. `error` stays the wire-facing transport code, so
# a caller that only forwards a CONNECTION_CLOSE is unaffected; `reason` says
# which check rejected. ownership validation alone can refuse in well over
# sixty distinct ways and one undifferentiated INTERNAL_ERROR leaves a caller
# bisecting its own buffer list by hand
pub def InitReason: u64;
pub val INIT_OK: InitReason = 0;
pub val INIT_ARGUMENT: InitReason = 1;
pub val INIT_STORAGE_CAPACITY: InitReason = 2;
pub val INIT_STORAGE_RANGES: InitReason = 3;
pub val INIT_STORAGE_SECRETS: InitReason = 4;
pub val INIT_STORAGE_BORROWED: InitReason = 5;
pub val INIT_COMPONENT_RANGES: InitReason = 6;
pub val INIT_PROVIDER_RANGES: InitReason = 7;
pub val INIT_PROVIDER_SECRETS: InitReason = 8;
pub val INIT_COMPONENT_BORROWED: InitReason = 9;
pub val INIT_PRECONDITION: InitReason = 10;
pub val INIT_IDENTITY: InitReason = 11;
pub val INIT_PARAMETERS: InitReason = 12;
pub val INIT_RECOVERY: InitReason = 13;
pub val INIT_LEASE: InitReason = 14;
pub val INIT_KEYS: InitReason = 15;
pub val INIT_PATH: InitReason = 16;
pub val INIT_PROVIDER_START: InitReason = 17;

# `reason_kind` and the two indices are only populated for the ownership
# reasons. an index is a position in the range list the named check built:
# INIT_STORAGE_* index the twenty-three owned storage ranges, INIT_COMPONENT_*
# and INIT_PROVIDER_RANGES index the sixty-three component ranges, whose first
# twenty-three entries are the storage ranges in the same order. for a
# _BORROWED reason `reason_first` is instead the borrowed range's own index and
# `reason_second` is the owned range it collided with
pub rec InitResult {
    ok: bool;
    error: u64;
    provider_error: u64;
    reason: InitReason;
    reason_kind: ownership.Overlap;
    reason_first: usize;
    reason_second: usize;
}

# first writer wins, so a coarse refusal further out never overwrites the
# precise one that caused it
fun refuse(result: *InitResult, reason: InitReason) bool {
    if (result != nil && result.reason == INIT_OK) { result.reason = reason; }
    ret false;
}

fun refuse_overlap(result: *InitResult, reason: InitReason,
                   detail: ownership.Disjointness) bool {
    if (result != nil && result.reason == INIT_OK) {
        result.reason = reason;
        result.reason_kind = detail.kind;
        result.reason_first = detail.first;
        result.reason_second = detail.second;
    }
    ret false;
}

pub rec Core {
    config: Config;
    storage: Storage;
    cids: *cid_api.Manager;
    paths: *path_api.Manager;
    streams: *stream_api.Manager;
    datagrams: *datagram_api.Queue;
    negotiation: negotiation_api.Client;
    recovery_state: recovery.Recovery;
    acknowledgements: ack_api.Tracker;
    peer_parameters: transport_parameters.Parameters;
    local_parameters: transport_parameters.Parameters;
    retry_source_connection_id: packet.ConnectionId;
    packet_numbers: [3]u64;
    expected_packet_numbers: [3]u64;
    ack_prepared: [3]bool;
    received_token_length: usize;
    send_token_length: usize;
    send_max_udp_payload: usize;
    idle_timeout_ns: u64;
    next_owner: u64;
    next_owner_slot: usize;
    last_received_ns: u64;
    last_activity_ns: u64;
    last_now_ns: u64;
    close_started_ns: u64;
    close_deadline_ns: u64;
    close_error: u64;
    close_frame_type: u64;
    close_reason_length: usize;
    last_provider_error: u64;
    timer_generation: u64;
    timer_deadline_ns: u64;
    timer_recovery_generation: u64;
    timer_kind: u8;
    state: transport_api.ConnectionState;
    early_disposition: u8;
    role: transport_api.Role;
    authenticated_packets: usize;
    retry_count: usize;
    version_restart_count: usize;
    close_transmissions: usize;
    probes_remaining: u8;
    probe_space: u8;
    probe_owner: u64;
    peer_parameters_ready: bool;
    retry_source_present: bool;
    peer_authenticated: bool;
    handshake_confirmed: bool;
    initial_keys_discarded: bool;
    close_queued: bool;
    handshake_done_queued: bool;
    peer_close_received: bool;
    send_token_queued: bool;
    send_token_prepared: bool;
    idle_timer_enabled: bool;
    initialized: bool;
    closing: bool;
    destroyed: bool;
}

rec Envelope {
    destination: packet.ConnectionId;
    source: packet.ConnectionId;
    token: packet.Span;
    kind: u8;
    version: u32;
    offset: usize;
    length: usize;
    packet_number_offset: usize;
    valid: bool;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun saturated_add(left: u64, right: u64) u64 {
    if (right > (0 - 1::u64) - left) { ret 0 - 1::u64; }
    ret left + right;
}

fun saturated_multiply(left: u64, right: u64) u64 {
    if (left == 0 || right == 0) { ret 0; }
    if (left > (0 - 1::u64) / right) { ret 0 - 1::u64; }
    ret left * right;
}

fun valid_role(role: transport_api.Role) bool {
    ret role == transport_api.CLIENT || role == transport_api.SERVER;
}

fun role_handshake(role: transport_api.Role) handshake_api.Role {
    if (role == transport_api.CLIENT) { ret handshake_api.CLIENT; }
    ret handshake_api.SERVER;
}

fun peer_parameter_role(role: transport_api.Role) u8 {
    if (role == transport_api.CLIENT) { ret transport_parameters.ROLE_SERVER; }
    ret transport_parameters.ROLE_CLIENT;
}

fun space_index(space: u8) usize { ret (space - packet.SPACE_INITIAL)::usize; }

fun level_for_kind(kind: u8) handshake_api.Level {
    if (kind == packet.PACKET_INITIAL) { ret handshake_api.INITIAL; }
    if (kind == packet.PACKET_ZERO_RTT) { ret handshake_api.EARLY; }
    if (kind == packet.PACKET_HANDSHAKE) { ret handshake_api.HANDSHAKE; }
    ret handshake_api.APPLICATION;
}

fun kind_for_level(level: handshake_api.Level) u8 {
    if (level == handshake_api.INITIAL) { ret packet.PACKET_INITIAL; }
    if (level == handshake_api.EARLY) { ret packet.PACKET_ZERO_RTT; }
    if (level == handshake_api.HANDSHAKE) { ret packet.PACKET_HANDSHAKE; }
    ret packet.PACKET_ONE_RTT;
}

fun path_address(value: ip.Endpoint) path_api.Address {
    var result: path_api.Address;
    result.port = value.port;
    result.scope_id = value.scope;
    if (value.addr.is_v6 != 0) {
        result.family = path_api.ADDRESS_IPV6;
        memory.copy[u8](?result.bytes[0], ?value.addr.v6.octets[0], 16);
    } or {
        result.family = path_api.ADDRESS_IPV4;
        memory.copy[u8](?result.bytes[0], ?value.addr.v4.octets[0], 4);
    }
    ret result;
}

fun ip_endpoint(value: path_api.Address) ip.Endpoint {
    var result: ip.Endpoint;
    result.port = value.port;
    result.scope = value.scope_id;
    if (value.family == path_api.ADDRESS_IPV6) {
        result.addr.is_v6 = 1;
        memory.copy[u8](?result.addr.v6.octets[0], ?value.bytes[0], 16);
    } or {
        memory.copy[u8](?result.addr.v4.octets[0], ?value.bytes[0], 4);
    }
    ret result;
}

fun path_endpoint(local: ip.Endpoint, peer: ip.Endpoint) path_api.Endpoint {
    ret path_api.Endpoint{local: path_address(local), peer: path_address(peer)};
}

fun core_result(core: *Core, status: transport_api.Status,
                error: u64) transport_api.CoreResult {
    ret transport_api.CoreResult{status: status, error: error,
        provider_error: core.last_provider_error, state: core.state};
}

# the guards that refuse before the core is known good cannot read a provider
# error off it, and a literal that omits the field leaves the previous frame's
# contents there rather than zero (briar-systems/mach#3108)
fun core_refused(error: u64) transport_api.CoreResult {
    ret transport_api.CoreResult{status: transport_api.STATUS_ERROR,
        error: error, provider_error: 0, state: transport_api.DRAINING};
}

fun stream_prepared_token(token: stream_api.AttemptToken) stream_api.Prepared {
    var value: stream_api.Prepared;
    value.ok = true;
    value.token = token;
    ret value;
}

fun datagram_prepared_token(token: datagram_api.Token) datagram_api.Prepared {
    var value: datagram_api.Prepared;
    value.ok = true;
    value.token = token;
    ret value;
}

fun core_range(core: *Core) ownership.Range {
    if (core == nil) { var empty: ownership.Range; ret empty; }
    ret ownership.anchored_record[Core, Config](?core.config,
        $offset_of(Core, config));
}

fun secrets_range(secrets: *Secrets) ownership.Range {
    if (secrets == nil) { var empty: ownership.Range; ret empty; }
    ret ownership.anchored_record[Secrets, bool](?secrets.initialized,
        $offset_of(Secrets, initialized));
}

fun secret_storage_range(storage: *SecretStorage) ownership.Range {
    if (storage == nil) { var empty: ownership.Range; ret empty; }
    ret ownership.anchored_record[SecretStorage, usize](
        ?storage.receive_plaintext_capacity,
        $offset_of(SecretStorage, receive_plaintext_capacity));
}

fun core_record_valid(core: *Core) bool {
    ret core_range(core).valid;
}

fun secret_record_valid(secrets: *Secrets) bool {
    ret secrets_range(secrets).valid;
}

fun borrowed_disjoint(core: *Core, borrowed: ownership.Range) bool {
    if (!borrowed.valid) { ret false; }
    var owned: [21]ownership.Range;
    owned[0] = ownership.bytes(core.storage.receive_header,
        core.storage.receive_header_capacity, ownership.ZERO_FORBIDDEN);
    owned[1] = ownership.bytes(core.storage.receive_decoded,
        core.storage.receive_decoded_capacity, ownership.ZERO_FORBIDDEN);
    owned[2] = ownership.bytes(core.storage.send_plaintext,
        core.storage.send_plaintext_capacity, ownership.ZERO_FORBIDDEN);
    owned[3] = ownership.bytes(core.storage.close_reason,
        core.storage.close_reason_capacity, ownership.ZERO_FORBIDDEN);
    owned[4] = ownership.array(core.storage.frame_ack_ranges::*u8,
        core.storage.frame_ack_capacity, $size_of(frame.AckRange),
        ownership.ZERO_FORBIDDEN);
    owned[5] = ownership.array(core.storage.recovery_events::*u8,
        core.storage.recovery_event_capacity, $size_of(recovery.Event),
        ownership.ZERO_FORBIDDEN);
    owned[6] = ownership.array(core.storage.recovery_initial.packets::*u8,
        core.storage.recovery_initial.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    owned[7] = ownership.array(core.storage.recovery_handshake.packets::*u8,
        core.storage.recovery_handshake.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    owned[8] = ownership.array(core.storage.recovery_application.packets::*u8,
        core.storage.recovery_application.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    owned[9] = ownership.array(core.storage.ack_initial.ranges::*u8,
        core.storage.ack_initial.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    owned[10] = ownership.array(core.storage.ack_handshake.ranges::*u8,
        core.storage.ack_handshake.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    owned[11] = ownership.array(core.storage.ack_application.ranges::*u8,
        core.storage.ack_application.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    owned[12] = ownership.array(core.storage.owners::*u8,
        core.storage.owner_capacity, $size_of(Owner), ownership.ZERO_FORBIDDEN);
    owned[13] = ownership.array(core.storage.peer_extensions::*u8,
        core.storage.peer_extension_capacity,
        $size_of(transport_parameters.Parameter), ownership.ZERO_ALLOWED);
    owned[14] = ownership.array(core.storage.local_extensions::*u8,
        core.storage.local_extension_capacity,
        $size_of(transport_parameters.Parameter), ownership.ZERO_ALLOWED);
    owned[15] = ownership.bytes(core.storage.peer_extension_bytes,
        core.storage.peer_extension_byte_capacity, ownership.ZERO_ALLOWED);
    owned[16] = ownership.bytes(core.storage.local_extension_bytes,
        core.storage.local_extension_byte_capacity, ownership.ZERO_ALLOWED);
    owned[17] = ownership.bytes(core.storage.received_token,
        core.storage.received_token_capacity, ownership.ZERO_FORBIDDEN);
    owned[18] = ownership.bytes(core.storage.send_token,
        core.storage.send_token_capacity, ownership.ZERO_FORBIDDEN);
    owned[19] = ownership.bytes(core.storage.negotiation.retry_token,
        core.storage.negotiation.retry_token_capacity, ownership.ZERO_ALLOWED);
    owned[20] = ownership.bytes(core.storage.negotiation.retry_pseudo,
        core.storage.negotiation.retry_pseudo_capacity, ownership.ZERO_ALLOWED);
    var i: usize = 0;
    for (i < 21) {
        if (!ownership.disjoint(borrowed, owned[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun handshake_failure(core: *Core, value: handshake_api.Result) u64 {
    if (value.error == handshake_api.ERROR_PROVIDER) {
        core.last_provider_error = value.provider_error;
        ret INTERNAL_ERROR;
    }
    if (value.error == handshake_api.ERROR_BUFFER ||
        value.error == handshake_api.ERROR_LIMIT ||
        value.error == handshake_api.ERROR_OFFSET ||
        value.error == handshake_api.ERROR_OVERFLOW) {
        ret CRYPTO_BUFFER_EXCEEDED;
    }
    ret INTERNAL_ERROR;
}

fun begin_application_close(core: *Core) bool {
    if (!core.streams.closing &&
        stream_api.begin_close_scoped(core.streams, core.config.source).status != stream_api.STATUS_OK) {
        ret false;
    }
    if (!core.datagrams.closing &&
        datagram_api.begin_close_scoped(core.datagrams, core.config.source).status != datagram_api.STATUS_OK) {
        ret false;
    }
    ret true;
}

fun fail(core: *Core, error: u64, now_ns: u64) transport_api.CoreResult {
    if (!core.closing) {
        if (!begin_application_close(core)) { error = INTERNAL_ERROR; }
        core.closing = true;
        core.close_queued = true;
        core.close_error = error;
        core.close_frame_type = 0;
        core.close_started_ns = now_ns;
        core.close_deadline_ns = saturated_add(now_ns,
            core.config.drain_timeout_ns);
        core.state = transport_api.CLOSING;
    }
    ret core_result(core, transport_api.STATUS_ERROR, error);
}

fun key_set_disjoint(data: *^u8, length: usize,
                     keys: *protection.KeySet) bool {
    ret ownership.secret_disjoint(data, length, ?keys.secret[0], 48) &&
        ownership.secret_disjoint(data, length, ?keys.key[0], 32) &&
        ownership.secret_disjoint(data, length, ?keys.iv[0], 12) &&
        ownership.secret_disjoint(data, length, ?keys.hp[0], 32);
}

fun welded_keys_disjoint(secrets: *Secrets, data: *^u8,
                         length: usize) bool {
    ret key_set_disjoint(data, length, ?secrets.initial_keys.client) &&
        key_set_disjoint(data, length, ?secrets.initial_keys.server) &&
        key_set_disjoint(data, length, ?secrets.early_send) &&
        key_set_disjoint(data, length, ?secrets.early_receive) &&
        key_set_disjoint(data, length, ?secrets.handshake_send) &&
        key_set_disjoint(data, length, ?secrets.handshake_receive) &&
        key_set_disjoint(data, length, ?secrets.application_send.current) &&
        key_set_disjoint(data, length,
            ?secrets.application_receive.previous) &&
        key_set_disjoint(data, length,
            ?secrets.application_receive.current) &&
        key_set_disjoint(data, length, ?secrets.application_receive.next);
}

fun storage_valid(core: *Core, secrets: *Secrets, config: *Config,
                  storage: *Storage, secret_storage: *SecretStorage,
                  result: *InitResult) bool {
    if (core == nil || secrets == nil || config == nil || storage == nil ||
        secret_storage == nil) { ret refuse(result, INIT_ARGUMENT); }
    if (!core_range(core).valid ||
        !secrets_range(secrets).valid ||
        !ownership.record[Config](config).valid ||
        !ownership.record[Storage](storage).valid ||
        !secret_storage_range(secret_storage).valid ||
        secret_storage.receive_plaintext == nil ||
        secret_storage.send_plaintext == nil ||
        secret_storage.receive_plaintext == secret_storage.send_plaintext ||
        secret_storage.receive_plaintext_capacity < config.max_udp_payload ||
        secret_storage.send_plaintext_capacity < config.max_udp_payload ||
        storage.receive_header_capacity < config.max_udp_payload ||
        storage.receive_decoded_capacity < config.max_udp_payload ||
        storage.send_plaintext_capacity < config.max_udp_payload ||
        storage.close_reason_capacity == 0 || storage.frame_ack_capacity == 0 ||
        storage.ack_initial.capacity == 0 ||
        storage.ack_handshake.capacity == 0 ||
        storage.ack_application.capacity == 0 ||
        storage.frame_ack_capacity < storage.ack_initial.capacity - 1 ||
        storage.frame_ack_capacity < storage.ack_handshake.capacity - 1 ||
        storage.frame_ack_capacity < storage.ack_application.capacity - 1 ||
        storage.recovery_event_capacity < storage.owner_capacity ||
        storage.owner_capacity == 0 || storage.received_token_capacity == 0 ||
        storage.send_token_capacity == 0) {
        ret refuse(result, INIT_STORAGE_CAPACITY);
    }
    var zero_negotiation: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    var zero_versions: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    if (config.role == transport_api.SERVER) {
        zero_negotiation = ownership.ZERO_ALLOWED;
        zero_versions = ownership.ZERO_ALLOWED;
    }
    var ranges: [23]ownership.Range;
    ranges[0] = core_range(core);
    ranges[1] = secrets_range(secrets);
    ranges[2] = ownership.bytes(storage.receive_header,
        storage.receive_header_capacity, ownership.ZERO_FORBIDDEN);
    ranges[3] = ownership.bytes(storage.receive_decoded,
        storage.receive_decoded_capacity, ownership.ZERO_FORBIDDEN);
    ranges[4] = ownership.bytes(storage.send_plaintext,
        storage.send_plaintext_capacity, ownership.ZERO_FORBIDDEN);
    ranges[5] = ownership.bytes(storage.close_reason,
        storage.close_reason_capacity, ownership.ZERO_FORBIDDEN);
    ranges[6] = ownership.array(storage.frame_ack_ranges::*u8,
        storage.frame_ack_capacity, $size_of(frame.AckRange),
        ownership.ZERO_FORBIDDEN);
    ranges[7] = ownership.array(storage.recovery_events::*u8,
        storage.recovery_event_capacity, $size_of(recovery.Event),
        ownership.ZERO_FORBIDDEN);
    ranges[8] = ownership.array(storage.recovery_initial.packets::*u8,
        storage.recovery_initial.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    ranges[9] = ownership.array(storage.recovery_handshake.packets::*u8,
        storage.recovery_handshake.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    ranges[10] = ownership.array(storage.recovery_application.packets::*u8,
        storage.recovery_application.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    ranges[11] = ownership.array(storage.ack_initial.ranges::*u8,
        storage.ack_initial.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    ranges[12] = ownership.array(storage.ack_handshake.ranges::*u8,
        storage.ack_handshake.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    ranges[13] = ownership.array(storage.ack_application.ranges::*u8,
        storage.ack_application.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    ranges[14] = ownership.array(storage.owners::*u8, storage.owner_capacity,
        $size_of(Owner), ownership.ZERO_FORBIDDEN);
    ranges[15] = ownership.array(storage.peer_extensions::*u8,
        storage.peer_extension_capacity, $size_of(transport_parameters.Parameter),
        ownership.ZERO_ALLOWED);
    ranges[16] = ownership.array(storage.local_extensions::*u8,
        storage.local_extension_capacity, $size_of(transport_parameters.Parameter),
        ownership.ZERO_ALLOWED);
    ranges[17] = ownership.bytes(storage.peer_extension_bytes,
        storage.peer_extension_byte_capacity, ownership.ZERO_ALLOWED);
    ranges[18] = ownership.bytes(storage.local_extension_bytes,
        storage.local_extension_byte_capacity, ownership.ZERO_ALLOWED);
    ranges[19] = ownership.bytes(storage.received_token,
        storage.received_token_capacity, ownership.ZERO_FORBIDDEN);
    ranges[20] = ownership.bytes(storage.send_token,
        storage.send_token_capacity, ownership.ZERO_FORBIDDEN);
    ranges[21] = ownership.bytes(storage.negotiation.retry_token,
        storage.negotiation.retry_token_capacity, zero_negotiation);
    ranges[22] = ownership.bytes(storage.negotiation.retry_pseudo,
        storage.negotiation.retry_pseudo_capacity, zero_negotiation);
    val owned: ownership.Disjointness = ownership.disjointness(?ranges[0], 23);
    if (owned.kind != ownership.OVERLAP_NONE) {
        ret refuse_overlap(result, INIT_STORAGE_RANGES, owned);
    }
    if (!ownership.secret_disjoint(secret_storage.receive_plaintext,
            secret_storage.receive_plaintext_capacity,
            secret_storage.send_plaintext,
            secret_storage.send_plaintext_capacity) ||
        !welded_keys_disjoint(secrets, secret_storage.receive_plaintext,
            secret_storage.receive_plaintext_capacity) ||
        !welded_keys_disjoint(secrets, secret_storage.send_plaintext,
            secret_storage.send_plaintext_capacity)) {
        ret refuse(result, INIT_STORAGE_SECRETS);
    }
    var borrowed: [4]ownership.Range;
    borrowed[0] = ownership.bytes(config.alpn.data, config.alpn.length,
        ownership.ZERO_FORBIDDEN);
    borrowed[1] = ownership.bytes(config.server_name.data,
        config.server_name.length, ownership.ZERO_ALLOWED);
    borrowed[2] = ownership.bytes(config.local_transport_parameters.data,
        config.local_transport_parameters.length, ownership.ZERO_FORBIDDEN);
    borrowed[3] = ownership.array(config.supported_versions::*u8,
        config.supported_version_count, $size_of(u32), zero_versions);
    var i: usize = 0;
    for (i < 4) {
        val lent: ownership.Disjointness = ownership.disjoint_from(borrowed[i], i,
            ?ranges[0], 0, 23);
        if (lent.kind != ownership.OVERLAP_NONE) {
            ret refuse_overlap(result, INIT_STORAGE_BORROWED, lent);
        }
        i = i + 1;
    }
    ret true;
}

fun local_parameter_role(role: transport_api.Role) u8 {
    if (role == transport_api.CLIENT) { ret transport_parameters.ROLE_CLIENT; }
    ret transport_parameters.ROLE_SERVER;
}

fun validate_local_parameters(config: Config, parameters: *transport_parameters.Parameters,
                              cids: *cid_api.Manager, paths: *path_api.Manager,
                              streams: *stream_api.Manager,
                              datagrams: *datagram_api.Queue) bool {
    if (!packet.connection_id_equal(?parameters.initial_source_connection_id,
            ?config.local_source) ||
        parameters.max_udp_payload_size::usize != config.max_udp_payload ||
        saturated_multiply(parameters.max_idle_timeout, 1000000) !=
            config.max_idle_timeout_ns ||
        parameters.initial_max_data != streams.config.receive_max_data ||
        parameters.initial_max_stream_data_bidi_local !=
            streams.config.receive_local_bidirectional_limit ||
        parameters.initial_max_stream_data_bidi_remote !=
            streams.config.receive_peer_bidirectional_limit ||
        parameters.initial_max_stream_data_uni !=
            streams.config.receive_unidirectional_limit ||
        parameters.initial_max_streams_bidi !=
            streams.config.peer_bidirectional_limit ||
        parameters.initial_max_streams_uni !=
            streams.config.peer_unidirectional_limit ||
        parameters.active_connection_id_limit::usize !=
            cids.config.peer_active_limit ||
        parameters.disable_active_migration == paths.config.allow_peer_active_migration ||
        parameters.max_datagram_frame_size::usize !=
            datagrams.config.local_max_frame_size) { ret false; }
    if (config.role == transport_api.SERVER &&
        !packet.connection_id_equal(?parameters.original_destination_connection_id,
            ?config.original_destination)) { ret false; }
    if (config.role == transport_api.SERVER) {
        if (config.retry_source_present) {
            if (!transport_parameters.has(parameters,
                    transport_parameters.RETRY_SOURCE_CONNECTION_ID) ||
                !packet.connection_id_equal(?parameters.retry_source_connection_id,
                    ?config.retry_source)) { ret false; }
        } or (transport_parameters.has(parameters,
            transport_parameters.RETRY_SOURCE_CONNECTION_ID)) { ret false; }
    }
    ret true;
}

fun component_storage_valid(core: *Core, secrets: *Secrets, config: *Config,
                            storage: *Storage, secret_storage: *SecretStorage,
                            handshake: *handshake_api.Adapter,
                            cids: *cid_api.Manager, paths: *path_api.Manager,
                            streams: *stream_api.Manager,
                            datagrams: *datagram_api.Queue,
                            result: *InitResult) bool {
    if (handshake == nil || cids == nil || paths == nil || streams == nil ||
        datagrams == nil) { ret refuse(result, INIT_ARGUMENT); }
    var ranges: [63]ownership.Range;
    ranges[0] = core_range(core);
    ranges[1] = secrets_range(secrets);
    if (!ranges[0].valid || !ranges[1].valid) {
        ret refuse(result, INIT_STORAGE_CAPACITY);
    }
    ranges[2] = ownership.bytes(storage.receive_header,
        storage.receive_header_capacity, ownership.ZERO_FORBIDDEN);
    ranges[3] = ownership.bytes(storage.receive_decoded,
        storage.receive_decoded_capacity, ownership.ZERO_FORBIDDEN);
    ranges[4] = ownership.bytes(storage.send_plaintext,
        storage.send_plaintext_capacity, ownership.ZERO_FORBIDDEN);
    ranges[5] = ownership.bytes(storage.close_reason,
        storage.close_reason_capacity, ownership.ZERO_FORBIDDEN);
    ranges[6] = ownership.array(storage.frame_ack_ranges::*u8,
        storage.frame_ack_capacity, $size_of(frame.AckRange),
        ownership.ZERO_FORBIDDEN);
    ranges[7] = ownership.array(storage.recovery_events::*u8,
        storage.recovery_event_capacity, $size_of(recovery.Event),
        ownership.ZERO_FORBIDDEN);
    ranges[8] = ownership.array(storage.recovery_initial.packets::*u8,
        storage.recovery_initial.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    ranges[9] = ownership.array(storage.recovery_handshake.packets::*u8,
        storage.recovery_handshake.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    ranges[10] = ownership.array(storage.recovery_application.packets::*u8,
        storage.recovery_application.capacity, $size_of(recovery.SentPacket),
        ownership.ZERO_FORBIDDEN);
    ranges[11] = ownership.array(storage.ack_initial.ranges::*u8,
        storage.ack_initial.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    ranges[12] = ownership.array(storage.ack_handshake.ranges::*u8,
        storage.ack_handshake.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    ranges[13] = ownership.array(storage.ack_application.ranges::*u8,
        storage.ack_application.capacity, $size_of(ack_api.Range),
        ownership.ZERO_FORBIDDEN);
    ranges[14] = ownership.array(storage.owners::*u8, storage.owner_capacity,
        $size_of(Owner), ownership.ZERO_FORBIDDEN);
    ranges[15] = ownership.array(storage.peer_extensions::*u8,
        storage.peer_extension_capacity, $size_of(transport_parameters.Parameter),
        ownership.ZERO_ALLOWED);
    ranges[16] = ownership.array(storage.local_extensions::*u8,
        storage.local_extension_capacity, $size_of(transport_parameters.Parameter),
        ownership.ZERO_ALLOWED);
    ranges[17] = ownership.bytes(storage.peer_extension_bytes,
        storage.peer_extension_byte_capacity, ownership.ZERO_ALLOWED);
    ranges[18] = ownership.bytes(storage.local_extension_bytes,
        storage.local_extension_byte_capacity, ownership.ZERO_ALLOWED);
    ranges[19] = ownership.bytes(storage.received_token,
        storage.received_token_capacity, ownership.ZERO_FORBIDDEN);
    ranges[20] = ownership.bytes(storage.send_token,
        storage.send_token_capacity, ownership.ZERO_FORBIDDEN);
    var zero_negotiation: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    if (config.role == transport_api.SERVER) {
        zero_negotiation = ownership.ZERO_ALLOWED;
    }
    ranges[21] = ownership.bytes(storage.negotiation.retry_token,
        storage.negotiation.retry_token_capacity, zero_negotiation);
    ranges[22] = ownership.bytes(storage.negotiation.retry_pseudo,
        storage.negotiation.retry_pseudo_capacity, zero_negotiation);
    # public-field anchors validate mixed records before field access
    ranges[23] = ownership.anchored_record[
        handshake_api.Adapter, handshake_api.Config](?handshake.config,
            $offset_of(handshake_api.Adapter, config));
    ranges[24] = ownership.record[cid_api.Manager](cids);
    ranges[25] = ownership.record[path_api.Manager](paths);
    ranges[26] = ownership.record[stream_api.Manager](streams);
    ranges[27] = ownership.record[datagram_api.Queue](datagrams);
    val anchored: ownership.Disjointness = ownership.disjointness(?ranges[0], 28);
    if (anchored.kind != ownership.OVERLAP_NONE) {
        ret refuse_overlap(result, INIT_COMPONENT_RANGES, anchored);
    }

    ranges[28] = ownership.bytes(handshake.storage.receive_data,
        handshake.storage.receive_length, ownership.ZERO_FORBIDDEN);
    ranges[29] = ownership.array(handshake.storage.receive_present::*u8,
        handshake.storage.receive_length, $size_of(bool),
        ownership.ZERO_FORBIDDEN);
    ranges[30] = ownership.bytes(handshake.storage.send_data,
        handshake.storage.send_length, ownership.ZERO_FORBIDDEN);
    ranges[31] = ownership.array(handshake.storage.send_pending::*u8,
        handshake.storage.send_length, $size_of(bool),
        ownership.ZERO_FORBIDDEN);
    ranges[32] = ownership.array(handshake.storage.send_acked::*u8,
        handshake.storage.send_length, $size_of(bool),
        ownership.ZERO_FORBIDDEN);
    ranges[33] = ownership.array(handshake.storage.send_inflight::*u8,
        handshake.storage.send_length, $size_of(u16),
        ownership.ZERO_FORBIDDEN);
    ranges[34] = ownership.array(handshake.storage.attempts::*u8,
        handshake.storage.attempt_capacity, $size_of(handshake_api.Attempt),
        ownership.ZERO_FORBIDDEN);
    ranges[35] = ownership.array(cids.storage.local::*u8,
        cids.storage.local_capacity, $size_of(cid_api.Entry),
        ownership.ZERO_FORBIDDEN);
    ranges[36] = ownership.array(cids.storage.peer::*u8,
        cids.storage.peer_capacity, $size_of(cid_api.Entry),
        ownership.ZERO_FORBIDDEN);
    ranges[37] = ownership.array(paths.storage.paths::*u8,
        paths.storage.path_capacity, $size_of(path_api.Path),
        ownership.ZERO_FORBIDDEN);
    ranges[38] = ownership.array(paths.storage.challenges::*u8,
        paths.storage.challenge_capacity, $size_of(path_api.Challenge),
        ownership.ZERO_FORBIDDEN);
    ranges[39] = ownership.array(paths.storage.responses::*u8,
        paths.storage.response_capacity, $size_of(path_api.Response),
        ownership.ZERO_FORBIDDEN);
    ranges[40] = ownership.array(paths.storage.sends::*u8,
        paths.storage.send_capacity, $size_of(path_api.SendReservation),
        ownership.ZERO_FORBIDDEN);
    ranges[41] = ownership.array(streams.storage.streams::*u8,
        streams.storage.stream_capacity, $size_of(stream_api.Stream),
        ownership.ZERO_FORBIDDEN);
    ranges[42] = ownership.array(streams.storage.attempts::*u8,
        streams.storage.attempt_capacity, $size_of(stream_api.Attempt),
        ownership.ZERO_FORBIDDEN);
    ranges[43] = ownership.bytes(streams.storage.send_data,
        streams.storage.send_data_length, ownership.ZERO_FORBIDDEN);
    ranges[44] = ownership.array(streams.storage.send_pending::*u8,
        streams.storage.send_state_length, $size_of(bool),
        ownership.ZERO_FORBIDDEN);
    ranges[45] = ownership.array(streams.storage.send_acked::*u8,
        streams.storage.send_state_length, $size_of(bool),
        ownership.ZERO_FORBIDDEN);
    ranges[46] = ownership.bytes(streams.storage.send_inflight,
        streams.storage.send_state_length, ownership.ZERO_FORBIDDEN);
    ranges[47] = ownership.bytes(streams.storage.receive_data,
        streams.storage.receive_data_length, ownership.ZERO_FORBIDDEN);
    ranges[48] = ownership.array(streams.storage.receive_present::*u8,
        streams.storage.receive_state_length, $size_of(bool),
        ownership.ZERO_FORBIDDEN);
    var datagram_zero: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    if (!datagrams.config.enabled) { datagram_zero = ownership.ZERO_ALLOWED; }
    ranges[49] = ownership.array(datagrams.storage.send_entries::*u8,
        datagrams.storage.send_capacity, $size_of(datagram_api.Entry), datagram_zero);
    ranges[50] = ownership.bytes(datagrams.storage.send_bytes,
        datagrams.storage.send_bytes_length, datagram_zero);
    ranges[51] = ownership.array(datagrams.storage.receive_entries::*u8,
        datagrams.storage.receive_capacity, $size_of(datagram_api.Entry), datagram_zero);
    ranges[52] = ownership.bytes(datagrams.storage.receive_bytes,
        datagrams.storage.receive_bytes_length, datagram_zero);
    if (!handshake_api.provider_ranges(handshake, ?ranges[53],
        handshake_api.PROVIDER_RANGE_CAPACITY)) {
        ret refuse(result, INIT_PROVIDER_RANGES);
    }
    val whole: ownership.Disjointness = ownership.disjointness(?ranges[0], 63);
    if (whole.kind != ownership.OVERLAP_NONE) {
        ret refuse_overlap(result, INIT_COMPONENT_RANGES, whole);
    }
    if (!handshake_api.provider_secrets_disjoint(handshake,
            secret_storage.receive_plaintext,
            secret_storage.receive_plaintext_capacity) ||
        !handshake_api.provider_secrets_disjoint(handshake,
            secret_storage.send_plaintext,
            secret_storage.send_plaintext_capacity)) {
        ret refuse(result, INIT_PROVIDER_SECRETS);
    }
    var borrowed: [4]ownership.Range;
    borrowed[0] = ownership.bytes(config.alpn.data, config.alpn.length,
        ownership.ZERO_FORBIDDEN);
    borrowed[1] = ownership.bytes(config.server_name.data, config.server_name.length,
        ownership.ZERO_ALLOWED);
    borrowed[2] = ownership.bytes(config.local_transport_parameters.data,
        config.local_transport_parameters.length, ownership.ZERO_FORBIDDEN);
    var zero_versions: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    if (config.role == transport_api.SERVER) { zero_versions = ownership.ZERO_ALLOWED; }
    borrowed[3] = ownership.array(config.supported_versions::*u8,
        config.supported_version_count, $size_of(u32), zero_versions);
    var i: usize = 0;
    for (i < 4) {
        val lent: ownership.Disjointness = ownership.disjoint_from(borrowed[i], i,
            ?ranges[0], 23, 63);
        if (lent.kind != ownership.OVERLAP_NONE) {
            ret refuse_overlap(result, INIT_COMPONENT_BORROWED, lent);
        }
        i = i + 1;
    }
    ret true;
}

fun initialize(core: *Core, secrets: *Secrets, config: Config, storage: Storage,
               secret_storage: SecretStorage, handshake: *handshake_api.Adapter,
               cids: *cid_api.Manager,
               paths: *path_api.Manager, streams: *stream_api.Manager,
               datagrams: *datagram_api.Queue, now_ns: u64,
               init_result: *InitResult) bool {
    if (!storage_valid(core, secrets, ?config, ?storage, ?secret_storage,
        init_result)) { ret false; }
    if (!component_storage_valid(core, secrets, ?config, ?storage, ?secret_storage, handshake,
        cids, paths, streams, datagrams, init_result)) { ret false; }
    if (core.initialized || core.destroyed ||
        !valid_role(config.role) || config.source == 0 ||
        (config.version != packet.VERSION_1 && config.version != packet.VERSION_2) ||
        config.max_udp_payload < 1200 || config.max_udp_payload > 65527 ||
        config.drain_timeout_ns == 0 || config.local_source.len == 0 ||
        config.peer_destination.len == 0 || config.initial_secret_destination.len == 0 ||
        config.original_destination.len == 0 || config.alpn.data == nil ||
        config.alpn.length == 0 || config.local_transport_parameters.data == nil ||
        config.local_transport_parameters.length == 0 ||
        secrets.initialized || secrets.destroyed || handshake == nil ||
        !handshake.initialized || handshake.started || handshake.core_lease != 0 ||
        handshake.config.source != config.source ||
        cids == nil || !cids.initialized || cids.core_lease != 0 ||
        cids.config.source != config.source ||
        paths == nil || paths.config.source != config.source || paths.core_lease != 0 ||
        !paths.valid || streams == nil || !streams.valid || streams.core_lease != 0 ||
        datagrams == nil || datagrams.core_lease != 0 ||
        !datagrams.valid || streams.config.source != config.source ||
        streams.send_max_data != 0 ||
        streams.config.local_bidirectional_limit != 0 ||
        streams.config.local_unidirectional_limit != 0 ||
        streams.config.send_local_bidirectional_limit != 0 ||
        streams.config.send_peer_bidirectional_limit != 0 ||
        streams.config.send_unidirectional_limit != 0 ||
        datagrams.config.source != config.source ||
        (datagrams.config.enabled && (datagrams.peer_limit_bound ||
            datagrams.config.peer_max_frame_size != 0)) ||
        (config.role == transport_api.CLIENT &&
        (paths.config.role != path_api.ROLE_CLIENT ||
        streams.config.role != stream_api.ROLE_CLIENT ||
        (config.supported_versions == nil ||
        config.supported_version_count == 0))) ||
        (config.role == transport_api.SERVER &&
        (paths.config.role != path_api.ROLE_SERVER ||
        streams.config.role != stream_api.ROLE_SERVER))) {
        ret refuse(init_result, INIT_PRECONDITION);
    }
    val current_local: cid_api.Selected = cid_api.current(cids, true);
    val current_peer: cid_api.Selected = cid_api.current(cids, false);
    val current_path: path_api.PathResult = path_api.selected(paths);
    if (current_local.status != cid_api.STATUS_OK ||
        current_peer.status != cid_api.STATUS_OK ||
        current_path.status != path_api.STATUS_OK ||
        !packet.connection_id_equal(?current_local.id, ?config.local_source) ||
        !packet.connection_id_equal(?current_peer.id,
            ?config.peer_destination) ||
        !path_api.endpoint_equal(paths.storage.paths[current_path.handle.index].endpoint,
            path_endpoint(config.local, config.peer))) {
        ret refuse(init_result, INIT_IDENTITY);
    }
    var local_parameters: transport_parameters.Parameters;
    val local_decoded: transport_parameters.DecodeResult =
        transport_parameters.decode(config.local_transport_parameters.data,
            config.local_transport_parameters.length, true,
            local_parameter_role(config.role), transport_parameters.default_limits(),
            transport_parameters.Storage{extensions: storage.local_extensions,
                extension_capacity: storage.local_extension_capacity,
                extension_bytes: storage.local_extension_bytes,
                extension_byte_capacity: storage.local_extension_byte_capacity},
            ?local_parameters);
    if (local_decoded.status != transport_parameters.STATUS_DONE ||
        !validate_local_parameters(config, ?local_parameters, cids, paths, streams,
            datagrams)) { ret refuse(init_result, INIT_PARAMETERS); }
    var candidate: Core;
    var candidate_secrets: Secrets;
    candidate.config = config;
    candidate.storage = storage;
    candidate_secrets.storage = secret_storage;
    candidate_secrets.handshake = handshake;
    candidate.cids = cids;
    candidate.paths = paths;
    candidate.streams = streams;
    candidate.datagrams = datagrams;
    candidate.local_parameters = local_parameters;
    candidate.role = config.role;
    candidate.state = transport_api.HANDSHAKING;
    candidate.next_owner = 1;
    candidate.last_activity_ns = now_ns;
    candidate.last_received_ns = now_ns;
    candidate.last_now_ns = now_ns;
    candidate.timer_generation = 1;
    candidate.send_max_udp_payload = config.max_udp_payload;
    candidate.idle_timeout_ns = config.max_idle_timeout_ns;
    candidate.idle_timer_enabled = config.max_idle_timeout_ns != 0;

    candidate.recovery_state = recovery.init(storage.recovery_initial,
        storage.recovery_handshake, storage.recovery_application,
        recovery.default_config());
    if (!candidate.recovery_state.valid || !recovery.set_peer_address_validated(
        ?candidate.recovery_state, config.peer_validated, now_ns).ok) {
        ret refuse(init_result, INIT_RECOVERY);
    }
    candidate.acknowledgements = ack_api.init(storage.ack_initial,
        storage.ack_handshake, storage.ack_application,
        saturated_multiply(local_parameters.max_ack_delay, 1000000),
        local_parameters.ack_delay_exponent::u8);
    if (!candidate.acknowledgements.valid) {
        ret refuse(init_result, INIT_RECOVERY);
    }
    if (config.role == transport_api.CLIENT) {
        if (!negotiation_api.initialize(?candidate.negotiation,
            negotiation_api.Config{
            supported_versions: config.supported_versions,
            supported_version_count: config.supported_version_count},
            storage.negotiation, config.version, config.original_destination,
            config.local_source)) { ret refuse(init_result, INIT_RECOVERY); }
    }
    var start: handshake_api.Start;
    start.role = role_handshake(config.role);
    start.version = config.version;
    start.server_name = handshake_api.View{data: config.server_name.data,
        length: config.server_name.length};
    start.alpn = handshake_api.View{data: config.alpn.data, length: config.alpn.length};
    start.local_transport_parameters = handshake_api.View{
        data: config.local_transport_parameters.data,
        length: config.local_transport_parameters.length};
    start.now_ns = now_ns;
    start.enable_early_data = config.enable_early_data;
    if (!handshake_api.lease_core(handshake, config.source)) {
        ret refuse(init_result, INIT_LEASE);
    }
    if (!cid_api.lease_core(cids, config.source)) {
        handshake_api.release_core(handshake, config.source);
        ret refuse(init_result, INIT_LEASE);
    }
    if (!path_api.lease_core(paths, config.source)) {
        cid_api.release_core(cids, config.source);
        handshake_api.release_core(handshake, config.source);
        ret refuse(init_result, INIT_LEASE);
    }
    if (!stream_api.lease_core(streams, config.source)) {
        path_api.release_core(paths, config.source);
        cid_api.release_core(cids, config.source);
        handshake_api.release_core(handshake, config.source);
        ret refuse(init_result, INIT_LEASE);
    }
    if (!datagram_api.lease_core(datagrams, config.source)) {
        stream_api.release_core(streams, config.source);
        path_api.release_core(paths, config.source);
        cid_api.release_core(cids, config.source);
        handshake_api.release_core(handshake, config.source);
        ret refuse(init_result, INIT_LEASE);
    }
    if (protection.derive_initial(?candidate_secrets.initial_keys, config.version,
        contracts.Bytes{data: ?config.initial_secret_destination.data[0],
            len: config.initial_secret_destination.len::usize}) != protection.OK) {
        datagram_api.release_core(datagrams, config.source);
        stream_api.release_core(streams, config.source);
        path_api.release_core(paths, config.source);
        cid_api.release_core(cids, config.source);
        handshake_api.release_core(handshake, config.source);
        ret refuse(init_result, INIT_KEYS);
    }
    if (path_api.configure_transport_scoped(paths, config.source, current_path.handle,
        candidate.recovery_state.rtt.smoothed_ns,
        now_ns).status != path_api.STATUS_OK) {
        datagram_api.release_core(datagrams, config.source);
        stream_api.release_core(streams, config.source);
        path_api.release_core(paths, config.source);
        cid_api.release_core(cids, config.source);
        handshake_api.release_core(handshake, config.source);
        protection.destroy_initial(?candidate_secrets.initial_keys);
        ret refuse(init_result, INIT_PATH);
    }
    val started: handshake_api.Result = handshake_api.start_scoped(handshake,
        config.source, ?start);
    if (started.status != handshake_api.STATUS_OK) {
        init_result.error = INTERNAL_ERROR;
        init_result.provider_error = started.provider_error;
        path_api.unconfigure_transport_scoped(paths, config.source, current_path.handle);
        datagram_api.release_core(datagrams, config.source);
        stream_api.release_core(streams, config.source);
        path_api.release_core(paths, config.source);
        cid_api.release_core(cids, config.source);
        handshake_api.release_core(handshake, config.source);
        protection.destroy_initial(?candidate_secrets.initial_keys);
        ret refuse(init_result, INIT_PROVIDER_START);
    }
    var i: usize = 0;
    for (i < storage.owner_capacity) {
        storage.owners[i].state = OWNER_FREE;
        storage.owners[i].generation = next_generation(storage.owners[i].generation);
        i = i + 1;
    }
    candidate_secrets.initialized = true;
    candidate.initialized = true;
    secrets[0] = candidate_secrets;
    core[0] = candidate;
    init_result.ok = true;
    ret true;
}

pub fun init_client_result(core: *Core, secrets: *Secrets, config: Config,
                           storage: Storage, secret_storage: SecretStorage,
                           handshake: *handshake_api.Adapter,
                           cids: *cid_api.Manager, paths: *path_api.Manager,
                           streams: *stream_api.Manager,
                           datagrams: *datagram_api.Queue,
                           now_ns: u64) InitResult {
    var init_result: InitResult;
    if (config.role != transport_api.CLIENT) {
        init_result.error = INTERNAL_ERROR;
        init_result.reason = INIT_ARGUMENT;
        ret init_result;
    }
    if (!initialize(core, secrets, config, storage, secret_storage, handshake,
        cids, paths, streams, datagrams, now_ns, ?init_result) &&
        init_result.error == NO_ERROR) {
        init_result.error = INTERNAL_ERROR;
    }
    ret init_result;
}

pub fun init_server_result(core: *Core, secrets: *Secrets, config: Config,
                           storage: Storage, secret_storage: SecretStorage,
                           handshake: *handshake_api.Adapter,
                           cids: *cid_api.Manager, paths: *path_api.Manager,
                           streams: *stream_api.Manager,
                           datagrams: *datagram_api.Queue,
                           now_ns: u64) InitResult {
    var init_result: InitResult;
    if (config.role != transport_api.SERVER) {
        init_result.error = INTERNAL_ERROR;
        init_result.reason = INIT_ARGUMENT;
        ret init_result;
    }
    if (!initialize(core, secrets, config, storage, secret_storage, handshake,
        cids, paths, streams, datagrams, now_ns, ?init_result) &&
        init_result.error == NO_ERROR) {
        init_result.error = INTERNAL_ERROR;
    }
    ret init_result;
}

pub fun init_client(core: *Core, secrets: *Secrets, config: Config, storage: Storage,
                    secret_storage: SecretStorage,
                    handshake: *handshake_api.Adapter, cids: *cid_api.Manager,
                    paths: *path_api.Manager, streams: *stream_api.Manager,
                    datagrams: *datagram_api.Queue, now_ns: u64) bool {
    ret init_client_result(core, secrets, config, storage, secret_storage,
        handshake, cids, paths, streams, datagrams, now_ns).ok;
}

pub fun init_server(core: *Core, secrets: *Secrets, config: Config, storage: Storage,
                    secret_storage: SecretStorage,
                    handshake: *handshake_api.Adapter, cids: *cid_api.Manager,
                    paths: *path_api.Manager, streams: *stream_api.Manager,
                    datagrams: *datagram_api.Queue, now_ns: u64) bool {
    ret init_server_result(core, secrets, config, storage, secret_storage,
        handshake, cids, paths, streams, datagrams, now_ns).ok;
}

# rolls back a successful core init before the assembly becomes observable
pub fun abandon_initialization(core: *Core, secrets: *Secrets) bool {
    if (!core_record_valid(core) || !secret_record_valid(secrets) ||
        !core.initialized || core.destroyed || core.closing ||
        core.state != transport_api.HANDSHAKING || !secrets.initialized ||
        secrets.destroyed || core.authenticated_packets != 0 ||
        core.retry_count != 0 || core.version_restart_count != 0 ||
        core.next_owner != 1 || core.next_owner_slot != 0) { ret false; }
    var i: usize = 0;
    for (i < core.storage.owner_capacity) {
        if (core.storage.owners[i].state != OWNER_FREE) { ret false; }
        i = i + 1;
    }
    val selected: path_api.PathResult = path_api.selected(core.paths);
    if (selected.status != path_api.STATUS_OK ||
        path_api.unconfigure_transport_scoped(core.paths, core.config.source,
            selected.handle).status != path_api.STATUS_OK ||
        !datagram_api.release_core(core.datagrams, core.config.source) ||
        !stream_api.release_core(core.streams, core.config.source) ||
        !path_api.release_core(core.paths, core.config.source) ||
        !cid_api.release_core(core.cids, core.config.source) ||
        !handshake_api.abandon_core(secrets.handshake, core.config.source)) {
        ret false;
    }
    protection.destroy_initial(?secrets.initial_keys);
    protection.destroy(?secrets.early_send);
    protection.destroy(?secrets.early_receive);
    protection.destroy(?secrets.handshake_send);
    protection.destroy(?secrets.handshake_receive);
    protection.destroy_send(?secrets.application_send);
    protection.destroy_receive(?secrets.application_receive);
    ct.zeroize(secrets.storage.receive_plaintext,
        secrets.storage.receive_plaintext_capacity);
    ct.zeroize(secrets.storage.send_plaintext,
        secrets.storage.send_plaintext_capacity);
    var empty_core: Core;
    var empty_secrets: Secrets;
    core[0] = empty_core;
    secrets[0] = empty_secrets;
    ret true;
}

fun install_secret(core: *Core, secrets: *Secrets,
                   event: *handshake_api.Event) bool {
    val secret: contracts.SecretBytes = contracts.SecretBytes{
        data: event.secret.data, len: event.secret.length};
    var error: protection.Error = protection.INVALID_INPUT;
    if (event.level == handshake_api.EARLY) {
        if (event.direction == handshake_api.DIRECTION_SEND) {
            error = protection.derive_tls(?secrets.early_send, core.config.version,
                protection.LEVEL_EARLY, event.algorithm, secret);
        } or {
            error = protection.derive_tls(?secrets.early_receive, core.config.version,
                protection.LEVEL_EARLY, event.algorithm, secret);
        }
    }
    if (event.level == handshake_api.HANDSHAKE) {
        if (event.direction == handshake_api.DIRECTION_SEND) {
            error = protection.derive_tls(?secrets.handshake_send, core.config.version,
                protection.LEVEL_HANDSHAKE, event.algorithm, secret);
        } or {
            error = protection.derive_tls(?secrets.handshake_receive, core.config.version,
                protection.LEVEL_HANDSHAKE, event.algorithm, secret);
        }
    }
    if (event.level == handshake_api.APPLICATION) {
        if (event.direction == handshake_api.DIRECTION_SEND) {
            error = protection.init_send(?secrets.application_send, core.config.version,
                event.algorithm, secret);
        } or {
            error = protection.init_receive(?secrets.application_receive,
                core.config.version, event.algorithm, secret);
        }
    }
    if (error != protection.OK) { ret false; }
    if (event.level == handshake_api.HANDSHAKE &&
        !recovery.set_handshake_keys(?core.recovery_state, true,
            core.last_now_ns).ok) {
        ret false;
    }
    ret true;
}

fun validate_peer_parameters(core: *Core, parameters: *transport_parameters.Parameters) bool {
    if (!packet.connection_id_equal(?parameters.initial_source_connection_id,
        ?core.config.peer_destination)) { ret false; }
    if (core.role == transport_api.CLIENT) {
        if (!packet.connection_id_equal(?parameters.original_destination_connection_id,
            ?core.config.original_destination)) { ret false; }
        if (core.retry_source_present) {
            if (!transport_parameters.has(parameters,
                transport_parameters.RETRY_SOURCE_CONNECTION_ID) ||
                !packet.connection_id_equal(?parameters.retry_source_connection_id,
                    ?core.retry_source_connection_id)) { ret false; }
        } or (transport_parameters.has(parameters,
            transport_parameters.RETRY_SOURCE_CONNECTION_ID)) { ret false; }
    }
    ret true;
}

fun accept_parameters(core: *Core, event: *handshake_api.Event) bool {
    var parameters: transport_parameters.Parameters;
    val decoded: transport_parameters.DecodeResult = transport_parameters.decode(
        event.data.data, event.data.length, true, peer_parameter_role(core.role),
        transport_parameters.default_limits(), transport_parameters.Storage{
            extensions: core.storage.peer_extensions,
            extension_capacity: core.storage.peer_extension_capacity,
            extension_bytes: core.storage.peer_extension_bytes,
            extension_byte_capacity: core.storage.peer_extension_byte_capacity},
        ?parameters);
    if (decoded.status != transport_parameters.STATUS_DONE ||
        !validate_peer_parameters(core, ?parameters)) { ret false; }
    if (transport_parameters.has(?parameters,
        transport_parameters.STATELESS_RESET_TOKEN) &&
        cid_api.install_initial_peer_reset_token_scoped(core.cids,
            core.config.source,
            parameters.stateless_reset_token).status != cid_api.STATUS_OK) {
        ret false;
    }
    core.peer_parameters = parameters;
    core.peer_parameters_ready = true;
    core.paths.config.peer_disabled_active_migration =
        parameters.disable_active_migration;
    if (stream_api.apply_peer_limits_scoped(core.streams, core.config.source,
            parameters.initial_max_data,
            parameters.initial_max_stream_data_bidi_local,
            parameters.initial_max_stream_data_bidi_remote,
            parameters.initial_max_stream_data_uni,
            parameters.initial_max_streams_bidi,
            parameters.initial_max_streams_uni).status == stream_api.STATUS_ERROR ||
        cid_api.update_local_limit_scoped(core.cids, core.config.source,
            parameters.active_connection_id_limit).status != cid_api.STATUS_OK) {
        ret false;
    }
    if (parameters.max_udp_payload_size::usize < core.send_max_udp_payload) {
        core.send_max_udp_payload = parameters.max_udp_payload_size::usize;
    }
    if (core.paths.config.maximum_mtu::usize > core.send_max_udp_payload) {
        core.paths.config.maximum_mtu = core.send_max_udp_payload::u16;
    }
    if (!recovery.set_max_ack_delay(?core.recovery_state,
        saturated_multiply(parameters.max_ack_delay, 1000000),
        core.last_now_ns).ok) { ret false; }
    if (parameters.max_idle_timeout != 0) {
        val peer_idle: u64 = saturated_multiply(
            parameters.max_idle_timeout, 1000000);
        if (!core.idle_timer_enabled || peer_idle < core.idle_timeout_ns) {
            core.idle_timeout_ns = peer_idle;
        }
        core.idle_timer_enabled = true;
    }
    if (core.datagrams.config.enabled &&
        datagram_api.bind_peer_limit_scoped(core.datagrams, core.config.source,
            parameters.max_datagram_frame_size::usize).status !=
            datagram_api.STATUS_OK) { ret false; }
    ret true;
}

fun discard_initial_keys(core: *Core, secrets: *Secrets) bool {
    if (core.initial_keys_discarded) { ret true; }
    val initial_index: usize = space_index(packet.SPACE_INITIAL);
    if (core.recovery_state.spaces[initial_index].len >
        core.storage.recovery_event_capacity) { ret false; }
    val before: u64 = core.recovery_state.bytes_in_flight::u64;
    val initial: recovery.DiscardResult = recovery.discard_space(
        ?core.recovery_state, packet.SPACE_INITIAL, core.last_now_ns,
        core.storage.recovery_events, core.storage.recovery_event_capacity);
    if (!initial.ok || !apply_recovery_events(core, secrets,
        initial.event_count, core.last_now_ns, false, false, before)) { ret false; }
    protection.destroy_initial(?secrets.initial_keys);
    if (!ack_api.discard_space(?core.acknowledgements, packet.SPACE_INITIAL)) {
        ret false;
    }
    core.initial_keys_discarded = true;
    ret true;
}

fun confirm_handshake(core: *Core, secrets: *Secrets) bool {
    if (core.handshake_confirmed) { ret true; }
    val handshake_index: usize = space_index(packet.SPACE_HANDSHAKE);
    if (core.recovery_state.spaces[handshake_index].len >
        core.storage.recovery_event_capacity ||
        !recovery.confirm_handshake(?core.recovery_state,
            core.last_now_ns).ok ||
        path_api.confirm_handshake_scoped(core.paths, core.config.source).status != path_api.STATUS_OK ||
        protection.confirm_handshake_send(?secrets.application_send) != protection.OK ||
        protection.confirm_handshake_receive(?secrets.application_receive) != protection.OK ||
        !discard_initial_keys(core, secrets)) {
        ret false;
    }
    val handshake_before: u64 = core.recovery_state.bytes_in_flight::u64;
    val handshake_discarded: recovery.DiscardResult = recovery.discard_space(
        ?core.recovery_state, packet.SPACE_HANDSHAKE, core.last_now_ns,
        core.storage.recovery_events, core.storage.recovery_event_capacity);
    if (!handshake_discarded.ok || !apply_recovery_events(core, secrets,
        handshake_discarded.event_count, core.last_now_ns, false, false,
        handshake_before)) { ret false; }
    protection.destroy(?secrets.handshake_send);
    protection.destroy(?secrets.handshake_receive);
    ack_api.discard_space(?core.acknowledgements, packet.SPACE_HANDSHAKE);
    core.handshake_confirmed = true;
    core.state = transport_api.ACTIVE;
    if (core.role == transport_api.SERVER) {
        core.handshake_done_queued = true;
    }
    ret true;
}

fun pump_handshake(core: *Core, secrets: *Secrets) u64 {
    var count: usize = 0;
    for (count < 64) {
        val event: handshake_api.Event = handshake_api.next_event_scoped(
            secrets.handshake, core.config.source);
        if (event.status == handshake_api.STATUS_EMPTY) { ret NO_ERROR; }
        if (event.status != handshake_api.STATUS_OK) {
            if (event.error == handshake_api.ERROR_PROVIDER) {
                core.last_provider_error = event.provider_error;
            }
            ret INTERNAL_ERROR;
        }
        var accepted: bool = true;
        var rejected_error: u64 = CRYPTO_ERROR_BASE;
        if (event.kind == handshake_api.EVENT_TRAFFIC_SECRET) {
            accepted = install_secret(core, secrets, ?event);
            rejected_error = INTERNAL_ERROR;
        }
        if (event.kind == handshake_api.EVENT_PEER_TRANSPORT_PARAMETERS) {
            accepted = accept_parameters(core, ?event);
            rejected_error = TRANSPORT_PARAMETER_ERROR;
        }
        if (event.kind == handshake_api.EVENT_EARLY_DATA) {
            core.early_disposition = event.disposition;
            if (event.disposition == handshake_api.EARLY_REJECTED) {
                protection.destroy(?secrets.early_send);
                protection.destroy(?secrets.early_receive);
            }
        }
        if (event.kind == handshake_api.EVENT_AUTHENTICATION) {
            core.peer_authenticated = event.disposition == handshake_api.AUTHENTICATED;
            accepted = core.peer_authenticated;
        }
        if (event.kind == handshake_api.EVENT_ALERT) {
            core.close_error = CRYPTO_ERROR_BASE + event.alert;
        }
        val completed: handshake_api.Result = handshake_api.complete_event_scoped(
            secrets.handshake, core.config.source, event.token, accepted);
        if (completed.status != handshake_api.STATUS_OK) {
            if (!accepted && completed.error == handshake_api.ERROR_REJECTED) {
                ret rejected_error;
            }
            ret handshake_failure(core, completed);
        }
        if (!accepted) { ret rejected_error; }
        if (event.kind == handshake_api.EVENT_HANDSHAKE_COMPLETE) {
            if (core.role == transport_api.SERVER) {
                if (!confirm_handshake(core, secrets)) { ret INTERNAL_ERROR; }
            } or {
                core.state = transport_api.ACTIVE;
            }
        }
        if (event.kind == handshake_api.EVENT_ALERT) {
            if (!begin_application_close(core)) { ret INTERNAL_ERROR; }
            core.closing = true;
            core.close_queued = true;
            core.close_started_ns = core.last_now_ns;
            core.close_deadline_ns = saturated_add(core.last_now_ns,
                core.config.drain_timeout_ns);
            core.state = transport_api.CLOSING;
            ret NO_ERROR;
        }
        count = count + 1;
    }
    ret INTERNAL_ERROR;
}

fun kind_from_bits(version: u32, bits: u8) u8 {
    if (version == packet.VERSION_1) {
        if (bits == 0) { ret packet.PACKET_INITIAL; }
        if (bits == 1) { ret packet.PACKET_ZERO_RTT; }
        if (bits == 2) { ret packet.PACKET_HANDSHAKE; }
        ret packet.PACKET_RETRY;
    }
    if (version == packet.VERSION_2) {
        if (bits == 0) { ret packet.PACKET_RETRY; }
        if (bits == 1) { ret packet.PACKET_INITIAL; }
        if (bits == 2) { ret packet.PACKET_ZERO_RTT; }
        ret packet.PACKET_HANDSHAKE;
    }
    ret packet.PACKET_UNKNOWN_VERSION;
}

fun read_id(data: *u8, length: usize, position: *usize,
            output: *packet.ConnectionId) bool {
    if (@position >= length) { ret false; }
    val width: usize = data[@position]::usize;
    @position = @position + 1;
    if (width > packet.MAX_CONNECTION_ID || width > length - @position) { ret false; }
    if (!packet.set_connection_id(output, ?data[@position], width)) { ret false; }
    @position = @position + width;
    ret true;
}

fun envelope(data: *u8, length: usize, offset: usize,
             short_destination_length: u8) Envelope {
    var result: Envelope;
    result.offset = offset;
    if (data == nil || offset >= length) { ret result; }
    val first: u8 = data[offset];
    if ((first & 0x80) == 0) {
        if ((first & 0x40) == 0 || short_destination_length::usize >
            packet.MAX_CONNECTION_ID || short_destination_length::usize >
            length - offset - 1) { ret result; }
        result.kind = packet.PACKET_ONE_RTT;
        result.length = length - offset;
        result.packet_number_offset = 1 + short_destination_length::usize;
        packet.set_connection_id(?result.destination, ?data[offset + 1],
            short_destination_length::usize);
        result.valid = result.packet_number_offset < result.length;
        ret result;
    }
    if (length - offset < 7) { ret result; }
    result.version = binary.get_uint(?data[offset + 1], 4, binary.BIG)::u32;
    if (result.version != 0 && (first & 0x40) == 0) { ret result; }
    var position: usize = offset + 5;
    if (!read_id(data, length, ?position, ?result.destination) ||
        !read_id(data, length, ?position, ?result.source)) { ret result; }
    if (result.version == 0) {
        result.kind = packet.PACKET_VERSION_NEGOTIATION;
        result.length = length - offset;
        result.valid = true;
        ret result;
    }
    result.kind = kind_from_bits(result.version, (first >> 4) & 3);
    if (result.kind == packet.PACKET_RETRY ||
        result.kind == packet.PACKET_UNKNOWN_VERSION) {
        result.length = length - offset;
        result.valid = true;
        ret result;
    }
    var decoder: binary.Decoder = binary.decoder(?data[position],
        length - position, binary.BIG);
    if (result.kind == packet.PACKET_INITIAL) {
        val token_length: varint.Decoded = varint.read(?decoder, false);
        if (token_length.status != varint.STATUS_DONE ||
            token_length.value > (decoder.len - decoder.pos)::u64) { ret result; }
        result.token.len = token_length.value::usize;
        if (result.token.len > 0) {
            result.token.data = ?decoder.data[decoder.pos];
        }
        decoder.pos = decoder.pos + result.token.len;
    }
    val encoded_length: varint.Decoded = varint.read(?decoder, false);
    if (encoded_length.status != varint.STATUS_DONE || encoded_length.value < 1 ||
        encoded_length.value > (decoder.len - decoder.pos)::u64) { ret result; }
    position = position + decoder.pos;
    result.packet_number_offset = position - offset;
    result.length = result.packet_number_offset + encoded_length.value::usize;
    result.valid = result.length <= length - offset;
    ret result;
}

fun local_destination(core: *Core, value: *packet.ConnectionId,
                      kind: u8) cid_api.Selected {
    val matched: cid_api.Selected = cid_api.match_local(core.cids, value);
    if (matched.status == cid_api.STATUS_OK) { ret matched; }
    var result: cid_api.Selected;
    if (kind == packet.PACKET_INITIAL && packet.connection_id_equal(value,
            ?core.config.initial_secret_destination)) {
        result.status = cid_api.STATUS_OK;
        result.id = @value;
        ret result;
    }
    result.status = cid_api.STATUS_STALE;
    ret result;
}

fun receive_keys(core: *Core, secrets: *Secrets,
                 level: handshake_api.Level) *protection.KeySet {
    if (level == handshake_api.INITIAL) {
        if (core.role == transport_api.CLIENT) { ret ?secrets.initial_keys.server; }
        ret ?secrets.initial_keys.client;
    }
    if (level == handshake_api.EARLY) { ret ?secrets.early_receive; }
    if (level == handshake_api.HANDSHAKE) { ret ?secrets.handshake_receive; }
    ret nil;
}

fun owner_by_id(core: *Core, owner: u64) *Owner {
    var i: usize = 0;
    for (i < core.storage.owner_capacity) {
        if (core.storage.owners[i].state != OWNER_FREE &&
            core.storage.owners[i].owner == owner) { ret ?core.storage.owners[i]; }
        i = i + 1;
    }
    ret nil;
}

fun free_owner(value: *Owner) {
    value.state = OWNER_FREE;
    value.generation = next_generation(value.generation);
}

fun terminal_owner(core: *Core, secrets: *Secrets,
                   event: *recovery.Event, now_ns: u64,
                   persistent: bool) bool {
    val owner: *Owner = owner_by_id(core, event.owner);
    if (owner == nil || owner.state != OWNER_SENT || owner.packet_number != event.number ||
        owner.space != event.space) { ret false; }
    var terminal: u8 = handshake_api.TERMINAL_LOST;
    var stream_terminal: u8 = stream_api.TERMINAL_LOST;
    if (event.kind == recovery.EVENT_ACKED) {
        terminal = handshake_api.TERMINAL_ACKED;
        stream_terminal = stream_api.TERMINAL_ACKED;
        if (event.space == packet.SPACE_APPLICATION &&
            secrets.application_send.state == protection.STATE_ACTIVE) {
            protection.note_acknowledged(?secrets.application_send, event.number);
        }
    }
    if (owner.kind == OWNER_CRYPTO && handshake_api.on_terminal_scoped(secrets.handshake, core.config.source, owner.handshake, terminal).status != handshake_api.STATUS_OK) { ret false; }
    if (owner.kind == OWNER_STREAM && stream_api.on_terminal_scoped(core.streams, core.config.source,
        owner.stream, stream_terminal).status != stream_api.STATUS_OK) { ret false; }
    if (owner.kind == OWNER_ACK && event.kind == recovery.EVENT_ACKED &&
        !ack_api.on_ack_packet_acked(?core.acknowledgements, owner.space,
            owner.ack_largest)) { ret false; }
    if (owner.kind == OWNER_CID_RETIREMENT &&
        cid_api.retirement_terminal_scoped(core.cids, core.config.source,
            owner.cid_retirement,
            event.kind == recovery.EVENT_ACKED).status != cid_api.STATUS_OK) {
        ret false;
    }
    if (owner.kind == OWNER_NEW_CID &&
        cid_api.advertisement_terminal_scoped(core.cids, core.config.source,
            owner.cid_retirement,
            event.kind == recovery.EVENT_ACKED).status != cid_api.STATUS_OK) {
        ret false;
    }
    if (owner.kind == OWNER_HANDSHAKE_DONE &&
        event.kind != recovery.EVENT_ACKED) {
        core.handshake_done_queued = true;
    }
    if (owner.kind == OWNER_NEW_TOKEN) {
        core.send_token_prepared = false;
        if (event.kind == recovery.EVENT_ACKED) {
            core.send_token_length = 0;
        } or {
            core.send_token_queued = true;
        }
    }
    val path_handle: path_api.Handle = path_api.Handle{
        source: owner.path_send.source, index: owner.path_send.path_index,
        generation: owner.path_send.path_generation};
    if (path_handle.source == 0 || path_handle.index >=
            core.paths.storage.path_capacity ||
        !core.paths.storage.paths[path_handle.index].valid ||
        core.paths.storage.paths[path_handle.index].generation !=
            path_handle.generation) { ret false; }
    val transport_path: *path_api.Path =
        ?core.paths.storage.paths[path_handle.index];
    val selected: path_api.PathResult = path_api.selected(core.paths);
    val path_persistent: bool = persistent &&
        selected.status == path_api.STATUS_OK &&
        selected.handle.source == path_handle.source &&
        selected.handle.index == path_handle.index &&
        selected.handle.generation == path_handle.generation;
    val updated: congestion_api.UpdateResult = congestion_api.on_recovery(
        ?transport_path.congestion, congestion_api.Signals{
            events: event, event_count: 1,
            bytes_in_flight_before: transport_path.recovery_bytes_in_flight,
            now_ns: now_ns,
            smoothed_rtt_ns: core.recovery_state.rtt.smoothed_ns,
            ecn_congestion: false,
            ecn_sent_at_ns: 0,
            persistent_congestion: path_persistent &&
                event.kind == recovery.EVENT_LOST,
            growth_permitted: owner.growth_permitted,
            retry: event.kind == recovery.EVENT_RETRY});
    if (!updated.ok) { ret false; }
    if (owner.kind == OWNER_MTU_PROBE) {
        var terminal: u8 = path_api.MTU_TERMINAL_LOST;
        if (event.kind == recovery.EVENT_ACKED) {
            terminal = path_api.MTU_TERMINAL_ACKED;
        }
        val mtu: path_api.MtuResult = path_api.on_mtu_terminal_scoped(core.paths, core.config.source,
            owner.mtu_probe, terminal);
        if (mtu.status != path_api.STATUS_OK) { ret false; }
        if (mtu.reconfigure_congestion &&
            !congestion_api.set_max_datagram_size(?transport_path.congestion,
                mtu.current_mtu::u64, now_ns).ok) { ret false; }
        if (mtu.reconfigure_pacer && !pacer_api.reconfigure(?transport_path.pacer,
            pacer_api.default_config(mtu.current_mtu::u64,
                transport_path.congestion.congestion_window), now_ns,
            transport_path.congestion.congestion_window,
            core.recovery_state.rtt.smoothed_ns).ok) { ret false; }
    } or (owner.path_send.source != 0) {
        if (event.kind == recovery.EVENT_ACKED) {
            if (path_api.on_packet_acked_scoped(core.paths, core.config.source, path_handle,
                owner.bytes::u16).status != path_api.STATUS_OK) { ret false; }
        } or (event.kind == recovery.EVENT_LOST) {
            val mtu: path_api.MtuResult = path_api.on_large_packet_lost_scoped(
                core.paths, core.config.source, path_handle, owner.bytes::u16);
            if (mtu.status != path_api.STATUS_OK) { ret false; }
            if (mtu.reconfigure_congestion &&
                !congestion_api.set_max_datagram_size(?transport_path.congestion,
                    mtu.current_mtu::u64, now_ns).ok) { ret false; }
            if (mtu.reconfigure_pacer && !pacer_api.reconfigure(?transport_path.pacer,
                pacer_api.default_config(mtu.current_mtu::u64,
                    transport_path.congestion.congestion_window), now_ns,
                transport_path.congestion.congestion_window,
                core.recovery_state.rtt.smoothed_ns).ok) { ret false; }
        }
    }
    if (path_api.recovery_terminal_scoped(core.paths, core.config.source, path_handle,
            owner.bytes::u64).status != path_api.STATUS_OK ||
        !pacer_api.sync(?transport_path.pacer, now_ns,
            transport_path.congestion.congestion_window,
            core.recovery_state.rtt.smoothed_ns).ok ||
        path_api.release_recovery_scoped(core.paths, core.config.source,
            path_handle).status != path_api.STATUS_OK) { ret false; }
    free_owner(owner);
    ret true;
}

fun apply_recovery_events(core: *Core, secrets: *Secrets, count: usize, now_ns: u64,
                          persistent: bool, retry_event: bool,
                          bytes_before: u64) bool {
    var i: usize = 0;
    for (i < count) {
        if (!terminal_owner(core, secrets, ?core.storage.recovery_events[i],
            now_ns, persistent)) { ret false; }
        i = i + 1;
    }
    if (retry_event && count == 0) {
        val selected: path_api.PathResult = path_api.selected(core.paths);
        if (selected.status != path_api.STATUS_OK ||
            path_api.configure_transport_scoped(core.paths, core.config.source, selected.handle,
                core.recovery_state.rtt.smoothed_ns,
                now_ns).status != path_api.STATUS_OK) { ret false; }
        val retry_path: *path_api.Path =
            ?core.paths.storage.paths[selected.handle.index];
        if (!congestion_api.reset(?retry_path.congestion, now_ns).ok ||
            !pacer_api.reset(?retry_path.pacer,
                retry_path.congestion.congestion_window,
                core.recovery_state.rtt.smoothed_ns, now_ns).ok) { ret false; }
    }
    ret true;
}

fun handle_ack(core: *Core, secrets: *Secrets, space: u8, value: *frame.Frame,
               now_ns: u64) bool {
    val before: u64 = core.recovery_state.bytes_in_flight::u64;
    val selected: path_api.PathResult = path_api.selected(core.paths);
    if (selected.status != path_api.STATUS_OK) { ret false; }
    val acknowledged: recovery.AckResult = recovery.on_ack_path(
        ?core.recovery_state,
        space, value, now_ns, core.peer_parameters.ack_delay_exponent::u8,
        selected.handle.source, selected.handle.index,
        selected.handle.generation,
        core.storage.recovery_events, core.storage.recovery_event_capacity);
    if (!acknowledged.ok) { ret false; }
    ret apply_recovery_events(core, secrets, acknowledged.event_count, now_ns,
        acknowledged.persistent_congestion, false, before);
}

fun apply_path_signals(core: *Core, reset_congestion: bool,
                       reset_rtt: bool, rotate_connection_id: bool,
                       now_ns: u64) bool {
    if (rotate_connection_id &&
        cid_api.rotate_peer_scoped(core.cids,
            core.config.source).status == cid_api.STATUS_ERROR) {
        ret false;
    }
    if (reset_rtt && !recovery.reset_path(?core.recovery_state, now_ns).ok) {
        ret false;
    }
    val selected: path_api.PathResult = path_api.selected(core.paths);
    if (selected.status != path_api.STATUS_OK ||
        path_api.configure_transport_scoped(core.paths, core.config.source, selected.handle,
            core.recovery_state.rtt.smoothed_ns,
            now_ns).status != path_api.STATUS_OK) { ret false; }
    val current: *path_api.Path =
        ?core.paths.storage.paths[selected.handle.index];
    if (reset_congestion &&
        !congestion_api.reset(?current.congestion, now_ns).ok) { ret false; }
    if ((reset_congestion || reset_rtt) &&
        !pacer_api.reset(?current.pacer,
            current.congestion.congestion_window,
            core.recovery_state.rtt.smoothed_ns, now_ns).ok) { ret false; }
    ret true;
}

fun close_from_peer(core: *Core, value: *frame.Frame, now_ns: u64) bool {
    if (core.closing) { ret true; }
    if (!begin_application_close(core)) { ret false; }
    core.closing = true;
    core.close_queued = false;
    core.close_error = value.error_code;
    core.close_frame_type = value.frame_type;
    core.close_started_ns = now_ns;
    core.close_deadline_ns = saturated_add(now_ns,
        core.config.drain_timeout_ns);
    core.state = transport_api.DRAINING;
    core.peer_close_received = true;
    ret true;
}

fun stateless_reset(core: *Core, data: *u8, length: usize) bool {
    if (length < 21) { ret false; }
    val tail: usize = length - 16;
    var matched: u8 = 0;
    var i: usize = 0;
    for (i < core.cids.storage.peer_capacity) {
        val entry: *cid_api.Entry = ?core.cids.storage.peer[i];
        var valid: u8 = 0;
        if (entry.state != cid_api.ENTRY_FREE && entry.reset_token_present) {
            valid = 1;
        }
        var difference: u8 = 0;
        var j: usize = 0;
        for (j < 16) {
            difference = difference | (entry.reset_token[j] ^ data[tail + j]);
            j = j + 1;
        }
        var equal: u8 = 0;
        if (difference == 0) { equal = 1; }
        matched = matched | (equal & valid);
        i = i + 1;
    }
    ret matched != 0;
}

fun enter_stateless_reset(core: *Core, now_ns: u64) bool {
    if (!begin_application_close(core)) { ret false; }
    core.closing = true;
    core.close_queued = false;
    core.peer_close_received = true;
    core.close_started_ns = now_ns;
    core.close_deadline_ns = saturated_add(now_ns,
        core.config.drain_timeout_ns);
    core.state = transport_api.DRAINING;
    ret true;
}

fun frame_allowed(core: *Core, level: handshake_api.Level,
                  value: *frame.Frame) bool {
    if ((value.kind == frame.ACK || value.kind == frame.ACK_ECN) &&
        level == handshake_api.EARLY) { ret false; }
    if (value.kind == frame.CRYPTO && level != handshake_api.INITIAL &&
        level != handshake_api.HANDSHAKE && level != handshake_api.APPLICATION) {
        ret false;
    }
    if ((frame.is_stream(value.kind) || value.kind == frame.RESET_STREAM ||
        value.kind == frame.STOP_SENDING || value.kind == frame.MAX_DATA ||
        value.kind == frame.MAX_STREAM_DATA || value.kind == frame.MAX_STREAMS_BIDI ||
        value.kind == frame.MAX_STREAMS_UNI || value.kind == frame.DATA_BLOCKED ||
        value.kind == frame.STREAM_DATA_BLOCKED ||
        value.kind == frame.STREAMS_BLOCKED_BIDI ||
        value.kind == frame.STREAMS_BLOCKED_UNI || value.kind == frame.DATAGRAM ||
        value.kind == frame.DATAGRAM_LEN) && level != handshake_api.EARLY &&
        level != handshake_api.APPLICATION) { ret false; }
    if ((value.kind == frame.NEW_CONNECTION_ID ||
        value.kind == frame.RETIRE_CONNECTION_ID ||
        value.kind == frame.PATH_CHALLENGE || value.kind == frame.PATH_RESPONSE ||
        value.kind == frame.HANDSHAKE_DONE || value.kind == frame.NEW_TOKEN) &&
        level != handshake_api.APPLICATION) { ret false; }
    if (value.kind == frame.CONNECTION_CLOSE_TRANSPORT &&
        level == handshake_api.EARLY) { ret false; }
    if (value.kind == frame.CONNECTION_CLOSE_APPLICATION &&
        level != handshake_api.EARLY &&
        level != handshake_api.APPLICATION) { ret false; }
    ret true;
}

fun stream_failure(core: *Core, error: u8) bool {
    if (error == stream_api.ERROR_STREAM_LIMIT) {
        core.close_error = STREAM_LIMIT_ERROR;
    } or (error == stream_api.ERROR_FLOW_CONTROL) {
        core.close_error = FLOW_CONTROL_ERROR;
    } or (error == stream_api.ERROR_FINAL_SIZE) {
        core.close_error = FINAL_SIZE_ERROR;
    } or (error == stream_api.ERROR_DIRECTION) {
        core.close_error = STREAM_STATE_ERROR;
    } or (error == stream_api.ERROR_CAPACITY ||
        error == stream_api.ERROR_STATE || error == stream_api.ERROR_TOKEN) {
        core.close_error = INTERNAL_ERROR;
    } or {
        core.close_error = PROTOCOL_VIOLATION;
    }
    ret false;
}

fun process_frame(core: *Core, secrets: *Secrets,
                  level: handshake_api.Level, space: u8,
                  receive_path: path_api.Handle,
                  receive_destination: cid_api.Handle, value: *frame.Frame,
                  encoded_frame_size: usize, now_ns: u64) bool {
    if (!frame_allowed(core, level, value)) {
        core.close_error = PROTOCOL_VIOLATION;
        ret false;
    }
    if (value.kind == frame.PADDING || value.kind == frame.PING) { ret true; }
    if (value.kind == frame.ACK || value.kind == frame.ACK_ECN) {
        ret handle_ack(core, secrets, space, value, now_ns);
    }
    if (value.kind == frame.CRYPTO) {
        val received: handshake_api.Result = handshake_api.receive_scoped(
            secrets.handshake, core.config.source, level, value.offset, value.data.data,
            value.data.len, now_ns);
        if (received.status == handshake_api.STATUS_ERROR) {
            core.close_error = handshake_failure(core, received);
            ret false;
        }
        val handshake_error: u64 = pump_handshake(core, secrets);
        if (handshake_error != NO_ERROR) {
            core.close_error = handshake_error;
            ret false;
        }
        ret true;
    }
    if (value.kind == frame.NEW_TOKEN) {
        if (core.role != transport_api.CLIENT) {
            core.close_error = PROTOCOL_VIOLATION;
            ret false;
        }
        if (value.data.len == 0) {
            core.close_error = FRAME_ENCODING_ERROR;
            ret false;
        }
        if (value.data.len > core.storage.received_token_capacity) {
            core.close_error = INTERNAL_ERROR;
            ret false;
        }
        memory.copy[u8](core.storage.received_token, value.data.data, value.data.len);
        core.received_token_length = value.data.len;
        ret true;
    }
    if (frame.is_stream(value.kind)) {
        val received: stream_api.ReceiveResult = stream_api.receive_stream_scoped(
            core.streams, core.config.source, value.stream_id, value.offset, value.data.data,
            value.data.len, value.fin);
        if (received.ok) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.RESET_STREAM) {
        val received: stream_api.ReceiveResult = stream_api.receive_reset_scoped(
            core.streams, core.config.source, value.stream_id, value.error_code,
            value.final_size);
        if (received.ok) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.STOP_SENDING) {
        val received: stream_api.ReceiveResult = stream_api.receive_stop_scoped(
            core.streams, core.config.source, value.stream_id, value.error_code);
        if (received.ok) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.MAX_DATA) {
        val received: stream_api.OperationResult = stream_api.update_max_data_scoped(
            core.streams, core.config.source, value.maximum);
        if (received.status != stream_api.STATUS_ERROR) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.MAX_STREAM_DATA) {
        val received: stream_api.ReceiveResult =
            stream_api.receive_max_stream_data_scoped(core.streams, core.config.source, value.stream_id,
                value.maximum);
        if (received.ok) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.MAX_STREAMS_BIDI || value.kind == frame.MAX_STREAMS_UNI) {
        var direction: u8 = stream_api.DIRECTION_UNIDIRECTIONAL;
        if (value.kind == frame.MAX_STREAMS_BIDI) {
            direction = stream_api.DIRECTION_BIDIRECTIONAL;
        }
        val received: stream_api.OperationResult = stream_api.update_max_streams_scoped(
            core.streams, core.config.source, direction, value.maximum);
        if (received.status != stream_api.STATUS_ERROR) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.DATA_BLOCKED) {
        val received: stream_api.OperationResult =
            stream_api.receive_data_blocked_scoped(core.streams, core.config.source, value.maximum);
        if (received.status != stream_api.STATUS_ERROR) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.STREAM_DATA_BLOCKED) {
        val received: stream_api.ReceiveResult =
            stream_api.receive_stream_data_blocked_scoped(core.streams, core.config.source,
                value.stream_id, value.maximum);
        if (received.ok) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.STREAMS_BLOCKED_BIDI ||
        value.kind == frame.STREAMS_BLOCKED_UNI) {
        var direction: u8 = stream_api.DIRECTION_UNIDIRECTIONAL;
        if (value.kind == frame.STREAMS_BLOCKED_BIDI) {
            direction = stream_api.DIRECTION_BIDIRECTIONAL;
        }
        val received: stream_api.OperationResult =
            stream_api.receive_streams_blocked_scoped(core.streams, core.config.source, direction,
                value.maximum);
        if (received.status != stream_api.STATUS_ERROR) { ret true; }
        ret stream_failure(core, received.error);
    }
    if (value.kind == frame.DATAGRAM || value.kind == frame.DATAGRAM_LEN) {
        val received: datagram_api.QueueResult = datagram_api.receive_scoped(core.datagrams, core.config.source,
            value.data.data, value.data.len, encoded_frame_size);
        if (received.ok || received.error == datagram_api.ERROR_CAPACITY) { ret true; }
        core.close_error = INTERNAL_ERROR;
        if (received.error == datagram_api.ERROR_DISABLED ||
            received.error == datagram_api.ERROR_LIMIT) {
            core.close_error = PROTOCOL_VIOLATION;
        }
        ret false;
    }
    if (value.kind == frame.NEW_CONNECTION_ID) {
        val received: cid_api.Result = cid_api.receive_new_scoped(core.cids,
            core.config.source,
            value.sequence, value.retire_prior_to, value.connection_id,
            value.stateless_reset_token);
        if (received.status == cid_api.STATUS_OK ||
            received.status == cid_api.STATUS_DUPLICATE ||
            received.status == cid_api.STATUS_STALE) { ret true; }
        if (received.error == cid_api.ERROR_LIMIT) {
            core.close_error = CONNECTION_ID_LIMIT_ERROR;
        } or (received.status == cid_api.STATUS_BLOCKED ||
            received.error == cid_api.ERROR_CAPACITY) {
            core.close_error = INTERNAL_ERROR;
        } or { core.close_error = PROTOCOL_VIOLATION; }
        ret false;
    }
    if (value.kind == frame.RETIRE_CONNECTION_ID) {
        val received: cid_api.Result = cid_api.receive_retire_in_packet_scoped(
            core.cids, core.config.source, value.sequence,
            receive_destination.sequence);
        if (received.status != cid_api.STATUS_ERROR) { ret true; }
        if (received.error == cid_api.ERROR_CAPACITY ||
            received.error == cid_api.ERROR_STATE) {
            core.close_error = INTERNAL_ERROR;
        } or { core.close_error = PROTOCOL_VIOLATION; }
        ret false;
    }
    if (value.kind == frame.PATH_CHALLENGE) {
        if (receive_path.source != 0 &&
            path_api.queue_response_scoped(core.paths, core.config.source, receive_path,
                value.path_data).status == path_api.STATUS_OK) { ret true; }
        core.close_error = INTERNAL_ERROR;
        ret false;
    }
    if (value.kind == frame.PATH_RESPONSE) {
        val validated: path_api.ValidationResult = path_api.receive_response_scoped(
            core.paths, core.config.source, value.path_data, now_ns);
        if (validated.status != path_api.STATUS_ERROR &&
            apply_path_signals(core, validated.reset_congestion,
                validated.reset_rtt, false, now_ns)) { ret true; }
        core.close_error = INTERNAL_ERROR;
        ret false;
    }
    if (value.kind == frame.CONNECTION_CLOSE_TRANSPORT ||
        value.kind == frame.CONNECTION_CLOSE_APPLICATION) {
        ret close_from_peer(core, value, now_ns);
    }
    if (value.kind == frame.HANDSHAKE_DONE) {
        if (core.role != transport_api.CLIENT) {
            core.close_error = PROTOCOL_VIOLATION;
            ret false;
        }
        if (confirm_handshake(core, secrets)) { ret true; }
        core.close_error = INTERNAL_ERROR;
        ret false;
    }
    ret true;
}

fun scan_plaintext(core: *Core, plaintext: *u8, length: usize,
                   ack_eliciting: *bool, non_probing: *bool) bool {
    var decoder: binary.Decoder = binary.decoder(plaintext, length, binary.BIG);
    for (decoder.pos < decoder.len) {
        var value: frame.Frame;
        val decoded: frame.DecodeResult = frame.decode(?decoder, true,
            frame.default_limits(), frame.Storage{
                ack_ranges: core.storage.frame_ack_ranges,
                ack_capacity: core.storage.frame_ack_capacity}, ?value);
        if (decoded.status != frame.STATUS_DONE) { ret false; }
        if (frame.ack_eliciting(value.kind)) { @ack_eliciting = true; }
        if (value.kind != frame.PADDING && value.kind != frame.PATH_CHALLENGE &&
            value.kind != frame.PATH_RESPONSE &&
            value.kind != frame.NEW_CONNECTION_ID) { @non_probing = true; }
    }
    ret true;
}

fun apply_plaintext(core: *Core, secrets: *Secrets,
                    level: handshake_api.Level, space: u8,
                    receive_path: path_api.Handle,
                    receive_destination: cid_api.Handle, plaintext: *u8,
                    length: usize, now_ns: u64) bool {
    var decoder: binary.Decoder = binary.decoder(plaintext, length, binary.BIG);
    for (decoder.pos < decoder.len) {
        val frame_begin: usize = decoder.pos;
        var value: frame.Frame;
        val decoded: frame.DecodeResult = frame.decode(?decoder, true,
            frame.default_limits(), frame.Storage{
                ack_ranges: core.storage.frame_ack_ranges,
                ack_capacity: core.storage.frame_ack_capacity}, ?value);
        if (decoded.status != frame.STATUS_DONE ||
            !process_frame(core, secrets, level, space, receive_path,
                receive_destination,
                ?value, decoder.pos - frame_begin, now_ns)) { ret false; }
        if (core.peer_close_received) { brk; }
    }
    ret true;
}

fun restart_client(core: *Core, secrets: *Secrets, value: negotiation_api.Result,
                   now_ns: u64) bool {
    if (value.status != negotiation_api.STATUS_RESTART) { ret false; }
    var owner_index: usize = 0;
    for (owner_index < core.storage.owner_capacity) {
        if (core.storage.owners[owner_index].state == OWNER_PREPARED &&
            !cancel_payload(core, secrets,
                ?core.storage.owners[owner_index])) { ret false; }
        owner_index = owner_index + 1;
    }
    val before: u64 = core.recovery_state.bytes_in_flight::u64;
    val retried: recovery.DiscardResult = recovery.on_retry(?core.recovery_state,
        now_ns, core.storage.recovery_events, core.storage.recovery_event_capacity);
    if (!retried.ok || !apply_recovery_events(core, secrets, retried.event_count, now_ns,
        false, true, before)) { ret false; }
    if (value.restart == negotiation_api.RESTART_RETRY) {
        core.retry_count = core.retry_count + 1;
        core.retry_source_connection_id = value.peer_destination;
        core.retry_source_present = true;
        core.config.peer_destination = value.peer_destination;
        core.config.initial_secret_destination = value.peer_destination;
        if (cid_api.replace_initial_peer_scoped(core.cids, core.config.source,
            value.peer_destination).status != cid_api.STATUS_OK ||
            handshake_api.on_retry_scoped(secrets.handshake, core.config.source, value.version,
                now_ns).status != handshake_api.STATUS_OK) { ret false; }
    } or {
        core.version_restart_count = core.version_restart_count + 1;
        core.config.version = value.version;
        protection.destroy(?secrets.early_send);
        protection.destroy(?secrets.early_receive);
        if (handshake_api.on_version_negotiation_scoped(secrets.handshake, core.config.source, value.version,
            now_ns).status != handshake_api.STATUS_OK) { ret false; }
    }
    protection.destroy_initial(?secrets.initial_keys);
    if (protection.derive_initial(?secrets.initial_keys, core.config.version,
        contracts.Bytes{data: ?core.config.initial_secret_destination.data[0],
            len: core.config.initial_secret_destination.len::usize}) != protection.OK) {
        ret false;
    }
    core.acknowledgements = ack_api.init(core.storage.ack_initial,
        core.storage.ack_handshake, core.storage.ack_application,
        saturated_multiply(core.local_parameters.max_ack_delay, 1000000),
        core.local_parameters.ack_delay_exponent::u8);
    core.probes_remaining = 0;
    core.probe_space = 0;
    core.probe_owner = 0;
    if (value.restart == negotiation_api.RESTART_VERSION) {
        core.packet_numbers[0] = 0;
        core.expected_packet_numbers[0] = 0;
        core.packet_numbers[1] = 0;
        core.packet_numbers[2] = 0;
        core.expected_packet_numbers[1] = 0;
        core.expected_packet_numbers[2] = 0;
    }
    core.last_activity_ns = now_ns;
    core.last_received_ns = now_ns;
    core.last_now_ns = now_ns;
    ret core.acknowledgements.valid;
}

fun receive_special(core: *Core, secrets: *Secrets,
                    input: *transport_api.Datagram,
                    value: Envelope) transport_api.CoreResult {
    if (core.role != transport_api.CLIENT || value.offset != 0 ||
        core.authenticated_packets != 0) {
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    var negotiated: negotiation_api.Result;
    if (value.kind == packet.PACKET_VERSION_NEGOTIATION) {
        negotiated = negotiation_api.version_negotiation(?core.negotiation,
            input.data, input.length);
    } or {
        negotiated = negotiation_api.retry(?core.negotiation,
            input.data, input.length);
    }
    if (negotiated.status == negotiation_api.STATUS_IGNORED) {
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (!restart_client(core, secrets, negotiated, input.received_at_ns)) {
        ret fail(core, PROTOCOL_VIOLATION, input.received_at_ns);
    }
    ret core_result(core, transport_api.STATUS_OK, 0);
}

fun receive_protected(core: *Core, secrets: *Secrets,
                      input: *transport_api.Datagram,
                      value: Envelope) transport_api.CoreResult {
    if (value.kind == packet.PACKET_INITIAL && input.length < 1200) {
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (value.version != 0 && value.version != core.config.version) {
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    val receive_destination: cid_api.Selected = local_destination(core,
        ?value.destination, value.kind);
    if (receive_destination.status != cid_api.STATUS_OK) {
        if (value.kind == packet.PACKET_ONE_RTT &&
            stateless_reset(core, input.data, input.length) &&
            !enter_stateless_reset(core, input.received_at_ns)) {
            ret fail(core, INTERNAL_ERROR, input.received_at_ns);
        }
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    val level: handshake_api.Level = level_for_kind(value.kind);
    val space: u8 = packet.number_space(value.kind);
    val expected: u64 = core.expected_packet_numbers[space_index(space)];
    var opened: protection.OpenResult;
    if (level == handshake_api.APPLICATION) {
        opened = protection.open_receive_packet(?secrets.application_receive, expected,
            contracts.Bytes{data: ?input.data[value.offset], len: value.length},
            value.packet_number_offset, contracts.Buffer{
                data: core.storage.receive_header,
                capacity: core.storage.receive_header_capacity},
            contracts.SecretBuffer{data: secrets.storage.receive_plaintext,
                capacity: secrets.storage.receive_plaintext_capacity});
    } or {
        val keys: *protection.KeySet = receive_keys(core, secrets, level);
        opened = protection.open_packet(keys, expected,
            contracts.Bytes{data: ?input.data[value.offset], len: value.length},
            value.packet_number_offset, contracts.Buffer{
                data: core.storage.receive_header,
                capacity: core.storage.receive_header_capacity},
            contracts.SecretBuffer{data: secrets.storage.receive_plaintext,
                capacity: secrets.storage.receive_plaintext_capacity});
    }
    if (opened.error == protection.AUTH_FAILED ||
        opened.error == protection.KEYS_DISCARDED) {
        if (level == handshake_api.APPLICATION && opened.error ==
            protection.AUTH_FAILED && stateless_reset(core, input.data,
                input.length)) {
            if (!enter_stateless_reset(core, input.received_at_ns)) {
                ret fail(core, INTERNAL_ERROR, input.received_at_ns);
            }
        }
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (opened.error != protection.OK) {
        ret fail(core, PROTOCOL_VIOLATION, input.received_at_ns);
    }
    var plaintext_index: usize = 0;
    for (plaintext_index < opened.written) {
        core.storage.receive_decoded[plaintext_index] =
            secrets.storage.receive_plaintext[plaintext_index]:^;
        plaintext_index = plaintext_index + 1;
    }
    if (core.state == transport_api.CLOSING) {
        core.close_queued = true;
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    val plaintext: *u8 = core.storage.receive_decoded;
    var ack_eliciting: bool = false;
    var non_probing: bool = false;
    if (!scan_plaintext(core, plaintext, opened.written, ?ack_eliciting,
        ?non_probing)) { ret fail(core, FRAME_ENCODING_ERROR, input.received_at_ns); }
    val received: ack_api.ReceiveResult = ack_api.on_packet(?core.acknowledgements,
        space, opened.packet_number, input.received_at_ns, ack_eliciting, input.ecn);
    if (received.status == ack_api.RECEIVE_DUPLICATE ||
        received.status == ack_api.RECEIVE_DROPPED) {
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (received.status != ack_api.RECEIVE_NEW) {
        ret fail(core, INTERNAL_ERROR, input.received_at_ns);
    }
    if (core.role == transport_api.CLIENT && core.authenticated_packets == 0 &&
        value.source.len > 0 && !packet.connection_id_equal(?value.source,
            ?core.config.peer_destination)) {
        if (cid_api.replace_initial_peer_scoped(core.cids, core.config.source,
            value.source).status !=
            cid_api.STATUS_OK) { ret fail(core, PROTOCOL_VIOLATION,
                input.received_at_ns); }
        core.config.peer_destination = value.source;
    }
    val observed: path_api.Observation = path_api.observe_scoped(core.paths, core.config.source,
        path_endpoint(input.local, input.peer), opened.packet_number,
        value.length::u64, non_probing, true, true,
        cid_api.snapshot(core.cids).peer_active > 1, input.received_at_ns);
    if (observed.status == path_api.STATUS_ERROR) {
        ret fail(core, NO_VIABLE_PATH, input.received_at_ns);
    }
    val expected_next: u64 = opened.packet_number + 1;
    if (expected_next > core.expected_packet_numbers[space_index(space)]) {
        core.expected_packet_numbers[space_index(space)] = expected_next;
    }
    core.authenticated_packets = core.authenticated_packets + 1;
    core.last_activity_ns = input.received_at_ns;
    core.last_received_ns = input.received_at_ns;
    if (core.closing && !core.peer_close_received) { core.close_queued = true; }
    if (core.role == transport_api.CLIENT) {
        negotiation_api.note_authenticated(?core.negotiation);
    }
    if (core.role == transport_api.SERVER &&
        level == handshake_api.HANDSHAKE) {
        if (path_api.validate_address_scoped(core.paths, core.config.source,
            observed.handle).status != path_api.STATUS_OK ||
            !recovery.set_peer_address_validated(?core.recovery_state, true,
                input.received_at_ns).ok) {
            ret fail(core, INTERNAL_ERROR, input.received_at_ns);
        }
    }
    if (observed.status != path_api.STATUS_OK) {
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (!apply_path_signals(core, observed.reset_congestion,
        observed.reset_rtt, observed.rotate_connection_id,
        input.received_at_ns)) {
        ret fail(core, INTERNAL_ERROR, input.received_at_ns);
    }
    if (!apply_plaintext(core, secrets, level, space, observed.handle,
        receive_destination.handle, plaintext, opened.written,
        input.received_at_ns)) {
        var failure: u64 = PROTOCOL_VIOLATION;
        if (core.close_error != NO_ERROR) { failure = core.close_error; }
        ret fail(core, failure, input.received_at_ns);
    }
    if (core.role == transport_api.CLIENT && level == handshake_api.HANDSHAKE &&
        !discard_initial_keys(core, secrets)) {
        ret fail(core, INTERNAL_ERROR, input.received_at_ns);
    }
    if (core.closing) { ret core_result(core, transport_api.STATUS_OK, 0); }
    val handshake_error: u64 = pump_handshake(core, secrets);
    if (handshake_error != NO_ERROR) {
        ret fail(core, handshake_error, input.received_at_ns);
    }
    ret core_result(core, transport_api.STATUS_OK, 0);
}

pub fun receive(core: *Core, secrets: *Secrets,
                input: *transport_api.Datagram) transport_api.CoreResult {
    if (!core_record_valid(core) || !secret_record_valid(secrets) ||
        !ownership.bytes(input::*u8, $size_of(transport_api.Datagram),
            ownership.ZERO_FORBIDDEN).valid) {
        ret core_refused(INTERNAL_ERROR);
    }
    val input_range: ownership.Range = ownership.bytes(input.data,
        input.length, ownership.ZERO_FORBIDDEN);
    if (!core.initialized ||
        !secrets.initialized || core.destroyed || secrets.destroyed ||
        !borrowed_disjoint(core, input_range) ||
        input.length > core.config.max_udp_payload ||
        input.received_at_ns < core.last_now_ns) {
        ret core_refused(INTERNAL_ERROR);
    }
    if (core.state == transport_api.CLOSED ||
        core.state == transport_api.DRAINING) {
        ret core_result(core, transport_api.STATUS_CLOSED, 0);
    }
    core.last_now_ns = input.received_at_ns;
    var offset: usize = 0;
    for (offset < input.length) {
        val selected: cid_api.Selected = cid_api.current(core.cids, true);
        if (selected.status != cid_api.STATUS_OK) {
            ret fail(core, INTERNAL_ERROR, input.received_at_ns);
        }
        val value: Envelope = envelope(input.data, input.length, offset,
            selected.id.len);
        if (!value.valid || value.length == 0) {
            if (input.length - offset >= 21 &&
                (input.data[offset] & 0xc0) == 0x40 &&
                stateless_reset(core, input.data, input.length) &&
                !enter_stateless_reset(core, input.received_at_ns)) {
                ret fail(core, INTERNAL_ERROR, input.received_at_ns);
            }
            ret core_result(core, transport_api.STATUS_OK, 0);
        }
        var received: transport_api.CoreResult;
        if (value.kind == packet.PACKET_VERSION_NEGOTIATION ||
            value.kind == packet.PACKET_RETRY) {
            received = receive_special(core, secrets, input, value);
            offset = input.length;
        } or (value.kind == packet.PACKET_UNKNOWN_VERSION) {
            received = core_result(core, transport_api.STATUS_OK, 0);
            offset = input.length;
        } or {
            received = receive_protected(core, secrets, input, value);
            offset = offset + value.length;
        }
        if (received.status == transport_api.STATUS_ERROR || core.closing) {
            ret received;
        }
        if (value.kind == packet.PACKET_ONE_RTT) { offset = input.length; }
    }
    ret core_result(core, transport_api.STATUS_OK, 0);
}

pub fun queue_new_token(core: *Core, data: *u8, length: usize) bool {
    val input: ownership.Range = ownership.bytes(data, length,
        ownership.ZERO_FORBIDDEN);
    if (!core_record_valid(core) || !core.initialized || core.destroyed || core.closing ||
        core.role != transport_api.SERVER || !core.handshake_confirmed ||
        length == 0 || !borrowed_disjoint(core, input) ||
        length > core.storage.send_token_capacity ||
        core.send_token_queued || core.send_token_prepared) { ret false; }
    memory.copy[u8](core.storage.send_token, data, length);
    core.send_token_length = length;
    core.send_token_queued = true;
    ret true;
}

pub fun probe_path(core: *Core, endpoint: path_api.Endpoint,
                   preferred: bool) path_api.PathResult {
    if (!core_record_valid(core) || !core.initialized || core.destroyed ||
        core.closing) {
        var failed: path_api.PathResult;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_STATE;
        ret failed;
    }
    ret path_api.probe_scoped(core.paths, core.config.source, endpoint,
        preferred);
}

pub fun migrate_path(core: *Core, value: path_api.Handle, preferred: bool,
                     now_ns: u64) path_api.Observation {
    if (!core_record_valid(core) || !core.initialized || core.destroyed ||
        core.closing || now_ns < core.last_now_ns) {
        var failed: path_api.Observation;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_STATE;
        ret failed;
    }
    val migrated: path_api.Observation = path_api.migrate_scoped(core.paths,
        core.config.source, value, preferred,
        cid_api.peer_rotation_available(core.cids));
    if (migrated.status == path_api.STATUS_OK &&
        !apply_path_signals(core, migrated.reset_congestion,
            migrated.reset_rtt, migrated.rotate_connection_id, now_ns)) {
        var failed: path_api.Observation;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_STATE;
        ret failed;
    }
    if (migrated.status == path_api.STATUS_OK) { core.last_now_ns = now_ns; }
    ret migrated;
}

pub fun queue_path_challenge(core: *Core, value: path_api.Handle,
                             data: [8]u8, padded: bool,
                             purpose: u8) path_api.OperationResult {
    if (!core_record_valid(core) || !core.initialized || core.destroyed ||
        core.closing) {
        var failed: path_api.OperationResult;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_STATE;
        ret failed;
    }
    val pto_ns: u64 = recovery.current_pto(?core.recovery_state, true);
    if (pto_ns == 0) {
        var failed: path_api.OperationResult;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_TIME;
        ret failed;
    }
    ret path_api.queue_challenge_scoped(core.paths, core.config.source, value,
        data, pto_ns, pto_ns, padded, purpose);
}

pub fun on_path_packet_too_big(core: *Core, value: path_api.Handle,
                               reported_mtu: u16,
                               quote_authenticated: bool,
                               now_ns: u64) path_api.MtuResult {
    if (!core_record_valid(core) || !core.initialized || core.destroyed ||
        core.closing || now_ns < core.last_now_ns) {
        var failed: path_api.MtuResult;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_STATE;
        ret failed;
    }
    val updated: path_api.MtuResult = path_api.on_packet_too_big_scoped(
        core.paths, core.config.source, value, reported_mtu,
        quote_authenticated);
    if (updated.status != path_api.STATUS_OK) { ret updated; }
    val transport_path: *path_api.Path =
        ?core.paths.storage.paths[value.index];
    if (updated.reconfigure_congestion &&
        !congestion_api.set_max_datagram_size(?transport_path.congestion,
            updated.current_mtu::u64, now_ns).ok) {
        var failed: path_api.MtuResult;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_STATE;
        ret failed;
    }
    if (updated.reconfigure_pacer &&
        !pacer_api.reconfigure(?transport_path.pacer,
            pacer_api.default_config(updated.current_mtu::u64,
                transport_path.congestion.congestion_window), now_ns,
            transport_path.congestion.congestion_window,
            core.recovery_state.rtt.smoothed_ns).ok) {
        var failed: path_api.MtuResult;
        failed.status = path_api.STATUS_ERROR;
        failed.error = path_api.ERROR_STATE;
        ret failed;
    }
    core.last_now_ns = now_ns;
    ret updated;
}

pub fun received_token(core: *Core) View {
    var result: View;
    if (!core_record_valid(core) || !core.initialized || core.destroyed ||
        core.role != transport_api.CLIENT || core.received_token_length == 0) {
        ret result;
    }
    result.data = core.storage.received_token;
    result.length = core.received_token_length;
    ret result;
}

pub fun poll_handshake(core: *Core, secrets: *Secrets,
                       now_ns: u64) transport_api.CoreResult {
    if (!core_record_valid(core) || !secret_record_valid(secrets) || !core.initialized ||
        !secrets.initialized || core.destroyed || secrets.destroyed ||
        now_ns < core.last_now_ns) {
        ret core_refused(INTERNAL_ERROR);
    }
    if (core.closing) { ret core_result(core, transport_api.STATUS_CLOSED, 0); }
    core.last_now_ns = now_ns;
    val polled: handshake_api.Result = handshake_api.poll_scoped(
        secrets.handshake, core.config.source, now_ns);
    if (polled.status == handshake_api.STATUS_ERROR) {
        ret fail(core, handshake_failure(core, polled), now_ns);
    }
    val handshake_error: u64 = pump_handshake(core, secrets);
    if (handshake_error != NO_ERROR) { ret fail(core, handshake_error, now_ns); }
    ret core_result(core, transport_api.STATUS_OK, 0);
}

pub fun snapshot(core: *Core) Snapshot {
    var result: Snapshot;
    if (!core_record_valid(core)) { ret result; }
    result.state = core.state;
    result.version = core.config.version;
    result.authenticated_packets = core.authenticated_packets;
    result.retry_count = core.retry_count;
    result.version_restart_count = core.version_restart_count;
    result.received_token_length = core.received_token_length;
    result.early_disposition = core.early_disposition;
    result.peer_parameters_ready = core.peer_parameters_ready;
    result.peer_authenticated = core.peer_authenticated;
    result.handshake_confirmed = core.handshake_confirmed;
    result.initial_keys_discarded = core.initial_keys_discarded;
    result.provider_error = core.last_provider_error;
    result.closing = core.closing;
    result.destroyed = core.destroyed;
    var i: usize = 0;
    for (i < core.storage.owner_capacity) {
        if (core.storage.owners[i].state != OWNER_FREE) {
            result.active_owners = result.active_owners + 1;
        }
        i = i + 1;
    }
    ret result;
}

fun claim_owner(core: *Core) *Owner {
    var slot_offset: usize = 0;
    for (slot_offset < core.storage.owner_capacity) {
        val index: usize = (core.next_owner_slot + slot_offset) %
            core.storage.owner_capacity;
        if (core.storage.owners[index].state == OWNER_FREE) {
            var candidate: u64 = core.next_owner;
            var attempts: usize = 0;
            for (attempts <= core.storage.owner_capacity &&
                owner_by_id(core, candidate) != nil) {
                candidate = next_generation(candidate);
                attempts = attempts + 1;
            }
            if (owner_by_id(core, candidate) != nil) { ret nil; }
            val generation: u64 = next_generation(
                core.storage.owners[index].generation);
            var clean: Owner;
            clean.owner = candidate;
            clean.generation = generation;
            clean.state = OWNER_PREPARED;
            core.storage.owners[index] = clean;
            core.next_owner = next_generation(candidate);
            core.next_owner_slot = (index + 1) % core.storage.owner_capacity;
            ret ?core.storage.owners[index];
        }
        slot_offset = slot_offset + 1;
    }
    ret nil;
}

fun has_prepared_owner(core: *Core) bool {
    var i: usize = 0;
    for (i < core.storage.owner_capacity) {
        if (core.storage.owners[i].state == OWNER_PREPARED) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun cancel_payload(core: *Core, secrets: *Secrets, owner: *Owner) bool {
    var ok: bool = true;
    if (owner.kind == OWNER_ACK) {
        core.ack_prepared[space_index(owner.space)] = false;
    }
    if (owner.kind == OWNER_CRYPTO) {
        ok = handshake_api.cancel_prepared_scoped(secrets.handshake, core.config.source, owner.handshake).status == handshake_api.STATUS_OK;
    }
    if (owner.kind == OWNER_STREAM) {
        ok = stream_api.cancel_prepared_scoped(core.streams, core.config.source, stream_prepared_token(owner.stream)).status == stream_api.STATUS_OK;
    }
    if (owner.kind == OWNER_DATAGRAM) {
        ok = datagram_api.cancel_prepared_scoped(core.datagrams, core.config.source,
            datagram_prepared_token(owner.datagram)).status ==
            datagram_api.STATUS_OK;
    }
    if (owner.kind == OWNER_PATH_CHALLENGE) {
        ok = path_api.cancel_challenge_scoped(core.paths, core.config.source,
            owner.path_challenge).status == path_api.STATUS_OK;
    }
    if (owner.kind == OWNER_PATH_RESPONSE) {
        ok = path_api.cancel_response_scoped(core.paths, core.config.source,
            owner.path_response).status == path_api.STATUS_OK;
    }
    if (owner.kind == OWNER_CID_RETIREMENT) {
        ok = cid_api.retirement_terminal_scoped(core.cids, core.config.source,
            owner.cid_retirement,
            false).status == cid_api.STATUS_OK;
    }
    if (owner.kind == OWNER_NEW_CID) {
        ok = cid_api.advertisement_terminal_scoped(core.cids, core.config.source,
            owner.cid_retirement,
            false).status == cid_api.STATUS_OK;
    }
    if (owner.kind == OWNER_CLOSE) { core.close_queued = true; }
    if (owner.kind == OWNER_HANDSHAKE_DONE) {
        core.handshake_done_queued = true;
    }
    if (owner.kind == OWNER_NEW_TOKEN) {
        core.send_token_prepared = false;
        core.send_token_queued = true;
    }
    if (owner.kind == OWNER_MTU_PROBE) {
        if (owner.path_send.source != 0) {
            ok = path_api.cancel_send_scoped(core.paths, core.config.source,
                owner.path_send).status == path_api.STATUS_OK && ok;
            owner.path_send.source = 0;
        }
        ok = path_api.cancel_mtu_probe_scoped(core.paths, core.config.source,
            owner.mtu_probe).status == path_api.STATUS_OK && ok;
    }
    if (owner.pto_probe && core.probes_remaining < 255) {
        core.probes_remaining = core.probes_remaining + 1;
    }
    if (owner.path_send.source != 0) {
        ok = path_api.cancel_send_scoped(core.paths, core.config.source,
            owner.path_send).status == path_api.STATUS_OK && ok;
    }
    if (owner.pacer.ok) {
        if (owner.path.source == 0 ||
            owner.path.index >= core.paths.storage.path_capacity ||
            !core.paths.storage.paths[owner.path.index].valid ||
            core.paths.storage.paths[owner.path.index].generation !=
                owner.path.generation) {
            ok = false;
        } or {
            ok = pacer_api.cancel(
                ?core.paths.storage.paths[owner.path.index].pacer,
                owner.pacer).ok && ok;
        }
    }
    free_owner(owner);
    ret ok;
}

fun selected_path(core: *Core) path_api.PathResult {
    ret path_api.selected(core.paths);
}

fun level_available(core: *Core, secrets: *Secrets,
                    level: handshake_api.Level) bool {
    if (level == handshake_api.INITIAL) {
        ret secrets.initial_keys.state == protection.STATE_ACTIVE;
    }
    if (level == handshake_api.EARLY) {
        ret secrets.early_send.state == protection.STATE_ACTIVE;
    }
    if (level == handshake_api.HANDSHAKE) {
        ret secrets.handshake_send.state == protection.STATE_ACTIVE;
    }
    ret secrets.application_send.state == protection.STATE_ACTIVE;
}

fun level_for_space(core: *Core, secrets: *Secrets, space: u8) handshake_api.Level {
    if (space == packet.SPACE_INITIAL && level_available(core, secrets,
        handshake_api.INITIAL)) { ret handshake_api.INITIAL; }
    if (space == packet.SPACE_HANDSHAKE && level_available(core, secrets,
        handshake_api.HANDSHAKE)) { ret handshake_api.HANDSHAKE; }
    if (space == packet.SPACE_APPLICATION && level_available(core, secrets,
        handshake_api.APPLICATION)) { ret handshake_api.APPLICATION; }
    ret 0;
}

fun app_send_level(core: *Core, secrets: *Secrets) handshake_api.Level {
    if (!core.peer_parameters_ready) { ret 0; }
    if (level_available(core, secrets, handshake_api.APPLICATION)) {
        ret handshake_api.APPLICATION;
    }
    if (core.role == transport_api.CLIENT &&
        core.early_disposition != handshake_api.EARLY_REJECTED &&
        level_available(core, secrets, handshake_api.EARLY)) {
        ret handshake_api.EARLY;
    }
    ret 0;
}

fun encode_frame(builder: *binary.Builder, value: *frame.Frame) bool {
    ret frame.encode(builder, value, frame.default_limits()).ok;
}

fun choose_close_level(core: *Core, secrets: *Secrets) handshake_api.Level {
    if (level_available(core, secrets, handshake_api.APPLICATION)) {
        ret handshake_api.APPLICATION;
    }
    if (level_available(core, secrets, handshake_api.HANDSHAKE)) {
        ret handshake_api.HANDSHAKE;
    }
    if (level_available(core, secrets, handshake_api.INITIAL)) {
        ret handshake_api.INITIAL;
    }
    ret 0;
}

fun prepare_frame(core: *Core, secrets: *Secrets, owner: *Owner,
                  now_ns: u64, maximum: usize, output: *frame.Frame,
                  path: *path_api.Handle) bool {
    val selected: path_api.PathResult = selected_path(core);
    if (selected.status != path_api.STATUS_OK) { ret false; }
    @path = selected.handle;

    if (core.close_queued) {
        val level: handshake_api.Level = choose_close_level(core, secrets);
        if (level == 0) { ret false; }
        output.kind = frame.CONNECTION_CLOSE_TRANSPORT;
        if (core.close_frame_type == frame.CONNECTION_CLOSE_APPLICATION) {
            output.kind = frame.CONNECTION_CLOSE_APPLICATION;
        }
        output.error_code = core.close_error;
        output.frame_type = core.close_frame_type;
        output.data = packet.Span{data: core.storage.close_reason,
            len: core.close_reason_length};
        owner.kind = OWNER_CLOSE;
        owner.level = level;
        core.close_queued = false;
        ret true;
    }
    if (core.closing) { ret false; }

    var space: u8 = packet.SPACE_INITIAL;
    for (space <= packet.SPACE_APPLICATION) {
        val index: usize = space_index(space);
        val level: handshake_api.Level = level_for_space(core, secrets, space);
        if (level != 0 && !core.ack_prepared[index] &&
            ack_api.ack_due(?core.acknowledgements, space, now_ns)) {
            val built: ack_api.BuildResult = ack_api.build(?core.acknowledgements,
                space, now_ns, core.storage.frame_ack_ranges,
                core.storage.frame_ack_capacity, output);
            if (!built.ok) { ret false; }
            owner.kind = OWNER_ACK;
            owner.level = level;
            owner.space = space;
            owner.ack_generation = built.generation;
            owner.ack_largest = built.largest_acknowledged;
            core.ack_prepared[index] = true;
            ret true;
        }
        space = space + 1;
    }

    var level: handshake_api.Level = handshake_api.INITIAL;
    for (level <= handshake_api.APPLICATION) {
        if (level != handshake_api.EARLY && level_available(core, secrets, level)) {
            var prepared: handshake_api.Prepared;
            val probe_owner: *Owner = owner_by_id(core, core.probe_owner);
            var probing: bool = false;
            if (core.probes_remaining > 0 && probe_owner != nil &&
                probe_owner.kind == OWNER_CRYPTO &&
                probe_owner.level == level) {
                probing = true;
                prepared = handshake_api.prepare_probe_scoped(secrets.handshake, core.config.source, level, maximum);
            } or {
                prepared = handshake_api.prepare_scoped(secrets.handshake, core.config.source, level, maximum);
            }
            if (prepared.status == handshake_api.STATUS_OK) {
                output.kind = frame.CRYPTO;
                output.offset = prepared.offset;
                output.data = packet.Span{data: prepared.data.data,
                    len: prepared.data.length};
                owner.kind = OWNER_CRYPTO;
                owner.level = level;
                owner.handshake = prepared.token;
                if (probing) {
                    owner.pto_probe = true;
                    core.probes_remaining = core.probes_remaining - 1;
                }
                ret true;
            }
            if (prepared.status == handshake_api.STATUS_ERROR) { ret false; }
        }
        level = level + 1;
    }

    val application: handshake_api.Level = app_send_level(core, secrets);
    if (application == 0) { ret false; }

    if (application == handshake_api.APPLICATION && core.handshake_done_queued) {
        output.kind = frame.HANDSHAKE_DONE;
        owner.kind = OWNER_HANDSHAKE_DONE;
        owner.level = application;
        core.handshake_done_queued = false;
        ret true;
    }

    if (application == handshake_api.APPLICATION && core.send_token_queued &&
        !core.send_token_prepared) {
        output.kind = frame.NEW_TOKEN;
        output.data = packet.Span{data: core.storage.send_token,
            len: core.send_token_length};
        owner.kind = OWNER_NEW_TOKEN;
        owner.level = application;
        core.send_token_queued = false;
        core.send_token_prepared = true;
        ret true;
    }

    if (application == handshake_api.APPLICATION) {
        val advertisement: cid_api.Selected = cid_api.next_advertisement(core.cids);
        if (advertisement.status == cid_api.STATUS_OK) {
            if (cid_api.advertisement_sent_scoped(core.cids,
                core.config.source,
                advertisement.handle).status != cid_api.STATUS_OK) { ret false; }
            output.kind = frame.NEW_CONNECTION_ID;
            output.sequence = advertisement.handle.sequence;
            output.retire_prior_to = 0;
            output.connection_id = advertisement.id;
            output.stateless_reset_token = advertisement.reset_token;
            owner.kind = OWNER_NEW_CID;
            owner.level = application;
            owner.cid_retirement = advertisement.handle;
            ret true;
        }
        val retirement: cid_api.Result = cid_api.next_retirement(core.cids);
        if (retirement.status == cid_api.STATUS_OK) {
            if (cid_api.retirement_sent_scoped(core.cids,
                core.config.source,
                retirement.handle).status != cid_api.STATUS_OK) { ret false; }
            output.kind = frame.RETIRE_CONNECTION_ID;
            output.sequence = retirement.handle.sequence;
            owner.kind = OWNER_CID_RETIREMENT;
            owner.level = application;
            owner.cid_retirement = retirement.handle;
            ret true;
        }

        var path_index: usize = 0;
        for (path_index < core.paths.storage.path_capacity) {
            if (core.paths.storage.paths[path_index].valid) {
                val handle: path_api.Handle = path_api.Handle{
                    source: core.paths.config.source, index: path_index,
                    generation: core.paths.storage.paths[path_index].generation};
                val response: path_api.PreparedResponse =
                    path_api.prepare_response_scoped(core.paths, core.config.source, handle);
                if (response.status == path_api.STATUS_OK) {
                    output.kind = frame.PATH_RESPONSE;
                    output.path_data = response.data;
                    owner.kind = OWNER_PATH_RESPONSE;
                    owner.level = application;
                    owner.path_response = response.token;
                    owner.include_ping = response.require_non_probing;
                    owner.minimum_datagram_size = response.minimum_datagram_size;
                    @path = response.handle;
                    ret true;
                }
                val challenge: path_api.PreparedChallenge =
                    path_api.prepare_challenge_scoped(core.paths, core.config.source, handle);
                if (challenge.status == path_api.STATUS_OK) {
                    output.kind = frame.PATH_CHALLENGE;
                    output.path_data = challenge.data;
                    owner.kind = OWNER_PATH_CHALLENGE;
                    owner.level = application;
                    owner.path_challenge = challenge.token;
                    owner.minimum_datagram_size = challenge.minimum_datagram_size;
                    @path = challenge.handle;
                    ret true;
                }
            }
            path_index = path_index + 1;
        }
        val mtu: path_api.MtuPrepared = path_api.prepare_mtu_probe_scoped(core.paths, core.config.source,
            selected.handle);
        if (mtu.status == path_api.STATUS_OK) {
            output.kind = frame.PING;
            owner.kind = OWNER_MTU_PROBE;
            owner.level = application;
            owner.mtu_probe = mtu.token;
            owner.minimum_datagram_size = mtu.size;
            @path = mtu.handle;
            ret true;
        }
    }

    val control: stream_api.Prepared = stream_api.prepare_control_scoped(core.streams, core.config.source);
    if (control.status == stream_api.STATUS_OK) {
        if (control.kind == stream_api.SEND_MAX_DATA) {
            output.kind = frame.MAX_DATA;
            output.maximum = control.maximum;
        }
        if (control.kind == stream_api.SEND_MAX_STREAM_DATA) {
            output.kind = frame.MAX_STREAM_DATA;
            output.stream_id = control.handle.id;
            output.maximum = control.maximum;
        }
        if (control.kind == stream_api.SEND_MAX_STREAMS_BIDI) {
            output.kind = frame.MAX_STREAMS_BIDI;
            output.maximum = control.maximum;
        }
        if (control.kind == stream_api.SEND_MAX_STREAMS_UNI) {
            output.kind = frame.MAX_STREAMS_UNI;
            output.maximum = control.maximum;
        }
        owner.kind = OWNER_STREAM;
        owner.level = application;
        owner.stream = control.token;
        ret true;
    }
    if (control.status == stream_api.STATUS_ERROR) { ret false; }

    var stream_index: usize = 0;
    for (stream_index < core.streams.storage.stream_capacity) {
        val stream: *stream_api.Stream = ?core.streams.storage.streams[stream_index];
        if (stream.active) {
            val handle: stream_api.Handle = stream_api.Handle{
                source: core.streams.config.source, index: stream_index,
                generation: stream.generation, id: stream.id};
            val prepared: stream_api.Prepared = stream_api.prepare_scoped(core.streams, core.config.source,
                handle, maximum, core.probes_remaining > 0);
            if (prepared.status == stream_api.STATUS_OK) {
                if (prepared.kind == stream_api.SEND_STREAM) {
                    output.kind = frame.STREAM_BASE | 0x02;
                    if (prepared.offset != 0) { output.kind = output.kind | 0x04; }
                    if (prepared.fin) { output.kind = output.kind | 0x01; }
                    output.stream_id = prepared.handle.id;
                    output.offset = prepared.offset;
                    output.data = prepared.data;
                    output.fin = prepared.fin;
                }
                if (prepared.kind == stream_api.SEND_RESET) {
                    output.kind = frame.RESET_STREAM;
                    output.stream_id = prepared.handle.id;
                    output.error_code = prepared.application_error;
                    output.final_size = prepared.final_size;
                }
                if (prepared.kind == stream_api.SEND_STOP) {
                    output.kind = frame.STOP_SENDING;
                    output.stream_id = prepared.handle.id;
                    output.error_code = prepared.application_error;
                }
                owner.kind = OWNER_STREAM;
                owner.level = application;
                owner.stream = prepared.token;
                if (core.probes_remaining > 0) {
                    owner.pto_probe = true;
                    core.probes_remaining = core.probes_remaining - 1;
                }
                ret true;
            }
            if (prepared.status == stream_api.STATUS_ERROR) { ret false; }
        }
        stream_index = stream_index + 1;
    }

    val datagram: datagram_api.Prepared = datagram_api.prepare_scoped(core.datagrams, core.config.source, true);
    if (datagram.status == datagram_api.STATUS_OK) {
        output.kind = frame.DATAGRAM_LEN;
        output.data = datagram.data;
        owner.kind = OWNER_DATAGRAM;
        owner.level = application;
        owner.datagram = datagram.token;
        ret true;
    }
    if (datagram.status == datagram_api.STATUS_ERROR &&
        datagram.error != datagram_api.ERROR_DISABLED) { ret false; }

    if (core.probes_remaining > 0) {
        val probe_level: handshake_api.Level = level_for_space(core, secrets,
            core.probe_space);
        if (probe_level == 0) { ret false; }
        output.kind = frame.PING;
        owner.kind = OWNER_PROBE;
        owner.level = probe_level;
        owner.pto_probe = true;
        core.probes_remaining = core.probes_remaining - 1;
        ret true;
    }
    ret false;
}

fun send_key(core: *Core, secrets: *Secrets,
             level: handshake_api.Level) *protection.KeySet {
    if (level == handshake_api.INITIAL) {
        if (core.role == transport_api.CLIENT) { ret ?secrets.initial_keys.client; }
        ret ?secrets.initial_keys.server;
    }
    if (level == handshake_api.EARLY) { ret ?secrets.early_send; }
    if (level == handshake_api.HANDSHAKE) { ret ?secrets.handshake_send; }
    ret nil;
}

fun endpoint_for(core: *Core, value: path_api.Handle,
                 output: *path_api.Endpoint) bool {
    val snapshot: path_api.Snapshot = path_api.snapshot(core.paths, value);
    if (snapshot.status != path_api.STATUS_OK) { ret false; }
    @output = snapshot.endpoint;
    ret true;
}

pub fun generate(core: *Core, secrets: *Secrets, output: *u8,
                 capacity: usize, now_ns: u64) transport_api.CoreDatagram {
    var result: transport_api.CoreDatagram;
    val output_range: ownership.Range = ownership.bytes(output, capacity,
        ownership.ZERO_FORBIDDEN);
    if (!core_record_valid(core) || !secret_record_valid(secrets) || !core.initialized ||
        !secrets.initialized || core.destroyed || secrets.destroyed ||
        capacity < 1200 || !borrowed_disjoint(core, output_range) ||
        now_ns < core.last_now_ns) {
        result.status = transport_api.STATUS_ERROR;
        result.error = INTERNAL_ERROR;
        ret result;
    }
    result.state = core.state;
    if (core.state == transport_api.CLOSED) {
        result.status = transport_api.STATUS_CLOSED;
        ret result;
    }
    if (core.closing && !core.close_queued) {
        result.status = transport_api.STATUS_CLOSED;
        ret result;
    }
    if (!core.closing) {
        val polled: transport_api.CoreResult = poll_handshake(core, secrets, now_ns);
        if (polled.status == transport_api.STATUS_ERROR) {
            result.status = polled.status;
            result.error = polled.error;
            result.provider_error = polled.provider_error;
            result.state = polled.state;
            ret result;
        }
    }
    if (has_prepared_owner(core)) {
        result.status = transport_api.STATUS_BLOCKED;
        ret result;
    }
    var available: usize = capacity;
    if (available > core.send_max_udp_payload) {
        available = core.send_max_udp_payload;
    }
    val owner: *Owner = claim_owner(core);
    if (owner == nil) {
        result.status = transport_api.STATUS_BLOCKED;
        ret result;
    }
    var value: frame.Frame;
    var path: path_api.Handle;
    if (!prepare_frame(core, secrets, owner, now_ns,
        available - 96, ?value, ?path)) {
        free_owner(owner);
        result.status = transport_api.STATUS_EMPTY;
        ret result;
    }
    if (path_api.configure_transport_scoped(core.paths, core.config.source, path,
        core.recovery_state.rtt.smoothed_ns,
        now_ns).status != path_api.STATUS_OK) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_ERROR;
        result.error = INTERNAL_ERROR;
        ret result;
    }
    owner.path = path;
    var plaintext: binary.Builder = binary.builder(
        core.storage.send_plaintext, core.storage.send_plaintext_capacity,
        binary.BIG);
    if (!encode_frame(?plaintext, ?value)) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_ERROR;
        result.error = FRAME_ENCODING_ERROR;
        ret result;
    }
    if (owner.include_ping) {
        var ping: frame.Frame;
        ping.kind = frame.PING;
        if (!encode_frame(?plaintext, ?ping)) {
            cancel_payload(core, secrets, owner);
            result.status = transport_api.STATUS_ERROR;
            result.error = FRAME_ENCODING_ERROR;
            ret result;
        }
    }
    val space: u8 = packet.number_space(kind_for_level(owner.level));
    val index: usize = space_index(space);
    val number: u64 = core.packet_numbers[index];
    if (number > packet.MAX_PACKET_NUMBER) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_ERROR;
        result.error = PROTOCOL_VIOLATION;
        ret result;
    }
    val history: recovery.History = core.recovery_state.spaces[index];
    var largest_acked: u64 = 0 - 1::u64;
    if (history.has_largest_acked) { largest_acked = history.largest_acked; }
    val width: u8 = packet.packet_number_width(number, largest_acked);
    var protected_packet: packet.Packet;
    protected_packet.header.kind = kind_for_level(owner.level);
    protected_packet.header.version = core.config.version;
    protected_packet.header.packet_number = number;
    protected_packet.header.packet_number_len = width;
    protected_packet.header.key_phase = owner.level == handshake_api.APPLICATION &&
        secrets.application_send.phase;
    val destination: cid_api.Selected = cid_api.current(core.cids, false);
    val source: cid_api.Selected = cid_api.current(core.cids, true);
    if (destination.status != cid_api.STATUS_OK || source.status != cid_api.STATUS_OK) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_ERROR;
        result.error = INTERNAL_ERROR;
        ret result;
    }
    protected_packet.header.destination = destination.id;
    protected_packet.header.source = source.id;
    if (protected_packet.header.kind == packet.PACKET_INITIAL &&
        core.role == transport_api.CLIENT) {
        protected_packet.token = negotiation_api.token(?core.negotiation);
    }
    var header: packet.ProtectedHeaderResult;
    var padding_ok: bool = true;
    var minimum_plaintext: usize = 0;
    if (width < 4) { minimum_plaintext = 4 - width::usize; }
    if (protected_packet.header.kind == packet.PACKET_INITIAL) {
        var measured_builder: binary.Builder = binary.builder(output, available,
            binary.BIG);
        val measured_header: packet.ProtectedHeaderResult =
            packet.encode_protected_header(?measured_builder,
                ?protected_packet, 1200, packet.default_limits());
        if (!measured_header.ok || measured_header.count + 16 >= 1200) {
            padding_ok = false;
        } or {
            val initial_minimum: usize = 1200 - measured_header.count - 16;
            if (initial_minimum > minimum_plaintext) {
                minimum_plaintext = initial_minimum;
            }
        }
    }
    if (protected_packet.header.kind != packet.PACKET_INITIAL &&
        owner.minimum_datagram_size > 0) {
        var measured_builder: binary.Builder = binary.builder(output, available,
            binary.BIG);
        val measured_header: packet.ProtectedHeaderResult =
            packet.encode_protected_header(?measured_builder,
                ?protected_packet, plaintext.len + 16,
                packet.default_limits());
        if (!measured_header.ok || measured_header.count + 16 >=
            owner.minimum_datagram_size::usize) {
            if (!measured_header.ok) { padding_ok = false; }
        } or {
            val path_minimum: usize = owner.minimum_datagram_size::usize -
                measured_header.count - 16;
            if (path_minimum > minimum_plaintext) {
                minimum_plaintext = path_minimum;
            }
        }
    }
    if (plaintext.len < minimum_plaintext) {
        val padding: usize = minimum_plaintext - plaintext.len;
        var padding_frame: frame.Frame;
        padding_frame.kind = frame.PADDING;
        padding_frame.padding_count = padding;
        if (!encode_frame(?plaintext, ?padding_frame)) { padding_ok = false; }
    }
    if (padding_ok) {
        var header_builder: binary.Builder = binary.builder(output, available,
            binary.BIG);
        header = packet.encode_protected_header(?header_builder, ?protected_packet,
            plaintext.len + 16, packet.default_limits());
    }
    if (!padding_ok || !header.ok || header.count > available ||
        plaintext.len + 16 > available - header.count) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_ERROR;
        result.error = INTERNAL_ERROR;
        ret result;
    }
    val packet_size: usize = header.count + plaintext.len + 16;
    var secret_index: usize = 0;
    for (secret_index < plaintext.len) {
        secrets.storage.send_plaintext[secret_index] =
            core.storage.send_plaintext[secret_index];
        secret_index = secret_index + 1;
    }
    val ack_eliciting: bool = frame.ack_eliciting(value.kind);
    val in_flight: bool = ack_eliciting;
    if (ack_eliciting && history.len >= history.capacity) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_BLOCKED;
        ret result;
    }
    val transport_path: *path_api.Path =
        ?core.paths.storage.paths[path.index];
    if (ack_eliciting &&
        (transport_path.recovery_owners == 0 - 1::usize ||
        packet_size::u64 > (0 - 1::u64) -
            transport_path.recovery_bytes_in_flight ||
        packet_size > (0 - 1::usize) - core.recovery_state.bytes_in_flight)) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_BLOCKED;
        ret result;
    }
    val admitted: congestion_api.Admission = congestion_api.admit(
        ?transport_path.congestion, transport_path.recovery_bytes_in_flight,
        0 - 1::u64, packet_size::u64, 0, in_flight,
        owner.pto_probe || owner.kind == OWNER_PROBE);
    if (!admitted.ok || !admitted.permitted) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_BLOCKED;
        ret result;
    }
    owner.pacer = pacer_api.schedule(?transport_path.pacer, now_ns,
        transport_path.congestion.congestion_window,
        core.recovery_state.rtt.smoothed_ns,
        packet_size::u64, !ack_eliciting);
    if (!owner.pacer.ok || !owner.pacer.ready) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_BLOCKED;
        ret result;
    }
    var reserved: path_api.SendResult;
    if (owner.kind == OWNER_MTU_PROBE) {
        reserved = path_api.reserve_mtu_send_scoped(core.paths, core.config.source, path,
            packet_size::u64, true, owner.mtu_probe);
    } or {
        reserved = path_api.reserve_send_scoped(core.paths, core.config.source, path,
            packet_size::u64, owner.include_ping ||
            (value.kind != frame.PATH_CHALLENGE &&
            value.kind != frame.PATH_RESPONSE));
    }
    if (reserved.status != path_api.STATUS_OK) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_BLOCKED;
        ret result;
    }
    owner.path_send = reserved.token;
    var sealed: protection.Result;
    if (owner.level == handshake_api.APPLICATION) {
        sealed = protection.seal_send_packet(?secrets.application_send, number,
            contracts.Bytes{data: output, len: header.count},
            header.packet_number_offset,
            contracts.SecretBytes{data: secrets.storage.send_plaintext,
                len: plaintext.len},
            contracts.Buffer{data: output, capacity: available});
    } or {
        sealed = protection.seal_packet(send_key(core, secrets, owner.level), number,
            contracts.Bytes{data: output, len: header.count},
            header.packet_number_offset,
            contracts.SecretBytes{data: secrets.storage.send_plaintext,
                len: plaintext.len},
            contracts.Buffer{data: output, capacity: available});
    }
    if (sealed.error != protection.OK || sealed.written != packet_size) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_ERROR;
        result.error = INTERNAL_ERROR;
        ret result;
    }
    core.packet_numbers[index] = number + 1;
    owner.packet_number = number;
    owner.bytes = packet_size;
    owner.space = space;
    owner.ack_eliciting = ack_eliciting;
    owner.in_flight = in_flight;
    owner.growth_permitted = in_flight &&
        (owner.pto_probe || packet_size::u64 >=
        transport_path.congestion.congestion_window -
        transport_path.recovery_bytes_in_flight);
    var endpoint: path_api.Endpoint;
    if (!endpoint_for(core, path, ?endpoint)) {
        cancel_payload(core, secrets, owner);
        result.status = transport_api.STATUS_ERROR;
        result.error = NO_VIABLE_PATH;
        ret result;
    }
    result.status = transport_api.STATUS_OK;
    result.state = core.state;
    result.local = ip_endpoint(endpoint.local);
    result.peer = ip_endpoint(endpoint.peer);
    result.count = sealed.written;
    result.owner = owner.owner;
    ret result;
}

fun publish_payload(core: *Core, secrets: *Secrets, owner: *Owner,
                    now_ns: u64) bool {
    if (owner.kind == OWNER_ACK) {
        core.ack_prepared[space_index(owner.space)] = false;
        # a packet received between preparing this ack and its completion
        # supersedes its generation; the sent ack stays valid and the newer
        # pending state must survive, so a stale publication is not a failure
        ack_api.on_ack_sent(?core.acknowledgements, owner.space,
            owner.ack_generation);
        ret true;
    }
    if (owner.kind == OWNER_CRYPTO) {
        ret handshake_api.publish_scoped(secrets.handshake, core.config.source, owner.handshake).status == handshake_api.STATUS_OK;
    }
    if (owner.kind == OWNER_STREAM) {
        ret stream_api.publish_scoped(core.streams, core.config.source, stream_prepared_token(owner.stream)).status == stream_api.STATUS_OK;
    }
    if (owner.kind == OWNER_DATAGRAM) {
        ret datagram_api.publish_scoped(core.datagrams, core.config.source, datagram_prepared_token(owner.datagram)).status == datagram_api.STATUS_OK;
    }
    if (owner.kind == OWNER_PATH_CHALLENGE) {
        ret path_api.publish_challenge_scoped(core.paths, core.config.source, owner.path_challenge,
            now_ns).status == path_api.STATUS_OK;
    }
    if (owner.kind == OWNER_PATH_RESPONSE) {
        ret path_api.publish_response_scoped(core.paths, core.config.source,
            owner.path_response).status == path_api.STATUS_OK;
    }
    if (owner.kind == OWNER_MTU_PROBE) {
        ret path_api.publish_mtu_probe_scoped(core.paths, core.config.source,
            owner.mtu_probe).status == path_api.STATUS_OK;
    }
    ret true;
}

pub fun complete_send(core: *Core, secrets: *Secrets, owner_id: u64,
                      status: transport_api.SendStatus, count: usize,
                      now_ns: u64) transport_api.CoreResult {
    if (!core_record_valid(core) || !secret_record_valid(secrets) || !core.initialized ||
        !secrets.initialized || core.destroyed || secrets.destroyed ||
        now_ns < core.last_now_ns) {
        ret core_refused(INTERNAL_ERROR);
    }
    val owner: *Owner = owner_by_id(core, owner_id);
    core.last_now_ns = now_ns;
    if (owner == nil || owner.state != OWNER_PREPARED) {
        ret core_result(core, transport_api.STATUS_STALE, 0);
    }
    if (status != transport_api.SEND_SENT) {
        if (!cancel_payload(core, secrets, owner)) {
            ret fail(core, INTERNAL_ERROR, now_ns);
        }
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (count != owner.bytes) {
        if (!cancel_payload(core, secrets, owner)) {
            ret fail(core, INTERNAL_ERROR, now_ns);
        }
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    if (owner.path.source == 0 || owner.path.index >=
            core.paths.storage.path_capacity ||
        !core.paths.storage.paths[owner.path.index].valid ||
        core.paths.storage.paths[owner.path.index].generation !=
            owner.path.generation) {
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    val transport_path: *path_api.Path =
        ?core.paths.storage.paths[owner.path.index];
    if (pacer_api.publish(?transport_path.pacer, owner.pacer, now_ns,
            transport_path.congestion.congestion_window,
            core.recovery_state.rtt.smoothed_ns).status != pacer_api.PUBLISH_OK ||
        path_api.publish_send_scoped(core.paths, core.config.source,
            owner.path_send).status != path_api.STATUS_OK ||
        !publish_payload(core, secrets, owner, now_ns)) {
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    if (owner.ack_eliciting &&
        core.last_received_ns >= core.last_activity_ns) {
        core.last_activity_ns = now_ns;
    }
    if (!owner.ack_eliciting) {
        if (owner.kind == OWNER_CLOSE) {
            core.close_transmissions = core.close_transmissions + 1;
        }
        # the peer may acknowledge this number, so recovery must know it was sent
        if (!recovery.on_untracked_sent(?core.recovery_state, owner.space,
            owner.packet_number, now_ns).ok) {
            ret fail(core, INTERNAL_ERROR, now_ns);
        }
        free_owner(owner);
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    val recovery_path: path_api.Handle = path_api.Handle{
        source: owner.path_send.source, index: owner.path_send.path_index,
        generation: owner.path_send.path_generation};
    if (path_api.retain_recovery_scoped(core.paths, core.config.source,
        recovery_path).status != path_api.STATUS_OK) {
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    if (path_api.recovery_sent_scoped(core.paths, core.config.source, recovery_path,
        owner.bytes::u64).status != path_api.STATUS_OK) {
        path_api.release_recovery_scoped(core.paths, core.config.source, recovery_path);
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    val sent: recovery.OperationResult = recovery.on_packet_sent(
        ?core.recovery_state, owner.space, recovery.SentPacket{
            number: owner.packet_number, sent_at_ns: now_ns,
            sent_after_rtt_sample: core.recovery_state.rtt.has_sample,
            bytes: owner.bytes, owner: owner.owner,
            path_source: recovery_path.source,
            path_index: recovery_path.index,
            path_generation: recovery_path.generation, ecn: 0,
            ack_eliciting: owner.ack_eliciting, in_flight: owner.in_flight});
    if (!sent.ok) {
        path_api.recovery_terminal_scoped(core.paths, core.config.source, recovery_path,
            owner.bytes::u64);
        path_api.release_recovery_scoped(core.paths, core.config.source, recovery_path);
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    owner.state = OWNER_SENT;
    if (core.role == transport_api.SERVER &&
        owner.level == handshake_api.HANDSHAKE &&
        !discard_initial_keys(core, secrets)) {
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    ret core_result(core, transport_api.STATUS_OK, 0);
}

fun timer_candidate(armed: *bool, deadline: *u64, kind: *u8,
                    value: u64, value_kind: u8) {
    if (!@armed || value < @deadline ||
        (value == @deadline && value_kind < @kind)) {
        @armed = true;
        @deadline = value;
        @kind = value_kind;
    }
}

pub fun timer(core: *Core) transport_api.CoreTimer {
    var result: transport_api.CoreTimer;
    if (!core_record_valid(core) || !core.initialized || core.destroyed ||
        core.state == transport_api.CLOSED) { ret result; }
    var armed: bool = false;
    var deadline: u64 = 0;
    var kind: u8 = 0;
    if (core.state == transport_api.CLOSING) {
        timer_candidate(?armed, ?deadline, ?kind,
            core.close_deadline_ns, TIMER_CLOSE);
    } or (core.state == transport_api.DRAINING) {
        timer_candidate(?armed, ?deadline, ?kind,
            core.close_deadline_ns, TIMER_DRAIN);
    } or (core.idle_timer_enabled) {
        timer_candidate(?armed, ?deadline, ?kind,
            saturated_add(core.last_activity_ns,
                core.idle_timeout_ns), TIMER_IDLE);
    }
    val recovery_timer: recovery.Timer = recovery.timer(?core.recovery_state);
    if (!core.closing && recovery_timer.armed) {
        timer_candidate(?armed, ?deadline, ?kind,
            recovery_timer.deadline_ns, TIMER_RECOVERY);
    }
    if (!core.closing) {
        var path_index: usize = 0;
        for (path_index < core.paths.storage.path_capacity) {
            if (core.paths.storage.paths[path_index].valid &&
                core.paths.storage.paths[path_index].validation_deadline_ns != 0) {
                timer_candidate(?armed, ?deadline, ?kind,
                    core.paths.storage.paths[path_index].validation_deadline_ns,
                    TIMER_PATH);
            }
            path_index = path_index + 1;
        }
        var space_index_value: usize = 0;
        for (space_index_value < 3) {
            val ack_space: ack_api.Space =
                core.acknowledgements.spaces[space_index_value];
            if (!ack_space.discarded && ack_space.ack_pending &&
                ack_space.ack_deadline_armed) {
                timer_candidate(?armed, ?deadline, ?kind,
                    ack_space.ack_deadline_ns, TIMER_ACK);
            }
            space_index_value = space_index_value + 1;
        }
    }
    var recovery_generation: u64 = 0;
    if (kind == TIMER_RECOVERY) {
        recovery_generation = recovery_timer.generation;
    }
    if (!armed) { ret result; }
    if (core.timer_kind != kind || core.timer_deadline_ns != deadline ||
        core.timer_recovery_generation != recovery_generation) {
        core.timer_generation = next_generation(core.timer_generation);
        core.timer_kind = kind;
        core.timer_deadline_ns = deadline;
        core.timer_recovery_generation = recovery_generation;
    }
    result.armed = true;
    result.deadline_ns = deadline;
    result.generation = core.timer_generation;
    ret result;
}

fun terminal_drain(core: *Core, secrets: *Secrets, now_ns: u64) bool {
    var i: usize = 0;
    for (i < core.storage.owner_capacity) {
        if (core.storage.owners[i].state == OWNER_PREPARED &&
            !cancel_payload(core, secrets, ?core.storage.owners[i])) { ret false; }
        i = i + 1;
    }
    val discarded: recovery.DiscardResult = recovery.discard_all(
        ?core.recovery_state, now_ns, core.storage.recovery_events,
        core.storage.recovery_event_capacity);
    if (!discarded.ok) { ret false; }
    i = 0;
    for (i < discarded.event_count) {
        if (!terminal_owner(core, secrets,
            ?core.storage.recovery_events[i], now_ns, false)) { ret false; }
        i = i + 1;
    }
    if ((!core.cids.closing && !cid_api.begin_close_scoped(core.cids,
            core.config.source)) ||
        (!core.paths.closing && path_api.begin_close_scoped(core.paths, core.config.source).status !=
            path_api.STATUS_OK)) { ret false; }
    core.state = transport_api.CLOSED;
    ret true;
}

fun apply_path_timeout(core: *Core, value: path_api.TimeoutResult,
                       now_ns: u64) bool {
    if (value.status == path_api.STATUS_EMPTY) { ret true; }
    if (value.status != path_api.STATUS_OK || value.connection_lost) { ret false; }
    ret apply_path_signals(core, value.reset_congestion, value.reset_rtt,
        value.rotate_connection_id, now_ns);
}

pub fun on_timeout(core: *Core, secrets: *Secrets, generation: u64,
                   now_ns: u64) transport_api.CoreResult {
    if (!core_record_valid(core) || !secret_record_valid(secrets) || !core.initialized ||
        !secrets.initialized || core.destroyed || secrets.destroyed ||
        now_ns < core.last_now_ns) {
        ret core_refused(INTERNAL_ERROR);
    }
    val current: transport_api.CoreTimer = timer(core);
    if (!current.armed || generation != current.generation) {
        ret core_result(core, transport_api.STATUS_STALE, 0);
    }
    if (now_ns < current.deadline_ns) {
        ret core_result(core, transport_api.STATUS_EARLY, 0);
    }
    core.last_now_ns = now_ns;
    val fired_kind: u8 = core.timer_kind;
    val recovery_generation: u64 = core.timer_recovery_generation;
    core.timer_kind = 0;
    core.timer_deadline_ns = 0;
    core.timer_recovery_generation = 0;
    core.timer_generation = next_generation(core.timer_generation);
    if (fired_kind == TIMER_CLOSE) {
        core.state = transport_api.DRAINING;
        core.close_queued = false;
        core.close_deadline_ns = saturated_add(now_ns,
            core.config.drain_timeout_ns);
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (fired_kind == TIMER_DRAIN) {
        if (!terminal_drain(core, secrets, now_ns)) {
            ret fail(core, INTERNAL_ERROR, now_ns);
        }
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (fired_kind == TIMER_IDLE) {
        if (!begin_application_close(core)) {
            ret fail(core, INTERNAL_ERROR, now_ns);
        }
        core.closing = true;
        core.close_queued = false;
        core.peer_close_received = true;
        core.close_started_ns = now_ns;
        core.close_deadline_ns = saturated_add(now_ns,
            core.config.drain_timeout_ns);
        core.state = transport_api.DRAINING;
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (fired_kind == TIMER_RECOVERY) {
        val before: u64 = core.recovery_state.bytes_in_flight::u64;
        val selected: path_api.PathResult = path_api.selected(core.paths);
        if (selected.status != path_api.STATUS_OK) {
            ret fail(core, NO_VIABLE_PATH, now_ns);
        }
        val timed: recovery.TimeoutResult = recovery.on_timeout_path(
            ?core.recovery_state, now_ns, recovery_generation,
            selected.handle.source, selected.handle.index,
            selected.handle.generation,
            core.storage.recovery_events, core.storage.recovery_event_capacity);
        if (timed.status == recovery.TIMEOUT_LOSS) {
            if (!apply_recovery_events(core, secrets, timed.event_count,
                now_ns, timed.persistent_congestion, false, before)) {
                ret fail(core, INTERNAL_ERROR, now_ns);
            }
        } or (timed.status == recovery.TIMEOUT_PROBE) {
            core.probe_space = timed.probe_space;
            core.probes_remaining = timed.probe_count;
            core.probe_owner = timed.probe_owner;
        } or {
            ret fail(core, INTERNAL_ERROR, now_ns);
        }
    }
    if (fired_kind == TIMER_PATH && !apply_path_timeout(core,
        path_api.on_timeout_scoped(core.paths, core.config.source, now_ns), now_ns)) {
        ret fail(core, NO_VIABLE_PATH, now_ns);
    }
    ret core_result(core, transport_api.STATUS_OK, 0);
}

pub fun begin_close(core: *Core, secrets: *Secrets, abortive: bool,
                    application_error: u64, reason: *u8,
                    reason_length: usize, now_ns: u64) transport_api.CoreResult {
    val reason_range: ownership.Range = ownership.bytes(reason, reason_length,
        ownership.ZERO_ALLOWED);
    if (!core_record_valid(core) || !secret_record_valid(secrets) || !core.initialized ||
        !secrets.initialized || core.destroyed || secrets.destroyed ||
        now_ns < core.last_now_ns ||
        reason_length > core.storage.close_reason_capacity ||
        !borrowed_disjoint(core, reason_range)) {
        ret core_refused(INTERNAL_ERROR);
    }
    if (core.state == transport_api.CLOSED) {
        ret core_result(core, transport_api.STATUS_CLOSED, 0);
    }
    core.last_now_ns = now_ns;
    if (core.closing) {
        if (abortive) {
            core.close_queued = false;
            core.peer_close_received = true;
            core.state = transport_api.DRAINING;
            if (!terminal_drain(core, secrets, now_ns)) {
                ret fail(core, INTERNAL_ERROR, now_ns);
            }
        }
        ret core_result(core, transport_api.STATUS_OK, 0);
    }
    if (reason_length > 0) {
        memory.copy[u8](core.storage.close_reason, reason, reason_length);
    }
    if (!begin_application_close(core)) {
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    core.close_reason_length = reason_length;
    core.close_error = application_error;
    core.close_frame_type = frame.CONNECTION_CLOSE_APPLICATION;
    if (!level_available(core, secrets, handshake_api.APPLICATION)) {
        core.close_error = APPLICATION_ERROR;
        core.close_frame_type = 0;
    }
    core.closing = true;
    core.close_queued = !abortive;
    core.peer_close_received = abortive;
    core.close_started_ns = now_ns;
    core.close_deadline_ns = now_ns;
    if (!abortive) {
        core.close_deadline_ns = saturated_add(now_ns,
            core.config.drain_timeout_ns);
    }
    core.state = transport_api.CLOSING;
    if (abortive && !terminal_drain(core, secrets, now_ns)) {
        ret fail(core, INTERNAL_ERROR, now_ns);
    }
    ret core_result(core, transport_api.STATUS_OK, 0);
}

pub fun close_ready(core: *Core) bool {
    if (!core_record_valid(core) || !core.initialized || core.destroyed ||
        core.state != transport_api.CLOSED || !core.cids.closing ||
        !core.paths.closing || !core.streams.closing ||
        !core.datagrams.closing || core.streams.active_attempts != 0 ||
        core.datagrams.send_count != 0 || core.datagrams.delivered_count != 0) {
        ret false;
    }
    var i: usize = 0;
    for (i < core.storage.owner_capacity) {
        if (core.storage.owners[i].state != OWNER_FREE) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun finish_close(core: *Core, secrets: *Secrets) bool {
    if (!close_ready(core) || !secret_record_valid(secrets) || !secrets.initialized ||
        secrets.destroyed) { ret false; }
    val handshake_snapshot: handshake_api.Snapshot =
        handshake_api.snapshot(secrets.handshake);
    if (handshake_snapshot.event_active) { ret false; }
    if (!handshake_snapshot.closing && handshake_api.close_scoped(secrets.handshake, core.config.source, 0, core.last_now_ns).status != handshake_api.STATUS_OK) { ret false; }
    if (!handshake_api.destroy_scoped(secrets.handshake,
        core.config.source)) { ret false; }
    protection.destroy_initial(?secrets.initial_keys);
    protection.destroy(?secrets.early_send);
    protection.destroy(?secrets.early_receive);
    protection.destroy(?secrets.handshake_send);
    protection.destroy(?secrets.handshake_receive);
    protection.destroy_send(?secrets.application_send);
    protection.destroy_receive(?secrets.application_receive);
    ct.zeroize(secrets.storage.receive_plaintext,
        secrets.storage.receive_plaintext_capacity);
    ct.zeroize(secrets.storage.send_plaintext,
        secrets.storage.send_plaintext_capacity);
    if (!cid_api.finish_close_scoped(core.cids, core.config.source) ||
        path_api.finish_close_scoped(core.paths, core.config.source).status != path_api.STATUS_OK ||
        stream_api.finish_close_scoped(core.streams, core.config.source).status != stream_api.STATUS_OK ||
        datagram_api.finish_close_scoped(core.datagrams, core.config.source).status != datagram_api.STATUS_OK) {
        ret false;
    }
    secrets.initialized = false;
    secrets.destroyed = true;
    core.initialized = false;
    core.destroyed = true;
    ret true;
}
