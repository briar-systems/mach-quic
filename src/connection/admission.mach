# bounded server connection admission before expensive allocation

use quic.connection.ownership;

use std.memory;
use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Status: u8;
pub val STATUS_OK:      Status = 1;
pub val STATUS_BLOCKED: Status = 2;
pub val STATUS_STALE:   Status = 3;
pub val STATUS_ERROR:   Status = 4;

pub def Error: u8;
pub val ERROR_NONE:            Error = 0;
pub val ERROR_STATE:           Error = 1;
pub val ERROR_CONFIG:          Error = 2;
pub val ERROR_GLOBAL_LIMIT:    Error = 3;
pub val ERROR_PEER_LIMIT:      Error = 4;
pub val ERROR_PEER_CAPACITY:   Error = 5;
pub val ERROR_CHARGE_CAPACITY: Error = 6;
pub val ERROR_TOKEN:           Error = 7;
pub val ERROR_OVERFLOW:        Error = 8;

pub def ChargeState: u8;
pub val CHARGE_FREE:      ChargeState = 0;
pub val CHARGE_RESERVED:  ChargeState = 1;
pub val CHARGE_COMMITTED: ChargeState = 2;

pub rec Config {
    source:                   u64;
    max_connections:          usize;
    max_connections_per_peer: usize;
}

# peer quotas are keyed by address, not ephemeral source port
pub rec PeerKey {
    address: [16]u8;
    scope:   u32;
    is_v6:   bool;
}

pub rec PeerSlot {
    key:        PeerKey;
    active:     usize;
    generation: u64;
    used:       bool;
}

pub rec ChargeSlot {
    peer_index: usize;
    generation: u64;
    state:      ChargeState;
}

pub rec Storage {
    peers:           *PeerSlot;
    peer_capacity:   usize;
    charges:         *ChargeSlot;
    charge_capacity: usize;
}

pub rec Manager {
    config:         Config;
    storage:        Storage;
    active:         usize;
    reserved:       usize;
    next_peer:      usize;
    next_charge:    usize;
    listener_lease: u64;
    initialized:    bool;
    closing:        bool;
}

pub rec Charge {
    source:     u64;
    index:      usize;
    generation: u64;
}

pub rec Result {
    status: Status;
    error:  Error;
    charge: Charge;
}

pub rec Snapshot {
    active:      usize;
    reserved:    usize;
    peers:       usize;
    initialized: bool;
    closing:     bool;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

pub fun peer_key(endpoint: ip.Endpoint) PeerKey {
    var key: PeerKey;
    if (endpoint.addr.is_v6 != 0) {
        key.is_v6 = true;
        key.scope = endpoint.scope;
        memory.copy[u8](?key.address[0], ?endpoint.addr.v6.octets[0], 16);
    }
    or {
        memory.copy[u8](?key.address[0], ?endpoint.addr.v4.octets[0], 4);
    }
    ret key;
}

pub fun peer_equal(left: PeerKey, right: PeerKey) bool {
    if (left.is_v6 != right.is_v6 || left.scope != right.scope) { ret false; }
    var length: usize = 4;
    if (left.is_v6) { length = 16; }
    var i: usize = 0;
    for (i < length) {
        if (left.address[i] != right.address[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun physical(manager: *Manager) bool {
    if (!ownership.bytes(manager::*u8, $size_of(Manager),
        ownership.ZERO_FORBIDDEN).valid) { ret false; }
    val peers: ownership.Range = ownership.array(manager.storage.peers::*u8,
        manager.storage.peer_capacity, $size_of(PeerSlot),
        ownership.ZERO_FORBIDDEN);
    val charges: ownership.Range = ownership.array(manager.storage.charges::*u8,
        manager.storage.charge_capacity, $size_of(ChargeSlot),
        ownership.ZERO_FORBIDDEN);
    var ranges: [3]ownership.Range;
    ranges[0] = ownership.bytes(manager::*u8, $size_of(Manager),
        ownership.ZERO_FORBIDDEN);
    ranges[1] = peers;
    ranges[2] = charges;
    ret ownership.all_disjoint(?ranges[0], 3);
}

pub fun initialize(manager: *Manager, config: Config, storage: Storage) bool {
    if (config.source == 0 || config.max_connections == 0 ||
        config.max_connections_per_peer == 0 ||
        config.max_connections_per_peer > config.max_connections ||
        storage.peers == nil || storage.peer_capacity == 0 ||
        storage.charges == nil || storage.charge_capacity < config.max_connections) {
        ret false;
    }
    val manager_range: ownership.Range = ownership.bytes(manager::*u8,
        $size_of(Manager), ownership.ZERO_FORBIDDEN);
    val peer_range: ownership.Range = ownership.array(storage.peers::*u8,
        storage.peer_capacity, $size_of(PeerSlot), ownership.ZERO_FORBIDDEN);
    val charge_range: ownership.Range = ownership.array(storage.charges::*u8,
        storage.charge_capacity, $size_of(ChargeSlot), ownership.ZERO_FORBIDDEN);
    var ranges: [3]ownership.Range = [3]ownership.Range{
        manager_range, peer_range, charge_range
    };
    if (!ownership.all_disjoint(?ranges[0], 3) || manager.initialized) { ret false; }
    var i: usize = 0;
    for (i < storage.peer_capacity) {
        storage.peers[i].active     = 0;
        storage.peers[i].used       = false;
        storage.peers[i].generation = next_generation(storage.peers[i].generation);
        i                           = i + 1;
    }
    i = 0;
    for (i < storage.charge_capacity) {
        storage.charges[i].state      = CHARGE_FREE;
        storage.charges[i].generation = next_generation(storage.charges[i].generation);
        i                             = i + 1;
    }
    manager.config         = config;
    manager.storage        = storage;
    manager.active         = 0;
    manager.reserved       = 0;
    manager.next_peer      = 0;
    manager.next_charge    = 0;
    manager.listener_lease = 0;
    manager.closing        = false;
    manager.initialized    = true;
    ret true;
}

fun scope_allowed(manager: *Manager, listener_source: u64) bool {
    if (listener_source == 0) { ret manager.listener_lease == 0; }
    ret manager.listener_lease == listener_source;
}

pub fun lease_listener(manager: *Manager, source: u64) bool {
    if (!physical(manager) || !manager.initialized || manager.closing ||
        source == 0 || manager.listener_lease != 0) { ret false; }
    manager.listener_lease = source;
    ret true;
}

pub fun release_listener(manager: *Manager, source: u64) bool {
    if (!physical(manager) || !manager.initialized || source == 0 ||
        manager.listener_lease != source) { ret false; }
    manager.listener_lease = 0;
    ret true;
}

fun find_peer(manager: *Manager, key: PeerKey) usize {
    var i: usize = 0;
    for (i < manager.storage.peer_capacity) {
        if (manager.storage.peers[i].used &&
            peer_equal(manager.storage.peers[i].key, key)) { ret i; }
        i = i + 1;
    }
    ret manager.storage.peer_capacity;
}

fun claim_peer(manager: *Manager, key: PeerKey) usize {
    var offset: usize = 0;
    for (offset < manager.storage.peer_capacity) {
        val i: usize = (manager.next_peer + offset) % manager.storage.peer_capacity;
        if (!manager.storage.peers[i].used) {
            manager.storage.peers[i].key        = key;
            manager.storage.peers[i].active     = 0;
            manager.storage.peers[i].used       = true;
            manager.storage.peers[i].generation =
                next_generation(manager.storage.peers[i].generation);
            manager.next_peer = (i + 1) % manager.storage.peer_capacity;
            ret i;
        }
        offset = offset + 1;
    }
    ret manager.storage.peer_capacity;
}

fun claim_charge(manager: *Manager) usize {
    var offset: usize = 0;
    for (offset < manager.storage.charge_capacity) {
        val i: usize = (manager.next_charge + offset) % manager.storage.charge_capacity;
        if (manager.storage.charges[i].state == CHARGE_FREE) {
            manager.next_charge = (i + 1) % manager.storage.charge_capacity;
            ret i;
        }
        offset = offset + 1;
    }
    ret manager.storage.charge_capacity;
}

pub fun reserve(manager: *Manager, endpoint: ip.Endpoint) Result {
    ret reserve_scoped(manager, 0, endpoint);
}

pub fun reserve_scoped(manager: *Manager, listener_source: u64,
    endpoint: ip.Endpoint) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, listener_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (manager.active > manager.config.max_connections - manager.reserved ||
        manager.active + manager.reserved >= manager.config.max_connections) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_GLOBAL_LIMIT;
        ret result;
    }
    val key:        PeerKey = peer_key(endpoint);
    var peer_index: usize   = find_peer(manager, key);
    if (peer_index == manager.storage.peer_capacity) {
        peer_index = claim_peer(manager, key);
        if (peer_index == manager.storage.peer_capacity) {
            result.status = STATUS_BLOCKED;
            result.error  = ERROR_PEER_CAPACITY;
            ret result;
        }
    }
    val peer: *PeerSlot = ?manager.storage.peers[peer_index];
    if (peer.active >= manager.config.max_connections_per_peer) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_PEER_LIMIT;
        ret result;
    }
    val charge_index: usize = claim_charge(manager);
    if (charge_index == manager.storage.charge_capacity) {
        if (peer.active == 0) { peer.used = false; }
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_CHARGE_CAPACITY;
        ret result;
    }
    val slot: *ChargeSlot = ?manager.storage.charges[charge_index];
    slot.generation  = next_generation(slot.generation);
    slot.peer_index  = peer_index;
    slot.state       = CHARGE_RESERVED;
    peer.active      = peer.active + 1;
    manager.reserved = manager.reserved + 1;
    result.status    = STATUS_OK;
    result.charge    = Charge{source: manager.config.source, index: charge_index,
        generation: slot.generation};
    ret result;
}

fun slot_for(manager: *Manager, charge: Charge) *ChargeSlot {
    if (!physical(manager) || !manager.initialized || charge.source != manager.config.source ||
        charge.index >= manager.storage.charge_capacity) { ret nil; }
    val slot: *ChargeSlot = ?manager.storage.charges[charge.index];
    if (slot.state == CHARGE_FREE || slot.generation != charge.generation) { ret nil; }
    ret slot;
}

pub fun commit(manager: *Manager, charge: Charge) Result {
    ret commit_scoped(manager, 0, charge);
}

pub fun commit_scoped(manager: *Manager, listener_source: u64,
    charge: Charge) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, listener_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val slot: *ChargeSlot = slot_for(manager, charge);
    if (slot == nil || slot.state != CHARGE_RESERVED) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    slot.state       = CHARGE_COMMITTED;
    manager.reserved = manager.reserved - 1;
    manager.active   = manager.active + 1;
    result.status    = STATUS_OK;
    result.charge    = charge;
    ret result;
}

pub fun release(manager: *Manager, charge: Charge) Result {
    ret release_scoped(manager, 0, charge);
}

pub fun release_scoped(manager: *Manager, listener_source: u64,
    charge: Charge) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized ||
        !scope_allowed(manager, listener_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val slot: *ChargeSlot = slot_for(manager, charge);
    if (slot == nil) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    if (slot.state == CHARGE_RESERVED)  { manager.reserved = manager.reserved - 1; }
    if (slot.state == CHARGE_COMMITTED) { manager.active = manager.active - 1; }
    val peer: *PeerSlot = ?manager.storage.peers[slot.peer_index];
    peer.active = peer.active - 1;
    if (peer.active == 0) {
        peer.used       = false;
        peer.generation = next_generation(peer.generation);
    }
    slot.state      = CHARGE_FREE;
    slot.generation = next_generation(slot.generation);
    result.status   = STATUS_OK;
    result.charge   = charge;
    ret result;
}

pub fun begin_close(manager: *Manager) bool {
    if (!physical(manager) || !manager.initialized || manager.closing ||
        manager.listener_lease != 0) { ret false; }
    manager.closing = true;
    ret true;
}

pub fun finish_close(manager: *Manager) bool {
    if (!physical(manager) || !manager.initialized || !manager.closing ||
        manager.listener_lease != 0 ||
        manager.active != 0 || manager.reserved != 0) { ret false; }
    manager.initialized = false;
    ret true;
}

pub fun snapshot(manager: *Manager) Snapshot {
    var value: Snapshot;
    if (!physical(manager) || !manager.initialized) { ret value; }
    value.active      = manager.active;
    value.reserved    = manager.reserved;
    value.initialized = manager.initialized;
    value.closing     = manager.closing;
    var i: usize = 0;
    for (i < manager.storage.peer_capacity) {
        if (manager.storage.peers[i].used) { value.peers = value.peers + 1; }
        i = i + 1;
    }
    ret value;
}

test "quic.connection.admission: global and peer limits are charged before commit" {
    var peers:   [3]PeerSlot;
    var charges: [3]ChargeSlot;
    var manager: Manager;
    if (!initialize(?manager, Config{source: 91, max_connections: 3,
        max_connections_per_peer: 2}, Storage{peers: ?peers[0], peer_capacity: 3,
        charges:                  ?charges[0], charge_capacity: 3})) { ret 1; }
    val first:   Result = reserve(?manager, ip.endpoint(192, 0, 2, 1, 4000));
    val second:  Result = reserve(?manager, ip.endpoint(192, 0, 2, 1, 4001));
    val blocked: Result = reserve(?manager, ip.endpoint(192, 0, 2, 1, 4002));
    if (first.status != STATUS_OK || second.status != STATUS_OK ||
        blocked.error != ERROR_PEER_LIMIT || snapshot(?manager).reserved != 2) { ret 1; }
    if (commit(?manager, first.charge).status != STATUS_OK ||
        release(?manager, second.charge).status != STATUS_OK) { ret 2; }
    val other: Result = reserve(?manager, ip.endpoint(192, 0, 2, 2, 4000));
    val third: Result = reserve(?manager, ip.endpoint(192, 0, 2, 3, 4000));
    val full:  Result = reserve(?manager, ip.endpoint(192, 0, 2, 4, 4000));
    if (other.status != STATUS_OK || third.status != STATUS_OK ||
        full.error != ERROR_GLOBAL_LIMIT ||
        commit(?manager, other.charge).status != STATUS_OK) { ret 3; }
    if (release(?manager, first.charge).status != STATUS_OK ||
        release(?manager, other.charge).status != STATUS_OK ||
        release(?manager, third.charge).status != STATUS_OK) { ret 4; }
    if (!begin_close(?manager) || !finish_close(?manager)) { ret 5; }
    ret 0;
}

test "quic.connection.admission: stale and cross-source charges cannot release capacity" {
    var peers:   [1]PeerSlot;
    var charges: [1]ChargeSlot;
    var manager: Manager;
    if (!initialize(?manager, Config{source: 92, max_connections: 1,
        max_connections_per_peer: 1}, Storage{peers: ?peers[0], peer_capacity: 1,
        charges:                  ?charges[0], charge_capacity: 1})) { ret 1; }
    val held:  Result = reserve(?manager, ip.endpoint(203, 0, 113, 1, 1));
    var wrong: Charge = held.charge;
    wrong.source = 93;
    if (release(?manager, wrong).status != STATUS_STALE ||
        commit(?manager, held.charge).status != STATUS_OK ||
        release(?manager, held.charge).status != STATUS_OK ||
        release(?manager, held.charge).status != STATUS_STALE) { ret 1; }
    val reused: Result = reserve(?manager, ip.endpoint(203, 0, 113, 2, 2));
    if (reused.status != STATUS_OK || reused.charge.generation == held.charge.generation ||
        release(?manager, held.charge).status != STATUS_STALE ||
        release(?manager, reused.charge).status != STATUS_OK) { ret 2; }
    ret 0;
}

test "quic.connection.admission: hostile products and aliases publish no initialization" {
    val maximum: usize = ~(0::usize);
    var peers:   [2]PeerSlot;
    var charges: [1]ChargeSlot;
    peers[0].active  = 71;
    charges[0].state = CHARGE_COMMITTED;
    var manager:       Manager;
    val peer_overflow: usize = maximum / $size_of(PeerSlot) + 1;
    if (initialize(?manager, Config{source: 93, max_connections: 1,
        max_connections_per_peer: 1}, Storage{peers: (1::usize)::*PeerSlot,
        peer_capacity:            peer_overflow, charges: ?charges[0], charge_capacity: 1}) ||
        initialize(?manager, Config{source: 93, max_connections: 1,
        max_connections_per_peer: 1}, Storage{peers: maximum::*PeerSlot,
        peer_capacity:            1, charges: ?charges[0], charge_capacity: 1}) ||
        initialize(?manager, Config{source: 93, max_connections: 1,
        max_connections_per_peer: 1}, Storage{peers: ?peers[0],
        peer_capacity:            2, charges: (?peers[0])::*ChargeSlot,
        charge_capacity:          1}) || manager.initialized || peers[0].active != 71 ||
        charges[0].state != CHARGE_COMMITTED) { ret 1; }
    if (!initialize(?manager, Config{source: 93, max_connections: 1,
        max_connections_per_peer: 1}, Storage{peers: ?peers[0],
        peer_capacity:            2, charges: ?charges[0], charge_capacity: 1})) { ret 2; }
    val generation: u64 = peers[0].generation;
    if (initialize(?manager, Config{source: 94, max_connections: 1,
        max_connections_per_peer: 1}, Storage{peers: ?peers[0],
        peer_capacity:            2, charges: ?charges[0], charge_capacity: 1}) ||
        manager.config.source != 93 || peers[0].generation != generation) { ret 3; }
    ret 0;
}
