# bounded connection id lifecycle

use quic.connection.ownership;
use quic.packet.packet;

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Status: u8;
pub val STATUS_OK:        Status = 1;
pub val STATUS_DUPLICATE: Status = 2;
pub val STATUS_STALE:     Status = 3;
pub val STATUS_BLOCKED:   Status = 4;
pub val STATUS_ERROR:     Status = 5;

pub def Error: u8;
pub val ERROR_NONE:            Error = 0;
pub val ERROR_STATE:           Error = 1;
pub val ERROR_CONFIG:          Error = 2;
pub val ERROR_CAPACITY:        Error = 3;
pub val ERROR_LIMIT:           Error = 4;
pub val ERROR_SEQUENCE:        Error = 5;
pub val ERROR_DUPLICATE_ID:    Error = 6;
pub val ERROR_DUPLICATE_TOKEN: Error = 7;
pub val ERROR_RETIRE_CURRENT:  Error = 8;
pub val ERROR_TOKEN:           Error = 9;
pub val ERROR_ZERO_LENGTH:     Error = 10;

pub def EntryState: u8;
pub val ENTRY_FREE:          EntryState = 0;
pub val ENTRY_ACTIVE:        EntryState = 1;
pub val ENTRY_RETIRE_QUEUED: EntryState = 2;
pub val ENTRY_RETIRED:       EntryState = 3;
pub val ENTRY_RETIRE_SENT:   EntryState = 4;

pub rec Entry {
    id:                     packet.ConnectionId;
    reset_token:            [16]u8;
    sequence:               u64;
    generation:             u64;
    state:                  EntryState;
    current:                bool;
    advertised:             bool;
    advertisement_inflight: bool;
    reset_token_present:    bool;
}

pub rec Storage {
    local:          *Entry;
    local_capacity: usize;
    peer:           *Entry;
    peer_capacity:  usize;
}

pub rec Config {
    source:             u64;
    local_active_limit: usize;
    peer_active_limit:  usize;
}

pub rec Manager {
    config:                             Config;
    storage:                            Storage;
    local_active:                       usize;
    peer_active:                        usize;
    peer_retire_prior_to:               u64;
    core_lease:                         u64;
    initial_peer_reset_token_installed: bool;
    initialized:                        bool;
    closing:                            bool;
}

pub rec Handle {
    source:     u64;
    index:      usize;
    generation: u64;
    sequence:   u64;
    local:      bool;
}

pub rec Result {
    status:             Status;
    error:              Error;
    handle:             Handle;
    retired:            usize;
    replacement_needed: bool;
}

pub rec Selected {
    status:      Status;
    error:       Error;
    handle:      Handle;
    id:          packet.ConnectionId;
    reset_token: [16]u8;
}

pub rec Snapshot {
    local_active:         usize;
    peer_active:          usize;
    peer_retire_prior_to: u64;
    initialized:          bool;
    closing:              bool;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun token_equal(left: *[16]u8, right: *[16]u8) bool {
    var i: usize = 0;
    for (i < 16) {
        if (left[0][i] != right[0][i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun entry_equal(entry: *Entry, id: *packet.ConnectionId, reset_token: *[16]u8) bool {
    ret entry.reset_token_present && packet.connection_id_equal(?entry.id, id) &&
        token_equal(?entry.reset_token, reset_token);
}

fun clear_entries(entries: *Entry, capacity: usize) {
    var i: usize = 0;
    for (i < capacity) {
        entries[i].state                  = ENTRY_FREE;
        entries[i].current                = false;
        entries[i].advertised             = false;
        entries[i].advertisement_inflight = false;
        entries[i].reset_token_present    = false;
        entries[i].generation             = next_generation(entries[i].generation);
        i                                 = i + 1;
    }
}

fun assign(entry: *Entry, sequence: u64, id: packet.ConnectionId,
    reset_token: [16]u8, reset_token_present: bool,
    current: bool, advertised: bool) {
    entry.id                     = id;
    entry.reset_token            = reset_token;
    entry.sequence               = sequence;
    entry.generation             = next_generation(entry.generation);
    entry.state                  = ENTRY_ACTIVE;
    entry.current                = current;
    entry.advertised             = advertised;
    entry.advertisement_inflight = false;
    entry.reset_token_present    = reset_token_present;
}

# the record itself. its storage was proven disjoint from it at initialize and
# is not reassigned after, so every caller pairs this with `initialized`
fun physical(manager: *Manager) bool {
    ret ownership.bytes(manager::*u8, $size_of(Manager),
        ownership.ZERO_FORBIDDEN).valid;
}

pub fun initialize(manager: *Manager, config: Config, storage: Storage,
    initial_local: packet.ConnectionId,
    initial_peer: packet.ConnectionId) bool {
    if (config.source == 0 || config.local_active_limit < 2 ||
        config.peer_active_limit < 2 || storage.local == nil || storage.peer == nil ||
        storage.local_capacity < config.local_active_limit ||
        config.peer_active_limit > storage.peer_capacity / 2 ||
        initial_local.len::usize > packet.MAX_CONNECTION_ID ||
        initial_peer.len::usize > packet.MAX_CONNECTION_ID) { ret false; }
    var ranges: [3]ownership.Range;
    ranges[0] = ownership.bytes(manager::*u8, $size_of(Manager),
        ownership.ZERO_FORBIDDEN);
    ranges[1] = ownership.array(storage.local::*u8, storage.local_capacity,
        $size_of(Entry), ownership.ZERO_FORBIDDEN);
    ranges[2] = ownership.array(storage.peer::*u8, storage.peer_capacity,
        $size_of(Entry), ownership.ZERO_FORBIDDEN);
    if (!ownership.all_disjoint(?ranges[0], 3) || manager.initialized) { ret false; }
    clear_entries(storage.local, storage.local_capacity);
    clear_entries(storage.peer, storage.peer_capacity);
    var empty_token: [16]u8;
    assign(?storage.local[0], 0, initial_local, empty_token, false, true, true);
    assign(?storage.peer[0], 0, initial_peer, empty_token, false, true, true);
    manager.config                             = config;
    manager.storage                            = storage;
    manager.local_active                       = 1;
    manager.peer_active                        = 1;
    manager.peer_retire_prior_to               = 0;
    manager.core_lease                         = 0;
    manager.initial_peer_reset_token_installed = false;
    manager.closing                            = false;
    manager.initialized                        = true;
    ret true;
}

fun scope_allowed(manager: *Manager, core_source: u64) bool {
    if (core_source == 0) { ret manager.core_lease == 0; }
    ret manager.core_lease == core_source;
}

pub fun lease_core(manager: *Manager, source: u64) bool {
    if (!physical(manager) || !manager.initialized || manager.closing ||
        source == 0 || manager.core_lease != 0) { ret false; }
    manager.core_lease = source;
    ret true;
}

pub fun release_core(manager: *Manager, source: u64) bool {
    if (!physical(manager) || !manager.initialized || source == 0 ||
        manager.core_lease != source) { ret false; }
    manager.core_lease = 0;
    ret true;
}

fun handle(manager: *Manager, index: usize, local: bool) Handle {
    var entry: *Entry = ?manager.storage.peer[index];
    if (local) { entry = ?manager.storage.local[index]; }
    ret Handle{source: manager.config.source, index: index,
        generation: entry.generation, sequence: entry.sequence, local: local};
}

fun entries(manager: *Manager, local: bool) *Entry {
    if (local) { ret manager.storage.local; }
    ret manager.storage.peer;
}

fun capacity(manager: *Manager, local: bool) usize {
    if (local) { ret manager.storage.local_capacity; }
    ret manager.storage.peer_capacity;
}

fun slot_for(manager: *Manager, value: Handle) *Entry {
    if (!physical(manager) || !manager.initialized || value.source != manager.config.source ||
        value.index >= capacity(manager, value.local)) { ret nil; }
    val slot: *Entry = ?entries(manager, value.local)[value.index];
    if (slot.state == ENTRY_FREE || slot.generation != value.generation ||
        slot.sequence != value.sequence) { ret nil; }
    ret slot;
}

fun find_sequence(values: *Entry, count: usize, sequence: u64) usize {
    var i: usize = 0;
    for (i < count) {
        if (values[i].state != ENTRY_FREE && values[i].sequence == sequence) { ret i; }
        i = i + 1;
    }
    ret count;
}

fun find_free(values: *Entry, count: usize) usize {
    var i: usize = 0;
    for (i < count) {
        if (values[i].state == ENTRY_FREE || values[i].state == ENTRY_RETIRED) { ret i; }
        i = i + 1;
    }
    ret count;
}

fun collision(values: *Entry, count: usize, id: *packet.ConnectionId,
    token: *[16]u8, sequence: u64) Error {
    var i: usize = 0;
    for (i < count) {
        if (values[i].state != ENTRY_FREE && values[i].state != ENTRY_RETIRED &&
            values[i].sequence != sequence) {
            if (packet.connection_id_equal(?values[i].id, id)) { ret ERROR_DUPLICATE_ID; }
            if (values[i].reset_token_present &&
                token_equal(?values[i].reset_token, token)) {
                ret ERROR_DUPLICATE_TOKEN;
            }
        }
        i = i + 1;
    }
    ret ERROR_NONE;
}

pub fun issue_local(manager: *Manager, sequence: u64, id: packet.ConnectionId,
    reset_token: [16]u8) Result {
    ret issue_local_scoped(manager, 0, sequence, id, reset_token);
}

pub fun issue_local_scoped(manager: *Manager, core_source: u64, sequence: u64,
    id: packet.ConnectionId,
    reset_token: [16]u8) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source) || id.len == 0 ||
        id.len::usize > packet.MAX_CONNECTION_ID) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    # rfc 9000 5.1.1: an endpoint that chose a zero-length id cannot issue more
    if (local_zero_length(manager)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_ZERO_LENGTH;
        ret result;
    }
    val existing: usize = find_sequence(manager.storage.local,
        manager.storage.local_capacity, sequence);
    if (existing != manager.storage.local_capacity) {
        if (entry_equal(?manager.storage.local[existing], ?id, ?reset_token)) {
            result.status = STATUS_DUPLICATE;
            result.handle = handle(manager, existing, true);
        }
        or {
            result.status = STATUS_ERROR;
            result.error  = ERROR_SEQUENCE;
        }
        ret result;
    }
    val conflict: Error = collision(manager.storage.local, manager.storage.local_capacity,
        ?id, ?reset_token, sequence);
    if (conflict != ERROR_NONE) {
        result.status = STATUS_ERROR;
        result.error  = conflict;
        ret result;
    }
    if (manager.local_active >= manager.config.local_active_limit) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_LIMIT;
        ret result;
    }
    val index: usize = find_free(manager.storage.local, manager.storage.local_capacity);
    if (index == manager.storage.local_capacity) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_CAPACITY;
        ret result;
    }
    assign(?manager.storage.local[index], sequence, id, reset_token, true, false, false);
    manager.local_active = manager.local_active + 1;
    result.status        = STATUS_OK;
    result.handle        = handle(manager, index, true);
    ret result;
}

# retry replaces the peer's sequence-zero initial destination before authentication
pub fun replace_initial_peer(manager: *Manager, id: packet.ConnectionId) Result {
    ret replace_initial_peer_scoped(manager, 0, id);
}

pub fun replace_initial_peer_scoped(manager: *Manager, core_source: u64,
    id: packet.ConnectionId) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source) ||
        id.len::usize > packet.MAX_CONNECTION_ID || manager.peer_active != 1 ||
        manager.peer_retire_prior_to != 0 || manager.storage.peer[0].state != ENTRY_ACTIVE ||
        manager.storage.peer[0].sequence != 0 || !manager.storage.peer[0].current ||
        manager.initial_peer_reset_token_installed) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    manager.storage.peer[0].id         = id;
    manager.storage.peer[0].generation =
        next_generation(manager.storage.peer[0].generation);
    result.status = STATUS_OK;
    result.handle = handle(manager, 0, false);
    ret result;
}

pub fun install_initial_peer_reset_token(manager: *Manager,
    reset_token: [16]u8) Result {
    ret install_initial_peer_reset_token_scoped(manager, 0, reset_token);
}

pub fun install_initial_peer_reset_token_scoped(manager: *Manager,
    core_source: u64,
    reset_token: [16]u8) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source) ||
        manager.storage.peer[0].state != ENTRY_ACTIVE ||
        manager.storage.peer[0].sequence != 0) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val initial: *Entry = ?manager.storage.peer[0];
    if (manager.initial_peer_reset_token_installed) {
        if (token_equal(?initial.reset_token, ?reset_token)) {
            result.status = STATUS_DUPLICATE;
            result.handle = handle(manager, 0, false);
        }
        or {
            result.status = STATUS_ERROR;
            result.error  = ERROR_SEQUENCE;
        }
        ret result;
    }
    val conflict: Error = collision(manager.storage.peer,
        manager.storage.peer_capacity, ?initial.id, ?reset_token, 0);
    if (conflict != ERROR_NONE) {
        result.status = STATUS_ERROR;
        result.error  = conflict;
        ret result;
    }
    initial.reset_token                        = reset_token;
    initial.reset_token_present                = true;
    manager.initial_peer_reset_token_installed = true;
    result.status                              = STATUS_OK;
    result.handle                              = handle(manager, 0, false);
    ret result;
}

# applies the peer's active_connection_id_limit before any additional local id is issued
pub fun update_local_limit(manager: *Manager, limit: u64) Result {
    ret update_local_limit_scoped(manager, 0, limit);
}

pub fun update_local_limit_scoped(manager: *Manager, core_source: u64,
    limit: u64) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source) || limit < 2) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_LIMIT;
        ret result;
    }
    var effective: usize = manager.storage.local_capacity;
    if (limit < effective::u64) { effective = limit::usize; }
    if (manager.local_active > effective) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_LIMIT;
        ret result;
    }
    manager.config.local_active_limit = effective;
    result.status                     = STATUS_OK;
    ret result;
}

# applies NEW_CONNECTION_ID transactionally after validating all collisions and limits
pub fun receive_new(manager: *Manager, sequence: u64, retire_prior_to: u64,
    id: packet.ConnectionId, reset_token: [16]u8) Result {
    ret receive_new_scoped(manager, 0, sequence, retire_prior_to, id, reset_token);
}

pub fun receive_new_scoped(manager: *Manager, core_source: u64, sequence: u64,
    retire_prior_to: u64, id: packet.ConnectionId,
    reset_token: [16]u8) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source) || id.len == 0 ||
        id.len::usize > packet.MAX_CONNECTION_ID || retire_prior_to > sequence ||
        retire_prior_to < manager.peer_retire_prior_to) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_SEQUENCE;
        ret result;
    }
    # rfc 9000 19.15: a peer addressed by a zero-length id has none to issue
    if (peer_zero_length(manager)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_ZERO_LENGTH;
        ret result;
    }
    val existing: usize = find_sequence(manager.storage.peer,
        manager.storage.peer_capacity, sequence);
    if (existing != manager.storage.peer_capacity &&
        !entry_equal(?manager.storage.peer[existing], ?id, ?reset_token)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_SEQUENCE;
        ret result;
    }
    val conflict: Error = collision(manager.storage.peer, manager.storage.peer_capacity,
        ?id, ?reset_token, sequence);
    if (conflict != ERROR_NONE) {
        result.status = STATUS_ERROR;
        result.error  = conflict;
        ret result;
    }
    var retiring:        usize = 0;
    var current_retired: bool  = false;
    var i:               usize = 0;
    for (i < manager.storage.peer_capacity) {
        val entry: *Entry = ?manager.storage.peer[i];
        if (entry.state == ENTRY_ACTIVE && entry.sequence < retire_prior_to) {
            retiring = retiring + 1;
            if (entry.current) { current_retired = true; }
        }
        i = i + 1;
    }
    var resulting: usize = manager.peer_active - retiring;
    if (existing == manager.storage.peer_capacity) { resulting = resulting + 1; }
    if (resulting > manager.config.peer_active_limit) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_LIMIT;
        ret result;
    }
    if (existing == manager.storage.peer_capacity &&
        find_free(manager.storage.peer, manager.storage.peer_capacity) ==
        manager.storage.peer_capacity) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_CAPACITY;
        ret result;
    }

    i = 0;
    for (i < manager.storage.peer_capacity) {
        val entry: *Entry = ?manager.storage.peer[i];
        if (entry.state == ENTRY_ACTIVE && entry.sequence < retire_prior_to) {
            entry.state   = ENTRY_RETIRE_QUEUED;
            entry.current = false;
        }
        i = i + 1;
    }
    manager.peer_active          = manager.peer_active - retiring;
    manager.peer_retire_prior_to = retire_prior_to;
    var index: usize = existing;
    if (index == manager.storage.peer_capacity) {
        index = find_free(manager.storage.peer, manager.storage.peer_capacity);
        assign(?manager.storage.peer[index], sequence, id, reset_token, true,
            current_retired, true);
        manager.peer_active = manager.peer_active + 1;
    }
    if (current_retired && existing != manager.storage.peer_capacity) {
        manager.storage.peer[index].current = true;
    }
    result.status = STATUS_OK;
    if (existing != manager.storage.peer_capacity) { result.status = STATUS_DUPLICATE; }
    result.handle  = handle(manager, index, false);
    result.retired = retiring;
    ret result;
}

pub fun receive_retire(manager: *Manager, sequence: u64) Result {
    ret receive_retire_scoped(manager, 0, sequence);
}

pub fun receive_retire_scoped(manager: *Manager, core_source: u64,
    sequence: u64) Result {
    val current: Selected = current(manager, true);
    if (current.status != STATUS_OK) {
        var failed: Result;
        failed.status = STATUS_ERROR;
        failed.error  = ERROR_STATE;
        ret failed;
    }
    ret receive_retire_in_packet_scoped(manager, core_source, sequence,
        current.handle.sequence);
}

pub fun receive_retire_in_packet_scoped(manager: *Manager, core_source: u64,
    sequence: u64,
    destination_sequence: u64) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val index: usize = find_sequence(manager.storage.local,
        manager.storage.local_capacity, sequence);
    if (index == manager.storage.local_capacity) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_SEQUENCE;
        ret result;
    }
    val entry: *Entry = ?manager.storage.local[index];
    if (entry.state == ENTRY_RETIRED) {
        result.status = STATUS_DUPLICATE;
        result.handle = handle(manager, index, true);
        ret result;
    }
    if (entry.sequence == destination_sequence) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_RETIRE_CURRENT;
        ret result;
    }
    entry.state               = ENTRY_RETIRED;
    manager.local_active      = manager.local_active - 1;
    result.status             = STATUS_OK;
    result.handle             = handle(manager, index, true);
    result.replacement_needed = manager.local_active < manager.config.local_active_limit;
    ret result;
}

pub fun match_local(manager: *Manager, id: *packet.ConnectionId) Selected {
    var result: Selected;
    if (!physical(manager) || !manager.initialized || id == nil) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    var i: usize = 0;
    for (i < manager.storage.local_capacity) {
        if (manager.storage.local[i].state == ENTRY_ACTIVE &&
            packet.connection_id_equal(?manager.storage.local[i].id, id)) {
            result.status      = STATUS_OK;
            result.handle      = handle(manager, i, true);
            result.id          = manager.storage.local[i].id;
            result.reset_token = manager.storage.local[i].reset_token;
            ret result;
        }
        i = i + 1;
    }
    result.status = STATUS_STALE;
    result.error  = ERROR_TOKEN;
    ret result;
}

pub fun select(manager: *Manager, value: Handle) Result {
    ret select_scoped(manager, 0, value);
}

pub fun select_scoped(manager: *Manager, core_source: u64, value: Handle) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val entry: *Entry = slot_for(manager, value);
    if (entry == nil || entry.state != ENTRY_ACTIVE) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    val values: *Entry = entries(manager, value.local);
    val count:  usize  = capacity(manager, value.local);
    var i:      usize  = 0;
    for (i < count) {
        values[i].current = false;
        i                 = i + 1;
    }
    entry.current = true;
    result.status = STATUS_OK;
    result.handle = value;
    ret result;
}

pub fun current(manager: *Manager, local: bool) Selected {
    var result: Selected;
    if (!physical(manager) || !manager.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val values: *Entry = entries(manager, local);
    val count:  usize  = capacity(manager, local);
    var i:      usize  = 0;
    for (i < count) {
        if (values[i].state == ENTRY_ACTIVE && values[i].current) {
            result.status      = STATUS_OK;
            result.handle      = handle(manager, i, local);
            result.id          = values[i].id;
            result.reset_token = values[i].reset_token;
            ret result;
        }
        i = i + 1;
    }
    result.status = STATUS_ERROR;
    result.error  = ERROR_STATE;
    ret result;
}

# a peer that chose a zero-length id is addressed by its path alone, so it
# never issues or rotates to another id
pub fun local_zero_length(manager: *Manager) bool {
    ret physical(manager) && manager.initialized &&
        manager.storage.local[0].state == ENTRY_ACTIVE &&
        manager.storage.local[0].sequence == 0 &&
        manager.storage.local[0].id.len == 0;
}

pub fun peer_zero_length(manager: *Manager) bool {
    ret physical(manager) && manager.initialized &&
        manager.storage.peer[0].state == ENTRY_ACTIVE &&
        manager.storage.peer[0].sequence == 0 &&
        manager.storage.peer[0].id.len == 0;
}

pub fun rotate_peer(manager: *Manager) Result {
    ret rotate_peer_scoped(manager, 0);
}

pub fun peer_rotation_available(manager: *Manager) bool {
    if (!physical(manager) || !manager.initialized || manager.closing) {
        ret false;
    }
    var current:   bool  = false;
    var alternate: bool  = false;
    var i:         usize = 0;
    for (i < manager.storage.peer_capacity) {
        if (manager.storage.peer[i].state == ENTRY_ACTIVE) {
            if (manager.storage.peer[i].current) { current = true; }
            or                                   { alternate = true; }
        }
        i = i + 1;
    }
    ret current && alternate;
}

pub fun rotate_peer_scoped(manager: *Manager, core_source: u64) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    var current_index: usize = manager.storage.peer_capacity;
    var next_index:    usize = manager.storage.peer_capacity;
    var i:             usize = 0;
    for (i < manager.storage.peer_capacity) {
        if (manager.storage.peer[i].state == ENTRY_ACTIVE) {
            if (manager.storage.peer[i].current)             { current_index = i; }
            or (next_index == manager.storage.peer_capacity) { next_index = i; }
        }
        i = i + 1;
    }
    if (current_index == manager.storage.peer_capacity ||
        next_index == manager.storage.peer_capacity) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_LIMIT;
        ret result;
    }
    manager.storage.peer[current_index].current = false;
    manager.storage.peer[current_index].state   = ENTRY_RETIRE_QUEUED;
    manager.storage.peer[next_index].current    = true;
    manager.peer_active                         = manager.peer_active - 1;
    result.status                               = STATUS_OK;
    result.handle                               = handle(manager, next_index, false);
    ret result;
}

pub fun next_advertisement(manager: *Manager) Selected {
    var result: Selected;
    if (!physical(manager) || !manager.initialized || manager.closing) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    var i: usize = 0;
    for (i < manager.storage.local_capacity) {
        val entry: *Entry = ?manager.storage.local[i];
        if (entry.state == ENTRY_ACTIVE && !entry.advertised &&
            !entry.advertisement_inflight) {
            result.status      = STATUS_OK;
            result.handle      = handle(manager, i, true);
            result.id          = entry.id;
            result.reset_token = entry.reset_token;
            ret result;
        }
        i = i + 1;
    }
    result.status = STATUS_BLOCKED;
    ret result;
}

pub fun advertisement_sent(manager: *Manager, value: Handle) Result {
    ret advertisement_sent_scoped(manager, 0, value);
}

pub fun advertisement_sent_scoped(manager: *Manager, core_source: u64,
    value: Handle) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val entry: *Entry = slot_for(manager, value);
    if (entry == nil || !value.local || entry.state != ENTRY_ACTIVE ||
        entry.advertised || entry.advertisement_inflight) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    entry.advertisement_inflight = true;
    result.status                = STATUS_OK;
    result.handle                = value;
    ret result;
}

pub fun advertisement_terminal(manager: *Manager, value: Handle,
    acknowledged: bool) Result {
    ret advertisement_terminal_scoped(manager, 0, value, acknowledged);
}

pub fun advertisement_terminal_scoped(manager: *Manager, core_source: u64,
    value: Handle, acknowledged: bool) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val entry: *Entry = slot_for(manager, value);
    if (entry == nil || !value.local || entry.state != ENTRY_ACTIVE ||
        !entry.advertisement_inflight) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    entry.advertisement_inflight = false;
    if (acknowledged) { entry.advertised = true; }
    result.status = STATUS_OK;
    result.handle = value;
    ret result;
}

pub fun next_retirement(manager: *Manager) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    var i: usize = 0;
    for (i < manager.storage.peer_capacity) {
        if (manager.storage.peer[i].state == ENTRY_RETIRE_QUEUED) {
            result.status = STATUS_OK;
            result.handle = handle(manager, i, false);
            ret result;
        }
        i = i + 1;
    }
    result.status = STATUS_BLOCKED;
    ret result;
}

pub fun retirement_sent(manager: *Manager, value: Handle) Result {
    ret retirement_sent_scoped(manager, 0, value);
}

pub fun retirement_sent_scoped(manager: *Manager, core_source: u64,
    value: Handle) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val entry: *Entry = slot_for(manager, value);
    if (entry == nil || value.local || entry.state != ENTRY_RETIRE_QUEUED) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    entry.state   = ENTRY_RETIRE_SENT;
    result.status = STATUS_OK;
    result.handle = value;
    ret result;
}

pub fun retirement_terminal(manager: *Manager, value: Handle,
    acknowledged: bool) Result {
    ret retirement_terminal_scoped(manager, 0, value, acknowledged);
}

pub fun retirement_terminal_scoped(manager: *Manager, core_source: u64,
    value: Handle, acknowledged: bool) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val entry: *Entry = slot_for(manager, value);
    if (entry == nil || value.local || entry.state != ENTRY_RETIRE_SENT) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    entry.state = ENTRY_RETIRE_QUEUED;
    if (acknowledged) { entry.state = ENTRY_RETIRED; }
    result.status = STATUS_OK;
    result.handle = value;
    ret result;
}

pub fun begin_close(manager: *Manager) bool {
    ret begin_close_scoped(manager, 0);
}

pub fun begin_close_scoped(manager: *Manager, core_source: u64) bool {
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, core_source)) { ret false; }
    manager.closing = true;
    ret true;
}

pub fun finish_close(manager: *Manager) bool {
    ret finish_close_scoped(manager, 0);
}

pub fun finish_close_scoped(manager: *Manager, core_source: u64) bool {
    if (!physical(manager) || !manager.initialized || !manager.closing ||
        !scope_allowed(manager, core_source)) { ret false; }
    clear_entries(manager.storage.local, manager.storage.local_capacity);
    clear_entries(manager.storage.peer, manager.storage.peer_capacity);
    manager.local_active                       = 0;
    manager.peer_active                        = 0;
    manager.core_lease                         = 0;
    manager.initial_peer_reset_token_installed = false;
    manager.initialized                        = false;
    ret true;
}

pub fun snapshot(manager: *Manager) Snapshot {
    var result: Snapshot;
    if (!physical(manager) || !manager.initialized) { ret result; }
    result.local_active         = manager.local_active;
    result.peer_active          = manager.peer_active;
    result.peer_retire_prior_to = manager.peer_retire_prior_to;
    result.initialized          = manager.initialized;
    result.closing              = manager.closing;
    ret result;
}

fun make_id(value: u8) packet.ConnectionId {
    var id: packet.ConnectionId;
    id.len     = 4;
    id.data[0] = value;
    id.data[1] = value + 1;
    id.data[2] = value + 2;
    id.data[3] = value + 3;
    ret id;
}

fun make_token(value: u8) [16]u8 {
    var token: [16]u8;
    token[0]  = value;
    token[15] = value + 1;
    ret token;
}

test "quic.connection.cid: new ids retire transactionally and preserve a current destination" {
    var local:   [4]Entry;
    var peer:    [6]Entry;
    var manager: Manager;
    if (!initialize(?manager, Config{source: 201, local_active_limit: 3,
        peer_active_limit: 3}, Storage{local: ?local[0], local_capacity: 4,
        peer:              ?peer[0], peer_capacity: 6}, make_id(1), make_id(10))) { ret 1; }
    val one: Result = receive_new(?manager, 1, 0, make_id(20), make_token(20));
    if (one.status != STATUS_OK || select(?manager, one.handle).status != STATUS_OK) { ret 1; }
    val two: Result = receive_new(?manager, 2, 2, make_id(30), make_token(30));
    if (two.status != STATUS_OK || two.retired != 2 || snapshot(?manager).peer_active != 1 ||
        current(?manager, false).handle.sequence != 2) { ret 2; }
    if (next_retirement(?manager).status != STATUS_OK) { ret 3; }
    ret 0;
}

test "quic.connection.cid: malformed duplicates and active limits do not mutate state" {
    var local:   [3]Entry;
    var peer:    [4]Entry;
    var manager: Manager;
    if (!initialize(?manager, Config{source: 202, local_active_limit: 2,
        peer_active_limit: 2}, Storage{local: ?local[0], local_capacity: 3,
        peer:              ?peer[0], peer_capacity: 4}, make_id(1), make_id(10))) { ret 1; }
    val one:       Result = receive_new(?manager, 1, 0, make_id(20), make_token(20));
    val duplicate: Result = receive_new(?manager, 1, 0, make_id(21), make_token(20));
    val overflow:  Result = receive_new(?manager, 2, 0, make_id(30), make_token(30));
    if (one.status != STATUS_OK || duplicate.error != ERROR_SEQUENCE ||
        overflow.error != ERROR_LIMIT || snapshot(?manager).peer_active != 2 ||
        snapshot(?manager).peer_retire_prior_to != 0) { ret 1; }
    val exact: Result = receive_new(?manager, 1, 0, make_id(20), make_token(20));
    if (exact.status != STATUS_DUPLICATE) { ret 2; }
    ret 0;
}

test "quic.connection.cid: retirement follows the packet destination across active ids" {
    var local:   [3]Entry;
    var peer:    [4]Entry;
    var manager: Manager;
    if (!initialize(?manager, Config{source: 203, local_active_limit: 2,
        peer_active_limit: 2}, Storage{local: ?local[0], local_capacity: 3,
        peer:              ?peer[0], peer_capacity: 4}, make_id(1), make_id(10))) { ret 1; }
    if (receive_retire(?manager, 0).error != ERROR_RETIRE_CURRENT) { ret 1; }
    val issued:  Result   = issue_local(?manager, 1, make_id(40), make_token(40));
    val matched: Selected = match_local(?manager, ?local[issued.handle.index].id);
    if (issued.status != STATUS_OK || matched.status != STATUS_OK ||
        matched.handle.sequence != 1) { ret 2; }
    val retired: Result = receive_retire_in_packet_scoped(?manager, 0, 0, 1);
    if (retired.status != STATUS_OK || !retired.replacement_needed ||
        receive_retire_in_packet_scoped(?manager, 0, 1, 1).error !=
        ERROR_RETIRE_CURRENT) { ret 3; }
    if (!begin_close(?manager) || !finish_close(?manager) || snapshot(?manager).initialized) { ret 4; }
    ret 0;
}

test "quic.connection.cid: migration consumes one peer id and bounds local advertisements" {
    var local:   [3]Entry;
    var peer:    [6]Entry;
    var manager: Manager;
    if (!initialize(?manager, Config{source: 204, local_active_limit: 2,
        peer_active_limit: 3}, Storage{local: ?local[0], local_capacity: 3,
        peer:              ?peer[0], peer_capacity: 6}, make_id(1), make_id(10))) { ret 1; }
    if (update_local_limit(?manager, 8).status != STATUS_OK ||
        manager.config.local_active_limit != 3) { ret 1; }
    val added:   Result = receive_new(?manager, 1, 0, make_id(20), make_token(20));
    val rotated: Result = rotate_peer(?manager);
    if (added.status != STATUS_OK || rotated.status != STATUS_OK ||
        rotated.handle.sequence != 1 || snapshot(?manager).peer_active != 1 ||
        next_retirement(?manager).handle.sequence != 0 ||
        rotate_peer(?manager).status != STATUS_BLOCKED) { ret 2; }
    val retirement: Result = next_retirement(?manager);
    if (retirement_sent(?manager, retirement.handle).status != STATUS_OK ||
        retirement_terminal(?manager, retirement.handle, false).status != STATUS_OK ||
        next_retirement(?manager).status != STATUS_OK) { ret 3; }
    ret 0;
}

test "quic.connection.cid: initial reset token and bounded storage remain explicit" {
    var local:   [3]Entry;
    var peer:    [4]Entry;
    var manager: Manager;
    if (!initialize(?manager, Config{source: 205, local_active_limit: 2,
        peer_active_limit: 2}, Storage{local: ?local[0], local_capacity: 3,
        peer:              ?peer[0], peer_capacity: 4}, make_id(1), make_id(10))) { ret 1; }
    val initial_token: [16]u8 = make_token(10);
    if (install_initial_peer_reset_token(?manager, initial_token).status != STATUS_OK ||
        !manager.initial_peer_reset_token_installed ||
        !peer[0].reset_token_present ||
        install_initial_peer_reset_token(?manager, initial_token).status !=
        STATUS_DUPLICATE ||
        install_initial_peer_reset_token(?manager, make_token(11)).error !=
        ERROR_SEQUENCE) { ret 2; }
    if (receive_new(?manager, 1, 0, make_id(20), make_token(20)).status != STATUS_OK ||
        receive_new(?manager, 2, 1, make_id(30), make_token(30)).status != STATUS_OK ||
        receive_new(?manager, 3, 2, make_id(40), make_token(40)).status != STATUS_OK) {
        ret 3;
    }
    val prior:   u64    = manager.peer_retire_prior_to;
    val blocked: Result = receive_new(?manager, 4, 3, make_id(50), make_token(50));
    if (blocked.status != STATUS_BLOCKED || blocked.error != ERROR_CAPACITY ||
        manager.peer_retire_prior_to != prior || peer[2].state != ENTRY_ACTIVE) { ret 4; }
    if (!lease_core(?manager, 900) || begin_close(?manager) ||
        rotate_peer(?manager).error != ERROR_STATE ||
        !begin_close_scoped(?manager, 900) ||
        !finish_close_scoped(?manager, 900) || manager.core_lease != 0) {
        ret 5;
    }
    ret 0;
}

test "quic.connection.cid: hostile products and storage aliases are rejected atomically" {
    val maximum: usize = ~(0::usize);
    var local:   [3]Entry;
    var peer:    [4]Entry;
    local[0].state = ENTRY_RETIRED;
    peer[0].state  = ENTRY_RETIRE_SENT;
    var manager:        Manager;
    val local_overflow: usize = maximum / $size_of(Entry) + 1;
    if (initialize(?manager, Config{source: 206, local_active_limit: 2,
        peer_active_limit: 2}, Storage{local: (1::usize)::*Entry,
        local_capacity:    local_overflow, peer: ?peer[0], peer_capacity: 4},
        make_id(1), make_id(10)) ||
        initialize(?manager, Config{source: 206, local_active_limit: 2,
        peer_active_limit: 2}, Storage{local: maximum::*Entry,
        local_capacity:    3, peer: ?peer[0], peer_capacity: 4},
        make_id(1), make_id(10)) ||
        initialize(?manager, Config{source: 206, local_active_limit: 2,
        peer_active_limit: 2}, Storage{local: ?local[0], local_capacity: 3,
        peer:              (?local[0])::*Entry, peer_capacity: 4},
        make_id(1), make_id(10)) || manager.initialized ||
        local[0].state != ENTRY_RETIRED || peer[0].state != ENTRY_RETIRE_SENT) {
        ret 1;
    }
    ret 0;
}

test "quic.connection.cid: zero-length ids issue nothing and refuse the peer's" {
    var local_entries: [4]Entry;
    var peer_entries:  [4]Entry;
    var manager:       Manager;
    var empty:         packet.ConnectionId;
    var id:            packet.ConnectionId;
    var token:         [16]u8;
    empty.len  = 0;
    id.len     = 8;
    id.data[0] = 7;
    if (!initialize(?manager, Config{source: 5, local_active_limit: 2,
        peer_active_limit: 2}, Storage{local: ?local_entries[0], local_capacity: 4,
        peer:              ?peer_entries[0], peer_capacity: 4}, empty, empty)) { ret 1; }
    if (!local_zero_length(?manager) || !peer_zero_length(?manager) ||
        peer_rotation_available(?manager)) { ret 2; }
    val issued: Result = issue_local(?manager, 1, id, token);
    if (issued.status != STATUS_ERROR || issued.error != ERROR_ZERO_LENGTH) { ret 3; }
    token[0] = 1;
    val received: Result = receive_new(?manager, 1, 0, id, token);
    if (received.status != STATUS_ERROR || received.error != ERROR_ZERO_LENGTH ||
        manager.peer_active != 1) { ret 4; }
    ret 0;
}
