# the ed25519 test chain shared by every binding that needs a real mach-tls peer

use crypto.contracts;
use crypto.encoding.keys;
use crypto.secret;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use tls.cert;
use tls.cert.credentials;
use tls.cert.load;
use tls.clock;

pub val VERIFICATION_TIME: i64 = 1800000000;

var clock_moment: clock.Moment;
var clock_source: clock.Source;

# one clock every test engine reads, frozen inside the test chain's validity
pub fun test_clock() *clock.Source {
    if (clock_source.read_fn == nil) {
        clock_moment = clock.at(VERIFICATION_TIME, 1);
        clock_source = clock.frozen(?clock_moment);
    }
    ret ?clock_source;
}

pub val ROOT_LENGTH: usize = 341;
pub val LEAF_LENGTH: usize = 393;

var root_der: [341]u8;
var leaf_der: [393]u8;

#[oblivious]
pub fun deterministic_entropy(context: ptr, secret_context: *^u8,
    destination: *^u8, length: usize) i64 {
    val counter: *u8   = context::*u8;
    var i:       usize = 0;
    for (i < length) {
        destination[i] = counter[0] + i::u8 + 1;
        i              = i + 1;
    }
    counter[0] = counter[0] + 23;
    ret 0;
}

fun hex_nibble(value: u8, output: *u8) bool {
    if (value >= '0' && value <= '9') {
        output[0] = value - '0';
        ret true;
    }
    if (value >= 'a' && value <= 'f') {
        output[0] = value - 'a' + 10;
        ret true;
    }
    ret false;
}

fun decode_hex(input: *u8, length: usize, output: *u8, capacity: usize) bool {
    if (input == nil || output == nil || (length & 1) != 0 ||
        length / 2 > capacity) { ret false; }
    var i: usize = 0;
    for (i < length / 2) {
        var high: u8;
        var low:  u8;
        if (!hex_nibble(input[i * 2], ?high) ||
            !hex_nibble(input[i * 2 + 1], ?low)) { ret false; }
        output[i] = (high << 4) | low;
        i         = i + 1;
    }
    ret true;
}

# an ed25519 chain for api.example.com valid from 2026-08-28 to 2027-08-28
pub fun load_credentials(identity: *credentials.Identity,
    chain_storage: *cert.Certificate,
    key: *keys.PrivateKey, owner: *secret.Allocator) bool {
    val root_hex: *u8 = ""::*u8;
    val leaf_hex: *u8 = ""::*u8;
    if (!decode_hex(root_hex, 682, ?root_der[0], 341) ||
        !decode_hex(leaf_hex, 786, ?leaf_der[0], 393)) { ret false; }
    var key_der: [48]^u8 = [48]^u8{
        0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06,
        0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20,
        0xeb, 0x3b, 0x8b, 0xa3, 0x21, 0x67, 0x09, 0xef,
        0x29, 0x39, 0x0e, 0x9c, 0x43, 0x84, 0x01, 0xbe,
        0xca, 0x3f, 0xf8, 0x03, 0x7d, 0x60, 0xbb, 0x30,
        0x42, 0x18, 0xc8, 0x8c, 0xd4, 0xb7, 0x9b, 0x72,
    };
    @key = keys.empty_private();
    val loaded: contracts.Error = load.private_der(
        contracts.SecretBytes{data: ?key_der[0], len: 48}, cert.PKCS8_DER,
        owner, key);
    ct.zeroize(?key_der[0], 48);
    if (loaded != contracts.OK) { ret false; }
    chain_storage[0]     = cert.Certificate{der: ?leaf_der[0], der_len: 393};
    identity.server_name = contracts.Bytes{data: "api.example.com"::*u8, len: 15};
    identity.chain       = cert.Chain{certificates: chain_storage, len: 1};
    identity.private_key = key;
    ret true;
}

# the root the leaf chains to, for a client trust store
pub fun anchor() cert.Certificate {
    ret cert.Certificate{der: ?root_der[0], der_len: 341};
}
