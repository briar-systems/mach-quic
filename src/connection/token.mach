# authenticated address and retry tokens with owned replay protection
#
# consumed retry nonces are remembered until their token could no longer
# authenticate, in storage that grows with what is remembered

use quic.connection.ownership;
use quic.packet.packet;
use quic.storage.hash;
use quic.storage.heap;
use quic.storage.index;
use quic.storage.limited;
use quic.storage.slots;

use crypto.contracts;
use crypto.hmac;
use std.allocator;
use std.crypto.ct;
use std.encoding.binary;
use std.memory;
use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

pub val PURPOSE_RETRY:   u8 = 1;
pub val PURPOSE_ADDRESS: u8 = 2;

pub val TOKEN_SIZE: usize = 110;
pub val BODY_SIZE:  usize = 94;
pub val TAG_SIZE:   usize = 16;
pub val KEY_SIZE:   usize = 32;

pub def Status: u8;
pub val STATUS_OK:      Status = 1;
pub val STATUS_STALE:   Status = 2;
pub val STATUS_BLOCKED: Status = 3;
pub val STATUS_ERROR:   Status = 4;

pub def Error: u8;
pub val ERROR_NONE:     Error = 0;
pub val ERROR_STATE:    Error = 1;
pub val ERROR_CONFIG:   Error = 2;
pub val ERROR_BUFFER:   Error = 3;
pub val ERROR_FORMAT:   Error = 4;
pub val ERROR_KEY:      Error = 5;
pub val ERROR_AUTH:     Error = 6;
pub val ERROR_EXPIRED:  Error = 7;
pub val ERROR_ADDRESS:  Error = 8;
pub val ERROR_REPLAY:   Error = 9;
pub val ERROR_CAPACITY: Error = 10;
pub val ERROR_TOKEN:    Error = 11;
pub val ERROR_TIME:     Error = 12;
pub val ERROR_MEMORY:   Error = 13;
# the replay store is at its bound. the token is refused, never remembered
# over a live nonce, so replay protection holds under a flood
pub val ERROR_REPLAY_FULL: Error = 14;

pub def ReplayState: u8;
pub val REPLAY_FREE:     ReplayState = 0;
pub val REPLAY_RESERVED: ReplayState = 1;
pub val REPLAY_CONSUMED: ReplayState = 2;

# how many ranges `ranges` writes
pub val RANGE_COUNT: usize = 4;

# an entry leaves the expiry heap and the index once its token has expired,
# but a reservation's owner still holds it until commit or cancel
pub rec ReplaySlot {
    nonce:          u64;
    key_generation: u64;
    expires_at_ns:  u64;
    generation:     u64;
    hash:           u64;
    heap_position:  usize;
    state:          ReplayState;
}

rec ReplayKey {
    nonce:          u64;
    key_generation: u64;
}

# max_replay caps remembered nonces by count. it is required: a peer that can
# present many valid tokens must not be able to grow the store without limit
pub rec Config {
    source:             u64;
    retry_max_age_ns:   u64;
    address_max_age_ns: u64;
    max_replay:         usize;
}

pub rec Manager {
    config:              Config;
    backing:             *allocator.Allocator;
    replay:              slots.Slots[ReplaySlot];
    replay_index:        index.Index;
    expiry:              heap.Heap;
    hash_key:            hash.Key;
    current:             [32]^u8;
    previous:            [32]^u8;
    current_generation:  u64;
    previous_generation: u64;
    reserved:            usize;
    replay_full:         u64;
    generation:          u64;
    listener_lease:      u64;
    initialized:         bool;
    closing:             bool;
}

pub rec Snapshot {
    remembered:  usize;
    reserved:    usize;
    bytes:       usize;
    replay_full: u64;
    initialized: bool;
    closing:     bool;
}

pub rec Reservation {
    source:         u64;
    index:          usize;
    generation:     u64;
    nonce:          u64;
    key_generation: u64;
}

pub rec Claims {
    purpose:              u8;
    issued_at_ns:         u64;
    nonce:                u64;
    peer:                 ip.Endpoint;
    original_destination: packet.ConnectionId;
    retry_source:         packet.ConnectionId;
    reservation:          Reservation;
}

pub rec Result {
    status: Status;
    error:  Error;
    count:  usize;
    claims: Claims;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun valid_purpose(purpose: u8) bool {
    ret purpose == PURPOSE_RETRY || purpose == PURPOSE_ADDRESS;
}

fun copy_key(output: *^u8, input: contracts.SecretBytes) bool {
    if (output == nil || input.data == nil || input.len != KEY_SIZE) { ret false; }
    var i: usize = 0;
    for (i < KEY_SIZE) {
        output[i] = input.data[i];
        i         = i + 1;
    }
    ret true;
}

fun key_aliases_manager(manager: *Manager, key: contracts.SecretBytes) bool {
    if (manager == nil || key.data == nil || key.len != KEY_SIZE) { ret false; }
    ret !ownership.secret_disjoint(key.data, key.len,
        ?manager.current[0], KEY_SIZE) ||
        !ownership.secret_disjoint(key.data, key.len,
        ?manager.previous[0], KEY_SIZE);
}

fun manager_range(manager: *Manager) ownership.Range {
    ret ownership.anchored_record[Manager, Config](?manager.config,
        $offset_of(Manager, config));
}

# writes the manager and every directory it owns. directories move as they
# grow, so the ranges hold only until the next retry token is opened
pub fun ranges(manager: *Manager, output: *ownership.Range) {
    output[0] = manager_range(manager);
    output[1] = slots.range[ReplaySlot](?manager.replay);
    output[2] = index.range(?manager.replay_index);
    output[3] = heap.range(?manager.expiry);
}

fun physical(manager: *Manager) bool {
    if (manager == nil || !manager_range(manager).valid) { ret false; }
    if (!slots.sound[ReplaySlot](?manager.replay) ||
        !index.sound(?manager.replay_index) || !heap.sound(?manager.expiry) ||
        manager.replay_index.count > manager.replay.live ||
        manager.expiry.count != manager.replay_index.count ||
        manager.reserved > manager.replay.live) { ret false; }
    var owned: [4]ownership.Range;
    ranges(manager, ?owned[0]);
    ret ownership.all_disjoint(?owned[0], RANGE_COUNT);
}

fun config_valid(config: Config) bool {
    if (config.source == 0 || config.retry_max_age_ns == 0 ||
        config.address_max_age_ns == 0) { ret false; }
    if (config.max_replay == 0) { ret false; }
    ret true;
}

# replay storage draws on `backing` for the manager's whole life and is
# released to it by finish_close
pub fun initialize(manager: *Manager, config: Config,
    backing: *allocator.Allocator, generation: u64,
    key: contracts.SecretBytes) bool {
    if (!config_valid(config) || backing == nil || generation == 0 ||
        key.data == nil || key.len != KEY_SIZE) { ret false; }
    if (manager == nil) { ret false; }
    if (!manager_range(manager).valid || key_aliases_manager(manager, key) ||
        manager.initialized) {
        ret false;
    }
    val hash_key: opt[hash.Key] = hash.random_key();
    if (!sel hash_key.some) { ret false; }
    var next: Manager;
    if (!copy_key(?next.current[0], key)) { ret false; }
    next.config              = config;
    next.backing             = backing;
    next.replay              = slots.empty[ReplaySlot]();
    next.replay_index        = index.empty();
    next.expiry              = heap.empty();
    next.hash_key            = hash_key.some;
    next.current_generation  = generation;
    next.previous_generation = 0;
    next.reserved            = 0;
    next.generation          = manager.generation;
    next.listener_lease      = 0;
    next.closing             = false;
    next.initialized         = true;
    @manager                 = next;
    ret true;
}

fun scope_allowed(manager: *Manager, listener_source: u64) bool {
    if (listener_source == 0) { ret manager.listener_lease == 0; }
    ret manager.listener_lease == listener_source;
}

pub fun lease_listener(manager: *Manager, source: u64) bool {
    if (!physical(manager) || !manager.initialized || manager.closing ||
        source == 0 || manager.listener_lease != 0) { ret false; }
    manager.listener_lease = source;
    ret true;
}

pub fun release_listener(manager: *Manager, source: u64) bool {
    if (!physical(manager) || !manager.initialized || source == 0 ||
        manager.listener_lease != source) { ret false; }
    manager.listener_lease = 0;
    ret true;
}

pub fun rotate(manager: *Manager, generation: u64, key: contracts.SecretBytes) bool {
    ret rotate_scoped(manager, 0, generation, key);
}

pub fun rotate_scoped(manager: *Manager, listener_source: u64, generation: u64,
    key: contracts.SecretBytes) bool {
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, listener_source) ||
        generation == 0 || generation <= manager.current_generation ||
        key.data == nil || key.len != KEY_SIZE) { ret false; }
    if (key_aliases_manager(manager, key)) { ret false; }
    ct.zeroize(?manager.previous[0], KEY_SIZE);
    var i: usize = 0;
    for (i < KEY_SIZE) {
        manager.previous[i] = manager.current[i];
        manager.current[i]  = key.data[i];
        i                   = i + 1;
    }
    manager.previous_generation = manager.current_generation;
    manager.current_generation  = generation;
    ret true;
}

fun disjoint_from_owned(manager: *Manager, value: ownership.Range) bool {
    var owned: [4]ownership.Range;
    ranges(manager, ?owned[0]);
    ret ownership.disjoint_from(value, RANGE_COUNT, ?owned[0], 0,
        RANGE_COUNT).kind == ownership.OVERLAP_NONE;
}

fun write_endpoint(output: *u8, endpoint: ip.Endpoint) {
    output[29] = endpoint.addr.is_v6;
    binary.put_uint(?output[30], endpoint.scope::u64, 4, binary.BIG);
    binary.put_uint(?output[34], endpoint.port::u64, 2, binary.BIG);
    memory.raw_zero(?output[36], 16);
    if (endpoint.addr.is_v6 != 0) {
        memory.copy[u8](?output[36], ?endpoint.addr.v6.octets[0], 16);
    }
    or {
        memory.copy[u8](?output[36], ?endpoint.addr.v4.octets[0], 4);
    }
}

fun read_endpoint(input: *u8) ip.Endpoint {
    var endpoint: ip.Endpoint;
    endpoint.port  = binary.get_uint(?input[34], 2, binary.BIG)::u16;
    endpoint.scope = binary.get_uint(?input[30], 4, binary.BIG)::u32;
    if (input[29] != 0) {
        endpoint.addr.is_v6 = 1;
        memory.copy[u8](?endpoint.addr.v6.octets[0], ?input[36], 16);
    }
    or {
        memory.copy[u8](?endpoint.addr.v4.octets[0], ?input[36], 4);
    }
    ret endpoint;
}

fun endpoint_equal(left: ip.Endpoint, right: ip.Endpoint) bool {
    if (left.addr.is_v6 != right.addr.is_v6 || left.port != right.port ||
        left.scope != right.scope) { ret false; }
    var length:     usize = 4;
    var left_data:  *u8   = ?left.addr.v4.octets[0];
    var right_data: *u8   = ?right.addr.v4.octets[0];
    if (left.addr.is_v6 != 0) {
        length     = 16;
        left_data  = ?left.addr.v6.octets[0];
        right_data = ?right.addr.v6.octets[0];
    }
    var i: usize = 0;
    for (i < length) {
        if (left_data[i] != right_data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun mac(manager: *Manager, generation: u64, input: *u8, output: *u8) bool {
    var key: *^u8 = nil;
    if (generation == manager.current_generation)  { key = ?manager.current[0]; }
    if (generation == manager.previous_generation) { key = ?manager.previous[0]; }
    if (key == nil)                                { ret false; }
    val operation: contracts.Operation = hmac.sha256(
        contracts.SecretBytes{data: key, len: KEY_SIZE},
        contracts.Bytes{data: input, len: BODY_SIZE},
        contracts.Buffer{data: output, capacity: hmac.SHA256_TAG_SIZE});
    ret operation.error == contracts.OK && operation.written == hmac.SHA256_TAG_SIZE;
}

pub fun seal(manager: *Manager, purpose: u8, peer: ip.Endpoint,
    original_destination: packet.ConnectionId,
    retry_source: packet.ConnectionId, issued_at_ns: u64, nonce: u64,
    output: *u8, capacity: usize) Result {
    ret seal_scoped(manager, 0, purpose, peer, original_destination,
        retry_source, issued_at_ns, nonce, output, capacity);
}

pub fun seal_scoped(manager: *Manager, listener_source: u64, purpose: u8,
    peer: ip.Endpoint, original_destination: packet.ConnectionId,
    retry_source: packet.ConnectionId, issued_at_ns: u64, nonce: u64,
    output: *u8, capacity: usize) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, listener_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (!valid_purpose(purpose) ||
        original_destination.len::usize > packet.MAX_CONNECTION_ID ||
        retry_source.len::usize > packet.MAX_CONNECTION_ID ||
        (purpose == PURPOSE_RETRY &&
        (original_destination.len == 0 || retry_source.len == 0)) ||
        (purpose == PURPOSE_ADDRESS &&
        (original_destination.len != 0 || retry_source.len != 0)) ||
        issued_at_ns == 0 || nonce == 0) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_FORMAT;
        ret result;
    }
    val output_range: ownership.Range = ownership.bytes(output, capacity,
        ownership.ZERO_FORBIDDEN);
    if (capacity < TOKEN_SIZE || !disjoint_from_owned(manager, output_range)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_BUFFER;
        ret result;
    }
    output[0] = 'M';
    output[1] = 'Q';
    output[2] = 'T';
    output[3] = '1';
    output[4] = purpose;
    binary.put_uint(?output[5], manager.current_generation, 8, binary.BIG);
    binary.put_uint(?output[13], issued_at_ns, 8, binary.BIG);
    binary.put_uint(?output[21], nonce, 8, binary.BIG);
    write_endpoint(output, peer);
    output[52] = original_destination.len;
    memory.raw_zero(?output[53], packet.MAX_CONNECTION_ID);
    memory.copy[u8](?output[53], ?original_destination.data[0],
        original_destination.len::usize);
    output[73] = retry_source.len;
    memory.raw_zero(?output[74], packet.MAX_CONNECTION_ID);
    if (retry_source.len > 0) {
        memory.copy[u8](?output[74], ?retry_source.data[0], retry_source.len::usize);
    }
    var full_tag: [32]u8;
    if (!mac(manager, manager.current_generation, output, ?full_tag[0])) {
        memory.raw_zero(output, TOKEN_SIZE);
        result.status = STATUS_ERROR;
        result.error  = ERROR_KEY;
        ret result;
    }
    memory.copy[u8](?output[BODY_SIZE], ?full_tag[0], TAG_SIZE);
    memory.raw_zero(?full_tag[0], 32);
    result.status = STATUS_OK;
    result.count  = TOKEN_SIZE;
    ret result;
}

fun valid_tag(manager: *Manager, generation: u64, input: *u8) bool {
    var full_tag: [32]u8;
    if (!mac(manager, generation, input, ?full_tag[0])) { ret false; }
    var difference: u8    = 0;
    var i:          usize = 0;
    for (i < TAG_SIZE) {
        difference = difference | (full_tag[i] ^ input[BODY_SIZE + i]);
        i          = i + 1;
    }
    memory.raw_zero(?full_tag[0], 32);
    ret difference == 0;
}

fun replay_position(slot: *ReplaySlot) *usize {
    ret ?slot.heap_position;
}

fun replay_matches(slot: *ReplaySlot, key: *ReplayKey) bool {
    ret slot.nonce == key.nonce && slot.key_generation == key.key_generation;
}

fun replay_hash(manager: *Manager, key: *ReplayKey) u64 {
    ret hash.bytes(manager.hash_key, key::*u8, $size_of(ReplayKey));
}

fun free_replay(manager: *Manager, index_value: usize) {
    val slot: *ReplaySlot = ?manager.replay.items[index_value].value;
    if (slot.state == REPLAY_RESERVED) { manager.reserved = manager.reserved - 1; }
    slot.state = REPLAY_FREE;
    slots.release[ReplaySlot](?manager.replay, index_value);
}

# an expired token can no longer authenticate, so its nonce need not be
# remembered. a reservation keeps its slot until its owner finishes it
fun forget(manager: *Manager, index_value: usize) {
    val slot: *ReplaySlot = ?manager.replay.items[index_value].value;
    index.remove(?manager.replay_index, slot.hash, index_value);
    heap.remove[ReplaySlot](?manager.expiry, ?manager.replay, slot.heap_position,
        replay_position);
    if (slot.state != REPLAY_RESERVED) { free_replay(manager, index_value); }
}

fun expire(manager: *Manager, now_ns: u64) {
    for (manager.expiry.count > 0 && now_ns > manager.expiry.nodes[0].key) {
        forget(manager, manager.expiry.nodes[0].slot);
    }
}

fun reserve_replay(manager: *Manager, generation: u64, nonce: u64,
    expires_at_ns: u64, now_ns: u64) Result {
    var result: Result;
    expire(manager, now_ns);
    var key: ReplayKey;
    key.nonce          = nonce;
    key.key_generation = generation;
    val key_hash: u64 = replay_hash(manager, ?key);
    if (index.find[ReplaySlot, ReplayKey](?manager.replay_index, ?manager.replay,
        key_hash, ?key, replay_matches) != slots.NONE) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_REPLAY;
        ret result;
    }
    if (manager.replay.live >= manager.config.max_replay) {
        manager.replay_full = manager.replay_full + 1;
        result.status       = STATUS_BLOCKED;
        result.error        = ERROR_REPLAY_FULL;
        ret result;
    }
    if (!slots.reserve[ReplaySlot](?manager.replay, manager.backing, 1) ||
        !index.reserve(?manager.replay_index, manager.backing,
        manager.replay_index.count + 1) ||
        !heap.reserve(?manager.expiry, manager.backing, manager.expiry.count + 1)) {
        result.status = STATUS_BLOCKED;
        result.error  = ERROR_MEMORY;
        ret result;
    }
    val claimed: usize       = slots.claim[ReplaySlot](?manager.replay);
    val slot:    *ReplaySlot = ?manager.replay.items[claimed].value;
    manager.generation  = next_generation(manager.generation);
    slot.nonce          = nonce;
    slot.key_generation = generation;
    slot.expires_at_ns  = expires_at_ns;
    slot.generation     = manager.generation;
    slot.hash           = key_hash;
    slot.state          = REPLAY_RESERVED;
    manager.reserved    = manager.reserved + 1;
    index.insert(?manager.replay_index, key_hash, claimed);
    heap.push[ReplaySlot](?manager.expiry, ?manager.replay, expires_at_ns, claimed,
        replay_position);
    result.status             = STATUS_OK;
    result.claims.reservation = Reservation{source: manager.config.source,
        index:          claimed, generation: slot.generation, nonce: nonce,
        key_generation: generation};
    ret result;
}

pub fun open(manager: *Manager, input: *u8, length: usize,
    expected_peer: ip.Endpoint, now_ns: u64) Result {
    ret open_scoped(manager, 0, input, length, expected_peer, now_ns);
}

pub fun open_scoped(manager: *Manager, listener_source: u64, input: *u8,
    length: usize, expected_peer: ip.Endpoint, now_ns: u64) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, listener_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val input_range: ownership.Range = ownership.bytes(input, length,
        ownership.ZERO_FORBIDDEN);
    if (!disjoint_from_owned(manager, input_range) || length != TOKEN_SIZE ||
        input[0] != 'M' || input[1] != 'Q' ||
        input[2] != 'T' || input[3] != '1' || !valid_purpose(input[4]) || input[29] > 1 ||
        input[52]::usize > packet.MAX_CONNECTION_ID ||
        input[73]::usize > packet.MAX_CONNECTION_ID ||
        (input[4] == PURPOSE_RETRY && (input[52] == 0 || input[73] == 0)) ||
        (input[4] == PURPOSE_ADDRESS && (input[52] != 0 || input[73] != 0))) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_FORMAT;
        ret result;
    }
    val cid_length: usize = input[52]::usize;
    var i:          usize = cid_length;
    for (i < packet.MAX_CONNECTION_ID) {
        if (input[53 + i] != 0) {
            result.status = STATUS_ERROR;
            result.error  = ERROR_FORMAT;
            ret result;
        }
        i = i + 1;
    }
    val retry_length: usize = input[73]::usize;
    i = retry_length;
    for (i < packet.MAX_CONNECTION_ID) {
        if (input[74 + i] != 0) {
            result.status = STATUS_ERROR;
            result.error  = ERROR_FORMAT;
            ret result;
        }
        i = i + 1;
    }
    if (input[29] == 0) {
        i = 4;
        for (i < 16) {
            if (input[36 + i] != 0) {
                result.status = STATUS_ERROR;
                result.error  = ERROR_FORMAT;
                ret result;
            }
            i = i + 1;
        }
    }
    val key_generation: u64 = binary.get_uint(?input[5], 8, binary.BIG);
    if ((key_generation != manager.current_generation &&
        key_generation != manager.previous_generation) || !valid_tag(manager,
        key_generation, input)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_AUTH;
        ret result;
    }
    val issued_at_ns: u64 = binary.get_uint(?input[13], 8, binary.BIG);
    var max_age_ns:   u64 = manager.config.address_max_age_ns;
    if (input[4] == PURPOSE_RETRY) { max_age_ns = manager.config.retry_max_age_ns; }
    if (issued_at_ns == 0 || now_ns < issued_at_ns ||
        now_ns - issued_at_ns > max_age_ns ||
        issued_at_ns > (0 - 1::u64) - max_age_ns) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_EXPIRED;
        ret result;
    }
    val encoded_peer: ip.Endpoint = read_endpoint(input);
    if (!endpoint_equal(encoded_peer, expected_peer)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_ADDRESS;
        ret result;
    }
    result.status              = STATUS_OK;
    result.claims.purpose      = input[4];
    result.claims.issued_at_ns = issued_at_ns;
    result.claims.nonce        = binary.get_uint(?input[21], 8, binary.BIG);
    result.claims.peer         = encoded_peer;
    packet.set_connection_id(?result.claims.original_destination,
        ?input[53], cid_length);
    packet.set_connection_id(?result.claims.retry_source,
        ?input[74], retry_length);
    if (input[4] == PURPOSE_RETRY) {
        var replay: Result = reserve_replay(manager, key_generation,
            result.claims.nonce, issued_at_ns + max_age_ns, now_ns);
        if (replay.status != STATUS_OK) {
            replay.claims.purpose = PURPOSE_RETRY;
            ret replay;
        }
        result.claims.reservation = replay.claims.reservation;
    }
    ret result;
}

fun replay_slot(manager: *Manager, reservation: Reservation) *ReplaySlot {
    if (!physical(manager) || !manager.initialized ||
        reservation.source != manager.config.source) { ret nil; }
    val slot: *ReplaySlot = slots.at[ReplaySlot](?manager.replay, reservation.index);
    if (slot == nil || slot.state == REPLAY_FREE || slot.generation != reservation.generation ||
        slot.nonce != reservation.nonce ||
        slot.key_generation != reservation.key_generation) { ret nil; }
    ret slot;
}

pub fun commit(manager: *Manager, reservation: Reservation) Result {
    ret commit_scoped(manager, 0, reservation);
}

pub fun commit_scoped(manager: *Manager, listener_source: u64,
    reservation: Reservation) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized || manager.closing ||
        !scope_allowed(manager, listener_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val slot: *ReplaySlot = replay_slot(manager, reservation);
    if (slot == nil || slot.state != REPLAY_RESERVED) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    manager.reserved = manager.reserved - 1;
    slot.state       = REPLAY_CONSUMED;
    # expired while reserved: the token cannot authenticate again, so nothing
    # is left to remember
    if (slot.heap_position == slots.NONE) { free_replay(manager, reservation.index); }
    result.status = STATUS_OK;
    ret result;
}

pub fun cancel(manager: *Manager, reservation: Reservation) Result {
    ret cancel_scoped(manager, 0, reservation);
}

pub fun cancel_scoped(manager: *Manager, listener_source: u64,
    reservation: Reservation) Result {
    var result: Result;
    if (!physical(manager) || !manager.initialized ||
        !scope_allowed(manager, listener_source)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    val slot: *ReplaySlot = replay_slot(manager, reservation);
    if (slot == nil || slot.state != REPLAY_RESERVED) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    if (slot.heap_position != slots.NONE) { forget(manager, reservation.index); }
    free_replay(manager, reservation.index);
    result.status = STATUS_OK;
    ret result;
}

pub fun begin_close(manager: *Manager) bool {
    if (!physical(manager) || !manager.initialized || manager.closing ||
        manager.listener_lease != 0) { ret false; }
    manager.closing = true;
    ret true;
}

pub fun finish_close(manager: *Manager) bool {
    if (!physical(manager) || !manager.initialized || !manager.closing ||
        manager.listener_lease != 0) { ret false; }
    if (manager.reserved != 0) { ret false; }
    ct.zeroize(?manager.current[0], KEY_SIZE);
    ct.zeroize(?manager.previous[0], KEY_SIZE);
    # a refused release keeps the manager closing with what it still holds
    val replay:       bool = slots.destroy[ReplaySlot](?manager.replay, manager.backing);
    val replay_index: bool = index.destroy(?manager.replay_index, manager.backing);
    val expiry:       bool = heap.destroy(?manager.expiry, manager.backing);
    if (!replay || !replay_index || !expiry) { ret false; }
    manager.initialized = false;
    ret true;
}

pub fun snapshot(manager: *Manager) Snapshot {
    var value: Snapshot;
    if (!physical(manager) || !manager.initialized) { ret value; }
    value.remembered  = manager.replay.live;
    value.reserved    = manager.reserved;
    value.replay_full = manager.replay_full;
    value.bytes       = slots.bytes[ReplaySlot](?manager.replay) +
        index.bytes(?manager.replay_index) + heap.bytes(?manager.expiry);
    value.initialized = manager.initialized;
    value.closing     = manager.closing;
    ret value;
}

#[oblivious]
fun test_key(value: u8) [32]^u8 {
    var key: [32]^u8;
    var i:   usize = 0;
    for (i < 32) {
        key[i] = value + i::u8;
        i      = i + 1;
    }
    ret key;
}

fun test_id(value: u8) packet.ConnectionId {
    var id: packet.ConnectionId;
    id.len = 8;
    var i: usize = 0;
    for (i < 8) {
        id.data[i] = value + i::u8;
        i          = i + 1;
    }
    ret id;
}

fun test_config(source: u64, max_replay: usize) Config {
    var config: Config;
    config.source             = source;
    config.retry_max_age_ns   = 100;
    config.address_max_age_ns = 1000;
    config.max_replay         = 1 << 20;
    if (max_replay != 0) { config.max_replay = max_replay; }
    ret config;
}

fun test_retry(manager: *Manager, output: *u8, issued_at_ns: u64, nonce: u64) bool {
    ret seal(manager, PURPOSE_RETRY, ip.endpoint(192, 0, 2, 44, 4433), test_id(9),
        test_id(19), issued_at_ns, nonce, output, TOKEN_SIZE).status == STATUS_OK;
}

fun test_open(manager: *Manager, input: *u8, now_ns: u64) Result {
    ret open(manager, input, TOKEN_SIZE, ip.endpoint(192, 0, 2, 44, 4433), now_ns);
}

test "quic.connection.token: retry tokens bind address and are single use" {
    var memory_state: limited.Limited;
    if (!limited.make(?memory_state, 1 << 20)) { ret 1; }
    var key:     [32]^u8 = test_key(1);
    var manager: Manager;
    if (!initialize(?manager, test_config(301, 0), limited.allocator_of(?memory_state),
        1, contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    val peer:    ip.Endpoint = ip.endpoint(192, 0, 2, 10, 4433);
    var encoded: [TOKEN_SIZE]u8;
    val sealed:  Result      = seal(?manager, PURPOSE_RETRY, peer, test_id(9),
        test_id(19), 10, 77, ?encoded[0], TOKEN_SIZE);
    val opened: Result = open(?manager, ?encoded[0], TOKEN_SIZE, peer, 50);
    if (sealed.status != STATUS_OK || opened.status != STATUS_OK ||
        opened.claims.original_destination.data[0] != 9 ||
        commit(?manager, opened.claims.reservation).status != STATUS_OK ||
        open(?manager, ?encoded[0], TOKEN_SIZE, peer, 51).error != ERROR_REPLAY) { ret 1; }
    if (open(?manager, ?encoded[0], TOKEN_SIZE,
        ip.endpoint(192, 0, 2, 10, 4434), 52).error != ERROR_ADDRESS) { ret 2; }
    encoded[60] = encoded[60] ^ 1;
    if (open(?manager, ?encoded[0], TOKEN_SIZE, peer, 53).error != ERROR_AUTH) { ret 3; }
    if (!begin_close(?manager) || !finish_close(?manager) ||
        !limited.clean(?memory_state)) { ret 4; }
    ct.zeroize(?key[0], 32);
    limited.dnit(?memory_state);
    ret 0;
}

test "quic.connection.token: reservation cancellation, expiry, and key rotation are bounded" {
    var memory_state: limited.Limited;
    if (!limited.make(?memory_state, 1 << 20)) { ret 1; }
    var key_one: [32]^u8 = test_key(2);
    var key_two: [32]^u8 = test_key(3);
    var manager: Manager;
    if (!initialize(?manager, test_config(302, 0), limited.allocator_of(?memory_state),
        4, contracts.SecretBytes{data: ?key_one[0], len: 32})) { ret 1; }
    val peer:   ip.Endpoint = ip.endpoint(203, 0, 113, 2, 8443);
    var first:  [TOKEN_SIZE]u8;
    var second: [TOKEN_SIZE]u8;
    if (seal(?manager, PURPOSE_RETRY, peer, test_id(1), test_id(11), 10, 1,
        ?first[0], TOKEN_SIZE).status != STATUS_OK) { ret 1; }
    val held: Result = open(?manager, ?first[0], TOKEN_SIZE, peer, 20);
    if (held.status != STATUS_OK || cancel(?manager,
        held.claims.reservation).status != STATUS_OK) { ret 2; }
    if (!rotate(?manager, 5, contracts.SecretBytes{data: ?key_two[0], len: 32}) ||
        open(?manager, ?first[0], TOKEN_SIZE, peer, 21).status != STATUS_OK) { ret 3; }
    val old: Result = open(?manager, ?first[0], TOKEN_SIZE, peer, 21);
    if (old.error != ERROR_REPLAY) { ret 4; }
    var no_destination:  packet.ConnectionId;
    var no_retry_source: packet.ConnectionId;
    if (seal(?manager, PURPOSE_ADDRESS, peer, no_destination, no_retry_source, 30, 2,
        ?second[0], TOKEN_SIZE).status != STATUS_OK ||
        open(?manager, ?second[0], TOKEN_SIZE, peer, 1001).status != STATUS_OK ||
        open(?manager, ?second[0], TOKEN_SIZE, peer, 1031).error != ERROR_EXPIRED) { ret 5; }
    ct.zeroize(?key_one[0], 32);
    ct.zeroize(?key_two[0], 32);
    ret 0;
}

test "quic.connection.token: invalid configuration and aliases never publish key state" {
    var memory_state: limited.Limited;
    if (!limited.make(?memory_state, 1 << 20)) { ret 1; }
    val backing:     *allocator.Allocator  = limited.allocator_of(?memory_state);
    var key:         [32]^u8               = test_key(7);
    var manager:     Manager;
    val secret:      contracts.SecretBytes = contracts.SecretBytes{data: ?key[0], len: 32};
    var zero_replay: Config                = test_config(303, 0);
    zero_replay.max_replay = 0;
    if (initialize(?manager, zero_replay, backing, 1, secret) ||
        initialize(?manager, test_config(0, 0), backing, 1, secret) ||
        initialize(?manager, test_config(303, 0), nil, 1, secret) ||
        initialize(?manager, test_config(303, 0), backing, 0, secret) ||
        initialize(?manager, test_config(303, 0), backing, 1,
        contracts.SecretBytes{data: ?manager.current[0], len: 32}) ||
        manager.initialized) { ret 1; }
    if (!initialize(?manager, test_config(303, 0), backing, 1, secret)) { ret 2; }
    if (initialize(?manager, test_config(304, 0), backing, 2, secret) ||
        manager.current_generation != 1 || manager.config.source != 303) { ret 3; }
    ct.zeroize(?key[0], 32);
    ret 0;
}

test "quic.connection.token: replay storage grows and lookups survive rehash" {
    var memory_state: limited.Limited;
    if (!limited.make(?memory_state, 1 << 24)) { ret 1; }
    var key:     [32]^u8 = test_key(8);
    var manager: Manager;
    if (!initialize(?manager, test_config(305, 0), limited.allocator_of(?memory_state),
        1, contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var encoded: [TOKEN_SIZE]u8;
    var nonce:   u64 = 1;
    for (nonce <= 300) {
        if (!test_retry(?manager, ?encoded[0], 10, nonce)) { ret 2; }
        val opened: Result = test_open(?manager, ?encoded[0], 20);
        if (opened.status != STATUS_OK) { ret 3; }
        # alternate owners finish by commit and by cancel, then re-reserve
        if (nonce % 2 == 0 &&
            commit(?manager, opened.claims.reservation).status != STATUS_OK) { ret 4; }
        if (nonce % 2 == 1) {
            if (cancel(?manager, opened.claims.reservation).status != STATUS_OK) { ret 5; }
            val again: Result = test_open(?manager, ?encoded[0], 20);
            if (again.status != STATUS_OK ||
                commit(?manager, again.claims.reservation).status != STATUS_OK) { ret 6; }
        }
        nonce = nonce + 1;
    }
    val loaded: Snapshot = snapshot(?manager);
    if (loaded.remembered != 300 || loaded.reserved != 0 ||
        manager.replay.capacity < 300 || manager.replay_index.capacity < 600 ||
        manager.expiry.capacity < 300) { ret 7; }
    nonce = 1;
    for (nonce <= 300) {
        if (!test_retry(?manager, ?encoded[0], 10, nonce) ||
            test_open(?manager, ?encoded[0], 30).error != ERROR_REPLAY) { ret 8; }
        nonce = nonce + 1;
    }
    if (snapshot(?manager).remembered != 300) { ret 9; }
    if (!begin_close(?manager) || !finish_close(?manager) ||
        !limited.clean(?memory_state)) { ret 10; }
    ct.zeroize(?key[0], 32);
    limited.dnit(?memory_state);
    ret 0;
}

test "quic.connection.token: expired nonces are forgotten and the replay limit is a count" {
    var memory_state: limited.Limited;
    if (!limited.make(?memory_state, 1 << 20)) { ret 1; }
    var key:     [32]^u8 = test_key(9);
    var manager: Manager;
    if (!initialize(?manager, test_config(306, 3), limited.allocator_of(?memory_state),
        1, contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var encoded: [TOKEN_SIZE]u8;
    var nonce:   u64 = 1;
    for (nonce <= 3) {
        if (!test_retry(?manager, ?encoded[0], 10 * nonce, nonce)) { ret 2; }
        val opened: Result = test_open(?manager, ?encoded[0], 40);
        if (opened.status != STATUS_OK ||
            commit(?manager, opened.claims.reservation).status != STATUS_OK) { ret 3; }
        nonce = nonce + 1;
    }
    # the directory has spare slots, so only the count refuses
    if (!test_retry(?manager, ?encoded[0], 40, 4)) { ret 4; }
    val refused: Result = test_open(?manager, ?encoded[0], 41);
    if (manager.replay.capacity <= 3 || refused.status != STATUS_BLOCKED ||
        refused.error != ERROR_REPLAY_FULL || refused.claims.purpose != PURPOSE_RETRY ||
        snapshot(?manager).replay_full != 1) { ret 5; }
    # nonce 1 expires after 110 and nonce 2 after 120
    val admitted: Result = test_open(?manager, ?encoded[0], 115);
    if (admitted.status != STATUS_OK || snapshot(?manager).remembered != 3) { ret 6; }
    if (!test_retry(?manager, ?encoded[0], 10, 1) ||
        test_open(?manager, ?encoded[0], 115).error != ERROR_EXPIRED) { ret 7; }
    if (cancel(?manager, admitted.claims.reservation).status != STATUS_OK ||
        !test_retry(?manager, ?encoded[0], 125, 5)) { ret 8; }
    val late: Result = test_open(?manager, ?encoded[0], 135);
    if (late.status != STATUS_OK || snapshot(?manager).remembered != 1 ||
        manager.expiry.count != 1) { ret 9; }
    ct.zeroize(?key[0], 32);
    ret 0;
}

test "quic.connection.token: a reservation that expires before its owner finishes is still owned" {
    var memory_state: limited.Limited;
    if (!limited.make(?memory_state, 1 << 20)) { ret 1; }
    var key:     [32]^u8 = test_key(10);
    var manager: Manager;
    if (!initialize(?manager, test_config(307, 0), limited.allocator_of(?memory_state),
        1, contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var encoded: [TOKEN_SIZE]u8;
    if (!test_retry(?manager, ?encoded[0], 10, 1)) { ret 2; }
    val committed: Result = test_open(?manager, ?encoded[0], 20);
    if (!test_retry(?manager, ?encoded[0], 10, 2)) { ret 2; }
    val cancelled: Result = test_open(?manager, ?encoded[0], 20);
    if (committed.status != STATUS_OK || cancelled.status != STATUS_OK) { ret 3; }
    # a later open sweeps both expired reservations out of replay tracking
    if (!test_retry(?manager, ?encoded[0], 150, 3)) { ret 4; }
    val later: Result = test_open(?manager, ?encoded[0], 160);
    if (later.status != STATUS_OK || manager.replay_index.count != 1 ||
        snapshot(?manager).reserved != 3) { ret 5; }
    if (commit(?manager, committed.claims.reservation).status != STATUS_OK ||
        cancel(?manager, cancelled.claims.reservation).status != STATUS_OK ||
        commit(?manager, committed.claims.reservation).status != STATUS_STALE ||
        cancel(?manager, cancelled.claims.reservation).status != STATUS_STALE) { ret 6; }
    if (snapshot(?manager).remembered != 1 || snapshot(?manager).reserved != 1 ||
        cancel(?manager, later.claims.reservation).status != STATUS_OK ||
        !begin_close(?manager) || !finish_close(?manager) ||
        !limited.clean(?memory_state)) { ret 7; }
    ct.zeroize(?key[0], 32);
    limited.dnit(?memory_state);
    ret 0;
}

test "quic.connection.token: a refused growth refuses one token and remembers nothing" {
    var memory_state: limited.Limited;
    if (!limited.make(?memory_state, 1 << 20)) { ret 1; }
    var key:     [32]^u8 = test_key(11);
    var manager: Manager;
    if (!initialize(?manager, test_config(308, 0), limited.allocator_of(?memory_state),
        1, contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var encoded: [TOKEN_SIZE]u8;
    var nonce:   u64 = 1;
    for (nonce <= 8) {
        if (!test_retry(?manager, ?encoded[0], 10, nonce)) { ret 2; }
        val opened: Result = test_open(?manager, ?encoded[0], 20);
        if (opened.status != STATUS_OK ||
            commit(?manager, opened.claims.reservation).status != STATUS_OK) { ret 2; }
        nonce = nonce + 1;
    }
    memory_state.budget = memory_state.live_bytes;
    val before: Snapshot = snapshot(?manager);
    if (!test_retry(?manager, ?encoded[0], 10, 9)) { ret 3; }
    val refused: Result   = test_open(?manager, ?encoded[0], 20);
    val after:   Snapshot = snapshot(?manager);
    if (refused.status != STATUS_BLOCKED || refused.error != ERROR_MEMORY ||
        after.remembered != before.remembered || after.reserved != before.reserved ||
        manager.replay_index.count != 8 || manager.expiry.count != 8) { ret 4; }
    # the refused nonce was never remembered, so the same token opens once there is room
    memory_state.budget = 1 << 20;
    val retried: Result = test_open(?manager, ?encoded[0], 21);
    if (retried.status != STATUS_OK ||
        commit(?manager, retried.claims.reservation).status != STATUS_OK ||
        test_open(?manager, ?encoded[0], 22).error != ERROR_REPLAY) { ret 5; }
    memory_state.refuse_release = true;
    if (!begin_close(?manager) || finish_close(?manager) || !manager.initialized ||
        manager.replay.items == nil) { ret 6; }
    memory_state.refuse_release = false;
    if (!finish_close(?manager) || manager.initialized ||
        !limited.clean(?memory_state)) { ret 7; }
    ct.zeroize(?key[0], 32);
    limited.dnit(?memory_state);
    ret 0;
}
