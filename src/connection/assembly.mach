# assembles a connection core and every manager it owns from one configuration
#
# the core validates twelve exact equalities between its encoded local transport
# parameters and the manager configurations those parameters describe. deriving
# both from a single record is the only way that agreement is structural rather
# than something each consumer rediscovers.

use ack_api: quic.recovery.ack;
use cid_api: quic.connection.cid;
use core_api: quic.connection.core;
use datagram_api: quic.stream.datagram;
use handshake_api: quic.connection.handshake;
use quic.connection.negotiation;
use quic.frame.frame;
use quic.packet.packet;
use quic.recovery.recovery;
use quic.transport_parameters;
use path_api: quic.path.path;
use stream_api: quic.stream.stream;
use tls_client_api: quic.connection.tls_client;
use tls_server_api: quic.connection.tls_server;
use transport_api: quic.transport;
use binding_api: quic.transport.binding;

use tls.client;
use tls.server;

use std.encoding.binary;
use std.net.ip;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

# the capacities the assembly commits to. they are fixed because the record
# embeds its own storage: that is what lets a consumer declare one Connection
# and import nothing from packet, crypto, recovery, congestion, path or stream
pub val MAX_UDP_PAYLOAD: usize = 1500;
pub val CRYPTO_LENGTH: usize = 16384;
pub val CRYPTO_STRIDE: usize = 4096;
pub val H3_CRITICAL_STREAMS_PER_PEER: usize = 3;
pub val H3_REQUEST_STREAMS: usize = 8;
pub val STREAM_CAPACITY: usize = 16;
pub val STREAM_STRIDE: usize = 4096;
pub val STREAM_WINDOW: usize = STREAM_CAPACITY * STREAM_STRIDE;
pub val STREAM_ATTEMPT_CAPACITY: usize = STREAM_CAPACITY * 2;
pub val DATAGRAM_CAPACITY: usize = 4;
pub val DATAGRAM_STRIDE: usize = 1200;
pub val CONNECTION_ID_CAPACITY: usize = 4;
pub val OWNER_CAPACITY: usize = 16;
pub val TOKEN_CAPACITY: usize = 512;
pub val PARAMETER_CAPACITY: usize = 512;
pub val SEND_CAPACITY: usize = 4;

pub def Stage: u8;
pub val STAGE_OK: Stage = 0;
pub val STAGE_CONFIG: Stage = 1;
pub val STAGE_STREAMS: Stage = 2;
pub val STAGE_CONNECTION_IDS: Stage = 3;
pub val STAGE_PATHS: Stage = 4;
pub val STAGE_DATAGRAMS: Stage = 5;
pub val STAGE_HANDSHAKE: Stage = 6;
pub val STAGE_PARAMETERS: Stage = 7;
pub val STAGE_CORE: Stage = 8;
pub val STAGE_BINDING: Stage = 9;
pub val STAGE_DRIVER: Stage = 10;

# `core` carries the reason code the core itself reported, so a refusal at
# STAGE_CORE names which ownership or precondition check rejected
pub rec InitResult {
    ok: bool;
    stage: Stage;
    core: core_api.InitResult;
}

pub rec RoutingId {
    data: [20]u8;
    length: usize;
}

pub rec Route {
    source: u64;
    index: usize;
    generation: u64;
    sequence: u64;
    id: RoutingId;
    active: bool;
}

pub rec RoutingSnapshot {
    source: u64;
    capacity: usize;
    active: usize;
    initialized: bool;
}

pub rec Config {
    source: u64;
    version: u32;
    local: ip.Endpoint;
    peer: ip.Endpoint;
    local_source: *u8;
    local_source_length: usize;
    peer_destination: *u8;
    peer_destination_length: usize;
    original_destination: *u8;
    original_destination_length: usize;
    alpn: *u8;
    alpn_length: usize;
    server_name: *u8;
    server_name_length: usize;
    max_udp_payload: usize;
    max_idle_timeout_ms: u64;
    drain_timeout_ns: u64;
    peer_bidirectional_streams: u64;
    peer_unidirectional_streams: u64;
    receive_max_data: u64;
    receive_stream_data: u64;
    active_connection_id_limit: u64;
    max_datagram_frame_size: usize;
    verification_time_unix: i64;
    tls_deadline_ns: u64;
    entropy_context_size: usize;
    entropy_secret_context_size: usize;
    peer_validated: bool;
    enable_early_data: bool;
}

pub fun default_config(source: u64, local: ip.Endpoint,
                       peer: ip.Endpoint) Config {
    var value: Config;
    value.source = source;
    value.version = packet.VERSION_1;
    value.local = local;
    value.peer = peer;
    value.max_udp_payload = 1200;
    value.max_idle_timeout_ms = 30000;
    value.drain_timeout_ns = 3000000000;
    value.peer_bidirectional_streams = H3_REQUEST_STREAMS::u64;
    value.peer_unidirectional_streams = H3_CRITICAL_STREAMS_PER_PEER::u64;
    value.receive_max_data = STREAM_WINDOW::u64;
    value.receive_stream_data = STREAM_STRIDE::u64;
    value.active_connection_id_limit = 2;
    value.max_datagram_frame_size = 0;
    value.entropy_context_size = 1;
    value.entropy_secret_context_size = 0;
    ret value;
}

pub rec Connection {
    core: core_api.Core;
    secrets: core_api.Secrets;
    handshake: handshake_api.Adapter;
    cids: cid_api.Manager;
    paths: path_api.Manager;
    streams: stream_api.Manager;
    datagrams: datagram_api.Queue;
    binding: binding_api.Binding;
    driver: transport_api.Driver[binding_api.Binding];
    sends: [4]transport_api.SendSlot;

    supported_versions: [2]u32;
    local_parameters: [512]u8;
    local_parameter_length: usize;

    receive_header: [1500]u8;
    receive_decoded: [1500]u8;
    send_plaintext: [1500]u8;
    close_reason: [256]u8;
    frame_ack_ranges: [32]frame.AckRange;
    recovery_events: [32]recovery.Event;
    recovery_initial: [32]recovery.SentPacket;
    recovery_handshake: [32]recovery.SentPacket;
    recovery_application: [32]recovery.SentPacket;
    ack_initial: [32]ack_api.Range;
    ack_handshake: [32]ack_api.Range;
    ack_application: [32]ack_api.Range;
    owners: [16]core_api.Owner;
    peer_extensions: [16]transport_parameters.Parameter;
    peer_extension_bytes: [512]u8;
    local_extensions: [16]transport_parameters.Parameter;
    local_extension_bytes: [512]u8;
    received_token: [512]u8;
    send_token: [512]u8;
    retry_token: [512]u8;
    retry_pseudo: [1024]u8;

    secret_receive: [1500]^u8;
    secret_send: [1500]^u8;

    crypto_receive: [16384]u8;
    crypto_receive_present: [16384]bool;
    crypto_send: [16384]u8;
    crypto_send_pending: [16384]bool;
    crypto_send_acked: [16384]bool;
    crypto_send_inflight: [16384]u16;
    crypto_attempts: [8]handshake_api.Attempt;

    local_cids: [4]cid_api.Entry;
    peer_cids: [4]cid_api.Entry;
    path_values: [2]path_api.Path;
    path_challenges: [4]path_api.Challenge;
    path_responses: [4]path_api.Response;
    path_sends: [8]path_api.SendReservation;

    stream_values: [STREAM_CAPACITY]stream_api.Stream;
    stream_attempts: [STREAM_ATTEMPT_CAPACITY]stream_api.Attempt;
    stream_send: [STREAM_WINDOW]u8;
    stream_send_pending: [STREAM_WINDOW]bool;
    stream_send_acked: [STREAM_WINDOW]bool;
    stream_send_inflight: [STREAM_WINDOW]u8;
    stream_receive: [STREAM_WINDOW]u8;
    stream_receive_present: [STREAM_WINDOW]bool;

    datagram_send_entries: [4]datagram_api.Entry;
    datagram_receive_entries: [4]datagram_api.Entry;
    datagram_send_bytes: [4800]u8;
    datagram_receive_bytes: [4800]u8;

    initialized: bool;
}

fun staged(stage: Stage) InitResult {
    var value: InitResult;
    value.stage = stage;
    ret value;
}

fun connection_id(data: *u8, length: usize) packet.ConnectionId {
    var value: packet.ConnectionId;
    if (data == nil || length == 0 || length > packet.MAX_CONNECTION_ID) {
        ret value;
    }
    value.len = length::u8;
    var i: usize = 0;
    for (i < length) { value.data[i] = data[i]; i = i + 1; }
    ret value;
}

fun path_address(value: ip.Endpoint) path_api.Address {
    ret path_api.ipv4(value.addr.v4.octets[0], value.addr.v4.octets[1],
        value.addr.v4.octets[2], value.addr.v4.octets[3], value.port);
}

fun parameter_role(role: transport_api.Role) u8 {
    if (role == transport_api.CLIENT) { ret transport_parameters.ROLE_CLIENT; }
    ret transport_parameters.ROLE_SERVER;
}

fun config_valid(config: *Config, role: transport_api.Role) bool {
    if (config == nil || config.source == 0 ||
        (config.version != packet.VERSION_1 &&
         config.version != packet.VERSION_2) ||
        config.max_udp_payload < 1200 ||
        config.max_udp_payload > MAX_UDP_PAYLOAD ||
        config.drain_timeout_ns == 0 || config.max_idle_timeout_ms == 0 ||
        config.alpn == nil || config.alpn_length == 0 ||
        config.local_source == nil || config.local_source_length == 0 ||
        config.local_source_length > packet.MAX_CONNECTION_ID ||
        config.peer_destination == nil || config.peer_destination_length == 0 ||
        config.peer_destination_length > packet.MAX_CONNECTION_ID ||
        config.original_destination == nil ||
        config.original_destination_length == 0 ||
        config.original_destination_length > packet.MAX_CONNECTION_ID ||
        config.active_connection_id_limit < 2 ||
        config.active_connection_id_limit > CONNECTION_ID_CAPACITY::u64 ||
        config.peer_bidirectional_streams + config.peer_unidirectional_streams >
            STREAM_CAPACITY::u64 ||
        config.receive_stream_data == 0 ||
        config.receive_stream_data > STREAM_STRIDE::u64 ||
        config.receive_max_data == 0 ||
        config.receive_max_data > STREAM_WINDOW::u64 ||
        config.max_datagram_frame_size > DATAGRAM_STRIDE) { ret false; }
    if (role == transport_api.SERVER) { ret true; }
    ret config.server_name != nil && config.server_name_length != 0;
}

# the single source of truth for what this connection will enforce. the stream
# manager configuration below and the encoded parameters are two renderings of
# it, which is what makes the core's equality checks hold by construction
fun stream_configuration(config: *Config,
                         role: transport_api.Role) stream_api.Config {
    var value: stream_api.Config;
    value.source = config.source;
    value.role = stream_api.ROLE_CLIENT;
    if (role == transport_api.SERVER) { value.role = stream_api.ROLE_SERVER; }
    value.local_bidirectional_limit = 0;
    value.local_unidirectional_limit = 0;
    value.peer_bidirectional_limit = config.peer_bidirectional_streams;
    value.peer_unidirectional_limit = config.peer_unidirectional_streams;
    value.send_max_data = 0;
    value.receive_max_data = config.receive_max_data;
    value.send_local_bidirectional_limit = 0;
    value.send_peer_bidirectional_limit = 0;
    value.send_unidirectional_limit = 0;
    value.receive_local_bidirectional_limit = config.receive_stream_data;
    value.receive_peer_bidirectional_limit = config.receive_stream_data;
    value.receive_unidirectional_limit = config.receive_stream_data;
    ret value;
}

fun local_parameters(config: *Config,
                     role: transport_api.Role) transport_parameters.Parameters {
    var value: transport_parameters.Parameters = transport_parameters.defaults();
    value.max_idle_timeout = config.max_idle_timeout_ms;
    value.max_udp_payload_size = config.max_udp_payload::u64;
    value.initial_max_data = config.receive_max_data;
    value.initial_max_stream_data_bidi_local = config.receive_stream_data;
    value.initial_max_stream_data_bidi_remote = config.receive_stream_data;
    value.initial_max_stream_data_uni = config.receive_stream_data;
    value.initial_max_streams_bidi = config.peer_bidirectional_streams;
    value.initial_max_streams_uni = config.peer_unidirectional_streams;
    value.active_connection_id_limit = config.active_connection_id_limit;
    value.max_datagram_frame_size = config.max_datagram_frame_size::u64;
    value.initial_source_connection_id = connection_id(config.local_source,
        config.local_source_length);
    var id: u64 = transport_parameters.MAX_IDLE_TIMEOUT;
    for (id <= transport_parameters.MAX_ACK_DELAY) {
        if (id != transport_parameters.STATELESS_RESET_TOKEN &&
            id != transport_parameters.DISABLE_ACTIVE_MIGRATION) {
            transport_parameters.set_present(?value, id);
        }
        id = id + 1;
    }
    transport_parameters.set_present(?value,
        transport_parameters.ACTIVE_CONNECTION_ID_LIMIT);
    transport_parameters.set_present(?value,
        transport_parameters.INITIAL_SOURCE_CONNECTION_ID);
    if (config.max_datagram_frame_size != 0) {
        transport_parameters.set_present(?value,
            transport_parameters.MAX_DATAGRAM_FRAME_SIZE);
    }
    if (role == transport_api.SERVER) {
        value.original_destination_connection_id = connection_id(
            config.original_destination, config.original_destination_length);
        transport_parameters.set_present(?value,
            transport_parameters.ORIGINAL_DESTINATION_CONNECTION_ID);
    }
    ret value;
}

# the consumer needs these bytes before the connection exists, because its TLS
# engine carries them as the quic_transport_parameters extension. re-deriving
# them inside init from the same config is what keeps the two copies identical
pub fun encode_parameters(config: *Config, role: transport_api.Role,
                          output: *u8,
                          capacity: usize) transport_parameters.EncodeResult {
    var failed: transport_parameters.EncodeResult;
    if (!config_valid(config, role) || output == nil || capacity == 0) {
        ret failed;
    }
    var builder: binary.Builder = binary.builder(output, capacity, binary.BIG);
    var parameters: transport_parameters.Parameters = local_parameters(config,
        role);
    ret transport_parameters.encode(?builder, ?parameters,
        parameter_role(role), transport_parameters.default_limits());
}

fun crypto_storage(c: *Connection) handshake_api.Storage {
    ret handshake_api.Storage{
        receive_data: ?c.crypto_receive[0],
        receive_present: ?c.crypto_receive_present[0],
        receive_length: 16384, receive_stride: 4096,
        send_data: ?c.crypto_send[0],
        send_pending: ?c.crypto_send_pending[0],
        send_acked: ?c.crypto_send_acked[0],
        send_inflight: ?c.crypto_send_inflight[0],
        send_length: 16384, send_stride: 4096,
        attempts: ?c.crypto_attempts[0], attempt_capacity: 8};
}

fun crypto_config(config: *Config) handshake_api.Config {
    ret handshake_api.Config{source: config.source, max_crypto_per_level: 4096,
        max_event_data: 4096, max_peer_identity: 4096};
}

fun tls_configuration(config: *Config) tls_client_api.Config {
    ret tls_client_api.Config{
        verification_time_unix: config.verification_time_unix,
        deadline_ns: config.tls_deadline_ns,
        entropy_context_size: config.entropy_context_size,
        entropy_secret_context_size: config.entropy_secret_context_size};
}

fun server_tls_configuration(config: *Config) tls_server_api.Config {
    ret tls_server_api.Config{
        verification_time_unix: config.verification_time_unix,
        deadline_ns: config.tls_deadline_ns,
        entropy_context_size: config.entropy_context_size,
        entropy_secret_context_size: config.entropy_secret_context_size};
}

fun core_storage(c: *Connection) core_api.Storage {
    ret core_api.Storage{
        receive_header: ?c.receive_header[0], receive_header_capacity: 1500,
        receive_decoded: ?c.receive_decoded[0], receive_decoded_capacity: 1500,
        send_plaintext: ?c.send_plaintext[0], send_plaintext_capacity: 1500,
        close_reason: ?c.close_reason[0], close_reason_capacity: 256,
        frame_ack_ranges: ?c.frame_ack_ranges[0], frame_ack_capacity: 32,
        recovery_events: ?c.recovery_events[0], recovery_event_capacity: 32,
        recovery_initial: recovery.HistoryStorage{
            packets: ?c.recovery_initial[0], capacity: 32},
        recovery_handshake: recovery.HistoryStorage{
            packets: ?c.recovery_handshake[0], capacity: 32},
        recovery_application: recovery.HistoryStorage{
            packets: ?c.recovery_application[0], capacity: 32},
        ack_initial: ack_api.SpaceStorage{ranges: ?c.ack_initial[0],
            capacity: 32},
        ack_handshake: ack_api.SpaceStorage{ranges: ?c.ack_handshake[0],
            capacity: 32},
        ack_application: ack_api.SpaceStorage{ranges: ?c.ack_application[0],
            capacity: 32},
        owners: ?c.owners[0], owner_capacity: 16,
        peer_extensions: ?c.peer_extensions[0], peer_extension_capacity: 16,
        peer_extension_bytes: ?c.peer_extension_bytes[0],
        peer_extension_byte_capacity: 512,
        local_extensions: ?c.local_extensions[0], local_extension_capacity: 16,
        local_extension_bytes: ?c.local_extension_bytes[0],
        local_extension_byte_capacity: 512,
        received_token: ?c.received_token[0], received_token_capacity: 512,
        send_token: ?c.send_token[0], send_token_capacity: 512,
        negotiation: negotiation.Storage{retry_token: ?c.retry_token[0],
            retry_token_capacity: 512, retry_pseudo: ?c.retry_pseudo[0],
            retry_pseudo_capacity: 1024}};
}

fun secret_storage(c: *Connection) core_api.SecretStorage {
    ret core_api.SecretStorage{
        receive_plaintext: ?c.secret_receive[0],
        receive_plaintext_capacity: 1500,
        send_plaintext: ?c.secret_send[0],
        send_plaintext_capacity: 1500};
}

fun datagram_storage(c: *Connection) datagram_api.Storage {
    ret datagram_api.Storage{
        send_entries: ?c.datagram_send_entries[0], send_capacity: 4,
        send_bytes: ?c.datagram_send_bytes[0], send_bytes_length: 4800,
        send_stride: 1200,
        receive_entries: ?c.datagram_receive_entries[0], receive_capacity: 4,
        receive_bytes: ?c.datagram_receive_bytes[0], receive_bytes_length: 4800,
        receive_stride: 1200};
}

fun core_configuration(c: *Connection, config: *Config,
                       role: transport_api.Role) core_api.Config {
    var value: core_api.Config;
    value.source = config.source;
    value.role = role;
    value.version = config.version;
    value.supported_versions = ?c.supported_versions[0];
    value.supported_version_count = 2;
    value.local = config.local;
    value.peer = config.peer;
    value.original_destination = connection_id(config.original_destination,
        config.original_destination_length);
    value.initial_secret_destination = value.original_destination;
    value.local_source = connection_id(config.local_source,
        config.local_source_length);
    value.peer_destination = connection_id(config.peer_destination,
        config.peer_destination_length);
    value.alpn = core_api.View{data: config.alpn, length: config.alpn_length};
    value.server_name = core_api.View{data: config.server_name,
        length: config.server_name_length};
    value.local_transport_parameters = core_api.View{
        data: ?c.local_parameters[0], length: c.local_parameter_length};
    value.max_udp_payload = config.max_udp_payload;
    value.max_idle_timeout_ns = config.max_idle_timeout_ms * 1000000;
    value.drain_timeout_ns = config.drain_timeout_ns;
    value.peer_validated = config.peer_validated;
    value.retry_source_present = false;
    value.enable_early_data = config.enable_early_data;
    ret value;
}

# every manager except the handshake adapter, which the caller's TLS engine
# decides the shape of
fun build_managers(c: *Connection, config: *Config,
                   role: transport_api.Role) Stage {
    c.supported_versions[0] = packet.VERSION_1;
    c.supported_versions[1] = packet.VERSION_2;
    val local_id: packet.ConnectionId = connection_id(config.local_source,
        config.local_source_length);
    val peer_id: packet.ConnectionId = connection_id(config.peer_destination,
        config.peer_destination_length);
    if (!stream_api.initialize(?c.streams, stream_configuration(config, role),
        stream_api.Storage{
            streams: ?c.stream_values[0], stream_capacity: STREAM_CAPACITY,
            send_data: ?c.stream_send[0], send_data_length: STREAM_WINDOW,
            send_pending: ?c.stream_send_pending[0],
            send_acked: ?c.stream_send_acked[0],
            send_inflight: ?c.stream_send_inflight[0],
            send_state_length: STREAM_WINDOW, send_stride: STREAM_STRIDE,
            receive_data: ?c.stream_receive[0], receive_data_length: STREAM_WINDOW,
            receive_present: ?c.stream_receive_present[0],
            receive_state_length: STREAM_WINDOW, receive_stride: STREAM_STRIDE,
            attempts: ?c.stream_attempts[0],
            attempt_capacity: STREAM_ATTEMPT_CAPACITY})) {
        ret STAGE_STREAMS;
    }
    if (!cid_api.initialize(?c.cids, cid_api.Config{source: config.source,
        local_active_limit: config.active_connection_id_limit::usize,
        peer_active_limit: config.active_connection_id_limit::usize},
        cid_api.Storage{local: ?c.local_cids[0], local_capacity: 4,
            peer: ?c.peer_cids[0], peer_capacity: 4}, local_id, peer_id)) {
        ret STAGE_CONNECTION_IDS;
    }
    var path_role: u8 = path_api.ROLE_CLIENT;
    if (role == transport_api.SERVER) { path_role = path_api.ROLE_SERVER; }
    var path_config: path_api.Config = path_api.default_config(config.source,
        path_role, config.peer_validated);
    path_config.maximum_mtu = config.max_udp_payload::u16;
    if (!path_api.initialize(?c.paths, path_config, path_api.Storage{
        paths: ?c.path_values[0], path_capacity: 2,
        challenges: ?c.path_challenges[0], challenge_capacity: 4,
        responses: ?c.path_responses[0], response_capacity: 4,
        sends: ?c.path_sends[0], send_capacity: 8},
        path_api.Endpoint{local: path_address(config.local),
            peer: path_address(config.peer)})) {
        ret STAGE_PATHS;
    }
    val datagram_config: datagram_api.Config = datagram_api.Config{
        source: config.source, peer_max_frame_size: 0,
        local_max_frame_size: config.max_datagram_frame_size,
        enabled: config.max_datagram_frame_size != 0};
    var storage: datagram_api.Storage = datagram_api.empty_storage();
    if (datagram_config.enabled) { storage = datagram_storage(c); }
    if (!datagram_api.initialize(?c.datagrams, datagram_config, storage)) {
        ret STAGE_DATAGRAMS;
    }
    ret STAGE_OK;
}

fun finish(c: *Connection, config: *Config, role: transport_api.Role,
           scope: *cancel.Scope, now_ns: u64) InitResult {
    val encoded: transport_parameters.EncodeResult = encode_parameters(config,
        role, ?c.local_parameters[0], 512);
    if (!encoded.ok) { ret staged(STAGE_PARAMETERS); }
    c.local_parameter_length = encoded.count;
    var value: InitResult;
    if (role == transport_api.CLIENT) {
        value.core = core_api.init_client_result(?c.core, ?c.secrets,
            core_configuration(c, config, role), core_storage(c),
            secret_storage(c), ?c.handshake, ?c.cids, ?c.paths, ?c.streams,
            ?c.datagrams, now_ns);
    } or {
        value.core = core_api.init_server_result(?c.core, ?c.secrets,
            core_configuration(c, config, role), core_storage(c),
            secret_storage(c), ?c.handshake, ?c.cids, ?c.paths, ?c.streams,
            ?c.datagrams, now_ns);
    }
    if (!value.core.ok) {
        value.stage = STAGE_CORE;
        ret value;
    }
    if (!binding_api.bind(?c.binding, ?c.core, ?c.secrets) ||
        !binding_api.prepare_initial_route(?c.binding, config.local_source,
            config.local_source_length)) {
        value.stage = STAGE_BINDING;
        ret value;
    }
    val driver_config: transport_api.Config = transport_api.Config{
        source: config.source, max_udp_payload: config.max_udp_payload,
        max_close_reason: 256};
    val driver_storage: transport_api.Storage = transport_api.Storage{
        sends: ?c.sends[0], send_capacity: 4};
    var started: bool = false;
    if (role == transport_api.CLIENT) {
        started = transport_api.init_client[binding_api.Binding](?c.driver,
            driver_config, binding_api.protocol(?c.binding), ?c.streams,
            ?c.datagrams, scope, driver_storage);
    } or {
        started = transport_api.init_server[binding_api.Binding](?c.driver,
            driver_config, binding_api.protocol(?c.binding), ?c.streams,
            ?c.datagrams, scope, driver_storage);
    }
    if (!started) {
        value.stage = STAGE_DRIVER;
        ret value;
    }
    if (!binding_api.publish_initial_route(?c.binding)) {
        value.stage = STAGE_BINDING;
        ret value;
    }
    c.initialized = true;
    value.ok = true;
    value.stage = STAGE_OK;
    ret value;
}

pub fun routing_snapshot(c: *Connection) RoutingSnapshot {
    var value: RoutingSnapshot;
    if (c == nil || !c.initialized) { ret value; }
    val internal: binding_api.RoutingSnapshot =
        binding_api.routing_snapshot(?c.binding);
    value.source = internal.source;
    value.capacity = internal.capacity;
    value.active = internal.active;
    value.initialized = internal.initialized;
    ret value;
}

pub fun route_at(c: *Connection, index: usize) Route {
    var value: Route;
    if (c == nil || !c.initialized) { ret value; }
    val internal: binding_api.Route = binding_api.route_at(?c.binding, index);
    value.source = internal.source;
    value.index = internal.index;
    value.generation = internal.generation;
    value.sequence = internal.sequence;
    value.id.data = internal.id.data;
    value.id.length = internal.id.length;
    value.active = internal.active;
    ret value;
}

pub fun route_valid(c: *Connection, route: *Route) bool {
    if (c == nil || !c.initialized || route == nil) { ret false; }
    var internal: binding_api.Route;
    internal.source = route.source;
    internal.index = route.index;
    internal.generation = route.generation;
    internal.sequence = route.sequence;
    internal.id.data = route.id.data;
    internal.id.length = route.id.length;
    internal.active = route.active;
    ret binding_api.route_valid(?c.binding, ?internal);
}

pub fun init_client(c: *Connection, config: *Config, tls: *client.Client,
                    scope: *cancel.Scope, now_ns: u64) InitResult {
    if (c == nil || tls == nil || scope == nil || c.initialized ||
        !config_valid(config, transport_api.CLIENT)) {
        ret staged(STAGE_CONFIG);
    }
    val built: Stage = build_managers(c, config, transport_api.CLIENT);
    if (built != STAGE_OK) { ret staged(built); }
    if (!tls_client_api.initialize(?c.handshake, crypto_config(config),
        crypto_storage(c), tls, tls_configuration(config))) {
        ret staged(STAGE_HANDSHAKE);
    }
    ret finish(c, config, transport_api.CLIENT, scope, now_ns);
}

pub fun init_server(c: *Connection, config: *Config, tls: *server.Server,
                    scope: *cancel.Scope, now_ns: u64) InitResult {
    if (c == nil || tls == nil || scope == nil || c.initialized ||
        !config_valid(config, transport_api.SERVER)) {
        ret staged(STAGE_CONFIG);
    }
    val built: Stage = build_managers(c, config, transport_api.SERVER);
    if (built != STAGE_OK) { ret staged(built); }
    if (!tls_server_api.initialize(?c.handshake, crypto_config(config),
        crypto_storage(c), tls, server_tls_configuration(config))) {
        ret staged(STAGE_HANDSHAKE);
    }
    ret finish(c, config, transport_api.SERVER, scope, now_ns);
}

test "quic.connection.assembly: production profile encodes bounded H3 limits" {
    var id: [8]u8 = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var protocol: [2]u8 = [2]u8{'h', '3'};
    var name: [1]u8 = [1]u8{'x'};
    var config: Config = default_config(991,
        ip.endpoint(192, 0, 2, 1, 4433),
        ip.endpoint(192, 0, 2, 2, 4433));
    config.local_source = ?id[0];
    config.local_source_length = 8;
    config.peer_destination = ?id[0];
    config.peer_destination_length = 8;
    config.original_destination = ?id[0];
    config.original_destination_length = 8;
    config.alpn = ?protocol[0];
    config.alpn_length = 2;
    config.server_name = ?name[0];
    config.server_name_length = 1;
    var encoded: [512]u8;
    val result: transport_parameters.EncodeResult = encode_parameters(?config,
        transport_api.CLIENT, ?encoded[0], 512);
    var parameters: transport_parameters.Parameters;
    var storage: transport_parameters.Storage;
    if (!result.ok || transport_parameters.decode(?encoded[0], result.count,
            true, transport_parameters.ROLE_CLIENT,
            transport_parameters.default_limits(), storage,
            ?parameters).status != transport_parameters.STATUS_DONE ||
        parameters.initial_max_streams_bidi != H3_REQUEST_STREAMS::u64 ||
        parameters.initial_max_streams_uni !=
            H3_CRITICAL_STREAMS_PER_PEER::u64 ||
        parameters.initial_max_data != STREAM_WINDOW::u64 ||
        parameters.initial_max_stream_data_bidi_local != STREAM_STRIDE::u64 ||
        parameters.initial_max_stream_data_bidi_remote != STREAM_STRIDE::u64 ||
        parameters.initial_max_stream_data_uni != STREAM_STRIDE::u64) { ret 1; }
    config.peer_bidirectional_streams = 13;
    config.peer_unidirectional_streams = 3;
    if (!encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 2; }
    config.peer_bidirectional_streams = 14;
    if (encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 3; }
    config.peer_bidirectional_streams = H3_REQUEST_STREAMS::u64;
    config.peer_unidirectional_streams =
        H3_CRITICAL_STREAMS_PER_PEER::u64;
    config.receive_max_data = STREAM_WINDOW::u64 + 1;
    if (encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 4; }
    config.receive_max_data = STREAM_WINDOW::u64;
    config.receive_stream_data = STREAM_STRIDE::u64 + 1;
    if (encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 5; }
    ret 0;
}
