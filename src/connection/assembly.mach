# assembles a connection core and every manager it owns from one configuration
#
# the core validates twelve exact equalities between its encoded local transport
# parameters and the manager configurations those parameters describe. deriving
# both from a single record is the only way that agreement is structural rather
# than something each consumer rediscovers.

use quic.clock;
use cid_api:       quic.connection.cid;
use core_api:      quic.connection.core;
use handshake_api: quic.connection.handshake;
use listener_api:  quic.connection.listener;
use quic.connection.negotiation;
use quic.connection.ownership;
use tls_client_api: quic.connection.tls_client;
use tls_server_api: quic.connection.tls_server;
use quic.frame.frame;
use quic.packet.packet;
use path_api: quic.path.path;
use ack_api:  quic.recovery.ack;
use quic.recovery.recovery;
use chunks_api: quic.storage.chunks;
use quic.storage.ranges;
use supply:        quic.storage.source;
use datagram_api:  quic.stream.datagram;
use stream_api:    quic.stream.stream;
use transport_api: quic.transport;
use binding_api:   quic.transport.binding;
use quic.transport_parameters;

use tls.client;
use tls.server;

use std.chrono.duration;
use std.chrono.time;
use std.encoding.binary;
use std.memory.buffers;
use std.net.ip;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

# the exact capacities required of caller-owned public and secret backing
pub val MAX_UDP_PAYLOAD: usize = 1500;
# crypto bytes a level may carry, each level holding at most one chunk
pub val CRYPTO_PER_LEVEL:             usize = 4096;
pub val H3_CRITICAL_STREAMS_PER_PEER: usize = 3;
pub val H3_REQUEST_STREAMS:           usize = 8;
pub val STREAM_CAPACITY:              usize = 16;
pub val STREAM_STRIDE:                usize = 4096;
pub val STREAM_WINDOW:                usize = STREAM_CAPACITY * STREAM_STRIDE;
pub val STREAM_ATTEMPT_CAPACITY:      usize = STREAM_CAPACITY * 2;
pub val DATAGRAM_CAPACITY:            usize = 4;
pub val DATAGRAM_STRIDE:              usize = 1200;
pub val CONNECTION_ID_CAPACITY:       usize = 4;
pub val OWNER_CAPACITY:               usize = 16;
pub val TOKEN_CAPACITY:               usize = 512;
pub val PARAMETER_CAPACITY:           usize = 512;
pub val SEND_CAPACITY:                usize = 4;

pub def Stage: u8;
pub val STAGE_OK:             Stage = 0;
pub val STAGE_CONFIG:         Stage = 1;
pub val STAGE_STREAMS:        Stage = 2;
pub val STAGE_CONNECTION_IDS: Stage = 3;
pub val STAGE_PATHS:          Stage = 4;
pub val STAGE_DATAGRAMS:      Stage = 5;
pub val STAGE_HANDSHAKE:      Stage = 6;
pub val STAGE_PARAMETERS:     Stage = 7;
pub val STAGE_CORE:           Stage = 8;
pub val STAGE_BINDING:        Stage = 9;
pub val STAGE_DRIVER:         Stage = 10;
pub val STAGE_STORAGE:        Stage = 11;

# `core` carries the reason code the core itself reported, so a refusal at
# STAGE_CORE names which ownership or precondition check rejected
pub rec InitResult {
    ok:               bool;
    stage:            Stage;
    core:             core_api.InitResult;
    cleanup_retained: bool;
}

pub rec RoutingId {
    data:   [20]u8;
    length: usize;
}

pub rec Route {
    source:     u64;
    index:      usize;
    generation: u64;
    sequence:   u64;
    id:         RoutingId;
    active:     bool;
}

pub rec RoutingSnapshot {
    source:      u64;
    capacity:    usize;
    active:      usize;
    initialized: bool;
}

pub rec Config {
    source:                      u64;
    version:                     u32;
    local:                       ip.Endpoint;
    peer:                        ip.Endpoint;
    local_source:                *u8;
    local_source_length:         usize;
    peer_destination:            *u8;
    peer_destination_length:     usize;
    original_destination:        *u8;
    original_destination_length: usize;
    initial_destination:         *u8;
    initial_destination_length:  usize;
    retry_source:                *u8;
    retry_source_length:         usize;
    alpn:                        *u8;
    alpn_length:                 usize;
    server_name:                 *u8;
    server_name_length:          usize;
    max_udp_payload:             usize;
    # the idle timeout advertised to the peer, whole milliseconds on the wire
    max_idle_timeout:            duration.Duration;
    drain_timeout:               duration.Duration;
    peer_bidirectional_streams:  u64;
    peer_unidirectional_streams: u64;
    receive_max_data:            u64;
    receive_stream_data:         u64;
    active_connection_id_limit:  u64;
    max_datagram_frame_size:     usize;
    verification_time_unix:      i64;
    # when the handshake must have finished, on the monotonic clock
    tls_deadline:                opt[time.Instant];
    entropy_context_size:        usize;
    entropy_secret_context_size: usize;
    # chunks the pool sets aside for this connection alone
    chunk_reserve:             usize;
    peer_validated:            bool;
    retry_source_present:      bool;
    server_acceptance_applied: bool;
    enable_early_data:         bool;
}

pub fun default_config(source: u64, local: ip.Endpoint,
    peer: ip.Endpoint) Config {
    var value: Config;
    value.source                      = source;
    value.version                     = packet.VERSION_1;
    value.local                       = local;
    value.peer                        = peer;
    value.max_udp_payload             = MAX_UDP_PAYLOAD;
    value.max_idle_timeout            = 30 * duration.SECOND;
    value.drain_timeout               = 3 * duration.SECOND;
    value.tls_deadline                = opt[time.Instant].none{};
    value.peer_bidirectional_streams  = H3_REQUEST_STREAMS::u64;
    value.peer_unidirectional_streams = H3_CRITICAL_STREAMS_PER_PEER::u64;
    value.receive_max_data            = STREAM_WINDOW::u64;
    value.receive_stream_data         = STREAM_STRIDE::u64;
    value.active_connection_id_limit  = 2;
    value.max_datagram_frame_size     = 0;
    value.entropy_context_size        = 1;
    value.entropy_secret_context_size = 0;
    value.chunk_reserve               = 4;
    ret value;
}

# fixed arrays make the public backing size part of the type
pub rec Storage {
    sends:                    [SEND_CAPACITY]transport_api.SendSlot;
    supported_versions:       [2]u32;
    receive_header:           [MAX_UDP_PAYLOAD]u8;
    receive_decoded:          [MAX_UDP_PAYLOAD]u8;
    send_plaintext:           [MAX_UDP_PAYLOAD]u8;
    close_reason:             [256]u8;
    frame_ack_ranges:         [32]frame.AckRange;
    recovery_events:          [32]recovery.Event;
    ack_initial:              [32]ack_api.Range;
    ack_handshake:            [32]ack_api.Range;
    ack_application:          [32]ack_api.Range;
    received_token:           [TOKEN_CAPACITY]u8;
    send_token:               [TOKEN_CAPACITY]u8;
    crypto_attempts:          [8]handshake_api.Attempt;
    local_cids:               [CONNECTION_ID_CAPACITY]cid_api.Entry;
    peer_cids:                [CONNECTION_ID_CAPACITY]cid_api.Entry;
    path_values:              [2]path_api.Path;
    path_challenges:          [4]path_api.Challenge;
    path_responses:           [4]path_api.Response;
    path_sends:               [8]path_api.SendReservation;
    datagram_send_entries:    [DATAGRAM_CAPACITY]datagram_api.Entry;
    datagram_receive_entries: [DATAGRAM_CAPACITY]datagram_api.Entry;
    datagram_send_bytes:      [DATAGRAM_CAPACITY * DATAGRAM_STRIDE]u8;
    datagram_receive_bytes:   [DATAGRAM_CAPACITY * DATAGRAM_STRIDE]u8;
    source:                   u64;
    generation:               u64;
    leased:                   bool;
}

# secret storage is allocated only through classification-preserving ownership
pub rec SecretStorage {
    receive_plaintext: [MAX_UDP_PAYLOAD]^u8;
    send_plaintext:    [MAX_UDP_PAYLOAD]^u8;
    source:            u64;
    generation:        u64;
    leased:            bool;
}

pub rec Connection {
    core:           core_api.Core;
    secrets:        core_api.Secrets;
    handshake:      handshake_api.Adapter;
    cids:           cid_api.Manager;
    paths:          path_api.Manager;
    streams:        stream_api.Manager;
    datagrams:      datagram_api.Queue;
    binding:        binding_api.Binding;
    driver:         transport_api.Driver[binding_api.Binding];
    storage:        *Storage;
    secret_storage: *SecretStorage;
    # every chunk comes from the caller's buffer source, counted against this
    # connection's account
    provider: supply.Provider;
    account:  supply.Account;
    # handshake-only state, held until the core confirms the handshake
    handshake_block:           chunks_api.Block;
    storage_generation:        u64;
    secret_storage_generation: u64;
    local_parameter_length:    usize;
    initialized:               bool;
    released:                  bool;
}

fun staged(stage: Stage) InitResult {
    var value: InitResult;
    value.stage = stage;
    ret value;
}

fun connection_id(data: *u8, length: usize) packet.ConnectionId {
    var value: packet.ConnectionId;
    if (data == nil || length > packet.MAX_CONNECTION_ID) {
        ret value;
    }
    value.len = length::u8;
    var i: usize = 0;
    for (i < length) {
        value.data[i] = data[i];
        i             = i + 1;
    }
    ret value;
}

fun accepted_id(value: *packet.ConnectionId) bool {
    ret value != nil && value.len > 0 &&
        value.len::usize <= packet.MAX_CONNECTION_ID;
}

# rfc 9000 5.1: a client may choose a zero-length connection id
fun accepted_peer_id(value: *packet.ConnectionId) bool {
    ret value != nil && value.len::usize <= packet.MAX_CONNECTION_ID;
}

# applies the listener's complete acceptance as one configuration transaction.
# accepted must remain at a fixed address through parameter encoding and init
pub fun apply_server_acceptance(config: *Config,
    accepted: *listener_api.Accepted) bool {
    if (config == nil || accepted == nil ||
        accepted.action != listener_api.ACTION_ACCEPT ||
        (accepted.version != packet.VERSION_1 &&
        accepted.version != packet.VERSION_2) ||
        !accepted_id(?accepted.original_destination) ||
        !accepted_id(?accepted.initial_destination) ||
        !accepted_peer_id(?accepted.initial_source)) { ret false; }
    if (accepted.retry_source_present) {
        if (!accepted_id(?accepted.retry_source) ||
            !packet.connection_id_equal(?accepted.initial_destination,
            ?accepted.retry_source)) { ret false; }
    }
    or {
        if (accepted.retry_source.len != 0 ||
            !packet.connection_id_equal(?accepted.initial_destination,
            ?accepted.original_destination)) { ret false; }
    }
    var next: Config = @config;
    next.version                     = accepted.version;
    next.peer                        = accepted.peer;
    next.peer_destination            = ?accepted.initial_source.data[0];
    next.peer_destination_length     = accepted.initial_source.len::usize;
    next.original_destination        = ?accepted.original_destination.data[0];
    next.original_destination_length =
        accepted.original_destination.len::usize;
    next.initial_destination        = ?accepted.initial_destination.data[0];
    next.initial_destination_length = accepted.initial_destination.len::usize;
    next.retry_source               = nil;
    next.retry_source_length        = 0;
    if (accepted.retry_source_present) {
        next.retry_source        = ?accepted.retry_source.data[0];
        next.retry_source_length = accepted.retry_source.len::usize;
    }
    next.peer_validated            = accepted.peer_validated;
    next.retry_source_present      = accepted.retry_source_present;
    next.server_acceptance_applied = true;
    @config                        = next;
    ret true;
}

fun path_address(value: ip.Endpoint) path_api.Address {
    ret path_api.ipv4(value.addr.v4.octets[0], value.addr.v4.octets[1],
        value.addr.v4.octets[2], value.addr.v4.octets[3], value.port);
}

fun parameter_role(role: transport_api.Role) u8 {
    if (role == transport_api.CLIENT) { ret transport_parameters.ROLE_CLIENT; }
    ret transport_parameters.ROLE_SERVER;
}

fun config_valid(config: *Config, role: transport_api.Role) bool {
    if (config == nil || config.source == 0 ||
        (config.version != packet.VERSION_1 &&
        config.version != packet.VERSION_2) ||
        config.max_udp_payload < 1200 ||
        config.max_udp_payload > MAX_UDP_PAYLOAD ||
        config.drain_timeout <= 0 || config.max_idle_timeout < duration.MILLISECOND ||
        config.alpn == nil || config.alpn_length == 0 ||
        (config.local_source == nil && config.local_source_length != 0) ||
        (config.local_source_length == 0 && role != transport_api.CLIENT) ||
        config.local_source_length > packet.MAX_CONNECTION_ID ||
        (config.peer_destination == nil && config.peer_destination_length != 0) ||
        config.peer_destination_length > packet.MAX_CONNECTION_ID ||
        config.original_destination == nil ||
        config.original_destination_length == 0 ||
        config.original_destination_length > packet.MAX_CONNECTION_ID ||
        config.active_connection_id_limit < 2 ||
        config.active_connection_id_limit > CONNECTION_ID_CAPACITY::u64 ||
        config.peer_bidirectional_streams + config.peer_unidirectional_streams +
        H3_CRITICAL_STREAMS_PER_PEER::u64 > STREAM_CAPACITY::u64 ||
        config.receive_stream_data == 0 ||
        config.receive_stream_data > STREAM_STRIDE::u64 ||
        config.receive_max_data == 0 ||
        config.receive_max_data > STREAM_WINDOW::u64 ||
        config.max_datagram_frame_size > DATAGRAM_STRIDE) { ret false; }
    if (role == transport_api.SERVER) {
        if (!config.server_acceptance_applied ||
            config.initial_destination == nil ||
            config.initial_destination_length == 0 ||
            config.initial_destination_length > packet.MAX_CONNECTION_ID) {
            ret false;
        }
        if (config.retry_source_present) {
            if (config.retry_source == nil || config.retry_source_length == 0 ||
                config.retry_source_length > packet.MAX_CONNECTION_ID) {
                ret false;
            }
            var initial: packet.ConnectionId = connection_id(
                config.initial_destination,
                config.initial_destination_length);
            var retry: packet.ConnectionId = connection_id(config.retry_source,
                config.retry_source_length);
            ret packet.connection_id_equal(?initial, ?retry);
        }
        if (config.retry_source != nil || config.retry_source_length != 0) {
            ret false;
        }
        var initial: packet.ConnectionId = connection_id(
            config.initial_destination, config.initial_destination_length);
        var original: packet.ConnectionId = connection_id(
            config.original_destination, config.original_destination_length);
        ret packet.connection_id_equal(?initial, ?original);
    }
    ret config.server_name != nil && config.server_name_length != 0;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

# the handshake block's layout, one pool chunk the core releases once the
# handshake is confirmed
val EXTENSION_CAPACITY:       usize = 16;
val RETRY_PSEUDO_CAPACITY:    usize = 1024;
val LOCAL_PARAMETERS_AT:      usize = 0;
val LOCAL_EXTENSION_BYTES_AT: usize = PARAMETER_CAPACITY;
val PEER_EXTENSION_BYTES_AT:  usize = 2 * PARAMETER_CAPACITY;
val RETRY_TOKEN_AT:           usize = 3 * PARAMETER_CAPACITY;
val RETRY_PSEUDO_AT:          usize = RETRY_TOKEN_AT + TOKEN_CAPACITY;
val LOCAL_EXTENSIONS_AT:      usize = RETRY_PSEUDO_AT + RETRY_PSEUDO_CAPACITY;
val PEER_EXTENSIONS_AT:       usize = LOCAL_EXTENSIONS_AT +
    EXTENSION_CAPACITY * $size_of(transport_parameters.Parameter);
val HANDSHAKE_BLOCK_END: usize = PEER_EXTENSIONS_AT +
    EXTENSION_CAPACITY * $size_of(transport_parameters.Parameter);

fun chunk_source(c: *Connection) ranges.Source {
    ret ranges.Source{provider: ?c.provider, account: ?c.account, lane: supply.SEND};
}

fun local_parameter_bytes(c: *Connection) *u8 {
    ret ?c.handshake_block.data[LOCAL_PARAMETERS_AT];
}

fun public_core_storage(c: *Connection) core_api.Storage {
    val storage: *Storage = c.storage;
    val block:   *u8      = c.handshake_block.data;
    ret core_api.Storage{
        receive_header:           ?storage.receive_header[0],
        receive_header_capacity:  MAX_UDP_PAYLOAD,
        receive_decoded:          ?storage.receive_decoded[0],
        receive_decoded_capacity: MAX_UDP_PAYLOAD,
        send_plaintext:           ?storage.send_plaintext[0],
        send_plaintext_capacity:  MAX_UDP_PAYLOAD,
        close_reason:             ?storage.close_reason[0], close_reason_capacity: 256,
        frame_ack_ranges:         ?storage.frame_ack_ranges[0], frame_ack_capacity: 32,
        recovery_events:          ?storage.recovery_events[0], recovery_event_capacity: 32,
        recovery_initial:         recovery.HistoryStorage{capacity: HISTORY_CAPACITY},
        recovery_handshake:       recovery.HistoryStorage{capacity: HISTORY_CAPACITY},
        recovery_application:     recovery.HistoryStorage{capacity: HISTORY_CAPACITY},
        ack_initial:              ack_api.SpaceStorage{ranges: ?storage.ack_initial[0],
            capacity: 32},
        ack_handshake: ack_api.SpaceStorage{ranges: ?storage.ack_handshake[0],
            capacity: 32},
        ack_application: ack_api.SpaceStorage{ranges: ?storage.ack_application[0],
            capacity: 32},
        owners: nil, owner_capacity: OWNER_CAPACITY,
        peer_extensions: (?block[PEER_EXTENSIONS_AT])::*transport_parameters.Parameter,
        peer_extension_capacity:      EXTENSION_CAPACITY,
        peer_extension_bytes:         ?block[PEER_EXTENSION_BYTES_AT],
        peer_extension_byte_capacity: PARAMETER_CAPACITY,
        local_extensions: (?block[LOCAL_EXTENSIONS_AT])::*transport_parameters.Parameter,
        local_extension_capacity:      EXTENSION_CAPACITY,
        local_extension_bytes:         ?block[LOCAL_EXTENSION_BYTES_AT],
        local_extension_byte_capacity: PARAMETER_CAPACITY,
        received_token:                ?storage.received_token[0],
        received_token_capacity:       TOKEN_CAPACITY,
        send_token:                    ?storage.send_token[0], send_token_capacity: TOKEN_CAPACITY,
        negotiation:                   negotiation.Storage{
            retry_token:          ?block[RETRY_TOKEN_AT],
            retry_token_capacity: TOKEN_CAPACITY,
            retry_pseudo:         ?block[RETRY_PSEUDO_AT], retry_pseudo_capacity: RETRY_PSEUDO_CAPACITY
        },
        handshake_block: ?c.handshake_block,
        chunk_source:    chunk_source(c)
    };
}

fun public_cid_storage(storage: *Storage) cid_api.Storage {
    ret cid_api.Storage{local: ?storage.local_cids[0],
        local_capacity: CONNECTION_ID_CAPACITY, peer: ?storage.peer_cids[0],
        peer_capacity:  CONNECTION_ID_CAPACITY};
}

fun public_path_storage(storage: *Storage) path_api.Storage {
    ret path_api.Storage{paths: ?storage.path_values[0], path_capacity: 2,
        challenges: ?storage.path_challenges[0], challenge_capacity: 4,
        responses:  ?storage.path_responses[0], response_capacity: 4,
        sends:      ?storage.path_sends[0], send_capacity: 8};
}

fun public_stream_storage(c: *Connection) stream_api.Storage {
    ret stream_api.Storage{streams: nil,
        stream_capacity:   STREAM_CAPACITY,
        attempts:          nil,
        attempt_capacity:  STREAM_ATTEMPT_CAPACITY,
        chunks:            ?c.provider, account: ?c.account,
        send_buffer_limit: STREAM_STRIDE};
}

fun public_datagram_storage(storage: *Storage) datagram_api.Storage {
    ret datagram_api.Storage{
        send_entries:         ?storage.datagram_send_entries[0],
        send_capacity:        DATAGRAM_CAPACITY,
        send_bytes:           ?storage.datagram_send_bytes[0],
        send_bytes_length:    DATAGRAM_CAPACITY * DATAGRAM_STRIDE,
        send_stride:          DATAGRAM_STRIDE,
        receive_entries:      ?storage.datagram_receive_entries[0],
        receive_capacity:     DATAGRAM_CAPACITY,
        receive_bytes:        ?storage.datagram_receive_bytes[0],
        receive_bytes_length: DATAGRAM_CAPACITY * DATAGRAM_STRIDE,
        receive_stride:       DATAGRAM_STRIDE
    };
}

fun private_core_storage(storage: *SecretStorage) core_api.SecretStorage {
    ret core_api.SecretStorage{
        receive_plaintext:          ?storage.receive_plaintext[0],
        receive_plaintext_capacity: MAX_UDP_PAYLOAD,
        send_plaintext:             ?storage.send_plaintext[0],
        send_plaintext_capacity:    MAX_UDP_PAYLOAD
    };
}

fun connection_range(c: *Connection) ownership.Range {
    if (c == nil) {
        var empty: ownership.Range;
        ret empty;
    }
    ret ownership.anchored_record[Connection, usize](
        ?c.local_parameter_length,
        $offset_of(Connection, local_parameter_length));
}

fun secret_storage_range(storage: *SecretStorage) ownership.Range {
    if (storage == nil) {
        var empty: ownership.Range;
        ret empty;
    }
    ret ownership.anchored_record[SecretStorage, u64](?storage.source,
        $offset_of(SecretStorage, source));
}

fun capacities_valid(storage: *Storage, secret_storage: *SecretStorage) bool {
    ret !storage.leased && storage.source == 0 &&
        !secret_storage.leased && secret_storage.source == 0;
}

fun storage_ranges_valid(c: *Connection, config: *Config, storage: *Storage,
    secret_storage: *SecretStorage,
    scope: *cancel.Scope) bool {
    var ranges: [5]ownership.Range;
    ranges[0] = connection_range(c);
    ranges[1] = ownership.record[Storage](storage);
    ranges[2] = secret_storage_range(secret_storage);
    ranges[3] = ownership.record[cancel.Scope](scope);
    ranges[4] = ownership.record[Config](config);
    if (!ownership.all_disjoint(?ranges[0], 5) ||
        !ownership.secret_disjoint(?secret_storage.receive_plaintext[0],
        MAX_UDP_PAYLOAD, ?secret_storage.send_plaintext[0],
        MAX_UDP_PAYLOAD)) { ret false; }
    var borrowed: [7]ownership.Range;
    borrowed[0] = ownership.bytes(config.local_source,
        config.local_source_length, ownership.ZERO_ALLOWED);
    borrowed[1] = ownership.bytes(config.peer_destination,
        config.peer_destination_length, ownership.ZERO_ALLOWED);
    borrowed[2] = ownership.bytes(config.original_destination,
        config.original_destination_length, ownership.ZERO_FORBIDDEN);
    borrowed[3] = ownership.bytes(config.initial_destination,
        config.initial_destination_length, ownership.ZERO_ALLOWED);
    borrowed[4] = ownership.bytes(config.retry_source,
        config.retry_source_length, ownership.ZERO_ALLOWED);
    borrowed[5] = ownership.bytes(config.alpn, config.alpn_length,
        ownership.ZERO_FORBIDDEN);
    borrowed[6] = ownership.bytes(config.server_name,
        config.server_name_length, ownership.ZERO_ALLOWED);
    var i: usize = 0;
    for (i < 7) {
        if (ownership.disjoint_from(borrowed[i], i, ?ranges[0], 0, 4).kind !=
            ownership.OVERLAP_NONE) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a stream direction never holds more than its window in chunks, one partly
# filled chunk at each end, and a spill each for its chunk list and its ranges
val SPILLS_PER_STREAM: usize = 2;

# chunks held against the send direction besides stream and crypto bytes: the
# handshake block, the owner table, one packet history per space, the stream
# records and the stream attempts
val CORE_BLOCKS: usize = 1 + 1 + 3 +
    (STREAM_CAPACITY + stream_api.RECORDS_PER_BLOCK - 1) / stream_api.RECORDS_PER_BLOCK + 1;

# packets a space tracks, within one chunk and no more than the recovery
# events a call can report
val HISTORY_CAPACITY: usize = 32;

# each of the four crypto levels holds its bytes and a range spill
val CRYPTO_CHUNKS: usize = 4 * 2;

fun chunks_for(bytes: u64) usize {
    ret ((bytes + supply.BYTES::u64 - 1) / supply.BYTES::u64)::usize;
}

fun chunk_budget(window: u64) usize {
    ret STREAM_CAPACITY * (chunks_for(window) + 1 + SPILLS_PER_STREAM) +
        CRYPTO_CHUNKS * chunks_for(CRYPTO_PER_LEVEL::u64);
}

fun backing_lease_valid(c: *Connection) bool {
    ret c != nil && c.storage != nil && c.secret_storage != nil &&
        c.storage.leased && c.secret_storage.leased &&
        c.storage.source != 0 && c.storage.source == c.secret_storage.source &&
        c.storage.generation == c.storage_generation &&
        c.secret_storage.generation == c.secret_storage_generation;
}

fun acquire_backing(c: *Connection, config: *Config, storage: *Storage,
    secret_storage: *SecretStorage, chunks: buffers.Source,
    scope: *cancel.Scope) bool {
    if (c == nil || config == nil || chunks.ctx == nil || c.storage != nil ||
        c.secret_storage != nil || c.account.open ||
        !storage_ranges_valid(c, config, storage, secret_storage, scope) ||
        !capacities_valid(storage, secret_storage)) { ret false; }
    # the reservation is admission: a pool that cannot back it refuses the
    # connection before anything else is leased
    c.provider = chunks;
    if (!supply.open(?c.provider, ?c.account, config.source,
        chunk_budget(STREAM_STRIDE::u64) + CORE_BLOCKS,
        chunk_budget(config.receive_stream_data),
        config.chunk_reserve)) {
        var no_provider: supply.Provider;
        c.provider = no_provider;
        ret false;
    }
    var from: ranges.Source = chunk_source(c);
    if (!chunks_api.take_block(?from, ?c.handshake_block)) {
        supply.close(?c.provider, ?c.account);
        var no_provider: supply.Provider;
        c.provider = no_provider;
        ret false;
    }
    storage.generation          = next_generation(storage.generation);
    secret_storage.generation   = next_generation(secret_storage.generation);
    storage.source              = config.source;
    secret_storage.source       = config.source;
    storage.leased              = true;
    secret_storage.leased       = true;
    c.storage                   = storage;
    c.secret_storage            = secret_storage;
    c.storage_generation        = storage.generation;
    c.secret_storage_generation = secret_storage.generation;
    c.released                  = false;
    ret true;
}

fun release_backing(c: *Connection) bool {
    if (!backing_lease_valid(c)) { ret false; }
    # a core that never finished still holds its owner and history chunks
    if (c.account.open) { core_api.release_chunks(?c.core); }
    var from: ranges.Source = chunk_source(c);
    chunks_api.give_block(?from, ?c.handshake_block);
    if (c.handshake_block.data != nil ||
        (c.account.open && !supply.close(?c.provider, ?c.account))) { ret false; }
    var no_provider: supply.Provider;
    c.provider                  = no_provider;
    c.storage.source            = 0;
    c.storage.leased            = false;
    c.secret_storage.source     = 0;
    c.secret_storage.leased     = false;
    c.storage                   = nil;
    c.secret_storage            = nil;
    c.storage_generation        = 0;
    c.secret_storage_generation = 0;
    c.local_parameter_length    = 0;
    c.initialized               = false;
    c.released                  = true;
    ret true;
}

# the single source of truth for what this connection will enforce. the stream
# manager configuration below and the encoded parameters are two renderings of
# it, which is what makes the core's equality checks hold by construction
fun stream_configuration(config: *Config,
    role: transport_api.Role) stream_api.Config {
    var value: stream_api.Config;
    value.source = config.source;
    value.role   = stream_api.ROLE_CLIENT;
    if (role == transport_api.SERVER) { value.role = stream_api.ROLE_SERVER; }
    value.local_bidirectional_limit         = 0;
    value.local_unidirectional_limit        = 0;
    value.peer_bidirectional_limit          = config.peer_bidirectional_streams;
    value.peer_unidirectional_limit         = config.peer_unidirectional_streams;
    value.send_max_data                     = 0;
    value.receive_max_data                  = config.receive_max_data;
    value.send_local_bidirectional_limit    = 0;
    value.send_peer_bidirectional_limit     = 0;
    value.send_unidirectional_limit         = 0;
    value.receive_local_bidirectional_limit = config.receive_stream_data;
    value.receive_peer_bidirectional_limit  = config.receive_stream_data;
    value.receive_unidirectional_limit      = config.receive_stream_data;
    ret value;
}

fun local_parameters(config: *Config,
    role: transport_api.Role) transport_parameters.Parameters {
    var value: transport_parameters.Parameters = transport_parameters.defaults();
    value.max_idle_timeout                    = clock.span(config.max_idle_timeout) / 1000000;
    value.max_udp_payload_size                = config.max_udp_payload::u64;
    value.initial_max_data                    = config.receive_max_data;
    value.initial_max_stream_data_bidi_local  = config.receive_stream_data;
    value.initial_max_stream_data_bidi_remote = config.receive_stream_data;
    value.initial_max_stream_data_uni         = config.receive_stream_data;
    value.initial_max_streams_bidi            = config.peer_bidirectional_streams;
    value.initial_max_streams_uni             = config.peer_unidirectional_streams;
    value.active_connection_id_limit          = config.active_connection_id_limit;
    value.max_datagram_frame_size             = config.max_datagram_frame_size::u64;
    value.initial_source_connection_id        = connection_id(config.local_source,
        config.local_source_length);
    var id: u64 = transport_parameters.MAX_IDLE_TIMEOUT;
    for (id <= transport_parameters.MAX_ACK_DELAY) {
        if (id != transport_parameters.STATELESS_RESET_TOKEN &&
            id != transport_parameters.DISABLE_ACTIVE_MIGRATION) {
            transport_parameters.set_present(?value, id);
        }
        id = id + 1;
    }
    transport_parameters.set_present(?value,
        transport_parameters.ACTIVE_CONNECTION_ID_LIMIT);
    transport_parameters.set_present(?value,
        transport_parameters.INITIAL_SOURCE_CONNECTION_ID);
    if (config.max_datagram_frame_size != 0) {
        transport_parameters.set_present(?value,
            transport_parameters.MAX_DATAGRAM_FRAME_SIZE);
    }
    if (role == transport_api.SERVER) {
        value.original_destination_connection_id = connection_id(
            config.original_destination, config.original_destination_length);
        transport_parameters.set_present(?value,
            transport_parameters.ORIGINAL_DESTINATION_CONNECTION_ID);
        if (config.retry_source_present) {
            value.retry_source_connection_id = connection_id(
                config.retry_source, config.retry_source_length);
            transport_parameters.set_present(?value,
                transport_parameters.RETRY_SOURCE_CONNECTION_ID);
        }
    }
    ret value;
}

# the consumer needs these bytes before the connection exists, because its TLS
# engine carries them as the quic_transport_parameters extension. re-deriving
# them inside init from the same config is what keeps the two copies identical
pub fun encode_parameters(config: *Config, role: transport_api.Role,
    output: *u8,
    capacity: usize) transport_parameters.EncodeResult {
    var failed: transport_parameters.EncodeResult;
    if (!config_valid(config, role) || output == nil || capacity == 0) {
        ret failed;
    }
    var builder:    binary.Builder                  = binary.builder(output, capacity, binary.BIG);
    var parameters: transport_parameters.Parameters = local_parameters(config,
        role);
    ret transport_parameters.encode(?builder, ?parameters,
        parameter_role(role), transport_parameters.default_limits());
}

fun crypto_storage(c: *Connection) handshake_api.Storage {
    ret handshake_api.Storage{attempts: ?c.storage.crypto_attempts[0],
        attempt_capacity: 8, chunks: ?c.provider, account: ?c.account};
}

fun crypto_config(config: *Config) handshake_api.Config {
    ret handshake_api.Config{source: config.source, max_crypto_per_level: CRYPTO_PER_LEVEL,
        max_event_data: 4096, max_peer_identity: 4096};
}

# the handshake deadline as the adapters take it, 0 for none
fun tls_deadline_ns(config: *Config) u64 {
    if (sel config.tls_deadline.some) { ret clock.nanos(config.tls_deadline.some); }
    ret 0;
}

fun tls_configuration(config: *Config) tls_client_api.Config {
    ret tls_client_api.Config{
        verification_time_unix:      config.verification_time_unix,
        deadline_ns:                 tls_deadline_ns(config),
        entropy_context_size:        config.entropy_context_size,
        entropy_secret_context_size: config.entropy_secret_context_size
    };
}

fun server_tls_configuration(config: *Config) tls_server_api.Config {
    ret tls_server_api.Config{
        verification_time_unix:      config.verification_time_unix,
        deadline_ns:                 tls_deadline_ns(config),
        entropy_context_size:        config.entropy_context_size,
        entropy_secret_context_size: config.entropy_secret_context_size
    };
}

fun core_storage(c: *Connection) core_api.Storage {
    ret public_core_storage(c);
}

fun secret_storage(c: *Connection) core_api.SecretStorage {
    ret private_core_storage(c.secret_storage);
}

fun datagram_storage(c: *Connection) datagram_api.Storage {
    ret public_datagram_storage(c.storage);
}

fun scope_provider_disjoint(c: *Connection, scope: *cancel.Scope) bool {
    val scope_range: ownership.Range = ownership.record[cancel.Scope](scope);
    var ranges:      [handshake_api.PROVIDER_RANGE_CAPACITY]ownership.Range;
    if (!scope_range.valid || !handshake_api.provider_ranges(?c.handshake,
        ?ranges[0], handshake_api.PROVIDER_RANGE_CAPACITY)) { ret false; }
    var i: usize = 0;
    for (i < handshake_api.PROVIDER_RANGE_CAPACITY) {
        if (!ownership.disjoint(scope_range, ranges[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun core_configuration(c: *Connection, config: *Config,
    role: transport_api.Role) core_api.Config {
    var value: core_api.Config;
    value.source                  = config.source;
    value.role                    = role;
    value.version                 = config.version;
    value.supported_versions      = ?c.storage.supported_versions[0];
    value.supported_version_count = 2;
    value.local                   = config.local;
    value.peer                    = config.peer;
    value.original_destination    = connection_id(config.original_destination,
        config.original_destination_length);
    value.initial_secret_destination = value.original_destination;
    if (role == transport_api.SERVER) {
        value.initial_secret_destination = connection_id(
            config.initial_destination, config.initial_destination_length);
        value.retry_source = connection_id(config.retry_source,
            config.retry_source_length);
    }
    value.local_source = connection_id(config.local_source,
        config.local_source_length);
    value.peer_destination = connection_id(config.peer_destination,
        config.peer_destination_length);
    value.alpn        = core_api.View{data: config.alpn, length: config.alpn_length};
    value.server_name = core_api.View{data: config.server_name,
        length: config.server_name_length};
    value.local_transport_parameters = core_api.View{
        data: local_parameter_bytes(c), length: c.local_parameter_length
    };
    value.max_udp_payload      = config.max_udp_payload;
    value.max_idle_timeout_ns  = clock.span(config.max_idle_timeout) / 1000000 * 1000000;
    value.drain_timeout_ns     = clock.span(config.drain_timeout);
    value.peer_validated       = config.peer_validated;
    value.retry_source_present = config.retry_source_present;
    value.enable_early_data    = config.enable_early_data;
    ret value;
}

# every manager except the handshake adapter, which the caller's TLS engine
# decides the shape of
fun build_managers(c: *Connection, config: *Config,
    role: transport_api.Role) Stage {
    c.storage.supported_versions[0] = packet.VERSION_1;
    c.storage.supported_versions[1] = packet.VERSION_2;
    val local_id: packet.ConnectionId = connection_id(config.local_source,
        config.local_source_length);
    val peer_id: packet.ConnectionId = connection_id(config.peer_destination,
        config.peer_destination_length);
    if (!stream_api.initialize(?c.streams, stream_configuration(config, role),
        public_stream_storage(c))) {
        ret STAGE_STREAMS;
    }
    if (!cid_api.initialize(?c.cids, cid_api.Config{source: config.source,
        local_active_limit: config.active_connection_id_limit::usize,
        peer_active_limit:  config.active_connection_id_limit::usize},
        public_cid_storage(c.storage), local_id, peer_id)) {
        ret STAGE_CONNECTION_IDS;
    }
    var path_role: u8 = path_api.ROLE_CLIENT;
    if (role == transport_api.SERVER) { path_role = path_api.ROLE_SERVER; }
    var path_config: path_api.Config = path_api.default_config(config.source,
        path_role, config.peer_validated);
    # the send ceiling is the send storage; max_udp_payload bounds receipt only
    path_config.maximum_mtu = MAX_UDP_PAYLOAD::u16;
    if (!path_api.initialize(?c.paths, path_config,
        public_path_storage(c.storage),
        path_api.Endpoint{local: path_address(config.local),
        peer: path_address(config.peer)})) {
        ret STAGE_PATHS;
    }
    val datagram_config: datagram_api.Config = datagram_api.Config{
        source:               config.source, peer_max_frame_size: 0,
        local_max_frame_size: config.max_datagram_frame_size,
        enabled:              config.max_datagram_frame_size != 0
    };
    var storage: datagram_api.Storage = datagram_api.empty_storage();
    if (datagram_config.enabled) { storage = datagram_storage(c); }
    if (!datagram_api.initialize(?c.datagrams, datagram_config, storage)) {
        ret STAGE_DATAGRAMS;
    }
    ret STAGE_OK;
}

fun finish(c: *Connection, config: *Config, role: transport_api.Role,
    scope: *cancel.Scope, now: time.Instant) InitResult {
    if (!scope_provider_disjoint(c, scope)) { ret staged(STAGE_STORAGE); }
    val encoded: transport_parameters.EncodeResult = encode_parameters(config,
        role, local_parameter_bytes(c), PARAMETER_CAPACITY);
    if (!encoded.ok) { ret staged(STAGE_PARAMETERS); }
    c.local_parameter_length = encoded.count;
    var value: InitResult;
    if (role == transport_api.CLIENT) {
        value.core = core_api.init_client_result(?c.core, ?c.secrets,
            core_configuration(c, config, role), core_storage(c),
            secret_storage(c), ?c.handshake, ?c.cids, ?c.paths, ?c.streams,
            ?c.datagrams, clock.nanos(now));
    }
    or {
        value.core = core_api.init_server_result(?c.core, ?c.secrets,
            core_configuration(c, config, role), core_storage(c),
            secret_storage(c), ?c.handshake, ?c.cids, ?c.paths, ?c.streams,
            ?c.datagrams, clock.nanos(now));
    }
    if (!value.core.ok) {
        value.stage = STAGE_CORE;
        ret value;
    }
    if (!binding_api.bind(?c.binding, ?c.core, ?c.secrets) ||
        !binding_api.prepare_initial_route(?c.binding, config.local_source,
        config.local_source_length) ||
        !binding_api.publish_initial_route(?c.binding)) {
        value.stage = STAGE_BINDING;
        ret value;
    }
    val driver_config: transport_api.Config = transport_api.Config{
        source:           config.source, max_udp_payload: config.max_udp_payload,
        max_close_reason: 256
    };
    val driver_storage: transport_api.Storage = transport_api.Storage{
        sends: ?c.storage.sends[0], send_capacity: SEND_CAPACITY
    };
    var started: bool = false;
    if (role == transport_api.CLIENT) {
        started = transport_api.init_client[binding_api.Binding](?c.driver,
            driver_config, binding_api.protocol(?c.binding), ?c.streams,
            ?c.datagrams, scope, driver_storage);
    }
    or {
        started = transport_api.init_server[binding_api.Binding](?c.driver,
            driver_config, binding_api.protocol(?c.binding), ?c.streams,
            ?c.datagrams, scope, driver_storage);
    }
    if (!started) {
        value.stage = STAGE_DRIVER;
        ret value;
    }
    c.initialized = true;
    c.released    = false;
    value.ok      = true;
    value.stage   = STAGE_OK;
    ret value;
}

fun abandon_manager_initialization(c: *Connection) bool {
    if (!backing_lease_valid(c) || c.driver.initialized || c.initialized) {
        ret false;
    }
    if (c.binding.initialized &&
        !binding_api.abandon_initialization(?c.binding)) { ret false; }
    if (c.core.initialized &&
        !core_api.abandon_initialization(?c.core, ?c.secrets)) { ret false; }
    if (c.handshake.initialized &&
        !handshake_api.abandon_initialization(?c.handshake)) { ret false; }
    if (c.datagrams.valid) {
        if (!c.datagrams.closing &&
            datagram_api.begin_close(?c.datagrams).status !=
            transport_api.STATUS_OK) { ret false; }
        if (datagram_api.finish_close(?c.datagrams).status !=
            transport_api.STATUS_OK) { ret false; }
    }
    if (c.paths.valid) {
        if (!c.paths.closing && path_api.begin_close(?c.paths).status !=
            path_api.STATUS_OK) { ret false; }
        if (path_api.finish_close(?c.paths).status != path_api.STATUS_OK) {
            ret false;
        }
    }
    if (c.cids.initialized) {
        if (!c.cids.closing && !cid_api.begin_close(?c.cids)) { ret false; }
        if (!cid_api.finish_close(?c.cids))                   { ret false; }
    }
    if (c.streams.valid) {
        if (!c.streams.closing && stream_api.begin_close(?c.streams).status !=
            stream_api.STATUS_OK) { ret false; }
        if (stream_api.finish_close(?c.streams).status !=
            stream_api.STATUS_OK) { ret false; }
    }
    ret release_backing(c);
}

fun failed(c: *Connection, value: InitResult) InitResult {
    var result: InitResult = value;
    if (c != nil && !abandon_manager_initialization(c)) {
        result.cleanup_retained = true;
    }
    ret result;
}

pub fun routing_snapshot(c: *Connection) RoutingSnapshot {
    var value: RoutingSnapshot;
    if (c == nil || !c.initialized) { ret value; }
    val internal: binding_api.RoutingSnapshot =
        binding_api.routing_snapshot(?c.binding);
    value.source      = internal.source;
    value.capacity    = internal.capacity;
    value.active      = internal.active;
    value.initialized = internal.initialized;
    ret value;
}

pub fun route_at(c: *Connection, index: usize) Route {
    var value: Route;
    if (c == nil || !c.initialized) { ret value; }
    val internal: binding_api.Route = binding_api.route_at(?c.binding, index);
    value.source     = internal.source;
    value.index      = internal.index;
    value.generation = internal.generation;
    value.sequence   = internal.sequence;
    value.id.data    = internal.id.data;
    value.id.length  = internal.id.length;
    value.active     = internal.active;
    ret value;
}

pub fun route_valid(c: *Connection, route: *Route) bool {
    if (c == nil || !c.initialized || route == nil) { ret false; }
    var internal: binding_api.Route;
    internal.source     = route.source;
    internal.index      = route.index;
    internal.generation = route.generation;
    internal.sequence   = route.sequence;
    internal.id.data    = route.id.data;
    internal.id.length  = route.id.length;
    internal.active     = route.active;
    ret binding_api.route_valid(?c.binding, ?internal);
}

fun release_ready(c: *Connection) bool {
    ret c != nil && c.initialized && backing_lease_valid(c) &&
        c.driver.protocol.context == ?c.binding &&
        c.binding.core == ?c.core && c.binding.secrets == ?c.secrets &&
        c.core.cids == ?c.cids && c.core.paths == ?c.paths &&
        c.core.streams == ?c.streams && c.core.datagrams == ?c.datagrams &&
        c.secrets.handshake == ?c.handshake &&
        transport_api.release_ready[binding_api.Binding](?c.driver) &&
        binding_api.release_ready(?c.binding);
}

# release is serialized by the connection owner. refusal leaves the complete
# assembly intact. success is idempotent and preserves token generations while
# removing every live protocol and caller-borrowed reference
pub fun release_closed(c: *Connection) bool {
    if (c == nil) { ret false; }
    if (!c.initialized) {
        if (c.storage != nil || c.secret_storage != nil) {
            ret abandon_manager_initialization(c);
        }
        ret c.released;
    }
    if (!release_ready(c)) { ret false; }
    if (transport_api.release_closed[binding_api.Binding](?c.driver).status !=
        transport_api.STATUS_OK) { ret false; }
    if (!binding_api.release_closed(?c.binding)) { ret false; }
    c.core.config.supported_versions                = nil;
    c.core.config.alpn.data                         = nil;
    c.core.config.alpn.length                       = 0;
    c.core.config.server_name.data                  = nil;
    c.core.config.server_name.length                = 0;
    c.core.config.local_transport_parameters.data   = nil;
    c.core.config.local_transport_parameters.length = 0;
    c.core.initialized                              = false;
    c.core.destroyed                                = false;
    c.secrets.initialized                           = false;
    c.secrets.destroyed                             = false;
    val event_generation: u64 = c.handshake.event_generation;
    var empty_handshake:  handshake_api.Adapter;
    empty_handshake.event_generation = event_generation;
    c.handshake                      = empty_handshake;
    ret release_backing(c);
}

pub fun reusable(c: *Connection) bool {
    ret c != nil && !c.initialized && c.released &&
        c.storage == nil && c.secret_storage == nil &&
        !c.driver.initialized && !c.binding.initialized &&
        !c.core.initialized && !c.secrets.initialized &&
        !c.handshake.initialized && !c.cids.initialized &&
        !c.paths.valid && !c.streams.valid && !c.datagrams.valid;
}

pub fun init_client(c: *Connection, config: *Config, storage: *Storage,
    secret_storage: *SecretStorage, chunks: buffers.Source, tls: *client.Client,
    scope: *cancel.Scope, now: time.Instant) InitResult {
    if (!connection_range(c).valid ||
        !ownership.record[Config](config).valid ||
        !ownership.record[cancel.Scope](scope).valid) {
        ret staged(STAGE_CONFIG);
    }
    if (c.initialized) { ret staged(STAGE_CONFIG); }
    if (c.storage != nil || c.secret_storage != nil) {
        var retained: InitResult = staged(STAGE_STORAGE);
        retained.cleanup_retained = true;
        ret retained;
    }
    if (tls == nil || !config_valid(config, transport_api.CLIENT)) {
        ret staged(STAGE_CONFIG);
    }
    if (!ownership.record[Storage](storage).valid ||
        !secret_storage_range(secret_storage).valid ||
        !acquire_backing(c, config, storage, secret_storage, chunks, scope)) {
        ret staged(STAGE_STORAGE);
    }
    val built: Stage = build_managers(c, config, transport_api.CLIENT);
    if (built != STAGE_OK) { ret failed(c, staged(built)); }
    if (!tls_client_api.initialize(?c.handshake, crypto_config(config),
        crypto_storage(c), tls, tls_configuration(config))) {
        ret failed(c, staged(STAGE_HANDSHAKE));
    }
    val result: InitResult = finish(c, config, transport_api.CLIENT,
        scope, now);
    if (!result.ok) { ret failed(c, result); }
    ret result;
}

pub fun init_server(c: *Connection, config: *Config, storage: *Storage,
    secret_storage: *SecretStorage, chunks: buffers.Source, tls: *server.Server,
    scope: *cancel.Scope, now: time.Instant) InitResult {
    if (!connection_range(c).valid ||
        !ownership.record[Config](config).valid ||
        !ownership.record[cancel.Scope](scope).valid) {
        ret staged(STAGE_CONFIG);
    }
    if (c.initialized) { ret staged(STAGE_CONFIG); }
    if (c.storage != nil || c.secret_storage != nil) {
        var retained: InitResult = staged(STAGE_STORAGE);
        retained.cleanup_retained = true;
        ret retained;
    }
    if (tls == nil || !config_valid(config, transport_api.SERVER)) {
        ret staged(STAGE_CONFIG);
    }
    if (!ownership.record[Storage](storage).valid ||
        !secret_storage_range(secret_storage).valid ||
        !acquire_backing(c, config, storage, secret_storage, chunks, scope)) {
        ret staged(STAGE_STORAGE);
    }
    val built: Stage = build_managers(c, config, transport_api.SERVER);
    if (built != STAGE_OK) { ret failed(c, staged(built)); }
    if (!tls_server_api.initialize(?c.handshake, crypto_config(config),
        crypto_storage(c), tls, server_tls_configuration(config))) {
        ret failed(c, staged(STAGE_HANDSHAKE));
    }
    val result: InitResult = finish(c, config, transport_api.SERVER,
        scope, now);
    if (!result.ok) { ret failed(c, result); }
    ret result;
}

test "quic.connection.assembly: the handshake block fits one pool chunk" {
    if (HANDSHAKE_BLOCK_END > supply.BYTES ||
        LOCAL_EXTENSIONS_AT % $align_of(transport_parameters.Parameter) != 0) { ret 1; }
    ret 0;
}

test "quic.connection.assembly: production profile encodes bounded H3 limits" {
    var id:       [8]u8  = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var protocol: [2]u8  = [2]u8{'h', '3'};
    var name:     [1]u8  = [1]u8{'x'};
    var config:   Config = default_config(991,
        ip.endpoint(192, 0, 2, 1, 4433),
        ip.endpoint(192, 0, 2, 2, 4433));
    config.local_source                = ?id[0];
    config.local_source_length         = 8;
    config.peer_destination            = ?id[0];
    config.peer_destination_length     = 8;
    config.original_destination        = ?id[0];
    config.original_destination_length = 8;
    config.alpn                        = ?protocol[0];
    config.alpn_length                 = 2;
    config.server_name                 = ?name[0];
    config.server_name_length          = 1;
    var encoded: [512]u8;
    val result:  transport_parameters.EncodeResult = encode_parameters(?config,
        transport_api.CLIENT, ?encoded[0], 512);
    var parameters: transport_parameters.Parameters;
    var storage:    transport_parameters.Storage;
    if (!result.ok || transport_parameters.decode(?encoded[0], result.count,
        true, transport_parameters.ROLE_CLIENT,
        transport_parameters.default_limits(), storage,
        ?parameters).status != transport_parameters.STATUS_DONE ||
        parameters.initial_max_streams_bidi != H3_REQUEST_STREAMS::u64 ||
        parameters.initial_max_streams_uni !=
        H3_CRITICAL_STREAMS_PER_PEER::u64 ||
        parameters.initial_max_data != STREAM_WINDOW::u64 ||
        parameters.initial_max_stream_data_bidi_local != STREAM_STRIDE::u64 ||
        parameters.initial_max_stream_data_bidi_remote != STREAM_STRIDE::u64 ||
        parameters.initial_max_stream_data_uni != STREAM_STRIDE::u64) { ret 1; }
    config.peer_bidirectional_streams  = 10;
    config.peer_unidirectional_streams = 3;
    if (!encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 2; }
    config.peer_bidirectional_streams = 11;
    if (encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 3; }
    config.peer_bidirectional_streams  = H3_REQUEST_STREAMS::u64;
    config.peer_unidirectional_streams =
        H3_CRITICAL_STREAMS_PER_PEER::u64;
    config.receive_max_data = STREAM_WINDOW::u64 + 1;
    if (encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 4; }
    config.receive_max_data    = STREAM_WINDOW::u64;
    config.receive_stream_data = STREAM_STRIDE::u64 + 1;
    if (encode_parameters(?config, transport_api.CLIENT,
        ?encoded[0], 512).ok) { ret 5; }
    ret 0;
}

test "quic.connection.assembly: server acceptance preserves three Retry identities" {
    var local_id:    [8]u8  = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var original_id: [8]u8  = [8]u8{21, 22, 23, 24, 25, 26, 27, 28};
    var retry_id:    [8]u8  = [8]u8{41, 42, 43, 44, 45, 46, 47, 48};
    var peer_id:     [8]u8  = [8]u8{61, 62, 63, 64, 65, 66, 67, 68};
    var protocol:    [2]u8  = [2]u8{'h', '3'};
    var config:      Config = default_config(992,
        ip.endpoint(192, 0, 2, 2, 4433),
        ip.endpoint(192, 0, 2, 1, 55000));
    config.local_source        = ?local_id[0];
    config.local_source_length = 8;
    config.alpn                = ?protocol[0];
    config.alpn_length         = 2;
    var accepted: listener_api.Accepted;
    accepted.action               = listener_api.ACTION_ACCEPT;
    accepted.original_destination = connection_id(?original_id[0], 8);
    accepted.initial_destination  = connection_id(?retry_id[0], 8);
    accepted.initial_source       = connection_id(?peer_id[0], 8);
    accepted.retry_source         = accepted.initial_destination;
    accepted.retry_source_present = true;
    accepted.peer_validated       = true;
    accepted.peer                 = config.peer;
    accepted.version              = packet.VERSION_1;
    if (!apply_server_acceptance(?config, ?accepted) ||
        !config_valid(?config, transport_api.SERVER)) { ret 1; }
    var initial: packet.ConnectionId = connection_id(config.initial_destination,
        config.initial_destination_length);
    var original: packet.ConnectionId = connection_id(config.original_destination,
        config.original_destination_length);
    var retry: packet.ConnectionId = connection_id(config.retry_source,
        config.retry_source_length);
    val parameters: transport_parameters.Parameters = local_parameters(?config,
        transport_api.SERVER);
    if (!packet.connection_id_equal(?initial, ?accepted.initial_destination) ||
        !packet.connection_id_equal(?original,
        ?accepted.original_destination) ||
        !packet.connection_id_equal(?retry, ?accepted.retry_source) ||
        packet.connection_id_equal(?initial, ?original) ||
        !transport_parameters.has(?parameters,
        transport_parameters.RETRY_SOURCE_CONNECTION_ID) ||
        !packet.connection_id_equal(?parameters.original_destination_connection_id,
        ?accepted.original_destination) ||
        !packet.connection_id_equal(?parameters.retry_source_connection_id,
        ?accepted.retry_source)) { ret 2; }
    var malformed: listener_api.Accepted = accepted;
    malformed.initial_destination.data[0] =
        malformed.initial_destination.data[0] ^ 1;
    var untouched: Config = default_config(993, config.local, config.peer);
    untouched.local_source        = ?local_id[0];
    untouched.local_source_length = 8;
    untouched.alpn                = ?protocol[0];
    untouched.alpn_length         = 2;
    if (apply_server_acceptance(?untouched, ?malformed) ||
        untouched.server_acceptance_applied) { ret 3; }
    malformed                      = accepted;
    malformed.retry_source.data[0] = malformed.retry_source.data[0] ^ 1;
    if (apply_server_acceptance(?untouched, ?malformed) ||
        untouched.server_acceptance_applied) { ret 4; }
    malformed                          = accepted;
    malformed.original_destination.len = 0;
    if (apply_server_acceptance(?untouched, ?malformed) ||
        untouched.server_acceptance_applied) { ret 5; }
    var addressed: listener_api.Accepted = accepted;
    addressed.initial_destination  = addressed.original_destination;
    addressed.retry_source         = connection_id(nil, 0);
    addressed.retry_source_present = false;
    if (!apply_server_acceptance(?untouched, ?addressed) ||
        untouched.retry_source_present || !untouched.peer_validated ||
        !config_valid(?untouched, transport_api.SERVER)) { ret 6; }
    ret 0;
}
