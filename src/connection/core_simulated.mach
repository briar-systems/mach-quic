    ret 0;
}

test "quic.connection.core: public descriptors reject wrapping maximum ranges" {
    var fixture: Fixture;
    if (!initialize(?fixture, transport.CLIENT, true, 1)) { ret 1; }
    val maximum: usize = 0 - 1::usize;
    if (core.snapshot(maximum::*core.Core).state != 0) { ret 2; }
