    if (initialize_with_fault(?send, transport.CLIENT, true, 1,
            FAULT_SEND_KEYS) ||
        send.init_result.reason != core.INIT_STORAGE_SECRETS ||
        send.engine.initialized || send.secrets.initialized) { ret 2; }
    ret 0;
}

test "quic.connection.core: failed provider start rolls back every manager lease" {
    var fixture: Fixture;
    if (initialize_with_fault(?fixture, transport.CLIENT, true, 1,
            FAULT_PROVIDER_START) ||
        fixture.engine.initialized || fixture.secrets.initialized ||
        fixture.adapter.started || !fixture.adapter.closing ||
        fixture.adapter.core_lease != 0 || fixture.cids.core_lease != 0 ||
        fixture.paths.core_lease != 0 || fixture.streams.core_lease != 0 ||
        fixture.datagrams.core_lease != 0 ||
        fixture.path_values[0].transport_valid || fixture.init_result.ok ||
        fixture.init_result.error != core.INTERNAL_ERROR ||
        fixture.init_result.reason != core.INIT_PROVIDER_START ||
        fixture.init_result.provider_error != 0x7711) { ret 1; }
    ret 0;
}

test "quic.connection.core: active manager leases reject unscoped protocol mutation" {
    var fixture: Fixture;
    if (!initialize(?fixture, transport.CLIENT, true, 1)) { ret 1; }
    if (handshake.poll(?fixture.adapter, 1).status != handshake.STATUS_ERROR ||
        path.on_timeout(?fixture.paths, 1).status != path.STATUS_ERROR ||
        stream.prepare_control(?fixture.streams).status != stream.STATUS_ERROR ||
        datagram.prepare(?fixture.datagrams, true).error !=
            datagram.ERROR_STATE ||
        fixture.adapter.core_lease != fixture.engine.config.source ||
        fixture.paths.core_lease != fixture.engine.config.source ||
        fixture.streams.core_lease != fixture.engine.config.source ||
        fixture.datagrams.core_lease != fixture.engine.config.source) { ret 2; }
    ret 0;
}

test "quic.connection.core: public path operations retain the core lease" {
    var fixture: Fixture;
    if (!initialize(?fixture, transport.CLIENT, true, 1) ||
        path.confirm_handshake_scoped(?fixture.paths,
            fixture.engine.config.source).status != path.STATUS_OK) { ret 1; }
    var candidate: path.Endpoint = path_endpoint(fixture.engine.config.local,
        fixture.engine.config.peer);
    candidate.peer.port = candidate.peer.port + 1;
    val probed: path.PathResult = core.probe_path(?fixture.engine, candidate,
        true);
    var challenge: [8]u8 = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    if (probed.status != path.STATUS_OK) { ret 2; }
    if (core.queue_path_challenge(?fixture.engine, probed.handle, challenge,
        false, path.VALIDATION_PATH).status != path.STATUS_OK) { ret 4; }
    if (path.validate_address_scoped(?fixture.paths, fixture.engine.config.source,
        probed.handle).status != path.STATUS_OK) { ret 5; }
    val migrated: path.Observation = core.migrate_path(?fixture.engine,
        probed.handle, true, 2);
    val selected: path.PathResult = path.selected(?fixture.paths);
    val mtu: path.MtuResult = core.on_path_packet_too_big(?fixture.engine,
        probed.handle, 1200, true, 3);
    if (migrated.status != path.STATUS_OK ||
        selected.status != path.STATUS_OK ||
        selected.handle.index != probed.handle.index ||
        selected.handle.generation != probed.handle.generation ||
        mtu.status != path.STATUS_OK || fixture.paths.core_lease !=
            fixture.engine.config.source) { ret 3; }
    ret 0;
}

# a terminal TLS alert becomes CONNECTION_CLOSE carrying that exact alert in
# the low byte of CRYPTO_ERROR, so the peer learns why rather than only that
# something went wrong. two alerts are checked against their own exact codes:
# a mapping that collapsed onto a constant would satisfy at most one of them
fun deliver_alert(fixture: *Fixture, alert: u64) i64 {
    if (core.poll_handshake(?fixture.engine, ?fixture.secrets, 2).status !=
        transport.STATUS_OK) { ret 1; }
    if (!fixture.provider.emitted || fixture.engine.close_error != 0) { ret 2; }
    fixture.provider.emit_alert = alert;
    if (core.poll_handshake(?fixture.engine, ?fixture.secrets, 3).status !=
        transport.STATUS_OK) { ret 3; }
    if (!fixture.provider.alert_emitted) { ret 4; }
    ret 0;
}

test "quic.connection.core: handshake_failure reaches CONNECTION_CLOSE unflattened" {
    var fixture: Fixture;
    if (!initialize(?fixture, transport.CLIENT, true, 1)) { ret 1; }
    val delivered: i64 = deliver_alert(?fixture, 0x28);
    if (delivered != 0) { ret 10 + delivered::i32; }
    if (fixture.engine.close_error != core.CRYPTO_ERROR_BASE + 0x28) { ret 2; }
    ret 0;
}

test "quic.connection.core: bad_certificate reaches CONNECTION_CLOSE unflattened" {
    var fixture: Fixture;
    if (!initialize(?fixture, transport.CLIENT, true, 1)) { ret 1; }
    val delivered: i64 = deliver_alert(?fixture, 0x2a);
    if (delivered != 0) { ret 10 + delivered::i32; }
    if (fixture.engine.close_error != core.CRYPTO_ERROR_BASE + 0x2a) { ret 2; }
    ret 0;
}

# leaves a frame full of non-zero words for the next call to reuse, so a field
# an incomplete literal never named shows up as residue rather than zero
fun dirty_frame(seed: u64) u64 {
    var scratch: [128]u64;
    var i: usize = 0;
    for (i < 128) { scratch[i] = seed + i::u64 + 1; i = i + 1; }
    var total: u64 = 0;
    i = 0;
    for (i < 128) { total = total + scratch[i]; i = i + 1; }
    ret total;
}

test "quic.connection.core: a refusal reports every field it did not set" {
    var fixture: Fixture;
    var payload: [16]u8;
    var input: transport.Datagram = transport.Datagram{
        local: endpoint(1, 4433), peer: endpoint(2, 55000),
        data: ?payload[0], length: 16, received_at_ns: 1, ecn: 0};
    if (dirty_frame(0x5151515151515151) == 0) { ret 1; }
    # the engine was never initialized, so every operation takes its guard
    val received: transport.CoreResult = core.receive(?fixture.engine,
        ?fixture.secrets, ?input);
    if (received.status != transport.STATUS_ERROR ||
        received.error != core.INTERNAL_ERROR ||
        received.state != transport.DRAINING ||
        received.provider_error != 0) { ret 2; }
    if (dirty_frame(0x6262626262626262) == 0) { ret 3; }
    val timed_out: transport.CoreResult = core.on_timeout(?fixture.engine,
        ?fixture.secrets, 1, 1);
    if (timed_out.status != transport.STATUS_ERROR ||
        timed_out.provider_error != 0) { ret 4; }
    if (dirty_frame(0x7373737373737373) == 0) { ret 5; }
    val closed: transport.CoreResult = core.begin_close(?fixture.engine,
        ?fixture.secrets, false, 0, nil, 0, 1);
    if (closed.status != transport.STATUS_ERROR ||
        closed.provider_error != 0) { ret 6; }
    ret 0;
}
