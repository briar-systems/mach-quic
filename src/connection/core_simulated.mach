            maximum::*u8, 2, 2).status != transport.STATUS_ERROR ||
        core.snapshot(?fixture.engine).active_owners != 0) { ret 4; }
    ret 0;
}

test "quic.connection.core: initialization rejects cross-component ownership overlap" {
    var fixture: Fixture;
    if (initialize_with_fault(?fixture, transport.CLIENT, true, 1,
            FAULT_COMPONENT_OVERLAP) ||
        fixture.engine.initialized || fixture.secrets.initialized ||
        fixture.adapter.started || fixture.adapter.core_lease != 0 ||
        fixture.cids.core_lease != 0 || fixture.paths.core_lease != 0 ||
        fixture.streams.core_lease != 0 || fixture.datagrams.core_lease != 0 ||
        fixture.path_values[0].transport_valid) { ret 1; }
    # the stream send buffer was pointed at the receive header, so the refusal
    # has to name that pair and not merely report a failure
    if (fixture.init_result.reason != core.INIT_COMPONENT_RANGES ||
        fixture.init_result.reason_kind != ownership.OVERLAP_PAIR ||
        fixture.init_result.reason_first != 2 ||
        fixture.init_result.reason_second != 43) { ret 2; }
    ret 0;
}

test "quic.connection.core: a refused initialization names the check that rejected" {
    var capacity: Fixture;
    if (initialize_with_fault(?capacity, transport.CLIENT, true, 1,
            FAULT_STORAGE_CAPACITY) ||
        capacity.init_result.error != core.INTERNAL_ERROR ||
        capacity.init_result.reason != core.INIT_STORAGE_CAPACITY) { ret 1; }
    # close_reason was aliased onto the receive header, ranges 5 and 2
    var owned: Fixture;
    if (initialize_with_fault(?owned, transport.CLIENT, true, 1,
            FAULT_STORAGE_OVERLAP) ||
        owned.init_result.reason != core.INIT_STORAGE_RANGES ||
        owned.init_result.reason_kind != ownership.OVERLAP_PAIR ||
        owned.init_result.reason_first != 2 ||
        owned.init_result.reason_second != 5) { ret 2; }
    # the borrowed ALPN was pointed into the send plaintext buffer, range 4
    var lent: Fixture;
    if (initialize_with_fault(?lent, transport.CLIENT, true, 1,
            FAULT_STORAGE_BORROWED) ||
        lent.init_result.reason != core.INIT_STORAGE_BORROWED ||
        lent.init_result.reason_kind != ownership.OVERLAP_PAIR ||
        lent.init_result.reason_first != 0 ||
        lent.init_result.reason_second != 4) { ret 3; }
    # the same borrowed range aimed at a component buffer, stream sends
    var component_lent: Fixture;
    if (initialize_with_fault(?component_lent, transport.CLIENT, true, 1,
            FAULT_COMPONENT_BORROWED) ||
        component_lent.init_result.reason != core.INIT_COMPONENT_BORROWED ||
        component_lent.init_result.reason_kind != ownership.OVERLAP_PAIR ||
        component_lent.init_result.reason_first != 0 ||
        component_lent.init_result.reason_second != 43) { ret 4; }
    var secrets: Fixture;
    if (initialize_with_fault(?secrets, transport.CLIENT, true, 1,
            FAULT_PROVIDER_SECRETS) ||
        secrets.init_result.reason != core.INIT_PROVIDER_SECRETS) { ret 5; }
    var clean: Fixture;
    if (!initialize(?clean, transport.CLIENT, true, 1) ||
        clean.init_result.reason != core.INIT_OK ||
        clean.init_result.reason_kind != ownership.OVERLAP_NONE ||
        clean.init_result.reason_first != 0 ||
        clean.init_result.reason_second != 0) { ret 6; }
    ret 0;
}

test "quic.connection.core: external plaintext cannot alias welded keys" {
    var receive: Fixture;
    if (initialize_with_fault(?receive, transport.CLIENT, true, 1,
            FAULT_RECEIVE_KEYS) ||
        receive.init_result.reason != core.INIT_STORAGE_SECRETS ||
        receive.engine.initialized || receive.secrets.initialized) { ret 1; }
