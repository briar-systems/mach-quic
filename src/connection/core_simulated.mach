    var input: transport.Datagram = transport.Datagram{
        local: fixture.engine.config.local, peer: fixture.engine.config.peer,
        data: ?ignored[0], length: 1, received_at_ns: 1000011, ecn: 0};
    if (core.receive(?fixture.engine, ?fixture.secrets,
        ?input).status != transport.STATUS_CLOSED) { ret 2; }
