# typed mach-tls client binding for quic handshake ownership

use crypto.contracts;
use crypto.secret;
use test_credentials: quic.connection.credentials_simulated;
use handshake_api:    quic.connection.handshake;
use quic.packet.packet;
use quic.storage.limited;
use supply: quic.storage.source;
use std.memory.buffers;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.size.usize;
use tls.buffer;
use tls.cert;
use tls.client;
use tls.clock;
use tls.config;
use tls.record;
use tls.tls13;

pub rec Config {
    deadline_ns:                 u64;
    entropy_context_size:        usize;
    entropy_secret_context_size: usize;
}

pub val ERROR_TLS_BASE: u64 = handshake_api.PROVIDER_TLS_ERROR_BASE;
pub val ERROR_CONFIG:   u64 = handshake_api.PROVIDER_BINDING_CONFIG;
pub val ERROR_LEVEL:    u64 = handshake_api.PROVIDER_BINDING_LEVEL;
pub val ERROR_OFFSET:   u64 = handshake_api.PROVIDER_BINDING_OFFSET;
pub val ERROR_TIME:     u64 = handshake_api.PROVIDER_BINDING_TIME;
pub val ERROR_DEADLINE: u64 = handshake_api.PROVIDER_BINDING_DEADLINE;
pub val ERROR_STATE:    u64 = handshake_api.PROVIDER_BINDING_STATE;
pub val ERROR_EVENT:    u64 = handshake_api.PROVIDER_BINDING_EVENT;

pub fun initialize(adapter: *handshake_api.Adapter,
    adapter_config: handshake_api.Config,
    storage: handshake_api.Storage, value: *client.Handshake,
    lease: buffer.Lease, configuration: Config) bool {
    ret handshake_api.initialize_tls_client(adapter, adapter_config, storage, value, lease,
        configuration.deadline_ns,
        configuration.entropy_context_size,
        configuration.entropy_secret_context_size);
}

#[testing]
var adapter_chunk_pool: supply.TestPool;
#[testing]
var adapter_chunk_account: supply.Account;

# one pool for every adapter these tests build, which may outlive a test
#[testing]
fun adapter_account() *supply.Account {
    if (!supply.test_made(?adapter_chunk_pool)) {
        supply.make_test(?adapter_chunk_pool, 256);
        supply.open_connection(?adapter_chunk_pool.provider, ?adapter_chunk_account,
            1, 128, 128, 4 * supply.RECORD, 0, nil, 0);
    }
    ret ?adapter_chunk_account;
}

# the lease every test engine charges: the adapters' shared account, on tls's
# lane
#[testing]
fun adapter_lease() buffer.Lease {
    ret buffer.Lease{source: ?adapter_chunk_pool.provider, account: adapter_account(),
        lane: supply.TLS};
}

#[testing]
var adapter_attempts: [8]handshake_api.Attempt;

#[testing]
#[oblivious]
fun deterministic_entropy(context: ptr, secret_context: *^u8,
    destination: *^u8, length: usize) i64 {
    val counter: *u8   = context::*u8;
    var i:       usize = 0;
    for (i < length) {
        destination[i] = counter[0] + i::u8 + 1;
        i              = i + 1;
    }
    counter[0] = counter[0] + 17;
    ret 0;
}

test tls_client__exact_client_hello_ownership_survives_loss_and_restarts {
    var entropy_counter: u8             = 1;
    var entropy:         secret.Entropy = secret.Entropy{context: ?entropy_counter,
        secret_context: nil, fill_fn: deterministic_entropy, initialized: true};
    var anchor:    cert.Certificate       = cert.Certificate{der: "x"::*u8, der_len: 1};
    var trust:     cert.TrustStore        = cert.TrustStore{anchors: ?anchor, len: 1};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: "h3"::*u8, len: 2}
    };
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [3]tls13.CipherSuite = [3]tls13.CipherSuite{
        tls13.AES_128_GCM_SHA256, tls13.AES_256_GCM_SHA384,
        tls13.CHACHA20_POLY1305_SHA256
    };
    var groups: [2]tls13.NamedGroup = [2]tls13.NamedGroup{
        tls13.X25519, tls13.SECP256R1
    };
    var signatures: [1]tls13.SignatureScheme =
        [1]tls13.SignatureScheme{tls13.ED25519};
    var client_config: config.ClientConfig;
    client_config.server_name = contracts.Bytes{
        data: "api.example.com"::*u8, len: 15
    };
    client_config.alpn                            = ?protocols[0];
    client_config.alpn_len                        = 1;
    client_config.trust                           = ?trust;
    client_config.versions                        = ?versions[0];
    client_config.version_len                     = 1;
    client_config.suites                          = ?suites[0];
    client_config.suite_len                       = 3;
    client_config.groups                          = ?groups[0];
    client_config.group_len                       = 2;
    client_config.signatures                      = ?signatures[0];
    client_config.signature_len                   = 1;
    client_config.entropy                         = ?entropy;
    client_config.entropy_context_size            = 1;
    client_config.limits                          = config.production_limits();
    client_config.clock                           = test_credentials.test_clock();
    client_config.limits.max_peer_handshake_bytes = 4096;
    client_config.limits.max_client_hello_bytes   = 4096;
    client_config.limits.max_client_flight_bytes  = 4096;
    client_config.limits.max_chain_bytes          = 4096;
    client_config.limits.max_ticket_bytes         = 4096;
    var local_parameters: [4]u8 = [4]u8{0x01, 0x02, 0x03, 0x04};
    var tls_value:        client.Handshake;
    if (!client.init(?tls_value, ?client_config, adapter_lease(),
        client.ExtraExtension{kind: client.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?local_parameters[0], len: 4}},
        client.QUIC_TRANSPORT_PARAMETERS)) { ret 1; }
    val adapter_config: handshake_api.Config = handshake_api.Config{source: 77,
        max_crypto_per_level: 4096, max_event_data: 4096,
        max_peer_identity:    4096};
    val adapter_storage: handshake_api.Storage = handshake_api.Storage{attempts: ?adapter_attempts[0], attempt_capacity: 8,
        account: adapter_account(), chunks: ?adapter_chunk_pool.provider};
    var overlapping: handshake_api.Storage = adapter_storage;
    overlapping.attempts = (?tls_value.random[0])::*handshake_api.Attempt;
    var rejected_adapter: handshake_api.Adapter;
    var other_lane:       buffer.Lease = adapter_lease();
    other_lane.lane = supply.RECEIVE;
    if (initialize(?rejected_adapter, adapter_config, adapter_storage, ?tls_value,
        other_lane, Config{deadline_ns: 1000,
        entropy_context_size: 1, entropy_secret_context_size: 0}) ||
        initialize(?rejected_adapter, adapter_config, adapter_storage, ?tls_value,
        buffer.no_lease(), Config{deadline_ns: 1000, entropy_context_size: 1,
        entropy_secret_context_size: 0}) || rejected_adapter.initialized) {
        ret 23;
    }
    if (initialize(?rejected_adapter, adapter_config, overlapping, ?tls_value,
        adapter_lease(), Config{deadline_ns: 1000,
        entropy_context_size:        1,
        entropy_secret_context_size: 0}) || rejected_adapter.initialized) {
        ret 21;
    }
    var shared_clock:      clock.Source = @test_credentials.test_clock();
    var overlapping_clock: clock.Source = shared_clock;
    overlapping_clock.context      = (?adapter_attempts[0])::ptr;
    overlapping_clock.context_size = 8;
    tls_value.config.clock         = ?overlapping_clock;
    if (initialize(?rejected_adapter, adapter_config, adapter_storage, ?tls_value,
        adapter_lease(), Config{deadline_ns: 1000, entropy_context_size: 1,
        entropy_secret_context_size: 0}) || rejected_adapter.initialized) {
        ret 24;
    }
    tls_value.config.clock = (?adapter_attempts[1])::*clock.Source;
    if (initialize(?rejected_adapter, adapter_config, adapter_storage, ?tls_value,
        adapter_lease(), Config{deadline_ns: 1000, entropy_context_size: 1,
        entropy_secret_context_size: 0}) || rejected_adapter.initialized) {
        ret 25;
    }
    tls_value.config.clock = test_credentials.test_clock();
    var adapter: handshake_api.Adapter;
    if (!initialize(?adapter, adapter_config, adapter_storage, ?tls_value,
        adapter_lease(), Config{deadline_ns: 1000,
        entropy_context_size:        1,
        entropy_secret_context_size: 0})) {
        ret 22;
    }
    var start: handshake_api.Start;
    start.role        = handshake_api.CLIENT;
    start.version     = packet.VERSION_1;
    start.server_name = handshake_api.View{data: "api.example.com"::*u8,
        length: 15};
    start.alpn                       = handshake_api.View{data: "h3"::*u8, length: 2};
    start.local_transport_parameters = handshake_api.View{
        data: ?local_parameters[0], length: 4
    };
    start.now_ns = 1;
    if (!adapter.initialized ||
        handshake_api.start(?adapter, ?start).status != handshake_api.STATUS_OK) {
        ret 23;
    }
    val first: handshake_api.Event = handshake_api.next_event(?adapter);
    if (first.status != handshake_api.STATUS_OK ||
        first.kind != handshake_api.EVENT_CRYPTO ||
        first.level != handshake_api.INITIAL || first.data.length == 0) { ret 3; }
    val hello_length: usize = first.data.length;
    var retained:     [64]u8;
    var i:            usize = 0;
    for (i < 64 && i < hello_length) {
        retained[i] = first.data.data[i];
        i           = i + 1;
    }
    if (handshake_api.complete_event(?adapter, first.token, true).status !=
        handshake_api.STATUS_OK) { ret 4; }
    val prepared: handshake_api.Prepared = handshake_api.prepare(?adapter,
        handshake_api.INITIAL, 64);
    if (prepared.status != handshake_api.STATUS_OK || prepared.offset != 0 ||
        handshake_api.publish(?adapter, prepared.token).status !=
        handshake_api.STATUS_OK ||
        handshake_api.on_terminal(?adapter, prepared.token,
        handshake_api.TERMINAL_LOST).status != handshake_api.STATUS_OK ||
        handshake_api.on_retry(?adapter, packet.VERSION_1, 2).status !=
        handshake_api.STATUS_OK) { ret 5; }
    val retried: handshake_api.Event = handshake_api.next_event(?adapter);
    if (retried.status != handshake_api.STATUS_OK ||
        retried.kind != handshake_api.EVENT_CRYPTO ||
        retried.data.length != hello_length) { ret 6; }
    i = 0;
    for (i < 64 && i < hello_length) {
        if (retried.data.data[i] != retained[i]) { ret 7; }
        i = i + 1;
    }
    if (handshake_api.complete_event(?adapter, retried.token, true).status !=
        handshake_api.STATUS_OK) { ret 8; }
    val retry_range: handshake_api.Prepared = handshake_api.prepare(?adapter,
        handshake_api.INITIAL, 64);
    if (retry_range.status != handshake_api.STATUS_OK || retry_range.offset != 0 ||
        handshake_api.cancel_prepared(?adapter, retry_range.token).status !=
        handshake_api.STATUS_OK ||
        handshake_api.on_version_negotiation(?adapter, packet.VERSION_2, 3).status !=
        handshake_api.STATUS_OK) { ret 9; }
    val negotiated: handshake_api.Event = handshake_api.next_event(?adapter);
    if (negotiated.status != handshake_api.STATUS_OK ||
        negotiated.data.length != hello_length ||
        handshake_api.complete_event(?adapter, negotiated.token, true).status !=
        handshake_api.STATUS_OK) { ret 10; }
    val negotiated_range: handshake_api.Prepared = handshake_api.prepare(?adapter,
        handshake_api.INITIAL, 64);
    if (negotiated_range.status != handshake_api.STATUS_OK ||
        negotiated_range.offset != 0 ||
        handshake_api.cancel_prepared(?adapter, negotiated_range.token).status !=
        handshake_api.STATUS_OK) { ret 11; }
    var malformed: [4]u8                = [4]u8{0xff, 0, 0, 0};
    val ingested:  handshake_api.Result = handshake_api.receive(?adapter,
        handshake_api.INITIAL, 0, ?malformed[0], 4, 4);
    val alert: handshake_api.Event = handshake_api.next_event(?adapter);
    if (ingested.status != handshake_api.STATUS_OK ||
        alert.status != handshake_api.STATUS_OK ||
        alert.kind != handshake_api.EVENT_ALERT ||
        alert.alert != record.UNEXPECTED_MESSAGE_ALERT::u64 ||
        handshake_api.complete_event(?adapter, alert.token, true).status !=
        handshake_api.STATUS_OK || !handshake_api.destroy(?adapter)) { ret 12; }
    if (!client.init(?tls_value, ?client_config, adapter_lease(),
        client.ExtraExtension{kind: client.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?local_parameters[0], len: 4}},
        client.QUIC_TRANSPORT_PARAMETERS)) { ret 13; }
    var deadline_adapter: handshake_api.Adapter;
    if (!initialize(?deadline_adapter,
        handshake_api.Config{source: 78, max_crypto_per_level: 4096,
        max_event_data: 4096, max_peer_identity: 4096},
        handshake_api.Storage{attempts: ?adapter_attempts[0], attempt_capacity: 8,
        account: adapter_account(), chunks: ?adapter_chunk_pool.provider}, ?tls_value,
        adapter_lease(), Config{deadline_ns: 10,
        entropy_context_size:        1,
        entropy_secret_context_size: 0})) { ret 14; }
    start.now_ns = 5;
    if (!deadline_adapter.initialized ||
        handshake_api.start(?deadline_adapter, ?start).status !=
        handshake_api.STATUS_OK) { ret 14; }
    val expired: handshake_api.Result = handshake_api.poll(?deadline_adapter, 10);
    if (expired.status != handshake_api.STATUS_ERROR ||
        expired.error != handshake_api.ERROR_PROVIDER ||
        expired.provider_error != ERROR_DEADLINE ||
        !handshake_api.destroy(?deadline_adapter)) { ret 15; }
    ret 0;
}
