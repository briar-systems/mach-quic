# assembled controls and backing are far past a stack frame

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

var front_memory:     allocator_testing.Testing;
var dialer:           assembly.Connection;
var listener:         assembly.Connection;
var dialer_storage:   assembly.Storage;
var listener_storage: assembly.Storage;
var copied_storage:   assembly.Storage;
# both ends run on this test's one pump, so they share its scratch pair
var pump_scratch:     assembly.Scratch;
var pump_secret:      assembly.SecretScratch;
var dialer_tls:       client.Handshake;
var listener_tls:     server.Handshake;
var dialer_tls_two:   client.Handshake;
var listener_tls_two: server.Handshake;
var rollback_tls:     client.Handshake;

var dialer_parameters:   [512]u8;
var listener_parameters: [512]u8;
var wire:                [1500]u8;
var dialer_scope:        cancel.Scope;
var listener_scope:      cancel.Scope;

var secret_storage_delegate:         secret.ArrayAllocator[assembly.SecretScratch];
var secret_storage_deallocations:    usize;
var secret_storage_zeroed_releases:  usize;
var secret_storage_nonzero_releases: usize;

fun secret_storage_allocate(context: ptr, secret_context: *^u8, count: usize,
    bytes: usize, alignment: usize,
    output: **assembly.SecretScratch) i64 {
    ret secret_storage_delegate.allocate_fn(secret_storage_delegate.context,
        secret_storage_delegate.secret_context, count, bytes, alignment,
        output);
}

fun secret_storage_deallocate(context: ptr, secret_context: *^u8,
    data: *assembly.SecretScratch, count: usize,
    bytes: usize, alignment: usize) i64 {
    secret_storage_deallocations = secret_storage_deallocations + 1;
    var zeroed: bool  = true;
    var i:      usize = 0;
    for (i < count) {
        if (data[i].holder != 0 || data[i].receive_plaintext[0]:>u8 != 0 ||
            data[i].receive_plaintext[assembly.MAX_UDP_PAYLOAD - 1]:>u8 != 0 ||
            data[i].send_plaintext[0]:>u8 != 0 ||
            data[i].send_plaintext[assembly.MAX_UDP_PAYLOAD - 1]:>u8 != 0) {
            zeroed = false;
        }
        i = i + 1;
    }
    if (zeroed) {
        secret_storage_zeroed_releases =
            secret_storage_zeroed_releases + 1;
    }
    or {
        secret_storage_nonzero_releases =
            secret_storage_nonzero_releases + 1;
    }
    if (secret_storage_deallocations == 1) {
        data[0].receive_plaintext[0] = 0xCC;
        ret -1;
    }
    ret secret_storage_delegate.deallocate_fn(secret_storage_delegate.context,
        secret_storage_delegate.secret_context, data, count, bytes, alignment);
}

# marks a stream attempt as escaped, which keeps the rollback from reclaiming
rec RollbackProbe {
    attempt_state: *u8;
    calls:         usize;
    armed:         bool;
}

#[oblivious]
fun rollback_entropy(context: ptr, secret_context: *^u8,
    destination: *^u8, length: usize) i64 {
    val probe: *RollbackProbe = context::*RollbackProbe;
    probe.calls = probe.calls + 1;
    if (probe.armed) {
        probe.attempt_state[0] = 1;
        ret -1;
    }
    var i: usize = 0;
    for (i < length) {
        destination[i] = (i + probe.calls)::u8;
        i              = i + 1;
    }
    ret 0;
}

var chunk_pool: supply.TestPool;

# a pool small enough for a test to exhaust, and whether connections use it
var small_pool: supply.TestPool;
var starving:   bool;

# the caller composes each account: its own handle and two lanes after quic's
val COMPOSED_LANES:           usize    = 2;
val COMPOSED_DIALER_HANDLE:   u64      = 0xC0DE01;
val COMPOSED_LISTENER_HANDLE: u64      = 0xC0DE02;
var composed_budgets:         [2]usize = [2]usize{8192, 4096};
var composed:                 bool;

# how a test misdeclares the caller's lanes, and which stage refuses it
val LANES_OK:       u8 = 0;
val LANES_OVER:     u8 = 1;
val LANES_MISMATCH: u8 = 2;
var lane_fault:     u8;

# one pool serves every connection a test assembles
fun test_chunks() buffers.Source {
    var extra: usize = 0;
    if (composed) { extra = COMPOSED_LANES; }
    if (starving) {
        if (!supply.test_made(?small_pool)) {
            supply.make_test_lanes(?small_pool, 128, extra);
        }
        ret small_pool.provider;
    }
    if (!supply.test_made(?chunk_pool)) {
        supply.make_test_lanes(?chunk_pool, 4096, extra);
    }
    ret chunk_pool.provider;
}

# which lease establish_direct gives the dialer's engine
val LEASE_OWN:      u8 = 0;
val LEASE_PEER:     u8 = 1;
val LEASE_NONE:     u8 = 2;
val LEASE_ORIGINAL: u8 = 3;
var mislease:       u8;
# a connection the dialer is copied from after its lease was taken
var original: assembly.Connection;
# what establish_direct returns once the dialer's engine was refused
val REFUSED: i32 = 99;
# whether the listener answers the first Initial with a stateless refusal
# instead of a connection, and what establish_direct returns once it did
var refusing:       bool;
val REFUSAL_CLOSED: i32 = 98;

# the front listener answers the dialer's Initial the way a busy server would,
# then the dialer must be draining on CONNECTION_REFUSED with nothing else
# having happened to it
fun refused_start(clock: *u64, length: usize) i32 {
    val front_made: err[allocator.Error] = allocator_testing.make(?front_memory);
    if (sel front_made.err) { ret 50; }
    var admission_config: admission.Config;
    admission_config.source                   = 921;
    admission_config.max_connections          = opt[usize].none{};
    admission_config.max_connections_per_peer = opt[usize].none{};
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission_config,
        allocator_testing.allocator_of(?front_memory))) { ret 51; }
    var token_config: token.Config;
    token_config.source          = 922;
    token_config.retry_max_age   = duration.SECOND;
    token_config.address_max_age = duration.SECOND;
    token_config.max_replay      = 16;
    var token_key:     [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token_config,
        allocator_testing.allocator_of(?front_memory), 1,
        contracts.SecretBytes{data: ?token_key[0], len: 32})) { ret 52; }
    var quic_versions: [1]u32 = [1]u32{packet_api.VERSION_1};
    var front:         listener_api.Listener;
    if (!listener_api.initialize(?front, listener_api.Config{source: 923,
        supported_versions:   ?quic_versions[0], supported_version_count: 1,
        minimum_initial_size: 1200, require_retry: false},
        allocator_testing.allocator_of(?front_memory),
        ?admission_manager, ?token_manager)) { ret 53; }
    var refusal_bytes: [256]u8;
    var request:       listener_api.Request;
    request.peer                     = dialer_endpoint();
    request.data                     = ?wire[0];
    request.length                   = length;
    request.now                      = instants.instant(clock[0]);
    request.retry_nonce              = 0;
    request.version_negotiation_bits = 0;
    request.output                   = ?refusal_bytes[0];
    request.output_capacity          = 256;
    if (!listener_api.set_retry_source(?request, ?listener_source[0], 8)) { ret 54; }
    val refused: listener_api.Result = listener_api.refuse(?front, ?request,
        core.CONNECTION_REFUSED);
    if (refused.action != listener_api.ACTION_REFUSE || refused.output_count == 0 ||
        refused.output_count > 3 * length || front.pending.live != 0 ||
        admission.snapshot(?admission_manager).reserved != 0) { ret 55; }
    clock[0] = clock[0] + 1000;
    if (!deliver(?dialer, dialer_endpoint(), listener_endpoint(), ?refusal_bytes[0],
        refused.output_count, clock[0])) { ret 56; }
    val state: core.Snapshot = core.snapshot(?dialer.core);
    if (state.state != transport.DRAINING || !state.closing ||
        !dialer.core.peer_close_received ||
        dialer.core.close_error != core.CONNECTION_REFUSED ||
        dialer.core.close_frame_type != 0 ||
        transport.snapshot[binding.Binding](?dialer.driver).state !=
        transport.DRAINING) { ret 57; }
    # a draining client sends nothing more
    clock[0] = clock[0] + 1000;
    val after: transport.Generated = checked_generate(?dialer, ?dialer_scope, ?wire[0], 1500, instants.instant(clock[0]), 0);
    if (after.status == transport.STATUS_OK) { ret 58; }
    if (!listener_api.begin_close(?front) || !listener_api.finish_close(?front) ||
        !admission.begin_close(?admission_manager) ||
        !admission.finish_close(?admission_manager) ||
        !token.begin_close(?token_manager) || !token.finish_close(?token_manager)) {
        ret 59;
    }
    ret 0;
}

fun dialer_engine_lease() tls_buffer.Lease {
    if (mislease == LEASE_PEER) { ret assembly.tls_lease(?listener); }
    if (mislease == LEASE_NONE) { ret tls_buffer.no_lease(); }
    if (mislease == LEASE_ORIGINAL) {
        val lease: tls_buffer.Lease = assembly.tls_lease(?original);
        dialer = original;
        ret lease;
    }
    ret assembly.tls_lease(?dialer);
}

# chunks another account holds on the small pool
var hog_account: supply.Account;
var hog_chunks:  [256]supply.Chunk;
var hog_count:   usize;

# holds every chunk of the small pool but one, which the dialer's handshake
# block takes, so its tls start finds no memory at all
fun hog() bool {
    test_chunks();
    var extra:   usize  = 0;
    var budgets: *usize = nil;
    if (composed) {
        extra   = COMPOSED_LANES;
        budgets = ?composed_budgets[0];
    }
    if (!supply.open_connection(?small_pool.provider, ?hog_account, 77, 256, 0, 0, 0,
        budgets, extra)) { ret false; }
    var from: supply.Source = supply.Source{provider: ?small_pool.provider,
        account: ?hog_account, lane: supply.SEND};
    hog_count = 0;
    for (hog_count < 256) {
        val taken: supply.Taken = supply.take(?from, supply.BYTES);
        if (!taken.ok) { brk; }
        hog_chunks[hog_count] = taken.chunk;
        hog_count             = hog_count + 1;
    }
    if (hog_count == 0 || hog_count == 256) { ret false; }
    hog_count = hog_count - 1;
    ret supply.give(?from, hog_chunks[hog_count]);
}

fun unhog() bool {
    var from: supply.Source = supply.Source{provider: ?small_pool.provider,
        account: ?hog_account, lane: supply.SEND};
    for (hog_count > 0) {
        hog_count = hog_count - 1;
        if (!supply.give(?from, hog_chunks[hog_count])) { ret false; }
    }
    ret supply.close(?small_pool.provider, ?hog_account);
}

# the dialer's tls start waited for memory: nothing goes out and polling stops
# until the pool wakes the connection, and then the same start runs again
fun starved_start(clock: *u64) i32 {
    clock[0] = clock[0] + 1000;
    val waiting: transport.Generated = checked_generate(?dialer, ?dialer_scope, ?wire[0], 1500, instants.instant(clock[0]), 0);
    if (waiting.status == transport.STATUS_OK ||
        waiting.status == transport.STATUS_ERROR ||
        !core.snapshot(?dialer.core).handshake_waiting ||
        assembly.tls_released(?dialer) ||
        dialer.handshake.levels[0].send_acked != 0 ||
        dialer_tls.hello_len != 0) { ret 40; }
    if (!unhog()) { ret 41; }
    var woken: [8]u64;
    val count: usize = supply.ready(?small_pool.provider, ?woken[0], 8);
    var found: bool  = false;
    var i:     usize = 0;
    for (i < count) {
        if (woken[i] == dialer.account.handle) { found = true; }
        i = i + 1;
    }
    if (!found) { ret 42; }
    transport.storage_ready[binding.Binding](?dialer.driver);
    ret 0;
}

# a failing exit code is one byte, so the detail lands here and the assertion
# returns only which step refused
var fault_side:   u64;
var fault_step:   u64;
var fault_status: u64;
var fault_error:  u64;

var dialer_source:       [8]u8 = [8]u8{0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18};
var listener_source:     [8]u8 = [8]u8{0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28};
var initial_destination: [8]u8 =
    [8]u8{0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38};
var alpn:        [2]u8  = [2]u8{'h', '3'};
var server_name: [15]u8 = [15]u8{'a', 'p', 'i', '.', 'e', 'x', 'a', 'm',
    'p', 'l', 'e', '.', 'c', 'o', 'm'};

# an exit code is one byte, so a refusal reports which side and step refused and
# what the core said, each clamped rather than truncated into another code's
# range. never zero, so a refusal cannot be mistaken for a pass
fun clamped(value: u64, ceiling: u64) u64 {
    if (value > ceiling) { ret ceiling; }
    ret value;
}

fun refusal() i32 {
    ret (100 + fault_side * 50 + fault_step * 8 +
        clamped(fault_status, 3) * 2 + clamped(fault_error, 1))::i32;
}

fun endpoint(host: u8, port: u16) ip.Endpoint {
    var value: ip.Endpoint;
    value.addr.v4.octets[0] = 192;
    value.addr.v4.octets[1] = 0;
    value.addr.v4.octets[2] = 2;
    value.addr.v4.octets[3] = host;
    value.port              = port;
    ret value;
}

fun dialer_endpoint() ip.Endpoint {
    ret endpoint(1, 55000);
}

fun listener_endpoint() ip.Endpoint {
    ret endpoint(2, 4433);
}

fun embedded_scope(data: *u8, length: usize) *cancel.Scope {
    if (data == nil || length < $size_of(cancel.Scope)) { ret nil; }
    val alignment: usize = $align_of(cancel.Scope);
    val start:     usize = data::usize;
    val aligned:   usize = (start + alignment - 1) / alignment * alignment;
    if (aligned < start || aligned - start > length - $size_of(cancel.Scope)) {
        ret nil;
    }
    ret aligned::*cancel.Scope;
}

fun connection_id(data: *u8, length: usize) packet_api.ConnectionId {
    var value: packet_api.ConnectionId;
    packet_api.set_connection_id(?value, data, length);
    ret value;
}

# absolute tls handshake deadline for connections built here, zero for none
var handshake_deadline_ns: u64;

# both sides describe the same connection; only the identity fields differ
# the DATAGRAM frame size both ends advertise, 0 for none
var datagram_frame_size: usize;

fun connection_config(role: transport.Role) assembly.Config {
    var value: assembly.Config;
    if (role == transport.CLIENT) {
        value = assembly.default_config(901, dialer_endpoint(),
            listener_endpoint());
        value.local_source       = ?dialer_source[0];
        value.peer_destination   = ?initial_destination[0];
        value.server_name        = ?server_name[0];
        value.server_name_length = 15;
    }
    or {
        value = assembly.default_config(902, listener_endpoint(),
            dialer_endpoint());
        value.local_source     = ?listener_source[0];
        value.peer_destination = ?dialer_source[0];
    }
    # a starved pool has nothing to set aside
    if (starving) { value.chunk_reserve = 0; }
    if (composed) {
        value.account_handle = COMPOSED_DIALER_HANDLE;
        if (role != transport.CLIENT) { value.account_handle = COMPOSED_LISTENER_HANDLE; }
        value.extra_budgets = ?composed_budgets[0];
        value.extra_lanes   = COMPOSED_LANES;
    }
    value.local_source_length         = 8;
    value.peer_destination_length     = 8;
    value.original_destination        = ?initial_destination[0];
    value.original_destination_length = 8;
    value.alpn                        = ?alpn[0];
    value.alpn_length                 = 2;
    value.max_udp_payload             = 1200;
    value.max_idle_timeout            = 30 * duration.SECOND;
    value.peer_bidirectional_streams  = (assembly.STREAM_CAPACITY -
        assembly.H3_CRITICAL_STREAMS_PER_PEER * 2)::u64;
    value.peer_unidirectional_streams =
        assembly.H3_CRITICAL_STREAMS_PER_PEER::u64;
    value.receive_max_data        = assembly.STREAM_WINDOW::u64;
    value.receive_stream_data     = assembly.STREAM_STRIDE::u64;
    value.peer_validated          = true;
    value.max_datagram_frame_size = datagram_frame_size;
    if (handshake_deadline_ns != 0) {
        value.tls_deadline = opt[time.Instant].some{instants.instant(handshake_deadline_ns)};
    }
    ret value;
}

# when set, every driver call in carry records what both ends hold after it
var observed: *Peak;

fun watch() {
    if (observed != nil) { observe(observed); }
}

# every generate a test makes is checked against pending_output asked just
# before it. a datagram the query did not predict, or a prediction the
# generate did not bear out outside the query's documented edges, reads as an
# error to the test that made the call
val MISPREDICTED: u8 = 0xee;

# the public state a query could touch: every record of the connection but
# its secrets, the storage it lent, and its account
# the public state a query could touch: every record of the connection
# that holds no secret, the storage it lent, its account, and what the
# driver and the handshake adapter keep beside their secret-bearing context
rec Public {
    core:              core.Core;
    cids:              cid_api.Manager;
    paths:             path_api.Manager;
    streams:           stream_api.Manager;
    datagrams:         datagram_api.Queue;
    storage:           assembly.Storage;
    account:           supply.Account;
    state:             transport.ConnectionState;
    last_now_ns:       u64;
    pending_sends:     usize;
    next_slot:         usize;
    closing:           bool;
    next_attempt:      usize;
    handshake_lease:   u64;
    handshake_closing: bool;
}

# fills a zeroed record field by field, so padding compares equal
fun public_of(value: *assembly.Connection, output: *Public) {
    output.core              = value.core;
    output.cids              = value.cids;
    output.paths             = value.paths;
    output.streams           = value.streams;
    output.datagrams         = value.datagrams;
    output.storage           = @value.storage;
    output.account           = value.account;
    output.state             = value.driver.state;
    output.last_now_ns       = value.driver.last_now_ns;
    output.pending_sends     = value.driver.pending_sends;
    output.next_slot         = value.driver.next_slot;
    output.closing           = value.driver.closing;
    output.next_attempt      = value.handshake.next_attempt;
    output.handshake_lease   = value.handshake.core_lease;
    output.handshake_closing = value.handshake.closing;
}

fun checked_generate(value: *assembly.Connection, scope: *cancel.Scope, buffer: *u8,
    capacity: usize, now: time.Instant, context: usize) transport.Generated {
    val handshake_work: bool = core.handshake_pending(?value.core);
    val refused:        bool = value.core.send_refused;
    val cancelled:      bool = atomic.load(?value.driver.cancellation.pending) != 0;
    var before:         Public;
    var after:          Public;
    public_of(value, ?before);
    val predicted: bool = transport.pending_output[binding.Binding](?value.driver, now);
    val news:      bool = transport.pending_stream_news[binding.Binding](?value.driver);
    public_of(value, ?after);
    # asking changes nothing
    if (news != stream_api.pending_news(?value.streams) ||
        !memory.equal[Public](?before, ?after, 1)) {
        var touched: transport.Generated;
        touched.status = transport.STATUS_ERROR;
        touched.error  = MISPREDICTED;
        ret touched;
    }
    var generated: transport.Generated = transport.generate[binding.Binding](?value.driver,
        scope, buffer, capacity, now, context);
    val sent: bool = generated.status == transport.STATUS_OK;
    val edge: bool = handshake_work || cancelled || (value.core.send_refused && !refused) ||
        capacity < value.core.send_max_udp_payload;
    if (sent != predicted && (sent || !edge)) {
        generated.status = transport.STATUS_ERROR;
        generated.error  = MISPREDICTED;
    }
    ret generated;
}

# one generated datagram, completed on the sender and delivered to the peer,
# exactly as an owner's scheduling loop would move it
fun carry(source: *assembly.Connection, sink: *assembly.Connection,
    source_scope: *cancel.Scope, sink_local: ip.Endpoint,
    sink_peer: ip.Endpoint, clock: *u64, moved: *usize) i64 {
    var guard: usize = 0;
    for (guard < 64) {
        clock[0] = clock[0] + 1000;
        val generated: transport.Generated =
            checked_generate(source, source_scope,
            ?wire[0], 1500, instants.instant(clock[0]), 0);
        if (generated.status == transport.STATUS_EMPTY ||
            generated.status == transport.STATUS_BLOCKED) { ret 0; }
        if (generated.status != transport.STATUS_OK) {
            fault_step   = 1;
            fault_status = generated.status::u64;
            fault_error  = generated.error::u64;
            ret 1;
        }
        if (generated.count == 0) {
            fault_step = 2;
            ret 2;
        }
        watch();
        clock[0] = clock[0] + 1000;
        val completed: transport.Completion =
            transport.complete_send[binding.Binding](?source.driver,
            generated.token, transport.SEND_SENT, generated.count,
            instants.instant(clock[0]));
        if (completed.status != transport.STATUS_OK) {
            fault_step   = 3;
            fault_status = completed.status::u64;
            fault_error  = completed.error::u64;
            ret 3;
        }
        watch();
        var input: transport.Datagram;
        input.local       = sink_local;
        input.peer        = sink_peer;
        input.data        = ?wire[0];
        input.length      = generated.count;
        input.received_at = instants.instant(clock[0]);
        input.ecn         = 0;
        clock[0]          = clock[0] + 1000;
        val received: transport.OperationResult =
            transport.receive_datagram[binding.Binding](?sink.driver, ?input);
        if (received.status != transport.STATUS_OK) {
            fault_step   = 4;
            fault_status = received.status::u64;
            fault_error  = received.error::u64;
            ret 4;
        }
        watch();
        moved[0] = moved[0] + 1;
        guard    = guard + 1;
    }
    fault_step = 5;
    ret 5;
}

# carries both directions for a fixed number of rounds, with no completion
# condition, so a caller that is past the handshake is not relying on one
fun pump(clock: *u64, moved: *usize, rounds: usize) i64 {
    var round: usize = 0;
    for (round < rounds) {
        val forward: i64 = carry(?dialer, ?listener, ?dialer_scope,
            listener_endpoint(), dialer_endpoint(), clock, moved);
        if (forward != 0) {
            fault_side = 1;
            ret forward;
        }
        val backward: i64 = carry(?listener, ?dialer, ?listener_scope,
            dialer_endpoint(), listener_endpoint(), clock, moved);
        if (backward != 0) {
            fault_side = 2;
            ret backward;
        }
        round = round + 1;
    }
    ret 0;
}

fun exchange(clock: *u64, moved: *usize, rounds: usize) i64 {
    var round: usize = 0;
    for (round < rounds) {
        val forward: i64 = carry(?dialer, ?listener, ?dialer_scope,
            listener_endpoint(), dialer_endpoint(), clock, moved);
        if (forward != 0) {
            fault_side = 1;
            ret forward;
        }
        val backward: i64 = carry(?listener, ?dialer, ?listener_scope,
            dialer_endpoint(), listener_endpoint(), clock, moved);
        if (backward != 0) {
            fault_side = 2;
            ret backward;
        }
        clock[0] = clock[0] + 1000;
        if (core.poll_handshake(?dialer.core, ?dialer.secrets,
            clock[0]).status == transport.STATUS_ERROR) {
            fault_side = 1;
            fault_step = 6;
            ret 6;
        }
        clock[0] = clock[0] + 1000;
        if (core.poll_handshake(?listener.core, ?listener.secrets,
            clock[0]).status == transport.STATUS_ERROR) {
            fault_side = 2;
            fault_step = 6;
            ret 6;
        }
        if (core.snapshot(?dialer.core).state == transport.ACTIVE &&
            core.snapshot(?listener.core).state == transport.ACTIVE) { ret 0; }
        round = round + 1;
    }
    fault_step = 7;
    ret 7;
}

test "quic.connection.assembly: production H3 capacity, routing, and close share one binding" {
    var owner:         secret.Allocator = secret.system_allocator();
    var chain_storage: [1]cert.Certificate;
    var key:           keys.PrivateKey;
    var identity:      credentials.Identity;
    if (!test_credentials.load_credentials(?identity, ?chain_storage[0], ?key,
        ?owner)) { ret 1; }
    var generation: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK) { ret 2; }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        ret 3;
    }

    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite =
        [1]tls13.CipherSuite{tls13.AES_128_GCM_SHA256};
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme =
        [1]tls13.SignatureScheme{tls13.ED25519};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: ?alpn[0], len: 2}
    };

    var listener_config: assembly.Config = connection_config(transport.SERVER);
    val dialer_config:   assembly.Config = connection_config(transport.CLIENT);
    val dialer_encoded:  usize           = assembly.encode_parameters(?dialer_config,
        transport.CLIENT, ?dialer_parameters[0], 512).count;
    if (dialer_encoded == 0) { ret 4; }

    var listener_counter: u8             = 3;
    var listener_entropy: secret.Entropy = secret.Entropy{
        context: ?listener_counter, secret_context: nil,
        fill_fn: test_credentials.deterministic_entropy, initialized: true
    };
    var listener_tls_config: config.ServerConfig;
    listener_tls_config.credentials                     = ?store;
    listener_tls_config.alpn                            = ?protocols[0];
    listener_tls_config.alpn_len                        = 1;
    listener_tls_config.require_alpn                    = true;
    listener_tls_config.versions                        = ?versions[0];
    listener_tls_config.version_len                     = 1;
    listener_tls_config.suites                          = ?suites[0];
    listener_tls_config.suite_len                       = 1;
    listener_tls_config.groups                          = ?groups[0];
    listener_tls_config.group_len                       = 1;
    listener_tls_config.signatures                      = ?signatures[0];
    listener_tls_config.signature_len                   = 1;
    listener_tls_config.entropy                         = ?listener_entropy;
    listener_tls_config.entropy_context_size            = 1;
    listener_tls_config.limits                          = config.production_limits();
    listener_tls_config.clock                           = test_credentials.test_clock();
    listener_tls_config.limits.max_peer_handshake_bytes = 8192;
    listener_tls_config.limits.max_client_hello_bytes   = 8192;
    listener_tls_config.limits.max_client_flight_bytes  = 8192;
    listener_tls_config.limits.max_server_flight_bytes  = 8192;
    listener_tls_config.limits.max_chain_bytes          = 4096;
    listener_tls_config.limits.max_ticket_bytes         = 4096;
    var anchor:         cert.Certificate = test_credentials.anchor();
    var trust:          cert.TrustStore  = cert.TrustStore{anchors: ?anchor, len: 1};
    var dialer_counter: u8               = 91;
    var dialer_entropy: secret.Entropy   = secret.Entropy{
        context: ?dialer_counter, secret_context: nil,
        fill_fn: test_credentials.deterministic_entropy, initialized: true
    };
    var dialer_tls_config: config.ClientConfig;
    dialer_tls_config.server_name = contracts.Bytes{data: ?server_name[0],
        len: 15};
    dialer_tls_config.alpn                            = ?protocols[0];
    dialer_tls_config.alpn_len                        = 1;
    dialer_tls_config.trust                           = ?trust;
    dialer_tls_config.versions                        = ?versions[0];
    dialer_tls_config.version_len                     = 1;
    dialer_tls_config.suites                          = ?suites[0];
    dialer_tls_config.suite_len                       = 1;
    dialer_tls_config.groups                          = ?groups[0];
    dialer_tls_config.group_len                       = 1;
    dialer_tls_config.signatures                      = ?signatures[0];
    dialer_tls_config.signature_len                   = 1;
    dialer_tls_config.client_identity                 = nil;
    dialer_tls_config.entropy                         = ?dialer_entropy;
    dialer_tls_config.entropy_context_size            = 1;
    dialer_tls_config.limits                          = config.production_limits();
    dialer_tls_config.clock                           = test_credentials.test_clock();
    dialer_tls_config.limits.max_peer_handshake_bytes = 8192;
    dialer_tls_config.limits.max_client_hello_bytes   = 8192;
    dialer_tls_config.limits.max_client_flight_bytes  = 8192;
    dialer_tls_config.limits.max_chain_bytes          = 4096;
    dialer_tls_config.limits.max_ticket_bytes         = 4096;
    if (!client.init(?dialer_tls, ?dialer_tls_config, assembly.tls_lease(?dialer),
        client.ExtraExtension{kind: client.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?dialer_parameters[0],
        len:  dialer_encoded}},
        client.QUIC_TRANSPORT_PARAMETERS)) { ret 6; }

    if (!operation_ok(cancel.make_root(?listener_scope, opt[time.Instant].none{})) ||
        !operation_ok(cancel.make_root(?dialer_scope, opt[time.Instant].none{}))) {
        ret 7;
    }
    val core_scope: *cancel.Scope = embedded_scope(
        ?pump_scratch.receive_header[0], assembly.MAX_UDP_PAYLOAD);
    val handshake_scope: *cancel.Scope = embedded_scope(
        (?dialer_storage.crypto_attempts[0])::*u8, 8 * $size_of(handshake.Attempt));
    val cid_scope: *cancel.Scope = embedded_scope(
        (?dialer_storage.local_cids[0])::*u8,
        assembly.CONNECTION_ID_CAPACITY * $size_of(cid_api.Entry));
    val path_scope: *cancel.Scope = embedded_scope(
        (?dialer_storage.path_values[0])::*u8, 2 * $size_of(path_api.Path));
    val core_overlap: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, core_scope, instants.instant(1000));
    val handshake_overlap: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, handshake_scope, instants.instant(1000));
    val cid_overlap: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, cid_scope, instants.instant(1000));
    val path_overlap: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, path_scope, instants.instant(1000));
    if (core_scope == nil || handshake_scope == nil || cid_scope == nil ||
        path_scope == nil || core_overlap.stage != assembly.STAGE_STORAGE ||
        handshake_overlap.stage != assembly.STAGE_STORAGE ||
        cid_overlap.stage != assembly.STAGE_STORAGE ||
        path_overlap.stage != assembly.STAGE_STORAGE ||
        core_overlap.cleanup_retained || handshake_overlap.cleanup_retained ||
        cid_overlap.cleanup_retained || path_overlap.cleanup_retained ||
        dialer.storage != nil || dialer.scratch != nil ||
        dialer_storage.leased || dialer_storage.source != 0 ||
        !scratch.idle(?pump_scratch, ?pump_secret)) {
        ret 236;
    }
    val misaligned: *assembly.Storage =
        ((?dialer_storage)::usize + 1)::*assembly.Storage;
    val malformed: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, misaligned, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, ?dialer_scope, instants.instant(1000));
    val missing: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, nil, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, ?dialer_scope, instants.instant(1000));
    if (malformed.stage != assembly.STAGE_STORAGE ||
        missing.stage != assembly.STAGE_STORAGE ||
        malformed.cleanup_retained || missing.cleanup_retained ||
        dialer_storage.leased || !scratch.idle(?pump_scratch, ?pump_secret)) { ret 237; }
    val dialed: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, ?dialer_scope, instants.instant(1000));
    if (!dialed.ok)                         { ret 170 + dialed.stage::i32; }
    if (dialed.core.reason != core.INIT_OK) { ret 180 + dialed.core.reason::i32; }
    val dialer_storage_generation: u64 = dialer_storage.generation;
    copied_storage = dialer_storage;
    var competing:     assembly.Connection;
    val public_reused: assembly.InitResult = assembly.init_client(?competing,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, ?dialer_scope, instants.instant(1000));
    # the scratch pair may be shared, but never laid over a connection's storage
    val scratch_overlap: assembly.InitResult = assembly.init_client(?competing,
        ?dialer_config, ?listener_storage, (?listener_storage)::*assembly.Scratch,
        ?pump_secret, test_chunks(), ?dialer_tls, ?dialer_scope,
        instants.instant(1000));
    val copied_reused: assembly.InitResult = assembly.init_client(?competing,
        ?dialer_config, ?copied_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, ?dialer_scope, instants.instant(1000));
    if (public_reused.stage != assembly.STAGE_STORAGE ||
        scratch_overlap.stage != assembly.STAGE_STORAGE ||
        copied_reused.stage != assembly.STAGE_STORAGE ||
        public_reused.cleanup_retained || scratch_overlap.cleanup_retained ||
        copied_reused.cleanup_retained ||
        competing.storage != nil || competing.scratch != nil ||
        !dialer_storage.leased || dialer.scratch != ?pump_scratch ||
        dialer.secret_scratch != ?pump_secret || !copied_storage.leased ||
        ?copied_storage.close_reason[0] == ?dialer_storage.close_reason[0] ||
        dialer_storage.source != dialer_config.source ||
        dialer_storage.generation != dialer_storage_generation ||
        listener_storage.leased || !scratch.idle(?pump_scratch, ?pump_secret)) { ret 238; }
    copied_storage.source = 0;
    copied_storage.leased = false;

    # state of the dialer's adapter the instant after init, before any exchange
    val started: handshake.Snapshot = handshake.snapshot(?dialer.handshake);
    if (!started.initialized)             { ret 210; }
    if (!started.started)                 { ret 211; }
    if (started.closing)                  { ret 212; }
    if (started.destroyed)                { ret 213; }
    if (started.terminal_alert != 0)      { ret 214; }
    if (started.event_active)             { ret 215; }
    if (started.role != handshake.CLIENT) { ret 216; }
    var clock:            u64 = 1000;
    var admission_config: admission.Config;
    admission_config.source                   = 911;
    admission_config.max_connections          = opt[usize].some{2};
    admission_config.max_connections_per_peer = opt[usize].some{2};
    val admission_made: err[allocator.Error] = allocator_testing.make(?front_memory);
    if (sel admission_made.err) { ret 8; }
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission_config,
        allocator_testing.allocator_of(?front_memory))) { ret 8; }
    var token_config: token.Config;
    token_config.source          = 912;
    token_config.retry_max_age   = duration.SECOND;
    token_config.address_max_age = duration.SECOND;
    token_config.max_replay      = 1024;
    var token_key:     [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token_config,
        allocator_testing.allocator_of(?front_memory), 1,
        contracts.SecretBytes{data: ?token_key[0], len: 32})) { ret 9; }
    var quic_versions: [1]u32 = [1]u32{packet_api.VERSION_1};
    var front:         listener_api.Listener;
    if (!listener_api.initialize(?front, listener_api.Config{source: 913,
        supported_versions:   ?quic_versions[0], supported_version_count: 1,
        minimum_initial_size: 1200, require_retry: true},
        allocator_testing.allocator_of(?front_memory),
        ?admission_manager, ?token_manager)) { ret 10; }
    var retry_bytes: [512]u8;
    clock = clock + 1000;
    val first:   transport.Generated = checked_generate(?dialer, ?dialer_scope, ?wire[0], 1500, instants.instant(clock), 0);
    var request: listener_api.Request;
    request.peer   = dialer_endpoint();
    request.data   = ?wire[0];
    request.length = first.count;
    request.now    = instants.instant(clock);
    if (!listener_api.set_retry_source(?request, ?listener_source[0], 8)) {
        ret 11;
    }
    request.retry_nonce     = 41;
    request.output          = ?retry_bytes[0];
    request.output_capacity = 512;
    val challenged: listener_api.Result = listener_api.preflight(?front,
        ?request);
    clock = clock + 1000;
    if (first.status != transport.STATUS_OK || first.count < 1200 ||
        challenged.action != listener_api.ACTION_RETRY ||
        transport.complete_send[binding.Binding](?dialer.driver, first.token,
        transport.SEND_SENT, first.count, instants.instant(clock)).status !=
        transport.STATUS_OK) { ret 11; }
    var retry_datagram: transport.Datagram;
    retry_datagram.local       = dialer_endpoint();
    retry_datagram.peer        = listener_endpoint();
    retry_datagram.data        = ?retry_bytes[0];
    retry_datagram.length      = challenged.output_count;
    clock                      = clock + 1000;
    retry_datagram.received_at = instants.instant(clock);
    if (transport.receive_datagram[binding.Binding](?dialer.driver,
        ?retry_datagram).status != transport.STATUS_OK) { ret 12; }
    clock = clock + 1000;
    if (core.poll_handshake(?dialer.core, ?dialer.secrets, clock).status ==
        transport.STATUS_ERROR) { ret 13; }
    clock = clock + 1000;
    val second:         transport.Generated             = checked_generate(?dialer, ?dialer_scope, ?wire[0], 1500, instants.instant(clock), 0);
    val routed_initial: listener_api.ClassifiedDatagram =
        listener_api.classify_datagram(?wire[0], second.count, 8);
    if (routed_initial.class != listener_api.DATAGRAM_INITIAL ||
        routed_initial.destination.length != 8) { ret 221; }
    request.data   = ?wire[0];
    request.length = second.count;
    request.now    = instants.instant(clock);
    val reserved: listener_api.Result = listener_api.preflight(?front,
        ?request);
    val accepted: listener_api.Accepted = listener_api.commit(?front,
        reserved.acceptance);
    clock = clock + 1000;
    if (second.status != transport.STATUS_OK) {
        ret (20 + second.status::i32);
    }
    if (second.count < 1200)                                        { ret 13; }
    if (reserved.action != listener_api.ACTION_ACCEPT)              { ret 16; }
    if (accepted.action != listener_api.ACTION_ACCEPT)              { ret 17; }
    if (!accepted.retry_source_present || !accepted.peer_validated) { ret 18; }
    if (transport.complete_send[binding.Binding](?dialer.driver, second.token,
        transport.SEND_SENT, second.count, instants.instant(clock)).status !=
        transport.STATUS_OK) { ret 19; }
    if (!assembly.apply_server_acceptance(?listener_config, ?accepted)) { ret 20; }
    val listener_encoded: usize = assembly.encode_parameters(?listener_config,
        transport.SERVER, ?listener_parameters[0], 512).count;
    if (listener_encoded == 0 || !server.init(?listener_tls,
        ?listener_tls_config, assembly.tls_lease(?listener),
        server.ExtraExtension{kind: server.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?listener_parameters[0],
        len:  listener_encoded}},
        server.QUIC_TRANSPORT_PARAMETERS)) { ret 14; }
    val served: assembly.InitResult = assembly.init_server(?listener,
        ?listener_config, ?listener_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?listener_tls, ?listener_scope,
        instants.instant(clock));
    if (!served.ok)                         { ret 140 + served.stage::i32; }
    if (served.core.reason != core.INIT_OK) { ret 150 + served.core.reason::i32; }
    var retried_datagram: transport.Datagram;
    retried_datagram.local       = listener_endpoint();
    retried_datagram.peer        = dialer_endpoint();
    retried_datagram.data        = ?wire[0];
    retried_datagram.length      = second.count;
    clock                        = clock + 1000;
    retried_datagram.received_at = instants.instant(clock);
    if (transport.receive_datagram[binding.Binding](?listener.driver,
        ?retried_datagram).status != transport.STATUS_OK) { ret 15; }
    var moved: usize = 2;
    val ran:   i64   = exchange(?clock, ?moved, 24);
    # never zero, so a refusal can never be mistaken for a pass
    if (ran != 0)   { ret refusal(); }
    if (moved == 0) { ret 200; }
    if (transport.snapshot[binding.Binding](?dialer.driver).state !=
        transport.ACTIVE ||
        transport.snapshot[binding.Binding](?listener.driver).state !=
        transport.ACTIVE) { ret 201; }
    if (!core.snapshot(?dialer.core).peer_parameters_ready ||
        !core.snapshot(?listener.core).peer_parameters_ready) { ret 202; }

    val routes: assembly.RoutingSnapshot = assembly.routing_snapshot(?listener);
    val route:  assembly.Route           = assembly.route_at(?listener, 0);
    if (!routes.initialized || routes.capacity != 1 || routes.active != 1 ||
        !route.active || route.sequence != 0 || route.id.length != 8 ||
        route.id.length != routed_initial.destination.length ||
        !assembly.route_valid(?listener, ?route)) { ret 203; }
    var i: usize = 0;
    for (i < 8) {
        if (route.id.data[i] != listener_source[i] ||
            route.id.data[i] != routed_initial.destination.data[i]) { ret 204; }
        i = i + 1;
    }
    var stale_route: assembly.Route = route;
    stale_route.generation = stale_route.generation + 1;
    var wrong_route: assembly.Route = route;
    wrong_route.id.data[0] = wrong_route.id.data[0] ^ 1;
    if (assembly.route_valid(?listener, ?stale_route) ||
        assembly.route_valid(?listener, ?wrong_route) ||
        assembly.route_at(?listener, 1).active) { ret 205; }
    if (assembly.release_closed(?listener) || !listener.initialized ||
        listener.released || !assembly.route_valid(?listener, ?route)) {
        ret 222;
    }

    var dialer_critical:   [3]transport.Stream;
    var listener_critical: [3]transport.Stream;
    var requests:          [10]transport.Stream;
    var stream_byte:       [1]u8;
    i = 0;
    for (i < 3) {
        val dialer_opened: transport.OpenResult =
            transport.open_stream[binding.Binding](?dialer.driver,
            transport.UNIDIRECTIONAL);
        val listener_opened: transport.OpenResult =
            transport.open_stream[binding.Binding](?listener.driver,
            transport.UNIDIRECTIONAL);
        if (dialer_opened.status != transport.STATUS_OK ||
            listener_opened.status != transport.STATUS_OK) { ret 206; }
        dialer_critical[i]   = dialer_opened.stream;
        listener_critical[i] = listener_opened.stream;
        stream_byte[0]       = i::u8;
        if (transport.write_stream[binding.Binding](?dialer.driver,
            dialer_critical[i], ?stream_byte[0], 1).count != 1 ||
            transport.write_stream[binding.Binding](?listener.driver,
            listener_critical[i], ?stream_byte[0], 1).count != 1) {
            ret 207;
        }
        i = i + 1;
    }
    i = 0;
    for (i < 10) {
        val opened: transport.OpenResult =
            transport.open_stream[binding.Binding](?dialer.driver,
            transport.BIDIRECTIONAL);
        if (opened.status != transport.STATUS_OK) { ret 208; }
        requests[i]    = opened.stream;
        stream_byte[0] = (0x80 + i)::u8;
        if (transport.write_stream[binding.Binding](?dialer.driver,
            requests[i], ?stream_byte[0], 1).count != 1 ||
            transport.finish_stream[binding.Binding](?dialer.driver,
            requests[i]).status != transport.STATUS_OK) { ret 209; }
        i = i + 1;
    }
    if (pump(?clock, ?moved, 16) != 0) { ret refusal(); }
    var accepted_streams: [13]transport.Stream;
    i = 0;
    for (i < 13) {
        val accepted_stream: transport.OpenResult =
            transport.accept_stream[binding.Binding](?listener.driver);
        if (accepted_stream.status != transport.STATUS_OK) { ret 210; }
        accepted_streams[i] = accepted_stream.stream;
        i                   = i + 1;
    }
    i = 0;
    for (i < 3) {
        if (transport.accept_stream[binding.Binding](?dialer.driver).status !=
            transport.STATUS_OK) { ret 211; }
        i = i + 1;
    }
    if (transport.snapshot[binding.Binding](?dialer.driver).active_streams != 16 ||
        transport.snapshot[binding.Binding](?listener.driver).active_streams != 16) {
        ret 212;
    }
    # one ack-eliciting listener packet leaves the dialer holding a delayed ack
    stream_byte[0] = 0xC0;
    if (transport.write_stream[binding.Binding](?listener.driver,
        listener_critical[0], ?stream_byte[0], 1).count != 1) { ret 214; }
    if (carry(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
        listener_endpoint(), ?clock, ?moved) != 0) { ret refusal(); }
    # two dialer packets make the listener's next ack immediate
    i = 0;
    for (i < 2) {
        stream_byte[0] = (0xA0 + i)::u8;
        if (transport.write_stream[binding.Binding](?dialer.driver,
            dialer_critical[i], ?stream_byte[0], 1).count != 1) { ret 214; }
        if (carry(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
            dialer_endpoint(), ?clock, ?moved) != 0) { ret refusal(); }
        i = i + 1;
    }
    # a packet received between preparing an ack-only packet and its send
    # completion supersedes that ack's generation; the completion must not
    # fail the connection
    var ack_wire: [1500]u8;
    clock = clock + 1000;
    val ack_only: transport.Generated =
        checked_generate(?listener, ?listener_scope,
        ?ack_wire[0], 1500, instants.instant(clock), 0);
    if (ack_only.status != transport.STATUS_OK || ack_only.count == 0) { ret 215; }
    stream_byte[0] = 0xA2;
    if (transport.write_stream[binding.Binding](?dialer.driver,
        dialer_critical[2], ?stream_byte[0], 1).count != 1) { ret 216; }
    if (carry(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
        dialer_endpoint(), ?clock, ?moved) != 0) { ret refusal(); }
    clock = clock + 1000;
    val superseded: transport.Completion =
        transport.complete_send[binding.Binding](?listener.driver,
        ack_only.token, transport.SEND_SENT, ack_only.count, instants.instant(clock));
    if (superseded.status != transport.STATUS_OK ||
        transport.snapshot[binding.Binding](?listener.driver).state !=
        transport.ACTIVE) { ret 217; }
    # the ack-only packet is now the largest the dialer has received; when its
    # delayed ack fires it acknowledges that number, which the listener never
    # tracked for loss, and the listener must accept it
    var ack_datagram: transport.Datagram;
    ack_datagram.local       = dialer_endpoint();
    ack_datagram.peer        = listener_endpoint();
    ack_datagram.data        = ?ack_wire[0];
    ack_datagram.length      = ack_only.count;
    ack_datagram.received_at = instants.instant(clock);
    ack_datagram.ecn         = 0;
    if (transport.receive_datagram[binding.Binding](?dialer.driver,
        ?ack_datagram).status != transport.STATUS_OK) { ret 218; }
    clock = clock + 100000000;
    var reply_wire: [1500]u8;
    val reply:      transport.Generated =
        checked_generate(?dialer, ?dialer_scope,
        ?reply_wire[0], 1500, instants.instant(clock), 0);
    if (reply.status != transport.STATUS_OK || reply.count == 0) { ret 219; }
    clock = clock + 1000;
    if (transport.complete_send[binding.Binding](?dialer.driver, reply.token,
        transport.SEND_SENT, reply.count, instants.instant(clock)).status != transport.STATUS_OK) {
        ret 219;
    }
    var reply_datagram: transport.Datagram;
    reply_datagram.local       = listener_endpoint();
    reply_datagram.peer        = dialer_endpoint();
    reply_datagram.data        = ?reply_wire[0];
    reply_datagram.length      = reply.count;
    reply_datagram.received_at = instants.instant(clock);
    reply_datagram.ecn         = 0;
    if (transport.receive_datagram[binding.Binding](?listener.driver,
        ?reply_datagram).status != transport.STATUS_OK ||
        transport.snapshot[binding.Binding](?listener.driver).state !=
        transport.ACTIVE) { ret 220; }
    if (pump(?clock, ?moved, 4) != 0) { ret refusal(); }
    if (!transport.cancel_connection[binding.Binding](?dialer.driver) ||
        !transport.cancel_connection[binding.Binding](?listener.driver)) { ret 213; }
    # the abortive cancel drained the listener at once; releasing its streams
    # is still the owner's call and must succeed in every closing state
    i = 0;
    for (i < 13) {
        if (transport.release_stream[binding.Binding](?listener.driver,
            accepted_streams[i]).status != transport.STATUS_OK) { ret 224; }
        i = i + 1;
    }
    i = 0;
    for (i < 3) {
        if (transport.release_stream[binding.Binding](?listener.driver,
            listener_critical[i]).status != transport.STATUS_OK) { ret 225; }
        i = i + 1;
    }
    if (transport.snapshot[binding.Binding](?listener.driver).active_streams != 0) {
        ret 226;
    }
    if (transport.finish_close[binding.Binding](?dialer.driver).status !=
        transport.STATUS_OK) { ret 214; }
    if (transport.finish_close[binding.Binding](?listener.driver).status !=
        transport.STATUS_OK) { ret 216; }
    if (assembly.routing_snapshot(?listener).active != 0 ||
        assembly.route_valid(?listener, ?route) ||
        listener_api.release_connection(?front, accepted.charge).action !=
        listener_api.ACTION_ACCEPT || !listener_api.begin_close(?front) ||
        !listener_api.finish_close(?front)) {
        ret 215;
    }
    if (!assembly.release_closed(?dialer) ||
        !assembly.release_closed(?listener) || dialer.initialized ||
        listener.initialized || !dialer.released || !listener.released ||
        !assembly.release_closed(?dialer) ||
        !assembly.release_closed(?listener) ||
        !operation_ok(cancel.destroy(?dialer_scope)) || !operation_ok(cancel.destroy(?listener_scope))) {
        ret 223;
    }

    # the same stable records now serve a second real client/server generation
    if (!client.init(?dialer_tls_two, ?dialer_tls_config, assembly.tls_lease(?dialer),
        client.ExtraExtension{kind: client.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?dialer_parameters[0],
        len:  dialer_encoded}},
        client.QUIC_TRANSPORT_PARAMETERS) ||
        !operation_ok(cancel.make_root(?dialer_scope, opt[time.Instant].none{})) ||
        !operation_ok(cancel.make_root(?listener_scope, opt[time.Instant].none{}))) { ret 224; }
    val redialed: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls_two, ?dialer_scope,
        instants.instant(clock + 1000));
    if (!redialed.ok || redialed.core.reason != core.INIT_OK) { ret 225; }
    clock = clock + 2000;
    val third: transport.Generated = checked_generate(?dialer, ?dialer_scope, ?wire[0], 1500, instants.instant(clock), 0);
    if (third.status != transport.STATUS_OK ||
        third.token.index != first.token.index ||
        third.token.generation == first.token.generation ||
        transport.complete_send[binding.Binding](?dialer.driver, first.token,
        transport.SEND_SENT, first.count, instants.instant(clock + 1000)).status !=
        transport.STATUS_STALE ||
        transport.complete_send[binding.Binding](?dialer.driver, third.token,
        transport.SEND_SENT, third.count, instants.instant(clock + 2000)).status !=
        transport.STATUS_OK) { ret 226; }

    var direct: listener_api.Accepted;
    direct.action               = listener_api.ACTION_ACCEPT;
    direct.original_destination = connection_id(?initial_destination[0], 8);
    direct.initial_destination  = connection_id(?initial_destination[0], 8);
    direct.initial_source       = connection_id(?dialer_source[0], 8);
    direct.peer                 = dialer_endpoint();
    direct.version              = packet_api.VERSION_1;
    direct.peer_validated       = true;
    var listener_config_two: assembly.Config = connection_config(
        transport.SERVER);
    if (!assembly.apply_server_acceptance(?listener_config_two, ?direct)) {
        ret 227;
    }
    val listener_encoded_two: usize = assembly.encode_parameters(
        ?listener_config_two, transport.SERVER, ?listener_parameters[0], 512).count;
    if (listener_encoded_two == 0 || !server.init(?listener_tls_two,
        ?listener_tls_config, assembly.tls_lease(?listener),
        server.ExtraExtension{kind: server.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?listener_parameters[0],
        len:  listener_encoded_two}},
        server.QUIC_TRANSPORT_PARAMETERS)) { ret 228; }
    cancel.cancel(?listener_scope);
    val refused_two: assembly.InitResult = assembly.init_server(?listener,
        ?listener_config_two, ?listener_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?listener_tls_two,
        ?listener_scope, instants.instant(clock + 2000));
    if (refused_two.ok || refused_two.stage != assembly.STAGE_DRIVER ||
        listener.initialized || !listener.released ||
        !assembly.reusable(?listener) ||
        assembly.routing_snapshot(?listener).initialized ||
        !server.destroy(?listener_tls_two) ||
        !operation_ok(cancel.destroy(?listener_scope)) ||
        !server.init(?listener_tls_two,
        ?listener_tls_config, assembly.tls_lease(?listener),
        server.ExtraExtension{kind: server.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?listener_parameters[0],
        len:  listener_encoded_two}},
        server.QUIC_TRANSPORT_PARAMETERS) ||
        !operation_ok(cancel.make_root(?listener_scope, opt[time.Instant].none{}))) { ret 235; }
    val reserved_two: assembly.InitResult = assembly.init_server(?listener,
        ?listener_config_two, ?listener_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?listener_tls_two,
        ?listener_scope, instants.instant(clock + 2000));
    if (!reserved_two.ok || reserved_two.core.reason != core.INIT_OK) { ret 229; }
    val route_two: assembly.Route = assembly.route_at(?listener, 0);
    if (!route_two.active || route_two.generation == route.generation ||
        assembly.route_valid(?listener, ?route)) { ret 230; }
    var direct_datagram: transport.Datagram;
    direct_datagram.local       = listener_endpoint();
    direct_datagram.peer        = dialer_endpoint();
    direct_datagram.data        = ?wire[0];
    direct_datagram.length      = third.count;
    clock                       = clock + 3000;
    direct_datagram.received_at = instants.instant(clock);
    val received_initial_two: transport.OperationResult =
        transport.receive_datagram[binding.Binding](?listener.driver,
        ?direct_datagram);
    if (received_initial_two.status != transport.STATUS_OK) { ret 234; }
    if (exchange(?clock, ?moved, 24) != 0)                  { ret refusal(); }
    val reused: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    var reused_bytes: [4]u8 = [4]u8{'n', 'e', 'x', 't'};
    if (reused.status != transport.STATUS_OK ||
        transport.write_stream[binding.Binding](?dialer.driver, reused.stream,
        ?reused_bytes[0], 4).count != 4 ||
        transport.finish_stream[binding.Binding](?dialer.driver,
        reused.stream).status != transport.STATUS_OK ||
        pump(?clock, ?moved, 12) != 0) { ret 231; }
    val received_two: transport.OpenResult =
        transport.accept_stream[binding.Binding](?listener.driver);
    var received_bytes: [4]u8;
    val read_two:       transport.ReadResult = transport.read_stream[binding.Binding](
        ?listener.driver, received_two.stream, ?received_bytes[0], 4);
    if (received_two.status != transport.STATUS_OK ||
        read_two.status != transport.STATUS_OK || read_two.count != 4 ||
        !read_two.fin || received_bytes[0] != 'n' ||
        received_bytes[3] != 't') { ret 232; }
    if (!transport.cancel_connection[binding.Binding](?dialer.driver) ||
        !transport.cancel_connection[binding.Binding](?listener.driver) ||
        transport.finish_close[binding.Binding](?dialer.driver).status !=
        transport.STATUS_OK ||
        transport.finish_close[binding.Binding](?listener.driver).status !=
        transport.STATUS_OK || !assembly.release_closed(?dialer) ||
        !assembly.release_closed(?listener) ||
        !operation_ok(cancel.destroy(?dialer_scope)) || !operation_ok(cancel.destroy(?listener_scope))) {
        ret 233;
    }

    var rollback_probe: RollbackProbe;
    rollback_probe.attempt_state = (?dialer.streams.active_attempts)::*u8;
    rollback_probe.armed         = true;
    var rollback_entropy_source: secret.Entropy = secret.Entropy{
        context: (?rollback_probe)::ptr, secret_context: nil,
        fill_fn:                                         rollback_entropy, initialized: true
    };
    var rollback_tls_config: config.ClientConfig = dialer_tls_config;
    rollback_tls_config.entropy              = ?rollback_entropy_source;
    rollback_tls_config.entropy_context_size = $size_of(RollbackProbe);
    var rollback_config: assembly.Config = connection_config(transport.CLIENT);
    rollback_config.entropy_context_size = $size_of(RollbackProbe);
    if (!client.init(?rollback_tls, ?rollback_tls_config, assembly.tls_lease(?dialer),
        client.ExtraExtension{kind: client.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?dialer_parameters[0],
        len:  dialer_encoded}},
        client.QUIC_TRANSPORT_PARAMETERS) ||
        !operation_ok(cancel.make_root(?dialer_scope, opt[time.Instant].none{}))) { ret 239; }
    val retained: assembly.InitResult = assembly.init_client(?dialer,
        ?rollback_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?rollback_tls, ?dialer_scope, instants.instant(clock + 1000));
    val retained_storage_generation: u64 = dialer_storage.generation;
    if (retained.ok || retained.stage != assembly.STAGE_CORE ||
        retained.core.reason != core.INIT_PROVIDER_START ||
        !retained.cleanup_retained || rollback_probe.calls != 1 ||
        dialer.initialized || dialer.released || assembly.reusable(?dialer) ||
        dialer.storage != ?dialer_storage || dialer.scratch != ?pump_scratch ||
        !dialer_storage.leased || !scratch.idle(?pump_scratch, ?pump_secret) ||
        dialer_storage.source != rollback_config.source ||
        dialer.streams.active_attempts != 1 ||
        dialer.handshake_block.data == nil) { ret 240; }
    val repeated: assembly.InitResult = assembly.init_client(?dialer,
        ?rollback_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?rollback_tls, ?dialer_scope, instants.instant(clock + 1000));
    val public_retained: assembly.InitResult = assembly.init_client(?competing,
        ?rollback_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?rollback_tls, ?dialer_scope, instants.instant(clock + 1000));
    val scratch_retained: assembly.InitResult = assembly.init_client(?competing,
        ?rollback_config, ?listener_storage, (?listener_storage)::*assembly.Scratch,
        ?pump_secret, test_chunks(),
        ?rollback_tls, ?dialer_scope, instants.instant(clock + 1000));
    if (repeated.stage != assembly.STAGE_STORAGE ||
        !repeated.cleanup_retained ||
        public_retained.stage != assembly.STAGE_STORAGE ||
        scratch_retained.stage != assembly.STAGE_STORAGE ||
        public_retained.cleanup_retained || scratch_retained.cleanup_retained ||
        competing.storage != nil || competing.scratch != nil ||
        listener_storage.leased ||
        dialer_storage.generation != retained_storage_generation) {
        ret 241;
    }
    dialer.streams.active_attempts = 0;
    # a connection torn down before its handshake gives the block back
    if (!assembly.release_closed(?dialer) || !assembly.reusable(?dialer) ||
        dialer.handshake_block.data != nil || dialer.account.open ||
        dialer.storage != nil || dialer.scratch != nil ||
        dialer.secret_scratch != nil || dialer_storage.leased ||
        dialer_storage.source != 0 || !scratch.idle(?pump_scratch, ?pump_secret) ||
        dialer_storage.generation != retained_storage_generation) {
        ret 242;
    }
    if (!assembly.release_closed(?dialer) ||
        dialer_storage.generation != retained_storage_generation ||
        !client.destroy(?rollback_tls) || !operation_ok(cancel.destroy(?dialer_scope))) {
        ret 243;
    }
    ct.zeroize(?token_key[0], 32);
    ret 0;
}

test "quic.connection.assembly: public storage supports ordinary dynamic pools" {
    val count:   usize             = 2;
    val bytes:   usize             = $size_of(assembly.Storage) * count;
    val storage: *assembly.Storage = os.allocate(bytes)::*assembly.Storage;
    if (storage == nil || storage::usize % $align_of(assembly.Storage) != 0) {
        ret 1;
    }
    storage[0].source            = 71;
    storage[1].source            = 72;
    storage[0].close_reason[0]   = 0xA5;
    storage[1].close_reason[255] = 0x5A;
    if (storage[0].source != 71 || storage[1].source != 72 ||
        ?storage[0] == ?storage[1] ||
        ?storage[0].close_reason[0] == ?storage[1].close_reason[0] ||
        os.deallocate(storage::ptr, bytes) != 0) { ret 2; }
    ret 0;
}

test "quic.connection.assembly: typed secret pools retain wiped deallocation for retry" {
    var control_owner: secret.ArrayAllocator[assembly.Connection] =
        secret.system_array_allocator[assembly.Connection]();
    secret_storage_delegate =
        secret.system_array_allocator[assembly.SecretScratch]();
    secret_storage_deallocations    = 0;
    secret_storage_zeroed_releases  = 0;
    secret_storage_nonzero_releases = 0;
    var storage_owner: secret.ArrayAllocator[assembly.SecretScratch] =
        secret.ArrayAllocator[assembly.SecretScratch]{context: nil,
        secret_context: nil, allocate_fn: secret_storage_allocate,
        deallocate_fn:  secret_storage_deallocate, initialized: true};
    var controls: secret.SecretArray[assembly.Connection] =
        secret.empty_array[assembly.Connection]();
    var storage: secret.SecretArray[assembly.SecretScratch] =
        secret.empty_array[assembly.SecretScratch]();
    if (secret.init_array[assembly.Connection](?controls, ?control_owner, 2) !=
        contracts.OK ||
        secret.init_array[assembly.SecretScratch](?storage, ?storage_owner, 2) !=
        contracts.OK) { ret 1; }
    val control_data: *assembly.Connection =
        secret.array_data[assembly.Connection](?controls);
    val storage_data: *assembly.SecretScratch =
        secret.array_data[assembly.SecretScratch](?storage);
    if (control_data == nil || storage_data == nil) { ret 2; }
    control_data[0].local_parameter_length                       = 77;
    control_data[0].secrets.initial_keys.client.secret[0]        = 0xA5;
    storage_data[0].holder                                       = 41;
    storage_data[0].receive_plaintext[0]                         = 0x5A;
    storage_data[1].send_plaintext[assembly.MAX_UDP_PAYLOAD - 1] = 0xC3;
    if (secret.destroy_array[assembly.Connection](?controls) != contracts.OK ||
        secret.destroy_array[assembly.SecretScratch](?storage) !=
        contracts.DEALLOCATION_FAILED ||
        !secret.array_cleanup_pending[assembly.SecretScratch](?storage) ||
        secret.array_active[assembly.SecretScratch](?storage) ||
        secret.array_data[assembly.SecretScratch](?storage) != nil ||
        storage.data == nil || storage.data[0].receive_plaintext[0]:>u8 != 0 ||
        secret_storage_deallocations != 1 ||
        secret_storage_zeroed_releases != 1 ||
        secret_storage_nonzero_releases != 0) { ret 3; }
    if (secret.destroy_array[assembly.SecretScratch](?storage) != contracts.OK ||
        secret_storage_deallocations != 2 ||
        secret_storage_zeroed_releases != 2 ||
        secret_storage_nonzero_releases != 0 ||
        secret.destroy_array[assembly.Connection](?controls) != contracts.OK ||
        secret.destroy_array[assembly.SecretScratch](?storage) != contracts.OK) {
        ret 4;
    }
    ret 0;
}

var response_bytes: [1400]u8;
var reply_bytes:    [1400]u8;

# a direct server acceptance with no retry, so the test drives only the path
# under scrutiny
fun establish_direct(dialer_payload: usize, listener_payload: usize,
    dialer_cid: usize, clock: *u64, moved: *usize) i32 {
    var owner:         secret.Allocator = secret.system_allocator();
    var chain_storage: [1]cert.Certificate;
    var key:           keys.PrivateKey;
    var identity:      credentials.Identity;
    if (!test_credentials.load_credentials(?identity, ?chain_storage[0], ?key,
        ?owner)) { ret 1; }
    var generation: credentials.Generation = credentials.empty_generation();
    if (credentials.initialize(?generation, ?identity, 1, 0, nil,
        false) != contracts.OK) { ret 2; }
    var store: credentials.Store = credentials.empty_store();
    if (credentials.initialize_store(?store, ?generation) != contracts.OK) {
        ret 3;
    }
    var versions: [1]u16               = [1]u16{tls13.VERSION};
    var suites:   [1]tls13.CipherSuite =
        [1]tls13.CipherSuite{tls13.AES_128_GCM_SHA256};
    var groups:     [1]tls13.NamedGroup      = [1]tls13.NamedGroup{tls13.X25519};
    var signatures: [1]tls13.SignatureScheme =
        [1]tls13.SignatureScheme{tls13.ED25519};
    var protocols: [1]config.ProtocolName = [1]config.ProtocolName{
        config.ProtocolName{data: ?alpn[0], len: 2}
    };

    var dialer_config: assembly.Config = connection_config(transport.CLIENT);
    dialer_config.max_udp_payload     = dialer_payload;
    dialer_config.local_source_length = dialer_cid;
    val dialer_encoded: usize = assembly.encode_parameters(?dialer_config,
        transport.CLIENT, ?dialer_parameters[0], 512).count;
    if (dialer_encoded == 0) { ret 4; }

    var listener_counter: u8             = 3;
    var listener_entropy: secret.Entropy = secret.Entropy{
        context: ?listener_counter, secret_context: nil,
        fill_fn: test_credentials.deterministic_entropy, initialized: true
    };
    var listener_tls_config: config.ServerConfig;
    listener_tls_config.credentials                     = ?store;
    listener_tls_config.alpn                            = ?protocols[0];
    listener_tls_config.alpn_len                        = 1;
    listener_tls_config.require_alpn                    = true;
    listener_tls_config.versions                        = ?versions[0];
    listener_tls_config.version_len                     = 1;
    listener_tls_config.suites                          = ?suites[0];
    listener_tls_config.suite_len                       = 1;
    listener_tls_config.groups                          = ?groups[0];
    listener_tls_config.group_len                       = 1;
    listener_tls_config.signatures                      = ?signatures[0];
    listener_tls_config.signature_len                   = 1;
    listener_tls_config.entropy                         = ?listener_entropy;
    listener_tls_config.entropy_context_size            = 1;
    listener_tls_config.limits                          = config.production_limits();
    listener_tls_config.clock                           = test_credentials.test_clock();
    listener_tls_config.limits.max_peer_handshake_bytes = 8192;
    listener_tls_config.limits.max_client_hello_bytes   = 8192;
    listener_tls_config.limits.max_client_flight_bytes  = 8192;
    listener_tls_config.limits.max_server_flight_bytes  = 8192;
    listener_tls_config.limits.max_chain_bytes          = 4096;
    listener_tls_config.limits.max_ticket_bytes         = 4096;
    var anchor:         cert.Certificate = test_credentials.anchor();
    var trust:          cert.TrustStore  = cert.TrustStore{anchors: ?anchor, len: 1};
    var dialer_counter: u8               = 91;
    var dialer_entropy: secret.Entropy   = secret.Entropy{
        context: ?dialer_counter, secret_context: nil,
        fill_fn: test_credentials.deterministic_entropy, initialized: true
    };
    var dialer_tls_config: config.ClientConfig;
    dialer_tls_config.server_name = contracts.Bytes{data: ?server_name[0],
        len: 15};
    dialer_tls_config.alpn                            = ?protocols[0];
    dialer_tls_config.alpn_len                        = 1;
    dialer_tls_config.trust                           = ?trust;
    dialer_tls_config.versions                        = ?versions[0];
    dialer_tls_config.version_len                     = 1;
    dialer_tls_config.suites                          = ?suites[0];
    dialer_tls_config.suite_len                       = 1;
    dialer_tls_config.groups                          = ?groups[0];
    dialer_tls_config.group_len                       = 1;
    dialer_tls_config.signatures                      = ?signatures[0];
    dialer_tls_config.signature_len                   = 1;
    dialer_tls_config.client_identity                 = nil;
    dialer_tls_config.entropy                         = ?dialer_entropy;
    dialer_tls_config.entropy_context_size            = 1;
    dialer_tls_config.limits                          = config.production_limits();
    dialer_tls_config.clock                           = test_credentials.test_clock();
    dialer_tls_config.limits.max_peer_handshake_bytes = 8192;
    dialer_tls_config.limits.max_client_hello_bytes   = 8192;
    dialer_tls_config.limits.max_client_flight_bytes  = 8192;
    dialer_tls_config.limits.max_chain_bytes          = 4096;
    dialer_tls_config.limits.max_ticket_bytes         = 4096;
    val engine_ready: bool = client.init(?dialer_tls, ?dialer_tls_config,
        dialer_engine_lease(),
        client.ExtraExtension{kind: client.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?dialer_parameters[0],
        len:  dialer_encoded}},
        client.QUIC_TRANSPORT_PARAMETERS);
    if (engine_ready == (mislease == LEASE_NONE)) { ret 5; }
    if (!operation_ok(cancel.make_root(?listener_scope, opt[time.Instant].none{})) ||
        !operation_ok(cancel.make_root(?dialer_scope, opt[time.Instant].none{}))) {
        ret 6;
    }
    if (starving && !hog()) { ret 39; }
    # the lane fault lands after the parameters were encoded, so only init sees it
    if (lane_fault != LANES_OK) {
        dialer_config.extra_budgets = ?composed_budgets[0];
        dialer_config.extra_lanes   = 1;
        if (lane_fault == LANES_OVER) { dialer_config.extra_lanes = supply.MAX_EXTRA_LANES + 1; }
    }
    val dialed: assembly.InitResult = assembly.init_client(?dialer,
        ?dialer_config, ?dialer_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?dialer_tls, ?dialer_scope, instants.instant(clock[0]));
    if (mislease != LEASE_OWN) {
        if (dialed.ok || dialed.stage != assembly.STAGE_HANDSHAKE ||
            !assembly.reusable(?dialer) || dialer.account.open) { ret 8; }
        ret REFUSED;
    }
    if (lane_fault == LANES_OVER) {
        if (dialed.ok || dialed.stage != assembly.STAGE_CONFIG || dialer.account.open) { ret 8; }
        ret REFUSED;
    }
    if (lane_fault == LANES_MISMATCH) {
        if (dialed.ok || dialed.stage != assembly.STAGE_STORAGE || dialer.account.open ||
            dialer.storage != nil || dialer.provider.ctx != nil) { ret 8; }
        ret REFUSED;
    }
    if (!dialed.ok || dialed.core.reason != core.INIT_OK) { ret 7; }
    if (starving) {
        val starved: i32 = starved_start(clock);
        if (starved != 0) { ret starved; }
    }

    clock[0] = clock[0] + 1000;
    val first: transport.Generated = checked_generate(?dialer, ?dialer_scope, ?wire[0], 1500, instants.instant(clock[0]), 0);
    clock[0] = clock[0] + 1000;
    if (first.status != transport.STATUS_OK || first.count < 1200 ||
        transport.complete_send[binding.Binding](?dialer.driver, first.token,
        transport.SEND_SENT, first.count, instants.instant(clock[0])).status !=
        transport.STATUS_OK) { ret 8; }
    if (refusing) {
        val closed: i32 = refused_start(clock, first.count);
        if (closed != 0) { ret closed; }
        ret REFUSAL_CLOSED;
    }

    var direct: listener_api.Accepted;
    direct.action               = listener_api.ACTION_ACCEPT;
    direct.original_destination = connection_id(?initial_destination[0], 8);
    direct.initial_destination  = connection_id(?initial_destination[0], 8);
    direct.initial_source       = connection_id(?dialer_source[0], dialer_cid);
    direct.peer                 = dialer_endpoint();
    direct.version              = packet_api.VERSION_1;
    direct.peer_validated       = true;
    var listener_config: assembly.Config = connection_config(transport.SERVER);
    listener_config.max_udp_payload = listener_payload;
    if (!assembly.apply_server_acceptance(?listener_config, ?direct)) { ret 9; }
    val listener_encoded: usize = assembly.encode_parameters(?listener_config,
        transport.SERVER, ?listener_parameters[0], 512).count;
    if (listener_encoded == 0 || !server.init(?listener_tls,
        ?listener_tls_config, assembly.tls_lease(?listener),
        server.ExtraExtension{kind: server.QUIC_TRANSPORT_PARAMETERS,
        data: contracts.Bytes{data: ?listener_parameters[0],
        len:  listener_encoded}},
        server.QUIC_TRANSPORT_PARAMETERS)) { ret 10; }
    val served: assembly.InitResult = assembly.init_server(?listener,
        ?listener_config, ?listener_storage, ?pump_scratch, ?pump_secret, test_chunks(),
        ?listener_tls, ?listener_scope, instants.instant(clock[0]));
    # handshake-only state is held until the handshake is confirmed
    if (!served.ok || served.core.reason != core.INIT_OK ||
        listener.handshake_block.data == nil ||
        listener.core.storage.handshake_block != ?listener.handshake_block) { ret 11; }
    var initial: transport.Datagram;
    initial.local       = listener_endpoint();
    initial.peer        = dialer_endpoint();
    initial.data        = ?wire[0];
    initial.length      = first.count;
    clock[0]            = clock[0] + 1000;
    initial.received_at = instants.instant(clock[0]);
    if (transport.receive_datagram[binding.Binding](?listener.driver,
        ?initial).status != transport.STATUS_OK) { ret 12; }
    if (exchange(clock, moved, 24) != 0) { ret refusal(); }
    if (dialer.handshake_block.data != nil || listener.handshake_block.data != nil ||
        dialer.core.storage.handshake_block != nil ||
        listener.core.storage.negotiation.retry_token != nil ||
        dialer.core.negotiation.storage.retry_pseudo != nil ||
        dialer.core.peer_parameters.extensions != nil ||
        listener.core.local_parameters.extensions != nil ||
        dialer.core.storage.ack_handshake.ranges != nil ||
        listener.core.acknowledgements.spaces[0].ranges != nil ||
        listener.core.acknowledgements.spaces[1].capacity != 0) { ret 13; }
    ret 0;
}

fun drain_stream(driver: *transport.Driver[binding.Binding], value: transport.Stream,
    output: *u8, capacity: usize, fin: *bool) usize {
    var total: usize = 0;
    for (total < capacity) {
        val read: transport.ReadResult = transport.read_stream[binding.Binding](
            driver, value, ?output[total], capacity - total);
        if (read.status != transport.STATUS_OK) { ret total; }
        total = total + read.count;
        if (read.fin) {
            @fin = true;
            ret total;
        }
        if (read.count == 0) { ret total; }
    }
    ret total;
}

# the server's control and qpack streams open before the client has opened
# anything, as an h3 server facing quic-go does, and the response is larger
# than the base mtu
fun stream_flow(dialer_payload: usize, listener_payload: usize,
    dialer_cid: usize) i32 {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(dialer_payload, listener_payload,
        dialer_cid, ?clock, ?moved);
    if (established != 0) { ret established; }

    var sizes:    [3]usize = [3]usize{11, 1, 1};
    var critical: [3]transport.Stream;
    var i:        usize    = 0;
    for (i < 3) {
        val opened: transport.OpenResult = transport.open_stream[binding.Binding](
            ?listener.driver, transport.UNIDIRECTIONAL);
        if (opened.status != transport.STATUS_OK) { ret 20; }
        critical[i] = opened.stream;
        if (transport.write_stream[binding.Binding](?listener.driver,
            critical[i], ?response_bytes[0], sizes[i]).count != sizes[i]) { ret 21; }
        i = i + 1;
    }
    var request_byte: [1]u8                = [1]u8{'q'};
    val request:      transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (request.status != transport.STATUS_OK ||
        transport.write_stream[binding.Binding](?dialer.driver, request.stream,
        ?request_byte[0], 1).count != 1 ||
        transport.finish_stream[binding.Binding](?dialer.driver,
        request.stream).status != transport.STATUS_OK) { ret 22; }
    if (pump(?clock, ?moved, 8) != 0) { ret refusal(); }

    val accepted: transport.OpenResult =
        transport.accept_stream[binding.Binding](?listener.driver);
    if (accepted.status != transport.STATUS_OK) { ret 23; }
    i = 0;
    for (i < 1400) {
        response_bytes[i] = (i % 251)::u8;
        i                 = i + 1;
    }
    if (transport.write_stream[binding.Binding](?listener.driver,
        accepted.stream, ?response_bytes[0], 1400).count != 1400 ||
        transport.finish_stream[binding.Binding](?listener.driver,
        accepted.stream).status != transport.STATUS_OK) { ret 24; }
    if (pump(?clock, ?moved, 16) != 0) { ret refusal(); }

    i = 0;
    for (i < 3) {
        val peer_stream: transport.OpenResult =
            transport.accept_stream[binding.Binding](?dialer.driver);
        if (peer_stream.status != transport.STATUS_OK) { ret 25; }
        var fin: bool = false;
        if (drain_stream(?dialer.driver, peer_stream.stream, ?reply_bytes[0],
            1400, ?fin) != sizes[i]) { ret 26; }
        i = i + 1;
    }
    var fin: bool = false;
    if (drain_stream(?dialer.driver, request.stream, ?reply_bytes[0], 1400,
        ?fin) != 1400 || !fin) { ret 27; }
    i = 0;
    for (i < 1400) {
        if (reply_bytes[i] != response_bytes[i]) { ret 28; }
        i = i + 1;
    }
    ret 0;
}

test "quic.connection.assembly: streams flow when both ends declare 1200" {
    ret stream_flow(1200, 1200, 8);
}

test "quic.connection.assembly: streams flow when both ends declare 1280" {
    ret stream_flow(1280, 1280, 8);
}

test "quic.connection.assembly: streams flow when both ends declare 1452" {
    ret stream_flow(1452, 1452, 8);
}

test "quic.connection.assembly: streams flow when both ends declare 1500" {
    ret stream_flow(1500, 1500, 8);
}

test "quic.connection.assembly: streams flow when only the client declares above 1200" {
    ret stream_flow(1500, 1200, 8);
}

test "quic.connection.assembly: streams flow when only the server declares above 1200" {
    ret stream_flow(1200, 1500, 8);
}

# rfc 9000 5.1: the server addresses such a client by its path alone
test "quic.connection.assembly: a client with a zero-length connection id exchanges streams" {
    val flowed: i32 = stream_flow(1500, 1500, 0);
    if (flowed != 0) { ret flowed; }
    val route: assembly.Route = assembly.route_at(?dialer, 0);
    if (!route.active || route.id.length != 0) { ret 40; }
    ret 0;
}

var datagram_bytes: [1000]u8;

fun datagram_flow() i32 {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 4) != 0) { ret refusal(); }
    val sending:   usize = supply.held(?dialer.account, supply.SEND);
    val receiving: usize = supply.held(?listener.account, supply.RECEIVE);
    var i:         usize = 0;
    for (i < 1000) {
        datagram_bytes[i] = (i % 241)::u8;
        i                 = i + 1;
    }
    # the payload holds a chunk only from send until its packet is published
    val sent: transport.DatagramResult = transport.send_datagram[binding.Binding](
        ?dialer.driver, ?datagram_bytes[0], 1000);
    if (sent.status != transport.STATUS_OK ||
        supply.held(?dialer.account, supply.SEND) != sending + 1) { ret 21; }
    if (pump(?clock, ?moved, 4) != 0)                         { ret refusal(); }
    if (supply.held(?dialer.account, supply.SEND) != sending) { ret 22; }
    val got: transport.ReceivedDatagram = transport.next_datagram[binding.Binding](
        ?listener.driver);
    if (got.status != transport.STATUS_OK || got.data.length != 1000 ||
        got.data.data[0] != 0 || got.data.data[999] != datagram_bytes[999] ||
        supply.held(?listener.account, supply.RECEIVE) != receiving + 1) { ret 23; }
    if (transport.release_datagram[binding.Binding](?listener.driver,
        got.token).status != transport.STATUS_OK ||
        supply.held(?listener.account, supply.RECEIVE) != receiving) { ret 24; }
    ret 0;
}

test "quic.connection.assembly: an application datagram holds chunks only while queued" {
    datagram_frame_size = assembly.DATAGRAM_STRIDE;
    val flowed: i32 = datagram_flow();
    datagram_frame_size = 0;
    ret flowed;
}

var bulk_bytes: [4096]u8;

# one datagram moved at a frozen instant, so only the pacer's budget changes
fun hop(source: *assembly.Connection, sink: *assembly.Connection,
    source_scope: *cancel.Scope, sink_local: ip.Endpoint, sink_peer: ip.Endpoint,
    now_ns: u64) u8 {
    val generated: transport.Generated =
        checked_generate(source, source_scope,
        ?wire[0], 1500, instants.instant(now_ns), 0);
    if (generated.status != transport.STATUS_OK) { ret generated.status; }
    if (transport.complete_send[binding.Binding](?source.driver,
        generated.token, transport.SEND_SENT, generated.count,
        instants.instant(now_ns)).status != transport.STATUS_OK) { ret transport.STATUS_ERROR; }
    var input: transport.Datagram;
    input.local       = sink_local;
    input.peer        = sink_peer;
    input.data        = ?wire[0];
    input.length      = generated.count;
    input.received_at = instants.instant(now_ns);
    if (transport.receive_datagram[binding.Binding](?sink.driver,
        ?input).status != transport.STATUS_OK) { ret transport.STATUS_ERROR; }
    ret transport.STATUS_OK;
}

test "quic.connection.assembly: a pacing delay arms the connection timer" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(assembly.MAX_UDP_PAYLOAD,
        assembly.MAX_UDP_PAYLOAD, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?listener.driver, transport.UNIDIRECTIONAL);
    if (opened.status != transport.STATUS_OK ||
        transport.write_stream[binding.Binding](?listener.driver,
        opened.stream, ?bulk_bytes[0], 4096).count != 4096) { ret 20; }
    # an exhausted budget at the current instant leaves the pacer alone
    # holding the next packet
    val now:   u64              = clock + 1000;
    val pacer: *pacer_api.State = ?listener.storage.path_values[0].pacer;
    pacer.budget         = 0.0;
    pacer.last_update_ns = now;
    if (hop(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
        listener_endpoint(), now) != transport.STATUS_BLOCKED) { ret 21; }
    val paced: u64 = listener.core.pace_deadline_ns;
    if (paced <= now) { ret 22; }
    # output held by the pacer is pending only from the instant it is ready
    if (output_pending(?listener, now) || output_pending(?listener, paced - 1) ||
        !output_pending(?listener, paced)) { ret 26; }
    val timer: transport.Timer = transport.timer[binding.Binding](?listener.driver);
    if (!timer.armed || instants.nanos(timer.deadline) != paced) { ret 23; }
    if (transport.on_timeout[binding.Binding](?listener.driver, timer,
        instants.instant(paced)).status != transport.STATUS_OK ||
        listener.core.pace_deadline_ns != 0) { ret 24; }
    if (hop(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
        listener_endpoint(), paced) != transport.STATUS_OK) { ret 25; }
    ret 0;
}

# one stream byte from the source, carried at the current instant
fun send_byte(source: *assembly.Connection, sink: *assembly.Connection,
    source_scope: *cancel.Scope, sink_local: ip.Endpoint, sink_peer: ip.Endpoint,
    value: transport.Stream, clock: *u64) u8 {
    var byte: [1]u8 = [1]u8{0x5A};
    if (transport.write_stream[binding.Binding](?source.driver, value,
        ?byte[0], 1).count != 1) { ret transport.STATUS_ERROR; }
    clock[0] = clock[0] + 1000;
    ret hop(source, sink, source_scope, sink_local, sink_peer, clock[0]);
}

fun secret_clear(data: *^u8, length: usize) bool {
    var i: usize = 0;
    for (i < length) {
        if (data[i]:>u8 != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "quic.connection.assembly: a NEW_TOKEN holds a chunk only while it waits" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    val quiet: i32 = settle(?clock, ?moved);
    if (quiet != 0) { ret quiet; }
    val sending:   usize = supply.held(?listener.account, supply.SEND);
    val receiving: usize = supply.held(?dialer.account, supply.RECEIVE);
    var token:     [40]u8;
    var i:         usize = 0;
    for (i < 40) {
        token[i] = (i * 7)::u8;
        i        = i + 1;
    }
    if (core.queue_new_token(?dialer.core, ?token[0], 40) != transport.STATUS_ERROR ||
        core.queue_new_token(?listener.core, ?token[0], 40) != transport.STATUS_OK ||
        core.queue_new_token(?listener.core, ?token[0], 40) != transport.STATUS_EARLY ||
        !core.snapshot(?listener.core).new_token_pending ||
        supply.held(?listener.account, supply.SEND) != sending + 1) { ret 20; }
    # the token's chunk was taken after init, and is owned from then on
    if (core.queue_new_token(?listener.core, listener.core.send_token.data, 40) !=
        transport.STATUS_ERROR) { ret 25; }
    var empty: [1]u8;
    if (core.take_received_token(?dialer.core, ?empty[0], 1).status !=
        transport.STATUS_EMPTY) { ret 21; }
    val settled: i32 = settle(?clock, ?moved);
    if (settled != 0) { ret settled; }
    # the acknowledged token is gone from the server, and waits at the client
    if (supply.held(?listener.account, supply.SEND) != sending ||
        supply.held(?dialer.account, supply.RECEIVE) != receiving + 1 ||
        core.snapshot(?dialer.core).received_token_length != 40 ||
        core.snapshot(?listener.core).new_token_pending) { ret 22; }
    val aliased: core.TakenToken = core.take_received_token(?dialer.core,
        dialer.core.received_token.data, 64);
    if (aliased.status != transport.STATUS_ERROR ||
        core.snapshot(?dialer.core).received_token_length != 40) { ret 26; }
    var small:  [8]u8;
    var output: [64]u8;
    val short:  core.TakenToken = core.take_received_token(?dialer.core, ?small[0], 8);
    if (short.status != transport.STATUS_ERROR || short.length != 40 ||
        supply.held(?dialer.account, supply.RECEIVE) != receiving + 1) { ret 23; }
    val taken: core.TakenToken = core.take_received_token(?dialer.core, ?output[0], 64);
    if (taken.status != transport.STATUS_OK || taken.length != 40 ||
        output[0] != 0 || output[39] != token[39] ||
        supply.held(?dialer.account, supply.RECEIVE) != receiving ||
        core.take_received_token(?dialer.core, ?output[0], 64).status !=
        transport.STATUS_EMPTY) { ret 24; }
    ret 0;
}

test "quic.connection.assembly: connections sharing a scratch pair cannot run at once" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 4) != 0) { ret refusal(); }
    # both ends used the pair for the whole handshake and left nothing in it
    if (!scratch.idle(?pump_scratch, ?pump_secret) ||
        !secret_clear(?pump_secret.receive_plaintext[0], assembly.MAX_UDP_PAYLOAD) ||
        !secret_clear(?pump_secret.send_plaintext[0], assembly.MAX_UDP_PAYLOAD)) {
        ret 20;
    }
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    var byte: [1]u8 = [1]u8{0x42};
    if (opened.status != transport.STATUS_OK ||
        transport.write_stream[binding.Binding](?dialer.driver, opened.stream,
        ?byte[0], 1).count != 1) { ret 21; }
    # a call on the listener holds the pair, so the dialer's call is refused
    # before its core runs, with nothing sent and no state changed
    if (!scratch.lend(?pump_scratch, ?pump_secret, listener.core.config.source)) {
        ret 22;
    }
    val before:  transport.ConnectionState = dialer.core.state;
    val packets: u64                       = dialer.core.packet_numbers[2];
    clock = clock + 1000;
    # the query reads the core alone, so it answers while the pair is held
    if (!transport.pending_output[binding.Binding](?dialer.driver,
        instants.instant(clock))) { ret 24; }
    val refused: transport.Generated = transport.generate[binding.Binding](?dialer.driver,
        ?dialer_scope, ?wire[0], 1500, instants.instant(clock), 0);
    scratch.give_back(?pump_scratch, ?pump_secret, listener.core.config.source);
    if (refused.status != transport.STATUS_ERROR ||
        refused.error != transport.ERROR_STATE || refused.count != 0 ||
        dialer.core.state != before || dialer.core.packet_numbers[2] != packets ||
        transport.snapshot[binding.Binding](?dialer.driver).state != transport.ACTIVE) {
        ret 23;
    }
    # once the pair is free the same work goes out
    clock = clock + 1000;
    if (hop(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
        dialer_endpoint(), clock) != transport.STATUS_OK ||
        dialer.core.packet_numbers[2] != packets + 1 ||
        !scratch.idle(?pump_scratch, ?pump_secret)) { ret 25; }
    ret 0;
}

test "quic.connection.assembly: a peer key update moves our send keys before we acknowledge it" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 4) != 0) { ret refusal(); }
    val dialer_stream: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (dialer_stream.status != transport.STATUS_OK) { ret 20; }
    # a second update before the first is acknowledged is refused
    if (protection.initiate_update(?dialer.secrets.application_send) != protection.OK ||
        protection.initiate_update(?dialer.secrets.application_send) !=
        protection.KEY_UPDATE_ERROR || !dialer.secrets.application_send.phase) { ret 21; }
    if (send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
        dialer_endpoint(), dialer_stream.stream, ?clock) != transport.STATUS_OK) { ret 22; }
    # the listener switched its send keys on opening the update packet, so the
    # ack it builds next is already protected with the new phase
    if (listener.secrets.application_receive.generation != 2 ||
        listener.secrets.application_send.generation != 2 ||
        !listener.secrets.application_send.phase) { ret 23; }
    val accepted: transport.OpenResult = transport.accept_stream[binding.Binding](
        ?listener.driver);
    if (accepted.status != transport.STATUS_OK) { ret 24; }
    if (send_byte(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
        listener_endpoint(), accepted.stream, ?clock) != transport.STATUS_OK) { ret 25; }
    if (pump(?clock, ?moved, 6) != 0) { ret refusal(); }
    if (transport.snapshot[binding.Binding](?dialer.driver).state != transport.ACTIVE ||
        transport.snapshot[binding.Binding](?listener.driver).state != transport.ACTIVE ||
        !listener.secrets.application_receive.update_response_confirmed) { ret 26; }

    # once acknowledged, the peer may update again and we follow
    if (protection.initiate_update(?dialer.secrets.application_send) != protection.OK) {
        ret 27;
    }
    if (send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
        dialer_endpoint(), dialer_stream.stream, ?clock) != transport.STATUS_OK) { ret 28; }
    if (listener.secrets.application_send.generation != 3 ||
        listener.secrets.application_send.phase) { ret 29; }
    if (send_byte(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
        listener_endpoint(), accepted.stream, ?clock) != transport.STATUS_OK) { ret 30; }
    if (pump(?clock, ?moved, 6) != 0) { ret refusal(); }
    if (transport.snapshot[binding.Binding](?dialer.driver).state != transport.ACTIVE ||
        transport.snapshot[binding.Binding](?listener.driver).state != transport.ACTIVE ||
        dialer.secrets.application_receive.generation != 3) { ret 31; }
    var received: [8]u8;
    var fin:      bool = false;
    if (drain_stream(?listener.driver, accepted.stream, ?received[0], 8, ?fin) != 2 ||
        drain_stream(?dialer.driver, dialer_stream.stream, ?received[0], 8,
        ?fin) != 2) { ret 32; }
    ret 0;
}

test "quic.connection.assembly: an established connection outlives the handshake deadline" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    # the handshake finishes well inside the deadline, and the transfer
    # continues long after it
    handshake_deadline_ns = 50000000;
    val established: i32 = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0)               { ret established; }
    if (clock >= handshake_deadline_ns) { ret 20; }
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (opened.status != transport.STATUS_OK) { ret 21; }
    var sent: usize = 0;
    var i:    usize = 0;
    for (i < 8) {
        clock = clock + 20000000;
        if (send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
            dialer_endpoint(), opened.stream, ?clock) != transport.STATUS_OK) {
            ret 30 + i::i32;
        }
        if (pump(?clock, ?moved, 2) != 0) { ret refusal(); }
        sent = sent + 1;
        i    = i + 1;
    }
    if (clock <= handshake_deadline_ns ||
        transport.snapshot[binding.Binding](?dialer.driver).state != transport.ACTIVE ||
        transport.snapshot[binding.Binding](?listener.driver).state != transport.ACTIVE) {
        ret 22;
    }
    val accepted: transport.OpenResult = transport.accept_stream[binding.Binding](
        ?listener.driver);
    var received: [16]u8;
    var fin:      bool = false;
    if (accepted.status != transport.STATUS_OK ||
        drain_stream(?listener.driver, accepted.stream, ?received[0], 16,
        ?fin) != sent) { ret 23; }
    ret 0;
}

test "quic.connection.assembly: a stateless refusal drains the client in the same receive" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    refusing = true;
    val established: i32 = establish_direct(1200, 1200, 8, ?clock, ?moved);
    if (established != REFUSAL_CLOSED) { ret established; }
    ret 0;
}

test "quic.connection.assembly: an acknowledged MTU probe keeps a connection whose window passed ten datagrams" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    val path: *path_api.Path = ?listener.storage.path_values[0];
    if (path.current_mtu != 1200) { ret 20; }
    # a window larger than any pacer burst for the next probe size
    path.congestion.congestion_window = 40000;
    if (pump(?clock, ?moved, 12) != 0) { ret refusal(); }
    if (path.current_mtu <= 1200 ||
        path.congestion.congestion_window <= 10 * path.current_mtu::u64 ||
        transport.snapshot[binding.Binding](?listener.driver).state != transport.ACTIVE) {
        ret 21;
    }
    ret 0;
}

fun sent_owner(value: *assembly.Connection, number: u64) *core.Owner {
    var i: usize = 0;
    for (i < value.core.owner_capacity) {
        val owner: *core.Owner = ?value.core.owners[i];
        if (owner.state == core.OWNER_SENT && owner.space == packet_api.SPACE_APPLICATION &&
            owner.packet_number == number) { ret owner; }
        i = i + 1;
    }
    ret nil;
}

test "quic.connection.assembly: a failed recovery event still settles every owner and close completes" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1200, 1200, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 4) != 0) { ret refusal(); }
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?listener.driver, transport.UNIDIRECTIONAL);
    if (opened.status != transport.STATUS_OK) { ret 20; }
    val first: u64   = listener.core.packet_numbers[2];
    var i:     usize = 0;
    for (i < 3) {
        if (send_byte(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
            listener_endpoint(), opened.stream, ?clock) != transport.STATUS_OK) { ret 21; }
        i = i + 1;
    }
    # the middle packet's settlement fails, the others are sound
    val broken: *core.Owner = sent_owner(?listener, first + 1);
    if (broken == nil || sent_owner(?listener, first) == nil ||
        sent_owner(?listener, first + 2) == nil) { ret 22; }
    broken.bytes = 60000;
    var ack_wire: [1500]u8;
    clock = clock + 1000;
    val ack: transport.Generated = checked_generate(?dialer, ?dialer_scope, ?ack_wire[0], 1500, instants.instant(clock), 0);
    if (ack.status != transport.STATUS_OK ||
        transport.complete_send[binding.Binding](?dialer.driver, ack.token,
        transport.SEND_SENT, ack.count, instants.instant(clock)).status != transport.STATUS_OK) { ret 23; }
    var input: transport.Datagram;
    input.local       = listener_endpoint();
    input.peer        = dialer_endpoint();
    input.data        = ?ack_wire[0];
    input.length      = ack.count;
    input.received_at = instants.instant(clock);
    if (transport.receive_datagram[binding.Binding](?listener.driver,
        ?input).status != transport.STATUS_ERROR) { ret 24; }
    if (sent_owner(?listener, first) != nil || sent_owner(?listener, first + 1) != nil ||
        sent_owner(?listener, first + 2) != nil) { ret 25; }
    if (!transport.cancel_connection[binding.Binding](?listener.driver) ||
        transport.release_stream[binding.Binding](?listener.driver,
        opened.stream).status != transport.STATUS_OK ||
        transport.finish_close[binding.Binding](?listener.driver).status !=
        transport.STATUS_OK) { ret 26; }
    ret 0;
}

# a fired ack timer hands the ack to generate. reporting the same expired
# deadline again would make an owner that re-arms first spin
test "quic.connection.assembly: a fired ack timer is not reported again" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 4) != 0) { ret refusal(); }
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (opened.status != transport.STATUS_OK ||
        send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
        dialer_endpoint(), opened.stream, ?clock) != transport.STATUS_OK) { ret 20; }
    # one ack-eliciting packet leaves the listener holding a delayed ack
    val space: *ack_api.Space  = ?listener.core.acknowledgements.spaces[2];
    val armed: transport.Timer = transport.timer[binding.Binding](?listener.driver);
    if (!space.ack_pending || !space.ack_deadline_armed || !armed.armed ||
        instants.nanos(armed.deadline) != space.ack_deadline_ns) { ret 21; }
    val deadline: u64 = instants.nanos(armed.deadline);
    if (transport.on_timeout[binding.Binding](?listener.driver, armed,
        instants.instant(deadline)).status != transport.STATUS_OK) { ret 22; }
    val rearmed: transport.Timer = transport.timer[binding.Binding](?listener.driver);
    if (rearmed.armed && instants.nanos(rearmed.deadline) <= deadline) { ret 23; }
    # the ack itself still goes out on the next generate
    if (hop(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
        listener_endpoint(), deadline) != transport.STATUS_OK ||
        space.ack_pending) { ret 24; }
    ret 0;
}

fun generate_status(value: *assembly.Connection, scope: *cancel.Scope, now_ns: u64) u8 {
    var scratch:   [1500]u8;
    val generated: transport.Generated = checked_generate(value, scope, ?scratch[0], 1500, instants.instant(now_ns), 0);
    if (generated.status == transport.STATUS_OK) {
        transport.complete_send[binding.Binding](?value.driver, generated.token,
            transport.SEND_SENT, generated.count, instants.instant(now_ns));
    }
    ret generated.status;
}

# an idle connection's generate does no selection work, and every way send
# work can appear still reaches it
test "quic.connection.assembly: an idle generate does no selection work until something changes" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1200, 1200, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 8) != 0) { ret refusal(); }
    clock = clock + 1000;
    if (generate_status(?listener, ?listener_scope, clock) != transport.STATUS_EMPTY) { ret 20; }
    # a thousand idle calls cost one selection at most
    val before: u64   = listener.core.selecting_generates;
    var i:      usize = 0;
    for (i < 1000) {
        clock = clock + 1000;
        if (generate_status(?listener, ?listener_scope, clock) != transport.STATUS_EMPTY) {
            ret 21;
        }
        i = i + 1;
    }
    if (listener.core.selecting_generates != before) { ret 22; }
    # a stream write outside any core call ends the idle stretch
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?listener.driver, transport.UNIDIRECTIONAL);
    var byte: [1]u8 = [1]u8{7};
    if (opened.status != transport.STATUS_OK ||
        transport.write_stream[binding.Binding](?listener.driver, opened.stream,
        ?byte[0], 1).count != 1) { ret 23; }
    clock = clock + 1000;
    if (generate_status(?listener, ?listener_scope, clock) != transport.STATUS_OK) { ret 24; }
    if (pump(?clock, ?moved, 4) != 0)                                              { ret refusal(); }
    clock = clock + 1000;
    if (generate_status(?listener, ?listener_scope, clock) != transport.STATUS_EMPTY) { ret 25; }
    # a received packet ends it, and a delayed ack becomes due by time alone
    val request: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (request.status != transport.STATUS_OK ||
        send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
        dialer_endpoint(), request.stream, ?clock) != transport.STATUS_OK) { ret 26; }
    # an immediate ack goes out at once, so send until one is delayed
    val space:   *ack_api.Space = ?listener.core.acknowledgements.spaces[2];
    var delayed: bool           = false;
    var tries:   usize          = 0;
    for (!delayed && tries < 6) {
        if (pump(?clock, ?moved, 2) != 0) { ret refusal(); }
        if (send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
            dialer_endpoint(), request.stream, ?clock) != transport.STATUS_OK) { ret 30; }
        delayed = space.ack_pending && space.ack_deadline_armed &&
            !space.ack_immediate && space.ack_deadline_ns > clock + 1;
        tries = tries + 1;
    }
    if (!delayed) { ret 27; }
    val due: u64 = space.ack_deadline_ns;
    if (generate_status(?listener, ?listener_scope, clock + 1) != transport.STATUS_EMPTY ||
        !listener.core.send_idle) { ret 28; }
    if (generate_status(?listener, ?listener_scope, due) != transport.STATUS_OK ||
        space.ack_pending) { ret 29; }
    ret 0;
}

fun output_pending(value: *assembly.Connection, now_ns: u64) bool {
    ret transport.pending_output[binding.Binding](?value.driver, instants.instant(now_ns));
}

fun news_pending(value: *assembly.Connection) bool {
    ret transport.pending_stream_news[binding.Binding](?value.driver);
}

# sends until generate finds nothing, and answers whether it ended empty
fun drain(value: *assembly.Connection, scope: *cancel.Scope, now_ns: u64) bool {
    var sends: usize = 0;
    for (sends < 64) {
        val status: u8 = generate_status(value, scope, now_ns);
        if (status == transport.STATUS_EMPTY) { ret true; }
        if (status != transport.STATUS_OK)    { ret false; }
        sends = sends + 1;
    }
    ret false;
}

test "quic.connection.assembly: output is pending from the work that makes it until generate sends it" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1200, 1200, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 8) != 0) { ret refusal(); }
    clock = clock + 1000;
    if (!drain(?listener, ?listener_scope, clock) || output_pending(?listener, clock)) { ret 20; }
    # a stream write outside any core call, until generate has sent it all
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?listener.driver, transport.UNIDIRECTIONAL);
    if (opened.status != transport.STATUS_OK ||
        transport.write_stream[binding.Binding](?listener.driver, opened.stream,
        ?bulk_bytes[0], 3000).count != 3000 || !output_pending(?listener, clock)) { ret 21; }
    if (!drain(?listener, ?listener_scope, clock) || output_pending(?listener, clock)) { ret 22; }
    # a delayed ack is pending only once it is due, so the answer takes the time
    if (pump(?clock, ?moved, 4) != 0) { ret refusal(); }
    val request: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (request.status != transport.STATUS_OK) { ret 23; }
    val space:   *ack_api.Space = ?listener.core.acknowledgements.spaces[2];
    var delayed: bool           = false;
    var tries:   usize          = 0;
    for (!delayed && tries < 6) {
        if (pump(?clock, ?moved, 2) != 0) { ret refusal(); }
        if (send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
            dialer_endpoint(), request.stream, ?clock) != transport.STATUS_OK) { ret 24; }
        delayed = space.ack_pending && space.ack_deadline_armed &&
            !space.ack_immediate && space.ack_deadline_ns > clock + 1;
        tries = tries + 1;
    }
    if (!delayed) { ret 25; }
    val due: u64 = space.ack_deadline_ns;
    if (!drain(?listener, ?listener_scope, clock + 1) ||
        output_pending(?listener, clock + 1) || output_pending(?listener, due - 1) ||
        !output_pending(?listener, due)) { ret 26; }
    if (!drain(?listener, ?listener_scope, due) || output_pending(?listener, due) ||
        space.ack_pending) { ret 27; }
    ret 0;
}

test "quic.connection.assembly: stream news is pending until the owner takes it" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1200, 1200, 8, ?clock, ?moved);
    if (established != 0)                                 { ret established; }
    if (pump(?clock, ?moved, 8) != 0)                     { ret refusal(); }
    if (news_pending(?listener) || news_pending(?dialer)) { ret 20; }
    # a peer stream is news from its first frame, and its data once accepted
    val request: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (request.status != transport.STATUS_OK ||
        send_byte(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
        dialer_endpoint(), request.stream, ?clock) != transport.STATUS_OK ||
        !news_pending(?listener)) { ret 21; }
    val accepted: transport.OpenResult = transport.accept_stream[binding.Binding](
        ?listener.driver);
    if (accepted.status != transport.STATUS_OK || !news_pending(?listener)) { ret 22; }
    val readable: transport.ReadyStream = transport.ready_stream[binding.Binding](
        ?listener.driver);
    if (readable.status != transport.STATUS_OK || !readable.readable ||
        news_pending(?listener)) { ret 23; }
    var output: [8]u8;
    if (transport.read_stream[binding.Binding](?listener.driver, accepted.stream,
        ?output[0], 8).count != 1 || news_pending(?listener)) { ret 24; }
    # a bare fin after every byte was read is news again, and reads as the end
    if (transport.finish_stream[binding.Binding](?dialer.driver,
        request.stream).status != transport.STATUS_OK) { ret 25; }
    clock = clock + 1000;
    if (hop(?dialer, ?listener, ?dialer_scope, listener_endpoint(), dialer_endpoint(),
        clock) != transport.STATUS_OK || !news_pending(?listener) ||
        !transport.ready_stream[binding.Binding](?listener.driver).readable ||
        news_pending(?listener) ||
        !transport.read_stream[binding.Binding](?listener.driver, accepted.stream,
        ?output[0], 8).fin) { ret 26; }
    # the peer asking the listener to stop sending is news on the listener
    if (transport.cancel_stream_receive[binding.Binding](?dialer.driver, request.stream,
        9).status != transport.STATUS_OK) { ret 27; }
    clock = clock + 1000;
    if (hop(?dialer, ?listener, ?dialer_scope, listener_endpoint(), dialer_endpoint(),
        clock) != transport.STATUS_OK || !news_pending(?listener) ||
        !transport.ready_stream[binding.Binding](?listener.driver).reset ||
        news_pending(?listener)) { ret 28; }
    ret 0;
}

test "quic.connection.assembly: a peer stream opened by a bare fin is news through accept" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1200, 1200, 8, ?clock, ?moved);
    if (established != 0)             { ret established; }
    if (pump(?clock, ?moved, 8) != 0) { ret refusal(); }
    if (news_pending(?listener))      { ret 20; }
    val request: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.UNIDIRECTIONAL);
    if (request.status != transport.STATUS_OK ||
        transport.finish_stream[binding.Binding](?dialer.driver,
        request.stream).status != transport.STATUS_OK) { ret 21; }
    clock = clock + 1000;
    if (hop(?dialer, ?listener, ?dialer_scope, listener_endpoint(), dialer_endpoint(),
        clock) != transport.STATUS_OK || !news_pending(?listener)) { ret 22; }
    val accepted: transport.OpenResult = transport.accept_stream[binding.Binding](
        ?listener.driver);
    if (accepted.status != transport.STATUS_OK || !news_pending(?listener)) { ret 23; }
    val ready: transport.ReadyStream = transport.ready_stream[binding.Binding](
        ?listener.driver);
    if (ready.status != transport.STATUS_OK || !ready.readable || news_pending(?listener)) { ret 24; }
    var output: [8]u8;
    val read:   transport.ReadResult = transport.read_stream[binding.Binding](?listener.driver,
        accepted.stream, ?output[0], 8);
    if (read.status != transport.STATUS_OK || !read.fin || read.count != 0 ||
        news_pending(?listener)) { ret 25; }
    ret 0;
}

rec Lossy {
    seed:        u64;
    loss:        u64;
    held:        [1500]u8;
    held_length: usize;
    held_at:     u64;
    dropped:     usize;
    reordered:   usize;
}

fun lossy_roll(lossy: *Lossy) u64 {
    lossy.seed = lossy.seed * 6364136223846793005 + 1442695040888963407;
    ret (lossy.seed >> 33) % 1000;
}

fun deliver(sink: *assembly.Connection, local: ip.Endpoint, peer: ip.Endpoint,
    data: *u8, length: usize, now_ns: u64) bool {
    var input: transport.Datagram;
    input.local       = local;
    input.peer        = peer;
    input.data        = data;
    input.length      = length;
    input.received_at = instants.instant(now_ns);
    ret transport.receive_datagram[binding.Binding](?sink.driver, ?input).status ==
        transport.STATUS_OK;
}

# moves every datagram the source has, dropping some and swapping the order of
# others. a held datagram goes out after the next one
fun lossy_carry(source: *assembly.Connection, sink: *assembly.Connection,
    source_scope: *cancel.Scope, sink_local: ip.Endpoint, sink_peer: ip.Endpoint,
    now_ns: u64, lossy: *Lossy) bool {
    var guard: usize = 0;
    for (guard < 64) {
        val generated: transport.Generated =
            checked_generate(source, source_scope,
            ?wire[0], 1500, instants.instant(now_ns), 0);
        if (generated.status == transport.STATUS_EMPTY ||
            generated.status == transport.STATUS_BLOCKED) { brk; }
        if (generated.status != transport.STATUS_OK ||
            transport.complete_send[binding.Binding](?source.driver, generated.token,
            transport.SEND_SENT, generated.count, instants.instant(now_ns)).status !=
            transport.STATUS_OK) { ret false; }
        val roll: u64 = lossy_roll(lossy);
        if (roll < lossy.loss) {
            lossy.dropped = lossy.dropped + 1;
        }
        or (roll < lossy.loss + 100 && lossy.held_length == 0) {
            memory.copy[u8](?lossy.held[0], ?wire[0], generated.count);
            lossy.held_length = generated.count;
            lossy.reordered   = lossy.reordered + 1;
        }
        or {
            if (!deliver(sink, sink_local, sink_peer, ?wire[0], generated.count, now_ns)) {
                ret false;
            }
            if (lossy.held_length > 0) {
                if (!deliver(sink, sink_local, sink_peer, ?lossy.held[0],
                    lossy.held_length, now_ns)) { ret false; }
                lossy.held_length = 0;
            }
        }
        guard = guard + 1;
    }
    ret true;
}

fun fire_due(c: *assembly.Connection, now_ns: u64) bool {
    val due: transport.Timer = transport.timer[binding.Binding](?c.driver);
    if (!due.armed || instants.nanos(due.deadline) > now_ns) { ret true; }
    ret transport.on_timeout[binding.Binding](?c.driver, due, instants.instant(now_ns)).status !=
        transport.STATUS_ERROR;
}

fun next_deadline(clock: u64) u64 {
    var next:   u64             = clock + 50000000;
    val dialed: transport.Timer = transport.timer[binding.Binding](?dialer.driver);
    val served: transport.Timer = transport.timer[binding.Binding](?listener.driver);
    if (dialed.armed && instants.nanos(dialed.deadline) < next) { next = instants.nanos(dialed.deadline); }
    if (served.armed && instants.nanos(served.deadline) < next) { next = instants.nanos(served.deadline); }
    if (next <= clock)                                          { next = clock + 1000; }
    ret next;
}

var lossy_streams: [10]transport.Stream;
var lossy_payload: [4096]u8;
var lossy_sink:    [4096]u8;

# ten request streams each fill their whole window through a lossy, reordering
# path, and every byte arrives without a storage refusal
fun lossy_transfer(loss: u64, seed: u64) i32 {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    var i: usize = 0;
    for (i < 4096) {
        lossy_payload[i] = (i * 7 + 3)::u8;
        i                = i + 1;
    }
    i = 0;
    for (i < 10) {
        val opened: transport.OpenResult = transport.open_stream[binding.Binding](
            ?dialer.driver, transport.BIDIRECTIONAL);
        if (opened.status != transport.STATUS_OK ||
            transport.write_stream[binding.Binding](?dialer.driver, opened.stream,
            ?lossy_payload[0], 4096).count != 4096 ||
            transport.finish_stream[binding.Binding](?dialer.driver,
            opened.stream).status != transport.STATUS_OK) { ret 20; }
        i = i + 1;
    }
    var lossy: Lossy;
    lossy.seed = seed;
    lossy.loss = loss;
    var received: [10]usize;
    var accepted: usize = 0;
    var finished: usize = 0;
    var rounds:   usize = 0;
    for (finished < 10 && rounds < 4000) {
        if (!lossy_carry(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
            dialer_endpoint(), clock, ?lossy) ||
            !lossy_carry(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
            listener_endpoint(), clock, ?lossy)) { ret 21; }
        for (accepted < 10) {
            val peer: transport.OpenResult = transport.accept_stream[binding.Binding](
                ?listener.driver);
            if (peer.status != transport.STATUS_OK) { brk; }
            lossy_streams[accepted] = peer.stream;
            accepted                = accepted + 1;
        }
        i = 0;
        for (i < accepted) {
            val read: transport.ReadResult = transport.read_stream[binding.Binding](
                ?listener.driver, lossy_streams[i], ?lossy_sink[0], 4096);
            if (read.count > 0) {
                var k: usize = 0;
                for (k < read.count) {
                    if (lossy_sink[k] != lossy_payload[received[i] + k]) { ret 22; }
                    k = k + 1;
                }
                received[i] = received[i] + read.count;
            }
            if (read.fin && received[i] == 4096) {
                finished    = finished + 1;
                received[i] = received[i] + 1;
            }
            i = i + 1;
        }
        clock = next_deadline(clock);
        if (!fire_due(?dialer, clock) || !fire_due(?listener, clock)) { ret 23; }
        rounds = rounds + 1;
    }
    if (finished != 10) { ret 24; }
    if (lossy.dropped == 0 || listener.streams.receive_storage_refusals != 0 ||
        listener.core.refused_packets != 0) { ret 25; }
    # once the last acknowledgements land, each side holds only the records of
    # its ten open streams: crypto levels are discarded or drained, every
    # stream byte is delivered, and nothing is in flight
    lossy.loss = 0;
    rounds     = 0;
    for (rounds < 64) {
        if (!lossy_carry(?dialer, ?listener, ?dialer_scope, listener_endpoint(),
            dialer_endpoint(), clock, ?lossy) ||
            !lossy_carry(?listener, ?dialer, ?listener_scope, dialer_endpoint(),
            listener_endpoint(), clock, ?lossy)) { ret 26; }
        clock = next_deadline(clock);
        if (!fire_due(?dialer, clock) || !fire_due(?listener, clock)) { ret 27; }
        rounds = rounds + 1;
    }
    val records: usize = (10 + stream_api.RECORDS_PER_BLOCK - 1) / stream_api.RECORDS_PER_BLOCK;
    if (supply.held(?dialer.account, supply.SEND) != records || supply.held(?dialer.account, supply.RECEIVE) != 0 ||
        supply.held(?listener.account, supply.SEND) != records || supply.held(?listener.account, supply.RECEIVE) != 0 ||
        dialer.core.owners != nil || listener.streams.attempt_block.data != nil) {
        ret 28;
    }
    ret 0;
}

test "quic.connection.assembly: a full window survives 5% loss and reordering without storage refusals" {
    ret lossy_transfer(50, 11);
}

test "quic.connection.assembly: a full window survives 10% loss and reordering without storage refusals" {
    ret lossy_transfer(100, 29);
}

# what a connection costs while idle, measured two ways that never stand in
# for each other: the fixed records every connection carries, and the chunks a
# live idle connection holds. a failure means that cost moved. decide it
# deliberately, and update these numbers, the changelog and the readme together
val GUARD_STORAGE_BYTES:    usize = 4560;
val GUARD_CONNECTION_BYTES: usize = 10640;
# established, no streams
val GUARD_IDLE_CHUNKS: usize = 0;
# established, the six h3 control streams open and drained: one record block
val GUARD_H3_SEND_CHUNKS:    usize = 1;
val GUARD_H3_RECEIVE_CHUNKS: usize = 0;

fun settle(clock: *u64, moved: *usize) i32 {
    var i: usize = 0;
    for (i < 20) {
        clock[0] = next_deadline(clock[0]);
        if (!fire_due(?dialer, clock[0]) || !fire_due(?listener, clock[0])) { ret 1; }
        if (pump(clock, moved, 4) != 0)                                     { ret refusal(); }
        i = i + 1;
    }
    ret 0;
}

fun holds(c: *assembly.Connection, send: usize, receive: usize) bool {
    ret supply.held(?c.account, supply.SEND) == send &&
        supply.held(?c.account, supply.RECEIVE) == receive;
}

test "quic.connection.assembly: an idle connection costs what was measured" {
    if ($size_of(assembly.Storage) != GUARD_STORAGE_BYTES ||
        $size_of(assembly.Connection) != GUARD_CONNECTION_BYTES) {
        print.eprintlnf("assembly.Storage is {} bytes (guard {}), Connection {} (guard {})",
            $size_of(assembly.Storage), GUARD_STORAGE_BYTES,
            $size_of(assembly.Connection), GUARD_CONNECTION_BYTES);
        ret 1;
    }
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    val settled: i32 = settle(?clock, ?moved);
    if (settled != 0) { ret settled; }
    if (!holds(?dialer, GUARD_IDLE_CHUNKS, GUARD_IDLE_CHUNKS) ||
        !holds(?listener, GUARD_IDLE_CHUNKS, GUARD_IDLE_CHUNKS)) {
        print.eprintln("an idle established connection holds chunks it did not before");
        ret 2;
    }
    # a settled handshake leaves tls holding nothing, and its records free
    if (!assembly.tls_released(?dialer) || !assembly.tls_released(?listener) ||
        !core.snapshot(?dialer.core).handshake_settled ||
        !core.snapshot(?listener.core).handshake_settled ||
        dialer.account.used[supply.TLS::usize] != 0 ||
        listener.account.used[supply.TLS::usize] != 0) {
        print.eprintlnf("tls holds {} and {} bytes once established",
            dialer.account.used[supply.TLS::usize],
            listener.account.used[supply.TLS::usize]);
        ret 7;
    }
    # wiping the released records does not disturb either connection
    var blank_client: client.Handshake;
    var blank_server: server.Handshake;
    dialer_tls   = blank_client;
    listener_tls = blank_server;
    var byte: [1]u8 = [1]u8{0x07};
    var i:    usize = 0;
    for (i < assembly.H3_CRITICAL_STREAMS_PER_PEER) {
        val dialed: transport.OpenResult = transport.open_stream[binding.Binding](
            ?dialer.driver, transport.UNIDIRECTIONAL);
        val served: transport.OpenResult = transport.open_stream[binding.Binding](
            ?listener.driver, transport.UNIDIRECTIONAL);
        if (dialed.status != transport.STATUS_OK || served.status != transport.STATUS_OK ||
            transport.write_stream[binding.Binding](?dialer.driver, dialed.stream,
            ?byte[0], 1).count != 1 ||
            transport.write_stream[binding.Binding](?listener.driver, served.stream,
            ?byte[0], 1).count != 1) { ret 3; }
        i = i + 1;
    }
    val carried: i32 = settle(?clock, ?moved);
    if (carried != 0) { ret carried; }
    var sink: [4]u8;
    i = 0;
    for (i < assembly.H3_CRITICAL_STREAMS_PER_PEER) {
        val at_dialer: transport.OpenResult =
            transport.accept_stream[binding.Binding](?dialer.driver);
        val at_listener: transport.OpenResult =
            transport.accept_stream[binding.Binding](?listener.driver);
        if (at_dialer.status != transport.STATUS_OK ||
            at_listener.status != transport.STATUS_OK ||
            transport.read_stream[binding.Binding](?dialer.driver, at_dialer.stream,
            ?sink[0], 4).count != 1 ||
            transport.read_stream[binding.Binding](?listener.driver,
            at_listener.stream, ?sink[0], 4).count != 1) { ret 4; }
        i = i + 1;
    }
    val drained: i32 = settle(?clock, ?moved);
    if (drained != 0)                                                               { ret drained; }
    if (dialer.streams.active_streams != 6 || listener.streams.active_streams != 6) { ret 5; }
    if (!holds(?dialer, GUARD_H3_SEND_CHUNKS, GUARD_H3_RECEIVE_CHUNKS) ||
        !holds(?listener, GUARD_H3_SEND_CHUNKS, GUARD_H3_RECEIVE_CHUNKS)) {
        print.eprintlnf("an idle h3 connection holds send {} receive {} chunks (guard {} and {})",
            supply.held(?dialer.account, supply.SEND),
            supply.held(?dialer.account, supply.RECEIVE),
            GUARD_H3_SEND_CHUNKS, GUARD_H3_RECEIVE_CHUNKS);
        ret 6;
    }
    ret 0;
}

var transfer_source: [4096]u8;
var transfer_sink:   [4096]u8;

rec Peak {
    dialer_send:      usize;
    dialer_receive:   usize;
    listener_send:    usize;
    listener_receive: usize;
    # bytes on the tls lane
    dialer_tls:   usize;
    listener_tls: usize;
}

fun observe(peak: *Peak) {
    val a: usize = supply.held(?dialer.account, supply.SEND);
    val b: usize = supply.held(?dialer.account, supply.RECEIVE);
    val c: usize = supply.held(?listener.account, supply.SEND);
    val d: usize = supply.held(?listener.account, supply.RECEIVE);
    if (a > peak.dialer_send)      { peak.dialer_send = a; }
    if (b > peak.dialer_receive)   { peak.dialer_receive = b; }
    if (c > peak.listener_send)    { peak.listener_send = c; }
    if (d > peak.listener_receive) { peak.listener_receive = d; }
    val e: usize = dialer.account.used[supply.TLS::usize];
    val f: usize = listener.account.used[supply.TLS::usize];
    if (e > peak.dialer_tls)   { peak.dialer_tls = e; }
    if (f > peak.listener_tls) { peak.listener_tls = f; }
}

# sends `total` bytes on one stream from the dialer, reading as they arrive,
# and reports the most chunks either end held after any driver call
fun active_transfer(total: usize, peak: *Peak, clock: *u64, moved: *usize) i32 {
    observed = peak;
    val result: i32 = transfer_observed(total, peak, clock, moved);
    observed = nil;
    ret result;
}

fun transfer_observed(total: usize, peak: *Peak, clock: *u64, moved: *usize) i32 {
    val opened: transport.OpenResult = transport.open_stream[binding.Binding](
        ?dialer.driver, transport.BIDIRECTIONAL);
    if (opened.status != transport.STATUS_OK) { ret 30; }
    var i: usize = 0;
    for (i < 4096) {
        transfer_source[i] = (i % 253)::u8;
        i                  = i + 1;
    }
    var sent:     usize = 0;
    var received: usize = 0;
    var accepted: transport.Stream;
    var have:     bool  = false;
    var rounds:   usize = 0;
    var fin:      bool  = false;
    for (!fin && rounds < 4096) {
        if (sent < total) {
            var span: usize = total - sent;
            if (span > 4096) { span = 4096; }
            val wrote: transport.WriteResult = transport.write_stream[binding.Binding](
                ?dialer.driver, opened.stream, ?transfer_source[sent % 4096], span);
            sent = sent + wrote.count;
            if (sent == total &&
                transport.finish_stream[binding.Binding](?dialer.driver,
                opened.stream).status != transport.STATUS_OK) { ret 31; }
        }
        observe(peak);
        clock[0] = next_deadline(clock[0]);
        if (!fire_due(?dialer, clock[0]) || !fire_due(?listener, clock[0])) { ret 32; }
        if (pump(clock, moved, 1) != 0)                                     { ret refusal(); }
        observe(peak);
        if (!have) {
            val got: transport.OpenResult = transport.accept_stream[binding.Binding](
                ?listener.driver);
            if (got.status == transport.STATUS_OK) {
                accepted = got.stream;
                have     = true;
            }
        }
        if (have) {
            val before: usize = received;
            received = received + drain_stream(?listener.driver, accepted,
                ?transfer_sink[0], 4096, ?fin);
            if (received > before && (transfer_sink[0] !=
                transfer_source[before % 4096] ||
                transport.credit_stream[binding.Binding](?listener.driver, accepted,
                (received - before)::u64).status != transport.STATUS_OK)) { ret 33; }
        }
        rounds = rounds + 1;
    }
    if (!fin || received != total) { ret 34; }
    ret 0;
}

# the most chunks each end holds while 64 KiB crosses one stream, sampled after
# every driver call, which is what an owner can observe between calls. both
# ends hold the same four send-lane blocks while their own packets are in
# flight: a record block, the owner table, the application packet history and
# the attempt block (stream data for the sender, MAX_STREAM_DATA for the
# receiver). on top of that the sender holds one data chunk on the send lane,
# never more because of STREAM_STRIDE, and the receiver one on the receive lane
val GUARD_ACTIVE_DIALER_SEND:      usize = 5;
val GUARD_ACTIVE_DIALER_RECEIVE:   usize = 0;
val GUARD_ACTIVE_LISTENER_SEND:    usize = 4;
val GUARD_ACTIVE_LISTENER_RECEIVE: usize = 1;

test "quic.connection.assembly: a 64 KiB transfer costs what was measured" {
    var clock:       u64   = 1000;
    var moved:       usize = 0;
    val established: i32   = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    val quiet: i32 = settle(?clock, ?moved);
    if (quiet != 0) { ret quiet; }
    var peak:   Peak;
    val flowed: i32 = active_transfer(65536, ?peak, ?clock, ?moved);
    if (flowed != 0) { ret flowed; }
    if (peak.dialer_send != GUARD_ACTIVE_DIALER_SEND ||
        peak.dialer_receive != GUARD_ACTIVE_DIALER_RECEIVE ||
        peak.listener_send != GUARD_ACTIVE_LISTENER_SEND ||
        peak.listener_receive != GUARD_ACTIVE_LISTENER_RECEIVE) {
        print.eprintlnf("a 64 KiB transfer peaked at dialer {}/{} listener {}/{} chunks (send/receive)",
            peak.dialer_send, peak.dialer_receive, peak.listener_send,
            peak.listener_receive);
        ret 1;
    }
    # once the bytes are read only the open stream's record block remains
    val after: i32 = settle(?clock, ?moved);
    if (after != 0)                                       { ret after; }
    if (!holds(?dialer, 1, 0) || !holds(?listener, 1, 0)) { ret 2; }
    ret 0;
}

test "quic.connection.assembly: a tls start refused for memory resumes when the pool wakes it" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    starving = true;
    val established: i32 = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    val settled: i32 = settle(?clock, ?moved);
    if (settled != 0) { ret settled; }
    val dialed: core.Snapshot = core.snapshot(?dialer.core);
    if (!dialed.handshake_confirmed || !dialed.handshake_settled ||
        dialed.handshake_waiting || dialer.account.used[supply.TLS::usize] != 0) { ret 50; }
    ret 0;
}

# only the lease the connection handed out lets an engine in, so an engine
# charging anything else cannot reach an account the connection closes. tls
# refuses to initialize without a lease, and the engine left uninitialized is
# refused in turn
# the caller's lanes ride on the connection's account, and its handle is what
# the pool reports, so the caller routes the wake to storage_ready itself
test "quic.connection.assembly: a composed account wakes on the caller's handle" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    starving = true;
    composed = true;
    val established: i32 = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    if (dialer.account.handle != COMPOSED_DIALER_HANDLE ||
        listener.account.handle != COMPOSED_LISTENER_HANDLE ||
        dialer.account.budgets[3] != 8192 || dialer.account.budgets[4] != 4096 ||
        supply.source_lanes_of(?small_pool.provider) != 5) { ret 51; }
    val settled: i32 = settle(?clock, ?moved);
    if (settled != 0)                                     { ret settled; }
    if (!core.snapshot(?dialer.core).handshake_confirmed) { ret 52; }
    ret 0;
}

test "quic.connection.assembly: a composed account carries the caller's lanes through a transfer" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    composed = true;
    val established: i32 = establish_direct(1500, 1500, 8, ?clock, ?moved);
    if (established != 0) { ret established; }
    if (dialer.account.handle != COMPOSED_DIALER_HANDLE ||
        dialer.account.budgets[4] != 4096) { ret 51; }
    ret 0;
}

test "quic.connection.assembly: more caller lanes than a source can declare is refused at config" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    lane_fault = LANES_OVER;
    ret establish_direct(1500, 1500, 8, ?clock, ?moved) - REFUSED;
}

test "quic.connection.assembly: caller lanes the source does not declare are refused at storage" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    lane_fault = LANES_MISMATCH;
    ret establish_direct(1500, 1500, 8, ?clock, ?moved) - REFUSED;
}

test "quic.connection.assembly: an engine holding another connection's lease is refused" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    mislease = LEASE_PEER;
    ret establish_direct(1500, 1500, 8, ?clock, ?moved) - REFUSED;
}

test "quic.connection.assembly: an engine holding no lease is refused" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    mislease = LEASE_NONE;
    ret establish_direct(1500, 1500, 8, ?clock, ?moved) - REFUSED;
}

# the lease points into the connection, so a copy made after it was taken is
# not the connection the engine charges
test "quic.connection.assembly: a connection copied after its lease was taken is refused" {
    var clock: u64   = 1000;
    var moved: usize = 0;
    mislease = LEASE_ORIGINAL;
    ret establish_direct(1500, 1500, 8, ?clock, ?moved) - REFUSED;
}

# what a handshake holds after any driver call, in chunks per lane and tls
# bytes, beside the caller's tls handshake records. a failure means that cost
# moved. decide it deliberately, and update these numbers, the changelog and
# the readme together
val GUARD_HANDSHAKE_DIALER_SEND:   usize = 5;
val GUARD_HANDSHAKE_LISTENER_SEND: usize = 6;
val GUARD_HANDSHAKE_DIALER_TLS:    usize = 8704;
val GUARD_HANDSHAKE_LISTENER_TLS:  usize = 18944;
val GUARD_CLIENT_HANDSHAKE_BYTES:  usize = 6424;
val GUARD_SERVER_HANDSHAKE_BYTES:  usize = 6224;

test "quic.connection.assembly: a handshake costs what was measured" {
    if ($size_of(client.Handshake) != GUARD_CLIENT_HANDSHAKE_BYTES ||
        $size_of(server.Handshake) != GUARD_SERVER_HANDSHAKE_BYTES) {
        print.eprintlnf("tls handshake records are {} and {} bytes (guard {} and {})",
            $size_of(client.Handshake), $size_of(server.Handshake),
            GUARD_CLIENT_HANDSHAKE_BYTES, GUARD_SERVER_HANDSHAKE_BYTES);
        ret 1;
    }
    var clock: u64   = 1000;
    var moved: usize = 0;
    var peak:  Peak;
    observed = ?peak;
    val established: i32 = establish_direct(1500, 1500, 8, ?clock, ?moved);
    observed = nil;
    if (established != 0) { ret established; }
    if (peak.dialer_send != GUARD_HANDSHAKE_DIALER_SEND || peak.dialer_receive != 0 ||
        peak.listener_send != GUARD_HANDSHAKE_LISTENER_SEND ||
        peak.listener_receive != 0 ||
        peak.dialer_tls != GUARD_HANDSHAKE_DIALER_TLS ||
        peak.listener_tls != GUARD_HANDSHAKE_LISTENER_TLS) {
        print.eprintlnf("a handshake peaked at dialer {}/{} chunks and {} tls bytes, listener {}/{} and {}",
            peak.dialer_send, peak.dialer_receive, peak.dialer_tls,
            peak.listener_send, peak.listener_receive, peak.listener_tls);
        ret 2;
    }
    ret 0;
}
