# checked physical ownership ranges

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def ZeroPolicy: u8;
pub val ZERO_FORBIDDEN: ZeroPolicy = 1;
pub val ZERO_ALLOWED: ZeroPolicy = 2;

pub rec Range {
    data: *u8;
    length: usize;
    valid: bool;
}

pub fun bytes(data: *u8, length: usize, zero_policy: ZeroPolicy) Range {
    var value: Range;
    value.data = data;
    value.length = length;
    if (zero_policy != ZERO_FORBIDDEN && zero_policy != ZERO_ALLOWED) { ret value; }
    if (length == 0) {
        value.valid = zero_policy == ZERO_ALLOWED;
        ret value;
    }
    if (data == nil || length - 1 > ~(0::usize) - data::usize) { ret value; }
    value.valid = true;
    ret value;
}

pub fun array(data: *u8, count: usize, item_size: usize,
              zero_policy: ZeroPolicy) Range {
    var value: Range;
    value.data = data;
    if (item_size == 0 || (count != 0 && item_size > ~(0::usize) / count)) {
        ret value;
    }
    ret bytes(data, count * item_size, zero_policy);
}

pub fun disjoint(left: Range, right: Range) bool {
    if (!left.valid || !right.valid) { ret false; }
    if (left.length == 0 || right.length == 0) { ret true; }
    val left_start: usize = left.data::usize;
    val right_start: usize = right.data::usize;
    val left_end: usize = left_start + left.length - 1;
    val right_end: usize = right_start + right.length - 1;
    ret left_end < right_start || right_end < left_start;
}

pub fun contains(outer: Range, inner: Range) bool {
    if (!outer.valid || !inner.valid || outer.length == 0 ||
        inner.length == 0) { ret false; }
    val outer_start: usize = outer.data::usize;
    val inner_start: usize = inner.data::usize;
    if (inner_start < outer_start) { ret false; }
    ret inner_start + inner.length - 1 <= outer_start + outer.length - 1;
}

pub fun secret_disjoint(left: *^u8, left_length: usize,
                        right: *^u8, right_length: usize) bool {
    if (left == nil || right == nil || left_length == 0 || right_length == 0) {
        ret false;
    }
    var i: usize = 0;
    for (i < right_length) {
        if (left == ?right[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < left_length) {
        if (right == ?left[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub def Overlap: u8;
pub val OVERLAP_NONE: Overlap = 0;
pub val OVERLAP_LIST_INVALID: Overlap = 1;
pub val OVERLAP_RANGE_INVALID: Overlap = 2;
pub val OVERLAP_PAIR: Overlap = 3;

# which range failed, and which one it collided with, so a caller is not left
# bisecting a list it did not build
pub rec Disjointness {
    kind: Overlap;
    first: usize;
    second: usize;
}

pub fun disjointness(ranges: *Range, count: usize) Disjointness {
    var value: Disjointness;
    value.kind = OVERLAP_NONE;
    value.first = 0;
    value.second = 0;
    val list: Range = array(ranges::*u8, count, $size_of(Range), ZERO_FORBIDDEN);
    if (!list.valid) { value.kind = OVERLAP_LIST_INVALID; ret value; }
    var i: usize = 0;
    for (i < count) {
        if (!ranges[i].valid) {
            value.kind = OVERLAP_RANGE_INVALID;
            value.first = i;
            ret value;
        }
        var j: usize = 0;
        for (j < i) {
            if (!disjoint(ranges[i], ranges[j])) {
                value.kind = OVERLAP_PAIR;
                value.first = j;
                value.second = i;
                ret value;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret value;
}

pub fun all_disjoint(ranges: *Range, count: usize) bool {
    ret disjointness(ranges, count).kind == OVERLAP_NONE;
}

# checks one range that is not a member of `ranges` against ranges[start..count).
# `index` is the subject's own position in whatever list the caller built, so a
# refusal names both sides rather than only the one that was walked
pub fun disjoint_from(subject: Range, index: usize, ranges: *Range,
                      start: usize, count: usize) Disjointness {
    var value: Disjointness;
    value.kind = OVERLAP_NONE;
    value.first = 0;
    value.second = 0;
    val list: Range = array(ranges::*u8, count, $size_of(Range), ZERO_FORBIDDEN);
    if (!list.valid || start > count) {
        value.kind = OVERLAP_LIST_INVALID;
        ret value;
    }
    if (!subject.valid) {
        value.kind = OVERLAP_RANGE_INVALID;
        value.first = index;
        ret value;
    }
    var j: usize = start;
    for (j < count) {
        if (!disjoint(subject, ranges[j])) {
            value.kind = OVERLAP_PAIR;
            value.first = index;
            value.second = j;
            ret value;
        }
        j = j + 1;
    }
    ret value;
}

test "quic.connection.ownership: inclusive maximum ranges are checked without wrapping" {
    val maximum: usize = ~(0::usize);
    val at_maximum: *u8 = maximum::*u8;
    val before_maximum: *u8 = (maximum - 1)::*u8;
    val last: Range = bytes(at_maximum, 1, ZERO_FORBIDDEN);
    val prior: Range = bytes(before_maximum, 1, ZERO_FORBIDDEN);
    val pair: Range = bytes(before_maximum, 2, ZERO_FORBIDDEN);
    if (!last.valid || !prior.valid || !pair.valid || !disjoint(last, prior) ||
        disjoint(last, pair) || bytes(at_maximum, 2, ZERO_FORBIDDEN).valid) { ret 1; }
    ret 0;
}

test "quic.connection.ownership: containment is inclusive and rejects overhang" {
    var storage: [8]u8;
    val whole: Range = bytes(?storage[0], 8, ZERO_FORBIDDEN);
    if (!contains(whole, whole) ||
        !contains(whole, bytes(?storage[0], 1, ZERO_FORBIDDEN)) ||
        !contains(whole, bytes(?storage[7], 1, ZERO_FORBIDDEN)) ||
        !contains(whole, bytes(?storage[3], 4, ZERO_FORBIDDEN))) { ret 1; }
    if (contains(whole, bytes(?storage[4], 5, ZERO_FORBIDDEN)) ||
        contains(bytes(?storage[1], 6, ZERO_FORBIDDEN),
            bytes(?storage[0], 2, ZERO_FORBIDDEN)) ||
        contains(whole, bytes(nil, 0, ZERO_ALLOWED)) ||
        contains(bytes(nil, 0, ZERO_ALLOWED), whole)) { ret 2; }
    ret 0;
}

test "quic.connection.ownership: zero and scaled ranges have explicit policies" {
    val maximum: usize = ~(0::usize);
    if (bytes(nil, 0, ZERO_FORBIDDEN).valid ||
        !bytes(nil, 0, ZERO_ALLOWED).valid ||
        array((1::usize)::*u8, maximum / 3 + 1, 3, ZERO_FORBIDDEN).valid ||
        array((maximum - 1)::*u8, 1, 4, ZERO_FORBIDDEN).valid) { ret 1; }
    var storage: [8]u8;
    var ranges: [3]Range;
    ranges[0] = bytes(?storage[0], 2, ZERO_FORBIDDEN);
    ranges[1] = bytes(?storage[2], 2, ZERO_FORBIDDEN);
    ranges[2] = bytes(?storage[4], 4, ZERO_FORBIDDEN);
    if (!all_disjoint(?ranges[0], 3)) { ret 2; }
    ranges[2] = bytes(?storage[1], 1, ZERO_FORBIDDEN);
    if (all_disjoint(?ranges[0], 3)) { ret 3; }
    ret 0;
}

test "quic.connection.ownership: a refusal names the ranges that collided" {
    var storage: [16]u8;
    var ranges: [4]Range;
    ranges[0] = bytes(?storage[0], 4, ZERO_FORBIDDEN);
    ranges[1] = bytes(?storage[4], 4, ZERO_FORBIDDEN);
    ranges[2] = bytes(?storage[8], 4, ZERO_FORBIDDEN);
    ranges[3] = bytes(?storage[12], 4, ZERO_FORBIDDEN);
    val clean: Disjointness = disjointness(?ranges[0], 4);
    if (clean.kind != OVERLAP_NONE || clean.first != 0 ||
        clean.second != 0) { ret 1; }
    ranges[3] = bytes(?storage[5], 2, ZERO_FORBIDDEN);
    val pair: Disjointness = disjointness(?ranges[0], 4);
    if (pair.kind != OVERLAP_PAIR || pair.first != 1 || pair.second != 3) { ret 2; }
    ranges[2] = bytes(nil, 0, ZERO_FORBIDDEN);
    val invalid: Disjointness = disjointness(?ranges[0], 4);
    if (invalid.kind != OVERLAP_RANGE_INVALID || invalid.first != 2) { ret 3; }
    if (disjointness(nil, 4).kind != OVERLAP_LIST_INVALID) { ret 4; }
    ret 0;
}

test "quic.connection.ownership: a borrowed range names itself and its collision" {
    var storage: [16]u8;
    var ranges: [4]Range;
    ranges[0] = bytes(?storage[0], 4, ZERO_FORBIDDEN);
    ranges[1] = bytes(?storage[4], 4, ZERO_FORBIDDEN);
    ranges[2] = bytes(?storage[8], 4, ZERO_FORBIDDEN);
    ranges[3] = bytes(?storage[12], 4, ZERO_FORBIDDEN);
    var lent: [8]u8;
    val outside: Disjointness = disjoint_from(bytes(?lent[0], 8, ZERO_FORBIDDEN),
        6, ?ranges[0], 1, 4);
    if (outside.kind != OVERLAP_NONE) { ret 1; }
    val inside: Disjointness = disjoint_from(bytes(?storage[9], 2, ZERO_FORBIDDEN),
        6, ?ranges[0], 1, 4);
    if (inside.kind != OVERLAP_PAIR || inside.first != 6 ||
        inside.second != 2) { ret 2; }
    # the same collision is invisible once the window excludes it
    if (disjoint_from(bytes(?storage[9], 2, ZERO_FORBIDDEN), 6, ?ranges[0], 3,
        4).kind != OVERLAP_NONE) { ret 3; }
    val malformed: Disjointness = disjoint_from(bytes(nil, 0, ZERO_FORBIDDEN), 6,
        ?ranges[0], 0, 4);
    if (malformed.kind != OVERLAP_RANGE_INVALID || malformed.first != 6) { ret 4; }
    ret 0;
}
