# stateless server preflight and pre-allocation admission

use quic.connection.admission;
use quic.connection.ownership;
use quic.connection.token;
use quic.crypto.protection;
use quic.packet.packet;
use quic.wire.varint;

use crypto.contracts;
use std.crypto.ct;
use std.encoding.binary;
use std.memory;
use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result;
use std.types.size.usize;
use std.types.string.str;

pub def Action: u8;
pub val ACTION_ACCEPT: Action = 1;
pub val ACTION_RETRY: Action = 2;
pub val ACTION_VERSION_NEGOTIATION: Action = 3;
pub val ACTION_DROP: Action = 4;
pub val ACTION_BLOCKED: Action = 5;
pub val ACTION_ERROR: Action = 6;

pub def Error: u8;
pub val ERROR_NONE: Error = 0;
pub val ERROR_STATE: Error = 1;
pub val ERROR_CONFIG: Error = 2;
pub val ERROR_BUFFER: Error = 3;
pub val ERROR_PACKET: Error = 4;
pub val ERROR_VERSION: Error = 5;
pub val ERROR_TOKEN: Error = 6;
pub val ERROR_IDENTITY: Error = 7;
pub val ERROR_ADMISSION: Error = 8;
pub val ERROR_CAPACITY: Error = 9;
pub val ERROR_CRYPTO: Error = 10;
pub val ERROR_OUTPUT: Error = 11;
pub val ERROR_TOKEN_HANDLE: Error = 12;
pub val ERROR_CLEANUP: Error = 13;

pub val CONNECTION_ID_CAPACITY: usize = 20;
pub val MAX_DATAGRAM_LENGTH: usize = 65527;

pub def DatagramClass: u8;
pub val DATAGRAM_MALFORMED: DatagramClass = 0;
pub val DATAGRAM_INITIAL: DatagramClass = 1;
pub val DATAGRAM_NEGOTIATE: DatagramClass = 2;
pub val DATAGRAM_ESTABLISHED: DatagramClass = 3;

pub rec ConnectionId {
    data: [CONNECTION_ID_CAPACITY]u8;
    length: usize;
}

pub rec ClassifiedDatagram {
    class: DatagramClass;
    destination: ConnectionId;
    version: u32;
    long_header: bool;
}

pub val PENDING_FREE: u8 = 0;
pub val PENDING_RESERVED: u8 = 1;
pub val PENDING_CLEANUP: u8 = 2;

pub def CleanupStatus: u8;
pub val CLEANUP_NONE: CleanupStatus = 0;
pub val CLEANUP_COMPLETE: CleanupStatus = 1;
pub val CLEANUP_RETAINED: CleanupStatus = 2;
pub val CLEANUP_INVALID: CleanupStatus = 3;

pub rec Config {
    source: u64;
    supported_versions: *u32;
    supported_version_count: usize;
    minimum_initial_size: usize;
    require_retry: bool;
}

pub rec Pending {
    charge: admission.Charge;
    replay: token.Reservation;
    original_destination: packet.ConnectionId;
    initial_destination: packet.ConnectionId;
    initial_source: packet.ConnectionId;
    retry_source: packet.ConnectionId;
    peer: ip.Endpoint;
    version: u32;
    generation: u64;
    listener_source: u64;
    listener_generation: u64;
    state: u8;
    owns_admission: bool;
    owns_replay: bool;
    peer_validated: bool;
    retry_source_present: bool;
}

pub rec Storage {
    pending: *Pending;
    pending_capacity: usize;
}

pub rec Listener {
    config: Config;
    storage: Storage;
    admission_manager: *admission.Manager;
    token_manager: *token.Manager;
    next_pending: usize;
    lease_generation: u64;
    owns_storage: bool;
    owns_admission_lease: bool;
    owns_token_lease: bool;
    cleanup_pending: bool;
    initialized: bool;
    closing: bool;
}

pub rec Request {
    peer: ip.Endpoint;
    data: *u8;
    length: usize;
    now_ns: u64;
    retry_source: ConnectionId;
    retry_nonce: u64;
    version_negotiation_bits: u8;
    output: *u8;
    output_capacity: usize;
}

pub rec Acceptance {
    source: u64;
    index: usize;
    generation: u64;
}

pub rec LeaseHandle {
    source: u64;
    generation: u64;
}

pub rec LeaseCleanupResult {
    status: CleanupStatus;
    handle: LeaseHandle;
    admission_retained: bool;
    token_retained: bool;
    storage_retained: bool;
    admission_attempted: bool;
    token_attempted: bool;
    storage_attempted: bool;
}

pub rec InitializeResult {
    ok: bool;
    error: Error;
    handle: LeaseHandle;
    cleanup: LeaseCleanupResult;
}

pub rec CleanupResult {
    status: CleanupStatus;
    acceptance: Acceptance;
    admission_retained: bool;
    replay_retained: bool;
    admission_attempted: bool;
    replay_attempted: bool;
    admission_status: admission.Status;
    admission_error: admission.Error;
    replay_status: token.Status;
    replay_error: token.Error;
}

pub rec Result {
    action: Action;
    error: Error;
    detail: u64;
    acceptance: Acceptance;
    output_count: usize;
    version: u32;
    cleanup: CleanupResult;
}

pub rec Accepted {
    action: Action;
    error: Error;
    detail: u64;
    charge: admission.Charge;
    original_destination: packet.ConnectionId;
    initial_destination: packet.ConnectionId;
    initial_source: packet.ConnectionId;
    retry_source: packet.ConnectionId;
    peer: ip.Endpoint;
    version: u32;
    peer_validated: bool;
    retry_source_present: bool;
    cleanup: CleanupResult;
}

rec Initial {
    destination: packet.ConnectionId;
    source: packet.ConnectionId;
    token_data: *u8;
    token_length: usize;
    version: u32;
    valid: bool;
}

fun copy_connection_id(output: *ConnectionId, data: *u8,
                       length: usize) bool {
    if (output == nil || data == nil || length == 0 ||
        length > CONNECTION_ID_CAPACITY) { ret false; }
    var next: ConnectionId;
    next.length = length;
    var i: usize = 0;
    for (i < CONNECTION_ID_CAPACITY) {
        next.data[i] = 0;
        i = i + 1;
    }
    memory.copy[u8](?next.data[0], data, length);
    @output = next;
    ret true;
}

fun packet_connection_id(value: *ConnectionId) packet.ConnectionId {
    var result: packet.ConnectionId;
    if (value == nil || value.length == 0 ||
        value.length > CONNECTION_ID_CAPACITY) { ret result; }
    packet.set_connection_id(?result, ?value.data[0], value.length);
    ret result;
}

# copies the retry source so the caller retains no storage through preflight
pub fun set_retry_source(request: *Request, data: *u8,
                         length: usize) bool {
    if (request == nil) { ret false; }
    var next: ConnectionId;
    if (!copy_connection_id(?next, data, length)) { ret false; }
    request.retry_source = next;
    ret true;
}

fun malformed_datagram() ClassifiedDatagram {
    var result: ClassifiedDatagram;
    result.class = DATAGRAM_MALFORMED;
    result.destination.length = 0;
    var i: usize = 0;
    for (i < CONNECTION_ID_CAPACITY) {
        result.destination.data[i] = 0;
        i = i + 1;
    }
    result.version = 0;
    result.long_header = false;
    ret result;
}

fun next_generation(value: u64) u64 {
    var next: u64 = value + 1;
    if (next == 0) { next = 1; }
    ret next;
}

fun known_supported(version: u32) bool {
    ret version == packet.VERSION_1 || version == packet.VERSION_2;
}

fun initial_bits(version: u32) u8 {
    if (version == packet.VERSION_1) { ret 0; }
    if (version == packet.VERSION_2) { ret 1; }
    ret 0xff;
}

fun version_supported(listener: *Listener, version: u32) bool {
    var i: usize = 0;
    for (i < listener.config.supported_version_count) {
        if (listener.config.supported_versions[i] == version) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun physical(listener: *Listener) bool {
    if (listener == nil) { ret false; }
    val listener_range: ownership.Range = ownership.bytes((?listener.config)::*u8,
        $size_of(Listener), ownership.ZERO_FORBIDDEN);
    if (!listener_range.valid) { ret false; }
    val admissions: *admission.Manager = listener.admission_manager;
    val tokens: *token.Manager = listener.token_manager;
    if (admissions == nil || tokens == nil ||
        !ownership.bytes(admissions::*u8, $size_of(admission.Manager),
            ownership.ZERO_FORBIDDEN).valid ||
        !ownership.bytes((?tokens.config)::*u8, $size_of(token.Manager),
            ownership.ZERO_FORBIDDEN).valid) { ret false; }
    val token_range: ownership.Range = ownership.bytes((?tokens.config)::*u8,
        $size_of(token.Manager), ownership.ZERO_FORBIDDEN);
    var ranges: [8]ownership.Range;
    ranges[0] = listener_range;
    ranges[1] = ownership.array(listener.config.supported_versions::*u8,
        listener.config.supported_version_count, $size_of(u32),
        ownership.ZERO_FORBIDDEN);
    ranges[2] = ownership.array(listener.storage.pending::*u8,
        listener.storage.pending_capacity, $size_of(Pending),
        ownership.ZERO_FORBIDDEN);
    ranges[3] = ownership.bytes(admissions::*u8, $size_of(admission.Manager),
        ownership.ZERO_FORBIDDEN);
    ranges[4] = ownership.array(admissions.storage.peers::*u8,
        admissions.storage.peer_capacity, $size_of(admission.PeerSlot),
        ownership.ZERO_FORBIDDEN);
    ranges[5] = ownership.array(admissions.storage.charges::*u8,
        admissions.storage.charge_capacity, $size_of(admission.ChargeSlot),
        ownership.ZERO_FORBIDDEN);
    ranges[6] = token_range;
    ranges[7] = ownership.array(tokens.storage.replay::*u8,
        tokens.storage.replay_capacity, $size_of(token.ReplaySlot),
        ownership.ZERO_FORBIDDEN);
    ret ownership.all_disjoint(?ranges[0], 8);
}

fun reset_unpublished(listener: *Listener) {
    val generation: u64 = listener.lease_generation;
    var empty: Listener;
    empty.lease_generation = generation;
    @listener = empty;
}

fun lease_handle_valid(listener: *Listener, value: LeaseHandle) bool {
    ret listener != nil && value.source != 0 &&
        value.source == listener.config.source &&
        value.generation != 0 && value.generation == listener.lease_generation;
}

fun claim_listener_storage(listener: *Listener) bool {
    var i: usize = 0;
    for (i < listener.storage.pending_capacity) {
        if (listener.storage.pending[i].listener_source != 0 ||
            listener.storage.pending[i].listener_generation != 0) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < listener.storage.pending_capacity) {
        listener.storage.pending[i].listener_source = listener.config.source;
        listener.storage.pending[i].listener_generation =
            listener.lease_generation;
        i = i + 1;
    }
    listener.owns_storage = true;
    ret true;
}

fun release_listener_storage(listener: *Listener) bool {
    var i: usize = 0;
    for (i < listener.storage.pending_capacity) {
        if (listener.storage.pending[i].listener_source != listener.config.source ||
            listener.storage.pending[i].listener_generation !=
                listener.lease_generation) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < listener.storage.pending_capacity) {
        listener.storage.pending[i].listener_source = 0;
        listener.storage.pending[i].listener_generation = 0;
        i = i + 1;
    }
    listener.owns_storage = false;
    ret true;
}

fun cleanup_listener_leases(listener: *Listener,
                            value: LeaseHandle) LeaseCleanupResult {
    var result: LeaseCleanupResult;
    result.handle = value;
    if (!lease_handle_valid(listener, value) ||
        (!listener.owns_storage && !listener.owns_admission_lease &&
            !listener.owns_token_lease)) {
        result.status = CLEANUP_INVALID;
        ret result;
    }
    listener.initialized = false;
    listener.cleanup_pending = true;
    if (listener.owns_admission_lease) {
        result.admission_attempted = true;
        if (admission.release_listener(listener.admission_manager,
                listener.config.source)) {
            listener.owns_admission_lease = false;
        }
    }
    if (listener.owns_token_lease) {
        result.token_attempted = true;
        if (token.release_listener(listener.token_manager,
                listener.config.source)) {
            listener.owns_token_lease = false;
        }
    }
    if (listener.owns_storage && !listener.owns_admission_lease &&
        !listener.owns_token_lease) {
        result.storage_attempted = true;
        release_listener_storage(listener);
    }
    result.admission_retained = listener.owns_admission_lease;
    result.token_retained = listener.owns_token_lease;
    result.storage_retained = listener.owns_storage;
    if (result.admission_retained || result.token_retained ||
        result.storage_retained) {
        result.status = CLEANUP_RETAINED;
        ret result;
    }
    result.status = CLEANUP_COMPLETE;
    reset_unpublished(listener);
    ret result;
}

pub fun initialize_result(listener: *Listener, config: Config, storage: Storage,
                          admission_manager: *admission.Manager,
                          token_manager: *token.Manager) InitializeResult {
    var result: InitializeResult;
    if (config.source == 0 || config.supported_versions == nil ||
        config.supported_version_count == 0 || config.supported_version_count > 16 ||
        config.minimum_initial_size < 1200 || storage.pending == nil ||
        storage.pending_capacity == 0) {
        result.error = ERROR_CONFIG;
        ret result;
    }
    if (listener == nil || admission_manager == nil || token_manager == nil) {
        result.error = ERROR_CONFIG;
        ret result;
    }
    if (!ownership.bytes(admission_manager::*u8, $size_of(admission.Manager),
            ownership.ZERO_FORBIDDEN).valid ||
        !ownership.bytes((?token_manager.config)::*u8, $size_of(token.Manager),
            ownership.ZERO_FORBIDDEN).valid) {
        result.error = ERROR_CONFIG;
        ret result;
    }
    val listener_range: ownership.Range = ownership.bytes((?listener.config)::*u8,
        $size_of(Listener), ownership.ZERO_FORBIDDEN);
    val token_range: ownership.Range = ownership.bytes((?token_manager.config)::*u8,
        $size_of(token.Manager), ownership.ZERO_FORBIDDEN);
    var ranges: [8]ownership.Range;
    ranges[0] = listener_range;
    ranges[1] = ownership.array(config.supported_versions::*u8,
        config.supported_version_count, $size_of(u32), ownership.ZERO_FORBIDDEN);
    ranges[2] = ownership.array(storage.pending::*u8, storage.pending_capacity,
        $size_of(Pending), ownership.ZERO_FORBIDDEN);
    ranges[3] = ownership.bytes(admission_manager::*u8,
        $size_of(admission.Manager), ownership.ZERO_FORBIDDEN);
    ranges[4] = ownership.array(admission_manager.storage.peers::*u8,
        admission_manager.storage.peer_capacity, $size_of(admission.PeerSlot),
        ownership.ZERO_FORBIDDEN);
    ranges[5] = ownership.array(admission_manager.storage.charges::*u8,
        admission_manager.storage.charge_capacity, $size_of(admission.ChargeSlot),
        ownership.ZERO_FORBIDDEN);
    ranges[6] = token_range;
    ranges[7] = ownership.array(token_manager.storage.replay::*u8,
        token_manager.storage.replay_capacity, $size_of(token.ReplaySlot),
        ownership.ZERO_FORBIDDEN);
    if (!ownership.all_disjoint(?ranges[0], 8)) {
        result.error = ERROR_CONFIG;
        ret result;
    }
    if (listener.initialized || listener.cleanup_pending || listener.owns_storage ||
        listener.owns_admission_lease || listener.owns_token_lease ||
        !admission_manager.initialized || admission_manager.closing ||
        !token_manager.initialized || token_manager.closing) {
        result.error = ERROR_STATE;
        ret result;
    }
    var i: usize = 0;
    for (i < config.supported_version_count) {
        if (!known_supported(config.supported_versions[i])) {
            result.error = ERROR_VERSION;
            ret result;
        }
        var j: usize = 0;
        for (j < i) {
            if (config.supported_versions[j] == config.supported_versions[i]) {
                result.error = ERROR_VERSION;
                ret result;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    listener.config = config;
    listener.storage = storage;
    listener.admission_manager = admission_manager;
    listener.token_manager = token_manager;
    listener.next_pending = 0;
    listener.lease_generation = next_generation(listener.lease_generation);
    listener.owns_storage = false;
    listener.owns_admission_lease = false;
    listener.owns_token_lease = false;
    listener.cleanup_pending = false;
    listener.closing = false;
    listener.initialized = false;
    result.handle = LeaseHandle{source: config.source,
        generation: listener.lease_generation};
    if (!claim_listener_storage(listener)) {
        result.error = ERROR_CAPACITY;
        reset_unpublished(listener);
        ret result;
    }
    if (!admission.lease_listener(admission_manager, config.source)) {
        result.error = ERROR_ADMISSION;
        result.cleanup = cleanup_listener_leases(listener, result.handle);
        if (result.cleanup.status == CLEANUP_RETAINED) {
            result.error = ERROR_CLEANUP;
        }
        ret result;
    }
    listener.owns_admission_lease = true;
    if (!token.lease_listener(token_manager, config.source)) {
        result.error = ERROR_TOKEN;
        result.cleanup = cleanup_listener_leases(listener, result.handle);
        if (result.cleanup.status == CLEANUP_RETAINED) {
            result.error = ERROR_CLEANUP;
        }
        ret result;
    }
    listener.owns_token_lease = true;
    i = 0;
    for (i < storage.pending_capacity) {
        storage.pending[i].state = PENDING_FREE;
        storage.pending[i].owns_admission = false;
        storage.pending[i].owns_replay = false;
        storage.pending[i].generation = next_generation(storage.pending[i].generation);
        i = i + 1;
    }
    listener.initialized = true;
    result.ok = true;
    ret result;
}

pub fun initialize(listener: *Listener, config: Config, storage: Storage,
                   admission_manager: *admission.Manager,
                   token_manager: *token.Manager) bool {
    ret initialize_result(listener, config, storage, admission_manager,
        token_manager).ok;
}

fun parse_ids(data: *u8, length: usize, initial: *Initial, position: *usize) bool {
    if (length < 7) { ret false; }
    initial.version = binary.get_uint(?data[1], 4, binary.BIG)::u32;
    var cursor: usize = 5;
    val destination_length: usize = data[cursor]::usize;
    cursor = cursor + 1;
    if (destination_length > packet.MAX_CONNECTION_ID ||
        destination_length > length - cursor) { ret false; }
    if (!packet.set_connection_id(?initial.destination, ?data[cursor],
        destination_length)) { ret false; }
    cursor = cursor + destination_length;
    if (cursor >= length) { ret false; }
    val source_length: usize = data[cursor]::usize;
    cursor = cursor + 1;
    if (source_length > packet.MAX_CONNECTION_ID || source_length > length - cursor) {
        ret false;
    }
    if (!packet.set_connection_id(?initial.source, ?data[cursor], source_length)) {
        ret false;
    }
    @position = cursor + source_length;
    ret true;
}

fun parse_initial(data: *u8, length: usize) Initial {
    var initial: Initial;
    if (data == nil || length < 7 || (data[0] & 0xc0) != 0xc0) { ret initial; }
    var position: usize = 0;
    if (!parse_ids(data, length, ?initial, ?position) ||
        !known_supported(initial.version) ||
        ((data[0] >> 4) & 0x03) != initial_bits(initial.version)) { ret initial; }
    var decoder: binary.Decoder = binary.decoder(?data[position], length - position,
        binary.BIG);
    val token_length: varint.Decoded = varint.read(?decoder, false);
    if (token_length.status != varint.STATUS_DONE ||
        token_length.value > (length - position - decoder.pos)::u64) { ret initial; }
    initial.token_length = token_length.value::usize;
    if (initial.token_length > 0) {
        initial.token_data = ?data[position + decoder.pos];
    }
    decoder.pos = decoder.pos + initial.token_length;
    val packet_length: varint.Decoded = varint.read(?decoder, false);
    if (packet_length.status != varint.STATUS_DONE || packet_length.value < 1 ||
        packet_length.value > (decoder.len - decoder.pos)::u64) { ret initial; }
    initial.valid = true;
    ret initial;
}

fun retry_bits(version: u32) u8 {
    if (version == packet.VERSION_1) { ret 3; }
    if (version == packet.VERSION_2) { ret 0; }
    ret 0xff;
}

fun encoded_tail_valid(data: *u8, length: usize, position: usize) bool {
    if (position >= length) { ret false; }
    var decoder: binary.Decoder = binary.decoder(?data[position],
        length - position, binary.BIG);
    val encoded: varint.Decoded = varint.read(?decoder, false);
    ret encoded.status == varint.STATUS_DONE && encoded.value >= 1 &&
        encoded.value <= (decoder.len - decoder.pos)::u64;
}

fun version_list_valid(data: *u8, length: usize, position: usize) bool {
    if (position >= length) { ret false; }
    val bytes: usize = length - position;
    if ((bytes & 3) != 0 || bytes / 4 > 64) { ret false; }
    var i: usize = 0;
    for (i < bytes / 4) {
        if (binary.get_uint(?data[position + i * 4], 4, binary.BIG) == 0) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# classifies one received datagram for a cid-indexed socket owner. every
# published byte is copied, and the input is borrowed only for this call
pub fun classify_datagram(data: *u8, length: usize,
                          short_destination_length: usize) ClassifiedDatagram {
    var result: ClassifiedDatagram = malformed_datagram();
    if (data == nil || length == 0 || length > MAX_DATAGRAM_LENGTH) { ret result; }
    val first: u8 = data[0];
    if ((first & 0x80) == 0) {
        if ((first & 0x40) == 0 || short_destination_length == 0 ||
            short_destination_length > CONNECTION_ID_CAPACITY ||
            short_destination_length >= length - 1) { ret result; }
        if (!copy_connection_id(?result.destination, ?data[1],
                short_destination_length)) { ret result; }
        result.class = DATAGRAM_ESTABLISHED;
        result.long_header = false;
        ret result;
    }
    if (length < 7) { ret result; }
    var initial: Initial;
    var position: usize = 0;
    if (!parse_ids(data, length, ?initial, ?position) ||
        initial.destination.len == 0 ||
        !copy_connection_id(?result.destination,
            ?initial.destination.data[0], initial.destination.len::usize)) {
        ret malformed_datagram();
    }
    result.version = initial.version;
    result.long_header = true;
    if (initial.version == 0) {
        if (!version_list_valid(data, length, position)) {
            ret malformed_datagram();
        }
        result.class = DATAGRAM_ESTABLISHED;
        ret result;
    }
    if ((first & 0x40) == 0) { ret malformed_datagram(); }
    if (!known_supported(initial.version)) {
        result.class = DATAGRAM_NEGOTIATE;
        ret result;
    }
    val bits: u8 = (first >> 4) & 0x03;
    if (bits == initial_bits(initial.version)) {
        if (!parse_initial(data, length).valid) { ret malformed_datagram(); }
        result.class = DATAGRAM_INITIAL;
        ret result;
    }
    if (bits == retry_bits(initial.version)) {
        if (position >= length || length - position <= packet.RETRY_INTEGRITY_TAG) {
            ret malformed_datagram();
        }
    } or (!encoded_tail_valid(data, length, position)) {
        ret malformed_datagram();
    }
    result.class = DATAGRAM_ESTABLISHED;
    ret result;
}

fun write_versions(listener: *Listener, output: *u8) usize {
    var i: usize = 0;
    for (i < listener.config.supported_version_count) {
        binary.put_uint(?output[i * 4], listener.config.supported_versions[i]::u64,
            4, binary.BIG);
        i = i + 1;
    }
    ret listener.config.supported_version_count * 4;
}

fun version_negotiation(listener: *Listener, request: *Request,
                        initial: *Initial) Result {
    var result: Result;
    val required: usize = 7 + initial.source.len::usize +
        initial.destination.len::usize + listener.config.supported_version_count * 4;
    var amplification: usize = 0 - 1::usize;
    if (request.length <= amplification / 3) { amplification = request.length * 3; }
    if (request.output == nil || request.output_capacity < required ||
        required > amplification) {
        result.action = ACTION_DROP;
        result.error = ERROR_OUTPUT;
        ret result;
    }
    var value: packet.Packet;
    value.header.kind = packet.PACKET_VERSION_NEGOTIATION;
    value.header.version = 0;
    value.header.destination = initial.source;
    value.header.source = initial.destination;
    value.header.retry_bits = request.version_negotiation_bits & 0x7f;
    var versions: [64]u8;
    value.versions.data = ?versions[0];
    value.versions.len = write_versions(listener, ?versions[0]);
    var builder: binary.Builder = binary.builder(request.output,
        request.output_capacity, binary.BIG);
    val encoded: packet.EncodeResult = packet.encode(?builder, ?value,
        packet.default_limits());
    if (!encoded.ok) {
        result.action = ACTION_ERROR;
        result.error = ERROR_OUTPUT;
        result.detail = encoded.error::u64;
        ret result;
    }
    result.action = ACTION_VERSION_NEGOTIATION;
    result.output_count = encoded.count;
    ret result;
}

fun retry(listener: *Listener, request: *Request, initial: *Initial) Result {
    var result: Result;
    if (request.retry_source.length == 0 ||
        request.retry_source.length > CONNECTION_ID_CAPACITY ||
        request.retry_nonce == 0 ||
        request.output == nil) {
        result.action = ACTION_ERROR;
        result.error = ERROR_CONFIG;
        ret result;
    }
    val retry_source: packet.ConnectionId =
        packet_connection_id(?request.retry_source);
    if (retry_source.len == 0) {
        result.action = ACTION_ERROR;
        result.error = ERROR_CONFIG;
        ret result;
    }
    var encoded_token: [token.TOKEN_SIZE]u8;
    val sealed: token.Result = token.seal_scoped(listener.token_manager,
        listener.config.source, token.PURPOSE_RETRY, request.peer, initial.destination,
        retry_source, request.now_ns, request.retry_nonce,
        ?encoded_token[0], token.TOKEN_SIZE);
    if (sealed.status != token.STATUS_OK) {
        result.action = ACTION_ERROR;
        result.error = ERROR_TOKEN;
        result.detail = sealed.error::u64;
        ret result;
    }
    var value: packet.Packet;
    value.header.kind = packet.PACKET_RETRY;
    value.header.version = initial.version;
    value.header.destination = initial.source;
    value.header.source = retry_source;
    value.token = packet.Span{data: ?encoded_token[0], len: token.TOKEN_SIZE};
    var builder: binary.Builder = binary.builder(request.output,
        request.output_capacity, binary.BIG);
    val encoded: packet.EncodeResult = packet.encode(?builder, ?value,
        packet.default_limits());
    var amplification: usize = 0 - 1::usize;
    if (request.length <= amplification / 3) { amplification = request.length * 3; }
    if (!encoded.ok || encoded.count < packet.RETRY_INTEGRITY_TAG ||
        encoded.count > amplification) {
        result.action = ACTION_ERROR;
        result.error = ERROR_OUTPUT;
        result.detail = encoded.error::u64;
        ret result;
    }
    var pseudo: [256]u8;
    var tag: [16]^u8;
    val integrity: protection.Result = protection.retry_tag(initial.version,
        contracts.Bytes{data: ?initial.destination.data[0],
            len: initial.destination.len::usize},
        contracts.Bytes{data: request.output,
            len: encoded.count - packet.RETRY_INTEGRITY_TAG},
        contracts.Buffer{data: ?pseudo[0], capacity: 256},
        contracts.SecretBuffer{data: ?tag[0], capacity: 16});
    if (integrity.error != protection.OK || integrity.written != 16) {
        result.action = ACTION_ERROR;
        result.error = ERROR_CRYPTO;
        result.detail = integrity.error::u64;
        ret result;
    }
    var i: usize = 0;
    for (i < 16) {
        request.output[encoded.count - 16 + i] = tag[i]:^;
        i = i + 1;
    }
    ct.zeroize(?tag[0], 16);
    result.action = ACTION_RETRY;
    result.output_count = encoded.count;
    result.version = initial.version;
    ret result;
}

fun claim_pending(listener: *Listener) usize {
    var offset: usize = 0;
    for (offset < listener.storage.pending_capacity) {
        val i: usize = (listener.next_pending + offset) %
            listener.storage.pending_capacity;
        if (listener.storage.pending[i].state == PENDING_FREE &&
            listener.storage.pending[i].listener_source ==
                listener.config.source &&
            listener.storage.pending[i].listener_generation ==
                listener.lease_generation) {
            val pending: *Pending = ?listener.storage.pending[i];
            pending.generation = next_generation(pending.generation);
            pending.state = PENDING_RESERVED;
            pending.owns_admission = false;
            pending.owns_replay = false;
            listener.next_pending = (i + 1) % listener.storage.pending_capacity;
            ret i;
        }
        offset = offset + 1;
    }
    ret listener.storage.pending_capacity;
}

fun external_disjoint(listener: *Listener, value: ownership.Range) bool {
    if (!value.valid) { ret false; }
    val admissions: *admission.Manager = listener.admission_manager;
    val tokens: *token.Manager = listener.token_manager;
    val listener_range: ownership.Range = ownership.bytes((?listener.config)::*u8,
        $size_of(Listener), ownership.ZERO_FORBIDDEN);
    val token_range: ownership.Range = ownership.bytes((?tokens.config)::*u8,
        $size_of(token.Manager), ownership.ZERO_FORBIDDEN);
    var ranges: [8]ownership.Range;
    ranges[0] = listener_range;
    ranges[1] = ownership.array(listener.config.supported_versions::*u8,
        listener.config.supported_version_count, $size_of(u32),
        ownership.ZERO_FORBIDDEN);
    ranges[2] = ownership.array(listener.storage.pending::*u8,
        listener.storage.pending_capacity, $size_of(Pending),
        ownership.ZERO_FORBIDDEN);
    ranges[3] = ownership.bytes(admissions::*u8, $size_of(admission.Manager),
        ownership.ZERO_FORBIDDEN);
    ranges[4] = ownership.array(admissions.storage.peers::*u8,
        admissions.storage.peer_capacity, $size_of(admission.PeerSlot),
        ownership.ZERO_FORBIDDEN);
    ranges[5] = ownership.array(admissions.storage.charges::*u8,
        admissions.storage.charge_capacity, $size_of(admission.ChargeSlot),
        ownership.ZERO_FORBIDDEN);
    ranges[6] = token_range;
    ranges[7] = ownership.array(tokens.storage.replay::*u8,
        tokens.storage.replay_capacity, $size_of(token.ReplaySlot),
        ownership.ZERO_FORBIDDEN);
    var i: usize = 0;
    for (i < 8) {
        if (!ownership.disjoint(value, ranges[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun issue_address_token(listener: *Listener, peer: ip.Endpoint,
                            now_ns: u64, nonce: u64, output: *u8,
                            capacity: usize) token.Result {
    if (!physical(listener) || !listener.initialized || listener.closing ||
        now_ns == 0 || nonce == 0 || capacity < token.TOKEN_SIZE ||
        !external_disjoint(listener, ownership.bytes(output, capacity,
            ownership.ZERO_FORBIDDEN))) {
        var failed: token.Result;
        failed.status = token.STATUS_ERROR;
        failed.error = token.ERROR_CONFIG;
        ret failed;
    }
    var empty: packet.ConnectionId;
    ret token.seal_scoped(listener.token_manager, listener.config.source,
        token.PURPOSE_ADDRESS, peer, empty, empty, now_ns, nonce, output,
        capacity);
}

pub fun preflight(listener: *Listener, request: *Request) Result {
    var result: Result;
    if (!physical(listener) || !listener.initialized || listener.closing ||
        listener.admission_manager.listener_lease != listener.config.source ||
        listener.token_manager.listener_lease != listener.config.source ||
        !listener.admission_manager.initialized ||
        !listener.token_manager.initialized) {
        result.action = ACTION_ERROR;
        result.error = ERROR_STATE;
        ret result;
    }
    val request_range: ownership.Range = ownership.bytes(request::*u8,
        $size_of(Request), ownership.ZERO_FORBIDDEN);
    if (!external_disjoint(listener, request_range)) {
        result.action = ACTION_ERROR;
        result.error = ERROR_BUFFER;
        ret result;
    }
    val input_range: ownership.Range = ownership.bytes(request.data,
        request.length, ownership.ZERO_FORBIDDEN);
    val output_range: ownership.Range = ownership.bytes(request.output,
        request.output_capacity, ownership.ZERO_ALLOWED);
    if (request.length < 7 || request.now_ns == 0 || !input_range.valid ||
        !output_range.valid || !external_disjoint(listener, input_range) ||
        !external_disjoint(listener, output_range) ||
        !ownership.disjoint(request_range, input_range) ||
        !ownership.disjoint(request_range, output_range) ||
        !ownership.disjoint(input_range, output_range)) {
        result.action = ACTION_DROP;
        result.error = ERROR_BUFFER;
        ret result;
    }
    var partial: Initial;
    var id_position: usize = 0;
    if ((request.data[0] & 0xc0) != 0xc0 ||
        !parse_ids(request.data, request.length, ?partial, ?id_position)) {
        result.action = ACTION_DROP;
        result.error = ERROR_PACKET;
        ret result;
    }
    if (!version_supported(listener, partial.version)) {
        ret version_negotiation(listener, request, ?partial);
    }
    val initial: Initial = parse_initial(request.data, request.length);
    if (!initial.valid || request.length < listener.config.minimum_initial_size ||
        initial.destination.len < 8 || initial.source.len == 0) {
        result.action = ACTION_DROP;
        result.error = ERROR_PACKET;
        ret result;
    }
    val index: usize = claim_pending(listener);
    if (index == listener.storage.pending_capacity) {
        result.action = ACTION_BLOCKED;
        result.error = ERROR_CAPACITY;
        ret result;
    }
    val pending: *Pending = ?listener.storage.pending[index];
    val acceptance: Acceptance = Acceptance{source: listener.config.source,
        index: index, generation: pending.generation};
    val admitted: admission.Result = admission.reserve_scoped(
        listener.admission_manager, listener.config.source, request.peer);
    if (admitted.status != admission.STATUS_OK) {
        release_pending(pending);
        result.action = ACTION_BLOCKED;
        result.error = ERROR_ADMISSION;
        result.detail = admitted.error::u64;
        ret result;
    }
    pending.charge = admitted.charge;
    pending.owns_admission = true;
    if (initial.token_length == 0 && listener.config.require_retry) {
        result = retry(listener, request, ?initial);
        result.cleanup = cleanup_owned(listener, pending, acceptance);
        if (result.cleanup.status == CLEANUP_RETAINED) {
            result.action = ACTION_ERROR;
            result.error = ERROR_CLEANUP;
        }
        ret result;
    }

    var opened: token.Result;
    var peer_validated: bool = false;
    var original_destination: packet.ConnectionId = initial.destination;
    var retry_source: packet.ConnectionId;
    var has_replay: bool = false;
    if (initial.token_length > 0) {
        opened = token.open_scoped(listener.token_manager, listener.config.source,
            initial.token_data, initial.token_length, request.peer, request.now_ns);
        if (opened.status != token.STATUS_OK) {
            result.action = ACTION_DROP;
            result.error = ERROR_TOKEN;
            result.detail = opened.error::u64;
            result.cleanup = cleanup_owned(listener, pending, acceptance);
            if (result.cleanup.status == CLEANUP_RETAINED) {
                result.action = ACTION_ERROR;
                result.error = ERROR_CLEANUP;
            }
            ret result;
        }
        peer_validated = true;
        if (opened.claims.purpose == token.PURPOSE_RETRY) {
            has_replay = true;
            pending.replay = opened.claims.reservation;
            pending.owns_replay = true;
            original_destination = opened.claims.original_destination;
            retry_source = opened.claims.retry_source;
            if (!packet.connection_id_equal(?initial.destination,
                ?opened.claims.retry_source)) {
                result.action = ACTION_DROP;
                result.error = ERROR_IDENTITY;
                result.cleanup = cleanup_owned(listener, pending, acceptance);
                if (result.cleanup.status == CLEANUP_RETAINED) {
                    result.action = ACTION_ERROR;
                    result.error = ERROR_CLEANUP;
                }
                ret result;
            }
        }
    }
    pending.original_destination = original_destination;
    pending.initial_destination = initial.destination;
    pending.initial_source = initial.source;
    pending.retry_source = retry_source;
    pending.peer = request.peer;
    pending.version = initial.version;
    pending.peer_validated = peer_validated;
    pending.retry_source_present = has_replay;
    result.action = ACTION_ACCEPT;
    result.version = initial.version;
    result.acceptance = acceptance;
    ret result;
}

fun pending_for(listener: *Listener, value: Acceptance, state: u8) *Pending {
    if (!physical(listener) || !listener.initialized ||
        listener.admission_manager.listener_lease != listener.config.source ||
        listener.token_manager.listener_lease != listener.config.source ||
        value.source != listener.config.source ||
        value.index >= listener.storage.pending_capacity) { ret nil; }
    val pending: *Pending = ?listener.storage.pending[value.index];
    if (pending.state != state || pending.generation != value.generation) {
        ret nil;
    }
    ret pending;
}

fun release_pending(pending: *Pending) bool {
    if (pending == nil || pending.owns_admission || pending.owns_replay) {
        ret false;
    }
    pending.state = PENDING_FREE;
    pending.generation = next_generation(pending.generation);
    ret true;
}

fun cleanup_owned(listener: *Listener, pending: *Pending,
                  value: Acceptance) CleanupResult {
    var result: CleanupResult;
    result.acceptance = value;
    result.admission_status = admission.STATUS_OK;
    result.replay_status = token.STATUS_OK;
    if (pending.owns_admission) {
        result.admission_attempted = true;
        val released: admission.Result = admission.release_scoped(
            listener.admission_manager, listener.config.source, pending.charge);
        result.admission_status = released.status;
        result.admission_error = released.error;
        if (released.status == admission.STATUS_OK) {
            pending.owns_admission = false;
        }
    }
    if (pending.owns_replay) {
        result.replay_attempted = true;
        val cancelled: token.Result = token.cancel_scoped(listener.token_manager,
            listener.config.source, pending.replay);
        result.replay_status = cancelled.status;
        result.replay_error = cancelled.error;
        if (cancelled.status == token.STATUS_OK) {
            pending.owns_replay = false;
        }
    }
    result.admission_retained = pending.owns_admission;
    result.replay_retained = pending.owns_replay;
    if (pending.owns_admission || pending.owns_replay) {
        pending.state = PENDING_CLEANUP;
        result.status = CLEANUP_RETAINED;
        ret result;
    }
    if (!release_pending(pending)) {
        result.status = CLEANUP_INVALID;
        ret result;
    }
    result.status = CLEANUP_COMPLETE;
    ret result;
}

pub fun commit(listener: *Listener, value: Acceptance) Accepted {
    var result: Accepted;
    val pending: *Pending = pending_for(listener, value, PENDING_RESERVED);
    if (pending == nil) {
        result.action = ACTION_ERROR;
        result.error = ERROR_TOKEN_HANDLE;
        ret result;
    }
    val admitted: admission.Result = admission.commit_scoped(
        listener.admission_manager, listener.config.source, pending.charge);
    if (admitted.status != admission.STATUS_OK) {
        result.cleanup = cleanup_owned(listener, pending, value);
        result.action = ACTION_ERROR;
        result.error = ERROR_ADMISSION;
        result.detail = admitted.error::u64;
        if (result.cleanup.status == CLEANUP_RETAINED) {
            result.error = ERROR_CLEANUP;
        }
        ret result;
    }
    if (pending.owns_replay) {
        val consumed: token.Result = token.commit_scoped(listener.token_manager,
            listener.config.source, pending.replay);
        if (consumed.status != token.STATUS_OK) {
            result.cleanup = cleanup_owned(listener, pending, value);
            result.action = ACTION_ERROR;
            result.error = ERROR_TOKEN;
            result.detail = consumed.error::u64;
            if (result.cleanup.status == CLEANUP_RETAINED) {
                result.error = ERROR_CLEANUP;
            }
            ret result;
        }
        pending.owns_replay = false;
    }
    result.action = ACTION_ACCEPT;
    result.charge = pending.charge;
    result.original_destination = pending.original_destination;
    result.initial_destination = pending.initial_destination;
    result.initial_source = pending.initial_source;
    result.retry_source = pending.retry_source;
    result.peer = pending.peer;
    result.version = pending.version;
    result.peer_validated = pending.peer_validated;
    result.retry_source_present = pending.retry_source_present;
    pending.owns_admission = false;
    release_pending(pending);
    ret result;
}

pub fun cancel(listener: *Listener, value: Acceptance) Result {
    var result: Result;
    val pending: *Pending = pending_for(listener, value, PENDING_RESERVED);
    if (pending == nil) {
        result.action = ACTION_ERROR;
        result.error = ERROR_TOKEN_HANDLE;
        ret result;
    }
    result.cleanup = cleanup_owned(listener, pending, value);
    if (result.cleanup.status == CLEANUP_RETAINED) {
        result.action = ACTION_ERROR;
        result.error = ERROR_CLEANUP;
        ret result;
    }
    result.action = ACTION_ACCEPT;
    ret result;
}

pub fun retry_cleanup(listener: *Listener, value: Acceptance) CleanupResult {
    val pending: *Pending = pending_for(listener, value, PENDING_CLEANUP);
    if (pending == nil) {
        var invalid: CleanupResult;
        invalid.status = CLEANUP_INVALID;
        invalid.acceptance = value;
        ret invalid;
    }
    ret cleanup_owned(listener, pending, value);
}

pub fun release_connection(listener: *Listener, charge: admission.Charge) Result {
    var result: Result;
    if (!physical(listener) || !listener.initialized ||
        listener.admission_manager.listener_lease != listener.config.source) {
        result.action = ACTION_ERROR;
        result.error = ERROR_STATE;
        ret result;
    }
    val released: admission.Result = admission.release_scoped(
        listener.admission_manager, listener.config.source, charge);
    if (released.status != admission.STATUS_OK) {
        result.action = ACTION_ERROR;
        result.error = ERROR_ADMISSION;
        result.detail = released.error::u64;
        ret result;
    }
    result.action = ACTION_ACCEPT;
    ret result;
}

pub fun begin_close(listener: *Listener) bool {
    if (!physical(listener) || !listener.initialized || listener.closing ||
        !listener.owns_storage || !listener.owns_admission_lease ||
        !listener.owns_token_lease ||
        listener.admission_manager.listener_lease != listener.config.source ||
        listener.token_manager.listener_lease != listener.config.source) {
        ret false;
    }
    listener.closing = true;
    ret true;
}

fun cleanup_ready(listener: *Listener) bool {
    if (!physical(listener)) { ret false; }
    var i: usize = 0;
    for (i < listener.storage.pending_capacity) {
        if (listener.storage.pending[i].state != PENDING_FREE) { ret false; }
        i = i + 1;
    }
    val admissions: admission.Snapshot = admission.snapshot(
        listener.admission_manager);
    ret admissions.active == 0 && admissions.reserved == 0;
}

pub fun abort_initialize(listener: *Listener,
                         value: LeaseHandle) LeaseCleanupResult {
    var invalid: LeaseCleanupResult;
    invalid.handle = value;
    invalid.status = CLEANUP_INVALID;
    if (!lease_handle_valid(listener, value) || !listener.initialized ||
        listener.closing || listener.cleanup_pending ||
        !cleanup_ready(listener)) { ret invalid; }
    ret cleanup_listener_leases(listener, value);
}

pub fun retry_initialization_cleanup(listener: *Listener,
                                     value: LeaseHandle) LeaseCleanupResult {
    var invalid: LeaseCleanupResult;
    invalid.handle = value;
    invalid.status = CLEANUP_INVALID;
    if (!lease_handle_valid(listener, value) || listener.initialized ||
        !listener.cleanup_pending ||
        (!listener.owns_storage && !listener.owns_admission_lease &&
            !listener.owns_token_lease)) {
        ret invalid;
    }
    ret cleanup_listener_leases(listener, value);
}

pub fun initialization_cleanup(listener: *Listener) LeaseCleanupResult {
    var result: LeaseCleanupResult;
    if (listener == nil) {
        result.status = CLEANUP_INVALID;
        ret result;
    }
    result.handle = LeaseHandle{source: listener.config.source,
        generation: listener.lease_generation};
    if (listener.cleanup_pending) {
        result.admission_retained = listener.owns_admission_lease;
        result.token_retained = listener.owns_token_lease;
        result.storage_retained = listener.owns_storage;
    }
    if (result.admission_retained || result.token_retained ||
        result.storage_retained) {
        result.status = CLEANUP_RETAINED;
    }
    ret result;
}

pub fun finish_close_result(listener: *Listener) LeaseCleanupResult {
    var invalid: LeaseCleanupResult;
    if (!physical(listener) || !listener.initialized || !listener.closing ||
        !listener.owns_storage || !listener.owns_admission_lease ||
        !listener.owns_token_lease ||
        !cleanup_ready(listener)) {
        invalid.status = CLEANUP_INVALID;
        ret invalid;
    }
    val handle: LeaseHandle = LeaseHandle{source: listener.config.source,
        generation: listener.lease_generation};
    ret cleanup_listener_leases(listener, handle);
}

pub fun finish_close(listener: *Listener) bool {
    ret finish_close_result(listener).status == CLEANUP_COMPLETE;
}

fun test_id(value: u8) packet.ConnectionId {
    var id: packet.ConnectionId;
    id.len = 8;
    var i: usize = 0;
    for (i < 8) { id.data[i] = value + i::u8; i = i + 1; }
    ret id;
}

fun test_initial_version(output: *u8, version: u32,
                         destination: packet.ConnectionId,
                         source: packet.ConnectionId, token_data: *u8,
                         token_length: usize) bool {
    if (output == nil || (version != packet.VERSION_1 &&
        version != packet.VERSION_2) || token_length > 0 &&
        token_data == nil) { ret false; }
    memory.raw_zero(output, 1200);
    output[0] = 0xc0;
    if (version == packet.VERSION_2) { output[0] = 0xd0; }
    binary.put_uint(?output[1], version::u64, 4, binary.BIG);
    output[5] = destination.len;
    memory.copy[u8](?output[6], ?destination.data[0], destination.len::usize);
    val source_length_position: usize = 6 + destination.len::usize;
    output[source_length_position] = source.len;
    memory.copy[u8](?output[source_length_position + 1], ?source.data[0],
        source.len::usize);
    val variable_position: usize = source_length_position + 1 + source.len::usize;
    var builder: binary.Builder = binary.builder(?output[variable_position],
        1200 - variable_position, binary.BIG);
    if (result.is_err[usize, u8](varint.write(?builder,
        token_length::u64, 0))) { ret false; }
    if (token_length > 0 &&
        result.is_err[usize, str](binary.builder_write_bytes(?builder,
            token_data, token_length))) {
        ret false;
    }
    val remaining: usize = 1200 - variable_position - builder.len;
    var width: u8 = 1;
    var tail: usize = remaining - 1;
    if (tail >= 64) { width = 2; tail = remaining - 2; }
    if (tail >= 16384) { width = 4; tail = remaining - 4; }
    if (result.is_err[usize, u8](varint.write(?builder,
        tail::u64, width))) { ret false; }
    ret builder.len + tail == 1200 - variable_position;
}

fun test_initial(output: *u8, destination: packet.ConnectionId,
                 source: packet.ConnectionId, token_data: *u8,
                 token_length: usize) bool {
    ret test_initial_version(output, packet.VERSION_1, destination, source,
        token_data, token_length);
}

# a literal that omits a field leaves the previous frame's contents there rather
# than zero (briar-systems/mach#3108), and a record-typed field cannot be zeroed
# by a nested literal for the same reason
fun no_connection_id() ConnectionId {
    var value: ConnectionId;
    value.length = 0;
    var i: usize = 0;
    for (i < CONNECTION_ID_CAPACITY) {
        value.data[i] = 0;
        i = i + 1;
    }
    ret value;
}

fun classified_id_equal(value: *ConnectionId,
                        expected: *packet.ConnectionId) bool {
    if (value == nil || expected == nil ||
        value.length != expected.len::usize) { ret false; }
    var i: usize = 0;
    for (i < value.length) {
        if (value.data[i] != expected.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "quic.connection.listener: datagram classification copies v1 v2 and short destinations" {
    val destination: packet.ConnectionId = test_id(11);
    val source: packet.ConnectionId = test_id(31);
    var input: [1200]u8;
    var before: [1200]u8;
    if (!test_initial_version(?input[0], packet.VERSION_1, destination,
            source, nil, 0)) { ret 1; }
    memory.raw_copy(?before[0], ?input[0], 1200);
    val first: ClassifiedDatagram = classify_datagram(?input[0], 1200, 8);
    if (first.class != DATAGRAM_INITIAL || !first.long_header ||
        first.version != packet.VERSION_1 ||
        !classified_id_equal(?first.destination, ?destination) ||
        !memory.raw_equal(?input[0], ?before[0], 1200)) { ret 2; }
    input[6] = input[6] ^ 0xff;
    if (!classified_id_equal(?first.destination, ?destination)) { ret 3; }

    if (!test_initial_version(?input[0], packet.VERSION_2, destination,
            source, nil, 0)) { ret 4; }
    val second: ClassifiedDatagram = classify_datagram(?input[0], 1200, 8);
    if (second.class != DATAGRAM_INITIAL || !second.long_header ||
        second.version != packet.VERSION_2 ||
        !classified_id_equal(?second.destination, ?destination)) { ret 5; }

    var short: [10]u8;
    short[0] = 0x40;
    var i: usize = 0;
    for (i < 8) {
        short[1 + i] = destination.data[i];
        i = i + 1;
    }
    short[9] = 0xa5;
    var short_before: [10]u8;
    memory.raw_copy(?short_before[0], ?short[0], 10);
    val third: ClassifiedDatagram = classify_datagram(?short[0], 10, 8);
    if (third.class != DATAGRAM_ESTABLISHED || third.long_header ||
        third.version != 0 ||
        !classified_id_equal(?third.destination, ?destination) ||
        !memory.raw_equal(?short[0], ?short_before[0], 10)) { ret 6; }
    short[1] = short[1] ^ 0xff;
    if (!classified_id_equal(?third.destination, ?destination)) { ret 7; }
    ret 0;
}

test "quic.connection.listener: datagram classification distinguishes negotiation and fails closed" {
    val destination: packet.ConnectionId = test_id(51);
    val source: packet.ConnectionId = test_id(71);
    var unknown: [27]u8;
    unknown[0] = 0xc0;
    binary.put_uint(?unknown[1], 0xfaceb00c, 4, binary.BIG);
    unknown[5] = destination.len;
    memory.copy[u8](?unknown[6], ?destination.data[0],
        destination.len::usize);
    val source_position: usize = 6 + destination.len::usize;
    unknown[source_position] = source.len;
    memory.copy[u8](?unknown[source_position + 1], ?source.data[0],
        source.len::usize);
    val invariant_length: usize = source_position + 1 + source.len::usize;
    val negotiated: ClassifiedDatagram = classify_datagram(?unknown[0],
        invariant_length, 8);
    if (negotiated.class != DATAGRAM_NEGOTIATE || !negotiated.long_header ||
        negotiated.version != 0xfaceb00c ||
        !classified_id_equal(?negotiated.destination, ?destination)) { ret 1; }

    unknown[0] = 0x80;
    binary.put_uint(?unknown[1], 0, 4, binary.BIG);
    binary.put_uint(?unknown[invariant_length], packet.VERSION_1::u64,
        4, binary.BIG);
    val version_negotiation: ClassifiedDatagram = classify_datagram(
        ?unknown[0], invariant_length + 4, 8);
    if (version_negotiation.class != DATAGRAM_ESTABLISHED ||
        !version_negotiation.long_header || version_negotiation.version != 0 ||
        !classified_id_equal(?version_negotiation.destination,
            ?destination)) { ret 2; }

    var handshake: [25]u8;
    handshake[0] = 0xe0;
    binary.put_uint(?handshake[1], packet.VERSION_1::u64, 4, binary.BIG);
    handshake[5] = destination.len;
    memory.copy[u8](?handshake[6], ?destination.data[0],
        destination.len::usize);
    handshake[source_position] = source.len;
    memory.copy[u8](?handshake[source_position + 1], ?source.data[0],
        source.len::usize);
    handshake[invariant_length] = 1;
    handshake[invariant_length + 1] = 0;
    if (classify_datagram(?handshake[0], invariant_length + 2, 8).class !=
            DATAGRAM_ESTABLISHED) { ret 3; }

    var one: [1]u8;
    one[0] = 0x40;
    if (classify_datagram(nil, 0, 8).class != DATAGRAM_MALFORMED ||
        classify_datagram(?one[0], 0, 8).class != DATAGRAM_MALFORMED ||
        classify_datagram(?one[0], MAX_DATAGRAM_LENGTH + 1, 8).class !=
            DATAGRAM_MALFORMED ||
        classify_datagram(?one[0], 1, 0).class != DATAGRAM_MALFORMED ||
        classify_datagram(?one[0], 1, CONNECTION_ID_CAPACITY + 1).class !=
            DATAGRAM_MALFORMED) { ret 4; }

    var short: [9]u8;
    short[0] = 0x40;
    if (classify_datagram(?short[0], 9, 8).class != DATAGRAM_MALFORMED) {
        ret 5;
    }
    short[0] = 0;
    if (classify_datagram(?short[0], 9, 8).class != DATAGRAM_MALFORMED) {
        ret 6;
    }
    unknown[0] = 0x80;
    binary.put_uint(?unknown[1], packet.VERSION_1::u64, 4, binary.BIG);
    if (classify_datagram(?unknown[0], invariant_length, 8).class !=
            DATAGRAM_MALFORMED) { ret 7; }
    unknown[0] = 0xc0;
    unknown[5] = (CONNECTION_ID_CAPACITY + 1)::u8;
    if (classify_datagram(?unknown[0], invariant_length, 8).class !=
            DATAGRAM_MALFORMED) { ret 8; }
    unknown[5] = destination.len;
    if (classify_datagram(?unknown[0], 6, 8).class != DATAGRAM_MALFORMED) {
        ret 9;
    }
    ret 0;
}

test "quic.connection.listener: Retry source setter copies transactionally" {
    var request: Request;
    request.retry_source = no_connection_id();
    var source: [8]u8;
    var i: usize = 0;
    for (i < 8) {
        source[i] = (91 + i)::u8;
        i = i + 1;
    }
    if (!set_retry_source(?request, ?source[0], 8) ||
        request.retry_source.length != 8) { ret 1; }
    source[0] = source[0] ^ 0xff;
    if (request.retry_source.data[0] != 91) { ret 2; }
    val retained: ConnectionId = request.retry_source;
    if (set_retry_source(?request, nil, 8) ||
        set_retry_source(?request, ?source[0], 0) ||
        set_retry_source(?request, ?source[0], CONNECTION_ID_CAPACITY + 1) ||
        set_retry_source(nil, ?source[0], 8)) { ret 3; }
    if (request.retry_source.length != retained.length) { ret 4; }
    i = 0;
    for (i < CONNECTION_ID_CAPACITY) {
        if (request.retry_source.data[i] != retained.data[i]) { ret 5; }
        i = i + 1;
    }
    ret 0;
}

test "quic.connection.listener: unsupported versions produce bounded negotiation" {
    var peer_slots: [2]admission.PeerSlot;
    var charges: [2]admission.ChargeSlot;
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission.Config{
        source: 501, max_connections: 2, max_connections_per_peer: 2},
        admission.Storage{peers: ?peer_slots[0], peer_capacity: 2,
            charges: ?charges[0], charge_capacity: 2})) { ret 1; }
    var replay: [2]token.ReplaySlot;
    var key: [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token.Config{source: 502,
        retry_max_age_ns: 100, address_max_age_ns: 1000},
        token.Storage{replay: ?replay[0], replay_capacity: 2}, 1,
        contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var pending: [2]Pending;
    var versions: [2]u32 = [2]u32{packet.VERSION_2, packet.VERSION_1};
    var listener: Listener;
    if (!initialize(?listener, Config{source: 503,
        supported_versions: ?versions[0], supported_version_count: 2,
        minimum_initial_size: 1200, require_retry: false}, Storage{pending: ?pending[0],
        pending_capacity: 2}, ?admission_manager, ?token_manager)) { ret 1; }
    var input: [32]u8;
    input[0] = 0xc0;
    binary.put_uint(?input[1], 0xfaceb00c, 4, binary.BIG);
    input[5] = 8;
    input[14] = 4;
    var output: [64]u8;
    var request: Request = Request{peer: ip.endpoint(192, 0, 2, 1, 4433),
        data: ?input[0], length: 19, now_ns: 1, output: ?output[0],
        output_capacity: 64, version_negotiation_bits: 0x35,
        retry_source: no_connection_id(), retry_nonce: 0};
    val negotiated: Result = preflight(?listener, ?request);
    if (negotiated.action != ACTION_VERSION_NEGOTIATION ||
        negotiated.output_count != 27 || output[0] != 0xb5 ||
        binary.get_uint(?output[19], 4, binary.BIG)::u32 != packet.VERSION_2 ||
        binary.get_uint(?output[23], 4, binary.BIG)::u32 != packet.VERSION_1) { ret 1; }
    var address_token: [token.TOKEN_SIZE]u8;
    val issued: token.Result = issue_address_token(?listener, request.peer, 2,
        7, ?address_token[0], token.TOKEN_SIZE);
    val opened: token.Result = token.open_scoped(?token_manager, 503,
        ?address_token[0], issued.count, request.peer, 3);
    if (issued.status != token.STATUS_OK || opened.status != token.STATUS_OK ||
        opened.claims.purpose != token.PURPOSE_ADDRESS ||
        opened.claims.original_destination.len != 0 ||
        opened.claims.retry_source.len != 0) { ret 2; }
    val original: packet.ConnectionId = test_id(61);
    val client_source: packet.ConnectionId = test_id(81);
    var initial: [1200]u8;
    if (!test_initial(?initial[0], original, client_source, nil, 0)) { ret 3; }
    request.data = ?initial[0];
    request.length = 1200;
    request.now_ns = 4;
    request.output = nil;
    request.output_capacity = 0;
    val direct_result: Result = preflight(?listener, ?request);
    val direct: Accepted = commit(?listener, direct_result.acceptance);
    if (direct_result.action != ACTION_ACCEPT || direct.action != ACTION_ACCEPT ||
        direct.peer_validated || direct.retry_source_present ||
        direct.retry_source.len != 0 ||
        !packet.connection_id_equal(?direct.original_destination, ?original) ||
        !packet.connection_id_equal(?direct.initial_destination, ?original) ||
        release_connection(?listener, direct.charge).action != ACTION_ACCEPT) {
        ret 4;
    }
    if (!test_initial(?initial[0], original, client_source,
        ?address_token[0], issued.count)) { ret 5; }
    request.now_ns = 5;
    val address_result: Result = preflight(?listener, ?request);
    val addressed: Accepted = commit(?listener, address_result.acceptance);
    if (address_result.action != ACTION_ACCEPT ||
        addressed.action != ACTION_ACCEPT || !addressed.peer_validated ||
        addressed.retry_source_present || addressed.retry_source.len != 0 ||
        !packet.connection_id_equal(?addressed.original_destination, ?original) ||
        !packet.connection_id_equal(?addressed.initial_destination, ?original) ||
        release_connection(?listener, addressed.charge).action != ACTION_ACCEPT) {
        ret 6;
    }
    ct.zeroize(?key[0], 32);
    ret 0;
}

test "quic.connection.listener: retry identity, replay, cancellation, and admission are atomic" {
    var peer_slots: [2]admission.PeerSlot;
    var charges: [2]admission.ChargeSlot;
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission.Config{
        source: 511, max_connections: 2, max_connections_per_peer: 2},
        admission.Storage{peers: ?peer_slots[0], peer_capacity: 2,
            charges: ?charges[0], charge_capacity: 2})) { ret 1; }
    var replay: [2]token.ReplaySlot;
    var key: [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token.Config{source: 512,
        retry_max_age_ns: 100, address_max_age_ns: 1000},
        token.Storage{replay: ?replay[0], replay_capacity: 2}, 1,
        contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var pending: [2]Pending;
    var versions: [1]u32 = [1]u32{packet.VERSION_1};
    var listener: Listener;
    if (!initialize(?listener, Config{source: 513,
        supported_versions: ?versions[0], supported_version_count: 1,
        minimum_initial_size: 1200, require_retry: true},
        Storage{pending: ?pending[0], pending_capacity: 2},
        ?admission_manager, ?token_manager)) { ret 1; }
    val original: packet.ConnectionId = test_id(1);
    val client_source: packet.ConnectionId = test_id(21);
    val retry_source: packet.ConnectionId = test_id(41);
    var initial: [1200]u8;
    var response: [256]u8;
    if (!test_initial(?initial[0], original, client_source, nil, 0)) { ret 1; }
    val peer: ip.Endpoint = ip.endpoint(198, 51, 100, 8, 55000);
    var request: Request = Request{peer: peer, data: ?initial[0], length: 1200,
        now_ns: 10, retry_source: no_connection_id(), retry_nonce: 99,
        output: ?response[0], output_capacity: 256,
        version_negotiation_bits: 0};
    if (!set_retry_source(?request, ?retry_source.data[0],
            retry_source.len::usize)) { ret 1; }
    val first_charge: admission.Result = admission.reserve_scoped(
        ?admission_manager, 513, ip.endpoint(203, 0, 113, 1, 4433));
    val second_charge: admission.Result = admission.reserve_scoped(
        ?admission_manager, 513, ip.endpoint(203, 0, 113, 2, 4433));
    if (first_charge.status != admission.STATUS_OK ||
        second_charge.status != admission.STATUS_OK) { ret 2; }
    memory.raw_fill(?response[0], 0xa5, 256);
    val saturated: Result = preflight(?listener, ?request);
    if (saturated.action != ACTION_BLOCKED || response[0] != 0xa5 ||
        admission.release_scoped(?admission_manager, 513,
            first_charge.charge).status != admission.STATUS_OK ||
        admission.release_scoped(?admission_manager, 513,
            second_charge.charge).status != admission.STATUS_OK) { ret 2; }
    val challenged: Result = preflight(?listener, ?request);
    if (challenged.action != ACTION_RETRY) { ret 2; }
    var decoder: binary.Decoder = binary.decoder(?response[0],
        challenged.output_count, binary.BIG);
    var retry_packet: packet.Packet;
    if (packet.decode(?decoder, true, packet.empty_decode_context(),
        packet.default_limits(), ?retry_packet).status != packet.STATUS_DONE ||
        retry_packet.header.kind != packet.PACKET_RETRY ||
        !packet.connection_id_equal(?retry_packet.header.source, ?retry_source)) { ret 3; }
    var pseudo: [256]u8;
    if (protection.verify_retry(packet.VERSION_1,
        contracts.Bytes{data: ?original.data[0], len: original.len::usize},
        contracts.Bytes{data: ?response[0],
            len: challenged.output_count - packet.RETRY_INTEGRITY_TAG},
        contracts.Bytes{data: ?response[challenged.output_count - 16], len: 16},
        contracts.Buffer{data: ?pseudo[0], capacity: 256}) != protection.OK) { ret 4; }

    var retried_initial: [1200]u8;
    if (!test_initial(?retried_initial[0], retry_source, client_source,
        retry_packet.token.data, retry_packet.token.len)) { ret 5; }
    request.data = ?retried_initial[0];
    request.now_ns = 20;
    val reserved: Result = preflight(?listener, ?request);
    if (reserved.action != ACTION_ACCEPT ||
        admission.snapshot(?admission_manager).reserved != 1 ||
        cancel(?listener, reserved.acceptance).action != ACTION_ACCEPT ||
        admission.snapshot(?admission_manager).reserved != 0) { ret 6; }
    val retried: Result = preflight(?listener, ?request);
    val accepted: Accepted = commit(?listener, retried.acceptance);
    if (retried.action != ACTION_ACCEPT || accepted.action != ACTION_ACCEPT ||
        !accepted.peer_validated ||
        !packet.connection_id_equal(?accepted.original_destination, ?original) ||
        !packet.connection_id_equal(?accepted.initial_destination,
            ?retry_source) || !accepted.retry_source_present ||
        !packet.connection_id_equal(?accepted.retry_source, ?retry_source) ||
        admission.snapshot(?admission_manager).active != 1) { ret 7; }
    if (preflight(?listener, ?request).error != ERROR_TOKEN ||
        release_connection(?listener, accepted.charge).action != ACTION_ACCEPT ||
        admission.snapshot(?admission_manager).active != 0) { ret 8; }
    ct.zeroize(?key[0], 32);
    ret 0;
}

test "quic.connection.listener: saturated admission precedes token authentication" {
    var peer_slots: [1]admission.PeerSlot;
    var charges: [1]admission.ChargeSlot;
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission.Config{
        source: 521, max_connections: 1, max_connections_per_peer: 1},
        admission.Storage{peers: ?peer_slots[0], peer_capacity: 1,
            charges: ?charges[0], charge_capacity: 1})) { ret 1; }
    var replay: [1]token.ReplaySlot;
    var key: [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token.Config{source: 522,
        retry_max_age_ns: 100, address_max_age_ns: 1000},
        token.Storage{replay: ?replay[0], replay_capacity: 1}, 1,
        contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var pending: [1]Pending;
    var versions: [1]u32 = [1]u32{packet.VERSION_1};
    var listener: Listener;
    if (!initialize(?listener, Config{source: 523,
        supported_versions: ?versions[0], supported_version_count: 1,
        minimum_initial_size: 1200, require_retry: false}, Storage{pending: ?pending[0],
        pending_capacity: 1}, ?admission_manager, ?token_manager)) { ret 1; }
    val peer: ip.Endpoint = ip.endpoint(203, 0, 113, 9, 44000);
    val original: packet.ConnectionId = test_id(1);
    val retry_source: packet.ConnectionId = test_id(41);
    val client_source: packet.ConnectionId = test_id(21);
    var encoded_token: [token.TOKEN_SIZE]u8;
    if (token.seal_scoped(?token_manager, listener.config.source,
        token.PURPOSE_RETRY, peer, original, retry_source, 10, 77,
        ?encoded_token[0], token.TOKEN_SIZE).status !=
        token.STATUS_OK) { ret 2; }
    var input: [1200]u8;
    if (!test_initial(?input[0], retry_source, client_source,
        ?encoded_token[0], token.TOKEN_SIZE)) { ret 3; }
    val occupied: admission.Result = admission.reserve_scoped(?admission_manager,
        listener.config.source, peer);
    if (occupied.status != admission.STATUS_OK ||
        admission.commit_scoped(?admission_manager, listener.config.source,
            occupied.charge).status !=
            admission.STATUS_OK) { ret 4; }
    val replay_generation: u64 = replay[0].generation;
    val replay_cursor: usize = token_manager.next_replay;
    var request: Request = Request{peer: peer, data: ?input[0], length: 1200,
        now_ns: 20, output: nil, output_capacity: 0,
        retry_source: no_connection_id(), retry_nonce: 0,
        version_negotiation_bits: 0};
    val blocked: Result = preflight(?listener, ?request);
    if (blocked.action != ACTION_BLOCKED) { ret 5; }
    if (replay[0].state != token.REPLAY_FREE ||
        replay[0].generation != replay_generation ||
        token_manager.next_replay != replay_cursor) { ret 6; }
    if (admission.release_scoped(?admission_manager, listener.config.source,
        occupied.charge).status != admission.STATUS_OK) { ret 7; }
    val accepted: Result = preflight(?listener, ?request);
    if (accepted.action != ACTION_ACCEPT ||
        cancel(?listener, accepted.acceptance).action != ACTION_ACCEPT ||
        admission.snapshot(?admission_manager).reserved != 0 ||
        replay[0].state != token.REPLAY_FREE) { ret 8; }
    ct.zeroize(?key[0], 32);
    ret 0;
}

test "quic.connection.listener: hostile configuration aliases acquire no leases" {
    val maximum: usize = ~(0::usize);
    var peer_slots: [1]admission.PeerSlot;
    var charges: [1]admission.ChargeSlot;
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission.Config{
        source: 531, max_connections: 1, max_connections_per_peer: 1},
        admission.Storage{peers: ?peer_slots[0], peer_capacity: 1,
            charges: ?charges[0], charge_capacity: 1})) { ret 1; }
    var replay: [1]token.ReplaySlot;
    var key: [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token.Config{source: 532,
        retry_max_age_ns: 100, address_max_age_ns: 1000},
        token.Storage{replay: ?replay[0], replay_capacity: 1}, 1,
        contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var pending: [1]Pending;
    pending[0].state = PENDING_RESERVED;
    var versions: [1]u32 = [1]u32{packet.VERSION_1};
    var listener: Listener;
    if (initialize(?listener, Config{source: 533,
            supported_versions: maximum::*u32, supported_version_count: 1,
            minimum_initial_size: 1200, require_retry: false}, Storage{pending: ?pending[0],
            pending_capacity: 1}, ?admission_manager, ?token_manager) ||
        initialize(?listener, Config{source: 533,
            supported_versions: ?versions[0], supported_version_count: 1,
            minimum_initial_size: 1200, require_retry: false}, Storage{pending: (?versions[0])::*Pending,
            pending_capacity: 1}, ?admission_manager, ?token_manager) ||
        listener.initialized || admission_manager.listener_lease != 0 ||
        token_manager.listener_lease != 0 || pending[0].state != PENDING_RESERVED) {
        ret 2;
    }
    ct.zeroize(?key[0], 32);
    ret 0;
}

test "quic.connection.listener: failed Acceptance cleanup retains each owned leg" {
    var peer_slots: [1]admission.PeerSlot;
    var charges: [1]admission.ChargeSlot;
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission.Config{
        source: 541, max_connections: 1, max_connections_per_peer: 1},
        admission.Storage{peers: ?peer_slots[0], peer_capacity: 1,
            charges: ?charges[0], charge_capacity: 1})) { ret 1; }
    var replay: [1]token.ReplaySlot;
    var key: [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token.Config{source: 542,
        retry_max_age_ns: 100, address_max_age_ns: 1000},
        token.Storage{replay: ?replay[0], replay_capacity: 1}, 1,
        contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var pending: [1]Pending;
    var versions: [1]u32 = [1]u32{packet.VERSION_1};
    var listener: Listener;
    if (!initialize(?listener, Config{source: 543,
        supported_versions: ?versions[0], supported_version_count: 1,
        minimum_initial_size: 1200, require_retry: false},
        Storage{pending: ?pending[0], pending_capacity: 1},
        ?admission_manager, ?token_manager)) { ret 1; }
    val peer: ip.Endpoint = ip.endpoint(198, 51, 100, 41, 55000);
    val original: packet.ConnectionId = test_id(1);
    val retry_source: packet.ConnectionId = test_id(41);
    val client_source: packet.ConnectionId = test_id(81);
    var encoded_token: [token.TOKEN_SIZE]u8;
    if (token.seal_scoped(?token_manager, listener.config.source,
        token.PURPOSE_RETRY, peer, original, retry_source, 10, 91,
        ?encoded_token[0], token.TOKEN_SIZE).status != token.STATUS_OK) { ret 2; }
    var input: [1200]u8;
    if (!test_initial(?input[0], retry_source, client_source,
        ?encoded_token[0], token.TOKEN_SIZE)) { ret 2; }
    var request: Request = Request{peer: peer, data: ?input[0], length: 1200,
        now_ns: 20, output: nil, output_capacity: 0,
        retry_source: no_connection_id(), retry_nonce: 0,
        version_negotiation_bits: 0};
    val reserved: Result = preflight(?listener, ?request);
    if (reserved.action != ACTION_ACCEPT || !pending[0].owns_admission ||
        !pending[0].owns_replay) { ret 3; }
    admission_manager.initialized = false;
    token_manager.initialized = false;
    val failed_cancel: Result = cancel(?listener, reserved.acceptance);
    if (failed_cancel.action != ACTION_ERROR ||
        failed_cancel.error != ERROR_CLEANUP ||
        failed_cancel.cleanup.status != CLEANUP_RETAINED ||
        !failed_cancel.cleanup.admission_retained ||
        !failed_cancel.cleanup.replay_retained ||
        !failed_cancel.cleanup.admission_attempted ||
        !failed_cancel.cleanup.replay_attempted ||
        failed_cancel.cleanup.admission_status != admission.STATUS_ERROR ||
        failed_cancel.cleanup.replay_status != token.STATUS_ERROR ||
        pending[0].state != PENDING_CLEANUP) { ret 4; }
    admission_manager.initialized = true;
    val admission_only: CleanupResult = retry_cleanup(?listener,
        failed_cancel.cleanup.acceptance);
    if (admission_only.status != CLEANUP_RETAINED ||
        admission_only.admission_retained || !admission_only.replay_retained ||
        !admission_only.admission_attempted ||
        !admission_only.replay_attempted ||
        admission_only.admission_status != admission.STATUS_OK ||
        admission_only.replay_status != token.STATUS_ERROR ||
        pending[0].state != PENDING_CLEANUP) { ret 5; }
    token_manager.initialized = true;
    val blocked: Result = preflight(?listener, ?request);
    if (blocked.action != ACTION_BLOCKED || blocked.error != ERROR_CAPACITY ||
        pending[0].state != PENDING_CLEANUP) { ret 6; }
    val completed: CleanupResult = retry_cleanup(?listener,
        admission_only.acceptance);
    if (completed.status != CLEANUP_COMPLETE ||
        completed.admission_retained || completed.replay_retained ||
        pending[0].state != PENDING_FREE || replay[0].state != token.REPLAY_FREE ||
        retry_cleanup(?listener, completed.acceptance).status != CLEANUP_INVALID) {
        ret 7;
    }
    val reverse: Result = preflight(?listener, ?request);
    if (reverse.action != ACTION_ACCEPT || !pending[0].owns_admission ||
        !pending[0].owns_replay) { ret 8; }
    admission_manager.initialized = false;
    val failed_reverse: Result = cancel(?listener, reverse.acceptance);
    if (failed_reverse.action != ACTION_ERROR ||
        failed_reverse.error != ERROR_CLEANUP ||
        failed_reverse.cleanup.status != CLEANUP_RETAINED ||
        !failed_reverse.cleanup.admission_retained ||
        failed_reverse.cleanup.replay_retained ||
        !failed_reverse.cleanup.admission_attempted ||
        !failed_reverse.cleanup.replay_attempted ||
        failed_reverse.cleanup.admission_status != admission.STATUS_ERROR ||
        failed_reverse.cleanup.replay_status != token.STATUS_OK ||
        pending[0].state != PENDING_CLEANUP ||
        replay[0].state != token.REPLAY_FREE) { ret 9; }
    val admission_retry: CleanupResult = retry_cleanup(?listener,
        failed_reverse.cleanup.acceptance);
    if (admission_retry.status != CLEANUP_RETAINED ||
        !admission_retry.admission_retained || admission_retry.replay_retained ||
        !admission_retry.admission_attempted || admission_retry.replay_attempted ||
        admission_retry.admission_status != admission.STATUS_ERROR ||
        pending[0].state != PENDING_CLEANUP ||
        replay[0].state != token.REPLAY_FREE) { ret 10; }
    admission_manager.initialized = true;
    val reverse_complete: CleanupResult = retry_cleanup(?listener,
        admission_retry.acceptance);
    if (reverse_complete.status != CLEANUP_COMPLETE ||
        !reverse_complete.admission_attempted ||
        reverse_complete.replay_attempted || pending[0].state != PENDING_FREE ||
        replay[0].state != token.REPLAY_FREE) { ret 11; }
    val retried: Result = preflight(?listener, ?request);
    if (retried.action != ACTION_ACCEPT || !pending[0].owns_admission ||
        !pending[0].owns_replay) { ret 12; }
    token_manager.initialized = false;
    val failed_commit: Accepted = commit(?listener, retried.acceptance);
    if (failed_commit.action != ACTION_ERROR ||
        failed_commit.error != ERROR_CLEANUP ||
        failed_commit.cleanup.status != CLEANUP_RETAINED ||
        failed_commit.cleanup.admission_retained ||
        !failed_commit.cleanup.replay_retained ||
        !failed_commit.cleanup.admission_attempted ||
        !failed_commit.cleanup.replay_attempted ||
        failed_commit.cleanup.admission_status != admission.STATUS_OK ||
        failed_commit.cleanup.replay_status != token.STATUS_ERROR ||
        admission.snapshot(?admission_manager).active != 0 ||
        admission.snapshot(?admission_manager).reserved != 0 ||
        pending[0].state != PENDING_CLEANUP) { ret 13; }
    token_manager.initialized = true;
    val commit_cleanup: CleanupResult = retry_cleanup(?listener,
        failed_commit.cleanup.acceptance);
    if (commit_cleanup.status != CLEANUP_COMPLETE ||
        pending[0].state != PENDING_FREE || replay[0].state != token.REPLAY_FREE ||
        !begin_close(?listener) || !finish_close(?listener)) { ret 14; }
    ct.zeroize(?key[0], 32);
    ret 0;
}

test "quic.connection.listener: unpublished lease cleanup retains each manager leg" {
    var peer_slots: [1]admission.PeerSlot;
    var charges: [1]admission.ChargeSlot;
    var admission_manager: admission.Manager;
    if (!admission.initialize(?admission_manager, admission.Config{
        source: 551, max_connections: 1, max_connections_per_peer: 1},
        admission.Storage{peers: ?peer_slots[0], peer_capacity: 1,
            charges: ?charges[0], charge_capacity: 1})) { ret 1; }
    var replay: [1]token.ReplaySlot;
    var key: [32]^u8;
    var token_manager: token.Manager;
    if (!token.initialize(?token_manager, token.Config{source: 552,
        retry_max_age_ns: 100, address_max_age_ns: 1000},
        token.Storage{replay: ?replay[0], replay_capacity: 1}, 1,
        contracts.SecretBytes{data: ?key[0], len: 32})) { ret 1; }
    var pending: [1]Pending;
    var versions: [1]u32 = [1]u32{packet.VERSION_1};
    val config: Config = Config{source: 553,
        supported_versions: ?versions[0], supported_version_count: 1,
        minimum_initial_size: 1200, require_retry: false};
    val storage: Storage = Storage{pending: ?pending[0], pending_capacity: 1};
    var listener: Listener;
    val first: InitializeResult = initialize_result(?listener, config, storage,
        ?admission_manager, ?token_manager);
    if (!first.ok || first.error != ERROR_NONE ||
        first.handle.source != config.source || first.handle.generation == 0 ||
        !listener.initialized || !listener.owns_storage ||
        !listener.owns_admission_lease ||
        !listener.owns_token_lease) { ret 2; }
    admission_manager.initialized = false;
    val admission_retained: LeaseCleanupResult = abort_initialize(?listener,
        first.handle);
    if (admission_retained.status != CLEANUP_RETAINED ||
        !admission_retained.admission_attempted ||
        !admission_retained.token_attempted ||
        !admission_retained.admission_retained ||
        admission_retained.token_retained ||
        !admission_retained.storage_retained ||
        admission_retained.storage_attempted || listener.initialized ||
        !listener.cleanup_pending ||
        admission_manager.listener_lease != config.source ||
        token_manager.listener_lease != 0) { ret 3; }
    val admission_only: LeaseCleanupResult = retry_initialization_cleanup(
        ?listener, admission_retained.handle);
    if (admission_only.status != CLEANUP_RETAINED ||
        !admission_only.admission_attempted || admission_only.token_attempted ||
        admission_only.storage_attempted ||
        !admission_only.admission_retained || admission_only.token_retained ||
        !admission_only.storage_retained) {
        ret 4;
    }
    admission_manager.initialized = true;
    if (initialize(?listener, config, storage, ?admission_manager,
            ?token_manager) ||
        initialization_cleanup(?listener).status != CLEANUP_RETAINED) { ret 5; }
    var blocked_listener: Listener;
    val blocked: InitializeResult = initialize_result(?blocked_listener, config,
        storage, ?admission_manager, ?token_manager);
    if (blocked.ok || blocked.error != ERROR_CAPACITY ||
        blocked_listener.initialized ||
        initialization_cleanup(?listener).status != CLEANUP_RETAINED) { ret 5; }
    val admission_complete: LeaseCleanupResult = retry_initialization_cleanup(
        ?listener, admission_only.handle);
    if (admission_complete.status != CLEANUP_COMPLETE || listener.initialized ||
        !admission_complete.storage_attempted ||
        admission_complete.storage_retained ||
        listener.cleanup_pending || listener.admission_manager != nil ||
        listener.token_manager != nil || admission_manager.listener_lease != 0 ||
        retry_initialization_cleanup(?listener, admission_complete.handle).status !=
            CLEANUP_INVALID) { ret 6; }
    val second: InitializeResult = initialize_result(?listener, config, storage,
        ?admission_manager, ?token_manager);
    if (!second.ok || second.handle.generation == first.handle.generation ||
        pending[0].state != PENDING_FREE ||
        abort_initialize(?listener, first.handle).status != CLEANUP_INVALID) {
        ret 7;
    }
    token_manager.initialized = false;
    val token_retained: LeaseCleanupResult = abort_initialize(?listener,
        second.handle);
    if (token_retained.status != CLEANUP_RETAINED ||
        !token_retained.admission_attempted || !token_retained.token_attempted ||
        token_retained.admission_retained || !token_retained.token_retained ||
        !token_retained.storage_retained || token_retained.storage_attempted ||
        admission_manager.listener_lease != 0 ||
        token_manager.listener_lease != config.source) { ret 8; }
    val token_only: LeaseCleanupResult = retry_initialization_cleanup(?listener,
        token_retained.handle);
    if (token_only.status != CLEANUP_RETAINED ||
        token_only.admission_attempted || !token_only.token_attempted ||
        token_only.storage_attempted || token_only.admission_retained ||
        !token_only.token_retained || !token_only.storage_retained) { ret 9; }
    token_manager.initialized = true;
    if (retry_initialization_cleanup(?listener, token_only.handle).status !=
        CLEANUP_COMPLETE) { ret 10; }
    val third: InitializeResult = initialize_result(?listener, config, storage,
        ?admission_manager, ?token_manager);
    if (!third.ok || !begin_close(?listener)) { ret 11; }
    admission_manager.initialized = false;
    token_manager.initialized = false;
    val both: LeaseCleanupResult = finish_close_result(?listener);
    if (both.status != CLEANUP_RETAINED || !both.admission_retained ||
        !both.token_retained || !both.storage_retained ||
        !both.admission_attempted || !both.token_attempted ||
        both.storage_attempted) { ret 12; }
    admission_manager.initialized = true;
    val token_last: LeaseCleanupResult = retry_initialization_cleanup(?listener,
        both.handle);
    if (token_last.status != CLEANUP_RETAINED ||
        token_last.admission_retained || !token_last.token_retained ||
        !token_last.storage_retained || token_last.storage_attempted ||
        !token_last.admission_attempted || !token_last.token_attempted) { ret 13; }
    token_manager.initialized = true;
    val closed: LeaseCleanupResult = retry_initialization_cleanup(?listener,
        token_last.handle);
    if (closed.status != CLEANUP_COMPLETE ||
        !closed.storage_attempted || closed.storage_retained ||
        admission_manager.listener_lease != 0 ||
        token_manager.listener_lease != 0) { ret 14; }
    if (!token.lease_listener(?token_manager, 554)) { ret 15; }
    val token_busy: InitializeResult = initialize_result(?listener, config,
        storage, ?admission_manager, ?token_manager);
    if (token_busy.ok || token_busy.error != ERROR_TOKEN ||
        token_busy.cleanup.status != CLEANUP_COMPLETE ||
        !token_busy.cleanup.admission_attempted ||
        token_busy.cleanup.token_attempted ||
        !token_busy.cleanup.storage_attempted ||
        token_busy.cleanup.storage_retained || listener.cleanup_pending ||
        admission_manager.listener_lease != 0 ||
        token_manager.listener_lease != 554 ||
        !token.release_listener(?token_manager, 554)) { ret 16; }
    if (!admission.lease_listener(?admission_manager, 555)) { ret 17; }
    val admission_busy: InitializeResult = initialize_result(?listener, config,
        storage, ?admission_manager, ?token_manager);
    if (admission_busy.ok || admission_busy.error != ERROR_ADMISSION ||
        admission_busy.cleanup.status != CLEANUP_COMPLETE ||
        admission_busy.cleanup.admission_attempted ||
        admission_busy.cleanup.token_attempted ||
        !admission_busy.cleanup.storage_attempted ||
        listener.cleanup_pending || token_manager.listener_lease != 0 ||
        admission_manager.listener_lease != 555 ||
        !admission.release_listener(?admission_manager, 555)) { ret 18; }
    ct.zeroize(?key[0], 32);
    ret 0;
}
