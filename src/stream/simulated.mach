use quic.storage.limited;
use supply: quic.storage.source;
use quic.stream.stream;

use std.memory;
use std.memory.buffers;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

#[testing]
var chunk_pool: supply.TestPool;
#[testing]
var chunk_account: supply.Account;

# every manager a test builds draws on one pool and account
#[testing]
fun test_chunks() *supply.Provider {
    if (!supply.test_made(?chunk_pool)) {
        supply.make_test(?chunk_pool, 512);
        supply.open(?chunk_pool.provider, ?chunk_account, 1, 256, 256, 0);
    }
    ret ?chunk_pool.provider;
}

#[testing]
fun test_account() *supply.Account {
    test_chunks();
    ret ?chunk_account;
}

#[testing]
fun initialize_manager(config: stream.Config,
    storage: stream.Storage) stream.Manager {
    var manager: stream.Manager;
    stream.initialize(?manager, config, storage);
    ret manager;
}

#[testing]
fun config(source: u64, streams: u64, data: u64) stream.Config {
    var value: stream.Config;
    value.source                            = source;
    value.role                              = stream.ROLE_CLIENT;
    value.local_bidirectional_limit         = streams;
    value.local_unidirectional_limit        = streams;
    value.peer_bidirectional_limit          = streams;
    value.peer_unidirectional_limit         = streams;
    value.send_max_data                     = data;
    value.receive_max_data                  = data;
    value.send_local_bidirectional_limit    = data;
    value.send_peer_bidirectional_limit     = data;
    value.send_unidirectional_limit         = data;
    value.receive_local_bidirectional_limit = data;
    value.receive_peer_bidirectional_limit  = data;
    value.receive_unidirectional_limit      = data;
    ret value;
}

test stream__stream_creation_implicit_peer_streams_and_ordered_delivery {
    var records:  [6]stream.Stream;
    var attempts: [12]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 6,
        attempts: ?attempts[0], attempt_capacity: 12,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 16
    };
    var limits: stream.Config = config(11, 2, 64);
    limits.receive_local_bidirectional_limit = 16;
    limits.receive_peer_bidirectional_limit  = 16;
    limits.receive_unidirectional_limit      = 16;
    var manager:    stream.Manager      = initialize_manager(limits, storage);
    val local_bidi: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    val local_uni:  stream.CreateResult = stream.open(?manager, stream.DIRECTION_UNIDIRECTIONAL);
    if (local_bidi.status != stream.STATUS_OK || local_bidi.handle.id != 0 ||
        local_uni.status != stream.STATUS_OK || local_uni.handle.id != 2) { ret 1; }

    var tail:      [2]u8                = [2]u8{'l', 'o'};
    val reordered: stream.ReceiveResult = stream.receive_stream(?manager, 5, 3, ?tail[0], 2, false);
    if (!reordered.ok || reordered.new_streams != 2 || manager.active_streams != 4) { ret 1; }
    val first_peer:  stream.CreateResult = stream.accept(?manager);
    val second_peer: stream.CreateResult = stream.accept(?manager);
    if (first_peer.handle.id != 1 || second_peer.handle.id != 5) { ret 1; }
    var head: [3]u8 = [3]u8{'h', 'e', 'l'};
    if (!stream.receive_stream(?manager, 5, 0, ?head[0], 3, false).ok ||
        !stream.receive_stream(?manager, 5, 5, nil, 0, true).ok) { ret 1; }
    var output: [8]u8;
    val read:   stream.ReadResult = stream.read(?manager, second_peer.handle, ?output[0], 8);
    if (read.status != stream.STATUS_FINISHED || read.count != 5 || !read.fin ||
        output[0] != 'h' || output[1] != 'e' || output[2] != 'l' ||
        output[3] != 'l' || output[4] != 'o') { ret 1; }
    ret 0;
}

test stream__final_size_overlap_and_connection_flow_failures_are_transactional {
    var records:  [3]stream.Stream;
    var attempts: [6]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 3,
        attempts: ?attempts[0], attempt_capacity: 6,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 16
    };
    var limits: stream.Config = config(12, 3, 8);
    limits.receive_local_bidirectional_limit = 16;
    limits.receive_peer_bidirectional_limit  = 16;
    limits.receive_unidirectional_limit      = 16;
    var manager:  stream.Manager       = initialize_manager(limits, storage);
    var data:     [6]u8                = [6]u8{1, 2, 3, 4, 5, 6};
    val received: stream.ReceiveResult = stream.receive_stream(?manager, 1, 0, ?data[0], 6, false);
    if (!received.ok || manager.receive_committed != 6 || manager.active_streams != 1) { ret 1; }
    if (!stream.receive_stream(?manager, 1, 0, ?data[0], 6, false).ok ||
        manager.receive_committed != 6) { ret 1; }
    if (stream.receive_stream(?manager, 1, 3, nil, 0, true).error != stream.ERROR_FINAL_SIZE ||
        manager.receive_committed != 6) { ret 1; }
    var conflict: [1]u8 = [1]u8{9};
    if (stream.receive_stream(?manager, 1, 2, ?conflict[0], 1, false).error != stream.ERROR_DATA_CONFLICT ||
        manager.receive_committed != 6) { ret 1; }
    if (stream.receive_stream(?manager, 5, 0, ?data[0], 3, false).error != stream.ERROR_FLOW_CONTROL ||
        manager.active_streams != 1 || manager.peer_bidirectional_opened != 1) { ret 1; }
    if (stream.receive_reset(?manager, 1, 7, 5).error != stream.ERROR_FINAL_SIZE ||
        manager.receive_committed != 6) { ret 1; }
    if (stream.receive_stream(?manager, 1, 0x4000000000000000, nil, 0, false).error != stream.ERROR_OVERFLOW ||
        manager.receive_committed != 6) { ret 1; }
    ret 0;
}

test stream__exact_send_budgets_and_duplicate_transmissions_retain_ownership {
    var records:  [2]stream.Stream;
    var attempts: [8]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 2,
        attempts: ?attempts[0], attempt_capacity: 8,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 4
    };
    var limits: stream.Config = config(13, 2, 6);
    limits.send_local_bidirectional_limit = 4;
    limits.receive_max_data               = 16;
    var manager:     stream.Manager      = initialize_manager(limits, storage);
    val opened:      stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var data:        [8]u8               = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    val first_write: stream.WriteResult  = stream.write(?manager, opened.handle, ?data[0], 8);
    if (first_write.count != 4 || !first_write.stream_blocked || !first_write.storage_blocked ||
        first_write.connection_blocked) { ret 1; }
    val first: stream.Prepared = stream.prepare(?manager, opened.handle, 4, false);
    if (!first.ok || first.offset != 0 || first.data.len != 4 ||
        stream.publish(?manager, first).status != stream.STATUS_OK) { ret 1; }
    val duplicate: stream.Prepared = stream.prepare(?manager, opened.handle, 4, true);
    if (!duplicate.ok || stream.publish(?manager, duplicate).status != stream.STATUS_OK) { ret 1; }
    # the acknowledged bytes are delivered, but their chunk stays while the
    # duplicate still references it in flight
    if (stream.on_terminal(?manager, first.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        records[opened.handle.index].send_base != 4 || supply.held(test_account(), supply.SEND) != 1) { ret 1; }
    # everything written is delivered and nothing is in flight, so the partly
    # used chunk goes too and the next write takes a fresh one
    if (stream.on_terminal(?manager, duplicate.token, stream.TERMINAL_LOST).status != stream.STATUS_OK ||
        records[opened.handle.index].send_base != 4 || supply.held(test_account(), supply.SEND) != 0) { ret 1; }

    if (stream.update_max_stream_data(?manager, opened.handle, 8).status != stream.STATUS_OK) { ret 1; }
    val second_write: stream.WriteResult = stream.write(?manager, opened.handle, ?data[4], 4);
    if (second_write.count != 2 || !second_write.connection_blocked || second_write.stream_blocked) { ret 1; }
    if (stream.finish(?manager, opened.handle).status != stream.STATUS_OK)                          { ret 1; }
    val final: stream.Prepared = stream.prepare(?manager, opened.handle, 4, false);
    if (!final.ok || !final.fin || final.offset != 4 || final.data.len != 2 ||
        stream.publish(?manager, final).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, final.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK) { ret 1; }
    if (!stream.snapshot(?manager, opened.handle).send_closed) { ret 1; }
    # a bare fin closes the receive side once read hands it to the owner
    if (!stream.receive_stream(?manager, 0, 0, nil, 0, true).ok ||
        stream.snapshot(?manager, opened.handle).receive_closed ||
        stream.read(?manager, opened.handle, ?data[0], 1).status != stream.STATUS_FINISHED ||
        !stream.snapshot(?manager, opened.handle).receive_closed) { ret 1; }
    if (stream.release(?manager, opened.handle).status != stream.STATUS_OK ||
        supply.held(test_account(), supply.SEND) != 0) { ret 1; }
    ret 0;
}

test stream__reset_stop_sending_and_cancellation_close_both_directions {
    var records:  [2]stream.Stream;
    var attempts: [8]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 2,
        attempts: ?attempts[0], attempt_capacity: 8,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    };
    var limits: stream.Config = config(14, 2, 16);
    limits.receive_local_bidirectional_limit = 8;
    limits.receive_peer_bidirectional_limit  = 8;
    limits.receive_unidirectional_limit      = 8;
    var manager: stream.Manager      = initialize_manager(limits, storage);
    val opened:  stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var data:    [3]u8               = [3]u8{1, 2, 3};
    stream.write(?manager, opened.handle, ?data[0], 3);
    val stopped: stream.ReceiveResult = stream.receive_stop(?manager, 0, 42);
    if (!stopped.ok || !stream.snapshot(?manager, opened.handle).send_cancelled) { ret 1; }
    var reset: stream.Prepared = stream.prepare(?manager, opened.handle, 8, false);
    if (!reset.ok || reset.kind != stream.SEND_RESET || reset.final_size != 3 || reset.application_error != 42 ||
        stream.publish(?manager, reset).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, reset.token, stream.TERMINAL_LOST).status != stream.STATUS_OK) { ret 1; }
    reset = stream.prepare(?manager, opened.handle, 8, false);
    if (!reset.ok || stream.publish(?manager, reset).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, reset.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK) { ret 1; }
    if (!stream.receive_stream(?manager, 0, 0, nil, 0, true).ok ||
        stream.read(?manager, opened.handle, ?data[0], 3).status != stream.STATUS_FINISHED ||
        stream.release(?manager, opened.handle).status != stream.STATUS_OK) { ret 1; }

    val next: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    if (stream.cancel_receive(?manager, next.handle, 9).status != stream.STATUS_OK ||
        stream.cancel_send(?manager, next.handle, 10).status != stream.STATUS_OK ||
        !stream.receive_stop(?manager, next.handle.id, 42).ok) { ret 1; }
    var control: stream.Prepared = stream.prepare(?manager, next.handle, 8, false);
    if (control.kind != stream.SEND_RESET || control.application_error != 10 ||
        stream.publish(?manager, control).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, control.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK) { ret 1; }
    control = stream.prepare(?manager, next.handle, 8, false);
    if (control.kind != stream.SEND_STOP || stream.publish(?manager, control).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, control.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK) { ret 1; }
    if (!stream.receive_reset(?manager, next.handle.id, 11, 3).ok || manager.receive_committed != 3 ||
        manager.receive_max_data != 19 || !stream.snapshot(?manager, next.handle).receive_closed ||
        !stream.receive_stream(?manager, next.handle.id, 0, ?data[0], 3, true).ok ||
        stream.acknowledge_reset(?manager, next.handle).status != stream.STATUS_OK ||
        stream.release(?manager, next.handle).status != stream.STATUS_OK) { ret 1; }
    ret 0;
}

test stream__connection_and_stream_flow_budgets_remain_independent {
    var records:  [4]stream.Stream;
    var attempts: [8]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 4,
        attempts: ?attempts[0], attempt_capacity: 8,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    };
    var limits: stream.Config = config(16, 4, 5);
    limits.send_local_bidirectional_limit    = 3;
    limits.send_peer_bidirectional_limit     = 3;
    limits.send_unidirectional_limit         = 3;
    limits.receive_local_bidirectional_limit = 4;
    limits.receive_peer_bidirectional_limit  = 4;
    limits.receive_unidirectional_limit      = 4;
    var manager:            stream.Manager      = initialize_manager(limits, storage);
    val first:              stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    val second:             stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var data:               [8]u8               = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    val stream_limited:     stream.WriteResult  = stream.write(?manager, first.handle, ?data[0], 8);
    val connection_limited: stream.WriteResult  = stream.write(?manager, second.handle, ?data[0], 8);
    if (stream_limited.count != 3 || !stream_limited.stream_blocked || stream_limited.connection_blocked ||
        connection_limited.count != 2 || !connection_limited.connection_blocked || connection_limited.stream_blocked ||
        manager.send_committed != 5) { ret 1; }
    if (stream.update_max_data(?manager, 8).status != stream.STATUS_OK ||
        stream.update_max_stream_data(?manager, first.handle, 6).status != stream.STATUS_OK ||
        stream.write(?manager, first.handle, ?data[3], 3).count != 3 || manager.send_committed != 8) { ret 1; }

    if (!stream.receive_stream(?manager, 1, 0, ?data[0], 4, false).ok ||
        stream.receive_stream(?manager, 5, 0, ?data[0], 2, false).error != stream.ERROR_FLOW_CONTROL ||
        manager.peer_bidirectional_opened != 1 || manager.receive_committed != 4) { ret 1; }
    val peer_second: stream.ReceiveResult = stream.receive_stream(?manager, 5, 0, ?data[0], 1, false);
    if (!peer_second.ok || peer_second.new_streams != 1 || manager.receive_committed != 5) { ret 1; }
    val peer_first: stream.CreateResult = stream.accept(?manager);
    if (peer_first.handle.id != 1 || stream.accept(?manager).handle.id != 5) { ret 1; }
    var output:   [4]u8;
    val consumed: stream.ReadResult = stream.read(?manager, peer_first.handle, ?output[0], 4);
    if (consumed.count != 4 || consumed.receive_max_data != 5 ||
        consumed.receive_max_stream_data != 4 || consumed.receive_uncredited != 4) { ret 1; }
    if (stream.receive_stream(?manager, 5, 1, ?data[1], 3, false).error !=
        stream.ERROR_FLOW_CONTROL || manager.receive_committed != 5) { ret 1; }
    if (stream.credit(?manager, peer_first.handle, 5).error != stream.ERROR_STATE ||
        manager.receive_max_data != 5) { ret 1; }
    val released: stream.OperationResult = stream.credit(?manager, peer_first.handle, 4);
    if (released.status != stream.STATUS_OK || released.receive_max_data != 9 ||
        released.receive_max_stream_data != 8 ||
        stream.snapshot(?manager, peer_first.handle).receive_uncredited != 0 ||
        stream.credit(?manager, peer_first.handle, 1).error != stream.ERROR_STATE) { ret 1; }
    if (!stream.receive_stream(?manager, 5, 1, ?data[1], 3, false).ok ||
        manager.receive_committed != 8) { ret 1; }
    ret 0;
}

test stream__unidirectional_streams_enforce_ownership_and_ordered_delivery {
    var records:  [2]stream.Stream;
    var attempts: [4]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 2,
        attempts: ?attempts[0], attempt_capacity: 4,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    };
    var limits: stream.Config = config(17, 2, 16);
    limits.receive_local_bidirectional_limit = 8;
    limits.receive_peer_bidirectional_limit  = 8;
    limits.receive_unidirectional_limit      = 8;
    var manager: stream.Manager      = initialize_manager(limits, storage);
    val local:   stream.CreateResult = stream.open(?manager, stream.DIRECTION_UNIDIRECTIONAL);
    var data:    [4]u8               = [4]u8{1, 2, 3, 4};
    if (local.handle.id != 2 || stream.receive_stream(?manager, 2, 0, ?data[0], 1, false).error != stream.ERROR_DIRECTION ||
        stream.write(?manager, local.handle, ?data[0], 4).count != 4 ||
        stream.finish(?manager, local.handle).status != stream.STATUS_OK) { ret 1; }
    val sent: stream.Prepared = stream.prepare(?manager, local.handle, 8, false);
    if (!sent.ok || !sent.fin || stream.publish(?manager, sent).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, sent.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        stream.release(?manager, local.handle).status != stream.STATUS_OK) { ret 1; }

    if (!stream.receive_stream(?manager, 3, 2, ?data[2], 2, true).ok ||
        !stream.receive_stream(?manager, 3, 0, ?data[0], 2, false).ok) { ret 1; }
    val peer: stream.CreateResult = stream.accept(?manager);
    if (peer.handle.id != 3 || stream.write(?manager, peer.handle, ?data[0], 1).error != stream.ERROR_DIRECTION ||
        stream.receive_stop(?manager, 3, 1).error != stream.ERROR_DIRECTION) { ret 1; }
    var output:   [4]u8;
    val received: stream.ReadResult = stream.read(?manager, peer.handle, ?output[0], 4);
    if (received.status != stream.STATUS_FINISHED || received.count != 4 || !received.fin ||
        output[0] != 1 || output[1] != 2 || output[2] != 3 || output[3] != 4 ||
        stream.release(?manager, peer.handle).status != stream.STATUS_OK) { ret 1; }
    if (!stream.receive_stream(?manager, 3, 4, nil, 0, true).closed ||
        !stream.receive_reset(?manager, 3, 9, 4).closed ||
        !stream.receive_stop(?manager, 2, 9).closed) { ret 1; }
    ret 0;
}

test stream__close_preserves_reserved_stream_publication {
    var records:  [1]stream.Stream;
    var attempts: [1]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 1,
        attempts: ?attempts[0], attempt_capacity: 1,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 4
    };
    var manager: stream.Manager      = initialize_manager(config(18, 1, 4), storage);
    val opened:  stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var data:    [1]u8               = [1]u8{6};
    stream.write(?manager, opened.handle, ?data[0], 1);
    val prepared: stream.Prepared = stream.prepare(?manager, opened.handle, 1, false);
    if (!prepared.ok || stream.begin_close(?manager).status != stream.STATUS_OK || prepared.data.data[0] != 6 ||
        stream.finish_close(?manager).error != stream.ERROR_CAPACITY ||
        stream.publish(?manager, prepared).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, prepared.token,
        stream.TERMINAL_ACKED).status != stream.STATUS_OK) { ret 1; }
    if (stream.cancel_prepared(?manager, prepared).status != stream.STATUS_STALE ||
        stream.finish_close(?manager).status != stream.STATUS_OK) { ret 1; }
    ret 0;
}

test stream__flow_control_frames_create_only_permitted_peer_stream_halves {
    var records:  [4]stream.Stream;
    var attempts: [4]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 4,
        attempts: ?attempts[0], attempt_capacity: 4,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    };
    var limits: stream.Config = config(19, 3, 16);
    limits.send_peer_bidirectional_limit     = 4;
    limits.receive_local_bidirectional_limit = 8;
    limits.receive_peer_bidirectional_limit  = 8;
    limits.receive_unidirectional_limit      = 8;
    var manager: stream.Manager       = initialize_manager(limits, storage);
    val maximum: stream.ReceiveResult = stream.receive_max_stream_data(?manager, 5, 12);
    if (!maximum.ok || maximum.new_streams != 2 || records[maximum.handle.index].send_limit != 12 ||
        stream.accept(?manager).handle.id != 1 || stream.accept(?manager).handle.id != 5) { ret 1; }
    val blocked: stream.ReceiveResult = stream.receive_stream_data_blocked(?manager, 7, 8);
    if (!blocked.ok || blocked.new_streams != 2 || blocked.receive_max_stream_data != 8 ||
        stream.accept(?manager).handle.id != 3 || stream.accept(?manager).handle.id != 7) { ret 1; }
    if (stream.receive_max_stream_data(?manager, 3, 4).error != stream.ERROR_DIRECTION ||
        stream.receive_stream_data_blocked(?manager, 0, 1).error != stream.ERROR_DIRECTION ||
        stream.receive_max_stream_data(?manager, 9, 1).error != stream.ERROR_CAPACITY || manager.active_streams != 4) { ret 1; }
    if (stream.receive_data_blocked(?manager, 16).receive_max_data != 16 ||
        stream.receive_streams_blocked(?manager, stream.DIRECTION_BIDIRECTIONAL, 3).peer_max_streams != 3) { ret 1; }
    ret 0;
}

test stream__stream_exhaustion_and_two_phase_teardown_are_bounded {
    var records:  [2]stream.Stream;
    var attempts: [4]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 2,
        attempts: ?attempts[0], attempt_capacity: 4,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    };
    var limits: stream.Config = config(15, 3, 16);
    limits.receive_max_data                  = 16;
    limits.receive_local_bidirectional_limit = 8;
    limits.receive_peer_bidirectional_limit  = 8;
    limits.receive_unidirectional_limit      = 8;
    var manager: stream.Manager = initialize_manager(limits, storage);
    var data:    [1]u8          = [1]u8{1};
    if (stream.receive_stream(?manager, 9, 0, ?data[0], 1, false).error != stream.ERROR_CAPACITY ||
        manager.active_streams != 0 || manager.peer_bidirectional_opened != 0) { ret 1; }
    val opened: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    stream.write(?manager, opened.handle, ?data[0], 1);
    val prepared: stream.Prepared = stream.prepare(?manager, opened.handle, 1, false);
    if (stream.publish(?manager, prepared).status != stream.STATUS_OK ||
        stream.begin_close(?manager).status != stream.STATUS_OK ||
        stream.finish_close(?manager).error != stream.ERROR_CAPACITY) { ret 1; }
    if (stream.on_terminal(?manager, prepared.token, stream.TERMINAL_LOST).status != stream.STATUS_OK ||
        stream.finish_close(?manager).status != stream.STATUS_OK) { ret 1; }
    if (stream.snapshot(?manager, opened.handle).ok) { ret 1; }
    ret 0;
}

test stream__consumed_credit_frames_survive_loss_and_stream_release {
    var records:  [1]stream.Stream;
    var attempts: [4]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 1,
        attempts: ?attempts[0], attempt_capacity: 4,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    };
    var limits: stream.Config = config(20, 1, 8);
    limits.receive_local_bidirectional_limit = 8;
    limits.receive_peer_bidirectional_limit  = 8;
    limits.receive_unidirectional_limit      = 8;
    var manager: stream.Manager = initialize_manager(limits, storage);
    var input:   [4]u8          = [4]u8{1, 2, 3, 4};
    if (!stream.receive_stream(?manager, 1, 0, ?input[0], 4, false).ok) {
        ret 1;
    }
    val accepted: stream.CreateResult = stream.accept(?manager);
    var output:   [4]u8;
    if (stream.read(?manager, accepted.handle, ?output[0], 4).count != 4 ||
        stream.prepare_control(?manager).status != stream.STATUS_EMPTY ||
        stream.credit(?manager, accepted.handle, 4).status != stream.STATUS_OK) {
        ret 1;
    }
    var control: stream.Prepared = stream.prepare_control(?manager);
    if (control.kind != stream.SEND_MAX_DATA || control.maximum != 12 ||
        stream.publish(?manager, control).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, control.token,
        stream.TERMINAL_LOST).status != stream.STATUS_OK) { ret 1; }
    control = stream.prepare_control(?manager);
    if (control.kind != stream.SEND_MAX_DATA ||
        stream.publish(?manager, control).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, control.token,
        stream.TERMINAL_ACKED).status != stream.STATUS_OK) { ret 1; }
    control = stream.prepare_control(?manager);
    if (control.kind != stream.SEND_MAX_STREAM_DATA || control.maximum != 12 ||
        stream.cancel_prepared(?manager, control).status != stream.STATUS_OK) {
        ret 1;
    }
    control = stream.prepare_control(?manager);
    if (stream.publish(?manager, control).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, control.token,
        stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        !stream.receive_stream(?manager, 1, 4, nil, 0, true).ok ||
        stream.read(?manager, accepted.handle, ?output[0], 4).status != stream.STATUS_FINISHED) { ret 1; }
    records[accepted.handle.index].send_closed = true;
    if (stream.release(?manager, accepted.handle).status != stream.STATUS_OK) {
        ret 1;
    }
    control = stream.prepare_control(?manager);
    if (control.kind != stream.SEND_MAX_STREAMS_BIDI || control.maximum != 2 ||
        stream.publish(?manager, control).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, control.token,
        stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        stream.prepare_control(?manager).status != stream.STATUS_EMPTY) { ret 1; }
    ret 0;
}

#[testing]
fun credit_storage(records: *stream.Stream, attempts: *stream.Attempt) stream.Storage {
    ret stream.Storage{
        streams:  records, stream_capacity: 1,
        attempts: attempts, attempt_capacity: 4,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    };
}

#[testing]
fun credit_limits(source: u64) stream.Config {
    var limits: stream.Config = config(source, 1, 8);
    limits.receive_max_data                  = 8;
    limits.receive_local_bidirectional_limit = 8;
    limits.receive_peer_bidirectional_limit  = 8;
    limits.receive_unidirectional_limit      = 8;
    ret limits;
}

test stream__cancellation_reconciles_delivered_bytes_exactly_once {
    var records:  [1]stream.Stream;
    var attempts: [4]stream.Attempt;
    var manager:  stream.Manager = initialize_manager(credit_limits(30),
        credit_storage(?records[0], ?attempts[0]));
    var input: [6]u8 = [6]u8{1, 2, 3, 4, 5, 6};
    if (!stream.receive_stream(?manager, 1, 0, ?input[0], 6, false).ok) { ret 1; }
    val accepted: stream.CreateResult = stream.accept(?manager);
    var output:   [4]u8;
    if (stream.read(?manager, accepted.handle, ?output[0], 4).count != 4 ||
        manager.receive_max_data != 8) { ret 2; }
    if (stream.cancel_receive(?manager, accepted.handle, 7).status !=
        stream.STATUS_OK || manager.receive_max_data != 14 ||
        stream.snapshot(?manager, accepted.handle).receive_uncredited != 0) {
        ret 3;
    }
    if (stream.cancel_receive(?manager, accepted.handle, 7).status !=
        stream.STATUS_OK || manager.receive_max_data != 14 ||
        stream.credit(?manager, accepted.handle, 1).error !=
        stream.ERROR_STATE || manager.receive_max_data != 14) { ret 4; }
    ret 0;
}

test stream__reset_acknowledgement_reconciles_delivered_bytes_once {
    var records:  [1]stream.Stream;
    var attempts: [4]stream.Attempt;
    var manager:  stream.Manager = initialize_manager(credit_limits(31),
        credit_storage(?records[0], ?attempts[0]));
    var input: [4]u8 = [4]u8{1, 2, 3, 4};
    if (!stream.receive_stream(?manager, 1, 0, ?input[0], 4, false).ok) { ret 1; }
    val accepted: stream.CreateResult = stream.accept(?manager);
    var output:   [4]u8;
    if (stream.read(?manager, accepted.handle, ?output[0], 4).count != 4 ||
        manager.receive_max_data != 8) { ret 2; }
    if (!stream.receive_reset(?manager, 1, 9, 6).ok ||
        manager.receive_max_data != 8) { ret 3; }
    if (stream.acknowledge_reset(?manager, accepted.handle).status !=
        stream.STATUS_OK || manager.receive_max_data != 14 ||
        stream.snapshot(?manager, accepted.handle).receive_uncredited != 0) {
        ret 4;
    }
    ret 0;
}

test stream__release_reconciles_bytes_the_caller_never_returned {
    var records:  [1]stream.Stream;
    var attempts: [4]stream.Attempt;
    var manager:  stream.Manager = initialize_manager(credit_limits(32),
        credit_storage(?records[0], ?attempts[0]));
    var input: [4]u8 = [4]u8{1, 2, 3, 4};
    if (!stream.receive_stream(?manager, 1, 0, ?input[0], 4, true).ok) { ret 1; }
    val accepted: stream.CreateResult = stream.accept(?manager);
    var output:   [4]u8;
    val consumed: stream.ReadResult   = stream.read(?manager, accepted.handle,
        ?output[0], 4);
    if (consumed.count != 4 || !consumed.fin ||
        consumed.receive_uncredited != 4 || manager.receive_max_data != 8) {
        ret 2;
    }
    if (stream.credit(?manager, accepted.handle, 1).status != stream.STATUS_OK ||
        manager.receive_max_data != 9 ||
        stream.snapshot(?manager, accepted.handle).receive_uncredited != 3) {
        ret 3;
    }
    records[accepted.handle.index].send_closed = true;
    if (stream.release(?manager, accepted.handle).status != stream.STATUS_OK ||
        manager.receive_max_data != 12) { ret 4; }
    ret 0;
}

test stream__a_closing_manager_releases_a_stream_whose_fin_was_never_acknowledged {
    var records:  [1]stream.Stream;
    var attempts: [1]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 1,
        attempts: ?attempts[0], attempt_capacity: 1,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 4
    };
    var manager: stream.Manager      = initialize_manager(config(18, 1, 4), storage);
    val opened:  stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var data:    [1]u8               = [1]u8{6};
    stream.write(?manager, opened.handle, ?data[0], 1);
    val prepared: stream.Prepared = stream.prepare(?manager, opened.handle, 1, false);
    if (!prepared.ok || stream.publish(?manager, prepared).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, prepared.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK) { ret 1; }
    if (stream.finish(?manager, opened.handle).status != stream.STATUS_OK) { ret 2; }
    # the fin is pending and the receive side is open, so the stream is not releasable
    if (stream.release(?manager, opened.handle).error != stream.ERROR_STATE)                               { ret 3; }
    if (stream.begin_close(?manager).status != stream.STATUS_OK)                                           { ret 4; }
    if (stream.release(?manager, opened.handle).status != stream.STATUS_OK || manager.active_streams != 0) { ret 5; }
    ret 0;
}

# rfc 9000 2.2: every byte is sent at least once before it counts as delivered
test stream__a_send_reserved_across_a_ring_lap_never_claims_the_next_lap {
    var records:  [2]stream.Stream;
    var attempts: [6]stream.Attempt;
    val storage:  stream.Storage = stream.Storage{
        streams:  ?records[0], stream_capacity: 2,
        attempts: ?attempts[0], attempt_capacity: 6,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 16
    };
    var limits: stream.Config = config(21, 2, 64);
    limits.receive_max_data                  = 32;
    limits.receive_local_bidirectional_limit = 16;
    limits.receive_peer_bidirectional_limit  = 16;
    limits.receive_unidirectional_limit      = 16;
    var manager: stream.Manager      = initialize_manager(limits, storage);
    val opened:  stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var first:   [16]u8;
    var second:  [16]u8;
    var i:       usize               = 0;
    for (i < 16) {
        first[i]  = i::u8;
        second[i] = (0x80 + i)::u8;
        i         = i + 1;
    }
    if (opened.status != stream.STATUS_OK ||
        stream.write(?manager, opened.handle, ?first[0], 16).count != 16) { ret 1; }
    # an original send and a probe retransmit of the same bytes are in flight
    val original: stream.Prepared = stream.prepare(?manager, opened.handle, 64, false);
    if (!original.ok || original.data.len != 16 ||
        stream.publish(?manager, original).status != stream.STATUS_OK) { ret 2; }
    val probe: stream.Prepared = stream.prepare(?manager, opened.handle, 64, true);
    if (!probe.ok || probe.data.len != 16 ||
        stream.publish(?manager, probe).status != stream.STATUS_OK) { ret 3; }
    # a third send of the old lap is reserved, and its bytes are already sealed
    val reserved: stream.Prepared = stream.prepare(?manager, opened.handle, 64, true);
    if (!reserved.ok || reserved.offset != 0 || reserved.data.len != 16) { ret 4; }
    # both in-flight sends are acknowledged before it completes, the old lap is
    # reclaimed, and the next lap reuses the same ring slots
    if (stream.on_terminal(?manager, original.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, probe.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        records[0].send_base != 16 ||
        stream.write(?manager, opened.handle, ?second[0], 16).count != 16) { ret 5; }
    if (stream.publish(?manager, reserved).status != stream.STATUS_OK) { ret 6; }
    # the next lap is still unsent, so it is still the next thing to send
    val next: stream.Prepared = stream.prepare(?manager, opened.handle, 64, false);
    if (!next.ok || next.offset != 16 || next.data.len != 16 ||
        next.data.data[0] != 0x80) { ret 7; }
    if (stream.publish(?manager, next).status != stream.STATUS_OK) { ret 8; }
    # the stale send's acknowledgement cannot deliver the next lap
    if (stream.on_terminal(?manager, reserved.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        records[0].send_base != 16) { ret 9; }
    if (stream.on_terminal(?manager, next.token, stream.TERMINAL_ACKED).status != stream.STATUS_OK ||
        records[0].send_base != 32 || supply.held(test_account(), supply.SEND) != 0 ||
        manager.active_attempts != 0) { ret 10; }
    ret 0;
}

#[testing]
fun ready_manager(records: *stream.Stream, attempts: *stream.Attempt, limit: usize) stream.Manager {
    var limits: stream.Config = config(31, 4, 8);
    limits.receive_max_data                  = 32;
    limits.receive_local_bidirectional_limit = 8;
    limits.receive_peer_bidirectional_limit  = 8;
    limits.receive_unidirectional_limit      = 8;
    limits.send_local_bidirectional_limit    = 2;
    ret initialize_manager(limits, stream.Storage{
        streams:  records, stream_capacity: 4,
        attempts: attempts, attempt_capacity: 8,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: limit
    });
}

test stream__the_ready_queue_reports_each_kind_of_news_once_oldest_first {
    var records:  [4]stream.Stream;
    var attempts: [8]stream.Attempt;
    var manager:  stream.Manager = ready_manager(?records[0], ?attempts[0], 8);
    var bytes:    [8]u8          = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    if (stream.next_ready(?manager).status != stream.STATUS_EMPTY) { ret 1; }
    # data for a peer stream is not news until accept names the stream
    if (!stream.receive_stream(?manager, 1, 0, ?bytes[0], 2, false).ok ||
        stream.next_ready(?manager).status != stream.STATUS_EMPTY) { ret 2; }
    val peer:  stream.CreateResult = stream.accept(?manager);
    val first: stream.Ready        = stream.next_ready(?manager);
    if (peer.status != stream.STATUS_OK || first.status != stream.STATUS_OK ||
        first.handle.id != 1 || !first.readable || first.writable || first.reset ||
        stream.next_ready(?manager).status != stream.STATUS_EMPTY) { ret 3; }
    # a local stream blocked on its own credit is reported when credit arrives
    val local: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    if (stream.write(?manager, local.handle, ?bytes[0], 4).count != 2 ||
        stream.next_ready(?manager).status != stream.STATUS_EMPTY) { ret 4; }
    # news for two streams comes out in order, and a second report for a queued
    # stream only adds to it
    if (!stream.receive_stream(?manager, 1, 2, ?bytes[2], 2, false).ok ||
        !stream.receive_max_stream_data(?manager, local.handle.id, 8).ok ||
        !stream.receive_stream(?manager, 1, 4, nil, 0, true).ok) { ret 5; }
    val second: stream.Ready = stream.next_ready(?manager);
    val third:  stream.Ready = stream.next_ready(?manager);
    if (second.handle.id != 1 || !second.readable || third.handle.id != local.handle.id ||
        !third.writable || third.readable ||
        stream.next_ready(?manager).status != stream.STATUS_EMPTY) { ret 6; }
    # a reset is news too
    if (!stream.receive_reset(?manager, 5, 9, 0).ok) { ret 7; }
    val reset_peer: stream.CreateResult = stream.accept(?manager);
    val reset:      stream.Ready        = stream.next_ready(?manager);
    if (reset_peer.handle.id != 5 || !reset.reset || reset.handle.id != 5) { ret 8; }
    ret 0;
}

test stream__a_connection_credit_or_buffer_release_reports_every_blocked_stream {
    var records:  [4]stream.Stream;
    var attempts: [8]stream.Attempt;
    var manager:  stream.Manager = ready_manager(?records[0], ?attempts[0], 4);
    manager.send_max_data                         = 4;
    manager.config.send_local_bidirectional_limit = 8;
    var bytes: [8]u8               = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    val a:     stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    val b:     stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    records[a.handle.index].send_limit = 8;
    records[b.handle.index].send_limit = 8;
    # a takes the whole connection credit, and b gets nothing
    val wrote_a: stream.WriteResult = stream.write(?manager, a.handle, ?bytes[0], 8);
    val wrote_b: stream.WriteResult = stream.write(?manager, b.handle, ?bytes[0], 8);
    if (wrote_a.count != 4 || !wrote_a.connection_blocked || !wrote_a.storage_blocked ||
        wrote_b.count != 0 || !wrote_b.connection_blocked) { ret 1; }
    # one MAX_DATA reports both, and a stream still short of buffer stays listed
    if (stream.update_max_data(?manager, 32).status != stream.STATUS_OK) { ret 2; }
    val first:  stream.Ready = stream.next_ready(?manager);
    val second: stream.Ready = stream.next_ready(?manager);
    if (first.handle.id != a.handle.id || !first.writable ||
        second.handle.id != b.handle.id || !second.writable ||
        stream.next_ready(?manager).status != stream.STATUS_EMPTY) { ret 3; }
    # an acknowledgement that frees a's buffer reports a again
    val sent: stream.Prepared = stream.prepare(?manager, a.handle, 8, false);
    if (!sent.ok || stream.publish(?manager, sent).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, sent.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_OK) { ret 4; }
    val freed: stream.Ready = stream.next_ready(?manager);
    if (freed.status != stream.STATUS_OK || freed.handle.id != a.handle.id ||
        !freed.writable) { ret 5; }
    # a pool wake reports streams a refused chunk stopped
    stream.storage_released(?manager);
    ret 0;
}

#[testing]
var fragment_bytes: [65536]u8;

# a peer that sends every other byte of its window hits the interval cap. its
# frames are refused for storage, the bookkeeping stays bounded, and the same
# bytes sent in order still complete the stream
test stream__a_fragmenting_peer_is_held_at_the_interval_cap {
    var records:  [2]stream.Stream;
    var attempts: [4]stream.Attempt;
    var limits:   stream.Config = config(41, 2, 65536);
    limits.receive_max_data                  = 65536;
    limits.receive_local_bidirectional_limit = 65536;
    limits.receive_peer_bidirectional_limit  = 65536;
    limits.receive_unidirectional_limit      = 65536;
    var manager: stream.Manager = initialize_manager(limits, stream.Storage{
        streams:  ?records[0], stream_capacity: 2,
        attempts: ?attempts[0], attempt_capacity: 4,
        chunks:   test_chunks(), account: test_account(), send_buffer_limit: 8
    });
    var i: usize = 0;
    for (i < 65536) {
        fragment_bytes[i] = (i % 253)::u8;
        i                 = i + 1;
    }
    # a 64 KiB window allows 64 intervals, and byte 0 is never sent
    var accepted: usize = 0;
    var refused:  usize = 0;
    var offset:   u64   = 1;
    for (offset < 65536) {
        val got: stream.ReceiveResult = stream.receive_stream(?manager, 1, offset,
            ?fragment_bytes[offset::usize], 1, false);
        if (got.ok)                            { accepted = accepted + 1; }
        or (got.error == stream.ERROR_STORAGE) { refused = refused + 1; }
        or                                     { ret 1; }
        offset = offset + 2;
    }
    val peer: stream.CreateResult = stream.accept(?manager);
    # refused frames took nothing: one data chunk and one spill for the ranges
    if (accepted != 64 || refused != 32768 - 64 || peer.status != stream.STATUS_OK ||
        records[peer.handle.index].receive_read != 0 ||
        manager.receive_storage_refusals != refused::u64 ||
        supply.held(test_account(), supply.RECEIVE) > 2) { ret 2; }
    # filling one gap merges two intervals, so progress is always possible
    if (!stream.receive_stream(?manager, 1, 2, ?fragment_bytes[2], 1, false).ok) { ret 3; }
    # the whole window sent in order completes, whatever was refused before
    offset = 0;
    for (offset < 65536) {
        if (!stream.receive_stream(?manager, 1, offset, ?fragment_bytes[offset::usize],
            1024, offset + 1024 == 65536).ok) { ret 4; }
        offset = offset + 1024;
    }
    var sink:  [4096]u8;
    var total: usize = 0;
    var ended: bool  = false;
    for (!ended && total <= 65536) {
        val read: stream.ReadResult = stream.read(?manager, peer.handle, ?sink[0], 4096);
        var k:    usize             = 0;
        for (k < read.count) {
            if (sink[k] != fragment_bytes[total + k]) { ret 5; }
            k = k + 1;
        }
        total = total + read.count;
        ended = read.fin;
        if (read.count == 0 && !ended) { ret 6; }
    }
    if (total != 65536 || supply.held(test_account(), supply.RECEIVE) != 0) { ret 7; }
    ret 0;
}

#[testing]
var lifetime_bytes: [4096]u8;

# a pool whose classes each keep one released chunk, so a class's next take
# reuses the chunk, and its slot, that its last release gave back. a pool that
# keeps none hands out a slot never used before one given back
#[testing]
fun retaining_chunks(chunks: *supply.TestPool, account: *supply.Account) bool {
    supply.classes(?chunks.classes[0], 1);
    val bytes: usize = 16 * supply.BYTES;
    if (!limited.make(?chunks.memory, bytes * 2) ||
        !buffers.make(?chunks.pool, supply.pool_config(?chunks.classes[0],
        supply.CLASS_COUNT, bytes), limited.allocator_of(?chunks.memory))) { ret false; }
    chunks.provider = buffers.source(?chunks.pool);
    ret supply.open(?chunks.provider, account, 1, 16, 16, 0);
}

# a chunk released by one stream and taken by another is not reachable through
# anything the first stream still holds
test stream__a_reused_chunk_is_untouched_by_the_stream_that_released_it {
    var chunks:  supply.TestPool;
    var account: supply.Account;
    if (!retaining_chunks(?chunks, ?account)) { ret 9; }
    var records:  [2]stream.Stream;
    var attempts: [8]stream.Attempt;
    var limits:   stream.Config = config(42, 2, 16384);
    limits.receive_max_data                  = 32;
    limits.receive_local_bidirectional_limit = 16;
    limits.receive_peer_bidirectional_limit  = 16;
    limits.receive_unidirectional_limit      = 16;
    var manager: stream.Manager = initialize_manager(limits, stream.Storage{
        streams:  ?records[0], stream_capacity: 2,
        attempts: ?attempts[0], attempt_capacity: 8,
        chunks:   ?chunks.provider, account: ?account, send_buffer_limit: 8192
    });
    var i: usize = 0;
    for (i < 4096) {
        lifetime_bytes[i] = (i % 251)::u8;
        i                 = i + 1;
    }
    val a: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    if (stream.write(?manager, a.handle, ?lifetime_bytes[0], 4096).count != 4096) { ret 1; }
    val original: stream.Prepared = stream.prepare(?manager, a.handle, 4096, false);
    if (!original.ok || stream.publish(?manager, original).status != stream.STATUS_OK) { ret 2; }
    val probe: stream.Prepared = stream.prepare(?manager, a.handle, 4096, true);
    if (!probe.ok || stream.publish(?manager, probe).status != stream.STATUS_OK) { ret 3; }
    val stale: stream.Prepared = stream.prepare(?manager, a.handle, 4096, true);
    if (!stale.ok || stale.data.len != 4096) { ret 4; }
    val old_index: u32 = records[a.handle.index].send.chunks.inline[0].chunk.ref.index;
    # both copies are acknowledged, so a's chunk goes back to the pool
    if (stream.on_terminal(?manager, original.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_OK ||
        stream.on_terminal(?manager, probe.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_OK || records[a.handle.index].send_base != 4096 ||
        supply.held(?account, supply.SEND) != 0) { ret 5; }
    # b takes the same chunk and fills it with its own bytes
    val b:     stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var other: [16]u8;
    i = 0;
    for (i < 16) {
        other[i] = 0xEE;
        i        = i + 1;
    }
    if (stream.write(?manager, b.handle, ?other[0], 16).count != 16 ||
        records[b.handle.index].send.chunks.inline[0].chunk.ref.index != old_index) { ret 6; }
    # the stale attempt of a publishes nothing and settles nothing of b's
    if (stream.publish(?manager, stale).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, stale.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_OK) { ret 7; }
    val sent: stream.Prepared = stream.prepare(?manager, b.handle, 64, false);
    if (!sent.ok || sent.offset != 0 || sent.data.len != 16 || sent.data.data[0] != 0xEE ||
        records[b.handle.index].send_base != 0) { ret 8; }
    ret 0;
}

# a manager whose records and attempts come from their own small pool
#[testing]
fun demand_manager(chunks: *supply.TestPool, account: *supply.Account, send: usize,
    manager: *stream.Manager) bool {
    if (!supply.make_test(chunks, 64) ||
        !supply.open(?chunks.provider, account, 7, send, 16, 0)) { ret false; }
    var limits: stream.Config = config(41, 16, 1 << 16);
    limits.role = stream.ROLE_SERVER;
    ret stream.initialize(manager, limits, stream.Storage{
        streams: nil, stream_capacity: 16, attempts: nil, attempt_capacity: 32,
        chunks:  ?chunks.provider, account: account, send_buffer_limit: 4096
    });
}

test stream__records_and_attempts_are_held_only_while_in_use {
    var chunks:  supply.TestPool;
    var account: supply.Account;
    var manager: stream.Manager;
    if (!demand_manager(?chunks, ?account, 16, ?manager) ||
        supply.held(?account, supply.SEND) != 0) { ret 1; }
    # one stream past a full record chunk spans two
    val span:    usize = stream.RECORDS_PER_BLOCK + 1;
    val last:    usize = span - 1;
    var handles: [16]stream.Handle;
    var i:       usize = 0;
    for (i < span) {
        val opened: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
        if (opened.status != stream.STATUS_OK) { ret 2; }
        handles[i] = opened.handle;
        i          = i + 1;
    }
    if (supply.held(?account, supply.SEND) != 2 || manager.active_streams != span) { ret 3; }
    var data: [4]u8 = [4]u8{1, 2, 3, 4};
    if (stream.write(?manager, handles[last], ?data[0], 4).count != 4 ||
        supply.held(?account, supply.SEND) != 3) { ret 4; }
    # an attempt takes the attempt chunk, which goes back when it settles
    val prepared: stream.Prepared = stream.prepare(?manager, handles[last], 4, false);
    if (!prepared.ok || supply.held(?account, supply.SEND) != 4 ||
        stream.publish(?manager, prepared).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, prepared.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_OK || manager.attempt_block.data != nil || supply.held(?account, supply.SEND) != 2) { ret 5; }
    # the settled token stays stale after its chunk is taken again
    val again: stream.Prepared = stream.prepare(?manager, handles[0], 4, false);
    if (again.status != stream.STATUS_EMPTY ||
        stream.on_terminal(?manager, prepared.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_STALE) { ret 6; }
    # releasing the stream alone in the second chunk gives that chunk back
    if (stream.finish(?manager, handles[last]).status != stream.STATUS_OK) { ret 7; }
    val fin: stream.Prepared = stream.prepare(?manager, handles[last], 4, false);
    if (!fin.ok || !fin.fin || stream.publish(?manager, fin).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, fin.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_OK) { ret 8; }
    if (stream.cancel_receive(?manager, handles[last], 0).status != stream.STATUS_OK) { ret 9; }
    val stop: stream.Prepared = stream.prepare(?manager, handles[last], 4, false);
    if (!stop.ok || stream.publish(?manager, stop).status != stream.STATUS_OK ||
        stream.on_terminal(?manager, stop.token, stream.TERMINAL_ACKED).status !=
        stream.STATUS_OK || stream.receive_reset(?manager, handles[last].id, 0, 0).error !=
        stream.ERROR_NONE) { ret 10; }
    val stale: stream.Handle = handles[last];
    if (stream.release(?manager, handles[last]).status != stream.STATUS_OK ||
        supply.held(?account, supply.SEND) != 1 || manager.record_blocks[1].data != nil) { ret 11; }
    # a new stream reuses the index under a new generation
    val reopened: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    if (reopened.status != stream.STATUS_OK || reopened.handle.index != last ||
        supply.held(?account, supply.SEND) != 2 ||
        stream.write(?manager, stale, ?data[0], 4).status != stream.STATUS_ERROR) { ret 12; }
    ret 0;
}

test stream__a_peer_stream_with_no_record_chunk_is_refused_unchanged {
    var chunks:  supply.TestPool;
    var account: supply.Account;
    var manager: stream.Manager;
    if (!demand_manager(?chunks, ?account, 1, ?manager)) { ret 1; }
    # the one send chunk holds one chunk of records, so a frame opening one more
    # stream than that is refused
    val fits:    u64                  = stream.RECORDS_PER_BLOCK::u64;
    var data:    [1]u8                = [1]u8{9};
    val refused: stream.ReceiveResult = stream.receive_stream(?manager, fits * 4, 0,
        ?data[0], 1, false);
    if (refused.ok || refused.error != stream.ERROR_STORAGE || manager.active_streams != 0 ||
        manager.peer_bidirectional_opened != 0 || manager.receive_committed != 0 ||
        manager.receive_storage_refusals != 1 || supply.held(?account, supply.SEND) != 0) { ret 2; }
    val opened: stream.ReceiveResult = stream.receive_stream(?manager, (fits - 1) * 4, 0,
        ?data[0], 1, false);
    if (!opened.ok || manager.active_streams != stream.RECORDS_PER_BLOCK || supply.held(?account, supply.SEND) != 1) { ret 3; }
    ret 0;
}

test stream__news_is_reported_until_the_owner_takes_it {
    var records:  [4]stream.Stream;
    var attempts: [8]stream.Attempt;
    var manager:  stream.Manager = ready_manager(?records[0], ?attempts[0], 8);
    var bytes:    [8]u8          = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var output:   [8]u8;
    if (stream.pending_news(?manager)) { ret 1; }
    # a peer stream is news from the frame that opens it, and each stream the
    # frame opens implicitly waits for accept too
    if (!stream.receive_stream(?manager, 5, 0, ?bytes[0], 2, false).ok ||
        !stream.pending_news(?manager) || manager.unaccepted_streams != 2) { ret 2; }
    val first: stream.CreateResult = stream.accept(?manager);
    if (first.handle.id != 1 || !stream.pending_news(?manager)) { ret 3; }
    val second: stream.CreateResult = stream.accept(?manager);
    # the accepted stream's data is queued news now, until it is taken
    if (second.handle.id != 5 || manager.unaccepted_streams != 0 ||
        !stream.pending_news(?manager)) { ret 4; }
    val ready: stream.Ready = stream.next_ready(?manager);
    if (!ready.readable || ready.handle.id != 5 || stream.pending_news(?manager)) { ret 5; }
    # more data with a fin, a reset and a flow-control opening each bring it back
    if (stream.read(?manager, second.handle, ?output[0], 8).count != 2 ||
        stream.pending_news(?manager) ||
        !stream.receive_stream(?manager, 5, 2, ?bytes[2], 1, true).ok ||
        !stream.pending_news(?manager) ||
        stream.next_ready(?manager).status != stream.STATUS_OK ||
        stream.pending_news(?manager)) { ret 6; }
    if (!stream.receive_reset(?manager, 1, 3, 0).ok || !stream.pending_news(?manager) ||
        !stream.next_ready(?manager).reset || stream.pending_news(?manager)) { ret 7; }
    val local: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    if (stream.write(?manager, local.handle, ?bytes[0], 4).count != 2 ||
        stream.pending_news(?manager) ||
        !stream.receive_max_stream_data(?manager, local.handle.id, 8).ok ||
        !stream.pending_news(?manager) || !stream.next_ready(?manager).writable ||
        stream.pending_news(?manager)) { ret 8; }
    ret 0;
}

test stream__a_bare_fin_after_every_byte_was_read_is_news {
    var records:  [4]stream.Stream;
    var attempts: [8]stream.Attempt;
    var manager:  stream.Manager = ready_manager(?records[0], ?attempts[0], 8);
    var bytes:    [2]u8          = [2]u8{1, 2};
    var output:   [8]u8;
    if (!stream.receive_stream(?manager, 1, 0, ?bytes[0], 2, false).ok) { ret 1; }
    val accepted: stream.CreateResult = stream.accept(?manager);
    if (accepted.status != stream.STATUS_OK || !stream.next_ready(?manager).readable ||
        stream.read(?manager, accepted.handle, ?output[0], 8).status != stream.STATUS_OK ||
        stream.pending_news(?manager)) { ret 2; }
    # the owner has drained the stream, so only the fin is left to report
    if (!stream.receive_stream(?manager, 1, 2, nil, 0, true).ok ||
        stream.snapshot(?manager, accepted.handle).receive_closed ||
        !stream.pending_news(?manager)) { ret 3; }
    val ready: stream.Ready = stream.next_ready(?manager);
    if (ready.status != stream.STATUS_OK || !ready.readable ||
        ready.handle.id != 1 || stream.pending_news(?manager)) { ret 4; }
    val read: stream.ReadResult = stream.read(?manager, accepted.handle, ?output[0], 8);
    if (read.status != stream.STATUS_FINISHED || read.count != 0 || read.final_size != 2 ||
        !stream.snapshot(?manager, accepted.handle).receive_closed) { ret 5; }
    # a repeated fin after the owner took the end is not news again
    if (!stream.receive_stream(?manager, 1, 2, nil, 0, true).ok ||
        stream.pending_news(?manager)) { ret 6; }
    ret 0;
}

test stream__a_peer_stream_opened_by_a_bare_fin_is_news_through_accept {
    var records:  [4]stream.Stream;
    var attempts: [8]stream.Attempt;
    var manager:  stream.Manager = ready_manager(?records[0], ?attempts[0], 8);
    var output:   [8]u8;
    if (!stream.receive_stream(?manager, 1, 0, nil, 0, true).ok ||
        !stream.pending_news(?manager) || manager.unaccepted_streams != 1) { ret 1; }
    val accepted: stream.CreateResult = stream.accept(?manager);
    if (accepted.status != stream.STATUS_OK || accepted.handle.id != 1 ||
        !stream.pending_news(?manager)) { ret 2; }
    val ready: stream.Ready = stream.next_ready(?manager);
    if (ready.status != stream.STATUS_OK || !ready.readable ||
        ready.handle.id != 1 || stream.pending_news(?manager)) { ret 3; }
    val read: stream.ReadResult = stream.read(?manager, accepted.handle, ?output[0], 8);
    if (read.status != stream.STATUS_FINISHED || read.count != 0 || read.final_size != 0 ||
        stream.pending_news(?manager)) { ret 4; }
    ret 0;
}

#[testing]
rec Snapshot {
    manager:  stream.Manager;
    records:  [4]stream.Stream;
    attempts: [8]stream.Attempt;
}

test stream__a_peek_names_what_the_prepare_after_it_sends_and_changes_nothing {
    var records:  [4]stream.Stream;
    var attempts: [8]stream.Attempt;
    var manager:  stream.Manager      = ready_manager(?records[0], ?attempts[0], 8);
    var bytes:    [8]u8               = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var before:   Snapshot;
    var after:    Snapshot;
    val local:    stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    if (stream.write(?manager, local.handle, ?bytes[0], 2).count != 2 ||
        !stream.lease_core(?manager, 31)) { ret 1; }
    if (stream.peek_scoped(?manager, 32, local.handle, 8, false).error != stream.ERROR_STATE ||
        stream.peek_control_scoped(?manager, 31).status != stream.STATUS_EMPTY) { ret 2; }
    before = Snapshot{manager: manager, records: records, attempts: attempts};
    val peeked: stream.Prepared = stream.peek_scoped(?manager, 31, local.handle, 8, false);
    after = Snapshot{manager: manager, records: records, attempts: attempts};
    if (peeked.status != stream.STATUS_OK || peeked.data.len != 2 ||
        !memory.equal[Snapshot](?before, ?after, 1)) { ret 3; }
    val taken: stream.Prepared = stream.prepare_scoped(?manager, 31, local.handle, 8, false);
    if (taken.status != stream.STATUS_OK || taken.kind != peeked.kind ||
        taken.offset != peeked.offset || taken.data.data != peeked.data.data ||
        taken.data.len != peeked.data.len || taken.fin != peeked.fin) { ret 4; }
    # the reserved attempt blocks the stream in the peek as in the prepare
    if (stream.peek_scoped(?manager, 31, local.handle, 8, false).status !=
        stream.STATUS_BLOCKED) { ret 5; }
    # a flow-control frame once the owner consumes what the peer sent
    if (!stream.receive_stream_scoped(?manager, 31, 1, 0, ?bytes[0], 8, false).ok) { ret 6; }
    val peer:   stream.CreateResult = stream.accept(?manager);
    var output: [8]u8;
    if (stream.read(?manager, peer.handle, ?output[0], 8).count != 8 ||
        stream.credit(?manager, peer.handle, 8).status != stream.STATUS_OK) { ret 7; }
    before = Snapshot{manager: manager, records: records, attempts: attempts};
    val control: stream.Prepared = stream.peek_control_scoped(?manager, 31);
    after = Snapshot{manager: manager, records: records, attempts: attempts};
    if (control.status != stream.STATUS_OK || !memory.equal[Snapshot](?before, ?after, 1)) { ret 8; }
    val sent: stream.Prepared = stream.prepare_control_scoped(?manager, 31);
    if (sent.status != stream.STATUS_OK || sent.kind != control.kind ||
        sent.maximum != control.maximum) { ret 9; }
    ret 0;
}

test stream__attempts_are_held_only_while_an_attempt_chunk_is {
    var chunks:  supply.TestPool;
    var account: supply.Account;
    var manager: stream.Manager;
    if (!demand_manager(?chunks, ?account, 16, ?manager) ||
        stream.attempts_held(?manager)) { ret 1; }
    val opened: stream.CreateResult = stream.open(?manager, stream.DIRECTION_BIDIRECTIONAL);
    var data:   [4]u8               = [4]u8{1, 2, 3, 4};
    if (stream.write(?manager, opened.handle, ?data[0], 4).count != 4) { ret 2; }
    val prepared: stream.Prepared = stream.prepare(?manager, opened.handle, 4, false);
    if (!prepared.ok || !stream.attempts_held(?manager) ||
        stream.cancel_prepared(?manager, prepared).status != stream.STATUS_OK ||
        stream.attempts_held(?manager)) { ret 3; }
    ret 0;
}
