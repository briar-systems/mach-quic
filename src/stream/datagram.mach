use quic.connection.ownership;
use quic.packet.packet;
use supply: quic.storage.source;
use quic.wire.varint;

use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val ENTRY_FREE:      u8 = 0;
pub val ENTRY_QUEUED:    u8 = 1;
pub val ENTRY_RESERVED:  u8 = 2;
pub val ENTRY_DELIVERED: u8 = 3;

pub val STATUS_OK:    u8 = 1;
pub val STATUS_EMPTY: u8 = 2;
pub val STATUS_STALE: u8 = 3;
pub val STATUS_ERROR: u8 = 4;

pub val ERROR_NONE:     u8 = 0;
pub val ERROR_STATE:    u8 = 1;
pub val ERROR_DISABLED: u8 = 2;
pub val ERROR_LIMIT:    u8 = 3;
pub val ERROR_CAPACITY: u8 = 4;
pub val ERROR_TOKEN:    u8 = 5;
pub val ERROR_OVERFLOW: u8 = 6;

pub rec Config {
    source:               u64;
    peer_max_frame_size:  usize;
    local_max_frame_size: usize;
    enabled:              bool;
}

# a queued datagram holds its payload in one chunk from the time it is queued
# until it is published, cancelled or released
pub rec Entry {
    generation: u64;
    sequence:   u64;
    length:     usize;
    state:      u8;
    chunk:      supply.Chunk;
}

# strides are the largest payload each direction accepts, at most supply.BYTES.
# payload chunks come from `chunks`, charged to `account`
pub rec Storage {
    send_entries:     *Entry;
    send_capacity:    usize;
    send_stride:      usize;
    receive_entries:  *Entry;
    receive_capacity: usize;
    receive_stride:   usize;
    chunks:           *supply.Provider;
    account:          *supply.Account;
}

# every field is assigned by name: an empty record literal does not reliably
# clear one, and these become ownership ranges
pub fun empty_storage() Storage {
    var value: Storage;
    value.send_entries     = nil;
    value.send_capacity    = 0;
    value.send_stride      = 0;
    value.receive_entries  = nil;
    value.receive_capacity = 0;
    value.receive_stride   = 0;
    value.chunks           = nil;
    value.account          = nil;
    ret value;
}

pub rec Queue {
    config:        Config;
    storage:       Storage;
    next_sequence: u64;
    send_count:    usize;
    # bumped when a datagram is queued, so an idle core notices without scanning
    send_revision:    u64;
    receive_count:    usize;
    delivered_count:  usize;
    core_lease:       u64;
    peer_limit_bound: bool;
    valid:            bool;
    closing:          bool;
    # the lent send and receive entry ranges, fixed from initialize on
    owned: [2]ownership.Range;
}

pub rec Token {
    source:     u64;
    index:      usize;
    generation: u64;
    receive:    bool;
}

pub rec QueueResult {
    ok:     bool;
    status: u8;
    error:  u8;
    token:  Token;
}

pub rec Prepared {
    ok:          bool;
    status:      u8;
    error:       u8;
    token:       Token;
    data:        packet.Span;
    frame_size:  usize;
    with_length: bool;
}

pub rec Delivery {
    status: u8;
    error:  u8;
    token:  Token;
    data:   packet.Span;
}

pub rec OperationResult {
    status: u8;
    error:  u8;
}

fun valid_stride(stride: usize) bool {
    ret stride > 0 && stride <= supply.BYTES;
}

fun valid_storage(storage: Storage) bool {
    if (storage.send_capacity == 0 || storage.receive_capacity == 0 ||
        !valid_stride(storage.send_stride) ||
        !valid_stride(storage.receive_stride) || storage.chunks == nil ||
        storage.account == nil) { ret false; }
    var ranges: [2]ownership.Range;
    ranges[0] = ownership.array(storage.send_entries::*u8,
        storage.send_capacity, $size_of(Entry), ownership.ZERO_FORBIDDEN);
    ranges[1] = ownership.array(storage.receive_entries::*u8,
        storage.receive_capacity, $size_of(Entry), ownership.ZERO_FORBIDDEN);
    ret ownership.all_disjoint(?ranges[0], 2);
}

fun valid_config(config: Config, storage: Storage) bool {
    if (config.source == 0) { ret false; }
    if (!config.enabled) {
        ret config.peer_max_frame_size == 0 && config.local_max_frame_size == 0 &&
            storage.send_capacity == 0 && storage.receive_capacity == 0 &&
            storage.chunks == nil;
    }
    ret valid_storage(storage) && config.local_max_frame_size > 0;
}

fun next_generation(value: u64) u64 {
    if (value == 0 - 1::u64) { ret 1; }
    ret value + 1;
}

fun take_sequence(queue: *Queue, value: *u64) bool {
    if (queue.next_sequence == 0 - 1::u64) { ret false; }
    @value              = queue.next_sequence;
    queue.next_sequence = queue.next_sequence + 1;
    ret true;
}

pub fun initialize(queue: *Queue, config: Config, storage: Storage) bool {
    if (queue == nil) { ret false; }
    var zero: ownership.ZeroPolicy = ownership.ZERO_FORBIDDEN;
    if (!config.enabled) { zero = ownership.ZERO_ALLOWED; }
    var ranges: [3]ownership.Range;
    ranges[0] = ownership.bytes((?queue.config)::*u8, $size_of(Queue),
        ownership.ZERO_FORBIDDEN);
    ranges[1] = ownership.array(storage.send_entries::*u8,
        storage.send_capacity, $size_of(Entry), zero);
    ranges[2] = ownership.array(storage.receive_entries::*u8,
        storage.receive_capacity, $size_of(Entry), zero);
    if (!ownership.all_disjoint(?ranges[0], 3) || queue.valid ||
        !valid_config(config, storage)) { ret false; }
    var candidate: Queue;
    candidate.config   = config;
    candidate.storage  = storage;
    candidate.owned[0] = ranges[1];
    candidate.owned[1] = ranges[2];
    var i:     usize = 0;
    var fresh: Entry;
    fresh.generation = 1;
    for (i < storage.send_capacity) {
        storage.send_entries[i] = fresh;
        i                       = i + 1;
    }
    i = 0;
    for (i < storage.receive_capacity) {
        storage.receive_entries[i] = fresh;
        i                          = i + 1;
    }
    candidate.next_sequence    = 1;
    candidate.peer_limit_bound = config.peer_max_frame_size > 0;
    candidate.valid            = true;
    queue[0]                   = candidate;
    ret true;
}

fun queue_record_valid(queue: *Queue) bool {
    ret queue != nil && ownership.bytes((?queue.config)::*u8, $size_of(Queue),
        ownership.ZERO_FORBIDDEN).valid;
}

fun borrowed_disjoint(queue: *Queue, borrowed: ownership.Range) bool {
    if (!queue_record_valid(queue) || !borrowed.valid ||
        !ownership.disjoint(borrowed, ownership.bytes((?queue.config)::*u8,
        $size_of(Queue), ownership.ZERO_FORBIDDEN))) { ret false; }
    if (!queue.config.enabled) { ret true; }
    ret ownership.disjoint(borrowed, queue.owned[0]) &&
        ownership.disjoint(borrowed, queue.owned[1]);
}

pub fun lease_core(queue: *Queue, source: u64) bool {
    if (!queue_record_valid(queue) || !queue.valid || queue.closing || source == 0 ||
        queue.core_lease != 0) { ret false; }
    queue.core_lease = source;
    ret true;
}

pub fun release_core(queue: *Queue, source: u64) bool {
    if (!queue_record_valid(queue) || !queue.valid || source == 0 ||
        queue.core_lease != source) { ret false; }
    queue.core_lease = 0;
    ret true;
}

fun queue_error(code: u8) QueueResult {
    var result: QueueResult;
    result.status = STATUS_ERROR;
    result.error  = code;
    ret result;
}

fun frame_size(length: usize, with_length: bool) usize {
    if (!with_length) {
        if (length == 0 - 1::usize) { ret 0; }
        ret length + 1;
    }
    val width: u8 = varint.width(length::u64);
    if (width == 0 || length > (0 - 1::usize) - 1 - width::usize) { ret 0; }
    ret 1 + width::usize + length;
}

fun token(queue: *Queue, index: usize, receive: bool) Token {
    var value: Token;
    value.source  = queue.config.source;
    value.index   = index;
    value.receive = receive;
    if (receive) {
        value.generation = queue.storage.receive_entries[index].generation;
    }
    or {
        value.generation = queue.storage.send_entries[index].generation;
    }
    ret value;
}

fun send_valid(queue: *Queue, value: Token, state: u8) bool {
    if (!queue_record_valid(queue) || !queue.valid || value.source != queue.config.source || value.receive ||
        value.index >= queue.storage.send_capacity) { ret false; }
    val entry: Entry = queue.storage.send_entries[value.index];
    ret entry.generation == value.generation && entry.state == state;
}

fun receive_valid(queue: *Queue, value: Token, state: u8) bool {
    if (!queue_record_valid(queue) || !queue.valid || value.source != queue.config.source || !value.receive ||
        value.index >= queue.storage.receive_capacity) { ret false; }
    val entry: Entry = queue.storage.receive_entries[value.index];
    ret entry.generation == value.generation && entry.state == state;
}

fun source(queue: *Queue, lane: supply.Lane) supply.Source {
    ret supply.Source{provider: queue.storage.chunks,
        account: queue.storage.account, lane: lane};
}

# a payload chunk for `length` bytes. a refusal registers the account for a wake
fun take_payload(queue: *Queue, lane: supply.Lane, length: usize,
    chunk: *supply.Chunk) bool {
    var from:  supply.Source = source(queue, lane);
    var bytes: usize         = length;
    if (bytes == 0) { bytes = 1; }
    val taken: supply.Taken = supply.take(?from, bytes);
    if (!taken.ok) { ret false; }
    @chunk = taken.chunk;
    ret true;
}

fun give_payload(queue: *Queue, lane: supply.Lane, entry: *Entry) {
    if (entry.chunk.data == nil) { ret; }
    var from: supply.Source = source(queue, lane);
    supply.give(?from, entry.chunk);
    var none: supply.Chunk;
    entry.chunk = none;
}

fun free_send(queue: *Queue, index: usize) {
    val entry: *Entry = ?queue.storage.send_entries[index];
    give_payload(queue, supply.SEND, entry);
    entry.state      = ENTRY_FREE;
    entry.length     = 0;
    entry.generation = next_generation(entry.generation);
    if (queue.send_count > 0) { queue.send_count = queue.send_count - 1; }
}

fun free_receive(queue: *Queue, index: usize) {
    val entry: *Entry = ?queue.storage.receive_entries[index];
    give_payload(queue, supply.RECEIVE, entry);
    if (entry.state == ENTRY_DELIVERED && queue.delivered_count > 0) {
        queue.delivered_count = queue.delivered_count - 1;
    }
    entry.state      = ENTRY_FREE;
    entry.length     = 0;
    entry.generation = next_generation(entry.generation);
    if (queue.receive_count > 0) { queue.receive_count = queue.receive_count - 1; }
}

pub fun enqueue(queue: *Queue, data: *u8, length: usize) QueueResult {
    if (!queue_record_valid(queue) || !queue.valid || queue.closing) { ret queue_error(ERROR_STATE); }
    if (!queue.config.enabled)                                       { ret queue_error(ERROR_DISABLED); }
    if (!queue.peer_limit_bound)                                     { ret queue_error(ERROR_STATE); }
    if (length > queue.storage.send_stride ||
        !borrowed_disjoint(queue, ownership.bytes(data, length,
        ownership.ZERO_ALLOWED)) ||
        frame_size(length, true) > queue.config.peer_max_frame_size) {
        ret queue_error(ERROR_LIMIT);
    }
    if (queue.next_sequence == 0 - 1::u64) { ret queue_error(ERROR_OVERFLOW); }
    var i: usize = 0;
    for (i < queue.storage.send_capacity && queue.storage.send_entries[i].state != ENTRY_FREE) { i = i + 1; }
    if (i == queue.storage.send_capacity) { ret queue_error(ERROR_CAPACITY); }
    val entry: *Entry = ?queue.storage.send_entries[i];
    if (!take_payload(queue, supply.SEND, length, ?entry.chunk)) {
        ret queue_error(ERROR_CAPACITY);
    }
    if (length > 0) { memory.copy[u8](entry.chunk.data, data, length); }
    entry.length = length;
    if (!take_sequence(queue, ?entry.sequence)) {
        give_payload(queue, supply.SEND, entry);
        ret queue_error(ERROR_OVERFLOW);
    }
    entry.state         = ENTRY_QUEUED;
    queue.send_count    = queue.send_count + 1;
    queue.send_revision = queue.send_revision + 1;
    var result: QueueResult;
    result.ok     = true;
    result.status = STATUS_OK;
    result.token  = token(queue, i, false);
    ret result;
}

fun prepared_error(status: u8, code: u8) Prepared {
    var result: Prepared;
    result.status = status;
    result.error  = code;
    ret result;
}

pub fun prepare(queue: *Queue, with_length: bool) Prepared {
    if (!queue_record_valid(queue) || !queue.valid || queue.closing ||
        queue.core_lease != 0) { ret prepared_error(STATUS_ERROR, ERROR_STATE); }
    if (!queue.config.enabled) { ret prepared_error(STATUS_ERROR, ERROR_DISABLED); }
    if (!queue.peer_limit_bound) {
        ret prepared_error(STATUS_ERROR, ERROR_STATE);
    }
    var chosen:   usize = queue.storage.send_capacity;
    var sequence: u64   = 0;
    var i:        usize = 0;
    for (i < queue.storage.send_capacity) {
        val entry: Entry = queue.storage.send_entries[i];
        if (entry.state == ENTRY_QUEUED && (chosen == queue.storage.send_capacity || entry.sequence < sequence)) {
            chosen   = i;
            sequence = entry.sequence;
        }
        i = i + 1;
    }
    if (chosen == queue.storage.send_capacity) { ret prepared_error(STATUS_EMPTY, ERROR_NONE); }
    val entry:   *Entry = ?queue.storage.send_entries[chosen];
    val encoded: usize  = frame_size(entry.length, with_length);
    if (encoded == 0 || encoded > queue.config.peer_max_frame_size) {
        ret prepared_error(STATUS_ERROR, ERROR_LIMIT);
    }
    entry.state = ENTRY_RESERVED;
    var result: Prepared;
    result.ok          = true;
    result.status      = STATUS_OK;
    result.token       = token(queue, chosen, false);
    result.data.data   = entry.chunk.data;
    result.data.len    = entry.length;
    result.frame_size  = encoded;
    result.with_length = with_length;
    ret result;
}

pub fun cancel_prepared(queue: *Queue, prepared: Prepared) OperationResult {
    var result: OperationResult;
    if (!queue_record_valid(queue) || queue.core_lease != 0 || !prepared.ok ||
        !send_valid(queue, prepared.token, ENTRY_RESERVED)) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    if (queue.closing) { free_send(queue, prepared.token.index); }
    or                 { queue.storage.send_entries[prepared.token.index].state = ENTRY_QUEUED; }
    result.status = STATUS_OK;
    ret result;
}

pub fun publish(queue: *Queue, prepared: Prepared) OperationResult {
    var result: OperationResult;
    if (!queue_record_valid(queue) || queue.core_lease != 0) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (!prepared.ok || !send_valid(queue, prepared.token, ENTRY_RESERVED)) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    free_send(queue, prepared.token.index);
    result.status = STATUS_OK;
    ret result;
}

pub fun bind_peer_limit(queue: *Queue, maximum: usize) OperationResult {
    var result: OperationResult;
    if (!queue_record_valid(queue) || !queue.valid || queue.closing ||
        queue.core_lease != 0 || !queue.config.enabled ||
        queue.peer_limit_bound || queue.send_count != 0) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    queue.config.peer_max_frame_size = maximum;
    queue.peer_limit_bound           = true;
    result.status                    = STATUS_OK;
    ret result;
}

pub fun cancel(queue: *Queue, value: Token) OperationResult {
    var result: OperationResult;
    if (!send_valid(queue, value, ENTRY_QUEUED)) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    free_send(queue, value.index);
    result.status = STATUS_OK;
    ret result;
}

pub fun receive(queue: *Queue, data: *u8, length: usize, encoded_frame_size: usize) QueueResult {
    if (!queue_record_valid(queue) || !queue.valid || queue.closing ||
        queue.core_lease != 0) { ret queue_error(ERROR_STATE); }
    if (!queue.config.enabled) { ret queue_error(ERROR_DISABLED); }
    if (length > queue.storage.receive_stride ||
        !borrowed_disjoint(queue, ownership.bytes(data, length,
        ownership.ZERO_ALLOWED)) ||
        length == 0 - 1::usize || encoded_frame_size < length + 1 ||
        encoded_frame_size > queue.config.local_max_frame_size) {
        ret queue_error(ERROR_LIMIT);
    }
    if (queue.next_sequence == 0 - 1::u64) { ret queue_error(ERROR_OVERFLOW); }
    var i: usize = 0;
    for (i < queue.storage.receive_capacity && queue.storage.receive_entries[i].state != ENTRY_FREE) { i = i + 1; }
    if (i == queue.storage.receive_capacity) { ret queue_error(ERROR_CAPACITY); }
    val entry: *Entry = ?queue.storage.receive_entries[i];
    if (!take_payload(queue, supply.RECEIVE, length, ?entry.chunk)) {
        ret queue_error(ERROR_CAPACITY);
    }
    if (length > 0) { memory.copy[u8](entry.chunk.data, data, length); }
    entry.length = length;
    if (!take_sequence(queue, ?entry.sequence)) {
        give_payload(queue, supply.RECEIVE, entry);
        ret queue_error(ERROR_OVERFLOW);
    }
    entry.state         = ENTRY_QUEUED;
    queue.receive_count = queue.receive_count + 1;
    var result: QueueResult;
    result.ok     = true;
    result.status = STATUS_OK;
    result.token  = token(queue, i, true);
    ret result;
}

pub fun next(queue: *Queue) Delivery {
    var result: Delivery;
    if (!queue_record_valid(queue) || !queue.valid || queue.closing) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (!queue.config.enabled) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_DISABLED;
        ret result;
    }
    var chosen:   usize = queue.storage.receive_capacity;
    var sequence: u64   = 0;
    var i:        usize = 0;
    for (i < queue.storage.receive_capacity) {
        val entry: Entry = queue.storage.receive_entries[i];
        if (entry.state == ENTRY_QUEUED && (chosen == queue.storage.receive_capacity || entry.sequence < sequence)) {
            chosen   = i;
            sequence = entry.sequence;
        }
        i = i + 1;
    }
    if (chosen == queue.storage.receive_capacity) {
        result.status = STATUS_EMPTY;
        ret result;
    }
    queue.storage.receive_entries[chosen].state = ENTRY_DELIVERED;
    queue.delivered_count                       = queue.delivered_count + 1;
    result.status                               = STATUS_OK;
    result.token                                = token(queue, chosen, true);
    result.data.data                            = queue.storage.receive_entries[chosen].chunk.data;
    result.data.len                             = queue.storage.receive_entries[chosen].length;
    ret result;
}

pub fun release(queue: *Queue, value: Token) OperationResult {
    var result: OperationResult;
    if (!receive_valid(queue, value, ENTRY_DELIVERED)) {
        result.status = STATUS_STALE;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    free_receive(queue, value.index);
    result.status = STATUS_OK;
    ret result;
}

pub fun begin_close(queue: *Queue) OperationResult {
    var result: OperationResult;
    if (!queue_record_valid(queue) || !queue.valid || queue.core_lease != 0) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    queue.closing = true;
    var i: usize = 0;
    for (i < queue.storage.send_capacity) {
        if (queue.storage.send_entries[i].state == ENTRY_QUEUED) { free_send(queue, i); }
        i = i + 1;
    }
    i = 0;
    for (i < queue.storage.receive_capacity) {
        if (queue.storage.receive_entries[i].state == ENTRY_QUEUED) { free_receive(queue, i); }
        i = i + 1;
    }
    result.status = STATUS_OK;
    ret result;
}

pub fun finish_close(queue: *Queue) OperationResult {
    var result: OperationResult;
    if (!queue_record_valid(queue) || !queue.valid || !queue.closing ||
        queue.core_lease != 0) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_STATE;
        ret result;
    }
    if (queue.send_count != 0 || queue.delivered_count != 0) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_CAPACITY;
        ret result;
    }
    queue.valid      = false;
    queue.core_lease = 0;
    result.status    = STATUS_OK;
    ret result;
}

fun enter_core_scope(queue: *Queue, source: u64) bool {
    if (!queue_record_valid(queue) || source == 0 || queue.core_lease != source) {
        ret false;
    }
    queue.core_lease = 0;
    ret true;
}

fun leave_core_scope(queue: *Queue, source: u64) {
    if (queue_record_valid(queue) && queue.valid) { queue.core_lease = source; }
}

pub fun prepare_scoped(queue: *Queue, source: u64,
    with_length: bool) Prepared {
    if (!enter_core_scope(queue, source)) {
        ret prepared_error(STATUS_ERROR, ERROR_STATE);
    }
    val result: Prepared = prepare(queue, with_length);
    leave_core_scope(queue, source);
    ret result;
}

pub fun cancel_prepared_scoped(queue: *Queue, source: u64,
    prepared: Prepared) OperationResult {
    if (!enter_core_scope(queue, source)) {
        var failed: OperationResult;
        failed.status = STATUS_ERROR;
        failed.error  = ERROR_STATE;
        ret failed;
    }
    val result: OperationResult = cancel_prepared(queue, prepared);
    leave_core_scope(queue, source);
    ret result;
}

pub fun publish_scoped(queue: *Queue, source: u64,
    prepared: Prepared) OperationResult {
    if (!enter_core_scope(queue, source)) {
        var failed: OperationResult;
        failed.status = STATUS_ERROR;
        failed.error  = ERROR_STATE;
        ret failed;
    }
    val result: OperationResult = publish(queue, prepared);
    leave_core_scope(queue, source);
    ret result;
}

pub fun receive_scoped(queue: *Queue, source: u64, data: *u8,
    length: usize, encoded_frame_size: usize) QueueResult {
    if (!enter_core_scope(queue, source)) { ret queue_error(ERROR_STATE); }
    val result: QueueResult = receive(queue, data, length, encoded_frame_size);
    leave_core_scope(queue, source);
    ret result;
}

pub fun bind_peer_limit_scoped(queue: *Queue, source: u64,
    maximum: usize) OperationResult {
    if (!enter_core_scope(queue, source)) {
        var failed: OperationResult;
        failed.status = STATUS_ERROR;
        failed.error  = ERROR_STATE;
        ret failed;
    }
    val result: OperationResult = bind_peer_limit(queue, maximum);
    leave_core_scope(queue, source);
    ret result;
}

pub fun begin_close_scoped(queue: *Queue, source: u64) OperationResult {
    if (!enter_core_scope(queue, source)) {
        var failed: OperationResult;
        failed.status = STATUS_ERROR;
        failed.error  = ERROR_STATE;
        ret failed;
    }
    val result: OperationResult = begin_close(queue);
    leave_core_scope(queue, source);
    ret result;
}

pub fun finish_close_scoped(queue: *Queue, source: u64) OperationResult {
    if (!enter_core_scope(queue, source)) {
        var failed: OperationResult;
        failed.status = STATUS_ERROR;
        failed.error  = ERROR_STATE;
        ret failed;
    }
    val result: OperationResult = finish_close(queue);
    leave_core_scope(queue, source);
    ret result;
}

var test_chunks:  supply.TestPool;
var test_account: supply.Account;

# storage over a shared test pool, whose account holds every chunk the tests take
fun test_storage(send: *Entry, send_capacity: usize, send_stride: usize,
    receive: *Entry, receive_capacity: usize, receive_stride: usize) Storage {
    if (!supply.test_made(?test_chunks)) {
        supply.make_test(?test_chunks, 64);
        supply.open(?test_chunks.provider, ?test_account, 1, 16, 16, 0);
    }
    ret Storage{send_entries: send, send_capacity: send_capacity,
        send_stride:      send_stride, receive_entries: receive,
        receive_capacity: receive_capacity, receive_stride: receive_stride,
        chunks:           ?test_chunks.provider, account: ?test_account};
}

fun initialized_for_test(config: Config, storage: Storage) Queue {
    var queue: Queue;
    initialize(?queue, config, storage);
    ret queue;
}

test "quic.stream.datagram: optional queues copy, order, cancel, and publish" {
    var send_entries:    [2]Entry;
    var receive_entries: [2]Entry;
    val storage:         Storage = test_storage(?send_entries[0], 2, 8, ?receive_entries[0], 2, 8);
    var queue:           Queue   = initialized_for_test(Config{source: 7, peer_max_frame_size: 10,
        local_max_frame_size: 10, enabled: true}, storage);
    var first:  [3]u8       = [3]u8{1, 2, 3};
    var second: [2]u8       = [2]u8{4, 5};
    val a:      QueueResult = enqueue(?queue, ?first[0], 3);
    val b:      QueueResult = enqueue(?queue, ?second[0], 2);
    first[0] = 9;
    if (!a.ok || !b.ok || cancel(?queue, b.token).status != STATUS_OK) { ret 1; }
    val prepared: Prepared = prepare(?queue, true);
    if (!prepared.ok || prepared.data.len != 3 || prepared.data.data[0] != 1 ||
        publish(?queue, prepared).status != STATUS_OK || queue.send_count != 0) { ret 1; }
    if (!receive(?queue, ?second[0], 2, 4).ok) { ret 1; }
    val delivered: Delivery = next(?queue);
    if (delivered.status != STATUS_OK || delivered.data.len != 2 || delivered.data.data[0] != 4) { ret 1; }
    if (release(?queue, delivered.token).status != STATUS_OK)                                    { ret 1; }
    ret 0;
}

test "quic.stream.datagram: capacity and close preserve delivered ownership" {
    var send_entries:    [1]Entry;
    var receive_entries: [1]Entry;
    val storage:         Storage = test_storage(?send_entries[0], 1, 4, ?receive_entries[0], 1, 4);
    var queue:           Queue   = initialized_for_test(Config{source: 8, peer_max_frame_size: 6,
        local_max_frame_size: 6, enabled: true}, storage);
    var data: [4]u8 = [4]u8{1, 2, 3, 4};
    if (!receive(?queue, ?data[0], 4, 6).ok || receive(?queue, ?data[0], 1, 3).error != ERROR_CAPACITY) { ret 1; }
    val delivered: Delivery = next(?queue);
    if (begin_close(?queue).status != STATUS_OK || finish_close(?queue).error != ERROR_CAPACITY)          { ret 1; }
    if (release(?queue, delivered.token).status != STATUS_OK || finish_close(?queue).status != STATUS_OK) { ret 1; }
    if (next(?queue).error != ERROR_STATE)                                                                { ret 1; }
    ret 0;
}

test "quic.stream.datagram: authenticated limits bind once and close preserves sends" {
    var send_entries:    [1]Entry;
    var receive_entries: [1]Entry;
    var queue:           Queue = initialized_for_test(Config{source: 12,
        peer_max_frame_size: 0, local_max_frame_size: 8, enabled: true},
        test_storage(?send_entries[0], 1, 4, ?receive_entries[0], 1, 4));
    var data: [3]u8 = [3]u8{1, 2, 3};
    if (enqueue(?queue, ?data[0], 3).error != ERROR_STATE ||
        !lease_core(?queue, 12) ||
        bind_peer_limit_scoped(?queue, 12, 5).status != STATUS_OK ||
        bind_peer_limit_scoped(?queue, 12, 6).error != ERROR_STATE) { ret 1; }
    val queued: QueueResult = enqueue(?queue, ?data[0], 3);
    if (!queued.ok) { ret 2; }
    val prepared: Prepared = prepare_scoped(?queue, 12, true);
    if (!prepared.ok || begin_close_scoped(?queue, 12).status != STATUS_OK ||
        publish_scoped(?queue, 12, prepared).status != STATUS_OK ||
        queue.send_count != 0) { ret 3; }
    ret 0;
}

test "quic.stream.datagram: disabled mode needs no storage" {
    var empty_storage:   Storage;
    var disabled_config: Config;
    disabled_config.source  = 9;
    disabled_config.enabled = false;
    var disabled: Queue = initialized_for_test(disabled_config, empty_storage);
    var byte:     [1]u8 = [1]u8{7};
    if (!disabled.valid || enqueue(?disabled, ?byte[0], 1).error != ERROR_DISABLED ||
        prepare(?disabled, true).error != ERROR_DISABLED || next(?disabled).error != ERROR_DISABLED) { ret 1; }
    ret 0;
}

test "quic.stream.datagram: frame and sequence bounds are transactional" {
    var byte:            [1]u8   = [1]u8{7};
    var send_entries:    [1]Entry;
    var receive_entries: [1]Entry;
    val storage:         Storage = test_storage(?send_entries[0], 1, 1, ?receive_entries[0], 1, 1);
    var queue:           Queue   = initialized_for_test(Config{source: 10, peer_max_frame_size: 3,
        local_max_frame_size: 2, enabled: true}, storage);
    val queued:      QueueResult = enqueue(?queue, ?byte[0], 1);
    val with_length: Prepared    = prepare(?queue, true);
    if (!queued.ok || !with_length.ok || with_length.frame_size != 3 ||
        publish(?queue, with_length).status != STATUS_OK) { ret 1; }
    queue.next_sequence = 0 - 1::u64;
    if (enqueue(?queue, ?byte[0], 1).error != ERROR_OVERFLOW || queue.send_count != 0 ||
        receive(?queue, ?byte[0], 1, 2).error != ERROR_OVERFLOW || queue.receive_count != 0) { ret 1; }
    ret 0;
}

test "quic.stream.datagram: close preserves prepared publication ownership" {
    var send_entries:    [1]Entry;
    var receive_entries: [1]Entry;
    val storage:         Storage = test_storage(?send_entries[0], 1, 4, ?receive_entries[0], 1, 4);
    var queue:           Queue   = initialized_for_test(Config{source: 11, peer_max_frame_size: 6,
        local_max_frame_size: 6, enabled: true}, storage);
    var data: [2]u8 = [2]u8{3, 4};
    if (!enqueue(?queue, ?data[0], 2).ok) { ret 1; }
    val prepared: Prepared = prepare(?queue, true);
    if (!prepared.ok || begin_close(?queue).status != STATUS_OK ||
        prepared.data.data[0] != 3 || finish_close(?queue).error != ERROR_CAPACITY ||
        publish(?queue, prepared).status != STATUS_OK ||
        finish_close(?queue).status != STATUS_OK ||
        cancel_prepared(?queue, prepared).status != STATUS_STALE) { ret 1; }
    ret 0;
}

test "quic.stream.datagram: owned regions reject maximum addresses and aliases" {
    var entries: [2]Entry;
    val config:  Config = Config{source: 90, peer_max_frame_size: 8,
        local_max_frame_size: 8, enabled: true};
    val maximum: usize = 0 - 1::usize;
    if (initialize(maximum::*Queue, config, test_storage(?entries[0], 1, 4, ?entries[1], 1, 4)) || initialize((?entries[0])::*Queue, config,
        test_storage(?entries[0], 1, 4, ?entries[1], 1, 4))) { ret 1; }
    val hostile: Queue = initialized_for_test(config, test_storage(maximum::*Entry, 1, 4, ?entries[1], 1, 4));
    val aliased: Queue = initialized_for_test(config, test_storage(?entries[0], 1, 4, ?entries[0], 1, 4));
    val wide:    Queue = initialized_for_test(config, test_storage(?entries[0], 1,
        supply.BYTES + 1, ?entries[1], 1, 4));
    if (hostile.valid || aliased.valid || wide.valid) { ret 1; }
    ret 0;
}

# an empty record literal does not reliably clear its fields, and these become
# ownership ranges: a stale pointer here makes a valid queue look overlapping
test "quic.stream.datagram: empty storage is fully cleared" {
    val value: Storage = empty_storage();
    if (value.send_entries != nil || value.receive_entries != nil ||
        value.chunks != nil || value.account != nil) { ret 1; }
    if (value.send_capacity != 0 || value.send_stride != 0 ||
        value.receive_capacity != 0 || value.receive_stride != 0) { ret 2; }
    var queue:  Queue;
    var config: Config;
    config.source               = 77;
    config.peer_max_frame_size  = 0;
    config.local_max_frame_size = 0;
    config.enabled              = false;
    if (!initialize(?queue, config, empty_storage())) { ret 3; }
    ret 0;
}

test "quic.stream.datagram: payload chunks are held only while a datagram is queued" {
    var fixture: supply.TestPool;
    var account: supply.Account;
    if (!supply.make_test(?fixture, 8) ||
        !supply.open(?fixture.provider, ?account, 5, 1, 1, 0)) { ret 1; }
    var send_entries:    [1]Entry;
    var receive_entries: [1]Entry;
    var queue:           Queue;
    if (!initialize(?queue, Config{source: 13, peer_max_frame_size: 64,
        local_max_frame_size: 64, enabled: true}, Storage{
        send_entries:         ?send_entries[0], send_capacity: 1, send_stride: 32,
        receive_entries:      ?receive_entries[0], receive_capacity: 1,
        receive_stride:       32, chunks: ?fixture.provider, account: ?account
    })) { ret 2; }
    if (supply.held(?account, supply.SEND) != 0 ||
        supply.held(?account, supply.RECEIVE) != 0) { ret 3; }
    var data: [3]u8 = [3]u8{1, 2, 3};
    # a small payload is charged the small chunk it got, and the entry table,
    # not the budget, caps how many wait
    val first: QueueResult = enqueue(?queue, ?data[0], 3);
    if (!first.ok || account.used[supply.SEND::usize] != supply.SMALL ||
        enqueue(?queue, ?data[0], 3).error != ERROR_CAPACITY ||
        queue.send_count != 1) { ret 4; }
    val prepared: Prepared = prepare(?queue, true);
    if (!prepared.ok || prepared.data.data[2] != 3 ||
        publish(?queue, prepared).status != STATUS_OK ||
        supply.held(?account, supply.SEND) != 0) { ret 5; }
    val empty: QueueResult = enqueue(?queue, nil, 0);
    if (!empty.ok || cancel(?queue, empty.token).status != STATUS_OK ||
        supply.held(?account, supply.SEND) != 0) { ret 6; }
    # an arriving datagram with no room is dropped, as RFC 9221 allows
    if (!receive(?queue, ?data[0], 3, 5).ok ||
        receive(?queue, ?data[0], 3, 5).error != ERROR_CAPACITY ||
        account.used[supply.RECEIVE::usize] != supply.SMALL) { ret 7; }
    val delivered: Delivery = next(?queue);
    if (delivered.status != STATUS_OK || delivered.data.data[0] != 1 ||
        release(?queue, delivered.token).status != STATUS_OK ||
        supply.held(?account, supply.RECEIVE) != 0) { ret 8; }
    # close gives back what is still queued
    if (!enqueue(?queue, ?data[0], 3).ok || !receive(?queue, ?data[0], 3, 5).ok ||
        begin_close(?queue).status != STATUS_OK ||
        finish_close(?queue).status != STATUS_OK ||
        supply.held(?account, supply.SEND) != 0 ||
        supply.held(?account, supply.RECEIVE) != 0) { ret 9; }
    # so is one whose chunk the budget refuses
    var starved:         supply.Account;
    var starved_entries: [1]Entry;
    var starved_queue:   Queue;
    if (!supply.open(?fixture.provider, ?starved, 6, 1, 0, 0) ||
        !initialize(?starved_queue, Config{source: 14, peer_max_frame_size: 64,
        local_max_frame_size: 64, enabled: true}, Storage{
        send_entries:         ?send_entries[0], send_capacity: 1, send_stride: 32,
        receive_entries:      ?starved_entries[0], receive_capacity: 1,
        receive_stride:       32, chunks: ?fixture.provider, account: ?starved
    })) { ret 11; }
    if (receive(?starved_queue, ?data[0], 3, 5).error != ERROR_CAPACITY ||
        starved_queue.receive_count != 0 ||
        starved.used[supply.RECEIVE::usize] != 0) { ret 12; }
    if (begin_close(?starved_queue).status != STATUS_OK ||
        finish_close(?starved_queue).status != STATUS_OK ||
        !supply.close(?fixture.provider, ?starved)) { ret 13; }
    if (!supply.close(?fixture.provider, ?account) || !supply.end_test(?fixture)) { ret 10; }
    ret 0;
}
