use quic.connection.ownership;
use quic.packet.packet;
use quic.storage.chunks;
use quic.storage.limited;
use quic.storage.pool;
use quic.storage.ranges;
use quic.wire.varint;

use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val ROLE_CLIENT: u8 = 1;
pub val ROLE_SERVER: u8 = 2;

pub val DIRECTION_BIDIRECTIONAL:  u8 = 1;
pub val DIRECTION_UNIDIRECTIONAL: u8 = 2;

pub val SEND_STREAM:           u8 = 1;
pub val SEND_RESET:            u8 = 2;
pub val SEND_STOP:             u8 = 3;
pub val SEND_MAX_DATA:         u8 = 4;
pub val SEND_MAX_STREAM_DATA:  u8 = 5;
pub val SEND_MAX_STREAMS_BIDI: u8 = 6;
pub val SEND_MAX_STREAMS_UNI:  u8 = 7;

pub val TERMINAL_ACKED: u8 = 1;
pub val TERMINAL_LOST:  u8 = 2;

pub val STATUS_OK:        u8 = 1;
pub val STATUS_EMPTY:     u8 = 2;
pub val STATUS_BLOCKED:   u8 = 3;
pub val STATUS_RESET:     u8 = 4;
pub val STATUS_FINISHED:  u8 = 5;
pub val STATUS_CANCELLED: u8 = 6;
pub val STATUS_STALE:     u8 = 7;
pub val STATUS_ERROR:     u8 = 8;

pub val ERROR_NONE:          u8 = 0;
pub val ERROR_STATE:         u8 = 1;
pub val ERROR_STREAM_LIMIT:  u8 = 2;
pub val ERROR_CAPACITY:      u8 = 3;
pub val ERROR_DIRECTION:     u8 = 4;
pub val ERROR_FLOW_CONTROL:  u8 = 5;
pub val ERROR_FINAL_SIZE:    u8 = 6;
pub val ERROR_DATA_CONFLICT: u8 = 7;
pub val ERROR_TOKEN:         u8 = 8;
pub val ERROR_OVERFLOW:      u8 = 9;
pub val ERROR_CANCELLED:     u8 = 10;
# a receive the connection cannot store right now: the caller refuses the
# packet unacknowledged and the peer retransmits it
pub val ERROR_STORAGE: u8 = 11;

val ATTEMPT_FREE:     u8  = 0;
val ATTEMPT_RESERVED: u8  = 1;
val ATTEMPT_ACTIVE:   u8  = 2;
val MAX_STREAM_COUNT: u64 = 1 << 60;

# receive intervals a stream may hold per this many bytes of its window, with a
# floor, so a peer fragmenting its data can never grow the bookkeeping past a
# bound proportional to what it was allowed to send
val RANGE_WINDOW_DIVISOR: u64   = 1024;
val RANGE_FLOOR:          usize = 32;

# no stream, for the intrusive lists below
val NO_STREAM: usize = 0xffffffffffffffff;

# records and attempts left unlent are taken from the pool a chunk at a time
pub val RECORDS_PER_BLOCK:  usize = pool.CHUNK / $size_of(Stream);
pub val RECORD_BLOCKS:      usize = 8;
pub val ATTEMPTS_PER_BLOCK: usize = pool.CHUNK / $size_of(Attempt);

# news an owner can act on for one stream
pub val READY_READABLE: u8 = 1;
pub val READY_WRITABLE: u8 = 2;
pub val READY_RESET:    u8 = 4;

# why a stream's last write stopped short
val BLOCKED_STREAM:     u8 = 1;
val BLOCKED_CONNECTION: u8 = 2;
val BLOCKED_STORAGE:    u8 = 4;

pub rec Config {
    source:                            u64;
    role:                              u8;
    local_bidirectional_limit:         u64;
    local_unidirectional_limit:        u64;
    peer_bidirectional_limit:          u64;
    peer_unidirectional_limit:         u64;
    send_max_data:                     u64;
    receive_max_data:                  u64;
    send_local_bidirectional_limit:    u64;
    send_peer_bidirectional_limit:     u64;
    send_unidirectional_limit:         u64;
    receive_local_bidirectional_limit: u64;
    receive_peer_bidirectional_limit:  u64;
    receive_unidirectional_limit:      u64;
}

pub rec Stream {
    id:                      u64;
    generation:              u64;
    accept_sequence:         u64;
    send_base:               u64;
    send_write:              u64;
    send_limit:              u64;
    receive_read:            u64;
    receive_highest:         u64;
    receive_limit:           u64;
    receive_uncredited:      u64;
    final_size:              u64;
    active_attempts:         usize;
    send_error:              u64;
    receive_error:           u64;
    active:                  bool;
    local:                   bool;
    unidirectional:          bool;
    accepted:                bool;
    can_send:                bool;
    can_receive:             bool;
    send_finished:           bool;
    send_closed:             bool;
    send_cancelled:          bool;
    fin_pending:             bool;
    fin_acked:               bool;
    fin_inflight:            u8;
    reset_pending:           bool;
    reset_acked:             bool;
    reset_inflight:          u8;
    receive_closed:          bool;
    receive_cancelled:       bool;
    final_known:             bool;
    reset_received:          bool;
    stop_pending:            bool;
    stop_acked:              bool;
    stop_inflight:           u8;
    stop_received:           bool;
    receive_advertised:      u64;
    max_stream_data_pending: bool;
    has_prepared:            bool;
    # send: the chunks written and not yet acknowledged, and the acknowledged
    # intervals above send_base. receive: the chunks holding unread bytes, and
    # the intervals present above receive_read
    send:    Buffer;
    receive: Buffer;
    # the ready queue: news not yet handed to the owner, oldest stream first
    ready_bits: u8;
    ready_prev: usize;
    ready_next: usize;
    # the causes of the last short write, and the list of streams waiting on
    # connection credit or storage, which a single event can release together
    blocked:      u8;
    blocked_prev: usize;
    blocked_next: usize;
}

pub rec Ready {
    status:   u8;
    handle:   Handle;
    readable: bool;
    writable: bool;
    reset:    bool;
}

pub rec Buffer {
    chunks: chunks.Chunks;
    ranges: ranges.RangeSet;
}

pub rec Attempt {
    generation:        u64;
    stream_index:      usize;
    stream_generation: u64;
    offset:            u64;
    length:            usize;
    maximum:           u64;
    chunk:             pool.Ref;
    kind:              u8;
    state:             u8;
    fin:               bool;
}

# streams, attempts: lent for the manager's lifetime, or nil to take them from
#                    the pool while they are in use
# chunks:            where every stream's bytes come from
# account:           whose budget they count against
# send_buffer_limit: bytes a stream may hold written and unacknowledged
pub rec Storage {
    streams:           *Stream;
    stream_capacity:   usize;
    attempts:          *Attempt;
    attempt_capacity:  usize;
    chunks:            *pool.Pool;
    account:           *pool.Account;
    send_buffer_limit: usize;
}

pub rec Manager {
    config:                      Config;
    storage:                     Storage;
    local_bidirectional_opened:  u64;
    local_unidirectional_opened: u64;
    peer_bidirectional_opened:   u64;
    peer_unidirectional_opened:  u64;
    send_committed:              u64;
    receive_committed:           u64;
    send_max_data:               u64;
    receive_max_data:            u64;
    receive_advertised:          u64;
    accept_sequence:             u64;
    active_streams:              usize;
    active_attempts:             usize;
    peer_limits_applied:         bool;
    max_data_pending:            bool;
    max_streams_bidi_pending:    bool;
    max_streams_uni_pending:     bool;
    peer_bidi_advertised:        u64;
    peer_uni_advertised:         u64;
    control_prepared:            bool;
    # bumped whenever send work may have appeared outside a core call, so an
    # idle core notices without scanning
    send_revision: u64;
    ready_head:    usize;
    ready_tail:    usize;
    blocked_head:  usize;
    blocked_tail:  usize;
    # acknowledgements that could not be recorded, so their bytes go again
    ack_record_refusals: u64;
    # received frames refused for storage before their packet was acknowledged
    receive_storage_refusals: u64;
    # records and attempts taken from the pool, and how many are in use
    record_blocks: [RECORD_BLOCKS]chunks.Block;
    record_live:   [RECORD_BLOCKS]usize;
    attempt_block: chunks.Block;
    attempts_live: usize;
    # generations are the manager's, so a record or attempt taken again from a
    # fresh chunk never matches a token issued before
    stream_generation:  u64;
    attempt_generation: u64;
    core_lease:         u64;
    valid:              bool;
    closing:            bool;
}

pub rec Handle {
    source:     u64;
    index:      usize;
    generation: u64;
    id:         u64;
}

pub rec AttemptToken {
    source:     u64;
    index:      usize;
    generation: u64;
}

pub rec CreateResult {
    status:               u8;
    error:                u8;
    handle:               Handle;
    stream_limit_blocked: bool;
    storage_blocked:      bool;
}

pub rec WriteResult {
    status:             u8;
    error:              u8;
    count:              usize;
    connection_blocked: bool;
    stream_blocked:     bool;
    storage_blocked:    bool;
}

pub rec ReadResult {
    status:                  u8;
    error:                   u8;
    count:                   usize;
    final_size:              u64;
    application_error:       u64;
    receive_max_data:        u64;
    receive_max_stream_data: u64;
    receive_uncredited:      u64;
    fin:                     bool;
}

pub rec ReceiveResult {
    ok:                      bool;
    error:                   u8;
    handle:                  Handle;
    new_streams:             usize;
    connection_delta:        u64;
    receive_max_stream_data: u64;
    closed:                  bool;
}

pub rec Prepared {
    ok:                bool;
    status:            u8;
    error:             u8;
    token:             AttemptToken;
    handle:            Handle;
    data:              packet.Span;
    offset:            u64;
    final_size:        u64;
    application_error: u64;
    maximum:           u64;
    kind:              u8;
    fin:               bool;
}

pub rec OperationResult {
    status:                  u8;
    error:                   u8;
    receive_max_data:        u64;
    receive_max_stream_data: u64;
    peer_max_streams:        u64;
}

pub rec Snapshot {
    ok:                 bool;
    error:              u8;
    id:                 u64;
    send_offset:        u64;
    receive_offset:     u64;
    final_size:         u64;
    send_error:         u64;
    receive_error:      u64;
    send_closed:        bool;
    receive_closed:     bool;
    send_cancelled:     bool;
    receive_cancelled:  bool;
    final_known:        bool;
    receive_uncredited: u64;
}

pub fun initiated_by_server(id: u64) bool {
    ret (id & 1) != 0;
}

pub fun unidirectional(id: u64) bool {
    ret (id & 2) != 0;
}

fun local_initiator(manager: *Manager, id: u64) bool {
    val server: bool = manager.config.role == ROLE_SERVER;
    ret initiated_by_server(id) == server;
}

fun previously_opened(manager: *Manager, id: u64) bool {
    val local:  bool = local_initiator(manager, id);
    val uni:    bool = unidirectional(id);
    var opened: u64  = manager.peer_bidirectional_opened;
    if (local)         { opened = manager.local_bidirectional_opened; }
    if (uni && local)  { opened = manager.local_unidirectional_opened; }
    if (uni && !local) { opened = manager.peer_unidirectional_opened; }
    ret (id >> 2) < opened;
}

fun id_can_send(manager: *Manager, id: u64) bool {
    ret !unidirectional(id) || local_initiator(manager, id);
}

fun id_can_receive(manager: *Manager, id: u64) bool {
    ret !unidirectional(id) || !local_initiator(manager, id);
}

fun minimum(a: u64, b: u64) u64 {
    if (a < b) { ret a; }
    ret b;
}

fun minimum_size(a: usize, b: usize) usize {
    if (a < b) { ret a; }
    ret b;
}

fun valid_config(config: Config, storage: Storage) bool {
    if (config.source == 0 || (config.role != ROLE_CLIENT && config.role != ROLE_SERVER)) { ret false; }
    if (config.local_bidirectional_limit > MAX_STREAM_COUNT || config.local_unidirectional_limit > MAX_STREAM_COUNT ||
        config.peer_bidirectional_limit > MAX_STREAM_COUNT || config.peer_unidirectional_limit > MAX_STREAM_COUNT) { ret false; }
    if (config.send_max_data > varint.MAX || config.receive_max_data > varint.MAX ||
        config.send_local_bidirectional_limit > varint.MAX || config.send_peer_bidirectional_limit > varint.MAX ||
        config.send_unidirectional_limit > varint.MAX || config.receive_local_bidirectional_limit > varint.MAX ||
        config.receive_peer_bidirectional_limit > varint.MAX || config.receive_unidirectional_limit > varint.MAX) { ret false; }
    if (storage.stream_capacity == 0 || storage.attempt_capacity == 0 ||
        storage.chunks == nil || storage.account == nil || !storage.account.open ||
        storage.account.pool != storage.chunks || storage.send_buffer_limit == 0) { ret false; }
    if ((storage.streams == nil &&
        storage.stream_capacity > RECORDS_PER_BLOCK * RECORD_BLOCKS) ||
        (storage.attempts == nil && storage.attempt_capacity > ATTEMPTS_PER_BLOCK)) {
        ret false;
    }
    var ranges: [2]ownership.Range;
    ranges[0] = lent_records(storage);
    ranges[1] = lent_attempts(storage);
    ret ownership.all_disjoint(?ranges[0], 2);
}

# the caller-lent record array, empty when records come from the pool
pub fun lent_records(storage: Storage) ownership.Range {
    if (storage.streams == nil) {
        ret ownership.array(nil::*u8, 0, $size_of(Stream), ownership.ZERO_ALLOWED);
    }
    ret ownership.array(storage.streams::*u8, storage.stream_capacity,
        $size_of(Stream), ownership.ZERO_FORBIDDEN);
}

# the caller-lent attempt array, empty when attempts come from the pool
pub fun lent_attempts(storage: Storage) ownership.Range {
    if (storage.attempts == nil) {
        ret ownership.array(nil::*u8, 0, $size_of(Attempt), ownership.ZERO_ALLOWED);
    }
    ret ownership.array(storage.attempts::*u8, storage.attempt_capacity,
        $size_of(Attempt), ownership.ZERO_FORBIDDEN);
}

fun next_generation(value: u64) u64 {
    if (value == 0 - 1::u64) { ret 1; }
    ret value + 1;
}

pub fun initialize(manager: *Manager, config: Config, storage: Storage) bool {
    if (manager == nil) { ret false; }
    var ranges: [3]ownership.Range;
    ranges[0] = ownership.bytes((?manager.config)::*u8, $size_of(Manager),
        ownership.ZERO_FORBIDDEN);
    ranges[1] = lent_records(storage);
    ranges[2] = lent_attempts(storage);
    if (!ownership.all_disjoint(?ranges[0], 3) || manager.valid ||
        !valid_config(config, storage)) { ret false; }
    var candidate: Manager;
    candidate.config  = config;
    candidate.storage = storage;
    var i: usize = 0;
    for (storage.streams != nil && i < storage.stream_capacity) {
        storage.streams[i].generation = 0;
        storage.streams[i].active     = false;
        i                             = i + 1;
    }
    i = 0;
    for (storage.attempts != nil && i < storage.attempt_capacity) {
        storage.attempts[i].generation = 0;
        storage.attempts[i].state      = ATTEMPT_FREE;
        i                              = i + 1;
    }
    candidate.send_max_data        = config.send_max_data;
    candidate.receive_max_data     = config.receive_max_data;
    candidate.receive_advertised   = config.receive_max_data;
    candidate.peer_bidi_advertised = config.peer_bidirectional_limit;
    candidate.peer_uni_advertised  = config.peer_unidirectional_limit;
    candidate.accept_sequence      = 1;
    candidate.ready_head           = NO_STREAM;
    candidate.ready_tail           = NO_STREAM;
    candidate.blocked_head         = NO_STREAM;
    candidate.blocked_tail         = NO_STREAM;
    candidate.valid                = true;
    manager[0]                     = candidate;
    ret true;
}

pub fun lease_core(manager: *Manager, source: u64) bool {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing || source == 0 ||
        manager.core_lease != 0) { ret false; }
    manager.core_lease = source;
    ret true;
}

pub fun release_core(manager: *Manager, source: u64) bool {
    if (!manager_record_valid(manager) || !manager.valid || source == 0 ||
        manager.core_lease != source) { ret false; }
    manager.core_lease = 0;
    ret true;
}

fun manager_record_valid(manager: *Manager) bool {
    ret manager != nil && ownership.bytes((?manager.config)::*u8,
        $size_of(Manager), ownership.ZERO_FORBIDDEN).valid;
}

# chunks come from the pool's own allocations, so only the records are checked
fun borrowed_disjoint(manager: *Manager, borrowed: ownership.Range) bool {
    if (!manager_record_valid(manager) || !borrowed.valid ||
        !ownership.disjoint(borrowed, ownership.bytes((?manager.config)::*u8,
        $size_of(Manager), ownership.ZERO_FORBIDDEN))) { ret false; }
    ret ownership.disjoint(borrowed, lent_records(manager.storage)) &&
        ownership.disjoint(borrowed, lent_attempts(manager.storage));
}

# the record at `index`, or nil when its chunk is not held
fun record(manager: *Manager, index: usize) *Stream {
    if (index >= manager.storage.stream_capacity) { ret nil; }
    if (manager.storage.streams != nil)           { ret ?manager.storage.streams[index]; }
    val block: *u8 = manager.record_blocks[index / RECORDS_PER_BLOCK].data;
    if (block == nil) { ret nil; }
    ret ?(block::*Stream)[index % RECORDS_PER_BLOCK];
}

# the record at `index` when it holds a live stream
fun live(manager: *Manager, index: usize) *Stream {
    val stream: *Stream = record(manager, index);
    if (stream == nil || !stream.active) { ret nil; }
    ret stream;
}

fun record_source(manager: *Manager) ranges.Source {
    ret source(manager, pool.SEND);
}

# records the block at `block` can hold within the capacity
fun block_records(manager: *Manager, block: usize) usize {
    val first: usize = block * RECORDS_PER_BLOCK;
    if (first >= manager.storage.stream_capacity) { ret 0; }
    ret minimum_size(RECORDS_PER_BLOCK, manager.storage.stream_capacity - first);
}

# holds enough free records for `count` new streams, or takes nothing
fun ensure_records(manager: *Manager, count: usize) bool {
    if (manager.storage.streams != nil) { ret true; }
    var free:  usize = 0;
    var block: usize = 0;
    for (block < RECORD_BLOCKS) {
        if (manager.record_blocks[block].data != nil) {
            free = free + block_records(manager, block) - manager.record_live[block];
        }
        block = block + 1;
    }
    var from:  ranges.Source = record_source(manager);
    var taken: [RECORD_BLOCKS]bool;
    block = 0;
    for (free < count && block < RECORD_BLOCKS) {
        if (manager.record_blocks[block].data == nil && block_records(manager, block) > 0) {
            if (!chunks.take_block(?from, ?manager.record_blocks[block])) { brk; }
            taken[block] = true;
            free         = free + block_records(manager, block);
        }
        block = block + 1;
    }
    if (free >= count) { ret true; }
    block = 0;
    for (block < RECORD_BLOCKS) {
        if (taken[block]) { chunks.give_block(?from, ?manager.record_blocks[block]); }
        block = block + 1;
    }
    ret false;
}

fun record_taken(manager: *Manager, index: usize) {
    if (manager.storage.streams != nil) { ret; }
    val block: usize = index / RECORDS_PER_BLOCK;
    manager.record_live[block] = manager.record_live[block] + 1;
}

# a record that no longer holds a stream, whose chunk goes back once empty
fun record_dropped(manager: *Manager, index: usize) {
    if (manager.storage.streams != nil) { ret; }
    val block: usize = index / RECORDS_PER_BLOCK;
    if (manager.record_live[block] > 0) {
        manager.record_live[block] = manager.record_live[block] - 1;
    }
    if (manager.record_live[block] == 0) {
        var from: ranges.Source = record_source(manager);
        chunks.give_block(?from, ?manager.record_blocks[block]);
    }
}

# the attempt at `index`, or nil when its chunk is not held
fun attempt_at(manager: *Manager, index: usize) *Attempt {
    if (index >= manager.storage.attempt_capacity) { ret nil; }
    if (manager.storage.attempts != nil)           { ret ?manager.storage.attempts[index]; }
    val block: *u8 = manager.attempt_block.data;
    if (block == nil) { ret nil; }
    ret ?(block::*Attempt)[index];
}

fun attempt_free(manager: *Manager, index: usize) bool {
    val attempt: *Attempt = attempt_at(manager, index);
    ret attempt == nil || attempt.state == ATTEMPT_FREE;
}

# the first free attempt index, or the capacity when none is
fun free_attempt_index(manager: *Manager) usize {
    var index: usize = 0;
    for (index < manager.storage.attempt_capacity && !attempt_free(manager, index)) {
        index = index + 1;
    }
    ret index;
}

# takes the free attempt at `index` under a new generation, or nil when its
# chunk is refused
fun occupy_attempt(manager: *Manager, index: usize) *Attempt {
    if (manager.storage.attempts == nil && manager.attempt_block.data == nil) {
        var from: ranges.Source = record_source(manager);
        if (!chunks.take_block(?from, ?manager.attempt_block)) { ret nil; }
    }
    val attempt: *Attempt = attempt_at(manager, index);
    var clean:   Attempt;
    manager.attempt_generation = next_generation(manager.attempt_generation);
    clean.generation           = manager.attempt_generation;
    @attempt                   = clean;
    manager.attempts_live      = manager.attempts_live + 1;
    ret attempt;
}

fun handle(manager: *Manager, index: usize) Handle {
    var value: Handle;
    value.source     = manager.config.source;
    value.index      = index;
    value.generation = record(manager, index).generation;
    value.id         = record(manager, index).id;
    ret value;
}

fun valid_handle(manager: *Manager, value: Handle) bool {
    if (!manager_record_valid(manager) || !manager.valid || value.source != manager.config.source ||
        value.index >= manager.storage.stream_capacity) { ret false; }
    val stream: *Stream = live(manager, value.index);
    ret stream != nil && stream.generation == value.generation && stream.id == value.id;
}

fun stream_index(manager: *Manager, id: u64) usize {
    var i: usize = 0;
    for (i < manager.storage.stream_capacity) {
        val stream: *Stream = live(manager, i);
        if (stream != nil && stream.id == id) { ret i; }
        i = i + 1;
    }
    ret manager.storage.stream_capacity;
}

# a free record for one new stream, taking a chunk when needed
fun free_index_ready(manager: *Manager) usize {
    if (manager.active_streams >= manager.storage.stream_capacity ||
        !ensure_records(manager, 1)) { ret manager.storage.stream_capacity; }
    ret free_index(manager);
}

# the first record held and free, or the capacity
fun free_index(manager: *Manager) usize {
    var i: usize = 0;
    for (i < manager.storage.stream_capacity) {
        val stream: *Stream = record(manager, i);
        if (stream != nil && !stream.active) { brk; }
        i = i + 1;
    }
    ret i;
}

fun source(manager: *Manager, direction: pool.Direction) ranges.Source {
    ret ranges.Source{pool: manager.storage.chunks, account: manager.storage.account,
        direction: direction};
}

fun buffer_release(manager: *Manager, buffer: *Buffer, direction: pool.Direction) {
    var from: ranges.Source = source(manager, direction);
    chunks.release_all(?buffer.chunks, ?from);
    ranges.clear(?buffer.ranges, ?from);
}

fun receive_cap(limit: u64) usize {
    val scaled: u64 = limit / RANGE_WINDOW_DIVISOR;
    if (scaled < RANGE_FLOOR::u64)           { ret RANGE_FLOOR; }
    if (scaled > ranges.SPILL_CAPACITY::u64) { ret ranges.SPILL_CAPACITY; }
    ret scaled::usize;
}

fun send_limit(config: Config, local: bool, uni: bool) u64 {
    if (uni) {
        if (local) { ret config.send_unidirectional_limit; }
        ret 0;
    }
    if (local) { ret config.send_local_bidirectional_limit; }
    ret config.send_peer_bidirectional_limit;
}

fun receive_limit(config: Config, local: bool, uni: bool) u64 {
    if (uni) {
        if (!local) { ret config.receive_unidirectional_limit; }
        ret 0;
    }
    if (local) { ret config.receive_local_bidirectional_limit; }
    ret config.receive_peer_bidirectional_limit;
}

fun initialize_stream(manager: *Manager, index: usize, id: u64, local: bool, accepted: bool) {
    manager.stream_generation = next_generation(manager.stream_generation);
    var stream: Stream;
    stream.id                 = id;
    stream.generation         = manager.stream_generation;
    stream.active             = true;
    stream.local              = local;
    stream.unidirectional     = unidirectional(id);
    stream.accepted           = accepted;
    stream.can_send           = !stream.unidirectional || local;
    stream.can_receive        = !stream.unidirectional || !local;
    stream.send_closed        = !stream.can_send;
    stream.receive_closed     = !stream.can_receive;
    stream.send_limit         = send_limit(manager.config, local, stream.unidirectional);
    stream.receive_limit      = receive_limit(manager.config, local, stream.unidirectional);
    stream.receive_advertised = stream.receive_limit;
    stream.accept_sequence    = manager.accept_sequence;
    manager.accept_sequence   = manager.accept_sequence + 1;
    stream.ready_prev         = NO_STREAM;
    stream.ready_next         = NO_STREAM;
    stream.blocked_prev       = NO_STREAM;
    stream.blocked_next       = NO_STREAM;
    stream.send.ranges        = ranges.make(ranges.SPILL_CAPACITY);
    stream.receive.ranges     = ranges.make(receive_cap(stream.receive_limit));
    @record(manager, index)   = stream;
    record_taken(manager, index);
    manager.active_streams = manager.active_streams + 1;
}

fun create_error(code: u8) CreateResult {
    var result: CreateResult;
    result.status = STATUS_ERROR;
    result.error  = code;
    ret result;
}

# whether no attempt is reserved or in flight
pub fun attempts_drained(manager: *Manager) bool {
    if (!manager_record_valid(manager) || manager.active_attempts != 0) { ret false; }
    var i: usize = 0;
    for (i < manager.storage.attempt_capacity) {
        if (!attempt_free(manager, i)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the handle of the live stream at `index`, with source 0 when there is none
pub fun handle_at(manager: *Manager, index: usize) Handle {
    var none: Handle;
    if (!manager_record_valid(manager) || live(manager, index) == nil) { ret none; }
    ret handle(manager, index);
}

fun at_stream(manager: *Manager, index: usize) *Stream {
    ret record(manager, index);
}

# queues news for a stream the owner already knows. a stream still waiting for
# accept is skipped, since accept names it; a queued stream just gains bits
fun push_ready(manager: *Manager, index: usize, bits: u8) {
    val stream: *Stream = at_stream(manager, index);
    if (!stream.active || !stream.accepted) { ret; }
    if (stream.ready_bits != 0) {
        stream.ready_bits = stream.ready_bits | bits;
        ret;
    }
    stream.ready_bits = bits;
    stream.ready_prev = manager.ready_tail;
    stream.ready_next = NO_STREAM;
    if (manager.ready_tail == NO_STREAM) { manager.ready_head = index; }
    or                                   { at_stream(manager, manager.ready_tail).ready_next = index; }
    manager.ready_tail = index;
}

fun unlink_ready(manager: *Manager, index: usize) {
    val stream: *Stream = at_stream(manager, index);
    if (stream.ready_bits == 0)         { ret; }
    if (stream.ready_prev == NO_STREAM) { manager.ready_head = stream.ready_next; }
    or                                  { at_stream(manager, stream.ready_prev).ready_next = stream.ready_next; }
    if (stream.ready_next == NO_STREAM) { manager.ready_tail = stream.ready_prev; }
    or                                  { at_stream(manager, stream.ready_next).ready_prev = stream.ready_prev; }
    stream.ready_prev = NO_STREAM;
    stream.ready_next = NO_STREAM;
    stream.ready_bits = 0;
}

fun listed_blocked(stream: *Stream) bool {
    ret (stream.blocked & (BLOCKED_CONNECTION | BLOCKED_STORAGE)) != 0;
}

# records why a write stopped short, listing the stream when a shared event
# can end it
fun note_blocked(manager: *Manager, index: usize, causes: u8) {
    val stream: *Stream = at_stream(manager, index);
    val listed: bool    = listed_blocked(stream);
    stream.blocked = stream.blocked | causes;
    if (listed || !listed_blocked(stream)) { ret; }
    stream.blocked_prev = manager.blocked_tail;
    stream.blocked_next = NO_STREAM;
    if (manager.blocked_tail == NO_STREAM) { manager.blocked_head = index; }
    or                                     { at_stream(manager, manager.blocked_tail).blocked_next = index; }
    manager.blocked_tail = index;
}

# clears causes, and reports the stream writable once none of the given ones
# is left
fun clear_blocked(manager: *Manager, index: usize, causes: u8) {
    val stream: *Stream = at_stream(manager, index);
    if ((stream.blocked & causes) == 0) { ret; }
    val listed: bool = listed_blocked(stream);
    stream.blocked = stream.blocked & ~causes;
    if (listed && !listed_blocked(stream)) {
        if (stream.blocked_prev == NO_STREAM) { manager.blocked_head = stream.blocked_next; }
        or                                    { at_stream(manager, stream.blocked_prev).blocked_next = stream.blocked_next; }
        if (stream.blocked_next == NO_STREAM) { manager.blocked_tail = stream.blocked_prev; }
        or                                    { at_stream(manager, stream.blocked_next).blocked_prev = stream.blocked_prev; }
        stream.blocked_prev = NO_STREAM;
        stream.blocked_next = NO_STREAM;
    }
    push_ready(manager, index, READY_WRITABLE);
}

# reports every listed stream blocked on `cause`. the walk is over blocked
# streams only, once per event that can release them
fun release_blocked(manager: *Manager, cause: u8) {
    var index: usize = manager.blocked_head;
    for (index != NO_STREAM) {
        val next: usize = at_stream(manager, index).blocked_next;
        clear_blocked(manager, index, cause);
        index = next;
    }
}

fun unlink_everywhere(manager: *Manager, index: usize) {
    unlink_ready(manager, index);
    val stream: *Stream = at_stream(manager, index);
    if (listed_blocked(stream)) {
        clear_blocked(manager, index, BLOCKED_CONNECTION | BLOCKED_STORAGE);
        unlink_ready(manager, index);
    }
    stream.blocked = 0;
}

fun readable_news(stream: *Stream) bool {
    ret ranges.covered_from(?stream.receive.ranges, stream.receive_read) > stream.receive_read ||
        (stream.final_known && stream.receive_read == stream.final_size && !stream.receive_closed);
}

# hands the owner the oldest stream with news, O(1)
pub fun next_ready(manager: *Manager) Ready {
    var result: Ready;
    if (!manager_record_valid(manager) || !manager.valid ||
        manager.ready_head == NO_STREAM) {
        result.status = STATUS_EMPTY;
        ret result;
    }
    val index:  usize   = manager.ready_head;
    val stream: *Stream = at_stream(manager, index);
    val bits:   u8      = stream.ready_bits;
    unlink_ready(manager, index);
    result.status   = STATUS_OK;
    result.handle   = handle(manager, index);
    result.readable = (bits & READY_READABLE) != 0;
    result.writable = (bits & READY_WRITABLE) != 0;
    result.reset    = (bits & READY_RESET) != 0;
    ret result;
}

# the pool gave chunks back, so every stream a refused chunk stopped may write
pub fun storage_released(manager: *Manager) {
    if (!manager_record_valid(manager) || !manager.valid) { ret; }
    release_blocked(manager, BLOCKED_STORAGE);
}

pub fun open(manager: *Manager, direction: u8) CreateResult {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing) { ret create_error(ERROR_STATE); }
    if (direction != DIRECTION_BIDIRECTIONAL && direction != DIRECTION_UNIDIRECTIONAL) {
        ret create_error(ERROR_DIRECTION);
    }
    val uni:    bool = direction == DIRECTION_UNIDIRECTIONAL;
    var opened: u64  = manager.local_bidirectional_opened;
    var limit:  u64  = manager.config.local_bidirectional_limit;
    if (uni) {
        opened = manager.local_unidirectional_opened;
        limit  = manager.config.local_unidirectional_limit;
    }
    if (opened >= limit) {
        var blocked: CreateResult = create_error(ERROR_STREAM_LIMIT);
        blocked.status               = STATUS_BLOCKED;
        blocked.stream_limit_blocked = true;
        ret blocked;
    }
    val index: usize = free_index_ready(manager);
    if (index == manager.storage.stream_capacity) {
        var blocked: CreateResult = create_error(ERROR_CAPACITY);
        blocked.status          = STATUS_BLOCKED;
        blocked.storage_blocked = true;
        ret blocked;
    }
    var initiator: u64 = 0;
    if (manager.config.role == ROLE_SERVER) { initiator = 1; }
    var direction_bit: u64 = 0;
    if (uni) { direction_bit = 2; }
    val id: u64 = opened * 4 + initiator + direction_bit;
    initialize_stream(manager, index, id, true, true);
    if (uni) { manager.local_unidirectional_opened = opened + 1; }
    or       { manager.local_bidirectional_opened = opened + 1; }
    var result: CreateResult;
    result.status = STATUS_OK;
    result.handle = handle(manager, index);
    ret result;
}

fun peer_open(manager: *Manager, id: u64) CreateResult {
    if (id > varint.MAX || local_initiator(manager, id)) { ret create_error(ERROR_DIRECTION); }
    val existing: usize = stream_index(manager, id);
    if (existing < manager.storage.stream_capacity) {
        var found: CreateResult;
        found.status = STATUS_OK;
        found.handle = handle(manager, existing);
        ret found;
    }
    val uni:     bool = unidirectional(id);
    val ordinal: u64  = id >> 2;
    var opened:  u64  = manager.peer_bidirectional_opened;
    var limit:   u64  = manager.config.peer_bidirectional_limit;
    if (uni) {
        opened = manager.peer_unidirectional_opened;
        limit  = manager.config.peer_unidirectional_limit;
    }
    if (ordinal >= limit || ordinal < opened) { ret create_error(ERROR_STREAM_LIMIT); }
    val needed: u64 = ordinal + 1 - opened;
    if (needed > manager.storage.stream_capacity::u64 - manager.active_streams::u64) {
        ret create_error(ERROR_CAPACITY);
    }
    # records for every stream the frame opens, or the frame is refused
    if (!ensure_records(manager, needed::usize)) {
        manager.receive_storage_refusals = manager.receive_storage_refusals + 1;
        ret create_error(ERROR_STORAGE);
    }
    var created:   u64 = 0;
    var requested: Handle;
    var initiator: u64 = 0;
    if (manager.config.role == ROLE_CLIENT) { initiator = 1; }
    var direction_bit: u64 = 0;
    if (uni) { direction_bit = 2; }
    for (created < needed) {
        val index:     usize = free_index(manager);
        val stream_id: u64   = (opened + created) * 4 + initiator + direction_bit;
        initialize_stream(manager, index, stream_id, false, false);
        if (stream_id == id) { requested = handle(manager, index); }
        created = created + 1;
    }
    if (uni) { manager.peer_unidirectional_opened = ordinal + 1; }
    or       { manager.peer_bidirectional_opened = ordinal + 1; }
    var result: CreateResult;
    result.status = STATUS_OK;
    result.handle = requested;
    ret result;
}

pub fun accept(manager: *Manager) CreateResult {
    if (!manager_record_valid(manager) || !manager.valid) { ret create_error(ERROR_STATE); }
    var chosen:   usize = manager.storage.stream_capacity;
    var sequence: u64   = 0;
    var i:        usize = 0;
    for (i < manager.storage.stream_capacity) {
        val stream: *Stream = live(manager, i);
        if (stream != nil && !stream.local && !stream.accepted &&
            (chosen == manager.storage.stream_capacity || stream.accept_sequence < sequence)) {
            chosen   = i;
            sequence = stream.accept_sequence;
        }
        i = i + 1;
    }
    if (chosen == manager.storage.stream_capacity) {
        var empty: CreateResult;
        empty.status = STATUS_EMPTY;
        ret empty;
    }
    record(manager, chosen).accepted = true;
    # news that arrived before accept was skipped, so it is queued now
    val accepted: *Stream = at_stream(manager, chosen);
    var news:     u8      = 0;
    if (readable_news(accepted))                           { news = news | READY_READABLE; }
    if (accepted.reset_received || accepted.stop_received) { news = news | READY_RESET; }
    if (news != 0)                                         { push_ready(manager, chosen, news); }
    var result: CreateResult;
    result.status = STATUS_OK;
    result.handle = handle(manager, chosen);
    ret result;
}

fun operation_error(code: u8) OperationResult {
    var result: OperationResult;
    result.status = STATUS_ERROR;
    result.error  = code;
    ret result;
}

pub fun update_max_data(manager: *Manager, maximum: u64) OperationResult {
    if (!manager_record_valid(manager) || !manager.valid ||
        manager.core_lease != 0) { ret operation_error(ERROR_STATE); }
    if (maximum > varint.MAX) { ret operation_error(ERROR_OVERFLOW); }
    if (maximum > manager.send_max_data) {
        manager.send_max_data = maximum;
        manager.send_revision = manager.send_revision + 1;
        release_blocked(manager, BLOCKED_CONNECTION);
    }
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

# binds the peer's authenticated initial transport limits exactly once
pub fun apply_peer_limits(manager: *Manager, max_data: u64,
    stream_data_bidi_local: u64,
    stream_data_bidi_remote: u64,
    stream_data_uni: u64, streams_bidi: u64,
    streams_uni: u64) OperationResult {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing ||
        manager.core_lease != 0 || manager.peer_limits_applied ||
        manager.active_streams != 0 ||
        manager.send_committed != 0 || manager.send_max_data != 0 ||
        manager.config.local_bidirectional_limit != 0 ||
        manager.config.local_unidirectional_limit != 0 ||
        manager.config.send_local_bidirectional_limit != 0 ||
        manager.config.send_peer_bidirectional_limit != 0 ||
        manager.config.send_unidirectional_limit != 0) {
        ret operation_error(ERROR_STATE);
    }
    if (max_data > varint.MAX || stream_data_bidi_local > varint.MAX ||
        stream_data_bidi_remote > varint.MAX || stream_data_uni > varint.MAX ||
        streams_bidi > MAX_STREAM_COUNT || streams_uni > MAX_STREAM_COUNT) {
        ret operation_error(ERROR_OVERFLOW);
    }
    manager.send_max_data                         = max_data;
    manager.config.local_bidirectional_limit      = streams_bidi;
    manager.config.local_unidirectional_limit     = streams_uni;
    manager.config.send_local_bidirectional_limit = stream_data_bidi_remote;
    manager.config.send_peer_bidirectional_limit  = stream_data_bidi_local;
    manager.config.send_unidirectional_limit      = stream_data_uni;
    manager.peer_limits_applied                   = true;
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

pub fun update_max_stream_data(manager: *Manager, value: Handle, maximum: u64) OperationResult {
    if (!valid_handle(manager, value)) { ret operation_error(ERROR_TOKEN); }
    val stream: *Stream = record(manager, value.index);
    if (!stream.can_send)     { ret operation_error(ERROR_DIRECTION); }
    if (maximum > varint.MAX) { ret operation_error(ERROR_OVERFLOW); }
    if (maximum > stream.send_limit) {
        stream.send_limit     = maximum;
        manager.send_revision = manager.send_revision + 1;
        clear_blocked(manager, value.index, BLOCKED_STREAM);
    }
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

pub fun receive_max_stream_data(manager: *Manager, id: u64, maximum: u64) ReceiveResult {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing ||
        manager.core_lease != 0 || id > varint.MAX) {
        ret receive_error(ERROR_STATE);
    }
    if (maximum > varint.MAX) { ret receive_error(ERROR_OVERFLOW); }
    var index:       usize = stream_index(manager, id);
    var new_streams: usize = 0;
    if (index == manager.storage.stream_capacity) {
        if (previously_opened(manager, id)) {
            if (!id_can_send(manager, id)) { ret receive_error(ERROR_DIRECTION); }
            var closed: ReceiveResult;
            closed.ok     = true;
            closed.closed = true;
            ret closed;
        }
        if (local_initiator(manager, id) || unidirectional(id)) { ret receive_error(ERROR_DIRECTION); }
        var needed: u64 = 0;
        val code:   u8  = peer_preflight(manager, id, ?needed);
        if (code != ERROR_NONE) { ret receive_error(code); }
        val before:  usize        = manager.active_streams;
        val created: CreateResult = peer_open(manager, id);
        if (created.status != STATUS_OK) { ret receive_error(created.error); }
        index       = created.handle.index;
        new_streams = manager.active_streams - before;
    }
    val stream: *Stream = record(manager, index);
    if (!stream.can_send) { ret receive_error(ERROR_DIRECTION); }
    if (maximum > stream.send_limit) {
        stream.send_limit = maximum;
        clear_blocked(manager, index, BLOCKED_STREAM);
    }
    var result: ReceiveResult;
    result.ok          = true;
    result.handle      = handle(manager, index);
    result.new_streams = new_streams;
    ret result;
}

pub fun update_max_streams(manager: *Manager, direction: u8, maximum: u64) OperationResult {
    if (!manager_record_valid(manager) || !manager.valid ||
        manager.core_lease != 0) { ret operation_error(ERROR_STATE); }
    if (maximum > MAX_STREAM_COUNT) { ret operation_error(ERROR_OVERFLOW); }
    if (direction == DIRECTION_BIDIRECTIONAL) {
        if (maximum > manager.config.local_bidirectional_limit) { manager.config.local_bidirectional_limit = maximum; }
    }
    or (direction == DIRECTION_UNIDIRECTIONAL) {
        if (maximum > manager.config.local_unidirectional_limit) { manager.config.local_unidirectional_limit = maximum; }
    }
    or { ret operation_error(ERROR_DIRECTION); }
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

pub fun write(manager: *Manager, value: Handle, data: *u8, length: usize) WriteResult {
    var result: WriteResult;
    val input:  ownership.Range = ownership.bytes(data, length,
        ownership.ZERO_ALLOWED);
    if (!valid_handle(manager, value) || manager.closing ||
        !borrowed_disjoint(manager, input)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    val stream: *Stream = record(manager, value.index);
    if (!stream.can_send) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_DIRECTION;
        ret result;
    }
    if (stream.send_cancelled || stream.stop_received) {
        result.status = STATUS_CANCELLED;
        result.error  = ERROR_CANCELLED;
        ret result;
    }
    if (stream.send_finished || stream.send_closed) {
        result.status = STATUS_FINISHED;
        ret result;
    }
    val buffered:          u64   = stream.send_write - stream.send_base;
    var storage_allowance: usize = 0;
    if (buffered < manager.storage.send_buffer_limit::u64) {
        storage_allowance = manager.storage.send_buffer_limit - buffered::usize;
    }
    var stream_allowance: u64 = 0;
    if (stream.send_write < stream.send_limit) { stream_allowance = stream.send_limit - stream.send_write; }
    var connection_allowance: u64 = 0;
    if (manager.send_committed < manager.send_max_data) { connection_allowance = manager.send_max_data - manager.send_committed; }
    var count: usize = minimum_size(length, storage_allowance);
    if (count::u64 > stream_allowance)               { count = stream_allowance::usize; }
    if (count::u64 > connection_allowance)           { count = connection_allowance::usize; }
    if (count::u64 > varint.MAX - stream.send_write) { count = (varint.MAX - stream.send_write)::usize; }
    # bytes go into chunks taken on demand; a refused chunk ends the write there
    val wanted:      usize         = count;
    var chunk_short: bool          = false;
    var written:     usize         = 0;
    var from:        ranges.Source = source(manager, pool.SEND);
    for (written < wanted) {
        val offset: u64          = stream.send_write + written::u64;
        val slot:   *chunks.Slot = chunks.ensure(?stream.send.chunks, ?from, offset);
        if (slot == nil) {
            chunk_short = true;
            brk;
        }
        val start: usize = (offset % pool.CHUNK::u64)::usize;
        var span:  usize = pool.CHUNK - start;
        if (span > wanted - written) { span = wanted - written; }
        memory.copy[u8](?slot.data[start], ?data[written], span);
        written = written + span;
    }
    count = written;
    if (count > 0) { manager.send_revision = manager.send_revision + 1; }
    if (count < length) {
        var causes: u8 = 0;
        if (stream_allowance <= count::u64)            { causes = causes | BLOCKED_STREAM; }
        if (connection_allowance <= count::u64)        { causes = causes | BLOCKED_CONNECTION; }
        if (chunk_short || storage_allowance <= count) { causes = causes | BLOCKED_STORAGE; }
        note_blocked(manager, value.index, causes);
    }
    stream.send_write         = stream.send_write + count::u64;
    manager.send_committed    = manager.send_committed + count::u64;
    result.count              = count;
    result.connection_blocked = count < length && connection_allowance <= count::u64;
    result.stream_blocked     = count < length && stream_allowance <= count::u64;
    result.storage_blocked    = count < length && (chunk_short || storage_allowance <= count);
    if (count == length) { result.status = STATUS_OK; }
    or                   { result.status = STATUS_BLOCKED; }
    ret result;
}

pub fun finish(manager: *Manager, value: Handle) OperationResult {
    if (!valid_handle(manager, value) || manager.closing) { ret operation_error(ERROR_TOKEN); }
    val stream: *Stream = record(manager, value.index);
    if (!stream.can_send)                              { ret operation_error(ERROR_DIRECTION); }
    if (stream.send_cancelled || stream.stop_received) { ret operation_error(ERROR_CANCELLED); }
    if (!stream.send_finished) {
        stream.send_finished  = true;
        stream.fin_pending    = true;
        manager.send_revision = manager.send_revision + 1;
    }
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

fun cancel_send_inner(stream: *Stream, error_code: u64) {
    stream.send_cancelled = true;
    stream.send_error     = error_code;
    stream.reset_pending  = !stream.reset_acked;
    stream.fin_pending    = false;
}

pub fun cancel_send(manager: *Manager, value: Handle, error_code: u64) OperationResult {
    if (!valid_handle(manager, value)) { ret operation_error(ERROR_TOKEN); }
    if (error_code > varint.MAX)       { ret operation_error(ERROR_OVERFLOW); }
    val stream: *Stream = record(manager, value.index);
    if (!stream.can_send) { ret operation_error(ERROR_DIRECTION); }
    if (!stream.send_closed && !stream.send_cancelled) {
        cancel_send_inner(stream, error_code);
        manager.send_revision = manager.send_revision + 1;
    }
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

fun grant_connection(manager: *Manager, count: u64) {
    manager.receive_max_data = minimum(varint.MAX, manager.receive_max_data + minimum(count, varint.MAX - manager.receive_max_data));
    if (manager.receive_max_data > manager.receive_advertised) {
        manager.max_data_pending = true;
        manager.send_revision    = manager.send_revision + 1;
    }
}

fun release_credit(manager: *Manager, stream: *Stream, count: u64) {
    grant_connection(manager, count);
    if (!stream.final_known) {
        stream.receive_limit = minimum(varint.MAX,
            stream.receive_limit + minimum(count, varint.MAX - stream.receive_limit));
        if (stream.receive_limit > stream.receive_advertised) {
            stream.max_stream_data_pending = true;
            manager.send_revision          = manager.send_revision + 1;
        }
    }
}

fun reconcile_uncredited(manager: *Manager, stream: *Stream) {
    if (stream.receive_uncredited == 0) { ret; }
    grant_connection(manager, stream.receive_uncredited);
    stream.receive_uncredited = 0;
}

fun clear_receive(manager: *Manager, index: usize) {
    buffer_release(manager, ?record(manager, index).receive, pool.RECEIVE);
}

pub fun cancel_receive(manager: *Manager, value: Handle, error_code: u64) OperationResult {
    if (!valid_handle(manager, value)) { ret operation_error(ERROR_TOKEN); }
    if (error_code > varint.MAX)       { ret operation_error(ERROR_OVERFLOW); }
    val stream: *Stream = record(manager, value.index);
    if (!stream.can_receive) { ret operation_error(ERROR_DIRECTION); }
    if (!stream.receive_closed && !stream.receive_cancelled) {
        val discarded: u64 = stream.receive_highest - stream.receive_read;
        grant_connection(manager, discarded);
        reconcile_uncredited(manager, stream);
        stream.receive_read = stream.receive_highest;
        clear_receive(manager, value.index);
        stream.receive_cancelled = true;
        stream.receive_error     = error_code;
        stream.stop_pending      = true;
        manager.send_revision    = manager.send_revision + 1;
    }
    var result: OperationResult;
    result.status           = STATUS_OK;
    result.receive_max_data = manager.receive_max_data;
    ret result;
}

fun attempt_token(manager: *Manager, index: usize) AttemptToken {
    var value: AttemptToken;
    value.source     = manager.config.source;
    value.index      = index;
    value.generation = attempt_at(manager, index).generation;
    ret value;
}

fun valid_attempt(manager: *Manager, value: AttemptToken, state: u8) bool {
    if (!manager_record_valid(manager) || !manager.valid || value.source != manager.config.source ||
        value.index >= manager.storage.attempt_capacity) { ret false; }
    val attempt: *Attempt = attempt_at(manager, value.index);
    ret attempt != nil && attempt.generation == value.generation && attempt.state == state;
}

fun free_attempt(manager: *Manager, index: usize) {
    val attempt: *Attempt = attempt_at(manager, index);
    attempt.state      = ATTEMPT_FREE;
    attempt.generation = 0;
    if (manager.attempts_live > 0) { manager.attempts_live = manager.attempts_live - 1; }
    if (manager.attempts_live == 0 && manager.attempt_block.data != nil) {
        var from: ranges.Source = record_source(manager);
        chunks.give_block(?from, ?manager.attempt_block);
    }
}

fun prepared_error(status: u8, code: u8) Prepared {
    var result: Prepared;
    result.status = status;
    result.error  = code;
    ret result;
}

pub fun prepare_control(manager: *Manager) Prepared {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing ||
        manager.core_lease != 0) {
        ret prepared_error(STATUS_ERROR, ERROR_STATE);
    }
    if (manager.control_prepared) {
        ret prepared_error(STATUS_BLOCKED, ERROR_CAPACITY);
    }
    var kind:         u8    = 0;
    var maximum:      u64   = 0;
    var stream_index: usize = manager.storage.stream_capacity;
    if (manager.max_data_pending) {
        kind    = SEND_MAX_DATA;
        maximum = manager.receive_max_data;
    }
    or {
        var i: usize = 0;
        for (i < manager.storage.stream_capacity) {
            val stream: *Stream = live(manager, i);
            if (stream != nil && stream.max_stream_data_pending) {
                kind         = SEND_MAX_STREAM_DATA;
                maximum      = stream.receive_limit;
                stream_index = i;
                brk;
            }
            i = i + 1;
        }
    }
    if (kind == 0 && manager.max_streams_bidi_pending) {
        kind    = SEND_MAX_STREAMS_BIDI;
        maximum = manager.config.peer_bidirectional_limit;
    }
    if (kind == 0 && manager.max_streams_uni_pending) {
        kind    = SEND_MAX_STREAMS_UNI;
        maximum = manager.config.peer_unidirectional_limit;
    }
    if (kind == 0) {
        var empty: Prepared;
        empty.status = STATUS_EMPTY;
        ret empty;
    }
    val attempt_index: usize = free_attempt_index(manager);
    if (attempt_index == manager.storage.attempt_capacity) {
        ret prepared_error(STATUS_BLOCKED, ERROR_CAPACITY);
    }
    val attempt: *Attempt = occupy_attempt(manager, attempt_index);
    if (attempt == nil) { ret prepared_error(STATUS_BLOCKED, ERROR_STORAGE); }
    attempt.stream_index      = stream_index;
    attempt.stream_generation = 0;
    if (stream_index < manager.storage.stream_capacity) {
        attempt.stream_generation = record(manager, stream_index).generation;
    }
    attempt.maximum          = maximum;
    attempt.kind             = kind;
    attempt.state            = ATTEMPT_RESERVED;
    manager.control_prepared = true;
    var result: Prepared;
    result.ok      = true;
    result.status  = STATUS_OK;
    result.token   = attempt_token(manager, attempt_index);
    result.kind    = kind;
    result.maximum = maximum;
    if (stream_index < manager.storage.stream_capacity) {
        result.handle = handle(manager, stream_index);
    }
    ret result;
}

# the end of the published data attempt of stream `index` that covers
# `offset`, or `offset` when none does
fun inflight_end(manager: *Manager, index: usize, offset: u64) u64 {
    var i: usize = 0;
    for (i < manager.storage.attempt_capacity) {
        val attempt: *Attempt = attempt_at(manager, i);
        if (attempt != nil && attempt.state == ATTEMPT_ACTIVE && attempt.kind == SEND_STREAM &&
            attempt.stream_index == index && attempt.length > 0 &&
            attempt.offset <= offset && offset < attempt.offset + attempt.length::u64) {
            ret attempt.offset + attempt.length::u64;
        }
        i = i + 1;
    }
    ret offset;
}

# the nearest start of a published data attempt of stream `index` after
# `offset`, capped at `limit`
fun next_inflight_start(manager: *Manager, index: usize, offset: u64, limit: u64) u64 {
    var nearest: u64   = limit;
    var i:       usize = 0;
    for (i < manager.storage.attempt_capacity) {
        val attempt: *Attempt = attempt_at(manager, i);
        if (attempt != nil && attempt.state == ATTEMPT_ACTIVE && attempt.kind == SEND_STREAM &&
            attempt.stream_index == index && attempt.length > 0 &&
            attempt.offset > offset && attempt.offset < nearest) {
            nearest = attempt.offset;
        }
        i = i + 1;
    }
    ret nearest;
}

pub fun prepare(manager: *Manager, value: Handle, maximum_bytes: usize, probe: bool) Prepared {
    if (!valid_handle(manager, value) || manager.closing ||
        manager.core_lease != 0) { ret prepared_error(STATUS_ERROR, ERROR_TOKEN); }
    val stream: *Stream = record(manager, value.index);
    if (stream.has_prepared) { ret prepared_error(STATUS_BLOCKED, ERROR_CAPACITY); }
    val attempt_index: usize = free_attempt_index(manager);
    if (attempt_index == manager.storage.attempt_capacity) { ret prepared_error(STATUS_BLOCKED, ERROR_CAPACITY); }
    var kind:        u8    = 0;
    var offset:      u64   = 0;
    var length:      usize = 0;
    var include_fin: bool  = false;
    var chunk:       pool.Ref;
    var data:        *u8   = nil;
    if ((stream.reset_pending || (probe && stream.reset_inflight > 0 && !stream.reset_acked)) &&
        stream.reset_inflight < 255) {
        kind = SEND_RESET;
    }
    or (!stream.reset_received &&
        (stream.stop_pending || (probe && stream.stop_inflight > 0 && !stream.stop_acked)) &&
        stream.stop_inflight < 255) {
        kind = SEND_STOP;
    }
    or (!stream.send_cancelled && stream.can_send && maximum_bytes > 0) {
        # the first byte neither acknowledged nor, unless probing, in flight
        var cursor: u64 = ranges.gap_start(?stream.send.ranges, stream.send_base,
            stream.send_write);
        if (!probe) {
            var hops: usize = 0;
            for (cursor < stream.send_write && hops <= manager.storage.attempt_capacity) {
                val covered: u64 = inflight_end(manager, value.index, cursor);
                if (covered == cursor) { brk; }
                cursor = ranges.gap_start(?stream.send.ranges, covered, stream.send_write);
                hops   = hops + 1;
            }
        }
        if (cursor < stream.send_write) {
            var limit: u64 = ranges.gap_end(?stream.send.ranges, cursor, stream.send_write);
            if (!probe) { limit = next_inflight_start(manager, value.index, cursor, limit); }
            val room: u64 = chunks.room(cursor);
            if (limit - cursor > room) { limit = cursor + room; }
            val slot: *chunks.Slot = chunks.find(?stream.send.chunks, chunks.number_of(cursor));
            if (slot != nil) {
                offset      = cursor;
                length      = minimum_size(maximum_bytes, (limit - cursor)::usize);
                kind        = SEND_STREAM;
                chunk       = slot.ref;
                data        = ?slot.data[(cursor % pool.CHUNK::u64)::usize];
                include_fin = offset + length::u64 == stream.send_write && stream.send_finished &&
                    !stream.fin_acked && stream.fin_inflight < 255 && (stream.fin_pending || probe);
            }
        }
        or (stream.send_finished && !stream.fin_acked &&
            (stream.fin_pending || (probe && stream.fin_inflight > 0)) && stream.fin_inflight < 255) {
            kind        = SEND_STREAM;
            offset      = stream.send_write;
            include_fin = true;
        }
    }
    if (kind == 0) {
        var empty: Prepared;
        empty.status = STATUS_EMPTY;
        ret empty;
    }
    val attempt: *Attempt = occupy_attempt(manager, attempt_index);
    if (attempt == nil) { ret prepared_error(STATUS_BLOCKED, ERROR_STORAGE); }
    attempt.stream_index      = value.index;
    attempt.stream_generation = value.generation;
    attempt.offset            = offset;
    attempt.length            = length;
    attempt.chunk             = chunk;
    attempt.kind              = kind;
    attempt.fin               = include_fin;
    attempt.state             = ATTEMPT_RESERVED;
    stream.has_prepared       = true;
    var result: Prepared;
    result.ok     = true;
    result.status = STATUS_OK;
    result.token  = attempt_token(manager, attempt_index);
    result.handle = value;
    result.kind   = kind;
    result.offset = offset;
    result.fin    = include_fin;
    if (kind == SEND_STREAM && length > 0) {
        result.data.data = data;
        result.data.len  = length;
    }
    if (kind == SEND_RESET) {
        result.final_size        = stream.send_write;
        result.application_error = stream.send_error;
    }
    if (kind == SEND_STOP) { result.application_error = stream.receive_error; }
    ret result;
}

pub fun cancel_prepared(manager: *Manager, prepared: Prepared) OperationResult {
    if (!manager_record_valid(manager) || manager.core_lease != 0 ||
        !prepared.ok || !valid_attempt(manager, prepared.token, ATTEMPT_RESERVED)) {
        var stale: OperationResult = operation_error(ERROR_TOKEN);
        stale.status = STATUS_STALE;
        ret stale;
    }
    val attempt: Attempt = @attempt_at(manager, prepared.token.index);
    if (attempt.kind >= SEND_MAX_DATA && attempt.kind <= SEND_MAX_STREAMS_UNI) {
        if (!manager.control_prepared) { ret operation_error(ERROR_STATE); }
        manager.control_prepared = false;
        free_attempt(manager, prepared.token.index);
        var cancelled: OperationResult;
        cancelled.status = STATUS_OK;
        ret cancelled;
    }
    if (attempt.stream_index < manager.storage.stream_capacity) {
        val stream: *Stream = record(manager, attempt.stream_index);
        if (stream.active && stream.generation == attempt.stream_generation) { stream.has_prepared = false; }
    }
    free_attempt(manager, prepared.token.index);
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

pub fun publish(manager: *Manager, prepared: Prepared) OperationResult {
    if (!manager_record_valid(manager) || manager.core_lease != 0) {
        ret operation_error(ERROR_STATE);
    }
    if (!prepared.ok || !valid_attempt(manager, prepared.token, ATTEMPT_RESERVED)) {
        var stale: OperationResult = operation_error(ERROR_TOKEN);
        stale.status = STATUS_STALE;
        ret stale;
    }
    val attempt: *Attempt = attempt_at(manager, prepared.token.index);
    if (attempt.kind >= SEND_MAX_DATA && attempt.kind <= SEND_MAX_STREAMS_UNI) {
        if (!manager.control_prepared) { ret operation_error(ERROR_STATE); }
        if (attempt.kind == SEND_MAX_STREAM_DATA) {
            if (attempt.stream_index >= manager.storage.stream_capacity) {
                ret operation_error(ERROR_TOKEN);
            }
            val controlled: *Stream = record(manager, attempt.stream_index);
            if (!controlled.active ||
                controlled.generation != attempt.stream_generation) {
                ret operation_error(ERROR_TOKEN);
            }
            controlled.max_stream_data_pending = false;
            controlled.active_attempts         = controlled.active_attempts + 1;
        }
        if (attempt.kind == SEND_MAX_DATA) { manager.max_data_pending = false; }
        if (attempt.kind == SEND_MAX_STREAMS_BIDI) {
            manager.max_streams_bidi_pending = false;
        }
        if (attempt.kind == SEND_MAX_STREAMS_UNI) {
            manager.max_streams_uni_pending = false;
        }
        manager.control_prepared = false;
        manager.active_attempts  = manager.active_attempts + 1;
        attempt.state            = ATTEMPT_ACTIVE;
        var published: OperationResult;
        published.status = STATUS_OK;
        ret published;
    }
    if (attempt.stream_index >= manager.storage.stream_capacity) { ret operation_error(ERROR_TOKEN); }
    val stream: *Stream = record(manager, attempt.stream_index);
    if (!stream.active || stream.generation != attempt.stream_generation || !stream.has_prepared) {
        ret operation_error(ERROR_TOKEN);
    }
    if (attempt.kind == SEND_STREAM) {
        # bytes acknowledged and reclaimed while this attempt was reserved no
        # longer own their ring slots, which may already hold the next lap.
        # the attempt keeps only the offsets that are still live, and an
        # in-flight count keeps those from being reclaimed until it settles
        if (attempt.offset < stream.send_base) {
            var reclaimed: u64 = stream.send_base - attempt.offset;
            if (reclaimed > attempt.length::u64) { reclaimed = attempt.length::u64; }
            attempt.offset = attempt.offset + reclaimed;
            attempt.length = attempt.length - reclaimed::usize;
        }
        # the chunk cannot have been reclaimed while any of its offsets are
        # still above send_base, so a surviving length still has its chunk
        if (attempt.length > 0 && !pool.retain(manager.storage.chunks, attempt.chunk)) {
            attempt.length = 0;
        }
        if (attempt.fin) {
            stream.fin_pending  = false;
            stream.fin_inflight = stream.fin_inflight + 1;
        }
    }
    or (attempt.kind == SEND_RESET) {
        stream.reset_pending  = false;
        stream.reset_inflight = stream.reset_inflight + 1;
    }
    or {
        stream.stop_pending  = false;
        stream.stop_inflight = stream.stop_inflight + 1;
    }
    stream.has_prepared     = false;
    stream.active_attempts  = stream.active_attempts + 1;
    manager.active_attempts = manager.active_attempts + 1;
    attempt.state           = ATTEMPT_ACTIVE;
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

fun reclaim_send(manager: *Manager, index: usize) {
    val stream: *Stream       = record(manager, index);
    var from:   ranges.Source = source(manager, pool.SEND);
    var base:   u64           = ranges.covered_from(?stream.send.ranges, stream.send_base);
    if (base > stream.send_write) { base = stream.send_write; }
    stream.send_base = base;
    ranges.drop_prefix(?stream.send.ranges, stream.send_base, ?from);
    if (stream.reset_acked && stream.active_attempts == 0) {
        stream.send_base = stream.send_write;
        ranges.clear(?stream.send.ranges, ?from);
    }
    chunks.release_consumed(?stream.send.chunks, ?from, stream.send_base,
        stream.send_base == stream.send_write);
    if (stream.send_write - stream.send_base < manager.storage.send_buffer_limit::u64) {
        clear_blocked(manager, index, BLOCKED_STORAGE);
    }
    if (stream.fin_acked && stream.send_base == stream.send_write) { stream.send_closed = true; }
    if (stream.reset_acked && stream.active_attempts == 0)         { stream.send_closed = true; }
}

pub fun on_terminal(manager: *Manager, value: AttemptToken, terminal: u8) OperationResult {
    if (!manager_record_valid(manager) || manager.core_lease != 0 ||
        !valid_attempt(manager, value, ATTEMPT_ACTIVE) ||
        (terminal != TERMINAL_ACKED && terminal != TERMINAL_LOST)) {
        var stale: OperationResult = operation_error(ERROR_TOKEN);
        stale.status = STATUS_STALE;
        ret stale;
    }
    val attempt: Attempt = @attempt_at(manager, value.index);
    if (attempt.kind >= SEND_MAX_DATA && attempt.kind <= SEND_MAX_STREAMS_UNI) {
        if (attempt.kind == SEND_MAX_DATA) {
            if (terminal == TERMINAL_ACKED &&
                attempt.maximum > manager.receive_advertised) {
                manager.receive_advertised = attempt.maximum;
            }
            manager.max_data_pending =
                manager.receive_max_data > manager.receive_advertised;
        }
        if (attempt.kind == SEND_MAX_STREAM_DATA) {
            if (attempt.stream_index >= manager.storage.stream_capacity) {
                ret operation_error(ERROR_TOKEN);
            }
            val controlled: *Stream = record(manager, attempt.stream_index);
            if (!controlled.active ||
                controlled.generation != attempt.stream_generation) {
                ret operation_error(ERROR_TOKEN);
            }
            if (terminal == TERMINAL_ACKED &&
                attempt.maximum > controlled.receive_advertised) {
                controlled.receive_advertised = attempt.maximum;
            }
            controlled.max_stream_data_pending =
                controlled.receive_limit > controlled.receive_advertised;
            if (controlled.active_attempts > 0) {
                controlled.active_attempts = controlled.active_attempts - 1;
            }
        }
        if (attempt.kind == SEND_MAX_STREAMS_BIDI) {
            if (terminal == TERMINAL_ACKED &&
                attempt.maximum > manager.peer_bidi_advertised) {
                manager.peer_bidi_advertised = attempt.maximum;
            }
            manager.max_streams_bidi_pending =
                manager.config.peer_bidirectional_limit >
                manager.peer_bidi_advertised;
        }
        if (attempt.kind == SEND_MAX_STREAMS_UNI) {
            if (terminal == TERMINAL_ACKED &&
                attempt.maximum > manager.peer_uni_advertised) {
                manager.peer_uni_advertised = attempt.maximum;
            }
            manager.max_streams_uni_pending =
                manager.config.peer_unidirectional_limit >
                manager.peer_uni_advertised;
        }
        if (manager.active_attempts > 0) {
            manager.active_attempts = manager.active_attempts - 1;
        }
        free_attempt(manager, value.index);
        var completed: OperationResult;
        completed.status = STATUS_OK;
        ret completed;
    }
    if (attempt.stream_index >= manager.storage.stream_capacity) { ret operation_error(ERROR_TOKEN); }
    val stream: *Stream = record(manager, attempt.stream_index);
    if (!stream.active || stream.generation != attempt.stream_generation) { ret operation_error(ERROR_TOKEN); }
    if (attempt.kind == SEND_STREAM) {
        if (attempt.length > 0) {
            pool.settle(manager.storage.chunks, attempt.chunk);
            # an acknowledgement is recorded above send_base only. a refused
            # record just means those bytes are sent again, never lost
            var start: u64 = attempt.offset;
            val end:   u64 = attempt.offset + attempt.length::u64;
            if (start < stream.send_base) { start = stream.send_base; }
            if (terminal == TERMINAL_ACKED && start < end) {
                var from: ranges.Source = source(manager, pool.SEND);
                if (ranges.insert(?stream.send.ranges, start, end, ?from) != ranges.STATUS_OK) {
                    manager.ack_record_refusals = manager.ack_record_refusals + 1;
                }
            }
        }
        if (attempt.fin) {
            if (stream.fin_inflight > 0) { stream.fin_inflight = stream.fin_inflight - 1; }
            if (terminal == TERMINAL_ACKED) {
                stream.fin_acked   = true;
                stream.fin_pending = false;
            }
            or (!stream.fin_acked && stream.fin_inflight == 0 && !stream.send_cancelled) {
                stream.fin_pending = true;
            }
        }
    }
    or (attempt.kind == SEND_RESET) {
        if (stream.reset_inflight > 0) { stream.reset_inflight = stream.reset_inflight - 1; }
        if (terminal == TERMINAL_ACKED) {
            stream.reset_acked   = true;
            stream.reset_pending = false;
        }
        or (!manager.closing && !stream.reset_acked && stream.reset_inflight == 0) {
            stream.reset_pending = true;
        }
    }
    or {
        if (stream.stop_inflight > 0) { stream.stop_inflight = stream.stop_inflight - 1; }
        if (terminal == TERMINAL_ACKED) {
            stream.stop_acked   = true;
            stream.stop_pending = false;
        }
        or (!manager.closing && !stream.reset_received && !stream.stop_acked && stream.stop_inflight == 0) {
            stream.stop_pending = true;
        }
    }
    if (stream.active_attempts > 0)  { stream.active_attempts = stream.active_attempts - 1; }
    if (manager.active_attempts > 0) { manager.active_attempts = manager.active_attempts - 1; }
    free_attempt(manager, value.index);
    reclaim_send(manager, attempt.stream_index);
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

fun receive_error(code: u8) ReceiveResult {
    var result: ReceiveResult;
    result.error = code;
    ret result;
}

fun peer_preflight(manager: *Manager, id: u64, needed: *u64) u8 {
    if (id > varint.MAX || local_initiator(manager, id)) { ret ERROR_DIRECTION; }
    val uni:     bool = unidirectional(id);
    val ordinal: u64  = id >> 2;
    var opened:  u64  = manager.peer_bidirectional_opened;
    var limit:   u64  = manager.config.peer_bidirectional_limit;
    if (uni) {
        opened = manager.peer_unidirectional_opened;
        limit  = manager.config.peer_unidirectional_limit;
    }
    if (ordinal >= limit || ordinal < opened) { ret ERROR_STREAM_LIMIT; }
    needed[0] = ordinal + 1 - opened;
    if (needed[0] > manager.storage.stream_capacity::u64 - manager.active_streams::u64) { ret ERROR_CAPACITY; }
    ret ERROR_NONE;
}

pub fun receive_stream_data_blocked(manager: *Manager, id: u64, maximum: u64) ReceiveResult {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing ||
        manager.core_lease != 0 || id > varint.MAX) {
        ret receive_error(ERROR_STATE);
    }
    if (maximum > varint.MAX) { ret receive_error(ERROR_OVERFLOW); }
    var index:       usize = stream_index(manager, id);
    var new_streams: usize = 0;
    if (index == manager.storage.stream_capacity) {
        if (previously_opened(manager, id)) {
            if (!id_can_receive(manager, id)) { ret receive_error(ERROR_DIRECTION); }
            var closed: ReceiveResult;
            closed.ok     = true;
            closed.closed = true;
            ret closed;
        }
        var needed: u64 = 0;
        val code:   u8  = peer_preflight(manager, id, ?needed);
        if (code != ERROR_NONE) { ret receive_error(code); }
        val before:  usize        = manager.active_streams;
        val created: CreateResult = peer_open(manager, id);
        if (created.status != STATUS_OK) { ret receive_error(created.error); }
        index       = created.handle.index;
        new_streams = manager.active_streams - before;
    }
    val stream: Stream = @record(manager, index);
    if (!stream.can_receive) { ret receive_error(ERROR_DIRECTION); }
    var result: ReceiveResult;
    result.ok                      = true;
    result.handle                  = handle(manager, index);
    result.new_streams             = new_streams;
    result.receive_max_stream_data = stream.receive_limit;
    ret result;
}

pub fun receive_data_blocked(manager: *Manager, maximum: u64) OperationResult {
    if (!manager_record_valid(manager) || !manager.valid ||
        manager.core_lease != 0) { ret operation_error(ERROR_STATE); }
    if (maximum > varint.MAX) { ret operation_error(ERROR_OVERFLOW); }
    var result: OperationResult;
    result.status           = STATUS_OK;
    result.receive_max_data = manager.receive_max_data;
    ret result;
}

pub fun receive_streams_blocked(manager: *Manager, direction: u8, maximum: u64) OperationResult {
    if (!manager_record_valid(manager) || !manager.valid ||
        manager.core_lease != 0) { ret operation_error(ERROR_STATE); }
    if (maximum > MAX_STREAM_COUNT) { ret operation_error(ERROR_OVERFLOW); }
    var result: OperationResult;
    result.status = STATUS_OK;
    if (direction == DIRECTION_BIDIRECTIONAL) {
        result.peer_max_streams = manager.config.peer_bidirectional_limit;
    }
    or (direction == DIRECTION_UNIDIRECTIONAL) {
        result.peer_max_streams = manager.config.peer_unidirectional_limit;
    }
    or { ret operation_error(ERROR_DIRECTION); }
    ret result;
}

pub fun receive_stream(manager: *Manager, id: u64, offset: u64, data: *u8,
    length: usize, fin: bool) ReceiveResult {
    val input: ownership.Range = ownership.bytes(data, length,
        ownership.ZERO_ALLOWED);
    if (!manager_record_valid(manager) || !manager.valid || manager.closing ||
        manager.core_lease != 0 || id > varint.MAX ||
        !borrowed_disjoint(manager, input)) {
        ret receive_error(ERROR_STATE);
    }
    if (offset > varint.MAX || length::u64 > varint.MAX - offset) { ret receive_error(ERROR_OVERFLOW); }
    var index:       usize = stream_index(manager, id);
    val provisional: bool  = index == manager.storage.stream_capacity;
    if (provisional && previously_opened(manager, id)) {
        if (!id_can_receive(manager, id)) { ret receive_error(ERROR_DIRECTION); }
        var closed: ReceiveResult;
        closed.ok     = true;
        closed.closed = true;
        ret closed;
    }
    var needed: u64 = 0;
    if (provisional) {
        val code: u8 = peer_preflight(manager, id, ?needed);
        if (code != ERROR_NONE) { ret receive_error(code); }
    }
    var current_final_known: bool = false;
    var current_final_size:  u64  = 0;
    var current_highest:     u64  = 0;
    var current_read:        u64  = 0;
    var current_limit:       u64  = receive_limit(manager.config, false, unidirectional(id));
    var discarding:          bool = false;
    if (!provisional) {
        val current: Stream = @record(manager, index);
        if (!current.can_receive) { ret receive_error(ERROR_DIRECTION); }
        current_final_known = current.final_known;
        current_final_size  = current.final_size;
        current_highest     = current.receive_highest;
        current_read        = current.receive_read;
        current_limit       = current.receive_limit;
        discarding          = current.receive_cancelled || current.reset_received;
    }
    val ending: u64 = offset + length::u64;
    if (current_final_known && (ending > current_final_size || (fin && ending != current_final_size))) {
        ret receive_error(ERROR_FINAL_SIZE);
    }
    if (fin && current_highest > ending) { ret receive_error(ERROR_FINAL_SIZE); }
    if (ending > current_limit)          { ret receive_error(ERROR_FLOW_CONTROL); }
    var delta: u64 = 0;
    if (ending > current_highest) { delta = ending - current_highest; }
    if (delta > manager.receive_max_data - minimum(manager.receive_committed, manager.receive_max_data)) {
        ret receive_error(ERROR_FLOW_CONTROL);
    }
    var copy_offset: u64   = offset;
    var copy_start:  usize = 0;
    if (copy_offset < current_read) {
        val skipped: u64 = minimum(ending, current_read) - copy_offset;
        copy_offset = copy_offset + skipped;
        copy_start  = skipped::usize;
    }
    val copy_length: usize         = length - copy_start;
    val storing:     bool          = !discarding && copy_length > 0;
    var reserved:    chunks.Reserved;
    var from:        ranges.Source = source(manager, pool.RECEIVE);
    if (storing) {
        if (!provisional) {
            val current: *Stream = record(manager, index);
            # a frame that would fragment the stream past its cap is refused
            # before its packet is acknowledged, so the peer sends it again
            if (ranges.count_after_insert(?current.receive.ranges, copy_offset, ending) >
                current.receive.ranges.cap) {
                manager.receive_storage_refusals = manager.receive_storage_refusals + 1;
                ret receive_error(ERROR_STORAGE);
            }
            if (chunks.conflicts(?current.receive.chunks, ?current.receive.ranges,
                copy_offset, ?data[copy_start], copy_length)) {
                ret receive_error(ERROR_DATA_CONFLICT);
            }
            if (!chunks.reserve(?current.receive.chunks, ?from, copy_offset, copy_length,
                ?reserved)) {
                manager.receive_storage_refusals = manager.receive_storage_refusals + 1;
                ret receive_error(ERROR_STORAGE);
            }
            if (ranges.insert(?current.receive.ranges, copy_offset, ending, ?from) !=
                ranges.STATUS_OK) {
                chunks.cancel(?from, ?reserved);
                manager.receive_storage_refusals = manager.receive_storage_refusals + 1;
                ret receive_error(ERROR_STORAGE);
            }
        }
        or (!chunks.reserve(nil, ?from, copy_offset, copy_length, ?reserved)) {
            manager.receive_storage_refusals = manager.receive_storage_refusals + 1;
            ret receive_error(ERROR_STORAGE);
        }
    }
    var new_streams: usize = 0;
    if (provisional) {
        val before:  usize        = manager.active_streams;
        val created: CreateResult = peer_open(manager, id);
        if (created.status != STATUS_OK) {
            if (storing) { chunks.cancel(?from, ?reserved); }
            ret receive_error(created.error);
        }
        index       = created.handle.index;
        new_streams = manager.active_streams - before;
    }
    val stream: *Stream = record(manager, index);
    if (storing) {
        chunks.commit(?stream.receive.chunks, ?reserved);
        if (provisional) {
            # an empty set takes one interval inline, so this cannot refuse
            ranges.insert(?stream.receive.ranges, copy_offset, ending, ?from);
        }
        chunks.write(?stream.receive.chunks, copy_offset, ?data[copy_start], copy_length);
    }
    if (ending > stream.receive_highest) { stream.receive_highest = ending; }
    manager.receive_committed = manager.receive_committed + delta;
    if (stream.receive_cancelled && delta > 0) {
        grant_connection(manager, delta);
        stream.receive_read = stream.receive_highest;
    }
    if (fin) {
        stream.final_known = true;
        stream.final_size  = ending;
        if (stream.receive_cancelled || stream.receive_read == ending) { stream.receive_closed = true; }
    }
    if (!stream.receive_cancelled && readable_news(stream)) {
        push_ready(manager, index, READY_READABLE);
    }
    var result: ReceiveResult;
    result.ok               = true;
    result.handle           = handle(manager, index);
    result.new_streams      = new_streams;
    result.connection_delta = delta;
    ret result;
}

pub fun receive_reset(manager: *Manager, id: u64, error_code: u64, final_size: u64) ReceiveResult {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing ||
        manager.core_lease != 0 || id > varint.MAX) { ret receive_error(ERROR_STATE); }
    if (error_code > varint.MAX || final_size > varint.MAX) { ret receive_error(ERROR_OVERFLOW); }
    var index:       usize = stream_index(manager, id);
    val provisional: bool  = index == manager.storage.stream_capacity;
    if (provisional && previously_opened(manager, id)) {
        if (!id_can_receive(manager, id)) { ret receive_error(ERROR_DIRECTION); }
        var closed: ReceiveResult;
        closed.ok     = true;
        closed.closed = true;
        ret closed;
    }
    var needed: u64 = 0;
    if (provisional) {
        val code: u8 = peer_preflight(manager, id, ?needed);
        if (code != ERROR_NONE) { ret receive_error(code); }
    }
    var current_final_known: bool = false;
    var current_final_size:  u64  = 0;
    var current_highest:     u64  = 0;
    var current_limit:       u64  = receive_limit(manager.config, false, unidirectional(id));
    if (!provisional) {
        val current: Stream = @record(manager, index);
        if (!current.can_receive) { ret receive_error(ERROR_DIRECTION); }
        current_final_known = current.final_known;
        current_final_size  = current.final_size;
        current_highest     = current.receive_highest;
        current_limit       = current.receive_limit;
    }
    if ((current_final_known && current_final_size != final_size) || current_highest > final_size) {
        ret receive_error(ERROR_FINAL_SIZE);
    }
    if (final_size > current_limit) { ret receive_error(ERROR_FLOW_CONTROL); }
    val delta: u64 = final_size - current_highest;
    if (delta > manager.receive_max_data - minimum(manager.receive_committed, manager.receive_max_data)) {
        ret receive_error(ERROR_FLOW_CONTROL);
    }
    var new_streams: usize = 0;
    if (provisional) {
        val before:  usize        = manager.active_streams;
        val created: CreateResult = peer_open(manager, id);
        if (created.status != STATUS_OK) { ret receive_error(created.error); }
        index       = created.handle.index;
        new_streams = manager.active_streams - before;
    }
    val stream: *Stream = record(manager, index);
    stream.final_known     = true;
    stream.final_size      = final_size;
    stream.receive_highest = final_size;
    if (!stream.reset_received) { stream.receive_error = error_code; }
    stream.reset_received = true;
    stream.stop_pending   = false;
    push_ready(manager, index, READY_RESET);
    manager.receive_committed = manager.receive_committed + delta;
    if (stream.receive_cancelled) {
        grant_connection(manager, delta);
        stream.receive_read   = final_size;
        stream.receive_closed = true;
        clear_receive(manager, index);
    }
    var result: ReceiveResult;
    result.ok               = true;
    result.handle           = handle(manager, index);
    result.new_streams      = new_streams;
    result.connection_delta = delta;
    ret result;
}

pub fun acknowledge_reset(manager: *Manager, value: Handle) OperationResult {
    if (!valid_handle(manager, value)) { ret operation_error(ERROR_TOKEN); }
    val stream: *Stream = record(manager, value.index);
    if (!stream.reset_received) { ret operation_error(ERROR_STATE); }
    val discarded: u64 = stream.final_size - stream.receive_read;
    grant_connection(manager, discarded);
    reconcile_uncredited(manager, stream);
    stream.receive_read   = stream.final_size;
    stream.receive_closed = true;
    clear_receive(manager, value.index);
    var result: OperationResult;
    result.status           = STATUS_OK;
    result.receive_max_data = manager.receive_max_data;
    ret result;
}

pub fun receive_stop(manager: *Manager, id: u64, error_code: u64) ReceiveResult {
    if (!manager_record_valid(manager) || !manager.valid || manager.closing ||
        manager.core_lease != 0 || id > varint.MAX) {
        ret receive_error(ERROR_STATE);
    }
    if (error_code > varint.MAX) { ret receive_error(ERROR_OVERFLOW); }
    var index: usize = stream_index(manager, id);
    if (index == manager.storage.stream_capacity) {
        if (previously_opened(manager, id)) {
            if (!id_can_send(manager, id)) { ret receive_error(ERROR_DIRECTION); }
            var closed: ReceiveResult;
            closed.ok     = true;
            closed.closed = true;
            ret closed;
        }
        if (unidirectional(id)) { ret receive_error(ERROR_DIRECTION); }
        var needed: u64 = 0;
        val code:   u8  = peer_preflight(manager, id, ?needed);
        if (code != ERROR_NONE) { ret receive_error(code); }
        val created: CreateResult = peer_open(manager, id);
        if (created.status != STATUS_OK) { ret receive_error(created.error); }
        index = created.handle.index;
    }
    val stream: *Stream = record(manager, index);
    if (!stream.can_send) { ret receive_error(ERROR_DIRECTION); }
    if (!stream.stop_received && !stream.send_closed) {
        stream.stop_received = true;
        if (!stream.send_cancelled) { cancel_send_inner(stream, error_code); }
        push_ready(manager, index, READY_RESET);
    }
    var result: ReceiveResult;
    result.ok     = true;
    result.handle = handle(manager, index);
    ret result;
}

pub fun read(manager: *Manager, value: Handle, output: *u8, capacity: usize) ReadResult {
    var result:      ReadResult;
    val destination: ownership.Range = ownership.bytes(output, capacity,
        ownership.ZERO_ALLOWED);
    if (!valid_handle(manager, value) ||
        !borrowed_disjoint(manager, destination)) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_TOKEN;
        ret result;
    }
    val stream: *Stream = record(manager, value.index);
    if (!stream.can_receive) {
        result.status = STATUS_ERROR;
        result.error  = ERROR_DIRECTION;
        ret result;
    }
    if (stream.reset_received && !stream.receive_closed) {
        result.status            = STATUS_RESET;
        result.application_error = stream.receive_error;
        result.final_size        = stream.final_size;
        ret result;
    }
    if (stream.receive_cancelled && !stream.receive_closed) {
        result.status            = STATUS_CANCELLED;
        result.application_error = stream.receive_error;
        ret result;
    }
    var available: u64 = ranges.covered_from(?stream.receive.ranges, stream.receive_read) -
        stream.receive_read;
    if (available > capacity::u64) { available = capacity::u64; }
    val count: usize = available::usize;
    if (count > 0) {
        chunks.read(?stream.receive.chunks, stream.receive_read, output, count);
    }
    stream.receive_read = stream.receive_read + count::u64;
    if (count > 0) {
        var from: ranges.Source = source(manager, pool.RECEIVE);
        ranges.drop_prefix(?stream.receive.ranges, stream.receive_read, ?from);
        chunks.release_consumed(?stream.receive.chunks, ?from, stream.receive_read,
            ranges.empty(?stream.receive.ranges));
    }
    stream.receive_uncredited = stream.receive_uncredited + count::u64;
    if (stream.final_known && stream.receive_read == stream.final_size) {
        stream.receive_closed = true;
        result.fin            = true;
    }
    result.count                   = count;
    result.final_size              = stream.final_size;
    result.receive_max_data        = manager.receive_max_data;
    result.receive_max_stream_data = stream.receive_limit;
    result.receive_uncredited      = stream.receive_uncredited;
    if (result.fin) { result.status = STATUS_FINISHED; }
    or (count > 0)  { result.status = STATUS_OK; }
    or              { result.status = STATUS_EMPTY; }
    ret result;
}

pub fun credit(manager: *Manager, value: Handle, count: u64) OperationResult {
    if (!valid_handle(manager, value)) { ret operation_error(ERROR_TOKEN); }
    val stream: *Stream = record(manager, value.index);
    if (!stream.can_receive)               { ret operation_error(ERROR_DIRECTION); }
    if (count > stream.receive_uncredited) { ret operation_error(ERROR_STATE); }
    stream.receive_uncredited = stream.receive_uncredited - count;
    if (count > 0) { release_credit(manager, stream, count); }
    var result: OperationResult;
    result.status                  = STATUS_OK;
    result.receive_max_data        = manager.receive_max_data;
    result.receive_max_stream_data = stream.receive_limit;
    ret result;
}

pub fun snapshot(manager: *Manager, value: Handle) Snapshot {
    var result: Snapshot;
    if (!valid_handle(manager, value)) {
        result.error = ERROR_TOKEN;
        ret result;
    }
    val stream: Stream = @record(manager, value.index);
    result.ok                 = true;
    result.id                 = stream.id;
    result.send_offset        = stream.send_write;
    result.receive_offset     = stream.receive_read;
    result.final_size         = stream.final_size;
    result.send_error         = stream.send_error;
    result.receive_error      = stream.receive_error;
    result.send_closed        = stream.send_closed;
    result.receive_closed     = stream.receive_closed;
    result.send_cancelled     = stream.send_cancelled;
    result.receive_cancelled  = stream.receive_cancelled;
    result.final_known        = stream.final_known;
    result.receive_uncredited = stream.receive_uncredited;
    ret result;
}

pub fun release(manager: *Manager, value: Handle) OperationResult {
    if (!valid_handle(manager, value)) { ret operation_error(ERROR_TOKEN); }
    val stream: *Stream = record(manager, value.index);
    # once the manager is closing no acknowledgement can arrive, so a stream
    # is releasable as soon as nothing of it is still in flight
    val unsettled: bool = stream.active_attempts != 0 || stream.has_prepared;
    if (manager.closing) {
        if (unsettled) { ret operation_error(ERROR_STATE); }
    }
    or {
        if (!stream.send_closed || !stream.receive_closed || unsettled ||
            (stream.stop_received && !stream.reset_acked) || (stream.receive_cancelled && !stream.stop_acked && !stream.reset_received)) {
            ret operation_error(ERROR_STATE);
        }
    }
    val peer: bool = !stream.local;
    val uni:  bool = stream.unidirectional;
    reconcile_uncredited(manager, stream);
    unlink_everywhere(manager, value.index);
    buffer_release(manager, ?stream.send, pool.SEND);
    buffer_release(manager, ?stream.receive, pool.RECEIVE);
    stream.active     = false;
    stream.generation = 0;
    record_dropped(manager, value.index);
    if (manager.active_streams > 0) { manager.active_streams = manager.active_streams - 1; }
    var result: OperationResult;
    result.status = STATUS_OK;
    if (peer) {
        if (uni && manager.config.peer_unidirectional_limit < MAX_STREAM_COUNT) {
            manager.config.peer_unidirectional_limit = manager.config.peer_unidirectional_limit + 1;
            manager.max_streams_uni_pending          = true;
            manager.send_revision                    = manager.send_revision + 1;
            result.peer_max_streams                  = manager.config.peer_unidirectional_limit;
        }
        if (!uni && manager.config.peer_bidirectional_limit < MAX_STREAM_COUNT) {
            manager.config.peer_bidirectional_limit = manager.config.peer_bidirectional_limit + 1;
            manager.max_streams_bidi_pending        = true;
            manager.send_revision                   = manager.send_revision + 1;
            result.peer_max_streams                 = manager.config.peer_bidirectional_limit;
        }
    }
    ret result;
}

pub fun begin_close(manager: *Manager) OperationResult {
    if (!manager_record_valid(manager) || !manager.valid ||
        manager.core_lease != 0) { ret operation_error(ERROR_STATE); }
    manager.closing = true;
    var i: usize = 0;
    for (i < manager.storage.stream_capacity) {
        val stream: *Stream = live(manager, i);
        if (stream != nil) {
            stream.send_cancelled    = true;
            stream.receive_cancelled = true;
        }
        i = i + 1;
    }
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

pub fun finish_close(manager: *Manager) OperationResult {
    if (!manager_record_valid(manager) || !manager.valid || !manager.closing ||
        manager.core_lease != 0) { ret operation_error(ERROR_STATE); }
    if (manager.active_attempts != 0) { ret operation_error(ERROR_CAPACITY); }
    var i: usize = 0;
    for (i < manager.storage.attempt_capacity) {
        if (!attempt_free(manager, i)) { ret operation_error(ERROR_CAPACITY); }
        i = i + 1;
    }
    i = 0;
    for (i < manager.storage.stream_capacity) {
        val stream: *Stream = live(manager, i);
        if (stream != nil) {
            buffer_release(manager, ?stream.send, pool.SEND);
            buffer_release(manager, ?stream.receive, pool.RECEIVE);
            stream.active     = false;
            stream.generation = 0;
            record_dropped(manager, i);
        }
        i = i + 1;
    }
    manager.active_streams = 0;
    manager.ready_head     = NO_STREAM;
    manager.ready_tail     = NO_STREAM;
    manager.blocked_head   = NO_STREAM;
    manager.blocked_tail   = NO_STREAM;
    manager.core_lease     = 0;
    manager.valid          = false;
    var result: OperationResult;
    result.status = STATUS_OK;
    ret result;
}

fun enter_core_scope(manager: *Manager, source: u64) bool {
    if (!manager_record_valid(manager) || source == 0 ||
        manager.core_lease != source) { ret false; }
    manager.core_lease = 0;
    ret true;
}

fun leave_core_scope(manager: *Manager, source: u64) {
    if (manager_record_valid(manager) && manager.valid) {
        manager.core_lease = source;
    }
}

pub fun apply_peer_limits_scoped(manager: *Manager, source: u64, max_data: u64,
    stream_data_bidi_local: u64,
    stream_data_bidi_remote: u64,
    stream_data_uni: u64, streams_bidi: u64,
    streams_uni: u64) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = apply_peer_limits(manager, max_data,
        stream_data_bidi_local, stream_data_bidi_remote, stream_data_uni,
        streams_bidi, streams_uni);
    leave_core_scope(manager, source);
    ret result;
}

pub fun update_max_data_scoped(manager: *Manager, source: u64,
    maximum: u64) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = update_max_data(manager, maximum);
    leave_core_scope(manager, source);
    ret result;
}

pub fun receive_max_stream_data_scoped(manager: *Manager, source: u64,
    id: u64, maximum: u64) ReceiveResult {
    if (!enter_core_scope(manager, source)) { ret receive_error(ERROR_STATE); }
    val result: ReceiveResult = receive_max_stream_data(manager, id, maximum);
    leave_core_scope(manager, source);
    ret result;
}

pub fun update_max_streams_scoped(manager: *Manager, source: u64,
    direction: u8, maximum: u64) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = update_max_streams(manager, direction, maximum);
    leave_core_scope(manager, source);
    ret result;
}

pub fun prepare_control_scoped(manager: *Manager, source: u64) Prepared {
    if (!enter_core_scope(manager, source)) {
        ret prepared_error(STATUS_ERROR, ERROR_STATE);
    }
    val result: Prepared = prepare_control(manager);
    leave_core_scope(manager, source);
    ret result;
}

pub fun prepare_scoped(manager: *Manager, source: u64, value: Handle,
    maximum_bytes: usize, probe: bool) Prepared {
    if (!enter_core_scope(manager, source)) {
        ret prepared_error(STATUS_ERROR, ERROR_STATE);
    }
    val result: Prepared = prepare(manager, value, maximum_bytes, probe);
    leave_core_scope(manager, source);
    ret result;
}

pub fun cancel_prepared_scoped(manager: *Manager, source: u64,
    prepared: Prepared) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = cancel_prepared(manager, prepared);
    leave_core_scope(manager, source);
    ret result;
}

pub fun publish_scoped(manager: *Manager, source: u64,
    prepared: Prepared) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = publish(manager, prepared);
    leave_core_scope(manager, source);
    ret result;
}

pub fun on_terminal_scoped(manager: *Manager, source: u64,
    value: AttemptToken, terminal: u8) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = on_terminal(manager, value, terminal);
    leave_core_scope(manager, source);
    ret result;
}

pub fun receive_stream_data_blocked_scoped(manager: *Manager, source: u64,
    id: u64,
    maximum: u64) ReceiveResult {
    if (!enter_core_scope(manager, source)) { ret receive_error(ERROR_STATE); }
    val result: ReceiveResult = receive_stream_data_blocked(manager, id, maximum);
    leave_core_scope(manager, source);
    ret result;
}

pub fun receive_data_blocked_scoped(manager: *Manager, source: u64,
    maximum: u64) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = receive_data_blocked(manager, maximum);
    leave_core_scope(manager, source);
    ret result;
}

pub fun receive_streams_blocked_scoped(manager: *Manager, source: u64,
    direction: u8,
    maximum: u64) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = receive_streams_blocked(manager, direction,
        maximum);
    leave_core_scope(manager, source);
    ret result;
}

pub fun receive_stream_scoped(manager: *Manager, source: u64, id: u64,
    offset: u64, data: *u8, length: usize,
    fin: bool) ReceiveResult {
    if (!enter_core_scope(manager, source)) { ret receive_error(ERROR_STATE); }
    val result: ReceiveResult = receive_stream(manager, id, offset, data,
        length, fin);
    leave_core_scope(manager, source);
    ret result;
}

pub fun receive_reset_scoped(manager: *Manager, source: u64, id: u64,
    error_code: u64, final_size: u64) ReceiveResult {
    if (!enter_core_scope(manager, source)) { ret receive_error(ERROR_STATE); }
    val result: ReceiveResult = receive_reset(manager, id, error_code,
        final_size);
    leave_core_scope(manager, source);
    ret result;
}

pub fun receive_stop_scoped(manager: *Manager, source: u64, id: u64,
    error_code: u64) ReceiveResult {
    if (!enter_core_scope(manager, source)) { ret receive_error(ERROR_STATE); }
    val result: ReceiveResult = receive_stop(manager, id, error_code);
    leave_core_scope(manager, source);
    ret result;
}

pub fun begin_close_scoped(manager: *Manager, source: u64) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = begin_close(manager);
    leave_core_scope(manager, source);
    ret result;
}

pub fun finish_close_scoped(manager: *Manager, source: u64) OperationResult {
    if (!enter_core_scope(manager, source)) { ret operation_error(ERROR_STATE); }
    val result: OperationResult = finish_close(manager);
    leave_core_scope(manager, source);
    ret result;
}

fun initialized_for_test(config: Config, storage: Storage) Manager {
    var manager: Manager;
    initialize(?manager, config, storage);
    ret manager;
}

test "quic.stream.stream: stream id bits expose ownership and direction" {
    if (initiated_by_server(0))  { ret 1; }
    if (!initiated_by_server(1)) { ret 1; }
    if (!unidirectional(2))      { ret 1; }
    ret 0;
}

var test_memory:  limited.Limited;
var test_chunks:  pool.Pool;
var test_account: pool.Account;

# a pool and account for a stream manager under test
fun test_storage(streams: *Stream, stream_capacity: usize, attempts: *Attempt,
    attempt_capacity: usize) Storage {
    if (!test_chunks.valid) {
        limited.make(?test_memory, 1 << 24);
        var chunk_config: pool.Config = pool.default_config(256);
        chunk_config.trap_misuse = false;
        pool.make(?test_chunks, limited.allocator_of(?test_memory), chunk_config);
        pool.open_account(?test_chunks, ?test_account, 1, 64, 64, 0);
    }
    ret Storage{streams: streams, stream_capacity: stream_capacity,
        attempts: attempts, attempt_capacity: attempt_capacity,
        chunks:   ?test_chunks, account: ?test_account, send_buffer_limit: 4};
}

test "quic.stream.stream: owned regions reject maximum addresses and aliases" {
    var streams:  [1]Stream;
    var attempts: [1]Attempt;
    var config:   Config;
    config.source                            = 93;
    config.role                              = ROLE_CLIENT;
    config.local_bidirectional_limit         = 1;
    config.local_unidirectional_limit        = 1;
    config.peer_bidirectional_limit          = 1;
    config.peer_unidirectional_limit         = 1;
    config.send_max_data                     = 4;
    config.receive_max_data                  = 4;
    config.send_local_bidirectional_limit    = 4;
    config.send_peer_bidirectional_limit     = 4;
    config.send_unidirectional_limit         = 4;
    config.receive_local_bidirectional_limit = 4;
    config.receive_peer_bidirectional_limit  = 4;
    config.receive_unidirectional_limit      = 4;
    val maximum: usize   = 0 - 1::usize;
    val sound:   Storage = test_storage(?streams[0], 1, ?attempts[0], 1);
    if (initialize(maximum::*Manager, config, sound) ||
        initialize((?streams[0])::*Manager, config, sound)) { ret 1; }
    var hostile_storage: Storage = sound;
    hostile_storage.streams = maximum::*Stream;
    val hostile:         Manager = initialized_for_test(config, hostile_storage);
    var aliased_storage: Storage = sound;
    aliased_storage.attempts = (?streams[0])::*Attempt;
    val aliased:          Manager = initialized_for_test(config, aliased_storage);
    var poolless_storage: Storage = sound;
    poolless_storage.chunks = nil;
    val poolless: Manager = initialized_for_test(config, poolless_storage);
    if (hostile.valid || aliased.valid || poolless.valid) { ret 1; }
    ret 0;
}

test "quic.stream.stream: authenticated peer limits bind from exact zero once" {
    var streams:  [1]Stream;
    var attempts: [1]Attempt;
    var config:   Config;
    config.source                            = 94;
    config.role                              = ROLE_CLIENT;
    config.peer_bidirectional_limit          = 1;
    config.peer_unidirectional_limit         = 1;
    config.receive_max_data                  = 4;
    config.receive_local_bidirectional_limit = 4;
    config.receive_peer_bidirectional_limit  = 4;
    config.receive_unidirectional_limit      = 4;
    var manager: Manager = initialized_for_test(config,
        test_storage(?streams[0], 1, ?attempts[0], 1));
    if (!manager.valid ||
        apply_peer_limits(?manager, 10, 2, 3, 4, 5, 6).status != STATUS_OK ||
        manager.send_max_data != 10 || manager.config.local_bidirectional_limit != 5 ||
        manager.config.local_unidirectional_limit != 6 ||
        manager.config.send_local_bidirectional_limit != 3 ||
        manager.config.send_peer_bidirectional_limit != 2 ||
        manager.config.send_unidirectional_limit != 4 ||
        apply_peer_limits(?manager, 11, 2, 3, 4, 5, 6).status != STATUS_ERROR) {
        ret 1;
    }
    ret 0;
}
